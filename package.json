{
  "name": "astronautical-aperture",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm run cache-nordletter-images && npm run generate-covers && astro dev",
    "start": "npm run cache-nordletter-images && npm run generate-covers && astro dev",
    "build": "npm run cache-nordletter-images && npm run generate-covers && npm run fetch-webmentions && astro build && ./scripts/trigger-syndication.sh || true",
    "build:cloudflare": "npm run cache-nordletter-images && npm run generate-covers && npm run fetch-webmentions && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-covers": "node scripts/generate-book-covers.js",
    "fetch-webmentions": "node scripts/fetch-webmentions.js",
    "cache-nordletter-images": "node scripts/cache-nordletter-images.js",
    "syndicate": "node scripts/syndicate-content.js",
    "syndicate:dry-run": "SYNDICATION_DRY_RUN=true node scripts/syndicate-content.js"
  },
  "dependencies": {
    "@astrojs/check": "^0.4.0",
    "@astrojs/mdx": "^4.3.1",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.3.1",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.12.0",
    "date-fns": "^2.30.0",
    "glob": "^11.0.2",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.12",
    "sanitize-html": "^2.16.0",
    "sax": "^1.4.1",
    "tailwindcss": "^3.4.0",
    "tslib": "^2.8.1",
    "typescript": "^5.3.3",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "@types/sanitize-html": "^2.16.0",
    "gray-matter": "^4.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.42.0"
  }
}
