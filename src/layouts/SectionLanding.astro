---
import PageHeader from '../components/layout/PageHeader.astro';
import TagList from '../components/TagList.astro';
import type { Post } from '../utils/content';

interface Props {
    title: string;
    description?: string;
    countText?: string;
    layout?: 'centered' | 'left-aligned';
    headerSize?: 'sm' | 'md' | 'lg';
    size?: 'sm' | 'md' | 'lg';
    headerMaxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl' | '7xl' | 'full';
    maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl' | '7xl' | 'full';
    countVariant?: 'accent' | 'plain';
    tagCategory?: string;
    tagTitle?: string;
    tagMaxTags?: number;
    tagShowMore?: boolean;
    tagPosts?: Post[];
    tagWrapperClass?: string;
    tagListSpacing?: string;
    tagListSpacingMobile?: string;
    contentClass?: string;
    contentPadding?: string;
    contentPaddingMobile?: string;
    padding?: 'none' | 'narrow' | 'wide';
    paddingValue?: string;
    paddingValueMobile?: string;
    wrapperClass?: string;
    countAlignment?: 'left' | 'center' | 'right';
    countClass?: string;
    gridMaxWidth?: string;
}

const {
    title,
    description,
    countText,
    layout = 'centered',
    headerSize = 'lg',
    size,
    headerMaxWidth = '7xl',
    maxWidth,
    countVariant = 'accent',
    tagCategory,
    tagTitle,
    tagMaxTags,
    tagShowMore,
    tagPosts,
    tagWrapperClass = '',
    tagListSpacing,
    tagListSpacingMobile,
    contentClass = '',
    contentPadding,
    contentPaddingMobile,
    padding = 'none',
    paddingValue,
    paddingValueMobile,
    wrapperClass = '',
    countAlignment = 'center',
    countClass = '',
    gridMaxWidth
} = Astro.props as Props;

const resolvedHeaderSize = size ?? headerSize;
const resolvedHeaderMaxWidth = maxWidth ?? headerMaxWidth;

const alignmentClasses = {
    left: 'text-left',
    center: 'text-center',
    right: 'text-right'
} as const;

const countAlignmentClass = alignmentClasses[countAlignment] ?? alignmentClasses.center;
const hasTagListSlot = Astro.slots.has('tagList');
const hasBeforeContentSlot = Astro.slots.has('beforeContent');
const hasAfterCountSlot = Astro.slots.has('afterCount');
const hasCountSlot = Astro.slots.has('count');
const hasSidebarSlot = Astro.slots.has('sidebar');

if (!hasTagListSlot && tagCategory && !tagPosts) {
    throw new Error('SectionLanding requires the `tagPosts` prop when rendering the default TagList.');
}

const countVariantClasses = {
    accent: 'section-count--accent',
    plain: 'section-count--plain'
} as const;

const countVariantClass = countVariantClasses[countVariant] ?? countVariantClasses.accent;

const tagListStyle = [
    tagListSpacing ? `--section-taglist-margin: ${tagListSpacing};` : undefined,
    tagListSpacingMobile ? `--section-taglist-margin-mobile: ${tagListSpacingMobile};` : undefined
].filter(Boolean).join(' ');

const contentStyle = [
    contentPadding ? `--section-content-padding: ${contentPadding};` : undefined,
    contentPaddingMobile ? `--section-content-padding-mobile: ${contentPaddingMobile};` : undefined
].filter(Boolean).join(' ');

const paddingTokens = {
    none: '0',
    narrow: 'clamp(0.75rem, 4vw, 2rem)',
    wide: 'clamp(1.5rem, 6vw, 4rem)'
} as const;

const resolvedPaddingToken = paddingTokens[padding] ?? paddingTokens.narrow;

const gridStyle = [
    `--section-grid-padding: ${paddingValue ?? resolvedPaddingToken};`,
    paddingValueMobile ? `--section-grid-padding-mobile: ${paddingValueMobile};` : undefined,
    gridMaxWidth ? `--section-grid-max-width: ${gridMaxWidth};` : undefined
].filter(Boolean).join(' ');

const shouldRenderCount = hasCountSlot || Boolean(countText);

const contentHasCustomSpanClass = /grid-span-\d+/.test(contentClass);
const contentHasCustomStartClass = /grid-start-\d+/.test(contentClass);
const contentSpanClass = contentHasCustomSpanClass
    ? ''
    : hasSidebarSlot
        ? 'grid-span-8'
        : 'grid-span-full';
const contentStartClass = contentHasCustomStartClass
    ? ''
    : hasSidebarSlot
        ? 'grid-start-1'
        : '';
const contentClassList = contentClass.split(/\s+/).filter(Boolean);
const contentAsGrid = contentClassList.includes('section-content--as-grid');
---
<section class={`section-landing ${wrapperClass}`.trim()}>
    <div
        class="section-landing__grid twelve-grid"
        style={gridStyle || undefined}
    >
        <div class="section-header grid-span-full">
            <PageHeader
                title={title}
                description={description}
                layout={layout}
                size={resolvedHeaderSize}
                maxWidth={resolvedHeaderMaxWidth}
            />
        </div>

        {shouldRenderCount && (
            <div class={`section-count grid-span-full ${countVariantClass} ${countAlignmentClass} ${countClass}`.trim()}>
                {hasCountSlot ? <slot name="count" /> : countText}
            </div>
        )}

        {hasAfterCountSlot && (
            <div class="section-after-count grid-span-full">
                <slot name="afterCount" />
            </div>
        )}

        {hasTagListSlot ? (
            <div
                class={`section-taglist grid-span-full ${tagWrapperClass}`.trim()}
                style={tagListStyle || undefined}
            >
                <slot name="tagList" />
            </div>
        ) : (
            tagCategory && (
                <div
                    class={`section-taglist grid-span-full ${tagWrapperClass}`.trim()}
                    style={tagListStyle || undefined}
                >
                    <TagList
                        category={tagCategory}
                        title={tagTitle}
                        maxTags={tagMaxTags}
                        showMore={tagShowMore}
                        posts={tagPosts}
                    />
                </div>
            )
        )}

        {hasBeforeContentSlot && (
            <div class="section-before-content grid-span-full">
                <slot name="beforeContent" />
            </div>
        )}

        <main
            class={`section-content ${contentSpanClass} ${contentStartClass} ${contentClass}`.trim()}
            style={contentStyle || undefined}
            data-content-mode={contentAsGrid ? 'as-grid' : undefined}
            data-garden-grid={contentAsGrid ? '' : undefined}
        >
            <slot />
        </main>

        {hasSidebarSlot && (
            <aside class="section-sidebar grid-span-4 grid-start-9">
                <div class="section-sidebar__inner">
                    <slot name="sidebar" />
                </div>
            </aside>
        )}
    </div>
</section>

<style>
    .section-landing {
        --section-grid-padding: 0;
    }

    .section-landing__grid {
        --grid-padding-inline: var(--section-grid-padding);
        --grid-row-gap: 0;
        padding-inline: var(--section-grid-padding);
        max-width: var(--section-grid-max-width, 71.25rem);
    }

    .section-count {
        margin-top: 1rem;
        margin-bottom: var(--section-count-margin, 0.75rem);
    }

    .section-count--accent {
        font-size: 0.875rem;
        font-weight: 500;
        color: #8b5cf6;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    :global(.dark) .section-count--accent {
        color: #a78bfa;
    }

    .section-count--plain {
        font-size: 1rem;
        font-weight: 600;
        color: #1f2937;
        text-transform: none;
        letter-spacing: normal;
    }

    :global(.dark) .section-count--plain {
        color: #f9fafb;
    }

    .section-taglist {
        margin-bottom: var(--section-taglist-margin, 1rem);
    }

    .section-content {
        --grid-padding-inline: 0;
        padding-bottom: var(--section-content-padding, 2rem);
    }

    .section-content.section-content--as-grid {
        padding-bottom: var(--section-content-grid-padding, 1rem);
    }

    .section-after-count {
        margin-bottom: 1rem;
    }

    .section-before-content {
        margin-bottom: 1.25rem;
    }

    .section-sidebar {
        align-self: start;
    }

    .section-sidebar__inner {
        display: flex;
        flex-direction: column;
        gap: clamp(1.25rem, 3vw, 2rem);
        position: sticky;
        top: clamp(1.5rem, 4vw, 3rem);
    }

    @media (max-width: 768px) {
        .section-landing__grid {
            --grid-padding-inline: var(--section-grid-padding-mobile, var(--section-grid-padding));
            --grid-row-gap: 0;
            padding-inline: var(--section-grid-padding-mobile, var(--section-grid-padding));
        }

        .section-count {
            margin-top: 0.75rem;
            margin-bottom: var(--section-count-margin-mobile, 0.5rem);
        }

        .section-content {
            --grid-padding-inline: 0;
            padding-bottom: var(--section-content-padding-mobile, 1.5rem);
        }

        .section-content.section-content--as-grid {
            padding-bottom: var(--section-content-grid-padding-mobile, 0.75rem);
        }

        .section-taglist {
            margin-bottom: var(--section-taglist-margin-mobile, 0.75rem);
        }

        .section-after-count {
            margin-bottom: 0.75rem;
        }

        .section-before-content {
            margin-bottom: 1rem;
        }

        .section-sidebar__inner {
            position: static;
        }
    }
</style>
