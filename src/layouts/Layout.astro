---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	currentPage: string;
}

const { title, description, currentPage } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/logo/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content={description || "A personal digital garden and blog"} />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Preload logo images -->
		<link rel="preload" href="/images/LogoLightMode.png" as="image" />
		<link rel="preload" href="/images/LogoDarkMode.png" as="image" />
		
		<!-- Open Graph / Social Media -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description || "A personal digital garden and blog"} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		
		<!-- Logo Switch Script - preloads logo based on theme -->
		<script is:inline src="/logo-switch.js"></script>

		<!-- Background color randomizer script -->
		<script is:inline src="/bg-color-randomizer.js"></script>
		
		<!-- Random link underline color script -->
		<script is:inline src="/random-link-colors.js"></script>
		
		<!-- Theme Script (to avoid FOUC - Flash of Unstyled Content) -->
		<script is:inline>
			// Auto-detect dark mode based on system preference only
			if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
			
			// Listen for system theme changes
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', event => {
				if (event.matches) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			});
		</script>
	</head>
	<body class="min-h-screen text-textPrimary dark:text-textPrimaryDark transition-all duration-500">
		<div class="flex flex-col min-h-screen">
			<Header currentPage={currentPage} />
			<main class="container mx-auto px-4 py-8 flex-grow max-w-3xl relative z-10">
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}
	
	/* Light theme colors - warmer background */
	:root {
		--color-bg: 255, 252, 245; /* Warm cream color */
		--color-bg-secondary: 250, 245, 235; /* Slightly darker cream for cards */
		--color-text-primary: 33, 33, 33;
		--color-text-secondary: 117, 117, 117; 
		--color-accent: 0, 102, 204; /* Blue accent (#0066cc) */
		--color-border: 235, 231, 225;
	}
	
	/* Dark theme colors - warmer background */
	.dark {
		--color-bg: 35, 30, 28; /* Warm dark brown */
		--color-bg-secondary: 45, 38, 34; /* Slightly lighter brown for cards */
		--color-text-primary: 255, 250, 240;
		--color-text-secondary: 209, 213, 219;
		--color-accent: 77, 159, 255; /* Lighter blue accent (#4d9fff) */
		--color-border: 85, 75, 70;
	}
	
	/* Add transitions for smooth color changes */
	html, body {
		transition: background-color 0.5s ease, color 0.3s ease;
	}
	
	body {
		background-size: cover;
		background-attachment: fixed;
	}
	
	/* Make content card backgrounds semi-transparent */
	.bg-bgSecondary, .dark .bg-bgSecondaryDark {
		background-color: rgba(var(--color-bg-secondary), 0.7);
		backdrop-filter: blur(10px);
	}
	
	@tailwind base;
	@tailwind components;
	@tailwind utilities;
	
	/* Base styles */
	html {
		font-family: system-ui, sans-serif;
		scroll-behavior: smooth;
	}
	
	/* Custom styling for markdown content */
	.prose {
		max-width: 65ch;
		color: rgb(var(--color-text-primary));
	}
	
	.prose h1,
	.prose h2,
	.prose h3,
	.prose h4,
	.prose h5,
	.prose h6 {
		color: rgb(var(--color-text-primary));
		margin-top: 2rem;
		margin-bottom: 1rem;
		line-height: 1.25;
	}
	
	.prose h1 {
		font-size: 2.25rem;
		font-weight: 700;
	}
	
	.prose h2 {
		font-size: 1.875rem;
		font-weight: 600;
	}
	
	.prose h3 {
		font-size: 1.5rem;
		font-weight: 600;
	}
	
	.prose p {
		margin-top: 1rem;
		margin-bottom: 1rem;
		line-height: 1.75;
	}
	
	.prose a {
		color: rgb(var(--color-accent));
		text-decoration: underline;
		font-weight: 500;
	}
	
	.prose ul,
	.prose ol {
		margin-top: 1rem;
		margin-bottom: 1rem;
		padding-left: 1.75rem;
	}
	
	.prose ul {
		list-style-type: disc;
	}
	
	.prose ol {
		list-style-type: decimal;
	}
	
	.prose li {
		margin-top: 0.5rem;
		margin-bottom: 0.5rem;
		line-height: 1.75;
	}
	
	.prose blockquote {
		border-left: 4px solid rgb(var(--color-text-secondary));
		padding-left: 1rem;
		font-style: italic;
		margin-top: 1.5rem;
		margin-bottom: 1.5rem;
	}
	
	.prose img {
		margin-top: 2rem;
		margin-bottom: 2rem;
		border-radius: 0.375rem;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
	}
	
	.prose code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
		font-size: 0.875rem;
		padding: 0.25rem 0.375rem;
		border-radius: 0.25rem;
		background-color: rgba(var(--color-text-primary), 0.1);
	}
	
	.prose pre {
		padding: 1rem;
		border-radius: 0.375rem;
		overflow-x: auto;
		background-color: rgba(var(--color-text-primary), 0.1);
		margin-top: 1.5rem;
		margin-bottom: 1.5rem;
	}
	
	.prose pre code {
		background-color: transparent;
		padding: 0;
	}
	
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border-width: 0;
	}
</style>
