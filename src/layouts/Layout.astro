---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LayoutContainer from '../components/layout/LayoutContainer.astro';
import LinkHoverEffect from '../components/LinkHoverEffect.astro';
import type { Post } from '../utils/content';
import '../styles/global.css';

interface Props {
        title: string;
        description?: string;
        currentPage: string;
        /** OpenGraph type; pass 'article' from post routes */
        ogType?: 'website' | 'article';
        /** Absolute or root-relative URL to a share image */
        ogImage?: string;
        /** ISO date for article:published_time (post pages) */
        publishedTime?: Date;
        /** Set false on pages that should not be indexed */
        index?: boolean;
        pageWrapper?: {
                as?: keyof HTMLElementTagNameMap;
                maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl' | '7xl' | 'full';
                padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
                paddingScale?: 'page' | 'container';
                centered?: boolean;
                container?: boolean;
                className?: string;
                prose?: boolean;
                proseSize?: 'sm' | 'base' | 'lg' | 'xl';
                grid?: {
                        gap?: 'tight' | 'loose';
                        padding?: 'none' | 'narrow' | 'wide';
                        className?: string;
                };
        };
        allPosts?: Post[];
        enableLinkHoverEffect?: boolean;
}

const {
        title,
        description,
        currentPage,
        ogType = 'website',
        ogImage,
        publishedTime,
        index = true,
        pageWrapper = {},
        enableLinkHoverEffect = false,
} = Astro.props as Props;

const SITE_NAME = 'Sajal Choudhary';
const fullTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const metaDescription = description || 'Sajal Choudhary — platform engineer and writer in Finland. Digital garden, blog, newsletter, and bookshelf.';
const shareImage = new URL(ogImage ?? '/logo/logo-square-v2.svg', Astro.site).href;

const gridConfig = pageWrapper.grid ?? {};

const gridClasses = [
        'twelve-grid',
        gridConfig.gap === 'tight' ? 'grid-gap-tight' : '',
        gridConfig.gap === 'loose' ? 'grid-gap-loose' : '',
        gridConfig.padding === 'narrow' ? 'grid-pad-narrow' : '',
        gridConfig.padding === 'wide' ? 'grid-pad-wide' : '',
        gridConfig.padding === 'none' ? 'grid-pad-none' : '',
        gridConfig.className || '',
]
        .filter(Boolean)
        .join(' ');

const wrapperClassName = ['grid-span-full', pageWrapper.className || ''].filter(Boolean).join(' ');

const containerEnabled = pageWrapper.container === true;
const containerMaxWidth = pageWrapper.maxWidth || 'full';
const containerPadding = pageWrapper.padding ?? 'none';
---

<!DOCTYPE html>
<html lang="en">
        <head>
                <meta charset="UTF-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <link rel="icon" type="image/svg+xml" href="/logo/logo-square-v2.svg" />
                <link rel="icon" type="image/png" sizes="32x32" href="/logo/favicon-32.png" />
                <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />
                <title>{fullTitle}</title>
                <meta name="description" content={metaDescription} />
                <link rel="canonical" href={canonicalUrl} />
                {!index && <meta name="robots" content="noindex, follow" />}
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph / Social Media -->
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={shareImage} />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={shareImage} />

		<link rel="alternate" type="application/rss+xml" title="Sajal Choudhary — everything" href="/rss.xml" />
		<link rel="alternate" type="application/rss+xml" title="Nordletter" href="/nordletter/rss.xml" />

		<!-- Fonts are self-hosted via @fontsource-variable (imported in global.css) -->


		<!-- Theme + background palette script (merged to avoid FOUC and a second
		     render-blocking request; runs synchronously before <body> paints) -->
                <script is:inline>
                        var LIGHT_COLORS = [
                                '209, 237, 252', '229, 236, 248', '244, 222, 245', '252, 209, 244',
                                '252, 218, 229', '254, 218, 184', '252, 245, 184', '232, 242, 204',
                                '191, 231, 207', '151, 219, 204', '174, 219, 219', '232, 236, 248',
                                '247, 209, 252'
                        ];
                        var DARK_COLORS = [
                                '45, 47, 51', '45, 45, 52', '50, 45, 52', '52, 45, 50',
                                '52, 47, 48', '52, 48, 45', '52, 52, 45', '48, 52, 45',
                                '45, 52, 48', '45, 52, 50', '45, 50, 52', '47, 45, 52',
                                '50, 45, 52'
                        ];

                        function pickIndex(key, exclude) {
                                var stored = sessionStorage.getItem(key);
                                var value = stored === null ? NaN : Number(stored);
                                if (Number.isInteger(value) && value >= 0 && value < LIGHT_COLORS.length && value !== exclude) {
                                        return value;
                                }
                                do {
                                        value = Math.floor(Math.random() * LIGHT_COLORS.length);
                                } while (value === exclude);
                                sessionStorage.setItem(key, String(value));
                                return value;
                        }

                        function applyBackgroundPalette(isDark) {
                                var i1 = pickIndex('bg-pick-1', -1);
                                var i2 = pickIndex('bg-pick-2', i1);
                                var palette = isDark ? DARK_COLORS : LIGHT_COLORS;
                                document.documentElement.style.setProperty('--color-bg-1', palette[i1]);
                                document.documentElement.style.setProperty('--color-bg-2', palette[i2]);
                        }

                        function applyTheme(isDark) {
                                document.documentElement.classList.toggle('dark', isDark);
                                applyBackgroundPalette(isDark);
                        }

                        function getStoredTheme() {
                                var stored = localStorage.getItem('theme');
                                return stored === 'dark' || stored === 'light' ? stored : null;
                        }

                        var darkMediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
                        var storedTheme = getStoredTheme();
                        applyTheme(storedTheme ? storedTheme === 'dark' : darkMediaQuery.matches);

                        darkMediaQuery.addEventListener('change', function (event) {
                                if (!getStoredTheme()) {
                                        applyTheme(event.matches);
                                }
                        });

                        window.toggleSiteTheme = function () {
                                var isDark = !document.documentElement.classList.contains('dark');
                                localStorage.setItem('theme', isDark ? 'dark' : 'light');
                                applyTheme(isDark);
                                return isDark;
                        };

                        document.addEventListener('keydown', function (event) {
                                if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
                                var target = event.target;
                                var tag = target && target.tagName;
                                if (tag === 'INPUT' || tag === 'TEXTAREA' || (target && target.isContentEditable)) return;
                                event.preventDefault();
                                window.location.href = '/search';
                        });
                </script>
                {Astro.slots.has('head') && <slot name="head" />}
        </head>
        <body class="min-h-screen text-textPrimary dark:text-textPrimaryDark transition-all duration-500">
                <a href="#main-content" class="skip-link">Skip to content</a>
                <div class="flex flex-col min-h-screen">
                        <Header currentPage={currentPage} />
                        <main id="main-content" tabindex="-1" class="flex-grow relative z-10">
                                <div class={gridClasses}>
                                        <LayoutContainer
                                                as={pageWrapper.as || 'div'}
                                                container={containerEnabled}
                                                maxWidth={containerMaxWidth}
                                                padding={containerPadding}
                                                paddingScale={pageWrapper.paddingScale || 'page'}
                                                centered={pageWrapper.centered !== false}
                                                prose={pageWrapper.prose === true}
                                                proseSize={pageWrapper.proseSize || 'base'}
                                                className={wrapperClassName}
                                        >
                                                <slot />
                                        </LayoutContainer>
                                </div>
                        </main>
			<Footer />
		</div>
		
                {enableLinkHoverEffect && <LinkHoverEffect />}
        </body>
</html>
