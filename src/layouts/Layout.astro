---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LayoutContainer from '../components/layout/LayoutContainer.astro';
import LinkHoverEffect from '../components/LinkHoverEffect.astro';
import type { Post } from '../utils/content';
import '../styles/global.css';

interface Props {
        title: string;
        description?: string;
        currentPage: string;
        /** OpenGraph type; pass 'article' from post routes */
        ogType?: 'website' | 'article';
        /** Absolute or root-relative URL to a share image */
        ogImage?: string;
        /** ISO date for article:published_time (post pages) */
        publishedTime?: Date;
        /** Set false on pages that should not be indexed */
        index?: boolean;
        pageWrapper?: {
                as?: keyof HTMLElementTagNameMap;
                maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl' | '7xl' | 'full';
                padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
                paddingScale?: 'page' | 'container';
                centered?: boolean;
                container?: boolean;
                className?: string;
                prose?: boolean;
                proseSize?: 'sm' | 'base' | 'lg' | 'xl';
                grid?: {
                        gap?: 'tight' | 'loose';
                        padding?: 'none' | 'narrow' | 'wide';
                        className?: string;
                };
        };
        allPosts?: Post[];
        enableLinkHoverEffect?: boolean;
}

const {
        title,
        description,
        currentPage,
        ogType = 'website',
        ogImage,
        publishedTime,
        index = true,
        pageWrapper = {},
        enableLinkHoverEffect = false,
} = Astro.props as Props;

const SITE_NAME = 'Sajal Choudhary';
const fullTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const metaDescription = description || 'Sajal Choudhary — platform engineer and writer in Finland. Digital garden, blog, newsletter, and bookshelf.';
const shareImage = new URL(ogImage ?? '/logo/logo-square-v2.svg', Astro.site).href;

const gridConfig = pageWrapper.grid ?? {};

const gridClasses = [
        'twelve-grid',
        gridConfig.gap === 'tight' ? 'grid-gap-tight' : '',
        gridConfig.gap === 'loose' ? 'grid-gap-loose' : '',
        gridConfig.padding === 'narrow' ? 'grid-pad-narrow' : '',
        gridConfig.padding === 'wide' ? 'grid-pad-wide' : '',
        gridConfig.padding === 'none' ? 'grid-pad-none' : '',
        gridConfig.className || '',
]
        .filter(Boolean)
        .join(' ');

const wrapperClassName = ['grid-span-full', pageWrapper.className || ''].filter(Boolean).join(' ');

const containerEnabled = pageWrapper.container === true;
const containerMaxWidth = pageWrapper.maxWidth || 'full';
const containerPadding = pageWrapper.padding ?? 'none';
---

<!DOCTYPE html>
<html lang="en">
        <head>
                <meta charset="UTF-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <link rel="icon" type="image/svg+xml" href="/logo/logo-square-v2.svg" />
                <link rel="icon" type="image/png" sizes="32x32" href="/logo/favicon-32.png" />
                <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />
                <title>{fullTitle}</title>
                <meta name="description" content={metaDescription} />
                <link rel="canonical" href={canonicalUrl} />
                {!index && <meta name="robots" content="noindex, follow" />}
		<meta name="generator" content={Astro.generator} />

		<!-- Preload logo image -->
		<link rel="preload" href="/logo/logo-square-v2.svg" as="image" />

		<!-- Open Graph / Social Media -->
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={shareImage} />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={shareImage} />

		<link rel="alternate" type="application/rss+xml" title="Sajal Choudhary — everything" href="/rss.xml" />
		<link rel="alternate" type="application/rss+xml" title="Nordletter" href="/nordletter/rss.xml" />

		<!-- Fonts are self-hosted via @fontsource-variable (imported in global.css) -->


		<!-- Background color randomizer script -->
		<script is:inline src="/bg-color-randomizer.js"></script>
		
		
		<!-- Theme Script (to avoid FOUC - Flash of Unstyled Content) -->
                <script is:inline>
                        // Auto-detect dark mode based on system preference only
                        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                                document.documentElement.classList.add('dark');
                        } else {
                                document.documentElement.classList.remove('dark');
                        }

                        // Listen for system theme changes
                        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', event => {
                                if (event.matches) {
                                        document.documentElement.classList.add('dark');
                                } else {
                                        document.documentElement.classList.remove('dark');
                                }
                        });
                </script>
                {Astro.slots.has('head') && <slot name="head" />}
        </head>
        <body class="min-h-screen text-textPrimary dark:text-textPrimaryDark transition-all duration-500">
                <div class="flex flex-col min-h-screen">
                        <Header currentPage={currentPage} />
                        <main class="flex-grow relative z-10">
                                <div class={gridClasses}>
                                        <LayoutContainer
                                                as={pageWrapper.as || 'div'}
                                                container={containerEnabled}
                                                maxWidth={containerMaxWidth}
                                                padding={containerPadding}
                                                paddingScale={pageWrapper.paddingScale || 'page'}
                                                centered={pageWrapper.centered !== false}
                                                prose={pageWrapper.prose === true}
                                                proseSize={pageWrapper.proseSize || 'base'}
                                                className={wrapperClassName}
                                        >
                                                <slot />
                                        </LayoutContainer>
                                </div>
                        </main>
			<Footer />
		</div>
		
                {enableLinkHoverEffect && <LinkHoverEffect />}
        </body>
</html>
