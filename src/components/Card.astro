---
import TimeDisplay from './TimeDisplay.astro';
import CategoryDisplay from './CategoryDisplay.astro';

const { title, description, pubDate, category, image, link } = Astro.props;
const hasImage = Boolean(image);
const cardClass = ['card', hasImage ? 'card--with-image' : 'card--no-image'].join(' ');
---

<article class={cardClass} data-card-root>
  <div class="card-content">
    {image && (
      <div class="card-image">
        <img 
          src={image} 
          alt={title}
          class="image"
        />
      </div>
    )}
    
    <div class="card-body">
      <h2 class="card-title prose">
        {link ? (
          <a href={link} class="card-link link-hover">
            {title}
          </a>
        ) : (
          title
        )}
      </h2>

      <div class="card-description">
        {category === 'micro' ? (
          <slot />
        ) : (
          description && (
            <p class="description-text">
              {description}
            </p>
          )
        )}
      </div>

      <div class="card-meta">
        <CategoryDisplay category={category} className="card-category" />
        <TimeDisplay date={pubDate} category={category} className="card-date" />
      </div>
      
    </div>
  </div>
</article>

<style>
  .card {
    --card-padding: clamp(0.75rem, 2vw, 1rem);
    --card-hover-bg: rgba(99, 102, 241, 0.08);
    --card-hover-border: rgba(167, 139, 250, 0.65);
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 0.75rem;
    border: 1px solid transparent;
    background-color: transparent;
    overflow: hidden;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .card--with-image {
    background: rgba(255, 255, 255, 0.96);
    border-color: rgba(229, 231, 235, 0.9);
    box-shadow: 0 14px 36px -24px rgba(15, 23, 42, 0.25);
  }

  :global(.dark) .card--with-image {
    background: rgba(24, 31, 44, 0.85);
    border-color: rgba(55, 65, 81, 0.7);
    box-shadow: 0 18px 42px -28px rgba(15, 23, 42, 0.6);
  }

  .card:hover,
  .card:focus-within {
    background: var(--card-hover-bg);
    border-color: var(--card-hover-border);
    box-shadow: 0 20px 46px -28px rgba(129, 140, 248, 0.35);
    transform: translateY(-2px);
  }

  .card--with-image:hover,
  .card--with-image:focus-within {
    background: rgba(250, 250, 255, 0.95);
  }

  :global(.dark) .card {
    --card-hover-bg: rgba(99, 102, 241, 0.12);
  }

  :global(.dark) .card--with-image:hover,
  :global(.dark) .card--with-image:focus-within {
    background: rgba(35, 35, 54, 0.9);
  }

  .card--no-image {
    border-color: transparent;
    box-shadow: none;
  }

  .card-content {
    padding: var(--card-padding);
  }

  .card-image {
    margin: calc(var(--card-padding) * -1);
    margin-bottom: var(--card-padding);
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .card:hover .image {
    transform: scale(1.05);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
    font-size: var(--text-small);
  }

  .card-date {
    font-size: var(--text-small);
    color: #6b7280;
    font-weight: 500;
  }

  :global(.dark) .card-date {
    color: #9ca3af;
  }



  .card-title {
    font-size: var(--text-large);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.35rem;
    color: #111827;
  }

  :global(.dark) .card-title {
    color: #f9fafb;
  }

  .card-description {
    color: #4b5563;
    line-height: 1.6;
  }

  :global(.dark) .card-description {
    color: #d1d5db;
  }

  .description-text {
    font-size: var(--text-normal);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Custom prose styles for micro posts */
  :global(.prose) {
    max-width: none;
  }

  :global(.prose p) {
    margin-top: 0;
    margin-bottom: 0.75em;
    font-size: var(--text-normal);
  }

  /* Additional prose styles for better markdown rendering */
  :global(.prose h1),
  :global(.prose h2),
  :global(.prose h3),
  :global(.prose h4) {
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    font-weight: 600;
  }

  :global(.prose ul),
  :global(.prose ol) {
    margin-top: 0.5em;
    margin-bottom: 1.25em;
    padding-left: 1.5em;
  }

  :global(.prose li) {
    margin-top: 0.25em;
    margin-bottom: 0.25em;
  }

  :global(.prose blockquote) {
    margin: 1.25em 0;
    padding-left: 1em;
    border-left: 4px solid #e5e7eb;
    font-style: italic;
  }

  :global(.dark .prose blockquote) {
    border-left-color: #374151;
  }

  :global(.prose code) {
    background-color: #f3f4f6;
    padding: 0.2em 0.4em;
    border-radius: 0.25em;
    font-size: 0.875em;
  }

  :global(.dark .prose code) {
    background-color: #1f2937;
  }

  :global(.prose pre) {
    background-color: #f3f4f6;
    padding: 1em;
    border-radius: 0.5em;
    overflow-x: auto;
    margin: 1.5em 0;
  }

  :global(.dark .prose pre) {
    background-color: #1f2937;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .card-content {
      padding: 0.875rem;
    }

    .card-image {
      margin: -0.875rem -0.875rem 0.875rem -0.875rem;
    }

    .card-meta {
      margin-bottom: 0.5rem;
    }
  }
</style>
