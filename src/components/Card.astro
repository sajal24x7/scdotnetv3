---
import TimeDisplay from './TimeDisplay.astro';
import CategoryDisplay from './CategoryDisplay.astro';

const { title, description, created, category, image, link } = Astro.props;
const hasImage = Boolean(image);
const cardClass = ['card', hasImage ? 'card--with-image' : 'card--no-image'].join(' ');
---

<article class={cardClass} data-card-root>
  <div class="card-content">
    {image && (
      <div class="card-image">
        <img
          src={image}
          alt={title}
          width="800"
          height="450"
          class="image"
          loading="lazy"
          decoding="async"
        />
      </div>
    )}
    
    <div class="card-body">
      <h2 class="card-title">
        {link ? (
          <a href={link} class="card-link link-hover">
            {title}
          </a>
        ) : (
          title
        )}
      </h2>

      <div class="card-description">
        {category === 'micro' ? (
          <div class="card-prose prose">
            <slot />
          </div>
        ) : (
          description && (
            <p class="description-text">
              {description}
            </p>
          )
        )}
      </div>

      <div class="card-meta">
        <CategoryDisplay category={category} className="card-category" />
        <TimeDisplay date={created} category={category} className="card-date card-chip" />
      </div>
      
    </div>
  </div>
</article>

<style>
  .card {
    --card-padding: clamp(0.5rem, 1.5vw, 0.75rem);
    --card-hover-bg: rgba(99, 102, 241, 0.08);
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    border-radius: 0.75rem;
    background-color: transparent;
    overflow: hidden;
    transition:
      background-color 180ms ease,
      box-shadow 220ms ease,
      transform 220ms ease,
      border-color 180ms ease;
  }

  :global(.dark) .card {
    --card-hover-bg: rgba(99, 102, 241, 0.12);
  }

  .card--with-image {
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 4px 12px rgba(15, 23, 42, 0.08);
  }

  :global(.dark) .card--with-image {
    background: rgba(24, 31, 44, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.2),
      0 4px 12px rgba(0, 0, 0, 0.3);
  }

  .card:hover,
  .card:focus-within {
    background: var(--card-hover-bg);
    box-shadow:
      0 4px 8px rgba(0, 0, 0, 0.08),
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 8px 24px rgba(129, 140, 248, 0.25);
    transform: translateY(-2px);
  }

  .card--with-image:hover,
  .card--with-image:focus-within {
    background: rgba(250, 250, 255, 0.95);
    border-color: rgba(99, 102, 241, 0.2);
  }

  :global(.dark) .card--with-image:hover,
  :global(.dark) .card--with-image:focus-within {
    background: rgba(35, 35, 54, 0.9);
    border-color: rgba(99, 102, 241, 0.3);
  }

  .card--no-image {
    background: rgba(0, 0, 0, 0.02);
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.02);
  }

  :global(.dark) .card--no-image {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.15);
  }

  .card-content {
    padding: var(--card-padding);
  }

  .card-image {
    margin: calc(var(--card-padding) * -1);
    margin-bottom: var(--card-padding);
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .card:hover .image {
    transform: scale(1.05);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
    font-size: var(--text-small);
  }

  .card-date {
    color: inherit;
  }



  .card-title {
    font-size: var(--text-large);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.35rem;
    color: #111827;
  }

  :global(.dark) .card-title {
    color: #f9fafb;
  }

  .card-description {
    color: #4b5563;
    line-height: 1.6;
  }

  :global(.dark) .card-description {
    color: #d1d5db;
  }

  .description-text {
    font-size: var(--text-normal);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Custom prose styles for micro posts */
  .card-prose {
    max-width: none;
  }

  .card-prose :global(p) {
    margin-top: 0;
    margin-bottom: 0.75em;
    font-size: var(--text-normal);
  }

  /* Additional prose styles for better markdown rendering */
  .card-prose :global(h1),
  .card-prose :global(h2),
  .card-prose :global(h3),
  .card-prose :global(h4) {
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    font-weight: 600;
  }

  .card-prose :global(ul),
  .card-prose :global(ol) {
    margin-top: 0.5em;
    margin-bottom: 1.25em;
    padding-left: 1.5em;
  }

  .card-prose :global(li) {
    margin-top: 0.25em;
    margin-bottom: 0.25em;
  }

  .card-prose :global(blockquote) {
    margin: 1.25em 0;
    padding-left: 1em;
    border-left: 4px solid #e5e7eb;
    font-style: italic;
  }

  :global(.dark) .card-prose :global(blockquote) {
    border-left-color: #374151;
  }

  .card-prose :global(code) {
    background-color: #f3f4f6;
    padding: 0.2em 0.4em;
    border-radius: 0.25em;
    font-size: 0.875em;
  }

  :global(.dark) .card-prose :global(code) {
    background-color: #1f2937;
  }

  .card-prose :global(pre) {
    background-color: #f3f4f6;
    padding: 1em;
    border-radius: 0.5em;
    overflow-x: auto;
    margin: 1.5em 0;
  }

  :global(.dark) .card-prose :global(pre) {
    background-color: #1f2937;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .card-content {
      padding: 0.75rem;
    }

    .card-image {
      margin: -0.75rem -0.75rem 0.75rem -0.75rem;
    }

    .card-meta {
      margin-bottom: 0.5rem;
    }
  }
</style>
