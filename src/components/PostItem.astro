---
import TimeDisplay from './TimeDisplay.astro';
import CategoryDisplay from './CategoryDisplay.astro';
import Tag from './Tag.astro';

interface Props {
  post: any;
  isMicroContent: (category: string) => boolean;
  showFullContent?: boolean;
}

const { post, isMicroContent, showFullContent = true } = Astro.props;
const tags = Array.isArray(post.data.tags) ? post.data.tags : [];
const hasTags = tags.length > 0;
---

<article class="post-item">
  <div class="post-item-body">
    {post.data.title && (
      <h2 class="stream-title">
        <a href={post.data.link} class="stream-title-link link-hover">
          {post.data.title}
        </a>
      </h2>
    )}

    <div class="stream-body">
      {post.data.category === 'micro' && showFullContent ? (
        <div
          class="prose dark:prose-dark stream-prose"
          set:html={post.renderedContent || post.body}
        />
      ) : (
        post.data.description && (
          <p class="stream-description">
            {post.data.description}
          </p>
        )
      )}
    </div>

    {!isMicroContent(post.data.category) && (
      <div class="stream-read-more">
        <a href={post.data.link} class="read-more-link link-hover">
          Read more →
        </a>
      </div>
    )}

    <div class="post-item-meta post-item-meta-mobile">
      <a href={post.data.link} class="stream-date-link link-hover">
        <TimeDisplay
          date={post.data.pubDate}
          category={post.data.category}
          className="stream-date"
          format="detailed"
        />
      </a>
      <div class="stream-meta-divider">•</div>
      <CategoryDisplay category={post.data.category} className="stream-category" />
      {hasTags && (
        <>
          <div class="stream-meta-divider">•</div>
          <div class="stream-tags-inline">
            {tags.map((tag: string) => (
              <Tag tag={tag} />
            ))}
          </div>
        </>
      )}
    </div>
  </div>

  <aside class="post-item-meta post-item-meta-desktop">
    <a href={post.data.link} class="stream-date-link link-hover">
      <TimeDisplay
        date={post.data.pubDate}
        category={post.data.category}
        className="stream-date"
        format="detailed"
      />
    </a>
    <CategoryDisplay category={post.data.category} className="stream-category" />
    {hasTags && (
      <div class="stream-tags-sidebar">
        {tags.map((tag: string) => (
          <Tag tag={tag} />
        ))}
      </div>
    )}
  </aside>
</article>

<style>
  .post-item {
    border-bottom: 1px solid rgb(var(--color-border));
    padding-bottom: calc(var(--post-item-spacing, var(--grid-row-gap)) / 2);
    margin-bottom: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: calc(var(--post-item-spacing, var(--grid-row-gap)) / 2);
  }

  .post-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .post-item-body {
    display: flex;
    flex-direction: column;
    gap: calc(var(--post-item-spacing, var(--grid-row-gap)) / 3);
  }

  .stream-title {
    font-size: var(--text-large);
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    color: rgb(var(--color-text-primary));
  }

  .stream-description {
    color: rgb(var(--color-text-secondary));
    line-height: 1.6;
  }

  .stream-body {
    margin-bottom: calc(var(--post-item-spacing, var(--grid-row-gap)) / 6);
  }

  .stream-read-more {
    margin-top: calc(var(--post-item-spacing, var(--grid-row-gap)) / 6);
  }

  .post-item-meta {
    font-size: 0.875rem;
    color: rgb(var(--color-text-secondary));
  }

  .post-item-meta-mobile {
    margin-top: 0;
    padding-top: calc(var(--post-item-spacing, var(--grid-row-gap)) / 2);
    border-top: 1px solid rgb(var(--color-border));
    display: flex;
    align-items: center;
    gap: calc(var(--post-item-spacing, var(--grid-row-gap)) / 4);
    flex-wrap: wrap;
  }

  .post-item-meta-desktop {
    display: none;
    flex-direction: column;
    gap: calc(var(--post-item-spacing, var(--grid-row-gap)) / 3);
    text-align: right;
  }

  .stream-date-link {
    text-decoration: none;
    transition: all 0.2s ease;
    color: inherit;
    font-weight: 500;
  }

  .stream-date {
    font-weight: 500;
    color: inherit;
    font-family: monospace;
  }

  .stream-tags-sidebar {
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .stream-tags-inline {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .stream-meta-divider {
    color: rgba(var(--color-text-secondary), 0.35);
  }

  .stream-prose {
    max-width: none;
    width: 100%;
  }

  .stream-prose :global(p) {
    margin-top: 0;
    margin-bottom: 0.75em;
  }

  @media (min-width: 48rem) {
    .post-item {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-column-gap);
      row-gap: var(--grid-row-gap);
    }

    .post-item-body {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .post-item-body {
      grid-column: 4 / span 9;
    }

    .post-item-meta-desktop {
      display: flex;
      grid-column: 1 / span 3;
      grid-row: 1;
      align-items: flex-end;
    }

    .post-item-meta-mobile {
      display: none;
    }
  }
</style>
