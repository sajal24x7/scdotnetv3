---
import TimeDisplay from './TimeDisplay.astro';
import CategoryDisplay from './CategoryDisplay.astro';

interface Props {
  post: any;
  isMicroContent: (category: string) => boolean;
  showFullContent?: boolean;
}

const { post, isMicroContent, showFullContent = true } = Astro.props;
---

<article class="post-item">
  <!-- Desktop: 2-column layout -->
  <div class="post-item-desktop">
    <!-- Left column: Metadata -->
    <div class="post-item-metadata">
      <a href={post.data.link} class="stream-date-link">
        <TimeDisplay 
          date={post.data.pubDate} 
          category={post.data.category} 
          className="stream-date"
          format="detailed"
        />
      </a>
      <CategoryDisplay category={post.data.category} className="stream-category" />
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="stream-tags-sidebar">
          {post.data.tags.map((tag: string) => (
            <a href={`/tags/${tag.toLowerCase()}/`} class="tag">
              {tag.toUpperCase()}
            </a>
          ))}
        </div>
      )}
    </div>
    
    <!-- Right column: Content -->
    <div class="post-item-content">
      {post.data.title && (
        <h2 class="stream-title">
          <a href={post.data.link} class="stream-title-link">
            {post.data.title}
          </a>
        </h2>
      )}
      
      <div class="stream-body">
        {post.data.category === 'micro' && showFullContent ? (
          <div class="prose dark:prose-dark max-w-none" set:html={post.renderedContent || post.body} />
        ) : (
          post.data.description && (
            <p class="stream-description">
              {post.data.description}
            </p>
          )
        )}
      </div>
      
      {!isMicroContent(post.data.category) && (
        <div class="stream-read-more">
          <a href={post.data.link} class="read-more-link">
            Read more →
          </a>
        </div>
      )}
    </div>
  </div>
  
  <!-- Mobile: Single column with inline metadata -->
  <div class="post-item-mobile">
    <div class="post-item-content">
      {post.data.title && (
        <h2 class="stream-mobile-title">
          <a href={post.data.link} class="stream-title-link">
            {post.data.title}
          </a>
        </h2>
      )}
      
      <div class="stream-mobile-body">
        {post.data.category === 'micro' && showFullContent ? (
          <div class="prose dark:prose-dark max-w-none" set:html={post.renderedContent || post.body} />
        ) : (
          post.data.description && (
            <p class="stream-description">
              {post.data.description}
            </p>
          )
        )}
      </div>
      
      {!isMicroContent(post.data.category) && (
        <div class="stream-read-more">
          <a href={post.data.link} class="read-more-link">
            Read more →
          </a>
        </div>
      )}
    </div>
    
    <!-- Mobile metadata after content -->
    <div class="stream-mobile-metadata">
      <a href={post.data.link} class="stream-date-link">
        <TimeDisplay 
          date={post.data.pubDate} 
          category={post.data.category} 
          className="stream-date"
          format="detailed"
        />
      </a>
      <div class="stream-meta-divider">•</div>
      <CategoryDisplay category={post.data.category} className="stream-category" />
      {post.data.tags && post.data.tags.length > 0 && (
        <>
          <div class="stream-meta-divider">•</div>
          <div class="stream-tags-inline">
            {post.data.tags.map((tag: string) => (
              <a href={`/tags/${tag.toLowerCase()}/`} class="tag">
                {tag.toUpperCase()}
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </div>
</article>

<style>
  .post-item {
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .post-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }

  :global(.dark) .post-item {
    border-bottom-color: #374151;
  }

  /* Desktop Layout */
  .post-item-desktop {
    display: none;
  }

  @media (min-width: 1024px) {
    .post-item-desktop {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 2rem;
    }
  }

  /* Mobile Layout */
  .post-item-mobile {
    display: block;
  }

  @media (min-width: 1024px) {
    .post-item-mobile {
      display: none;
    }
  }

  /* Metadata styling */
  .post-item-metadata {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: #6b7280;
    text-align: right;
    padding-right: 1rem;
  }

  :global(.dark) .post-item-metadata {
    color: #9ca3af;
  }

  .stream-date-link {
    text-decoration: none;
    transition: all 0.2s ease;
    color: inherit;
    font-weight: 500;
  }

  .stream-date {
    font-weight: 500;
    color: inherit;
    font-family: monospace;
  }

  /* Date links now use global styling */



  .stream-tags-sidebar {
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    align-items: flex-end;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .tag {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    /* Color, border, and hover styles now handled by global CSS */
  }

  /* Content styling */
  .stream-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.75rem;
    color: #111827;
  }

  :global(.dark) .stream-title {
    color: #f9fafb;
  }

  .stream-title-link {
    /* Title links now use global styling */
  }

  .stream-description {
    color: #4b5563;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  :global(.dark) .stream-description {
    color: #d1d5db;
  }

  .stream-body {
    margin-bottom: 1rem;
  }

  .read-more-link {
    /* Read more links now use global styling */
  }

  /* Mobile specific styling */
  .stream-mobile-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.75rem;
    color: #111827;
  }

  :global(.dark) .stream-mobile-title {
    color: #f9fafb;
  }

  .stream-mobile-metadata {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #f3f4f6;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: #6b7280;
  }

  :global(.dark) .stream-mobile-metadata {
    border-top-color: #374151;
    color: #9ca3af;
  }

  .stream-meta-divider {
    color: #d1d5db;
  }

  :global(.dark) .stream-meta-divider {
    color: #4b5563;
  }

  .stream-tags-inline {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  /* Prose styling for micro content */
  :global(.prose) {
    max-width: none;
  }

  :global(.prose p) {
    margin-top: 0;
    margin-bottom: 0.75em;
  }

  /* Prose links now use global styling */
</style>