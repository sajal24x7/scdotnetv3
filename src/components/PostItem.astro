---
import TimeDisplay from './TimeDisplay.astro';
import CategoryDisplay from './CategoryDisplay.astro';
import Tag from './Tag.astro';
import SyndicationLinks from './SyndicationLinks.astro';

interface Props {
  post: any;
  isMicroContent: (category: string) => boolean;
  showFullContent?: boolean;
  showReadMore?: boolean;
}

const { post, isMicroContent, showFullContent = true, showReadMore = true } = Astro.props;
const tags = Array.isArray(post.data.tags) ? post.data.tags : [];
const hasTags = tags.length > 0;
const isMicro = isMicroContent(post.data.category);
const postTitle = post.data.title;
const postLink = post.data.link;
const linkAriaLabel = postTitle
    ? `Open “${postTitle}”`
    : 'Open post';
const postImage = typeof post.data.image === 'string' ? post.data.image : null;
const showFeaturedImage = post.data.category === 'blog' && Boolean(postImage);
const postImageAlt = typeof post.data.imageAlt === 'string' && post.data.imageAlt
    ? post.data.imageAlt
    : postTitle || '';
const syndicationUrls = Array.isArray(post.data.syndicationUrls) ? post.data.syndicationUrls : [];
---

<article class="post-item">
  <header class="post-item-header">
    <div class="post-item-meta">
      <a href={postLink} class="post-item-timestamp link-hover" aria-label={linkAriaLabel}>
        <span class="post-item-time">
          <span class="post-item-time-chip card-chip">
            <TimeDisplay
              date={post.data.pubDate}
              category={post.data.category}
              className="post-item-time-value"
              format="relative"
            />
          </span>
          <span class="post-item-link-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path
                d="M8.693 6.807 6.1 9.4a4.273 4.273 0 0 0 6.045 6.045l7.071-7.071a3 3 0 0 0-4.243-4.243l-7.07 7.071a1.5 1.5 0 1 0 2.121 2.121l5.657-5.657"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </span>
      </a>
      <SyndicationLinks syndicationUrls={syndicationUrls} />
    </div>
  </header>

  {showFeaturedImage && postImage && (
    <figure class="post-item-media">
      <a href={postLink} class="post-item-media-link" aria-label={linkAriaLabel}>
        <img src={postImage} alt={postImageAlt} loading="lazy" decoding="async" />
      </a>
    </figure>
  )}

  {postTitle && (!isMicro || !showFullContent) && (
    <h2 class="stream-title">
      <a href={postLink} class="stream-title-link link-hover">
        {postTitle}
      </a>
    </h2>
  )}

  <div class="stream-body">
    {isMicro && showFullContent ? (
      <div
        class="prose dark:prose-dark stream-prose"
        set:html={post.renderedContent || post.body}
      />
    ) : (
      !isMicro && post.data.description && (
        <p class="stream-description">
          {post.data.description}
        </p>
      )
    )}
  </div>

  {!isMicro && showReadMore && (
    <div class="stream-read-more">
      <a href={postLink} class="read-more-link link-hover">
        Read more →
      </a>
    </div>
  )}

  <footer class="post-item-footer">
    <CategoryDisplay category={post.data.category} className="stream-category" />
    {hasTags && (
      <div class="post-item-tags">
        {tags.map((tag: string) => (
          <Tag tag={tag} />
        ))}
      </div>
    )}
  </footer>
</article>

<style>
  .post-item {
    border-bottom: 2px dashed rgba(var(--color-text-secondary), 0.55);
    padding-bottom: clamp(1rem, 2.5vw, 1.75rem);
    margin-bottom: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  :global(.dark) .post-item {
    border-bottom-color: rgba(var(--color-border), 0.6);
  }

  .post-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .post-item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .post-item-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .post-item-timestamp {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: #6b7280;
    font-size: var(--text-small);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  :global(.dark) .post-item-timestamp {
    color: #9ca3af;
  }

  .post-item-timestamp:hover {
    color: rgb(var(--color-text-primary));
  }

  .post-item-time {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .post-item-time-chip {
    gap: 0.3rem;
  }

  .post-item-time-value {
    color: inherit;
    font: inherit;
    text-transform: inherit;
    letter-spacing: inherit;
  }

  .post-item-link-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
  }

  .post-item-link-icon svg {
    width: 100%;
    height: 100%;
  }


  .stream-title {
    font-size: var(--text-large);
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    color: rgb(var(--color-text-primary));
  }

  .post-item-media {
    border-radius: clamp(0.75rem, 3vw, 1rem);
    overflow: hidden;
    background-color: rgba(var(--color-bg-secondary), 0.65);
    line-height: 0;
  }

  .post-item-media-link {
    display: block;
  }

  .post-item-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 16 / 9;
  }

  .stream-description {
    color: rgb(var(--color-text-secondary));
    line-height: 1.6;
  }

  .stream-body {
    margin-bottom: 0;
  }

  .stream-read-more {
    margin-top: 0;
  }

  .stream-prose {
    max-width: none;
    width: 100%;
  }

  .stream-prose :global(p) {
    margin-top: 0;
    margin-bottom: 0.75em;
  }

  .stream-prose :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    white-space: pre;
  }

  .stream-prose :global(pre code) {
    white-space: inherit;
  }

  .post-item-footer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: rgb(var(--color-text-secondary));
    padding-top: 0;
  }

  @media (max-width: 47.99rem) {
    .stream-prose :global(pre) {
      white-space: pre-wrap;
      word-break: break-word;
      overflow-wrap: anywhere;
    }
  }

  .post-item-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  @media (min-width: 48rem) {
    .post-item-header {
      align-items: flex-start;
    }

    .post-item-syndication {
      gap: 0.65rem;
    }
  }
</style>
