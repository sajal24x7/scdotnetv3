---
import TimeDisplay from './TimeDisplay.astro';
import CategoryDisplay from './CategoryDisplay.astro';
import Tag from './Tag.astro';

interface Props {
  post: any;
  isMicroContent: (category: string) => boolean;
  showFullContent?: boolean;
}

const { post, isMicroContent, showFullContent = true } = Astro.props;
const tags = Array.isArray(post.data.tags) ? post.data.tags : [];
const hasTags = tags.length > 0;
const isMicro = isMicroContent(post.data.category);
const postTitle = post.data.title;
const postLink = post.data.link;
const linkAriaLabel = postTitle
  ? `Open “${postTitle}”`
  : 'Open post';
---

<article class="post-item">
  <header class="post-item-header">
    <a href={postLink} class="post-item-timestamp link-hover" aria-label={linkAriaLabel}>
      <span class="post-item-time">
        <span class="post-item-timestamp-label">Posted</span>
        <TimeDisplay
          date={post.data.pubDate}
          category={post.data.category}
          className="post-item-time-value"
          format="relative"
        />
      </span>
    </a>
    <a href={postLink} class="post-item-link-button link-hover" aria-label={linkAriaLabel}>
      <span aria-hidden="true">↗</span>
    </a>
  </header>

  {!isMicro && postTitle && (
    <h2 class="stream-title">
      <a href={postLink} class="stream-title-link link-hover">
        {postTitle}
      </a>
    </h2>
  )}

  <div class="stream-body">
    {post.data.category === 'micro' && showFullContent ? (
      <div
        class="prose dark:prose-dark stream-prose"
        set:html={post.renderedContent || post.body}
      />
    ) : (
      post.data.description && (
        <p class="stream-description">
          {post.data.description}
        </p>
      )
    )}
  </div>

  {!isMicro && (
    <div class="stream-read-more">
      <a href={postLink} class="read-more-link link-hover">
        Read more →
      </a>
    </div>
  )}

  <footer class="post-item-footer">
    <CategoryDisplay category={post.data.category} className="stream-category" />
    {hasTags && (
      <div class="post-item-tags">
        {tags.map((tag: string) => (
          <Tag tag={tag} />
        ))}
      </div>
    )}
  </footer>
</article>

<style>
  .post-item {
    border-bottom: 1px dashed rgba(var(--color-border), 0.8);
    padding-bottom: calc(var(--post-item-spacing, var(--grid-row-gap)) / 2);
    margin-bottom: 0;
    display: flex;
    flex-direction: column;
    gap: calc(var(--post-item-spacing, var(--grid-row-gap)) / 3);
  }

  :global(.dark) .post-item {
    border-bottom-color: rgba(var(--color-border), 0.6);
  }

  .post-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .post-item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .post-item-timestamp {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    text-decoration: none;
    color: #6b7280;
    font-size: var(--text-small);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  :global(.dark) .post-item-timestamp {
    color: #9ca3af;
  }

  .post-item-timestamp:hover {
    color: rgb(var(--color-text-primary));
  }

  .post-item-timestamp-label {
    font-size: inherit;
    color: inherit;
    font-weight: inherit;
    text-transform: none;
    letter-spacing: normal;
  }

  .post-item-time {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .post-item-time-value {
    color: inherit;
  }

  .post-item-link-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    border: 1px solid rgba(var(--color-border), 0.8);
    background: rgba(var(--color-surface), 0.7);
    color: rgb(var(--color-text-secondary));
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .post-item-link-button:hover {
    color: rgb(var(--color-text-primary));
    border-color: rgb(var(--color-text-primary));
  }

  .stream-title {
    font-size: var(--text-large);
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    color: rgb(var(--color-text-primary));
  }

  .stream-description {
    color: rgb(var(--color-text-secondary));
    line-height: 1.6;
  }

  .stream-body {
    margin-bottom: calc(var(--post-item-spacing, var(--grid-row-gap)) / 6);
  }

  .stream-read-more {
    margin-top: calc(var(--post-item-spacing, var(--grid-row-gap)) / 6);
  }

  .stream-prose {
    max-width: none;
    width: 100%;
  }

  .stream-prose :global(p) {
    margin-top: 0;
    margin-bottom: 0.75em;
  }

  .post-item-footer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: rgb(var(--color-text-secondary));
    padding-top: calc(var(--post-item-spacing, var(--grid-row-gap)) / 2);
  }

  .post-item-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  @media (min-width: 48rem) {
    .post-item {
      gap: var(--post-item-spacing, var(--grid-row-gap));
    }

    .post-item-header {
      align-items: flex-start;
    }
  }
</style>
