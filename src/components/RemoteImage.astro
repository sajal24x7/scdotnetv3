---
// Responsive <img> for frontmatter image URLs. R2 images listed in the
// dimension manifest get an optimised src/srcset; anything else renders the
// original URL so a new or external image never breaks the build.
import type { HTMLAttributes } from 'astro/types';
import { getResponsiveImage } from '../utils/images';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'sizes'> {
    src: string;
    alt: string;
    /** `sizes` hint matching the slot the image is displayed in. */
    sizes: string;
    /** Largest width to generate; roughly 2x the widest layout slot. */
    maxWidth?: number;
}

const { src, sizes, maxWidth = 1600, loading = 'lazy', decoding = 'async', ...attrs } = Astro.props as Props;
const image = await getResponsiveImage(src, { sizes, maxWidth });
---

{image ? (
    <img
        {...attrs}
        src={image.src}
        srcset={image.srcset}
        sizes={image.sizes}
        width={attrs.width ?? image.width}
        height={attrs.height ?? image.height}
        loading={loading}
        decoding={decoding}
    />
) : (
    <img {...attrs} src={src} loading={loading} decoding={decoding} />
)}
