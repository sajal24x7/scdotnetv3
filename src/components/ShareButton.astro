---
interface Props {
    title?: string;
    url?: string;
    text?: string;
    class?: string;
    copiedMessage?: string;
}

const {
    title,
    url,
    text = 'Share',
    class: className = '',
    copiedMessage = 'Link copied to clipboard!'
} = Astro.props as Props;

const buttonId = `share-button-${Math.random().toString(36).slice(2, 10)}`;
const baseClass = 'link-inline text-accent flex items-center';
const classes = className ? `${baseClass} ${className}` : baseClass;
---
<button
    type="button"
    id={buttonId}
    class={classes}
    data-share-title={title ?? ''}
    data-share-url={url ?? ''}
    data-copied-message={copiedMessage}
>
    <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mr-1"
    >
        <circle cx="18" cy="5" r="3"></circle>
        <circle cx="6" cy="12" r="3"></circle>
        <circle cx="18" cy="19" r="3"></circle>
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    </svg>
    {text}
</button>

<script>
    const scriptElement = document.currentScript;
    const shareButton = scriptElement?.previousElementSibling;

    if (shareButton instanceof HTMLButtonElement) {
        shareButton.addEventListener('click', async () => {
            const shareTitle = shareButton.dataset.shareTitle || document.title;
            const shareUrl = shareButton.dataset.shareUrl || window.location.href;
            const fallbackMessage = shareButton.dataset.copiedMessage || 'Link copied to clipboard!';

            if (navigator.share) {
                try {
                    await navigator.share({
                        title: shareTitle,
                        url: shareUrl
                    });
                    return;
                } catch (error) {
                    console.error('Error sharing:', error);
                }
            }

            if (navigator.clipboard && shareUrl) {
                try {
                    await navigator.clipboard.writeText(shareUrl);
                    if (fallbackMessage) {
                        alert(fallbackMessage);
                    }
                } catch (error) {
                    console.error('Failed to copy:', error);
                }
            } else {
                console.warn('Share and clipboard APIs are unavailable in this browser.');
            }
        });
    }
</script>
