---
import shareButtonIslandScript from './ShareButton.client.js?url';

interface Props {
    title?: string;
    url?: string;
    ariaLabel?: string;
    class?: string;
    copiedMessage?: string;
}

const {
    title,
    url,
    ariaLabel = 'Share this post',
    class: className = '',
    copiedMessage = 'Link copied to clipboard!'
} = Astro.props as Props;
const baseClass =
    'flex h-10 w-10 items-center justify-center cursor-pointer appearance-none bg-transparent border border-borderColor dark:border-borderColorDark rounded-full text-textPrimary dark:text-textPrimaryDark transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgb(var(--color-accent))] hover:bg-[rgba(var(--color-border),0.12)] dark:hover:bg-[rgba(var(--color-border),0.22)]';
const classes = className ? `${baseClass} ${className}` : baseClass;
---
<button
    type="button"
    class={classes}
    data-share-button
    data-share-title={title ?? ''}
    data-share-url={url ?? ''}
    data-copied-message={copiedMessage}
    aria-label={ariaLabel}
    title={ariaLabel}
>
    <span class="sr-only">{ariaLabel}</span>
    <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
    >
        <circle cx="18" cy="5" r="3"></circle>
        <circle cx="6" cy="12" r="3"></circle>
        <circle cx="18" cy="19" r="3"></circle>
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    </svg>
</button>

<script type="module" src={shareButtonIslandScript}></script>
