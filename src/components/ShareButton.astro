---
import shareButtonIslandScript from './ShareButton.client.js?url';

interface Props {
    title?: string;
    url?: string;
    text?: string;
    class?: string;
    copiedMessage?: string;
}

const {
    title,
    url,
    text = 'Share',
    class: className = '',
    copiedMessage = 'Link copied to clipboard!'
} = Astro.props as Props;
const baseClass =
    'flex items-center cursor-pointer appearance-none bg-transparent border-0 p-0 text-textPrimary dark:text-textPrimaryDark transition-opacity hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgb(var(--color-accent))]';
const classes = className ? `${baseClass} ${className}` : baseClass;
---
<button
    type="button"
    class={classes}
    data-share-button
    data-share-title={title ?? ''}
    data-share-url={url ?? ''}
    data-copied-message={copiedMessage}
>
    <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mr-1"
    >
        <circle cx="18" cy="5" r="3"></circle>
        <circle cx="6" cy="12" r="3"></circle>
        <circle cx="18" cy="19" r="3"></circle>
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    </svg>
    {text}
</button>

<script type="module" src={shareButtonIslandScript}></script>
