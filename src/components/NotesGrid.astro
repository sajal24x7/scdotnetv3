---
import Card from './Card.astro';
import { parseMarkdown } from '../utils/markdown';

const { posts } = Astro.props;

// Pre-render markdown content
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? parseMarkdown(post.body) : null
}));
---

<div class="notes-grid layout-boundary px-4 md:px-0">
  {renderedPosts.map((post) => (
    <Card {...post.data}>
      {post.renderedContent && (
        <div class="prose dark:prose-dark max-w-none">
          <div set:html={post.renderedContent} />
        </div>
      )}
    </Card>
  ))}
</div>


<style>
  .notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .notes-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 768px) and (max-width: 1024px) {
    .notes-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 0.875rem;
    }
  }

  /* Desktop adjustments */
  @media (min-width: 1024px) {
    .notes-grid {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1rem;
    }
  }

  /* Ensure links are properly styled */
  :global(.prose a) {
    color: #3b82f6;
    text-decoration: none;
    transition: color 0.2s;
  }

  :global(.prose a:hover) {
    color: #2563eb;
    text-decoration: underline;
  }

  :global(.dark .prose a) {
    color: #60a5fa;
  }

  :global(.dark .prose a:hover) {
    color: #93c5fd;
  }
</style>