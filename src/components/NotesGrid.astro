---
import Card from './Card.astro';
import { marked } from 'marked';
import LinkHoverEffect from './LinkHoverEffect.astro';

const { posts } = Astro.props;

// Configure marked options
marked.setOptions({
  gfm: true, // GitHub Flavored Markdown
  breaks: true // Convert line breaks to <br>
});

// Pre-render markdown content
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? marked.parse(post.body) : null
}));
---

<div class="notes-grid">
  {renderedPosts.map((post) => (
    <Card {...post.data}>
      {post.renderedContent && (
        <div class="prose dark:prose-dark max-w-none">
          <div set:html={post.renderedContent} />
        </div>
      )}
    </Card>
  ))}
</div>

<LinkHoverEffect />

<style>
  .notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .notes-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      max-width: none;
      padding: 0 1rem;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 768px) and (max-width: 1024px) {
    .notes-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 0.875rem;
    }
  }

  /* Desktop adjustments */
  @media (min-width: 1024px) {
    .notes-grid {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1rem;
    }
  }

  /* Ensure links are properly styled */
  /* Persistent yellow highlight for prose links (manuelmoreale.com style) */
  :global(.prose a) {
    background-color: #FCEE0C; /* Aureolin - lighter yellow like manuelmoreale.com */
    color: inherit;
    text-decoration: none;
    padding: 0 2px;
    transition: background-color 0.2s ease;
  }

  :global(.prose a:hover) {
    background-color: #FFD700; /* Gold - darker yellow for hover */
  }

  :global(.dark .prose a) {
    background-color: #03D8F3; /* Vivid Sky Blue - cyberpunk blue */
  }

  :global(.dark .prose a:hover) {
    background-color: #00BFFF; /* Deep Sky Blue - darker cyberpunk blue for hover */
  }
</style>