---
import { formatDateWithoutYear } from '../utils/dateFormat';
import AdaptiveCard from './AdaptiveCard.astro';

interface Props {
  posts: any[];
}

const { posts } = Astro.props;

// Group posts by year
const postsByYear = posts.reduce((acc, post) => {
  const year = post.data.pubDate.getFullYear();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {});

// Sort years in descending order
const sortedYears = Object.keys(postsByYear).sort((a, b) => parseInt(b) - parseInt(a));
---

<div class="circular-container">
  {sortedYears.map((year) => (
    <section class="year-section">
      <h2 class="year-headline">{year}</h2>
      <div class="circular-grid">
        {postsByYear[year].map((post) => (
          <div class="circular-item">
            <AdaptiveCard 
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              category={post.data.category}
              image={post.data.image}
              link={post.data.link}
              layout="circular"
            />
          </div>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .circular-container {
    padding: 2rem 0;
  }

  .year-section {
    margin-bottom: 4rem;
  }

  .year-section:last-child {
    margin-bottom: 0;
  }

  .year-headline {
    font-size: 2rem;
    font-weight: 700;
    color: #1f2937;
    margin: 0 0 2rem 0;
    text-align: center;
    padding-bottom: 1rem;
    border-bottom: 2px solid #e5e7eb;
  }

  .circular-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .circular-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .circular-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .circular-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .circular-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Dark mode styles */
  :global(.dark) .year-headline {
    color: #f9fafb;
    border-bottom-color: #374151;
  }
</style>