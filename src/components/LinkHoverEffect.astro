---
// Simple, reliable link hover effects component
import { generateContentPreviews, escapeHtml } from '../utils/contentPreview';

// Generate content previews at build time
const contentPreviews = await generateContentPreviews();
const previewsJson = JSON.stringify(Object.fromEntries(contentPreviews));
---

<style>
  /* Permanent link colors for internal links (blue) */
  :global(.prose a[data-internal]) {
    color: #3b82f6 !important;
    text-decoration: none;
  }

  :global(.prose a[data-internal]:hover) {
    color: #2563eb !important;
    text-decoration: underline;
  }

  :global(.dark .prose a[data-internal]) {
    color: #60a5fa !important;
  }

  :global(.dark .prose a[data-internal]:hover) {
    color: #93c5fd !important;
  }

  /* Permanent link colors for external links (purple) */
  :global(.prose a[data-external]) {
    color: #8b5cf6 !important;
    text-decoration: none;
  }

  :global(.prose a[data-external]:hover) {
    color: #7c3aed !important;
    text-decoration: underline;
  }

  :global(.dark .prose a[data-external]) {
    color: #a78bfa !important;
  }

  :global(.dark .prose a[data-external]:hover) {
    color: #c4b5fd !important;
  }

  /* Hover tooltip styles */
  .hover-tooltip {
    position: fixed;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  .hover-tooltip.visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
    display: block !important;
  }

  /* Internal link preview */
  .hover-tooltip .internal-preview {
    border-left: 3px solid #3b82f6 !important;
    padding-left: 12px !important;
  }

  .hover-tooltip .internal-preview .title {
    font-weight: 600 !important;
    color: #3b82f6 !important;
    margin-bottom: 4px !important;
    font-size: 14px !important;
  }
  
  :global(.dark) .hover-tooltip .internal-preview .title {
    color: #60a5fa !important;
  }

  .hover-tooltip .internal-preview .description {
    font-size: 12px !important;
    line-height: 1.4 !important;
    margin-top: 4px !important;
    opacity: 0.8 !important;
  }

  /* External link preview */
  .hover-tooltip .external-preview {
    border-left: 3px solid #8b5cf6 !important;
    padding-left: 12px !important;
  }

  .hover-tooltip .external-preview .url {
    font-family: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, 'Courier New', monospace !important;
    font-size: 12px !important;
    color: #8b5cf6 !important;
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
    hyphens: auto !important;
    margin-bottom: 6px !important;
    line-height: 1.4 !important;
  }

  :global(.dark) .hover-tooltip .external-preview .url {
    color: #a78bfa !important;
  }
</style>

<script define:vars={{ previewsJson }}>
  function initLinkHoverEffects() {
    console.log('Initializing link hover effects...');
    
    // Parse build-time content previews
    const contentPreviews = JSON.parse(previewsJson);
    
    // Create tooltip element
    const tooltip = document.createElement('div');
    tooltip.className = 'hover-tooltip';
    document.body.appendChild(tooltip);
    
    // Classify and setup all links
    function setupLinks() {
      const proseElements = document.querySelectorAll('.prose');
      
      proseElements.forEach(prose => {
        const links = prose.querySelectorAll('a[href]');
        
        links.forEach(link => {
          const href = link.getAttribute('href');
          if (!href) return;
          
          // Determine if link is internal or external
          const isInternal = href.startsWith('/') || 
                           href.includes('__GHOST_URL__') || 
                           href.includes(window.location.hostname);
          
          // Apply permanent attributes for styling
          if (isInternal) {
            link.setAttribute('data-internal', '');
            link.removeAttribute('data-external');
            
            // Add content preview data for internal links
            const cleanHref = href.replace('__GHOST_URL__', '');
            const preview = contentPreviews[cleanHref];
            
            if (preview) {
              link.setAttribute('data-title', preview.title);
              if (preview.description) {
                link.setAttribute('data-description', preview.description);
              }
            }
          } else {
            link.setAttribute('data-external', '');
            link.removeAttribute('data-internal');
          }
          
          // Add hover events
          link.addEventListener('mouseenter', function(e) {
            showTooltip(e, href, isInternal);
          });
          
          link.addEventListener('mouseleave', function() {
            hideTooltip();
          });
          
          link.addEventListener('mousemove', function(e) {
            updateTooltipPosition(e);
          });
        });
      });
      

    }
    
    function showTooltip(event, href, isInternal) {
      let content = '';
      
      if (isInternal) {
        // Internal link preview - get data from attributes
        const cleanHref = href.replace('__GHOST_URL__', '');
        const urlParts = cleanHref.replace(/^\//, '').split('/');
        
        let title = 'Internal Link';
        let description = '';
        
        if (urlParts.length >= 2) {
          title = urlParts[1].replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        }
        
        // Check if the link has preview data
        const linkElement = event.target.closest('a');
        if (linkElement) {
          const dataTitle = linkElement.getAttribute('data-title');
          const dataDescription = linkElement.getAttribute('data-description');
          
          if (dataTitle) {
            title = dataTitle;
          }
          if (dataDescription) {
            description = dataDescription;
          }
        }
        
        content = `
          <div class="internal-preview">
            <div class="title">${title}</div>
            ${description ? `<div class="description">${description}</div>` : ''}
          </div>
        `;
      } else {
        // External link preview
        content = `
          <div class="external-preview">
            <div class="url">${href}</div>
          </div>
        `;
      }
      
      tooltip.innerHTML = content;
      
      // Apply inline styles with light/dark mode awareness
      const isDarkMode = document.documentElement.classList.contains('dark');
      
      if (isDarkMode) {
        tooltip.style.background = 'rgba(0, 0, 0, 0.95)';
        tooltip.style.color = 'white';
        tooltip.style.border = '1px solid rgba(255, 255, 255, 0.1)';
        tooltip.style.boxShadow = '0 4px 20px rgba(0, 0, 0, 0.3)';
      } else {
        tooltip.style.background = 'rgba(255, 255, 255, 0.95)';
        tooltip.style.color = '#1a1a1a';
        tooltip.style.border = '1px solid rgba(0, 0, 0, 0.1)';
        tooltip.style.boxShadow = '0 4px 20px rgba(0, 0, 0, 0.2)';
      }
      
      tooltip.style.padding = '12px 16px';
      tooltip.style.borderRadius = '8px';
      tooltip.style.fontSize = '14px';
      tooltip.style.zIndex = '9999';
      tooltip.style.pointerEvents = 'none';
      
      // Set different widths for internal vs external links
      if (isInternal) {
        tooltip.style.maxWidth = '300px';
        tooltip.style.minWidth = '150px';
      } else {
        tooltip.style.maxWidth = '400px';
        tooltip.style.minWidth = '100px';
      }
      
      tooltip.classList.add('visible');
      
      // Force show with inline styles to ensure it appears
      tooltip.style.display = 'block';
      tooltip.style.opacity = '1';
      tooltip.style.transform = 'translateY(0)';
      
      updateTooltipPosition(event);
      
      
    }
    
    function hideTooltip() {
      tooltip.classList.remove('visible');
      
      // Force hide with inline styles to ensure it disappears
      tooltip.style.opacity = '0';
      tooltip.style.transform = 'translateY(-10px)';
      
      // Clear the timeout to hide after a short delay
      setTimeout(() => {
        if (!tooltip.classList.contains('visible')) {
          tooltip.style.display = 'none';
        }
      }, 200);
    }
    
    function updateTooltipPosition(event) {
      const tooltipRect = tooltip.getBoundingClientRect();
      const viewportWidth = window.innerWidth;
      const viewportHeight = window.innerHeight;
      
      let left = event.clientX + 10;
      let top = event.clientY - tooltipRect.height - 10;
      
      // Keep tooltip within viewport
      if (left + tooltipRect.width > viewportWidth - 10) {
        left = event.clientX - tooltipRect.width - 10;
      }
      
      if (top < 10) {
        top = event.clientY + 10;
      }
      
      if (left < 10) {
        left = 10;
      }
      
      tooltip.style.left = left + 'px';
      tooltip.style.top = top + 'px';
    }
    

    
    // Initialize on DOM ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupLinks);
    } else {
      setupLinks();
    }
  }
  
  // Run the initialization
  initLinkHoverEffects();
</script> 