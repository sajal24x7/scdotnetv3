---
// Simple, reliable link hover effects component
---

<style>
  /* Permanent link colors for internal links (blue) */
  :global(.prose a[data-internal]) {
    color: #3b82f6 !important;
    text-decoration: none;
  }

  :global(.prose a[data-internal]:hover) {
    color: #2563eb !important;
    text-decoration: underline;
  }

  :global(.dark .prose a[data-internal]) {
    color: #60a5fa !important;
  }

  :global(.dark .prose a[data-internal]:hover) {
    color: #93c5fd !important;
  }

  /* Permanent link colors for external links (purple) */
  :global(.prose a[data-external]) {
    color: #8b5cf6 !important;
    text-decoration: none;
  }

  :global(.prose a[data-external]:hover) {
    color: #7c3aed !important;
    text-decoration: underline;
  }

  :global(.dark .prose a[data-external]) {
    color: #a78bfa !important;
  }

  :global(.dark .prose a[data-external]:hover) {
    color: #c4b5fd !important;
  }

  /* Hover tooltip styles */
  .hover-tooltip {
    position: fixed;
    background: rgba(0, 0, 0, 0.95);
    color: white;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 14px;
    max-width: 300px;
    z-index: 1000;
    pointer-events: none;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .hover-tooltip.visible {
    opacity: 1;
    transform: translateY(0);
  }

  :global(.dark) .hover-tooltip {
    background: rgba(255, 255, 255, 0.95);
    color: #1a1a1a;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  /* Internal link preview */
  .internal-preview {
    border-left: 3px solid #3b82f6;
    padding-left: 12px;
  }

  .internal-preview .title {
    font-weight: 600;
    color: #3b82f6;
    margin-bottom: 4px;
  }

  .internal-preview .category {
    font-size: 12px;
    opacity: 0.8;
  }

  :global(.dark) .internal-preview .title {
    color: #60a5fa;
  }

  /* External link preview */
  .external-preview {
    border-left: 3px solid #8b5cf6;
    padding-left: 12px;
  }

  .external-preview .url {
    font-family: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, 'Courier New', monospace;
    font-size: 12px;
    color: #8b5cf6;
    word-break: break-all;
    margin-bottom: 6px;
  }

  .external-preview .action {
    font-size: 12px;
    color: #8b5cf6;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  :global(.dark) .external-preview .url,
  :global(.dark) .external-preview .action {
    color: #a78bfa;
  }
</style>

<script>
  function initLinkHoverEffects() {
    console.log('Initializing link hover effects...');
    
    // Create tooltip element
    const tooltip = document.createElement('div');
    tooltip.className = 'hover-tooltip';
    document.body.appendChild(tooltip);
    
    // Classify and setup all links
    function setupLinks() {
      const proseElements = document.querySelectorAll('.prose');
      
      proseElements.forEach(prose => {
        const links = prose.querySelectorAll('a[href]');
        
        links.forEach(link => {
          const href = link.getAttribute('href');
          if (!href) return;
          
          // Determine if link is internal or external
          const isInternal = href.startsWith('/') || 
                           href.includes('__GHOST_URL__') || 
                           href.includes(window.location.hostname);
          
          // Apply permanent attributes for styling
          if (isInternal) {
            link.setAttribute('data-internal', '');
            link.removeAttribute('data-external');
          } else {
            link.setAttribute('data-external', '');
            link.removeAttribute('data-internal');
          }
          
          // Add hover events
          link.addEventListener('mouseenter', function(e) {
            showTooltip(e, href, isInternal);
          });
          
          link.addEventListener('mouseleave', function() {
            hideTooltip();
          });
          
          link.addEventListener('mousemove', function(e) {
            updateTooltipPosition(e);
          });
        });
      });
      
      console.log(`Processed ${document.querySelectorAll('.prose a[data-internal], .prose a[data-external]').length} links`);
    }
    
    function showTooltip(event, href, isInternal) {
      let content = '';
      
      if (isInternal) {
        // Internal link preview
        const cleanHref = href.replace('__GHOST_URL__', '');
        const urlParts = cleanHref.replace(/^\//, '').split('/');
        
        let title = 'Internal Link';
        let category = '';
        
        if (urlParts.length >= 2) {
          category = urlParts[0];
          title = urlParts[1].replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        }
        
        content = `
          <div class="internal-preview">
            <div class="title">${title}</div>
            <div class="category">Category: ${category}</div>
          </div>
        `;
      } else {
        // External link preview
        content = `
          <div class="external-preview">
            <div class="url">${href}</div>
            <div class="action">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17l9.2-9.2M17 17V7H7"/>
              </svg>
              Open in new tab
            </div>
          </div>
        `;
      }
      
      tooltip.innerHTML = content;
      tooltip.classList.add('visible');
      updateTooltipPosition(event);
    }
    
    function hideTooltip() {
      tooltip.classList.remove('visible');
    }
    
    function updateTooltipPosition(event) {
      const tooltipRect = tooltip.getBoundingClientRect();
      const viewportWidth = window.innerWidth;
      const viewportHeight = window.innerHeight;
      
      let left = event.clientX + 10;
      let top = event.clientY - tooltipRect.height - 10;
      
      // Keep tooltip within viewport
      if (left + tooltipRect.width > viewportWidth - 10) {
        left = event.clientX - tooltipRect.width - 10;
      }
      
      if (top < 10) {
        top = event.clientY + 10;
      }
      
      if (left < 10) {
        left = 10;
      }
      
      tooltip.style.left = left + 'px';
      tooltip.style.top = top + 'px';
    }
    
    // Initialize on DOM ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupLinks);
    } else {
      setupLinks();
    }
  }
  
  // Run the initialization
  initLinkHoverEffects();
</script> 