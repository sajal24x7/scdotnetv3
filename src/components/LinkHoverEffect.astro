---
import { getContentPreviewCategories } from '../data/contentPreviewStore';

const previewCategories = await getContentPreviewCategories();
---

<!-- The hover card element is created by the script below and appended to <body>,
     so these styles must be global — scoped selectors would require Astro's
     scope attribute, which JS-created elements never carry. -->
<style is:global>
  .hover-tooltip {
    position: fixed;
    z-index: 9999;
    display: none;
    flex-direction: column;
    width: min(460px, calc(100vw - 24px));
    max-height: 420px;
    overflow: hidden;
    border-radius: 10px;
    background: rgb(var(--color-bg));
    color: #1a1a1a;
    border: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.15s ease, transform 0.15s ease;
    pointer-events: none;
    font-size: var(--text-small);
    line-height: 1.5;
    text-align: left;
  }

  .dark .hover-tooltip {
    color: #f5f5f5;
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .hover-tooltip.visible {
    opacity: 1;
    transform: translateY(0);
    /* Interactive while shown so links inside the excerpt stay clickable. */
    pointer-events: auto;
  }

  /* Generic targets (e.g. learn wall-chart tiles) carry short strings, so the
     card shrinks to fit instead of holding the fixed preview width. */
  .hover-tooltip--fit {
    width: max-content;
    min-width: 160px;
    max-width: min(460px, calc(100vw - 24px));
  }

  .hover-tooltip__scroll {
    /* No scrollbar: the excerpt is pre-truncated to fit, and anything left
       over is simply clipped rather than made scrollable. */
    overflow: hidden;
    padding: 12px 16px;
  }

  /* Bottom fade signalling the excerpt is cut off — read more via the link. */
  .hover-tooltip::after {
    content: '';
    position: absolute;
    left: 1px;
    right: 1px;
    bottom: 1px;
    height: 28px;
    border-radius: 0 0 9px 9px;
    background: linear-gradient(to bottom, rgba(var(--color-bg), 0), rgba(var(--color-bg), 0.97));
    opacity: 0;
    transition: opacity 0.15s ease;
    pointer-events: none;
  }

  .hover-tooltip.has-overflow::after {
    opacity: 1;
  }

  /* Internal link preview */
  .hover-tooltip .internal-preview {
    border-left: 3px solid #3b82f6;
    padding-left: 12px;
  }

  .hover-tooltip .internal-preview .title {
    font-weight: 600;
    color: #3b82f6;
    margin-bottom: 4px;
    font-size: var(--text-small);
  }

  .dark .hover-tooltip .internal-preview .title {
    color: #60a5fa;
  }

  .hover-tooltip .internal-preview .description {
    font-size: var(--text-xs);
    line-height: 1.4;
    margin-top: 4px;
    opacity: 0.8;
  }

  /* Post-body excerpt rendered inside the card */
  .hover-tooltip .internal-preview .excerpt {
    margin-top: 8px;
    font-size: var(--text-xs);
    line-height: 1.55;
  }

  .hover-tooltip .excerpt p,
  .hover-tooltip .excerpt ul,
  .hover-tooltip .excerpt ol,
  .hover-tooltip .excerpt blockquote,
  .hover-tooltip .excerpt pre {
    margin: 0 0 0.6em;
  }

  .hover-tooltip .excerpt > :last-child {
    margin-bottom: 0;
  }

  .hover-tooltip .excerpt h1,
  .hover-tooltip .excerpt h2,
  .hover-tooltip .excerpt h3,
  .hover-tooltip .excerpt h4,
  .hover-tooltip .excerpt h5,
  .hover-tooltip .excerpt h6 {
    font-size: var(--text-xs);
    font-weight: 600;
    margin: 0.8em 0 0.3em;
  }

  .hover-tooltip .excerpt ul,
  .hover-tooltip .excerpt ol {
    padding-left: 1.2em;
  }

  .hover-tooltip .excerpt ul {
    list-style: disc;
  }

  .hover-tooltip .excerpt ol {
    list-style: decimal;
  }

  .hover-tooltip .excerpt blockquote {
    border-left: 2px solid currentColor;
    padding-left: 0.8em;
    opacity: 0.8;
  }

  .hover-tooltip .excerpt code {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .hover-tooltip .excerpt pre {
    background: rgba(0, 0, 0, 0.05);
    padding: 8px;
    border-radius: 6px;
    overflow-x: auto;
  }

  .dark .hover-tooltip .excerpt pre {
    background: rgba(255, 255, 255, 0.08);
  }

  .hover-tooltip .excerpt a {
    color: rgb(var(--color-accent));
    text-decoration: underline;
  }

  /* External link preview */
  .hover-tooltip .external-preview {
    border-left: 3px solid rgb(var(--color-accent));
    padding-left: 12px;
  }

  .hover-tooltip .external-preview .url {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: rgb(var(--color-accent));
    word-wrap: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
    line-height: 1.4;
  }

  .dark .hover-tooltip .external-preview .url {
    color: #a78bfa;
  }
</style>


<script is:inline define:vars={{ previewCategories }}>
    (function () {
        const PREVIEW_KEY = '__SC_LINK_PREVIEWS__';
        const STATE_KEY = '__SC_LINK_HOVER_STATE__';
        const PREVIEW_BASE_URL = '/api/link-previews';
        const AVAILABLE_SEGMENTS = new Set(previewCategories);
        const SHOW_DELAY_MS = 250;
        const HIDE_DELAY_MS = 300;

        const existing = window[PREVIEW_KEY];
        const previewMap = existing instanceof Map ? existing : new Map();

        if (!(existing instanceof Map)) {
            window[PREVIEW_KEY] = previewMap;
        }

        const defaultState = {
            processed: new WeakSet(),
            initialized: false,
            currentLink: null,
            prefetched: false
        };
        const state = window[STATE_KEY] || defaultState;

        if (!state.processed) {
            state.processed = new WeakSet();
        }

        state.scheduled = state.scheduled || false;
        state.prefetched = state.prefetched || false;
        state.currentLink = state.currentLink || null;
        state.loadedSegments = state.loadedSegments instanceof Set ? state.loadedSegments : new Set();
        state.pendingSegments = state.pendingSegments instanceof Set ? state.pendingSegments : new Set();
        state.segmentFetches = state.segmentFetches instanceof Map ? state.segmentFetches : new Map();
        state.prefetchScheduled = state.prefetchScheduled === true;
        window[STATE_KEY] = state;

        const processedLinks = state.processed;
        const loadedSegments = state.loadedSegments;
        const pendingSegments = state.pendingSegments;
        const segmentFetches = state.segmentFetches;

        // Timers live on the shared state so listeners registered by earlier
        // page loads (Astro swaps re-run this script in the same realm) all
        // cancel each other correctly.
        const hideTooltip = () => {
            const tooltip = state.tooltip;
            if (!tooltip) {
                return;
            }

            clearTimeout(state.showTimer);
            tooltip.classList.remove('visible');

            clearTimeout(state.displayTimer);
            state.displayTimer = window.setTimeout(() => {
                if (!tooltip.classList.contains('visible')) {
                    tooltip.style.display = 'none';
                }
            }, 180);

            state.currentLink = null;
        };

        const scheduleHide = () => {
            clearTimeout(state.hideTimer);
            state.hideTimer = window.setTimeout(hideTooltip, HIDE_DELAY_MS);
        };

        const updateOverflowFade = () => {
            const tooltip = state.tooltip;
            const scrollEl = state.scrollEl;
            if (!tooltip || !scrollEl) {
                return;
            }

            const overflowing = scrollEl.scrollHeight - scrollEl.scrollTop - scrollEl.clientHeight > 4;
            tooltip.classList.toggle('has-overflow', overflowing);
        };

        const ensureTooltip = () => {
            if (state.tooltip && document.body.contains(state.tooltip)) {
                if (!state.scrollEl || !state.tooltip.contains(state.scrollEl)) {
                    state.scrollEl = state.tooltip.querySelector('.hover-tooltip__scroll');
                }
                return state.tooltip;
            }

            if (!document.body) {
                return null;
            }

            const tooltip = document.createElement('div');
            tooltip.className = 'hover-tooltip';
            tooltip.style.display = 'none';

            const scrollEl = document.createElement('div');
            scrollEl.className = 'hover-tooltip__scroll';
            tooltip.appendChild(scrollEl);

            // Keep the card open while the pointer is over it, so the excerpt
            // can be scrolled; leaving it starts the hide countdown.
            tooltip.addEventListener('mouseenter', () => {
                clearTimeout(state.hideTimer);
            });
            tooltip.addEventListener('mouseleave', scheduleHide);

            document.body.appendChild(tooltip);
            state.tooltip = tooltip;
            state.scrollEl = scrollEl;
            return tooltip;
        };

        const tooltip = ensureTooltip();

        if (!tooltip) {
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', () => {
                    ensureTooltip();
                }, { once: true });
            }
            return;
        }

        const renderInternalPreview = (title, description, excerptHtml) => {
            const scrollEl = state.scrollEl;

            const container = document.createElement('div');
            container.className = 'internal-preview';

            const titleEl = document.createElement('div');
            titleEl.className = 'title';
            titleEl.textContent = title;
            container.appendChild(titleEl);

            if (excerptHtml) {
                const excerptEl = document.createElement('div');
                excerptEl.className = 'excerpt';
                // Excerpt HTML is generated and sanitized at build time.
                excerptEl.innerHTML = excerptHtml;
                container.appendChild(excerptEl);
            } else if (description) {
                const descriptionEl = document.createElement('div');
                descriptionEl.className = 'description';
                descriptionEl.textContent = description;
                container.appendChild(descriptionEl);
            }

            scrollEl.replaceChildren(container);
            scrollEl.scrollTop = 0;
        };

        const renderExternalPreview = (href) => {
            const scrollEl = state.scrollEl;

            const container = document.createElement('div');
            container.className = 'external-preview';

            const urlEl = document.createElement('div');
            urlEl.className = 'url';
            urlEl.textContent = href;
            container.appendChild(urlEl);

            scrollEl.replaceChildren(container);
            scrollEl.scrollTop = 0;
        };

        // Anchor the fixed-size card to the hovered element: below it when
        // there is room, above it otherwise, clamped to the viewport.
        const positionTooltip = (target) => {
            if (!target || !target.isConnected) {
                return;
            }

            const rect = target.getBoundingClientRect();
            tooltip.style.display = 'flex';

            const viewportWidth = window.innerWidth;
            const viewportHeight = window.innerHeight;
            const width = tooltip.offsetWidth;
            const height = tooltip.offsetHeight;

            const left = Math.min(Math.max(rect.left, 12), Math.max(12, viewportWidth - width - 12));

            let top;
            if (rect.bottom + 8 + height <= viewportHeight - 12) {
                top = rect.bottom + 8;
            } else if (rect.top - 8 - height >= 12) {
                top = rect.top - 8 - height;
            } else {
                top = Math.max(12, viewportHeight - height - 12);
            }

            tooltip.style.left = `${left}px`;
            tooltip.style.top = `${top}px`;
        };

        const revealTooltip = (target) => {
            clearTimeout(state.displayTimer);
            tooltip.style.display = 'flex';
            positionTooltip(target);
            tooltip.classList.add('visible');
            updateOverflowFade();
        };

        const normalizeHref = (href) => {
            if (!href) {
                return '';
            }

            if (href.startsWith('#')) {
                return '';
            }

            let cleanHref = href.replace('__GHOST_URL__', '');

            if (cleanHref.includes('sajalchoudhary.net') || cleanHref.startsWith('http')) {
                try {
                    const url = new URL(cleanHref, window.location.origin);
                    cleanHref = url.pathname;
                } catch (error) {
                    const match = cleanHref.match(/sajalchoudhary\.net(\/.*)/);
                    if (match) {
                        cleanHref = match[1];
                    }
                }
            }

            if (!cleanHref.startsWith('/')) {
                cleanHref = `/${cleanHref.replace(/^\/*/, '')}`;
            }

            const withTrailingSlash = cleanHref.endsWith('/') ? cleanHref : `${cleanHref}/`;
            return withTrailingSlash;
        };

        const getSegmentFromPath = (path) => {
            if (!path) {
                return '';
            }

            const parts = path.split('/').filter(Boolean);
            return parts.length > 0 ? parts[0] : '';
        };

        const ensureSegmentPreviewsLoaded = async (segment) => {
            if (!segment || loadedSegments.has(segment) || !AVAILABLE_SEGMENTS.has(segment)) {
                loadedSegments.add(segment);
                return previewMap;
            }

            let fetchPromise = segmentFetches.get(segment);

            if (!fetchPromise) {
                const url = `${PREVIEW_BASE_URL}/${encodeURIComponent(segment)}.json`;

                fetchPromise = fetch(url, {
                    headers: {
                        Accept: 'application/json'
                    }
                })
                    .then((response) => {
                        if (!response.ok) {
                            throw new Error(`Failed to load link previews for ${segment}: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then((data) => {
                        if (data && typeof data === 'object') {
                            for (const [path, preview] of Object.entries(data)) {
                                previewMap.set(path, preview);
                            }
                        }
                        loadedSegments.add(segment);
                        return previewMap;
                    })
                    .catch((error) => {
                        console.error('Link preview fetch failed', segment, error);
                        loadedSegments.add(segment);
                        return previewMap;
                    })
                    .finally(() => {
                        segmentFetches.delete(segment);
                    });

                segmentFetches.set(segment, fetchPromise);
            }

            return fetchPromise;
        };

        const scheduleSegmentPrefetch = () => {
            if (state.prefetchScheduled || pendingSegments.size === 0) {
                return;
            }

            state.prefetchScheduled = true;

            const runPrefetch = () => {
                state.prefetchScheduled = false;

                const segmentsToLoad = Array.from(pendingSegments);
                pendingSegments.clear();

                segmentsToLoad.forEach((segment) => {
                    if (!loadedSegments.has(segment)) {
                        void ensureSegmentPreviewsLoaded(segment);
                    }
                });
            };

            const idle = window.requestIdleCallback;

            if (typeof idle === 'function') {
                idle(runPrefetch, { timeout: 2000 });
                return;
            }

            window.setTimeout(runPrefetch, 1500);
        };

        const lookupPreview = (link) => {
            const normalized = link.dataset.previewPath || '';
            if (!normalized) {
                return null;
            }

            const fallback = link.dataset.previewFallback || normalized.replace(/\/$/, '');
            return previewMap.get(normalized) || previewMap.get(fallback) || null;
        };

        const applyPreviewData = (link) => {
            const preview = lookupPreview(link);
            const isCurrent = state.tooltip
                && state.tooltip.classList.contains('visible')
                && state.currentLink === link;

            if (!preview) {
                // No preview data for this path (e.g. a stale link): if the
                // card is showing its loading state, settle on title only.
                if (isCurrent) {
                    const titleText = link.getAttribute('data-title') || (link.textContent ? link.textContent.trim() : 'Internal Link');
                    renderInternalPreview(titleText, link.getAttribute('data-description') || '', '');
                    positionTooltip(link);
                    updateOverflowFade();
                }
                return;
            }

            if (preview.title) {
                link.setAttribute('data-title', preview.title);
            }
            if (preview.description) {
                link.setAttribute('data-description', preview.description);
            }

            if (isCurrent) {
                const titleText = preview.title || (link.textContent ? link.textContent.trim() : 'Internal Link');
                renderInternalPreview(titleText, preview.description || '', preview.excerpt || '');
                positionTooltip(link);
                updateOverflowFade();
            }
        };

        const isInternalHref = (href) => {
            if (!href) {
                return false;
            }

            if (href.startsWith('#')) {
                return false;
            }

            if (href.startsWith('/')) {
                return true;
            }

            if (href.includes('__GHOST_URL__')) {
                return true;
            }

            try {
                const url = new URL(href, window.location.origin);
                return url.hostname === window.location.hostname || url.hostname === 'sajalchoudhary.net';
            } catch (error) {
                return false;
            }
        };

        const showGenericTooltip = (el) => {
            clearTimeout(state.hideTimer);
            state.currentLink = el;
            tooltip.classList.add('hover-tooltip--fit');

            const title = el.dataset.hoverTitle || (el.textContent ? el.textContent.trim() : '');
            const description = el.dataset.hoverDescription || '';
            renderInternalPreview(title, description, '');

            revealTooltip(el);
        };

        const showTooltip = (link, isInternal) => {
            clearTimeout(state.hideTimer);
            state.currentLink = link;
            tooltip.classList.remove('hover-tooltip--fit');

            if (isInternal) {
                const dataTitle = link.getAttribute('data-title');
                const dataDescription = link.getAttribute('data-description');
                const fallbackTitle = link.textContent ? link.textContent.trim() : 'Internal Link';
                const segment = link.dataset.previewSegment || '';
                const preview = lookupPreview(link);

                if (preview) {
                    renderInternalPreview(preview.title || dataTitle || fallbackTitle, preview.description || dataDescription || '', preview.excerpt || '');
                } else if (segment && AVAILABLE_SEGMENTS.has(segment) && !loadedSegments.has(segment)) {
                    renderInternalPreview(dataTitle || fallbackTitle, 'Loading preview…', '');
                    void ensureSegmentPreviewsLoaded(segment).then(() => {
                        applyPreviewData(link);
                    });
                } else {
                    renderInternalPreview(dataTitle || fallbackTitle, dataDescription || '', '');
                }
            } else {
                renderExternalPreview(link.href || link.getAttribute('href') || '');
            }

            revealTooltip(link);
        };

        const scheduleShow = (show) => {
            clearTimeout(state.hideTimer);
            clearTimeout(state.showTimer);
            state.showTimer = window.setTimeout(show, SHOW_DELAY_MS);
        };

        const cancelShow = () => {
            clearTimeout(state.showTimer);
            scheduleHide();
        };

        const handleGenericTarget = (el) => {
            if (processedLinks.has(el)) {
                return;
            }

            processedLinks.add(el);

            el.addEventListener('mouseenter', () => {
                scheduleShow(() => showGenericTooltip(el));
            });

            el.addEventListener('mouseleave', cancelShow);
        };

        const handleLink = (link) => {
            if (processedLinks.has(link)) {
                return;
            }

            processedLinks.add(link);

            const href = link.getAttribute('href');
            if (!href || href.startsWith('#') || link.classList.contains('no-hover-effect')) {
                return;
            }

            const isInternal = isInternalHref(href);

            if (isInternal) {
                const normalized = normalizeHref(href);
                if (!normalized) {
                    return;
                }

                const fallback = normalized.replace(/\/$/, '');
                const segment = getSegmentFromPath(normalized);

                link.dataset.previewPath = normalized;
                link.dataset.previewFallback = fallback;

                if (segment) {
                    link.dataset.previewSegment = segment;
                } else {
                    delete link.dataset.previewSegment;
                }

                if (segment && AVAILABLE_SEGMENTS.has(segment) && !loadedSegments.has(segment)) {
                    pendingSegments.add(segment);
                    scheduleSegmentPrefetch();
                }

                applyPreviewData(link);
                link.setAttribute('data-internal', '');
                link.removeAttribute('data-external');
            } else {
                link.setAttribute('data-external', '');
                link.removeAttribute('data-internal');
            }

            link.addEventListener('mouseenter', () => {
                scheduleShow(() => showTooltip(link, isInternal));
            });

            link.addEventListener('mouseleave', cancelShow);
        };

        const setupLinks = () => {
            const proseElements = document.querySelectorAll('.prose');

            proseElements.forEach((prose) => {
                const links = prose.querySelectorAll('a[href]');
                links.forEach(handleLink);
            });

            // Non-link elements (e.g. wall-chart tiles) opt in with
            // data-hover-title/-description to get the same hover card,
            // independent of .prose.
            const genericTargets = document.querySelectorAll('[data-hover-title]');
            genericTargets.forEach(handleGenericTarget);
        };

        const scheduleSetup = () => {
            if (state.scheduled) {
                return;
            }

            state.scheduled = true;

            requestAnimationFrame(() => {
                state.scheduled = false;
                setupLinks();
            });
        };

        if (!state.initialized) {
            state.initialized = true;

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', scheduleSetup, { once: true });
            } else {
                scheduleSetup();
            }

            window.addEventListener('load', scheduleSetup);

            const observer = new MutationObserver(scheduleSetup);
            observer.observe(document.body, { childList: true, subtree: true });
            state.observer = observer;

            document.addEventListener('astro:after-swap', scheduleSetup);

            // Touch devices fire the emulated mouseenter on tap but never
            // mouseleave, so the card would stick until reload. Dismiss it
            // when the user taps/clicks outside the hovered link or the card
            // itself, scrolls, or returns to a bfcache-restored page.
            document.addEventListener('pointerdown', (event) => {
                if (!state.tooltip || !state.tooltip.classList.contains('visible')) {
                    return;
                }
                const target = event.target;
                if (target instanceof Node) {
                    if (state.currentLink && state.currentLink.contains(target)) {
                        return;
                    }
                    if (state.tooltip.contains(target)) {
                        return;
                    }
                }
                hideTooltip();
            }, { passive: true });

            // Element scroll events don't bubble to window, so scrolling the
            // excerpt inside the card does not trigger this dismissal.
            window.addEventListener('scroll', () => {
                if (state.tooltip && state.tooltip.classList.contains('visible')) {
                    hideTooltip();
                }
            }, { passive: true });

            window.addEventListener('pageshow', (event) => {
                if (event.persisted && state.tooltip) {
                    hideTooltip();
                }
            });
        } else {
            scheduleSetup();
        }
    })();
</script>
