---
// Simple, reliable link hover effects component
import { generateContentPreviews, escapeHtml } from '../utils/contentPreview';

// Generate content previews at build time
const contentPreviews = await generateContentPreviews();
const previewsJson = JSON.stringify(Object.fromEntries(contentPreviews));
---

<style>
  /* Persistent yellow highlight for all prose links (manuelmoreale.com style) */
  :global(.prose a) {
    background-color: #FFFF00; /* Pure yellow - manuelmoreale.com color */
    color: inherit;
    text-decoration: none;
    padding: 0 2px;
    transition: background-color 0.2s ease;
  }

  /* Darker yellow highlight on hover */
  :global(.prose a:hover) {
    background-color: #FFD700; /* Gold - darker yellow for hover */
  }

  /* Dark mode adjustments */
  :global(.dark .prose a) {
    background-color: #FFFF00; /* Keep same yellow in dark mode */
  }

  :global(.dark .prose a:hover) {
    background-color: #FFD700; /* Keep same gold in dark mode */
  }

  /* Hover tooltip styles */
  .hover-tooltip {
    position: fixed;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  .hover-tooltip.visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
    display: block !important;
  }

  /* Link preview styling with manuelmoreale.com yellow accent */
  .hover-tooltip .internal-preview,
  .hover-tooltip .external-preview {
    border-left: 3px solid #FFFF00 !important;
    padding-left: 12px !important;
  }

  .hover-tooltip .internal-preview .title {
    font-weight: 600 !important;
    color: #FFFF00 !important;
    margin-bottom: 4px !important;
    font-size: 14px !important;
  }
  
  :global(.dark) .hover-tooltip .internal-preview .title {
    color: #FFFF00 !important;
  }

  .hover-tooltip .internal-preview .description {
    font-size: 12px !important;
    line-height: 1.4 !important;
    margin-top: 4px !important;
    opacity: 0.8 !important;
  }

  .hover-tooltip .external-preview .url {
    font-family: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, 'Courier New', monospace !important;
    font-size: 12px !important;
    color: #FFFF00 !important;
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
    hyphens: auto !important;
    margin-bottom: 6px !important;
    line-height: 1.4 !important;
  }

  :global(.dark) .hover-tooltip .external-preview .url {
    color: #FFFF00 !important;
  }
</style>

<script define:vars={{ previewsJson }}>
  function initLinkHoverEffects() {
    // Parse build-time content previews
    const contentPreviews = JSON.parse(previewsJson);
    
    // Create tooltip element
    const tooltip = document.createElement('div');
    tooltip.className = 'hover-tooltip';
    document.body.appendChild(tooltip);
    
    // Classify and setup all links
    function setupLinks() {
      const proseElements = document.querySelectorAll('.prose');
      
      proseElements.forEach(prose => {
        const links = prose.querySelectorAll('a[href]');
        
        links.forEach(link => {
          const href = link.getAttribute('href');
          if (!href) return;
          
          // Skip links with no-hover-effect class
          if (link.classList.contains('no-hover-effect')) return;
          
          // Determine if link is internal or external for tooltip purposes
          const isInternal = href.startsWith('/') || 
                           href.includes('__GHOST_URL__') || 
                           href.includes(window.location.hostname) ||
                           href.includes('sajalchoudhary.net');
          
          // Add content preview data for internal links (for tooltips only)
          if (isInternal) {
            let cleanHref = href.replace('__GHOST_URL__', '');
            
            // Extract path from full domain URLs
            if (cleanHref.includes('sajalchoudhary.net')) {
              try {
                const url = new URL(cleanHref);
                cleanHref = url.pathname;
              } catch (e) {
                // If URL parsing fails, try to extract path manually
                const match = cleanHref.match(/sajalchoudhary\.net(\/.*)/);
                if (match) {
                  cleanHref = match[1];
                }
              }
            }
            
            const preview = contentPreviews[cleanHref];
            
            if (preview) {
              link.setAttribute('data-title', preview.title);
              if (preview.description) {
                link.setAttribute('data-description', preview.description);
              }
            }
          }
          
          // Add hover events
          link.addEventListener('mouseenter', function(e) {
            showTooltip(e, href, isInternal);
          });
          
          link.addEventListener('mouseleave', function() {
            hideTooltip();
          });
          
          link.addEventListener('mousemove', function(e) {
            updateTooltipPosition(e, isInternal);
          });
        });
      });
      

    }
    
    function showTooltip(event, href, isInternal) {
      let content = '';
      
      if (isInternal) {
        // Internal link preview - get data from attributes
        let cleanHref = href.replace('__GHOST_URL__', '');
        
        // Extract path from full domain URLs
        if (cleanHref.includes('sajalchoudhary.net')) {
          try {
            const url = new URL(cleanHref);
            cleanHref = url.pathname;
          } catch (e) {
            // If URL parsing fails, try to extract path manually
            const match = cleanHref.match(/sajalchoudhary\.net(\/.*)/);
            if (match) {
              cleanHref = match[1];
            }
          }
        }
        
        const urlParts = cleanHref.replace(/^\//, '').split('/');
        
        let title = 'Internal Link';
        let description = '';
        
        if (urlParts.length >= 2) {
          title = urlParts[1].replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        }
        
        // Check if the link has preview data
        const linkElement = event.target.closest('a');
        let hasPreviewData = false;
        
        if (linkElement) {
          const dataTitle = linkElement.getAttribute('data-title');
          const dataDescription = linkElement.getAttribute('data-description');
          
          if (dataTitle) {
            title = dataTitle;
            hasPreviewData = true;
          }
          if (dataDescription) {
            description = dataDescription;
            hasPreviewData = true;
          }
        }
        
        // If no preview data found, fall back to showing the URL
        if (!hasPreviewData) {
          content = `
            <div class="external-preview">
              <div class="url">${href}</div>
            </div>
          `;
        } else {
          content = `
            <div class="internal-preview">
              <div class="title">${title}</div>
              ${description ? `<div class="description">${description}</div>` : ''}
            </div>
          `;
        }
      } else {
        // External link preview
        content = `
          <div class="external-preview">
            <div class="url">${href}</div>
          </div>
        `;
      }
      
      tooltip.innerHTML = content;
      
      // Apply inline styles with light/dark mode awareness
      const isDarkMode = document.documentElement.classList.contains('dark');
      
      if (isDarkMode) {
        tooltip.style.background = 'rgba(0, 0, 0, 0.95)';
        tooltip.style.color = 'white';
        tooltip.style.border = '1px solid rgba(255, 255, 255, 0.1)';
        tooltip.style.boxShadow = '0 4px 20px rgba(0, 0, 0, 0.3)';
      } else {
        tooltip.style.background = 'rgba(255, 255, 255, 0.95)';
        tooltip.style.color = '#1a1a1a';
        tooltip.style.border = '1px solid rgba(0, 0, 0, 0.1)';
        tooltip.style.boxShadow = '0 4px 20px rgba(0, 0, 0, 0.2)';
      }
      
      tooltip.style.padding = '12px 16px';
      tooltip.style.borderRadius = '8px';
      tooltip.style.fontSize = '14px';
      tooltip.style.zIndex = '9999';
      tooltip.style.pointerEvents = 'none';
      
      // Set different widths for internal vs external links
      if (isInternal) {
        tooltip.style.maxWidth = '300px';
        tooltip.style.minWidth = '150px';
      } else {
        tooltip.style.maxWidth = '400px';
        tooltip.style.minWidth = '100px';
      }
      
      tooltip.classList.add('visible');
      
      // Force show with inline styles to ensure it appears
      tooltip.style.display = 'block';
      tooltip.style.opacity = '1';
      tooltip.style.transform = 'translateY(0)';
      
      updateTooltipPosition(event, isInternal);
      
      
    }
    
    function hideTooltip() {
      console.log('=== HIDING TOOLTIP ===');
      tooltip.classList.remove('visible');
      
      // Force hide with inline styles to ensure it disappears
      tooltip.style.opacity = '0';
      tooltip.style.transform = 'translateY(-10px)';
      
      console.log('Set tooltip opacity: 0, transform: translateY(-10px)');
      
      // Clear the timeout to hide after a short delay
      setTimeout(() => {
        if (!tooltip.classList.contains('visible')) {
          tooltip.style.display = 'none';
          console.log('Tooltip hidden after timeout');
        }
      }, 200);
    }
    
    function updateTooltipPosition(event, isInternal) {
      console.log('=== UPDATING TOOLTIP POSITION ===');
      console.log('Mouse position:', { clientX: event.clientX, clientY: event.clientY });
      
      // Force proper positioning styles first
      tooltip.style.position = 'fixed';
      tooltip.style.zIndex = '9999';
      
      // Use approximate dimensions (no need for getBoundingClientRect which is problematic)
      const tooltipWidth = isInternal ? 300 : 400;  // Use our configured widths
      const tooltipHeight = 80; // Approximate height
      
      const viewportWidth = window.innerWidth;
      const viewportHeight = window.innerHeight;
      
      console.log('Using dimensions:', { width: tooltipWidth, height: tooltipHeight });
      console.log('Viewport:', { width: viewportWidth, height: viewportHeight });
      
      let left = event.clientX + 10;
      let top = event.clientY - tooltipHeight - 10;
      
      console.log('Initial position:', { left, top });
      
      // Keep tooltip within viewport
      if (left + tooltipWidth > viewportWidth - 10) {
        left = event.clientX - tooltipWidth - 10;
        console.log('Adjusted left for viewport:', left);
      }
      
      if (top < 10) {
        top = event.clientY + 10;
        console.log('Adjusted top for viewport:', top);
      }
      
      if (left < 10) {
        left = 10;
        console.log('Adjusted left minimum:', left);
      }
      
      // Set position directly
      tooltip.style.left = left + 'px';
      tooltip.style.top = top + 'px';
      
      console.log('Final position set:', { left: left + 'px', top: top + 'px' });
      
      // Force a repaint
      tooltip.offsetHeight;
      
      // Check if it's actually visible now
      const rect = tooltip.getBoundingClientRect();
      console.log('Tooltip now at:', { 
        x: rect.x, 
        y: rect.y, 
        visible: rect.y >= 0 && rect.y < viewportHeight 
      });
    }
    

    
    // Initialize with multiple triggers to ensure it runs properly
    let isInitialized = false;
    
    function safeSetupLinks() {
      if (isInitialized) return;
      
      const proseElements = document.querySelectorAll('.prose');
      if (proseElements.length === 0) {
        // If no prose elements found, try again after a short delay
        setTimeout(safeSetupLinks, 100);
        return;
      }
      
      setupLinks();
      isInitialized = true;
      console.log('Link hover effects initialized successfully');
    }
    
    // Multiple initialization triggers
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', safeSetupLinks);
    } else {
      safeSetupLinks();
    }
    
    // Backup initialization after page load
    window.addEventListener('load', safeSetupLinks);
    
    // Additional trigger for Astro hydration
    setTimeout(safeSetupLinks, 500);
  }
  
  // Run the initialization
  initLinkHoverEffects();
</script> 