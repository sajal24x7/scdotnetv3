---
import { getAllPosts } from '../utils/content';
const allPosts = await getAllPosts();
// Force rebuild - search page removed
---

<div class="search-container mb-8">
  <div class="search-form">
    <input 
      type="text" 
      id="search-input"
      placeholder="Search posts or try 'tag:ai'..." 
      class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
    />
  </div>
  <div id="search-results" class="mt-4 hidden bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-lg shadow-lg max-h-96 overflow-y-auto"></div>
</div>

<script define:vars={{ allPosts }}>
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  
  function performSearch() {
    const query = searchInput.value.toLowerCase().trim();
    
    if (query.length < 2) {
      searchResults.classList.add('hidden');
      return;
    }
    
    let results = [];
    
    // Tag search
    if (query.startsWith('tag:')) {
      const tagQuery = query.substring(4);
      results = allPosts.filter(post => {
        if (!post.data.tags) return false;
        return post.data.tags.some(tag => tag.toLowerCase() === tagQuery);
      });
    } else {
      // Regular search
      results = allPosts.filter(post => {
        const title = post.data.title?.toLowerCase() || '';
        const category = post.data.category?.toLowerCase() || '';
        const description = post.data.description?.toLowerCase() || '';
        const tags = post.data.tags || [];
        
        return title.includes(query) || 
               category.includes(query) ||
               description.includes(query) ||
               tags.some(tag => tag.toLowerCase().includes(query));
      });
    }
    
    if (results.length > 0) {
      searchResults.innerHTML = results.slice(0, 8).map(post => {
        const tags = post.data.tags || [];
        const tagBadges = tags.slice(0, 2).map(tag => 
          `<span class="inline-block bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-xs px-2 py-1 rounded-full mr-1">${tag}</span>`
        ).join('');
        
        return `<a href="/${post.data.category}/${post.slug}/" class="block p-3 hover:bg-gray-100 dark:hover:bg-gray-700 border-b border-gray-200 dark:border-gray-600 last:border-b-0 transition-colors">
          <h3 class="font-semibold mb-1 text-gray-900 dark:text-gray-100">${post.data.title || 'Untitled'}</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">${post.data.category}</p>
          ${tags.length > 0 ? `<div>${tagBadges}</div>` : ''}
        </a>`;
      }).join('');
      searchResults.classList.remove('hidden');
    } else {
      searchResults.innerHTML = `<div class="p-4 text-center text-gray-600 dark:text-gray-400">
        <div class="mb-2">No results found for "<strong>${query}</strong>"</div>
        <div class="text-sm">Try searching for "AI", "blog", or "tag:ai"</div>
      </div>`;
      searchResults.classList.remove('hidden');
    }
  }
  
  searchInput.addEventListener('input', performSearch);
</script>