---
import { getAllPosts } from '../utils/content';

interface Props {
  category: string;
  title?: string;
  maxTags?: number;
  showMore?: boolean;
}

const { category, title = "Tagged with:", maxTags = 10, showMore = true } = Astro.props;

// Get all posts and filter by category
const allPosts = await getAllPosts();
let filteredPosts = allPosts;

// Handle special cases for categories that include multiple subcategories
if (category === 'garden') {
  filteredPosts = allPosts.filter(post => 
    ['evergreen', 'til', 'bookshelf', 'story', 'poem'].includes(post.data.category)
  );
} else if (category === 'prose') {
  filteredPosts = allPosts.filter(post => 
    ['story', 'poem'].includes(post.data.category)
  );
} else if (category === 'stream') {
  filteredPosts = allPosts.filter(post => 
    ['blog', 'micro', 'photo'].includes(post.data.category)
  );
} else {
  filteredPosts = allPosts.filter(post => post.data.category === category);
}

// Extract and count tags from filtered posts
const tagCounts: Record<string, number> = {};
filteredPosts.forEach(post => {
  if (post.data.tags) {
    post.data.tags.forEach(tag => {
      tagCounts[tag] = (tagCounts[tag] || 0) + 1;
    });
  }
});

// Sort tags by frequency (most used first), then alphabetically for ties
const allSortedTags = Object.keys(tagCounts)
  .sort((a, b) => {
    const countDiff = tagCounts[b] - tagCounts[a];
    return countDiff !== 0 ? countDiff : a.localeCompare(b);
  });

const popularTags = allSortedTags.slice(0, maxTags);
const hasMoreTags = allSortedTags.length > maxTags;

// Generate unique ID for this component instance
const componentId = `taglist-${Math.random().toString(36).substr(2, 9)}`;
---

{popularTags.length > 0 && (
  <div class="tagged-with" id={componentId}>
    <h3 class="tagged-with-title">{title}</h3>
    <div class="tagged-with-list">
      {popularTags.map((tag) => (
        <a 
          href={`/tags/${tag.toLowerCase()}/`} 
          class="tagged-with-item"
        >
          {tag.toUpperCase()} ({tagCounts[tag]})
        </a>
      ))}
      {hasMoreTags && showMore && (
        <button class="show-more-btn" data-target={componentId}>
          Show more →
        </button>
      )}
    </div>
    {hasMoreTags && showMore && (
      <div class="hidden-tags" id={`${componentId}-hidden`} style="display: none;">
        {allSortedTags.slice(maxTags).map((tag) => (
          <a 
            href={`/tags/${tag.toLowerCase()}/`} 
            class="tagged-with-item"
          >
            {tag.toUpperCase()} ({tagCounts[tag]})
          </a>
        ))}
        <button class="show-less-btn" data-target={componentId}>
          Show less ←
        </button>
      </div>
    )}
  </div>
)}

<style>
  .tagged-with {
    margin-bottom: 2rem;
  }

  .tagged-with-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: #111827;
  }

  :global(.dark) .tagged-with-title {
    color: #f9fafb;
  }

  .tagged-with-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .tagged-with-item {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    /* Color, border, and hover styles now handled by global CSS */
  }

  .show-more-btn,
  .show-less-btn {
    background: none;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    /* Color, border, and hover styles now handled by global CSS */
  }

  .hidden-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.5rem;
  }

  /* Mobile adjustments */
  @media (max-width: 640px) {
    .tagged-with {
      margin-bottom: 1.5rem;
    }

    .tagged-with-title {
      font-size: 0.9rem;
      margin-bottom: 0.5rem;
    }

    .tagged-with-item {
      font-size: 0.7rem;
      padding: 0.2rem 0.4rem;
    }

    .show-more-btn {
      font-size: 0.7rem;
      padding: 0.2rem 0.4rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Add event listeners to all show more buttons
    document.querySelectorAll('.show-more-btn').forEach(button => {
      button.addEventListener('click', function() {
        const targetId = this.getAttribute('data-target');
        const hiddenTags = document.getElementById(`${targetId}-hidden`);
        
        // Show all tags
        hiddenTags.style.display = 'flex';
        // Hide the show more button
        this.style.display = 'none';
      });
    });

    // Add event listeners to all show less buttons
    document.querySelectorAll('.show-less-btn').forEach(button => {
      button.addEventListener('click', function() {
        const targetId = this.getAttribute('data-target');
        const hiddenTags = document.getElementById(`${targetId}-hidden`);
        const showMoreBtn = document.querySelector(`[data-target="${targetId}"].show-more-btn`);
        
        // Hide extra tags
        hiddenTags.style.display = 'none';
        // Show the show more button again
        if (showMoreBtn) {
          showMoreBtn.style.display = 'inline-block';
        }
      });
    });
  });
</script>