---
import type { Post } from '../utils/content';
import tagListIslandScript from './islands/tag-list-island.js?url';

interface Props {
  category: string;
  title?: string;
  maxTags?: number;
  showMore?: boolean;
  posts: Post[];
  filterMode?: 'filter' | 'link';
}

const {
  category,
  title = "Tagged with:",
  maxTags = 10,
  showMore = true,
  posts,
  filterMode = 'filter'
} = Astro.props as Props;

const isFilterMode = filterMode === 'filter';

if (!posts) {
  throw new Error('TagList requires the `posts` prop to be provided by the parent component.');
}

const allPosts = posts;
let filteredPosts = allPosts;

// Handle special cases for categories that include multiple subcategories
if (category === 'garden') {
  filteredPosts = allPosts.filter(post => 
    ['evergreen', 'til', 'bookshelf', 'story', 'poem'].includes(post.data.category)
  );
} else if (category === 'prose') {
  filteredPosts = allPosts.filter(post => 
    ['story', 'poem'].includes(post.data.category)
  );
} else if (category === 'stream') {
  filteredPosts = allPosts.filter(post => 
    ['blog', 'micro', 'photo'].includes(post.data.category)
  );
} else {
  filteredPosts = allPosts.filter(post => post.data.category === category);
}

// Extract and count tags from filtered posts
const tagCounts: Record<string, number> = {};
filteredPosts.forEach(post => {
  if (post.data.tags) {
    post.data.tags.forEach(tag => {
      tagCounts[tag] = (tagCounts[tag] || 0) + 1;
    });
  }
});

// Sort tags by frequency (most used first), then alphabetically for ties
const allSortedTags = Object.keys(tagCounts)
  .sort((a, b) => {
    const countDiff = tagCounts[b] - tagCounts[a];
    return countDiff !== 0 ? countDiff : a.localeCompare(b);
  });

const popularTags = allSortedTags.slice(0, maxTags);
const hasMoreTags = allSortedTags.length > maxTags;

// Generate unique ID for this component instance
const componentId = `taglist-${Math.random().toString(36).slice(2, 11)}`;
---

{popularTags.length > 0 && (
  <tag-list class="tagged-with" id={componentId} data-filter-mode={isFilterMode ? 'filter' : 'link'}>
    <h3 class="tagged-with-title">{isFilterMode ? 'Filter by tag:' : title}</h3>
    <div class="tagged-with-list">
      {popularTags.map((tag) => (
        isFilterMode ? (
          <button
            type="button"
            class="tagged-with-item tag-chip"
            data-tag-filter={tag}
          >
            {tag.toUpperCase()} ({tagCounts[tag]})
          </button>
        ) : (
          <a
            href={`/tags/${tag.toLowerCase()}/`}
            class="tagged-with-item tag-chip"
          >
            {tag.toUpperCase()} ({tagCounts[tag]})
          </a>
        )
      ))}
      {hasMoreTags && showMore && (
        <button
          type="button"
          class="show-more-btn tag-chip"
          data-action="show-more"
          data-hidden-id={`${componentId}-hidden`}
          aria-expanded="false"
          aria-controls={`${componentId}-hidden`}
        >
          Show more →
        </button>
      )}
    </div>
    {hasMoreTags && showMore && (
      <div class="hidden-tags" id={`${componentId}-hidden`} hidden>
        {allSortedTags.slice(maxTags).map((tag) => (
          isFilterMode ? (
            <button
              type="button"
              class="tagged-with-item tag-chip"
              data-tag-filter={tag}
            >
              {tag.toUpperCase()} ({tagCounts[tag]})
            </button>
          ) : (
            <a
              href={`/tags/${tag.toLowerCase()}/`}
              class="tagged-with-item tag-chip"
            >
              {tag.toUpperCase()} ({tagCounts[tag]})
            </a>
          )
        ))}
        <button
          type="button"
          class="show-less-btn tag-chip"
          data-action="show-less"
          data-hidden-id={`${componentId}-hidden`}
          aria-controls={`${componentId}-hidden`}
        >
          Show less ←
        </button>
      </div>
    )}
  </tag-list>
)}

<style>
  .tagged-with {
    display: block;
    margin-bottom: 2rem;
  }

  .tagged-with-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: #111827;
  }

  :global(.dark) .tagged-with-title {
    color: #f9fafb;
  }

  .tagged-with-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .tagged-with-item,
  .show-more-btn,
  .show-less-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    cursor: pointer;
    white-space: nowrap;
    /* Color, border, and hover styles handled by global CSS */
  }

  .hidden-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.5rem;
  }

  .hidden-tags[hidden] {
    display: none !important;
  }

  /* Mobile adjustments */
  @media (max-width: 640px) {
    .tagged-with {
      margin-bottom: 1.5rem;
    }

    .tagged-with-title {
      font-size: 0.9rem;
      margin-bottom: 0.5rem;
    }

    .tagged-with-item,
    .show-more-btn,
    .show-less-btn {
      gap: 0.25rem;
    }
  }
</style>

<script type="module" src={tagListIslandScript}></script>
