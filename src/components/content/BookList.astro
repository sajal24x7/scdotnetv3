---
import type { Post } from '../../utils/content';

interface Props {
  posts: Post[];
  maxPosts?: number;
}

const { posts, maxPosts } = Astro.props;

// Filter and limit posts
const displayPosts = maxPosts ? posts.slice(0, maxPosts) : posts;
---

<div class="space-y-2">
  {displayPosts.map((post) => (
    <article class="compact-card">
      <a href={`/bookshelf/${post.slug}/`} class="block">
        <div class="flex items-center gap-2">
          {post.data.format && (
            <span class="text-small font-medium text-green-600 dark:text-green-400 bg-green-100 dark:bg-green-900 px-2 py-1 rounded-full">
              {post.data.format}
            </span>
          )}
          <h3 class="text-normal font-semibold group-hover:text-accent transition-colors">
            {post.data.title}
          </h3>
        </div>
      </a>
    </article>
  ))}
</div>

<style>
  .compact-card {
    border: 1px solid transparent;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(250, 250, 255, 0.8) 100%);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin-bottom: 0.5rem;
    transition: box-shadow 0.2s, border-color 0.2s, background 0.2s;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    cursor: pointer;
  }
  .compact-card:hover {
    border-color: #a78bfa;
    box-shadow: 0 4px 16px 0 rgba(136, 58, 234, 0.08);
    background: linear-gradient(135deg, rgba(250, 250, 255, 0.95) 0%, rgba(245, 245, 255, 0.9) 100%);
  }
  :global(.dark) .compact-card {
    background: linear-gradient(135deg, rgba(24, 24, 27, 0.9) 0%, rgba(35, 35, 54, 0.8) 100%);
    border-color: #27272a;
  }
  :global(.dark) .compact-card:hover {
    border-color: #a78bfa;
    background: linear-gradient(135deg, rgba(35, 35, 54, 0.95) 0%, rgba(45, 45, 70, 0.9) 100%);
  }
</style> 