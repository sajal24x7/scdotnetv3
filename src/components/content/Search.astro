---
interface Props {
  placeholder?: string;
  size?: 'sm' | 'md' | 'lg';
  showIcon?: boolean;
  autoFocus?: boolean;
}

const { 
  placeholder = 'Search posts...', 
  size = 'md', 
  showIcon = true,
  autoFocus = false
} = Astro.props;

const sizeClasses = {
  sm: 'text-small px-3 py-2',
  md: 'text-normal px-4 py-3',
  lg: 'text-large px-6 py-4'
};
---

<div class="relative">
  {showIcon && (
    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
      <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
      </svg>
    </div>
  )}
  
  <input
    type="search"
    name="search"
    id="search"
    class={`block w-full ${sizeClasses[size]} ${showIcon ? 'pl-10' : 'pl-4'} pr-4 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all duration-200`}
    placeholder={placeholder}
    autocomplete="off"
    autofocus={autoFocus}
  />
  
  <!-- Search results container (hidden by default) -->
  <div id="search-results" class="absolute z-50 w-full mt-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg hidden">
    <div class="p-4">
      <div class="text-small text-gray-500 dark:text-gray-400">Search results will appear here...</div>
    </div>
  </div>
</div>

<script>
  // Basic search functionality
  const searchInput = document.getElementById('search') as HTMLInputElement;
  const searchResults = document.getElementById('search-results');
  
  if (searchInput && searchResults) {
    let searchTimeout: NodeJS.Timeout;
    
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.trim();
      
      // Clear previous timeout
      clearTimeout(searchTimeout);
      
      if (query.length < 2) {
        searchResults.classList.add('hidden');
        return;
      }
      
      // Debounce search
      searchTimeout = setTimeout(() => {
        performSearch(query);
      }, 300);
    });
    
    // Hide results when clicking outside
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target as Node) && !searchResults.contains(e.target as Node)) {
        searchResults.classList.add('hidden');
      }
    });
    
    // Show results on focus if there's a query
    searchInput.addEventListener('focus', () => {
      const query = searchInput.value.trim();
      if (query.length >= 2) {
        searchResults.classList.remove('hidden');
      }
    });
  }
  
  async function performSearch(query: string) {
    // This is a placeholder for actual search implementation
    // In a real implementation, you would:
    // 1. Make an API call to your search endpoint
    // 2. Update the search results container with actual results
    // 3. Handle loading states and errors
    
    console.log('Searching for:', query);
    
    // For now, just show the results container
    if (searchResults) {
      searchResults.classList.remove('hidden');
      searchResults.innerHTML = `
        <div class="p-4">
          <div class="text-small text-gray-500 dark:text-gray-400">
            Search functionality coming soon...
          </div>
        </div>
      `;
    }
  }
</script>

<style>
  /* Focus ring animation */
  input:focus {
    box-shadow: 0 0 0 3px rgba(var(--color-accent-rgb), 0.1);
  }
  
  /* Search results animation */
  #search-results {
    transition: opacity 0.2s ease-in-out;
  }
  
  #search-results.hidden {
    opacity: 0;
    pointer-events: none;
  }
  
  /* Dark mode adjustments */
  :global(.dark) input {
    background: linear-gradient(135deg, rgba(31, 41, 55, 0.9) 0%, rgba(55, 65, 81, 0.8) 100%);
    border-color: rgb(75, 85, 99);
  }
  
  :global(.dark) input:focus {
    border-color: var(--color-accent);
  }
</style> 