---
import type { Post } from '../../utils/content';
import CategoryDisplay from '../CategoryDisplay.astro';

interface Props {
  posts: Post[];
  maxPosts?: number;
}

const { posts, maxPosts } = Astro.props;

// Filter and limit posts
const displayPosts = maxPosts ? posts.slice(0, maxPosts) : posts;
---

<div class="fiction-grid grid-gap-tight grid-pad-narrow">
    {displayPosts.map((post) => (
        <article class="fiction-card grid-span-3">
            <a href={`/${post.data.category}/${post.slug}/`} class="fiction-card__link">
                <div class="fiction-card__inner">
                    {post.data.image && (
                        <div class="fiction-card__image">
                            <img
                                src={post.data.image}
                                alt={`Cover for ${post.data.title}`}
                                loading="lazy"
                            />
                        </div>
                    )}
                    <div class="fiction-card__meta">
                        <CategoryDisplay category={post.data.category} />
                    </div>
                    <h3 class="fiction-card__title line-clamp-2">{post.data.title}</h3>
                    {post.data.description && (
                        <p class="fiction-card__description line-clamp-2">{post.data.description}</p>
                    )}
                </div>
            </a>
        </article>
    ))}
</div>

<style>
    .fiction-grid {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        column-gap: var(--grid-column-gap, clamp(1.5rem, 4vw, 2.5rem));
        row-gap: var(--grid-row-gap, clamp(1.75rem, 5vw, 2.75rem));
        padding-block: clamp(1.5rem, 5vw, 2.5rem);
        padding-inline: var(--grid-padding-inline, 0);
    }

    .fiction-card {
        height: 100%;
        display: flex;
        min-width: 0;
    }

    .fiction-card__link {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid rgba(var(--color-border), 0.7);
        background-color: rgba(var(--color-bg), 0.98);
        transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease, background-color 200ms ease;
    }

    .fiction-card__inner {
        display: flex;
        flex-direction: column;
        gap: clamp(0.75rem, 3vw, 1rem);
        padding: clamp(1rem, 3vw, 1.25rem);
        height: 100%;
    }

    .fiction-card__image {
        overflow: hidden;
        border-radius: 0.75rem;
        aspect-ratio: 4 / 3;
        background-color: rgba(var(--color-bg-secondary), 0.6);
    }

    .fiction-card__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .fiction-card__meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .fiction-card__title {
        font-size: var(--text-normal);
        font-weight: 600;
        color: rgba(var(--color-text-primary), 0.95);
        transition: color 200ms ease;
    }

    .fiction-card__description {
        font-size: var(--text-small);
        color: rgba(var(--color-text-secondary), 0.9);
    }

    .fiction-card__link:hover {
        border-color: rgba(var(--color-accent), 0.65);
        background-color: rgba(var(--color-bg-secondary), 0.65);
        box-shadow: 0 16px 32px -20px rgba(15, 23, 42, 0.35);
        transform: translateY(-2px);
    }

    .fiction-card__link:hover .fiction-card__title {
        color: rgb(var(--color-accent));
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    :global(.dark) .fiction-card__link {
        border-color: rgba(var(--color-border), 0.5);
        background-color: rgba(var(--color-bg-secondary), 0.35);
        backdrop-filter: blur(6px);
    }

    :global(.dark) .fiction-card__link:hover {
        border-color: rgba(var(--color-accent), 0.55);
        background-color: rgba(var(--color-bg-secondary), 0.5);
        box-shadow: 0 18px 38px -18px rgba(15, 23, 42, 0.6);
    }

    @media (min-width: 48rem) {
        .fiction-grid {
            grid-template-columns: repeat(12, minmax(0, 1fr));
        }
    }
</style>
