---
import type { Post } from '../../utils/content';

interface Props {
  posts: Post[];
  maxPosts?: number;
}

const { posts, maxPosts } = Astro.props;

// Filter and limit posts
const displayPosts = maxPosts ? posts.slice(0, maxPosts) : posts;
---

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
  {displayPosts.map((post) => (
    <article class="fiction-card">
      <a href={`/${post.data.category}/${post.slug}/`} class="block">
        <div class="fiction-content">
          {post.data.image && (
            <div class="fiction-image mb-3">
              <img 
                src={post.data.image} 
                alt={`Cover for ${post.data.title}`}
                class="w-full h-32 object-cover rounded-md"
              />
            </div>
          )}
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-medium text-purple-600 dark:text-purple-400 bg-purple-100 dark:bg-purple-900 px-2 py-1 rounded-full">
              {post.data.category}
            </span>
          </div>
          <h3 class="text-sm font-semibold group-hover:text-accent transition-colors line-clamp-2">
            {post.data.title}
          </h3>
          {post.data.description && (
            <p class="text-xs text-gray-600 dark:text-gray-400 mt-1 line-clamp-2">
              {post.data.description}
            </p>
          )}
        </div>
      </a>
    </article>
  ))}
</div>

<style>
  .fiction-card {
    border: 1px solid #e5e7eb;
    background: #fff;
    border-radius: 0.5rem;
    padding: 1rem;
    transition: box-shadow 0.2s, border-color 0.2s, background 0.2s;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    cursor: pointer;
    height: fit-content;
  }
  .fiction-card:hover {
    border-color: #a78bfa;
    box-shadow: 0 4px 16px 0 rgba(136, 58, 234, 0.08);
    background: #fafaff;
  }
  :global(.dark) .fiction-card {
    background: #18181b;
    border-color: #27272a;
  }
  :global(.dark) .fiction-card:hover {
    border-color: #a78bfa;
    background: #232336;
  }
  .fiction-content {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .fiction-image {
    overflow: hidden;
    border-radius: 0.375rem;
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style> 