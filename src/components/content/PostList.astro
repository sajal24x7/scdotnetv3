---
import TimeDisplay from '../TimeDisplay.astro';
import CategoryDisplay from '../CategoryDisplay.astro';
import Tag from '../Tag.astro';

interface Props {
  posts: any[];
  mode?: 'grid' | 'list' | 'timeline';
  showCategory?: boolean;
  showDate?: boolean;
  showDescription?: boolean;
  maxPosts?: number;
  compact?: boolean;
}

const { 
  posts, 
  mode = 'list', 
  showCategory = true, 
  showDate = true, 
  showDescription = false,
  maxPosts,
  compact = false
} = Astro.props;

const displayPosts = maxPosts ? posts.slice(0, maxPosts) : posts;

const getContainerClasses = () => {
    switch (mode) {
        case 'grid':
            return 'post-list post-list--grid twelve-grid grid-gap-tight grid-pad-narrow';
        case 'timeline':
            return 'post-list post-list--timeline space-y-8';
        default:
            return 'post-list post-list--list space-y-4';
    }
};

const getArticleClasses = () => {
    if (compact) {
        return 'compact-card';
    }

    switch (mode) {
        case 'grid':
            return 'post-list__grid-item grid-span-4';
        case 'timeline':
            return 'post-list__timeline-item';
        default:
            return 'post-list__item';
    }
};

const getLinkClasses = () => {
    switch (mode) {
        case 'grid':
            return 'post-list__grid-card group';
        default:
            return 'post-list__link group block';
    }
};
---

<div class={getContainerClasses()}>
    {displayPosts.map((post) => (
        <article class={getArticleClasses()}>
            <a href={`/${post.data.category}/${post.id}/`} class={getLinkClasses()}>
                {mode === 'grid' && (
                    <div class="post-list__grid-media">
                        {post.data.image && (
                            <img
                                src={post.data.image}
                                alt={post.data.title}
                                loading="lazy"
                            />
                        )}
                    </div>
                )}

                <div class="post-list__content">
                    {compact ? (
                        <div class="post-list__compact-header">
                            <CategoryDisplay category={post.data.category} />
                            <h3 class="text-normal font-semibold group-hover:text-accent transition-colors">
                                {post.data.title}
                            </h3>
                        </div>
                    ) : (
                        <>
                            {showDate && (
                                <TimeDisplay
                                    date={post.data.created}
                                    category={post.data.category}
                                    className="post-list__date card-chip"
                                />
                            )}
                            <h3 class="text-large font-semibold group-hover:text-accent transition-colors">
                                {post.data.title}
                            </h3>
                            {showDescription && post.data.description && (
                                <p class="post-list__description line-clamp-2">
                                    {post.data.description}
                                </p>
                            )}
                            {showCategory && (
                                <div class="post-list__meta">
                                    <CategoryDisplay category={post.data.category} />
                                    {post.data.tags && post.data.tags.length > 0 && (
                                        <div class="post-list__tags">
                                            {post.data.tags.slice(0, 2).map((tag: string) => (
                                                <Tag tag={tag} class="post-list__tag" />
                                            ))}
                                        </div>
                                    )}
                                </div>
                            )}
                        </>
                    )}
                </div>
            </a>
        </article>
    ))}
</div>

<style>
    .post-list {
        width: 100%;
    }

    .post-list__grid-item {
        display: flex;
        min-width: 0;
    }

    .post-list__grid-card {
        display: flex;
        flex-direction: column;
        gap: clamp(0.75rem, 3vw, 1.25rem);
        border-radius: 0.75rem;
        border: 1px solid rgba(var(--color-border), 0.75);
        background-color: rgba(var(--color-bg), 0.98);
        padding: clamp(1rem, 3vw, 1.5rem);
        height: 100%;
        transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease, background-color 200ms ease;
    }

    .post-list__grid-card:hover {
        border-color: rgba(var(--color-accent), 0.65);
        background-color: rgba(var(--color-bg-secondary), 0.6);
        box-shadow: 0 18px 40px -24px rgba(15, 23, 42, 0.35);
        transform: translateY(-2px);
    }

    .post-list__grid-media {
        overflow: hidden;
        border-radius: 0.75rem;
        aspect-ratio: 4 / 3;
        background-color: rgba(var(--color-bg-secondary), 0.55);
    }

    .post-list__grid-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .post-list__content {
        display: flex;
        flex-direction: column;
        gap: clamp(0.5rem, 2vw, 0.75rem);
    }

    .post-list__description {
        color: rgba(var(--color-text-secondary), 0.9);
    }

    .post-list__meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.25rem;
    }

    .post-list__date {
        color: inherit;
    }

    .post-list__tags {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        align-items: center;
    }

    .post-list__tag {
        margin-right: 0;
    }

    .post-list__compact-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .post-list__timeline-item {
        position: relative;
        padding-left: 2rem;
    }

    .post-list__timeline-item::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.6rem;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 9999px;
        background-color: rgb(var(--color-accent));
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .post-list__grid-card:hover .text-large,
    .post-list__grid-card:hover .text-normal {
        color: rgb(var(--color-accent));
    }

    .post-list__link {
        color: inherit;
        text-decoration: none;
    }

    .post-list__link:hover .text-large,
    .post-list__link:hover .text-normal {
        color: rgb(var(--color-accent));
    }

    .compact-card {
        border: 1px solid rgba(var(--color-border), 0.8);
        background-color: rgba(var(--color-bg), 0.98);
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
        margin-bottom: 0.5rem;
        transition: border-color 200ms ease, box-shadow 200ms ease, background-color 200ms ease;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
        cursor: pointer;
    }

    .compact-card:hover {
        border-color: rgba(var(--color-accent), 0.65);
        box-shadow: 0 12px 28px -18px rgba(15, 23, 42, 0.35);
        background-color: rgba(var(--color-bg-secondary), 0.65);
    }

    :global(.dark) .post-list__grid-card {
        border-color: rgba(var(--color-border), 0.5);
        background-color: rgba(var(--color-bg-secondary), 0.35);
        backdrop-filter: blur(6px);
    }

    :global(.dark) .post-list__grid-card:hover {
        border-color: rgba(var(--color-accent), 0.55);
        background-color: rgba(var(--color-bg-secondary), 0.5);
        box-shadow: 0 20px 44px -22px rgba(15, 23, 42, 0.6);
    }

    :global(.dark) .post-list__description {
        color: rgba(var(--color-text-secondary), 0.75);
    }

    :global(.dark) .post-list__tags {
        color: rgba(var(--color-text-secondary), 0.7);
    }

    :global(.dark) .compact-card {
        background-color: rgba(var(--color-bg-secondary), 0.35);
        border-color: rgba(var(--color-border), 0.5);
        backdrop-filter: blur(6px);
    }

    :global(.dark) .compact-card:hover {
        border-color: rgba(var(--color-accent), 0.55);
        background-color: rgba(var(--color-bg-secondary), 0.5);
        box-shadow: 0 18px 40px -24px rgba(15, 23, 42, 0.7);
    }
</style>