---
import Card from '../Card.astro';
import { marked } from 'marked';
import LinkHoverEffect from '../LinkHoverEffect.astro';

interface Props {
  posts: any[];
  layout?: 'grid' | 'list' | 'masonry';
  columns?: 1 | 2 | 3 | 4;
  gap?: 'sm' | 'md' | 'lg' | 'xl';
  showDividers?: boolean;
}

const { 
  posts, 
  layout = 'grid', 
  columns = 1, 
  gap = 'lg', 
  showDividers = true 
} = Astro.props;

// Configure marked options
marked.setOptions({
  gfm: true, // GitHub Flavored Markdown
  breaks: true // Convert line breaks to <br>
});

// Pre-render markdown content
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? marked.parse(post.body) : null
}));

// Generate responsive grid classes
const getGridClasses = () => {
  const gapClasses = {
    sm: 'gap-4',
    md: 'gap-6', 
    lg: 'gap-8',
    xl: 'gap-12'
  };

  const columnClasses = {
    1: 'grid-cols-1',
    2: 'grid-cols-2 md:grid-cols-2',
    3: 'grid-cols-2 md:grid-cols-2 lg:grid-cols-3',
    4: 'grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4'
  };

  return `${columnClasses[columns]} ${gapClasses[gap]}`;
};
---

<div class={`grid ${getGridClasses()}`}>
  {renderedPosts.map((post, index) => (
    <div class={layout === 'masonry' ? 'break-inside-avoid' : ''}>
      <Card {...post.data}>
        {post.renderedContent && (
          <div class="prose dark:prose-dark max-w-none">
            <div set:html={post.renderedContent} />
          </div>
        )}
      </Card>
    </div>
  ))}
</div>

<LinkHoverEffect />

<style>
  .grid {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Add a subtle divider between cards */
  .grid > *:not(:last-child) {
    position: relative;
  }

  .grid > *:not(:last-child)::after {
    content: '';
    position: absolute;
    bottom: -1.5rem;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgb(229 231 235),
      transparent
    );
  }

  :global(.dark) .grid > *:not(:last-child)::after {
    background: linear-gradient(
      to right,
      transparent,
      rgb(55 65 81),
      transparent
    );
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .grid {
      max-width: none;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 768px) and (max-width: 1024px) {
    .grid {
      max-width: 1200px;
    }
  }

  /* Large screen adjustments */
  @media (min-width: 1024px) {
    .grid {
      max-width: 1400px;
    }
  }

  /* Masonry layout (static, not conditional) */
  .masonry {
    column-count: 1;
    column-gap: 2rem;
  }
  @media (min-width: 768px) {
    .masonry {
      column-count: 2;
    }
  }
  @media (min-width: 1024px) {
    .masonry {
      column-count: 3;
    }
  }
  @media (min-width: 1280px) {
    .masonry {
      column-count: 4;
    }
  }

  /* Persistent yellow highlight for prose links (manuelmoreale.com style) */
  :global(.prose a) {
    background-color: rgba(255, 235, 59, 0.3); /* Subtle yellow highlight */
    color: inherit;
    text-decoration: none;
    padding: 0 2px;
    transition: background-color 0.2s ease;
  }

  :global(.prose a:hover) {
    background-color: rgba(255, 235, 59, 0.5); /* Slightly darker yellow on hover */
  }

  :global(.dark .prose a) {
    background-color: #1E40AF; /* Blue-800 - darker blue that works with white text */
  }

  :global(.dark .prose a:hover) {
    background-color: #1D4ED8; /* Blue-700 - slightly lighter for hover */
  }

  /* Exclude card titles from highlight effect */
  :global(.prose .card-link) {
    background-color: transparent !important;
    color: inherit !important;
    padding: 0 !important;
  }

  :global(.prose .card-link:hover) {
    background-color: transparent !important;
  }

  /* Card hover effects */
  :global(.card:hover) {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
  :global(.dark .card:hover) {
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
  }
</style> 