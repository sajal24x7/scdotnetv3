---
import Card from '../Card.astro';
import { parseMarkdown } from '../../utils/markdown';

interface Props {
  posts: any[];
  layout?: 'grid' | 'list' | 'masonry';
  columns?: 1 | 2 | 3 | 4;
  gap?: 'sm' | 'md' | 'lg' | 'xl';
  showDividers?: boolean;
}

const { 
  posts, 
  layout = 'grid', 
  columns = 1, 
  gap = 'lg', 
  showDividers = true 
} = Astro.props;

// Pre-render markdown content
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? parseMarkdown(post.body) : null
}));

const columnSpanMap: Record<typeof columns, 3 | 4 | 6 | 12> = {
    1: 12,
    2: 6,
    3: 4,
    4: 3
};

const containerClassName = [
    'responsive-content-grid',
    'twelve-grid',
    layout === 'list' ? 'responsive-content-grid--list' : '',
    layout === 'masonry' ? 'responsive-content-grid--masonry' : '',
].filter(Boolean).join(' ');
---

<div class={containerClassName} data-gap={gap} data-dividers={showDividers ? 'true' : 'false'}>
    {renderedPosts.map((post) => (
        <div
            class={`responsive-content-grid__item grid-span-${columnSpanMap[columns]} ${layout === 'masonry' ? 'responsive-content-grid__item--masonry' : ''}`.trim()}
        >
            <Card {...post.data}>
                {post.renderedContent && (
                    <div class="prose dark:prose-dark max-w-none">
                        <div set:html={post.renderedContent} />
                    </div>
                )}
            </Card>
        </div>
    ))}
</div>


<style>
  .responsive-content-grid {
    padding-block: clamp(1.5rem, 5vw, 3rem);
    row-gap: clamp(1.5rem, 5vw, 2.5rem);
  }

  .responsive-content-grid[data-gap='sm'] {
    --grid-column-gap: clamp(1rem, 3vw, 1.5rem);
    --grid-row-gap: clamp(1.25rem, 4vw, 2rem);
  }

  .responsive-content-grid[data-gap='md'] {
    --grid-column-gap: clamp(1.5rem, 4vw, 2rem);
    --grid-row-gap: clamp(1.75rem, 5vw, 2.5rem);
  }

  .responsive-content-grid[data-gap='lg'] {
    --grid-column-gap: clamp(2rem, 5vw, 2.75rem);
    --grid-row-gap: clamp(2.25rem, 6vw, 3rem);
  }

  .responsive-content-grid[data-gap='xl'] {
    --grid-column-gap: clamp(2.5rem, 6vw, 3.5rem);
    --grid-row-gap: clamp(2.75rem, 7vw, 3.5rem);
  }

  .responsive-content-grid__item {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .responsive-content-grid[data-dividers='true'] .responsive-content-grid__item {
    position: relative;
  }

  .responsive-content-grid[data-dividers='true'] .responsive-content-grid__item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--grid-row-gap) * -0.5);
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(var(--color-border), 0.85),
      transparent
    );
  }

  :global(.dark) .responsive-content-grid[data-dividers='true'] .responsive-content-grid__item:not(:last-child)::after {
    background: linear-gradient(
      to right,
      transparent,
      rgba(var(--color-border), 0.6),
      transparent
    );
  }

  .responsive-content-grid__item :global(.card) {
    height: 100%;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .responsive-content-grid__item :global(.card:hover) {
    transform: translateY(-2px);
    box-shadow: 0 20px 45px -25px rgba(15, 23, 42, 0.35);
  }

  .responsive-content-grid__item--masonry {
    break-inside: avoid;
  }

  .responsive-content-grid--list {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 5vw, 2.5rem);
  }

  .responsive-content-grid--list .responsive-content-grid__item {
    width: 100%;
  }

  :global(.dark) .responsive-content-grid__item :global(.card:hover) {
    box-shadow: 0 24px 48px -28px rgba(15, 23, 42, 0.6);
  }
</style>