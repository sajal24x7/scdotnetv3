---
import CategoryDisplay from '../CategoryDisplay.astro';
import TimeDisplay from '../TimeDisplay.astro';

type TransformPost = typeof import('../../utils/content')['transformPost'];

type TransformedPost = ReturnType<TransformPost>;

interface Props {
    posts?: TransformedPost[];
    title?: string;
}

const { posts = [], title = 'Featured' }: Props = Astro.props;
---

{posts.length > 0 && (
    <div class="home-featured">
        {title && (
            <h2 class="home-featured__title grid-span-full">{title}</h2>
        )}

        {posts.map((post) => (
            <article class="home-featured__item grid-span-3">
                <a href={post.data.link} class="home-featured__card">
                    <div class="home-featured__media" data-has-image={Boolean(post.data.image)}>
                        {post.data.image ? (
                            <img src={post.data.image} alt={post.data.title} loading="lazy" />
                        ) : (
                            <div class="home-featured__placeholder" aria-hidden="true"></div>
                        )}
                    </div>
                    <div class="home-featured__meta">
                        <CategoryDisplay category={post.data.category} className="home-featured__category" />
                        <TimeDisplay date={post.data.pubDate} category={post.data.category} className="home-featured__date card-chip" />
                    </div>
                    <h3 class="home-featured__heading">{post.data.title}</h3>
                </a>
            </article>
        ))}

        <div class="home-featured__spacer grid-span-full" aria-hidden="true"></div>
    </div>
)}

<style>
    .home-featured {
        display: contents;
    }

    .home-featured__title {
        font-size: var(--text-large);
        font-weight: 700;
        margin: 0 0 clamp(1.25rem, 3vw, 2rem);
        color: rgb(var(--color-text-primary));
        text-align: left;
    }

    .home-featured__item {
        display: flex;
        min-width: 0;
    }

    .home-featured__spacer {
        height: clamp(2rem, 5vw, 3.5rem);
    }

    .home-featured__card {
        display: flex;
        flex-direction: column;
        gap: clamp(0.75rem, 2vw, 1.25rem);
        width: 100%;
        text-decoration: none;
        color: inherit;
    }

    .home-featured__media {
        position: relative;
        aspect-ratio: 4 / 3;
        width: 100%;
        border-radius: 1.25rem;
        overflow: hidden;
        background: rgba(var(--color-accent), 0.08);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .home-featured__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
    }

    .home-featured__placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, rgba(var(--color-accent), 0.18), rgba(var(--color-accent), 0.08));
    }

    .home-featured__card:hover .home-featured__media {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px rgba(var(--color-accent), 0.15);
    }

    .home-featured__card:hover .home-featured__media img {
        transform: scale(1.03);
    }

    .home-featured__meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        color: rgb(var(--color-text-secondary));
    }

    .home-featured__date {
        color: inherit;
    }

    .home-featured__heading {
        font-size: clamp(1.1rem, 2.5vw, 1.4rem);
        font-weight: 600;
        margin: 0;
        line-height: 1.35;
        color: rgb(var(--color-text-primary));
    }

    @media (min-width: 48rem) and (max-width: 63.9375rem) {
        .home-featured__item.grid-span-3 {
            grid-column: span 6 / span 6;
        }
    }

    @media (max-width: 47.9375rem) {
        .home-featured__title {
            text-align: center;
        }

        .home-featured__card {
            text-align: center;
        }

        .home-featured__meta {
            justify-content: center;
        }
    }
</style>
