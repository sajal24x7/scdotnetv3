---
import CategoryDisplay from '../CategoryDisplay.astro';
import TimeDisplay from '../TimeDisplay.astro';
import Tag from '../Tag.astro';
import { parseMarkdown } from '../../utils/markdown';

type TransformPost = typeof import('../../utils/content')['transformPost'];
type TransformedPost = ReturnType<TransformPost>;
type FeaturedPost = TransformedPost & { renderedContent: string | null };

interface Props {
    posts?: TransformedPost[];
    title?: string;
}

const { posts = [], title = 'Featured' }: Props = Astro.props;

const renderedPosts: FeaturedPost[] = posts.map(post => ({
    ...post,
    renderedContent: post.body ? parseMarkdown(post.body) : null
}));
---

{renderedPosts.length > 0 && (
  <div class="featured-wrapper layout-boundary px-2 md:px-4">
    {title && (
      <h2 class="featured-title">{title}</h2>
    )}

    <div class="featured-list">
      {renderedPosts.map((post) => (
        <article class="featured-card">
          <a href={post.data.link} class="featured-card-link">
            {post.data.image && (
              <div class="featured-image">
                <img src={post.data.image} alt={post.data.title} loading="lazy" />
              </div>
            )}
            <div class="featured-content">
              <div class="featured-meta">
                <CategoryDisplay category={post.data.category} className="featured-category" />
                <TimeDisplay date={post.data.pubDate} category={post.data.category} className="featured-date card-chip" />
              </div>
              {post.data.title && (
                <h3 class="featured-heading">{post.data.title}</h3>
              )}
              <div class="featured-body">
                {post.data.category === 'micro' && post.renderedContent ? (
                  <div class="prose dark:prose-dark max-w-none" set:html={post.renderedContent} />
                ) : post.data.description ? (
                  <p>{post.data.description}</p>
                ) : null}
              </div>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="featured-tags">
                  {post.data.tags.map((tag: string) => (
                    <Tag tag={tag} />
                  ))}
                </div>
              )}
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
)}

<style>
  .featured-wrapper {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .featured-title {
    font-size: var(--text-large);
    font-weight: 700;
    color: rgb(var(--color-text-primary));
    text-align: center;
    margin: 0;
  }

  .featured-list {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .featured-card {
    border: 1px solid rgb(var(--color-border));
    border-radius: 1.5rem;
    overflow: hidden;
    background: rgb(var(--color-bg));
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .featured-card:hover {
    border-color: rgba(var(--color-accent), 0.6);
    box-shadow: 0 12px 30px -10px rgba(var(--color-accent), 0.25);
    transform: translateY(-2px);
  }

  .featured-card-link {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vw, 1.75rem);
    color: inherit;
    text-decoration: none;
  }

  .featured-image {
    width: 100%;
    height: clamp(12rem, 35vw, 14rem);
    overflow: hidden;
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    display: block;
  }

  .featured-card:hover .featured-image img {
    transform: scale(1.05);
  }

  .featured-content {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  @media (min-width: 64rem) {
    .featured-card-link {
      flex-direction: row;
      align-items: stretch;
    }

    .featured-image {
      width: min(20rem, 40%);
      height: auto;
    }
  }

  .featured-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    color: rgb(var(--color-text-secondary));
  }

  .featured-date {
    color: inherit;
  }

  .featured-heading {
    font-size: var(--text-large);
    font-weight: 700;
    color: rgb(var(--color-text-primary));
    line-height: 1.3;
    margin: 0;
  }

  .featured-body p {
    margin: 0;
    color: rgb(var(--color-text-secondary));
    line-height: 1.6;
  }

  .featured-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (min-width: 48rem) {
    .featured-title {
      text-align: left;
    }
  }
</style>
