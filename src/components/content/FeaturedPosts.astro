---
import CategoryDisplay from '../CategoryDisplay.astro';
import TimeDisplay from '../TimeDisplay.astro';
import Tag from '../Tag.astro';
import { getAllPosts, transformPost } from '../../utils/content';
import { parseMarkdown } from '../../utils/markdown';

interface FeaturedEntry {
  slug: string;
  href?: string;
  title?: string;
  description?: string;
  image?: string;
  tags?: string[];
}

interface Props {
  featuredEntries: FeaturedEntry[];
  title?: string;
}

type TransformedPost = ReturnType<typeof transformPost>;
type FeaturedPost = TransformedPost & { renderedContent: string | null };

const { featuredEntries = [], title = 'Featured' } = Astro.props;

const allPosts = await getAllPosts();
const postsBySlug = new Map(
  allPosts.map((post) => {
    const transformed = transformPost(post);
    return [post.slug, transformed];
  })
);

const renderedPosts: FeaturedPost[] = featuredEntries
  .map((entry) => {
    const basePost = postsBySlug.get(entry.slug);
    if (!basePost) {
      return null;
    }

    const mergedPost: TransformedPost = {
      ...basePost,
      data: {
        ...basePost.data,
        ...(entry.title ? { title: entry.title } : {}),
        ...(entry.description ? { description: entry.description } : {}),
        ...(entry.image ? { image: entry.image } : {}),
        ...(entry.tags ? { tags: entry.tags } : {}),
        link: entry.href ?? basePost.data.link
      }
    };

    const postWithContent: FeaturedPost = {
      ...mergedPost,
      renderedContent: mergedPost.body ? parseMarkdown(mergedPost.body) : null
    };

    return postWithContent;
  })
  .filter((post): post is FeaturedPost => Boolean(post));
---

{renderedPosts.length > 0 && (
  <div class="featured-wrapper layout-boundary px-2 md:px-4">
    {title && (
      <h2 class="featured-title">{title}</h2>
    )}

    <div class="featured-list">
      {renderedPosts.map((post) => (
        <article class="featured-card">
          <a href={post.data.link} class="featured-card-link">
            {post.data.image && (
              <div class="featured-image">
                <img src={post.data.image} alt={post.data.title} loading="lazy" />
              </div>
            )}
            <div class="featured-content">
              <div class="featured-meta">
                <CategoryDisplay category={post.data.category} className="featured-category" />
                <TimeDisplay date={post.data.pubDate} category={post.data.category} className="featured-date" />
              </div>
              {post.data.title && (
                <h3 class="featured-heading">{post.data.title}</h3>
              )}
              <div class="featured-body">
                {post.data.category === 'micro' && post.renderedContent ? (
                  <div class="prose dark:prose-dark max-w-none" set:html={post.renderedContent} />
                ) : post.data.description ? (
                  <p>{post.data.description}</p>
                ) : null}
              </div>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="featured-tags">
                  {post.data.tags.map((tag: string) => (
                    <Tag tag={tag} />
                  ))}
                </div>
              )}
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
)}

<style>
  .featured-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .featured-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: #111827;
    text-align: center;
  }

  :global(.dark) .featured-title {
    color: #f9fafb;
  }

  .featured-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .featured-card {
    border: 1px solid #e5e7eb;
    border-radius: 1.5rem;
    overflow: hidden;
    background: #ffffff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  :global(.dark) .featured-card {
    border-color: #374151;
    background: #1f2937;
  }

  .featured-card:hover {
    border-color: #a78bfa;
    box-shadow: 0 12px 30px -10px rgba(99, 102, 241, 0.25);
    transform: translateY(-2px);
  }

  .featured-card-link {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    color: inherit;
    text-decoration: none;
  }

  .featured-image {
    width: 100%;
    height: 220px;
    overflow: hidden;
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    display: block;
  }

  .featured-card:hover .featured-image img {
    transform: scale(1.05);
  }

  .featured-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
  }

  @media (min-width: 1024px) {
    .featured-card-link {
      flex-direction: row;
      align-items: stretch;
    }

    .featured-image {
      width: 320px;
      height: auto;
    }

  }

  .featured-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: #4b5563;
  }

  :global(.dark) .featured-meta {
    color: #d1d5db;
  }

  .featured-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1f2937;
    line-height: 1.3;
  }

  :global(.dark) .featured-heading {
    color: #f3f4f6;
  }

  .featured-body p {
    margin: 0;
    color: #4b5563;
    line-height: 1.6;
  }

  :global(.dark) .featured-body p {
    color: #d1d5db;
  }

  .featured-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 640px) {
    .featured-title {
      font-size: 1.5rem;
    }
  }
</style>
