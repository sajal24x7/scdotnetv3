---
import { Image } from 'astro:assets';
import { getBookCoverImage } from '../../utils/covers';
import {
    bookRatingDisplay,
    defaultBookRating,
    heartIconPaths,
    thumbIconPaths,
    type BookRating,
    type RatingIconSpec
} from '../../utils/bookRatings';

interface BookCardProps {
    title: string;
    author?: string;
    series?: string;
    startedReading?: Date | string;
    finishedReading?: Date | string;
    bookStatus?: 'reading' | 'read';
    bookRating?: BookRating;
    cover?: string;
    link?: string;
    format?: string;
}

const {
    title,
    author,
    series,
    startedReading,
    finishedReading,
    bookStatus,
    bookRating,
    cover,
    link,
    format
} = Astro.props as BookCardProps;

// Only use cover for bookshelf display
const coverImage = cover;

// Get the imported image for local book covers
const importedCoverImage = cover ? getBookCoverImage(cover) : null;

// Format dates
const formatDate = (date: Date | string | undefined) => {
  if (!date) return null;
  const dateObj = typeof date === 'string' ? new Date(date) : date;
  return dateObj.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'short', 
    day: 'numeric' 
  });
};

const startedDate = formatDate(startedReading);
const finishedDate = formatDate(finishedReading);

const showRating = bookStatus !== 'reading';
const rating: BookRating | null = showRating ? (bookRating ?? defaultBookRating) : null;
const ratingDisplay = rating ? bookRatingDisplay[rating] : null;
const ratingLabel = ratingDisplay?.label ?? null;
const ratingIconSpecs: readonly RatingIconSpec[] = ratingDisplay?.iconSpecs ?? [];
const ratingAriaLabel = ratingLabel ?? 'Rated';
---

<article class="book-card" data-card-root>
  <div class="book-content">
    <div class="book-cover">
      {coverImage && importedCoverImage ? (
        <Image
          src={importedCoverImage}
          alt={`${title} book cover`}
          width={250}
          height={375}
          class="cover-image"
        />
      ) : (
        <div class="cover-placeholder">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
        </div>
      )}
    </div>
    
    <div class="book-info">
      <div class="book-header">
        {series && series !== 'none' && (
          <div class="book-series">{series}</div>
        )}
        
        <h3 class="book-title">
          {link ? (
            <a href={link} class="book-link">{title}</a>
          ) : (
            title
          )}
        </h3>
        
        {author && (
          <div class="book-author">by {author}</div>
        )}
      </div>

      <div class="book-dates">
        {startedDate && (
          <div class="book-date">
            <span class="date-label">Started:</span>
            <span class="date-value">{startedDate}</span>
          </div>
        )}
        
        {finishedDate && (
          <div class="book-date">
            <span class="date-label">Finished:</span>
            <span class="date-value">{finishedDate}</span>
          </div>
        )}
      </div>

      <div class="book-meta">
        {format && (
          <span class="book-format">{format}</span>
        )}
        {rating && ratingIconSpecs.length > 0 && (
          <div
            class={`book-rating book-rating--${rating}`}
            aria-label={ratingAriaLabel}
          >
            <span class="book-rating__label">{ratingLabel}</span>
            <span class="book-rating__icons" aria-hidden="true">
              {ratingIconSpecs.map((iconSpec) => {
                const paths = iconSpec.type === 'heart'
                    ? heartIconPaths
                    : thumbIconPaths[iconSpec.direction];

                return (
                  <span class="book-rating__icon" aria-hidden="true">
                    <svg
                      class="book-rating__icon-svg"
                      width={iconSpec.size}
                      height={iconSpec.size}
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      {paths.map((d) => (
                        <path d={d}></path>
                      ))}
                    </svg>
                  </span>
                );
              })}
            </span>
          </div>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .book-card {
    position: relative;
    border-radius: 0.75rem;
    background: transparent;
    box-shadow: none;
    border: none;
    transition: transform 0.25s ease;
    height: fit-content;
  }

  .book-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgba(15, 23, 42, 0.06);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  :global(.dark) .book-card::before {
    background: rgba(148, 163, 184, 0.12);
  }

  .book-card:hover,
  .book-card:focus-within {
    transform: translateY(-2px);
  }

  .book-card:hover::before,
  .book-card:focus-within::before {
    opacity: 1;
  }

  .book-content {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 1rem;
    padding: 1rem;
  }

  .book-cover {
    flex-shrink: 0;
    width: 100px;
    height: 150px;
    background: #f9fafb;
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.dark) .book-cover {
    background: #111827;
  }

  .cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .book-card:hover .cover-image {
    transform: scale(1.05);
  }

  .cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9ca3af;
    background: #f3f4f6;
  }

  :global(.dark) .cover-placeholder {
    color: #6b7280;
    background: #374151;
  }

  .book-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .book-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    color: inherit;
  }

  .book-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: inherit;
  }

  .book-rating__label {
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.7rem;
  }

  .book-rating__icons {
    display: inline-flex;
    gap: 0.25rem;
  }

  .book-rating__icon {
    line-height: 1;
    display: inline-flex;
  }

  .book-rating__icon-svg {
    display: block;
  }

  .book-rating--love .book-rating__icon:nth-child(2) {
    margin-left: -0.2rem;
  }

  .book-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .book-series {
    font-size: var(--text-small);
    color: #6b7280;
    font-weight: 500;
  }

  :global(.dark) .book-series {
    color: #9ca3af;
  }

  .book-title {
    font-size: var(--text-normal);
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    color: #111827;
  }

  :global(.dark) .book-title {
    color: #f9fafb;
  }

  .book-link {
    /* Book links now use global styling */
  }

  .book-author {
    font-size: var(--text-small);
    color: #6b7280;
    font-weight: 500;
  }

  :global(.dark) .book-author {
    color: #9ca3af;
  }

  .book-dates {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: auto;
  }

  .book-date {
    display: flex;
    gap: 0.5rem;
    font-size: var(--text-small);
  }

  .date-label {
    color: #6b7280;
    font-weight: 500;
    min-width: 50px;
  }

  :global(.dark) .date-label {
    color: #9ca3af;
  }

  .date-value {
    color: #374151;
    font-weight: 500;
  }

  :global(.dark) .date-value {
    color: #d1d5db;
  }

  .book-format {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: lowercase;
    letter-spacing: 0.05em;
    color: #1f2937;
    background: transparent;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    border: 1px solid #d1d5db;
    white-space: nowrap;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  :global(.dark) .book-format {
    color: #e5e7eb;
    border-color: #4b5563;
  }

  .book-format:hover {
    color: #111827;
    border-color: #9ca3af;
  }

  :global(.dark) .book-format:hover {
    color: #f3f4f6;
    border-color: #9ca3af;
  }

  /* Mobile adjustments */
  @media (max-width: 640px) {
    .book-content {
      padding: 0.75rem;
      gap: 0.75rem;
    }

    .book-cover {
      width: 80px;
      height: 120px;
    }

    .date-label {
      min-width: 40px;
    }
  }

  /* Very small screens - make cover even larger */
  @media (max-width: 480px) {
    .book-cover {
      width: 90px;
      height: 135px;
    }
  }
</style>
