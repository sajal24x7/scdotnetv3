---
import { Image } from 'astro:assets';
import { getBookCoverImage } from '../../utils/bookCovers';
import type { BookRating } from '../../utils/bookRatings';

interface Props {
    title: string;
    author?: string | string[];
    rating?: BookRating;
    cover?: string;
    link?: string;
}

const { title, author, rating, cover, link } = Astro.props;

const coverImage = cover ? getBookCoverImage(cover) : null;

const formatAuthor = (a?: string | string[]) => {
    if (!a) return null;
    if (typeof a === 'string') return a;
    if (a.length === 0) return null;
    if (a.length === 1) return a[0];
    if (a.length === 2) return `${a[0]} & ${a[1]}`;
    return `${a[0]} et al.`;
};

const ratingLabel: Record<BookRating, string> = {
    love: 'Loved it',
    like: 'Liked it',
    nope: 'Not for me',
};
const ratingClass: Record<BookRating, string> = {
    love: 'hb-card__rating--love',
    like: 'hb-card__rating--like',
    nope: 'hb-card__rating--nope',
};

const formattedAuthor = formatAuthor(author);
const Tag = link ? 'a' : 'div';
---

<article class="hb-card">
    <Tag href={link} class="hb-card__surface">
        <div class="hb-card__cover">
            {coverImage ? (
                <Image
                    src={coverImage}
                    alt={`Cover of ${title}`}
                    width={210}
                    height={315}
                    loading="lazy"
                    decoding="async"
                    class="hb-card__cover-image"
                />
            ) : (
                <div class="hb-card__cover-placeholder" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                    </svg>
                </div>
            )}
        </div>
        <div class="hb-card__content">
            <h3 class="hb-card__title">{title}</h3>
            {formattedAuthor && (
                <p class="hb-card__author">{formattedAuthor}</p>
            )}
            {rating && (
                <span class={`hb-card__rating ${ratingClass[rating]}`}>
                    {ratingLabel[rating]}
                </span>
            )}
        </div>
    </Tag>
</article>

<style>
    .hb-card {
        width: 17rem;
        flex-shrink: 0;
        scroll-snap-align: start;
        background: rgba(0, 0, 0, 0.02);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 0.75rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
        transition:
            background-color 180ms ease,
            box-shadow 220ms ease,
            transform 220ms ease,
            border-color 180ms ease;
    }

    :global(.dark) .hb-card {
        background: rgba(255, 255, 255, 0.03);
        border-color: rgba(255, 255, 255, 0.08);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
    }

    .hb-card:hover,
    .hb-card:focus-within {
        background: rgba(99, 102, 241, 0.04);
        border-color: rgba(99, 102, 241, 0.2);
        box-shadow:
            0 4px 8px rgba(0, 0, 0, 0.08),
            0 8px 24px rgba(129, 140, 248, 0.15);
        transform: translateY(-2px);
    }

    :global(.dark) .hb-card:hover,
    :global(.dark) .hb-card:focus-within {
        background: rgba(99, 102, 241, 0.08);
        border-color: rgba(99, 102, 241, 0.3);
    }

    .hb-card__surface {
        display: flex;
        gap: 1rem;
        padding: 1rem;
        text-decoration: none;
        color: inherit;
        width: 100%;
        height: 100%;
    }

    /* ── Cover ─────────────────────────────────────────────── */
    .hb-card__cover {
        flex-shrink: 0;
        width: 4.5rem;
        max-width: 4.5rem;
        aspect-ratio: 2 / 3;
        border-radius: 0.5rem;
        overflow: hidden;
        background: rgba(15, 23, 42, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    :global(.dark) .hb-card__cover {
        background: rgba(148, 163, 184, 0.18);
    }

    .hb-card__cover-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: inherit;
    }

    .hb-card__cover-placeholder {
        color: rgba(15, 23, 42, 0.35);
    }

    :global(.dark) .hb-card__cover-placeholder {
        color: rgba(226, 232, 240, 0.45);
    }

    /* ── Content ───────────────────────────────────────────── */
    .hb-card__content {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .hb-card__title {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.3;
        margin: 0;
        color: #111827;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    :global(.dark) .hb-card__title {
        color: #f9fafb;
    }

    .hb-card__author {
        font-size: 0.875rem;
        font-weight: 500;
        margin: 0;
        color: #374151;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    :global(.dark) .hb-card__author {
        color: #d1d5db;
    }

    .hb-card__rating {
        margin-top: auto;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .hb-card__rating--love { color: #be185d; }
    .hb-card__rating--like { color: #166534; }
    .hb-card__rating--nope { color: #b91c1c; }

    :global(.dark) .hb-card__rating--love { color: #f9a8d4; }
    :global(.dark) .hb-card__rating--like { color: #86efac; }
    :global(.dark) .hb-card__rating--nope { color: #fca5a5; }
</style>
