---
import { Image } from 'astro:assets';
import { getBookCoverImage } from '../../utils/bookCovers';
import type { BookRating } from '../../utils/bookRatings';

interface Props {
    title: string;
    author?: string | string[];
    rating?: BookRating;
    cover?: string;
    link?: string;
}

const { title, author, rating, cover, link } = Astro.props;

const coverImage = cover ? getBookCoverImage(cover) : null;

const formatAuthor = (a?: string | string[]) => {
    if (!a) return null;
    if (typeof a === 'string') return a;
    if (a.length === 0) return null;
    if (a.length === 1) return a[0];
    if (a.length === 2) return `${a[0]} & ${a[1]}`;
    return `${a[0]} et al.`;
};

const ratingLabel: Record<BookRating, string> = {
    love: 'Loved it',
    like: 'Liked it',
    nope: 'Not for me',
};
const ratingClass: Record<BookRating, string> = {
    love: 'hb-card__rating--love',
    like: 'hb-card__rating--like',
    nope: 'hb-card__rating--nope',
};

const formattedAuthor = formatAuthor(author);
---

<article class="hb-card">
    {link ? (
        <a href={link} class="hb-card__link">
            <div class="hb-card__cover">
                {coverImage ? (
                    <Image
                        src={coverImage}
                        alt={`Cover of ${title}`}
                        width={180}
                        height={270}
                        loading="lazy"
                        decoding="async"
                        class="hb-card__img"
                    />
                ) : (
                    <div class="hb-card__placeholder" aria-hidden="true">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                        </svg>
                    </div>
                )}
            </div>
            <div class="hb-card__body">
                <h3 class="hb-card__title">{title}</h3>
                {formattedAuthor && <p class="hb-card__author">{formattedAuthor}</p>}
                {rating && (
                    <span class={`hb-card__rating ${ratingClass[rating]}`}>
                        {ratingLabel[rating]}
                    </span>
                )}
            </div>
        </a>
    ) : (
        <div class="hb-card__link">
            <div class="hb-card__cover">
                {coverImage ? (
                    <Image
                        src={coverImage}
                        alt={`Cover of ${title}`}
                        width={180}
                        height={270}
                        loading="lazy"
                        decoding="async"
                        class="hb-card__img"
                    />
                ) : (
                    <div class="hb-card__placeholder" aria-hidden="true">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                        </svg>
                    </div>
                )}
            </div>
            <div class="hb-card__body">
                <h3 class="hb-card__title">{title}</h3>
                {formattedAuthor && <p class="hb-card__author">{formattedAuthor}</p>}
                {rating && (
                    <span class={`hb-card__rating ${ratingClass[rating]}`}>
                        {ratingLabel[rating]}
                    </span>
                )}
            </div>
        </div>
    )}
</article>

<style>
    .hb-card {
        width: 10rem;
        flex-shrink: 0;
        scroll-snap-align: start;
        border-radius: 0.75rem;
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.07);
        background: rgba(0, 0, 0, 0.02);
        transition:
            transform 180ms ease,
            box-shadow 220ms ease;
    }

    :global(.dark) .hb-card {
        background: rgba(255, 255, 255, 0.03);
        border-color: rgba(255, 255, 255, 0.08);
    }

    .hb-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    }

    :global(.dark) .hb-card:hover {
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    }

    .hb-card__link {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        height: 100%;
    }

    .hb-card__cover {
        width: 100%;
        aspect-ratio: 2 / 3;
        overflow: hidden;
        background: rgba(0, 0, 0, 0.06);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    :global(.dark) .hb-card__cover {
        background: rgba(255, 255, 255, 0.08);
    }

    .hb-card__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
    }

    .hb-card:hover .hb-card__img {
        transform: scale(1.04);
    }

    .hb-card__placeholder {
        color: rgba(0, 0, 0, 0.25);
    }

    :global(.dark) .hb-card__placeholder {
        color: rgba(255, 255, 255, 0.25);
    }

    .hb-card__body {
        padding: 0.6rem 0.65rem 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        flex: 1;
    }

    .hb-card__title {
        font-size: 0.875rem;
        font-weight: 600;
        line-height: 1.35;
        margin: 0;
        color: rgb(var(--color-text-primary));
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .hb-card__author {
        font-size: 0.75rem;
        margin: 0;
        color: rgb(var(--color-text-secondary));
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .hb-card__rating {
        margin-top: auto;
        padding-top: 0.35rem;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .hb-card__rating--love { color: #be185d; }
    .hb-card__rating--like { color: #166534; }
    .hb-card__rating--nope { color: #b91c1c; }

    :global(.dark) .hb-card__rating--love { color: #f9a8d4; }
    :global(.dark) .hb-card__rating--like { color: #86efac; }
    :global(.dark) .hb-card__rating--nope { color: #fca5a5; }
</style>
