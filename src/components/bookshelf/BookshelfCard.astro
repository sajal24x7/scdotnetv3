---
import '../../styles/shelf-card.css';
import { Image } from 'astro:assets';
import { getBookCoverImage } from '../../utils/bookCovers';
import {
    bookRatingDisplay,
    heartIconPaths,
    thumbIconPaths,
    type BookRating,
    type RatingIconSpec
} from '../../utils/bookRatings';
import { SHELF_STATUS_LABELS, SHELF_STATUS_CHIP_CLASS, type ShelfStatus } from '../../utils/shelfStatus';

interface BookshelfCardProps {
    title: string;
    author?: string | string[];
    series?: string;
    seriesNumber?: number;
    format?: string;
    genre?: string;
    status?: ShelfStatus;
    readingProgress?: number;
    started?: Date | string;
    finished?: Date | string;
    created?: Date | string;
    rating?: BookRating;
    cover?: string;
    link?: string;
}

const props = Astro.props as BookshelfCardProps;

const parseDate = (value: Date | string | undefined) => {
    if (!value) {
        return null;
    }

    if (value instanceof Date) {
        return Number.isNaN(value.getTime()) ? null : value;
    }

    const parsed = new Date(value);
    return Number.isNaN(parsed.getTime()) ? null : parsed;
};

const formatYMD = (value: Date | string | undefined) => {
    const date = parseDate(value);

    if (!date) {
        return null;
    }

    return date.toISOString().slice(0, 10);
};

const formatAuthors = (author?: string | string[]) => {
    if (!author) {
        return null;
    }

    if (typeof author === 'string') {
        return author;
    }

    if (author.length === 0) {
        return null;
    }

    if (author.length === 1) {
        return author[0];
    }

    if (author.length === 2) {
        return `${author[0]} and ${author[1]}`;
    }

    return `${author.slice(0, -1).join(', ')}, and ${author[author.length - 1]}`;
};

const {
    title,
    author,
    series,
    seriesNumber,
    format,
    genre,
    status,
    readingProgress,
    started,
    finished,
    created,
    rating,
    cover,
    link
} = props;

const normalizedStatus: ShelfStatus | undefined = status ?? undefined;

const statusLabel = normalizedStatus ? SHELF_STATUS_LABELS.bookshelf[normalizedStatus] : null;
const statusChipClass = normalizedStatus ? SHELF_STATUS_CHIP_CLASS[normalizedStatus] : '';

const normalizedFormat = format ? format.toLowerCase() : null;

const formatLabelMap: Record<string, string> = {
    audio: 'AUDIOBOOK',
    audiobook: 'AUDIOBOOK',
    ebook: 'EBOOK',
    digital: 'EBOOK',
    paper: 'PAPERBACK',
    paperback: 'PAPERBACK',
    hardcover: 'HARDCOVER'
};

const formatLabel = normalizedFormat ? (formatLabelMap[normalizedFormat] ?? normalizedFormat.toUpperCase()) : null;

const genreLabel = genre ? genre.toUpperCase() : null;

const finishedDate = formatYMD(finished);
const startedDate = formatYMD(started);
const startedLabel = startedDate ?? null;
const finishedLabel = finishedDate ?? null;

const shouldShowRating = normalizedStatus !== 'started' && normalizedStatus !== 'todo';
const ratingDisplay = shouldShowRating && rating ? bookRatingDisplay[rating] : null;
const ratingAriaLabel = ratingDisplay
    ? ratingDisplay.label
    : 'Rating: Not set';
const ratingIconSpecs: readonly RatingIconSpec[] = ratingDisplay?.iconSpecs ?? [];
const ratingChipLabel = ratingDisplay?.label ?? null;

const safeProgress = (() => {
    if (status !== 'started') {
        return null;
    }

    if (typeof readingProgress !== 'number') {
        return null;
    }

    if (!Number.isFinite(readingProgress)) {
        return null;
    }

    return Math.max(0, Math.min(100, Math.round(readingProgress)));
})();

const coverImage = cover ? getBookCoverImage(cover) : null;
const formattedAuthor = formatAuthors(author);

const seriesInfo = (() => {
    if (!series || series === 'none' || series === '') return null;
    return { name: series, number: seriesNumber ?? null };
})();

const timelineLabel = (() => {
    if (startedLabel && finishedLabel) {
        return `Read ${startedLabel} - ${finishedLabel}`;
    }

    if (startedLabel) {
        return `Read ${startedLabel} -`;
    }

    if (finishedLabel) {
        return `Read - ${finishedLabel}`;
    }

    return null;
})();
---

<article class="book-card" data-card-root>
  <div class="book-card__surface">
    <div class="book-card__cover">
      {coverImage ? (
        <Image
          src={coverImage}
          alt={`Cover of ${title}`}
          width={210}
          height={315}
          layout="fixed"
          class="book-card__cover-image"
          loading="lazy"
        />
      ) : (
        <div class="book-card__cover-placeholder" aria-hidden="true">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
        </div>
      )}
    </div>

    <div class="book-card__content">
      <header class="book-card__header">
        <div class="book-card__title-row">
          <div class="book-card__title-block">
            {seriesInfo && (
              <button
                type="button"
                class="book-card__series book-card__series--clickable"
                data-filter-type="series"
                data-filter-value={seriesInfo.name}
              >
                {seriesInfo.name}{seriesInfo.number !== null ? ` #${seriesInfo.number}` : ''}
              </button>
            )}
            <h3 class="book-card__title">
              {link ? (
                <a href={link} class="book-card__title-link">
                  {title}
                </a>
              ) : (
                title
              )}
            </h3>
          </div>
        </div>
        {formattedAuthor && (
          <button
            type="button"
            class="book-card__author book-card__author--clickable"
            data-filter-type="author"
            data-filter-value={formattedAuthor}
          >
            {formattedAuthor}
          </button>
        )}
      </header>

      {(statusLabel || genreLabel || formatLabel || ratingChipLabel || timelineLabel) && (
        <div class="book-card__meta" data-meta>
          <div class="book-card__meta-row book-card__meta-row--chips">
            {statusLabel && normalizedStatus && normalizedStatus !== 'finished' && (
              <button
                type="button"
                class={`book-card__chip book-card__chip--status book-card__chip--clickable ${statusChipClass}`}
                data-filter-type="status"
                data-filter-value={normalizedStatus}
              >
                {statusLabel}
              </button>
            )}
            {genreLabel && genre && (
              <button
                type="button"
                class="book-card__chip book-card__chip--genre book-card__chip--clickable"
                data-filter-type="genre"
                data-filter-value={genre}
              >
                {genreLabel}
              </button>
            )}
            {formatLabel && format && (
              <button
                type="button"
                class="book-card__chip book-card__chip--format book-card__chip--clickable"
                data-filter-type="format"
                data-filter-value={format}
              >
                {formatLabel}
              </button>
            )}
            {ratingChipLabel && rating && (
              <button
                type="button"
                class={`book-card__chip book-card__chip--rating book-card__chip--clickable ${
                  rating ? `book-card__chip--rating-${rating}` : 'book-card__chip--rating-none'
                }`}
                data-filter-type="rating"
                data-filter-value={rating}
                aria-label={ratingAriaLabel}
              >
                <span class="book-card__chip-label">{ratingChipLabel}</span>
                {ratingIconSpecs.length > 0 && (
                  <span
                    class={`book-card__rating-icons ${
                      rating ? `book-card__rating-icons--${rating}` : ''
                    }`}
                    aria-hidden="true"
                  >
                    {ratingIconSpecs.map((iconSpec) => (
                      <span class="book-card__rating-icon">
                        <svg
                          width={iconSpec.size}
                          height={iconSpec.size}
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          {(
                            iconSpec.type === 'heart'
                                ? heartIconPaths
                                : thumbIconPaths[iconSpec.direction]
                          ).map((d) => (
                            <path d={d}></path>
                          ))}
                        </svg>
                      </span>
                    ))}
                  </span>
                )}
              </button>
            )}
            {timelineLabel && (
              <span class="book-card__chip book-card__chip--timeline">
                <span class="book-card__chip-label">{timelineLabel}</span>
              </span>
            )}
          </div>
        </div>
      )}

      {safeProgress !== null && (
        <div
          class="book-card__progress"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow={safeProgress}
        >
          <span class="book-card__progress-track">
            <span
              class="book-card__progress-fill"
              style={`width: ${safeProgress}%;`}
            ></span>
          </span>
        </div>
      )}
    </div>
  </div>
</article>

