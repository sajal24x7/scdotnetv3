---
import BookCard from './BookCard.astro';

interface Props {
  books: any[];
}

const { books } = Astro.props;

// Transform books for BookCard component
const transformBook = (book: any) => ({
  ...book.data,
  link: book.slug ? `/bookshelf/${book.slug}/` : undefined
});
---

<div class="book-grid">
  {books.map((book) => (
    <BookCard {...transformBook(book)} />
  ))}
</div>

<style>
  .book-grid {
    display: grid;
    /* Mobile: 1 column */
    grid-template-columns: 1fr;
    gap: 1rem;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0;
  }

  /* Tablet and desktop: 2 columns */
  @media (min-width: 768px) {
    .book-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  /* Extra large screens: still 2 columns but with more gap */
  @media (min-width: 1280px) {
    .book-grid {
      gap: 2rem;
    }
  }

  /* Mobile adjustments */
  @media (max-width: 767px) {
    .book-grid {
      padding: 0 0.5rem;
      gap: 0.75rem;
    }
  }
</style>