---
import BookCard from './BookCard.astro';

interface Props {
    books: any[];
}

const { books } = Astro.props;

// Transform books for BookCard component
const transformBook = (book: any) => ({
    ...book.data,
    link: book.slug ? `/bookshelf/${book.slug}/` : undefined
});

const getSpanClass = (book: any) => {
    const span = book?.data?.layout?.span;

    switch (span) {
        case 12:
            return 'grid-span-12';
        case 8:
            return 'grid-span-8';
        case 6:
            return 'grid-span-6';
        case 4:
            return 'grid-span-4';
        default:
            return 'grid-span-4';
    }
};
---

<div class="book-grid twelve-grid grid-gap-tight">
    {books.map((book) => (
        <div class={`book-grid__item ${getSpanClass(book)}`}>
            <BookCard {...transformBook(book)} />
        </div>
    ))}
</div>

<style>
    .book-grid {
        align-items: stretch;
    }

    .book-grid__item {
        display: flex;
        min-width: 0;
    }

    .book-grid__item :global(.book-card) {
        width: 100%;
    }
</style>