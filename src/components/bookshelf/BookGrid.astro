---
import BookshelfCard from './BookshelfCard.astro';

interface Props {
    books: any[];
}

const { books } = Astro.props;

// Transform books for BookshelfCard component
const transformBook = (book: any) => ({
    ...book.data,
    link: book.id ? `/bookshelf/${book.id}/` : undefined
});

const getGridClasses = (book: any) => {
    const span = book?.data?.layout?.span;

    switch (span) {
        case 12:
            return 'grid-span-12';
        case 8:
            return 'grid-start-3 grid-span-8';
        case 6:
            return 'grid-start-4 grid-span-6';
        case 4:
            return 'grid-start-4 grid-span-6';
        default:
            return 'grid-start-3 grid-span-8';
    }
};
---

<div class="book-grid twelve-grid grid-gap-tight">
    {books.map((book) => (
        <div class={`book-grid__item ${getGridClasses(book)}`}>
            <BookshelfCard {...transformBook(book)} />
        </div>
    ))}
</div>

<style>
    .book-grid {
        align-items: stretch;
    }

    .book-grid__item {
        display: flex;
        min-width: 0;
    }

    .book-grid__item :global(.book-card) {
        width: 100%;
    }
</style>
