---
interface Props {
  name: string;
  title: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  bookLink?: string;
  bookTitle?: string;
  jobDescription?: string;
}

const { 
  name, 
  title, 
  description, 
  imageSrc, 
  imageAlt, 
  bookLink, 
  bookTitle, 
  jobDescription 
} = Astro.props;
---

<div class="py-12 mb-8">
  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8 sm:gap-12">
    <!-- Larger circular photo on the left -->
    <img 
      src={imageSrc} 
      alt={imageAlt} 
      class="w-56 h-56 sm:w-72 sm:h-72 rounded-full object-cover shadow-lg flex-shrink-0"
    />
    
    <!-- Bio and newsletter signup on the right -->
    <div class="text-center sm:text-left flex-1">
      <h1 class="text-2xl sm:text-3xl font-bold mb-4">{title}</h1>
      <div class="prose dark:prose-invert max-w-none">
        <p class="text-base sm:text-lg leading-relaxed">
          {description}
          {bookLink && bookTitle && (
            <> I am the author of <a href={bookLink} class="text-accent hover:text-accent/80">{bookTitle}</a>, a collection of poems for young adults.</>
          )}
        </p>
        {jobDescription && (
          <p class="text-base sm:text-lg mb-0">
            {jobDescription}
          </p>
        )}
      </div>
    </div>
  </div>
</div> 