---
interface Props {
  name: string;
  title: string;
  description?: string;
  imageSrc: string;
  imageAlt: string;
  bookLink?: string;
  bookTitle?: string;
  jobDescription?: string;
}

const { 
  name, 
  title, 
  description = "I am a platform engineer and a writer based in Finland.<br />I am the author of <a href='/books/a-year-of-mornings/' class='text-accent hover:text-accent/80'>A Year of Mornings</a>, a collection of poems for young adults.<br />",
  imageSrc, 
  imageAlt, 
  bookLink, 
  bookTitle, 
  jobDescription 
} = Astro.props;
---

<div class="py-12 mb-8">
  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8 sm:gap-12">
    <!-- Larger circular photo on the left -->
    <img 
      src={imageSrc} 
      alt={imageAlt} 
      class="w-56 h-56 sm:w-72 sm:h-72 rounded-full object-cover shadow-lg flex-shrink-0"
    />
    
    <!-- Bio and newsletter signup on the right -->
    <div class="text-center sm:text-left flex-1">
      <h1 class="text-huge font-bold mb-4">{title}</h1>
      <div class="prose dark:prose-invert max-w-none">
        <p class="text-normal leading-relaxed" set:html={description}>
        </p>
        {jobDescription && (
          <p class="text-normal mb-0">
            {jobDescription}
          </p>
        )}
      </div>
    </div>
  </div>
</div> 