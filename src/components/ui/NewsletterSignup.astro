---
interface Props {
  title?: string;
  description?: string;
  actionUrl?: string;
  targetUrl?: string;
  placeholder?: string;
  buttonText?: string;
  showCopy?: boolean;
  wrapperClass?: string;
  formClass?: string;
}

const {
  title = "NordLetter",
  description = "I send out a newsletter once a week about living in Finland + five interesting things I've found on the open web.",
  actionUrl = "https://buttondown.com/api/emails/embed-subscribe/sajal24x7",
  targetUrl = "https://buttondown.com/sajal24x7",
  placeholder = "email address",
  buttonText = "Subscribe",
  showCopy = true,
  wrapperClass = "",
  formClass = ""
} = Astro.props;

const outerClasses = ["py-8", wrapperClass].filter(Boolean).join(" ");
const formClasses = [
  "flex flex-col sm:flex-row gap-3 max-w-md mx-auto items-center",
  formClass
].filter(Boolean).join(" ");
---

<div class={outerClasses}>
  <div class="prose dark:prose-invert max-w-none">
    {showCopy && title && <h2 class="text-large font-bold mb-4">{title}</h2>}
    {showCopy && description && (
      <p class="text-normal mb-6">
        {description}
      </p>
    )}

    <form
      class={formClasses}
      action={actionUrl}
      method="post"
      target="popupwindow"
      onsubmit={`window.open('${targetUrl}', 'popupwindow')`}
    >
      <input
        type="email"
        name="email"
        placeholder={placeholder}
        required
        class="w-64 sm:flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent text-center"
      />
      <button
        type="submit"
        class="w-auto px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors font-medium"
      >
        {buttonText}
      </button>
    </form>
  </div>
</div>
