---
interface Props {
  title?: string;
  description?: string;
  actionUrl?: string;
  targetUrl?: string;
  placeholder?: string;
  buttonText?: string;
  showCopy?: boolean;
  wrapperClass?: string;
  formClass?: string;
  headingClass?: string;
  centered?: boolean;
}

const {
  title = "NordLetter",
  description = "I send out a newsletter once a week about living in Finland + five interesting things I've found on the open web.",
  actionUrl = "https://buttondown.com/api/emails/embed-subscribe/sajal24x7",
  targetUrl = "https://buttondown.com/sajal24x7",
  placeholder = "email address",
  buttonText = "Subscribe",
  showCopy = true,
  wrapperClass = "",
  formClass = "",
  headingClass = "text-large font-bold mb-4",
  centered = false
} = Astro.props;

const outerClasses = [wrapperClass || "py-8"].filter(Boolean).join(" ");
const innerClasses = ["prose dark:prose-invert max-w-none", centered && "text-center"].filter(Boolean).join(" ");
const formClasses = [
  "flex flex-col sm:flex-row gap-3 max-w-md items-center",
  centered && "mx-auto",
  formClass
].filter(Boolean).join(" ");
---

<div class={outerClasses}>
  <div class={innerClasses}>
    {showCopy && title && <h2 class={headingClass}>{title}</h2>}
    {showCopy && description && (
      <p class="text-normal mb-6">
        {description}
      </p>
    )}

    <form
      class={formClasses}
      action={actionUrl}
      method="post"
      target="popupwindow"
      onsubmit={`window.open('${targetUrl}', 'popupwindow')`}
    >
      <input
        type="email"
        name="email"
        placeholder={placeholder}
        required
        class="w-80 sm:flex-1 px-4 py-1.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-[#8b5cf6] focus:border-transparent text-center"
      />
      <button
        type="submit"
        class="w-auto px-6 py-1.5 bg-[#8b5cf6] hover:bg-[#7c3aed] text-white rounded-lg transition-colors font-medium"
      >
        {buttonText}
      </button>
    </form>
  </div>
</div>
