---
interface Props {
  title: string;
  description: string;
  count: number;
  countLabel: string;
  tagsLink?: string;
  tagsLinkText?: string;
}

const { 
  title, 
  description, 
  count, 
  countLabel, 
  tagsLink, 
  tagsLinkText = "View entries by tag" 
} = Astro.props;
---

<header class="py-8 border-t border-black/10 dark:border-white/10">
  <div class="text-center">
    <h1 class="text-3xl sm:text-4xl font-bold mb-4">{title}</h1>
    <p class="text-base text-gray-600 dark:text-gray-400 mb-4 max-w-2xl mx-auto">
      {description}
    </p>
    <div class="text-sm text-purple-600 dark:text-purple-400 font-medium mb-4">
      {count} {count === 1 ? countLabel : countLabel}
    </div>
    {tagsLink && (
      <a 
        href={tagsLink} 
        class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
      >
        {tagsLinkText}
      </a>
    )}
  </div>
</header> 