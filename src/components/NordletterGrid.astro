---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import manifest from '../data/nordletter-image-manifest.json';
import { formatDateWithoutYear } from '../utils/dateFormat';

const { posts } = Astro.props;

const imageModules = import.meta.glob(
  '../images/nordletter/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
) as Record<string, { default: ImageMetadata }>;

const imagesByFileName = Object.fromEntries(
  Object.entries(imageModules).map(([key, module]) => [key.split('/').pop() ?? key, module.default])
);

const manifestMap = manifest as Record<string, string>;

const getLocalImage = (post: typeof posts[number]) => {
  const slug = post?.id;
  if (!slug) {
    return undefined;
  }

  const fileName = manifestMap[slug];
  if (!fileName) {
    return undefined;
  }

  return imagesByFileName[fileName];
};

// Group posts by year
const postsByYear = posts.reduce((acc, post) => {
  const year = post.data.pubDate.getFullYear();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof posts>);

// Sort years in descending order
const sortedYears = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);

const getSpanClass = (post: typeof posts[number]) => {
  const span = post?.data?.layout?.span;

  if (span === 6) {
    return 'grid-span-6';
  }

  if (span === 12) {
    return 'grid-span-12';
  }

  return 'grid-span-3';
};

const getVariantClass = (post: typeof posts[number]) => {
  const span = post?.data?.layout?.span;

  if (span === 12) {
    return 'nordletter-item--full';
  }

  if (span === 6) {
    return 'nordletter-item--wide';
  }

  return 'nordletter-item--standard';
};
---

{sortedYears.map((year) => (
  <section class="nordletter-year" aria-labelledby={`nordletter-year-${year}`}>
    <header class="nordletter-year__header grid-span-full">
      <h2 id={`nordletter-year-${year}`} class="nordletter-year__title">
        {year}
      </h2>
    </header>

    {postsByYear[year].map((post) => {
      const localImage = getLocalImage(post);
      const postTags = Array.isArray(post.data.tags) ? post.data.tags.join(',') : '';

      return (
        <article class={`nordletter-item ${getSpanClass(post)} ${getVariantClass(post)}`} data-content-item data-tags={postTags}>
          <a href={post.data.link} class="nordletter-link">
            {localImage ? (
              <div class="nordletter-image">
                <Image
                  src={localImage}
                  alt={post.data.title}
                  width={384}
                  height={384}
                  fit="cover"
                  loading="lazy"
                  decoding="async"
                  sizes="(max-width: 48rem) 40vw, 9.5rem"
                  class="nordletter-image__picture"
                />
              </div>
            ) : post.data.image ? (
              <div class="nordletter-image">
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  loading="lazy"
                  decoding="async"
                  width="384"
                  height="384"
                />
              </div>
            ) : null}
          <div class="nordletter-content">
            <div class="nordletter-edition">
              {post.data.editionDisplay || `${post.data.edition || 'N/A'} · ${formatDateWithoutYear(post.data.pubDate)}`}
            </div>
            <h3 class="nordletter-title">{post.data.title}</h3>
          </div>
        </a>
        </article>
      );
    })}
  </section>
))}

<style>
  .nordletter-year {
    display: contents;
  }

  .nordletter-year__header {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(0.75rem, 2vw, 1.25rem);
    border-bottom: 1px solid rgba(31, 41, 55, 0.12);
  }

  .nordletter-year:first-of-type .nordletter-year__header {
    margin-top: 0;
  }

  .nordletter-year__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: #1f2937;
    margin: 0;
    text-align: center;
  }

  .nordletter-item {
    min-width: 0;
  }

  .nordletter-link {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 2.5vw, 1.25rem);
    align-items: center;
    padding: clamp(1rem, 3vw, 1.5rem);
    text-decoration: none;
    color: inherit;
    height: 100%;
    transition: transform 0.2s ease;
  }

  .nordletter-link:hover {
    transform: translateY(-2px);
  }

  .nordletter-image {
    width: clamp(6rem, 20vw, 9.5rem);
    height: clamp(6rem, 20vw, 9.5rem);
    border-radius: 9999px;
    overflow: hidden;
    background: #f3f4f6;
    flex-shrink: 0;
    margin-inline: auto;
  }

  .nordletter-image__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .nordletter-image img,
  .nordletter-image__picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .nordletter-link:hover .nordletter-image img,
  .nordletter-link:hover .nordletter-image__picture img {
    transform: scale(1.05);
  }

  .nordletter-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
    align-items: center;
  }

  .nordletter-edition {
    font-size: 0.875rem;
    font-weight: 400;
    color: #6b7280;
    margin-bottom: 0.25rem;
  }

  .nordletter-title {
    font-size: clamp(1.125rem, 2.8vw, 1.5rem);
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
    color: #1f2937;
    transition: color 0.2s ease;
  }

  .nordletter-link:hover .nordletter-title {
    color: #3b82f6;
  }

  .nordletter-item--wide .nordletter-content,
  .nordletter-item--full .nordletter-content {
    max-width: 32rem;
    margin-inline: auto;
  }

  @media (min-width: 48rem) {
    .nordletter-item--wide .nordletter-link {
      flex-direction: row;
      align-items: center;
      text-align: left;
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }

    .nordletter-item--wide .nordletter-image {
      margin-inline: 0;
    }

    .nordletter-item--wide .nordletter-content {
      text-align: left;
      align-items: flex-start;
      margin-inline: 0;
    }
  }

  /* Dark mode styles */
  :global(.dark) .nordletter-year__header {
    border-bottom-color: rgba(148, 163, 184, 0.24);
  }

  :global(.dark) .nordletter-year__title {
    color: #f9fafb;
  }

  :global(.dark) .nordletter-title {
    color: #f9fafb;
  }

  :global(.dark) .nordletter-link:hover .nordletter-title {
    color: #93c5fd;
  }

  :global(.dark) .nordletter-edition {
    color: #9ca3af;
  }

  :global(.dark) .nordletter-image {
    background: #1f2937;
  }

  @media (max-width: 47.999rem) {
    .nordletter-year {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1rem, 4vw, 1.5rem);
    }

    .nordletter-year__header {
      grid-column: 1 / -1;
    }

    .nordletter-year .nordletter-item.grid-span-3 {
      grid-column: auto;
    }
  }
</style>
