---
import PostItem from './PostItem.astro';
import { parseMarkdown } from '../utils/markdown';

interface Props {
  posts: any[];
  title?: string;
  showTitle?: boolean;
  showFullContent?: boolean;
}

const { posts, title = "Recent Items", showTitle = true, showFullContent = true } = Astro.props;

// Pre-render markdown content for posts
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? parseMarkdown(post.body) : null
}));

// Check if content is micro type
const isMicroContent = (category: string) => category === 'micro';
---

<div class="recent-items layout-boundary px-2 md:px-4">
  {showTitle && (
    <h2 class="recent-items-title">{title}</h2>
  )}

  <div class="recent-items-list">
    {renderedPosts.map((post) => (
      <PostItem post={post} isMicroContent={isMicroContent} showFullContent={showFullContent} />
    ))}
  </div>
</div>

<style>
  .recent-items {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    width: 100%;
  }

  .recent-items-title {
    font-size: var(--text-large);
    font-weight: 700;
    color: rgb(var(--color-text-primary));
    margin: 0;
    text-align: center;
  }

  .recent-items-list {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .recent-items-list :global(.post-item) {
    --post-item-spacing: clamp(1.5rem, 4vw, 2.5rem);
  }

  @media (min-width: 48rem) {
    .recent-items-title {
      text-align: left;
    }
  }
</style>
