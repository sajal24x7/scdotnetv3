---
import CategoryDisplay from './CategoryDisplay.astro';

interface Props {
  backlinks: {
    slug: string;
    title: string;
    description: string;
    category: string;
    pubDate: Date;
  }[];
}

const { backlinks } = Astro.props;
---

{backlinks.length > 0 && (
  <section class="backlink-container">
    <div class="inner-container">
      <h3>{backlinks.length} Backlinks</h3>
      <div class="backlink-list">
        {backlinks.map((backlink) => (
          <article class="backlink-item">
            <a href={backlink.slug} class="backlink-link">
              <div class="backlink-content">
                <div class="backlink-header">
                  <CategoryDisplay category={backlink.category} />
                  <h4 class="backlink-title">{backlink.title}</h4>
                </div>
                {backlink.description && (
                  <p class="backlink-description">{backlink.description}</p>
                )}
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .backlink-container {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(var(--color-border));
  }

  .backlink-container h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: rgb(var(--color-text-primary));
  }

  .backlink-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .backlink-container .backlink-item {
    border: 1px solid #e5e7eb;
    background-color: #ffffff;
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    transition: box-shadow 0.2s, border-color 0.2s, background-color 0.2s;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    cursor: pointer;
  }

  .backlink-container .backlink-item:hover {
    border-color: #a78bfa;
    box-shadow: 0 4px 16px 0 rgba(136, 58, 234, 0.08);
    background-color: #fafaff;
  }

  :global(.dark) .backlink-container .backlink-item {
    background-color: #18181b;
    border-color: #27272a;
  }

  :global(.dark) .backlink-container .backlink-item:hover {
    border-color: #a78bfa;
    background-color: #232336;
  }

  .backlink-container .backlink-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .backlink-container .backlink-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .backlink-container .backlink-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: nowrap;
  }

  .backlink-container .backlink-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: #111827;
    line-height: 1.4;
    transition: color 0.2s ease;
    flex: 1;
    min-width: 0;
  }

  .backlink-container .backlink-item:hover .backlink-title {
    color: #3b82f6;
  }

  :global(.dark) .backlink-container .backlink-title {
    color: #f9fafb;
  }

  :global(.dark) .backlink-container .backlink-item:hover .backlink-title {
    color: #60a5fa;
  }

  .backlink-container .backlink-description {
    font-size: 0.875rem;
    color: #4b5563;
    line-height: 1.5;
    margin: 0;
  }

  :global(.dark) .backlink-container .backlink-description {
    color: #d1d5db;
  }

  @media (max-width: 768px) {
    .backlink-container .backlink-item {
      padding: 0.875rem 1rem;
    }

    .backlink-container .backlink-header {
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .backlink-container .backlink-title {
      font-size: 0.875rem;
      flex: 1;
      min-width: 200px;
    }
  }
</style>
