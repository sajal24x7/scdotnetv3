---
import CategoryDisplay from './CategoryDisplay.astro';
import TimeDisplay from './TimeDisplay.astro';

interface Props {
    backlinks: {
        slug: string;
        title: string;
        description: string;
        category: string;
        created: Date;
        snippet?: string;
    }[];
}

type BacklinkItem = Props['backlinks'][number];

interface NormalizedBacklink extends BacklinkItem {
    link: string;
    context: string;
}

const { backlinks } = Astro.props;
const normalizedBacklinks: NormalizedBacklink[] = backlinks.map((backlink) => {
    const category = backlink.category && backlink.category.trim().length > 0 ? backlink.category : 'blog';
    const description = backlink.description?.trim() ?? '';
    const slug = backlink.slug?.trim() ?? '';
    // Prefer the sentence the link appears in; fall back to the note's description.
    const context = backlink.snippet?.trim() || description;

    if (slug.startsWith('http')) {
        return {
            ...backlink,
            category,
            description,
            context,
            link: slug
        };
    }

    const sanitizedSlug = slug.replace(/[?#].*$/, '');
    const normalizedPath = sanitizedSlug.replace(/^\/+/, '').replace(/\/+$/, '');
    const link = normalizedPath.length > 0 ? `/${normalizedPath}/` : '/';

    return {
        ...backlink,
        category,
        description,
        context,
        link
    };
});

const count = normalizedBacklinks.length;
const countText = count === 1 ? '1 note leads here' : `${count} notes lead here`;
---

{count > 0 && (
    <section class="backlinks" aria-labelledby="backlinks-heading">
        <header class="backlinks__header">
            <h3 id="backlinks-heading" class="backlinks__heading">Paths into this note</h3>
            <p class="backlinks__count">{countText}</p>
        </header>
        <ul class="backlinks__list">
            {normalizedBacklinks.map((backlink) => (
                <li class="backlinks__item">
                    <div class="backlinks__item-header">
                        <a href={backlink.link} class="backlinks__title link-hover">
                            {backlink.title}
                        </a>
                        <span class="backlinks__meta">
                            <CategoryDisplay category={backlink.category} className="backlinks__category" />
                            <TimeDisplay date={backlink.created} category={backlink.category} className="backlinks__date" />
                        </span>
                    </div>
                    {backlink.context && (
                        <p class="backlinks__context">{backlink.context}</p>
                    )}
                </li>
            ))}
        </ul>
    </section>
)}

<style>
    .backlinks {
        margin-top: clamp(3rem, 6vw, 4rem);
        padding-top: clamp(2rem, 5vw, 3rem);
        border-top: 1px solid rgb(var(--color-border));
    }

    .backlinks__header {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        margin-bottom: clamp(1.25rem, 3vw, 1.75rem);
    }

    .backlinks__heading {
        font-size: clamp(1.125rem, 2vw, 1.375rem);
        font-weight: 600;
        color: rgb(var(--color-text-primary));
        margin: 0;
    }

    .backlinks__count {
        font-size: var(--text-small);
        color: rgb(var(--color-text-secondary));
        margin: 0;
    }

    .backlinks__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: clamp(1.25rem, 3vw, 1.75rem);
    }

    .backlinks__item {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        max-width: 42rem;
    }

    .backlinks__item-header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.25rem 0.75rem;
    }

    .backlinks__title {
        font-weight: 600;
        color: rgb(var(--color-text-primary));
        text-decoration: none;
    }

    .backlinks__title:hover,
    .backlinks__title:focus-visible {
        color: rgb(var(--color-accent));
    }

    .backlinks__meta {
        display: inline-flex;
        align-items: baseline;
        gap: 0.5rem;
        font-size: var(--text-xs);
        color: rgb(var(--color-text-secondary));
        white-space: nowrap;
    }

    .backlinks__context {
        font-size: var(--text-small);
        line-height: 1.6;
        color: rgb(var(--color-text-secondary));
        margin: 0;
        border-left: 2px solid rgb(var(--color-border));
        padding-left: 0.875rem;
    }
</style>
