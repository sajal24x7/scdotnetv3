---
import Card from './Card.astro';

interface Props {
    backlinks: {
        slug: string;
        title: string;
        description: string;
        category: string;
        pubDate: Date;
    }[];
}

const { backlinks } = Astro.props;
const headingId = `backlinks-${backlinks.length}`;
---

{backlinks.length > 0 && (
    <section class="backlinks" aria-labelledby={headingId}>
        <div class="backlinks__inner">
            <h3 id={headingId} class="backlinks__heading">
                {backlinks.length} Backlink{backlinks.length === 1 ? '' : 's'}
            </h3>
            <div class="backlinks__grid">
                {backlinks.map((backlink) => (
                    <div class="backlinks__card">
                        <Card
                            title={backlink.title}
                            description={backlink.description}
                            pubDate={backlink.pubDate}
                            category={backlink.category}
                            link={backlink.slug}
                        />
                    </div>
                ))}
            </div>
        </div>
    </section>
)}

<style>
    .backlinks {
        margin-top: clamp(3rem, 6vw, 4rem);
        padding-top: clamp(2rem, 5vw, 3rem);
        border-top: 1px solid rgb(var(--color-border));
    }

    :global(.dark) .backlinks {
        border-top-color: rgb(var(--color-border));
    }

    .backlinks__inner {
        display: flex;
        flex-direction: column;
        gap: clamp(1.5rem, 3vw, 2rem);
    }

    .backlinks__heading {
        font-size: clamp(1.125rem, 2vw, 1.375rem);
        font-weight: 600;
        color: rgb(var(--color-text-primary));
        margin: 0;
    }

    .backlinks__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1rem, 3vw, 1.75rem);
    }

    @media (min-width: 48rem) {
        .backlinks__grid {
            grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
        }
    }

    .backlinks__card {
        display: flex;
        height: 100%;
    }

    .backlinks__card :global(.card) {
        width: 100%;
    }
</style>
