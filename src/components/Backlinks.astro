---
interface Props {
  backlinks: {
    slug: string;
    title: string;
    description: string;
  }[];
}

const { backlinks } = Astro.props;
---

{backlinks.length > 0 && (
  <section class="backlink-container">
    <div class="inner-container">
      <h3>{backlinks.length} Backlinks</h3>
      <div class="backlink-grid">
        {backlinks.map((backlink) => (
          <article class="backlink-card">
            <div class="card-content">
              <div class="card-body">
                <h2 class="card-title">
                  <a href={backlink.slug} class="card-link">
                    {backlink.title}
                  </a>
                </h2>
                
                <div class="card-description">
                  {backlink.description && (
                    <p class="description-text">
                      {backlink.description}
                    </p>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}