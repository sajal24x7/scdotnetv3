---
import Card from './Card.astro';

interface Props {
  backlinks: {
    slug: string;
    title: string;
    description: string;
    category: string;
    pubDate: Date;
  }[];
}

const { backlinks } = Astro.props;
---

{backlinks.length > 0 && (
  <section class="backlink-container">
    <div class="inner-container">
      <h3>{backlinks.length} Backlinks</h3>
      <div class="backlink-grid">
        {backlinks.map((backlink) => (
          <div class="backlink-card-wrapper">
            <Card 
              title={backlink.title}
              description=""
              category={backlink.category}
              pubDate={backlink.pubDate}
              link={backlink.slug}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
)}