---
import CategoryDisplay from './CategoryDisplay.astro';

interface Props {
  backlinks: {
    slug: string;
    title: string;
    description: string;
    category: string;
    pubDate: Date;
  }[];
}

const { backlinks } = Astro.props;
---

{backlinks.length > 0 && (
  <section class="backlink-container">
    <div class="inner-container">
      <h3>{backlinks.length} Backlinks</h3>
      <div class="backlink-card">
        {backlinks.map((backlink, index) => (
          <div class="backlink-item">
            <div class="backlink-header">
              <h4 class="backlink-title">
                <a href={backlink.slug}>{backlink.title}</a>
                <CategoryDisplay category={backlink.category} className="backlink-category" />
              </h4>
            </div>
            {backlink.description && (
              <p class="backlink-description">{backlink.description}</p>
            )}
            {index < backlinks.length - 1 && <div class="backlink-divider"></div>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}