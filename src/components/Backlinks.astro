---
import CategoryDisplay from './CategoryDisplay.astro';

interface Props {
  backlinks: {
    slug: string;
    title: string;
    description: string;
    category: string;
    pubDate: Date;
  }[];
}

const { backlinks } = Astro.props;
---

{backlinks.length > 0 && (
  <section class="backlink-container">
    <div class="inner-container">
      <h3>{backlinks.length} Backlinks</h3>
      <div class="backlink-list">
        {backlinks.map((backlink) => (
          <article class="backlink-item">
            <a href={backlink.slug} class="backlink-link">
              <div class="backlink-content">
                <div class="backlink-header">
                  <CategoryDisplay category={backlink.category} />
                  <h4 class="backlink-title">{backlink.title}</h4>
                </div>
                {backlink.description && (
                  <p class="backlink-description">{backlink.description}</p>
                )}
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}