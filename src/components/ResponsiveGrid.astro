---
import Card from './Card.astro';
import { marked } from 'marked';
import LinkHoverEffect from './LinkHoverEffect.astro';

const { posts } = Astro.props;

// Configure marked options
marked.setOptions({
  gfm: true, // GitHub Flavored Markdown
  breaks: true // Convert line breaks to <br>
});

// Pre-render markdown content
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? marked.parse(post.body) : null
}));
---

<div class="responsive-grid">
  {renderedPosts.map((post) => (
    <Card {...post.data}>
      {post.renderedContent && (
        <div class="prose dark:prose-dark max-w-none">
          <div set:html={post.renderedContent} />
        </div>
      )}
    </Card>
  ))}
</div>

<LinkHoverEffect />

<style>
  .responsive-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    width: 100%;
    max-width: 1800px;
    margin: 0 auto;
    padding: 0;
  }

  /* Mobile adjustments - single column */
  @media (max-width: 768px) {
    .responsive-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
      max-width: none;
      padding: 0 1rem;
    }
  }

  /* Tablet adjustments - 2 columns */
  @media (min-width: 768px) and (max-width: 1024px) {
    .responsive-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      max-width: 95vw;
      margin: 0 auto;
    }
  }

  /* Desktop - 3 columns */
  @media (min-width: 1024px) and (max-width: 1440px) {
    .responsive-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      max-width: 90vw;
      margin: 0 auto;
    }
  }

  /* Large desktop - 3 columns with more space */
  @media (min-width: 1440px) and (max-width: 1920px) {
    .responsive-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      max-width: 85vw;
      margin: 0 auto;
    }
  }

  /* Extra large screens - 4 columns */
  @media (min-width: 1920px) {
    .responsive-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem;
      max-width: 80vw;
      margin: 0 auto;
    }
  }

  /* Ensure links are properly styled */
  :global(.prose a) {
    color: #3b82f6;
    text-decoration: none;
    transition: color 0.2s;
  }

  :global(.prose a:hover) {
    color: #2563eb;
    text-decoration: underline;
  }

  :global(.dark .prose a) {
    color: #60a5fa;
  }

  :global(.dark .prose a:hover) {
    color: #93c5fd;
  }
</style>