---
import Card from './Card.astro';
import { parseMarkdown } from '../utils/markdown';

const { posts } = Astro.props;

// Pre-render markdown content
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? parseMarkdown(post.body) : null
}));
---

<div class="grid grid-cols-1 gap-12 py-12 layout-boundary max-w-none md:max-w-layout px-4 md:px-0">
  {renderedPosts.map((post) => (
    <Card {...post.data}>
      {post.renderedContent && (
        <div class="prose dark:prose-dark max-w-none">
          <div set:html={post.renderedContent} />
        </div>
      )}
    </Card>
  ))}
</div>


<style>
  /* Add a subtle divider between cards */
  .grid > *:not(:last-child) {
    position: relative;
  }

  .grid > *:not(:last-child)::after {
    content: '';
    position: absolute;
    bottom: -1.5rem;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgb(229 231 235),
      transparent
    );
  }

  :global(.dark) .grid > *:not(:last-child)::after {
    background: linear-gradient(
      to right,
      transparent,
      rgb(55 65 81),
      transparent
    );
  }

  /* Ensure links are properly styled */
  :global(.prose a) {
    color: #3b82f6;
    text-decoration: none;
    transition: color 0.2s;
  }

  :global(.prose a:hover) {
    color: #2563eb;
    text-decoration: underline;
  }

  :global(.dark .prose a) {
    color: #60a5fa;
  }

  :global(.dark .prose a:hover) {
    color: #93c5fd;
  }
</style> 