---
import { formatDateWithTime } from '../utils/dateFormat';

interface Props {
  title?: string;
  content: string;
  url: string;
  pubDate: Date;
  link?: string;
}

const { title, content, url, pubDate, link } = Astro.props;

const formattedDate = formatDateWithTime(pubDate);

// Truncate content for preview
const MAX_CONTENT_LENGTH = 280; // Twitter-like character limit
let previewContent = content.trim();
if (previewContent.length > MAX_CONTENT_LENGTH) {
  previewContent = previewContent.substring(0, MAX_CONTENT_LENGTH) + '...';
}
---

<article class="relative">
  <div class="absolute -left-2 top-2 w-3 h-3 bg-accent rounded-full"></div>
  <div class="flex flex-col">
    <p class="text-sm text-textSecondary dark:text-textSecondaryDark mb-1">
      <a href={url} class="text-accent hover:text-accent/80 transition-colors">
        {formattedDate}
      </a>
    </p>
    
    {title && (
      <h3 class="text-lg font-semibold mb-2">
        <a href={url} class="hover:text-accent transition-colors">
          {title}
        </a>
      </h3>
    )}
    
    <div class="mb-2 text-textPrimary dark:text-textPrimaryDark">
      <p>{previewContent}</p>
    </div>
    
    {link && (
      <a 
        href={link} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-sm text-accent hover:underline break-all mb-2"
      >
        {link}
      </a>
    )}
  </div>
</article> 