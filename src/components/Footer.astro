---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { formatDateWithTime } from '../utils/dateFormat';
import SearchModal from './SearchModal.astro';

// Get current year for copyright
const currentYear = new Date().getFullYear();

// Get all year directories - these are the actual collections used in the site
const years = ['2012', '2013', '2014', '2015', '2016', '2017', '2019', '2021', '2022', '2024', '2025'] as const;

// Fetch all content from year-based collections
const allCollections = await Promise.all(years.map(year => getCollection(year as any)));
const allContent = allCollections.flat().filter((item: any) => item?.data?.pubDate).sort((a: any, b: any) => 
  new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

// Variables to calculate streak
let streakWeeks = 0;
let lastPostDate = null;
let totalPosts = allContent.length;
let weekCounts = new Map();

// Calculate streak if there's any content
if (allContent.length > 0) {
  // Get the latest post date
  lastPostDate = new Date((allContent[0] as any).data.pubDate);
  
  // Create a map to track if there was a post in each week
  const weekMap = new Map();
  
  allContent.forEach((item: any) => {
    const postDate = new Date(item.data.pubDate);
    // Get year and week number for this post
    const year = postDate.getFullYear();
    // Get week number using ISO week date calculation for better accuracy
    const startOfYear = new Date(year, 0, 1);
    const daysSinceStart = Math.floor((postDate.getTime() - startOfYear.getTime()) / (24 * 60 * 60 * 1000));
    const weekNumber = Math.floor(daysSinceStart / 7);
    
    // Create a unique key for this week
    const weekKey = `${year}-${weekNumber}`;
    
    // Count posts per week
    if (weekCounts.has(weekKey)) {
      weekCounts.set(weekKey, weekCounts.get(weekKey) + 1);
    } else {
      weekCounts.set(weekKey, 1);
    }
    
    // Mark this week as having a post
    weekMap.set(weekKey, true);
  });
  
  // Calculate the current week
  const now = new Date();
  const nowYear = now.getFullYear();
  const startOfThisYear = new Date(nowYear, 0, 1);
  const daysSinceStartOfYear = Math.floor((now.getTime() - startOfThisYear.getTime()) / (24 * 60 * 60 * 1000));
  const currentWeekNumber = Math.floor(daysSinceStartOfYear / 7);
  const currentWeekKey = `${nowYear}-${currentWeekNumber}`;
  
  // Start counting backwards from the most recent week with posts
  streakWeeks = 0;
  let checkWeekNumber = currentWeekNumber;
  let checkYear = nowYear;
  
  // If current week has no posts, start from last week
  if (!weekMap.has(currentWeekKey)) {
    checkWeekNumber -= 1;
    // Handle year boundary
    if (checkWeekNumber < 0) {
      checkYear--;
      checkWeekNumber = 51; // Approximately 52 weeks in a year
    }
  }
  
  // Count consecutive weeks with posts
  let counting = true;
  while (counting && checkYear >= 2020) { // Don't go back too far
    const weekKey = `${checkYear}-${checkWeekNumber}`;
    
    if (weekMap.has(weekKey)) {
      streakWeeks++;
      checkWeekNumber--;
      
      // If we go below week 0, go to previous year
      if (checkWeekNumber < 0) {
        checkYear--;
        checkWeekNumber = 51;
      }
    } else {
      counting = false;
    }
  }
}

// Ensure we have at least 1 week if there are any posts
if (allContent.length > 0 && streakWeeks === 0) {
  streakWeeks = 1;
}

// Format the last post date
const formattedLastPostDate = lastPostDate ? formatDateWithTime(lastPostDate) : 'Never';

// Debug info for weeks
const uniqueWeeks = [...weekCounts.keys()].sort().reverse();
const lastThreeWeeks = uniqueWeeks.slice(0, 3);
