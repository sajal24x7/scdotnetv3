---
import { formatDateWithTime } from '../utils/dateFormat';
import { getPostActivitySummary } from '../utils/postStats';

// Get current year for copyright
const currentYear = new Date().getFullYear();

const { latestPostDate, streakWeeks, totalPosts } = await getPostActivitySummary();
const hasPosts = totalPosts > 0;
const formattedLastPostDate = latestPostDate ? formatDateWithTime(latestPostDate) : '';

const footerNavItems = [
    { href: '/garden/', label: 'Garden' },
    { href: '/stream/', label: 'Stream' },
    { href: '/nordletter/', label: 'Nordletter' },
    { href: '/books/', label: 'Books' },
    { href: '/sajal/', label: 'About' },
    { href: '/feeds/', label: 'Feeds' },
    { href: '/search/', label: 'Search' },
    { href: '/colophon/', label: 'Colophon' },
];
---

<footer class="py-6 border-t border-borderColor bg-bgSecondary text-textPrimary">
    <div class="container mx-auto px-4 max-w-6xl">
        <nav aria-label="Footer navigation" class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-small">
            {footerNavItems.map((item) => (
                <a href={item.href} class="text-textSecondary hover:text-textPrimary transition-colors">
                    {item.label}
                </a>
            ))}
        </nav>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mt-6 pt-6 border-t border-borderColor text-center sm:text-left">
            {hasPosts && (
                <div class="text-textSecondary text-normal">
                    <p class="text-small opacity-75 mb-2">This website was last updated on {formattedLastPostDate}</p>
                    <p class="font-medium">New posts for <span class="text-accent">{streakWeeks}</span> consecutive {streakWeeks === 1 ? 'week' : 'weeks'}</p>
                    <p class="mt-1 text-small opacity-75">{totalPosts} total posts</p>
                </div>
            )}

            <p class="text-textSecondary text-small">
                &copy; {currentYear} Sajal Choudhary. All rights reserved.
            </p>
        </div>
    </div>
</footer>
