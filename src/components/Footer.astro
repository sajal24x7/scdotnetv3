---
import { formatDateWithTime } from '../utils/dateFormat';
import { getPostActivitySummary } from '../utils/postStats';

// Get current year for copyright
const currentYear = new Date().getFullYear();

const { latestPostDate, streakWeeks, totalPosts } = await getPostActivitySummary();
const hasPosts = totalPosts > 0;
const formattedLastPostDate = latestPostDate ? formatDateWithTime(latestPostDate) : '';

// Footer page links removed; footer now only shows copyright and stats
---

<footer class="py-6 border-t border-gray-600 dark:border-gray-400 bg-black text-white">
    <div class="container mx-auto px-4 max-w-6xl">
        {hasPosts && (
            <div class="text-center text-gray-300 text-normal pt-4">
                <p class="text-small opacity-75 mb-2">This website was last updated on {formattedLastPostDate}</p>
                <p class="font-medium">New posts for <span class="text-orange-500">{streakWeeks}</span> consecutive {streakWeeks === 1 ? 'week' : 'weeks'}</p>
                <p class="mt-1 text-small opacity-75">{totalPosts} total posts</p>
            </div>
        )}

        <!-- Copyright moved to the end -->
        <div class="text-center mt-6">
            <p class="text-gray-300 text-sm">
                &copy; {currentYear} Sajal Choudhary. All rights reserved.
            </p>
        </div>
    </div>
</footer>
