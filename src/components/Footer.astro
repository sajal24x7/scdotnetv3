---
import { getPostActivitySummary } from '../utils/postStats';
import NewsletterSignup from './ui/NewsletterSignup.astro';

// Get current year for copyright
const currentYear = new Date().getFullYear();

const { streakWeeks, totalPosts } = await getPostActivitySummary();
const hasPosts = totalPosts > 0;

const footerNavItems = [
    { href: '/sajal/', label: 'About' },
    { href: '/colophon/', label: 'Colophon' },
    { href: '/now/', label: 'Now' },
    { href: '/evergreen/', label: 'Evergreen' },
    { href: '/til/', label: 'TIL' },
    { href: '/stories/', label: 'Stories' },
    { href: '/poems/', label: 'Poems' },
    { href: '/photos/', label: 'Photos' },
    { href: '/bookshelf/', label: 'Bookshelf' },
];
---

<footer class="site-footer py-6 border-t">
    <div class="container mx-auto px-4 max-w-6xl">
        <nav aria-label="Footer navigation" class="footer-nav flex flex-wrap justify-center gap-x-6 gap-y-2 text-small">
            {footerNavItems.map((item) => (
                <a href={item.href}>
                    {item.label}
                </a>
            ))}
        </nav>

        <div class="footer-bottom-grid grid grid-cols-1 md:grid-cols-2 gap-8 mt-6 pt-6">
            <div class="footer-subscribe text-center md:text-left">
                <h2 class="text-large font-bold mb-3">Stay up to date</h2>
                <NewsletterSignup
                    showCopy={false}
                    buttonText="Subscribe"
                    wrapperClass="py-0 mb-3"
                    formClass="justify-center md:justify-start mx-auto md:mx-0"
                />
                <a href="/feeds/" class="footer-rss-btn">Subscribe via RSS</a>
            </div>

            <div class="footer-stats text-center md:text-right">
                <p class="text-small opacity-75 mb-2">&copy; {currentYear} Sajal Choudhary</p>
                {hasPosts && (
                    <p class="font-medium">New posts for <span class="footer-accent">{streakWeeks}</span> consecutive {streakWeeks === 1 ? 'week' : 'weeks'}</p>
                )}
            </div>
        </div>
    </div>
</footer>

<style>
    /* Deliberately always dark — a fixed footer band (reusing the site's own
       dark-mode background) rather than following the light/dark toggle or
       the randomized hero palette. */
    .site-footer {
        background: rgb(35, 30, 28);
        color: rgb(255, 250, 240);
        border-color: rgb(85, 75, 70);
    }

    .footer-bottom-grid {
        border-top: 1px solid rgb(85, 75, 70);
    }

    .footer-nav a,
    .footer-stats p {
        color: rgb(209, 213, 219);
    }

    .footer-nav a {
        transition: color 0.2s ease;
    }

    .footer-nav a:hover {
        color: rgb(255, 250, 240);
    }

    .footer-accent {
        color: #a78bfa;
    }

    /* The footer band is always dark regardless of the site's light/dark
       toggle, so the embedded newsletter form needs its own fixed styling
       rather than relying on Tailwind's .dark-scoped variants. */
    .footer-subscribe :global(input[type='email']) {
        background: rgb(45, 38, 34) !important;
        border-color: rgb(85, 75, 70) !important;
        color: rgb(255, 250, 240) !important;
    }

    .footer-subscribe :global(input[type='email']::placeholder) {
        color: rgb(156, 163, 175);
    }

    .footer-rss-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.375rem 1.5rem;
        border: 1px solid rgb(85, 75, 70);
        border-radius: 0.5rem;
        color: rgb(255, 250, 240);
        font-weight: 500;
        transition: background-color 0.2s ease;
    }

    .footer-rss-btn:hover {
        background: rgb(45, 38, 34);
    }
</style>
