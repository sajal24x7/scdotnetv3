---
import { getPostActivitySummary } from '../utils/postStats';

// Get current year for copyright
const currentYear = new Date().getFullYear();

const { streakWeeks, totalPosts } = await getPostActivitySummary();
const hasPosts = totalPosts > 0;

const footerNavItems = [
    { href: '/sajal/', label: 'About' },
    { href: '/colophon/', label: 'Colophon' },
    { href: '/now/', label: 'Now' },
    { href: '/evergreen/', label: 'Evergreen' },
    { href: '/til/', label: 'TIL' },
    { href: '/stories/', label: 'Stories' },
    { href: '/poems/', label: 'Poems' },
    { href: '/photos/', label: 'Photos' },
    { href: '/bookshelf/', label: 'Bookshelf' },
];
---

<footer class="site-footer py-6 border-t">
    <div class="container mx-auto px-4 max-w-6xl">
        <nav aria-label="Footer navigation" class="footer-nav flex flex-wrap justify-center gap-x-6 gap-y-2 text-small">
            {footerNavItems.map((item) => (
                <a href={item.href}>
                    {item.label}
                </a>
            ))}
        </nav>

        <div class="footer-stats-row mt-6 pt-6 text-center">
            <p class="text-small opacity-75 mb-2">&copy; {currentYear} Sajal Choudhary</p>
            {hasPosts && (
                <>
                    <p class="font-medium">New posts for <span class="footer-accent">{streakWeeks}</span> consecutive {streakWeeks === 1 ? 'week' : 'weeks'}</p>
                    <p class="mt-1 text-small opacity-75">{totalPosts} total posts</p>
                </>
            )}
        </div>
    </div>
</footer>

<style>
    /* Deliberately always dark — a fixed footer band (reusing the site's own
       dark-mode background) rather than following the light/dark toggle or
       the randomized hero palette. */
    .site-footer {
        background: rgb(35, 30, 28);
        color: rgb(255, 250, 240);
        border-color: rgb(85, 75, 70);
    }

    .footer-stats-row {
        border-top: 1px solid rgb(85, 75, 70);
    }

    .footer-nav a,
    .footer-stats-row p {
        color: rgb(209, 213, 219);
    }

    .footer-nav a {
        transition: color 0.2s ease;
    }

    .footer-nav a:hover {
        color: rgb(255, 250, 240);
    }

    .footer-accent {
        color: #a78bfa;
    }
</style>
