---
import type { Interaction } from '../../utils/interactions';
import { PLATFORM_META } from './platformMeta';
import { SITE_TIMEZONE } from '../../utils/dateFormat';

interface Props {
    interactions: Interaction[];
}

const { interactions = [] } = Astro.props as Props;

const replies = interactions.filter((i) => i.type === 'reply' || i.type === 'mention');
const likes = interactions.filter((i) => i.type === 'like');
const reposts = interactions.filter((i) => i.type === 'repost');
// Count-only aggregates from platforms that never expose who liked
// (Threads, Instagram) — rendered as chips next to the facepile.
const likeChips = interactions.filter((i) => i.type === 'like-count' && (i.count ?? 0) > 0);
const likeTotal = likes.length + likeChips.reduce((sum, i) => sum + (i.count ?? 0), 0);
const count = replies.length + likeTotal + reposts.length;

const countParts = [
    replies.length > 0 ? `${replies.length} ${replies.length === 1 ? 'reply' : 'replies'}` : null,
    likeTotal > 0 ? `${likeTotal} ${likeTotal === 1 ? 'like' : 'likes'}` : null,
    reposts.length > 0 ? `${reposts.length} ${reposts.length === 1 ? 'repost' : 'reposts'}` : null,
].filter(Boolean);

// Tabs only earn their place when there is more than one kind of response.
const showTabs = countParts.length > 1;

const FACEPILE_LIMIT = 24;

const dateFormatter = new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    timeZone: SITE_TIMEZONE,
});
const dateWithYearFormatter = new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: SITE_TIMEZONE,
});

function formatPublished(published?: string): string | null {
    if (!published) return null;
    const date = new Date(published);
    if (Number.isNaN(date.getTime())) return null;
    const sameYear = date.getFullYear() === new Date().getFullYear();
    return (sameYear ? dateFormatter : dateWithYearFormatter).format(date);
}

function initialOf(name: string): string {
    return (name.trim()[0] || '?').toUpperCase();
}

const facepileGroups = [
    { type: 'like', label: likes.length > 0 ? 'Liked by' : 'Likes', items: likes, chips: likeChips },
    { type: 'repost', label: 'Reposted by', items: reposts, chips: [] as Interaction[] },
].filter((group) => group.items.length > 0 || group.chips.length > 0);
---

{count > 0 && (
    <section class="interactions" aria-labelledby="interactions-heading" data-interactions>
        <header class="interactions__header">
            <div class="interactions__heading-row">
                <h3 id="interactions-heading" class="interactions__heading">Interactions</h3>
                {showTabs && (
                    <div class="interactions__tabs" data-interactions-tabs hidden>
                        <button type="button" class="interactions__tab" data-filter="all" aria-pressed="true">All</button>
                        {replies.length > 0 && (
                            <button type="button" class="interactions__tab" data-filter="replies" aria-pressed="false">
                                Replies ({replies.length})
                            </button>
                        )}
                        {likeTotal > 0 && (
                            <button type="button" class="interactions__tab" data-filter="likes" aria-pressed="false">
                                Likes ({likeTotal})
                            </button>
                        )}
                        {reposts.length > 0 && (
                            <button type="button" class="interactions__tab" data-filter="reposts" aria-pressed="false">
                                Reposts ({reposts.length})
                            </button>
                        )}
                    </div>
                )}
            </div>
            <p class="interactions__count">{countParts.join(' · ')} from around the web</p>
        </header>

        {facepileGroups.length > 0 && (
            <div class="interactions__facepiles">
                {facepileGroups.map((group) => (
                    <div class="interactions__facepile" data-interaction-section={`${group.type}s`}>
                        <span class="interactions__facepile-label">{group.label}</span>
                        <div class="interactions__facepile-avatars">
                            {group.items.slice(0, FACEPILE_LIMIT).map((item) => (
                                <a
                                    href={item.author.url}
                                    class="interactions__facepile-avatar"
                                    title={`${item.author.name} on ${PLATFORM_META[item.platform]?.label ?? item.platform}`}
                                    target="_blank"
                                    rel="nofollow noopener noreferrer"
                                >
                                    {item.author.avatar ? (
                                        <img
                                            src={item.author.avatar}
                                            alt={item.author.name}
                                            class="interactions__avatar-img"
                                            loading="lazy"
                                            decoding="async"
                                            referrerpolicy="no-referrer"
                                        />
                                    ) : (
                                        <span class="interactions__avatar-fallback" aria-hidden="true">
                                            {initialOf(item.author.name)}
                                        </span>
                                    )}
                                </a>
                            ))}
                            {group.items.length > FACEPILE_LIMIT && (
                                <span class="interactions__facepile-more">
                                    +{group.items.length - FACEPILE_LIMIT}
                                </span>
                            )}
                            {group.chips.map((chip) => {
                                const platformMeta = PLATFORM_META[chip.platform];
                                const platformLabel = platformMeta?.label ?? chip.platform;
                                const chipLabel = `${chip.count} ${chip.count === 1 ? 'like' : 'likes'} on ${platformLabel}`;
                                return chip.url ? (
                                    <a
                                        href={chip.url}
                                        class="interactions__count-chip"
                                        aria-label={chipLabel}
                                        target="_blank"
                                        rel="nofollow noopener noreferrer"
                                    >
                                        {platformMeta && (
                                            <span
                                                class="interactions__count-chip-icon"
                                                set:html={platformMeta.icon}
                                                aria-hidden="true"
                                            />
                                        )}
                                        <span class="interactions__count-chip-heart" aria-hidden="true">❤️</span>
                                        <span class="interactions__count-chip-count">{chip.count}</span>
                                    </a>
                                ) : (
                                    <span class="interactions__count-chip" aria-label={chipLabel}>
                                        {platformMeta && (
                                            <span
                                                class="interactions__count-chip-icon"
                                                set:html={platformMeta.icon}
                                                aria-hidden="true"
                                            />
                                        )}
                                        <span class="interactions__count-chip-heart" aria-hidden="true">❤️</span>
                                        <span class="interactions__count-chip-count">{chip.count}</span>
                                    </span>
                                );
                            })}
                        </div>
                    </div>
                ))}
            </div>
        )}

        {replies.length > 0 && (
            <ol class="interactions__stream" data-interaction-section="replies">
                {replies.map((reply) => {
                    const platform = PLATFORM_META[reply.platform];
                    const published = formatPublished(reply.published);
                    return (
                        <li class="interactions__item p-comment h-cite">
                            <div class="interactions__item-avatar p-author h-card">
                                {reply.author.avatar ? (
                                    <img
                                        src={reply.author.avatar}
                                        alt=""
                                        data-initial={initialOf(reply.author.name)}
                                        class="interactions__avatar-img u-photo"
                                        loading="lazy"
                                        decoding="async"
                                        referrerpolicy="no-referrer"
                                    />
                                ) : (
                                    <span class="interactions__avatar-fallback" aria-hidden="true">
                                        {initialOf(reply.author.name)}
                                    </span>
                                )}
                            </div>
                            <div class="interactions__item-body">
                                <div class="interactions__item-meta">
                                    {reply.author.url ? (
                                        <a
                                            href={reply.author.url}
                                            class="interactions__author p-author h-card p-name u-url"
                                            target="_blank"
                                            rel="nofollow noopener noreferrer"
                                        >{reply.author.name}</a>
                                    ) : (
                                        <span class="interactions__author">{reply.author.name}</span>
                                    )}
                                    {platform && (
                                        <span
                                            class="interactions__platform-icon"
                                            set:html={platform.icon}
                                            title={platform.label}
                                        />
                                    )}
                                    {published && reply.url && (
                                        <a
                                            href={reply.url}
                                            class="interactions__timestamp u-url"
                                            target="_blank"
                                            rel="nofollow noopener noreferrer"
                                        >{published}</a>
                                    )}
                                    {published && !reply.url && (
                                        <span class="interactions__timestamp">{published}</span>
                                    )}
                                </div>
                                {reply.content && (
                                    <div class="interactions__content p-content" set:html={reply.content} />
                                )}
                                {reply.url && (
                                    <a
                                        href={reply.url}
                                        class="interactions__reply-link"
                                        target="_blank"
                                        rel="nofollow noopener noreferrer"
                                    >Reply on {platform?.label ?? 'the original post'} ↗</a>
                                )}
                            </div>
                        </li>
                    );
                })}
            </ol>
        )}
    </section>
)}

<script>
    // Tab filtering + avatar fallbacks. Progressive enhancement: without JS
    // the tab bar stays hidden and every section is visible.
    function initInteractions(root: Element) {
        const tabs = root.querySelector<HTMLElement>('[data-interactions-tabs]');
        if (tabs) {
            tabs.hidden = false;
            const buttons = Array.from(tabs.querySelectorAll<HTMLButtonElement>('[data-filter]'));
            const sections = Array.from(root.querySelectorAll<HTMLElement>('[data-interaction-section]'));
            const facepiles = root.querySelector<HTMLElement>('.interactions__facepiles');

            const applyFilter = (filter: string) => {
                for (const section of sections) {
                    section.hidden = filter !== 'all' && section.dataset.interactionSection !== filter;
                }
                if (facepiles) {
                    facepiles.hidden = Array.from(
                        facepiles.querySelectorAll<HTMLElement>('[data-interaction-section]')
                    ).every((section) => section.hidden);
                }
                for (const button of buttons) {
                    button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
                }
            };

            for (const button of buttons) {
                button.addEventListener('click', () => applyFilter(button.dataset.filter || 'all'));
            }
        }

        // Replace broken avatars (deleted accounts, hotlink failures) with
        // an initial so the stream never shows broken-image icons.
        for (const img of root.querySelectorAll<HTMLImageElement>('.interactions__avatar-img')) {
            const swap = () => {
                const fallback = document.createElement('span');
                fallback.className = 'interactions__avatar-fallback';
                fallback.setAttribute('aria-hidden', 'true');
                // Carry over Astro's scope attribute so scoped styles apply.
                for (const attr of Array.from(img.attributes)) {
                    if (attr.name.startsWith('data-astro-cid')) {
                        fallback.setAttribute(attr.name, attr.value);
                    }
                }
                fallback.textContent = (
                    (img.dataset.initial || img.alt || '?').trim()[0] || '?'
                ).toUpperCase();
                img.replaceWith(fallback);
            };
            if (img.complete && img.naturalWidth === 0) {
                swap();
            } else {
                img.addEventListener('error', swap, { once: true });
            }
        }
    }

    document.querySelectorAll('[data-interactions]').forEach(initInteractions);
</script>

<style>
    .interactions {
        margin-top: clamp(3rem, 6vw, 4rem);
        padding-top: clamp(2rem, 5vw, 3rem);
        border-top: 1px solid rgb(var(--color-border));
    }

    .interactions__header {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        margin-bottom: clamp(1.25rem, 3vw, 1.75rem);
    }

    .interactions__heading-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1rem;
    }

    .interactions__heading {
        font-size: clamp(1.125rem, 2vw, 1.375rem);
        font-weight: 600;
        color: rgb(var(--color-text-primary));
        margin: 0;
    }

    .interactions__count {
        font-size: var(--text-small);
        color: rgb(var(--color-text-secondary));
        margin: 0;
    }

    .interactions__tabs {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.25rem;
    }

    .interactions__tab {
        appearance: none;
        border: 1px solid rgb(var(--color-border));
        background: transparent;
        color: rgb(var(--color-text-secondary));
        font-size: var(--text-xs);
        font-weight: 600;
        line-height: 1;
        padding: 0.35rem 0.65rem;
        border-radius: 9999px;
        cursor: pointer;
        transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
    }

    .interactions__tab:hover {
        color: rgb(var(--color-text-primary));
    }

    .interactions__tab[aria-pressed='true'] {
        background: rgb(var(--color-text-primary));
        border-color: rgb(var(--color-text-primary));
        color: rgb(var(--color-bg));
    }

    .interactions__tab:focus-visible {
        outline: 2px solid rgb(var(--color-accent));
        outline-offset: 2px;
    }

    .interactions__facepiles {
        display: flex;
        flex-direction: column;
        gap: 1.125rem;
        margin-bottom: clamp(1.5rem, 3vw, 2rem);
    }

    /* Avatar wall: profile pictures are the point, so give them room. */
    .interactions__facepile {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .interactions__facepile-label {
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgb(var(--color-text-secondary));
    }

    .interactions__facepile-avatars {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.375rem;
    }

    .interactions__facepile-avatar {
        display: inline-flex;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 0.625rem;
        overflow: hidden;
        transition: transform 0.15s ease;
        background: rgb(var(--color-border));
    }

    .interactions__facepile-avatar:hover,
    .interactions__facepile-avatar:focus-visible {
        transform: translateY(-2px);
    }

    .interactions__facepile-more {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 0.625rem;
        background: rgb(var(--color-border));
        font-size: var(--text-xs);
        font-weight: 600;
        color: rgb(var(--color-text-secondary));
    }

    /* Count-only likes (Threads/Instagram expose no accounts) sit beside
       the avatars as a chip of matching height. */
    .interactions__count-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        height: 2.75rem;
        padding: 0 0.875rem;
        border: 1px solid rgb(var(--color-border));
        border-radius: 0.625rem;
        font-size: var(--text-small);
        font-weight: 600;
        color: rgb(var(--color-text-secondary));
        text-decoration: none;
        transition: transform 0.15s ease, color 0.15s ease;
    }

    a.interactions__count-chip:hover,
    a.interactions__count-chip:focus-visible {
        transform: translateY(-2px);
        color: rgb(var(--color-text-primary));
    }

    /* Platform glyph (e.g. Instagram) → heart → count, in place of prose. */
    .interactions__count-chip-icon {
        display: inline-flex;
        width: 1.05rem;
        height: 1.05rem;
    }

    .interactions__count-chip-icon :global(svg) {
        width: 100%;
        height: 100%;
    }

    .interactions__count-chip-heart {
        font-size: 0.9rem;
        line-height: 1;
    }

    .interactions__count-chip-count {
        font-variant-numeric: tabular-nums;
    }

    .interactions__avatar-img,
    .interactions__avatar-fallback {
        width: 100%;
        height: 100%;
        border-radius: inherit;
        object-fit: cover;
        /* Cancel .prose img styling (margins/shadow) from the post container */
        margin: 0;
        box-shadow: none;
    }

    .interactions__avatar-fallback {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: 700;
        color: rgb(var(--color-text-secondary));
        background: rgb(var(--color-border));
    }

    .interactions__stream {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: clamp(1.25rem, 3vw, 1.75rem);
    }

    .interactions__item {
        display: flex;
        gap: 0.75rem;
        max-width: 42rem;
    }

    .interactions__item-avatar {
        flex-shrink: 0;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 0.625rem;
        overflow: hidden;
        background: rgb(var(--color-border));
    }

    .interactions__item-body {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        min-width: 0;
    }

    .interactions__item-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.45rem;
        font-size: var(--text-small);
    }

    .interactions__author {
        font-weight: 600;
        color: rgb(var(--color-text-primary));
        text-decoration: none;
    }

    a.interactions__author:hover,
    a.interactions__author:focus-visible {
        color: rgb(var(--color-accent));
    }

    .interactions__platform-icon {
        display: inline-flex;
        width: 0.875rem;
        height: 0.875rem;
        color: rgb(var(--color-text-secondary));
    }

    .interactions__platform-icon :global(svg) {
        width: 100%;
        height: 100%;
    }

    .interactions__timestamp {
        font-size: var(--text-xs);
        color: rgb(var(--color-text-secondary));
        text-decoration: none;
    }

    a.interactions__timestamp:hover,
    a.interactions__timestamp:focus-visible {
        text-decoration: underline;
    }

    .interactions__content {
        font-size: var(--text-small);
        line-height: 1.6;
        color: rgb(var(--color-text-primary));
        overflow-wrap: anywhere;
    }

    .interactions__content :global(p) {
        margin: 0 0 0.5rem;
    }

    .interactions__content :global(p:last-child) {
        margin-bottom: 0;
    }

    .interactions__content :global(a) {
        color: rgb(var(--color-accent));
        text-decoration: none;
    }

    .interactions__content :global(a:hover) {
        text-decoration: underline;
    }

    .interactions__reply-link {
        font-size: var(--text-xs);
        font-weight: 600;
        color: rgb(var(--color-text-secondary));
        text-decoration: none;
    }

    .interactions__reply-link:hover,
    .interactions__reply-link:focus-visible {
        color: rgb(var(--color-accent));
    }
</style>
