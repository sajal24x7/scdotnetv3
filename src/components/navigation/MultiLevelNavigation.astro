---
interface Props {
  currentPage: string;
  layout?: 'mobile' | 'desktop';
}

const { currentPage, layout = 'desktop' } = Astro.props;

// Main navigation items
const mainNavItems = [
  { href: '/about/', label: 'About', key: 'about' },
  { href: '/garden/', label: 'Garden', key: 'garden' },
  { href: '/stream/', label: 'Stream', key: 'stream' },
  { href: '/nordletter/', label: 'Nordletter', key: 'nordletter' },
];

// Secondary navigation items for each main section
const secondaryNavItems = {
  garden: [
    { href: '/garden/evergreen/', label: 'Evergreen' },
    { href: '/garden/til/', label: 'TIL' },
    { href: '/garden/bookshelf/', label: 'Bookshelf' },
    { href: '/garden/notes/', label: 'Notes' },
  ],
  stream: [
    { href: '/stream/blog/', label: 'Blog' },
    { href: '/stream/micro/', label: 'Micro' },
    { href: '/stream/photos/', label: 'Photos' },
    { href: '/stream/stories/', label: 'Stories' },
    { href: '/stream/poems/', label: 'Poems' },
  ],
};

// Determine which main section is active - improved logic for post pages
const getActiveMainSection = () => {
  // Check for garden section (including all subdirectories and posts)
  if (currentPage.startsWith('/garden/')) return 'garden';
  
  // Check for stream section (including all subdirectories and posts)
  if (currentPage.startsWith('/stream/')) return 'stream';
  
  // Check for individual post categories that belong to garden
  if (currentPage.startsWith('/evergreen/') || 
      currentPage.startsWith('/til/') || 
      currentPage.startsWith('/bookshelf/') || 
      currentPage.startsWith('/notes/')) return 'garden';
  
  // Check for individual post categories that belong to stream
  if (currentPage.startsWith('/blog/') || 
      currentPage.startsWith('/micro/') || 
      currentPage.startsWith('/photo/') || 
      currentPage.startsWith('/story/') || 
      currentPage.startsWith('/poem/')) return 'stream';
  
  // Check for other sections
  if (currentPage.startsWith('/about/')) return 'about';
  if (currentPage.startsWith('/nordletter/')) return 'nordletter';
  
  return null;
};

const activeMainSection = getActiveMainSection();

// Check if a link is active - improved logic for post pages
const isActive = (href: string) => {
  if (href === '/' && currentPage === '/') return true;
  if (href !== '/' && currentPage.startsWith(href)) return true;
  return false;
};

// Check if a main nav item is active
const isMainActive = (key: string) => {
  return activeMainSection === key;
};

// Get the specific subsection that's active for highlighting
const getActiveSubsection = () => {
  // Check for garden subsections
  if (currentPage.startsWith('/evergreen/')) return '/garden/evergreen/';
  if (currentPage.startsWith('/til/')) return '/garden/til/';
  if (currentPage.startsWith('/bookshelf/')) return '/garden/bookshelf/';
  if (currentPage.startsWith('/notes/')) return '/garden/notes/';
  
  // Check for stream subsections
  if (currentPage.startsWith('/blog/')) return '/stream/blog/';
  if (currentPage.startsWith('/micro/')) return '/stream/micro/';
  if (currentPage.startsWith('/photo/')) return '/stream/photos/';
  if (currentPage.startsWith('/story/')) return '/stream/stories/';
  if (currentPage.startsWith('/poem/')) return '/stream/poems/';
  
  return null;
};

const activeSubsection = getActiveSubsection();
---

<div class="w-full">
  <!-- Name Header Row -->
  <div class="border-b border-gray-200 dark:border-gray-700">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="py-4">
        <a href="/" class="inline-block">
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white font-serif tracking-tight">
            Sajal Choudhary
          </h1>
        </a>
      </div>
    </div>
  </div>

  <!-- Primary Navigation Row -->
  <nav class="border-b border-gray-200 dark:border-gray-700">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="flex items-center">
        {mainNavItems.map((item) => (
          <a
            href={item.href}
            class={`px-6 py-4 text-sm font-medium uppercase tracking-wide transition-colors duration-200 ${
              isMainActive(item.key)
                ? 'bg-gray-100/80 dark:bg-gray-800/80 text-gray-900 dark:text-white border-b-2 border-blue-600'
                : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50/50 dark:hover:bg-gray-800/50'
            }`}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <!-- Secondary Navigation Row (persistent for Garden and Stream sections) -->
  {activeMainSection && (activeMainSection === 'garden' || activeMainSection === 'stream') && (
    <nav class="border-b border-gray-200 dark:border-gray-700">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="flex items-center">
          {secondaryNavItems[activeMainSection].map((item) => (
            <a
              href={item.href}
              class={`px-6 py-4 text-sm font-medium uppercase tracking-wide transition-colors duration-200 ${
                (isActive(item.href) || (activeSubsection && activeSubsection === item.href))
                  ? 'bg-white/80 dark:bg-gray-900/80 text-gray-900 dark:text-white border-b-2 border-blue-600'
                  : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-white/50 dark:hover:bg-gray-900/50'
              }`}
            >
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </nav>
  )}
</div>

<style>
  /* Guardian-style typography */
  .font-serif {
    font-family: 'Georgia', 'Times New Roman', serif;
  }
  
  /* Ensure consistent dimensions */
  nav a {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
  }
  
  /* Active state styling */
  nav a.border-b-2 {
    margin-bottom: -1px;
  }
  
  /* Hover effects */
  nav a:hover {
    transition: all 0.2s ease-in-out;
  }
  
  /* Responsive adjustments */
  @media (max-width: 768px) {
    .container {
      padding-left: 1rem;
      padding-right: 1rem;
    }
    
    nav a {
      padding-left: 1rem;
      padding-right: 1rem;
      font-size: 0.875rem;
    }
    
    h1 {
      font-size: 1.5rem;
    }
  }
  
  @media (max-width: 640px) {
    nav a {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
      font-size: 0.75rem;
    }
    
    h1 {
      font-size: 1.25rem;
    }
  }
</style>