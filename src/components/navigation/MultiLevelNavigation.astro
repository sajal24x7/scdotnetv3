---
import SocialLinks from './SocialLinks.astro';

interface Props {
  currentPage: string;
  layout?: 'mobile' | 'desktop';
}

const { currentPage, layout = 'desktop' } = Astro.props;



// Main navigation items
const mainNavItems = [
  { href: '/about/', label: 'About', key: 'about' },
  { href: '/garden/', label: 'Garden', key: 'garden' },
  { href: '/stream/', label: 'Stream', key: 'stream' },
  { href: '/nordletter/', label: 'Nordletter', key: 'nordletter' },
];

// Secondary navigation items for each main section
const secondaryNavItems = {
  garden: [
    { href: '/evergreen/', label: 'Evergreen' },
    { href: '/til/', label: 'TIL' },
    { href: '/bookshelf/', label: 'Bookshelf' },
    { href: '/stories/', label: 'Stories' },
    { href: '/poems/', label: 'Poems' },
  ],
  stream: [
    { href: '/blog/', label: 'Blog' },
    { href: '/micro/', label: 'Micro' },
    { href: '/photos/', label: 'Photos' },
  ],
};

// Determine which main section is active - improved logic for post pages
const getActiveMainSection = () => {
  // Check for garden section (including all subdirectories and posts)
  if (currentPage.startsWith('/garden/')) return 'garden';
  
  // Check for stream section (including all subdirectories and posts)
  if (currentPage.startsWith('/stream/')) return 'stream';
  
  // Check for individual post categories that belong to garden
  if (currentPage.startsWith('/evergreen/') || 
      currentPage.startsWith('/til/') || 
      currentPage.startsWith('/bookshelf/') || 
      currentPage.startsWith('/stories/') ||
      currentPage.startsWith('/poems/')) return 'garden';
  
  // Check for individual post categories that belong to stream
  if (currentPage.startsWith('/blog/') || 
      currentPage.startsWith('/micro/') || 
      currentPage.startsWith('/photos/')) return 'stream';
  
  // Check for tags pages - show garden navigation by default
  if (currentPage.startsWith('/tags/')) return 'garden';
  
  // Check for other sections
  if (currentPage.startsWith('/about/')) return 'about';
  if (currentPage.startsWith('/nordletter/')) return 'nordletter';
  
  return null;
};

const activeMainSection = getActiveMainSection();

// Check if a link is active - improved logic for post pages
const isActive = (href: string) => {
  if (href === '/' && currentPage === '/') return true;
  if (href !== '/' && currentPage.startsWith(href)) return true;
  return false;
};

// Check if a main nav item is active
const isMainActive = (key: string) => {
  return activeMainSection === key;
};

// Get the specific subsection that's active for highlighting
const getActiveSubsection = () => {
  // Check for garden subsections
  if (currentPage.startsWith('/evergreen/')) return '/evergreen/';
  if (currentPage.startsWith('/til/')) return '/til/';
  if (currentPage.startsWith('/bookshelf/')) return '/bookshelf/';
  if (currentPage.startsWith('/stories/')) return '/stories/';
  if (currentPage.startsWith('/poems/')) return '/poems/';
  
  // Check for stream subsections
  if (currentPage.startsWith('/blog/')) return '/blog/';
  if (currentPage.startsWith('/micro/')) return '/micro/';
  if (currentPage.startsWith('/photos/')) return '/photos/';
  
  return null;
};

const activeSubsection = getActiveSubsection();
---

<div class="w-full">
  <script>
    // Handle category filtering for tags pages and update navigation
    document.addEventListener('DOMContentLoaded', function() {
      const urlParams = new URLSearchParams(window.location.search);
      const category = urlParams.get('category');
      
      if (category && window.location.pathname.startsWith('/tags/')) {
        // Determine which main section this category belongs to
        let mainSection = 'garden'; // default
        let subsection = null;
        
        if (['stream', 'blog', 'micro', 'photo'].includes(category)) {
          mainSection = 'stream';
        }
        
        // Map category to subsection for highlighting
        if (category === 'til') subsection = '/til/';
        else if (category === 'evergreen') subsection = '/evergreen/';
        else if (category === 'bookshelf') subsection = '/bookshelf/';
        else if (category === 'stories') subsection = '/stories/';
        else if (category === 'poems') subsection = '/poems/';
        else if (category === 'blog') subsection = '/blog/';
        else if (category === 'micro') subsection = '/micro/';
        else if (category === 'photo') subsection = '/photos/';
        
        // Update the primary navigation highlighting
        const primaryNav = document.querySelector('nav a[href="/' + mainSection + '/"]');
        if (primaryNav) {
          // Remove active state from current active item
          const currentActive = document.querySelector('nav a.bg-gray-100\\/80, nav a.dark\\:bg-gray-800\\/80');
          if (currentActive) {
            currentActive.classList.remove('bg-gray-100/80', 'dark:bg-gray-800/80', 'text-gray-900', 'dark:text-white', 'shadow-sm');
            currentActive.classList.add('text-gray-600', 'dark:text-gray-400');
          }
          
          // Add active state to the correct section
          primaryNav.classList.remove('text-gray-600', 'dark:text-gray-400');
          primaryNav.classList.add('bg-gray-100/80', 'dark:bg-gray-800/80', 'text-gray-900', 'dark:text-white', 'shadow-sm');
        }
        
        // Update secondary navigation highlighting if subsection exists
        if (subsection) {
          const secondaryNav = document.querySelector('nav a[href="' + subsection + '"]');
          if (secondaryNav) {
            // Remove active state from current secondary active item
            const currentSecondaryActive = document.querySelector('nav a.bg-white\\/80, nav a.dark\\:bg-gray-900\\/80');
            if (currentSecondaryActive) {
              currentSecondaryActive.classList.remove('bg-white/80', 'dark:bg-gray-900/80', 'text-gray-900', 'dark:text-white', 'border-b-2', 'border-blue-600', 'shadow-sm');
              currentSecondaryActive.classList.add('text-gray-600', 'dark:text-gray-400');
            }
            
            // Add active state to the correct subsection
            secondaryNav.classList.remove('text-gray-600', 'dark:text-gray-400');
            secondaryNav.classList.add('bg-white/80', 'dark:bg-gray-900/80', 'text-gray-900', 'dark:text-white', 'border-b-2', 'border-blue-600', 'shadow-sm');
          }
        }
      }
    });
  </script>
  <!-- Header: Name and Socials -->
  <div>
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="name-social-row py-4">
        <!-- Site Name -->
        <div class="header-name">
          <a href="/" class="inline-block">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white font-serif tracking-tight">
              Sajal Choudhary
            </h1>
          </a>
        </div>
        
        <!-- Social Links -->
        <div class="header-socials">
          <SocialLinks layout="horizontal" size="sm" />
        </div>
      </div>
    </div>
  </div>

  <!-- Primary Navigation Row -->
  <div>
    <div class="container mx-auto px-4 max-w-6xl">
      <nav class="primary-nav-row py-0.5">
        {mainNavItems.map((item) => (
          <a
            href={item.href}
            class={`px-3 py-0.5 text-sm font-medium uppercase tracking-wide transition-colors duration-200 ${
              isMainActive(item.key)
                ? 'bg-gray-100/80 dark:bg-gray-800/80 text-gray-900 dark:text-white'
                : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50/50 dark:hover:bg-gray-800/50'
            }`}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <!-- Secondary Navigation Row (persistent for Garden and Stream sections) -->
  {activeMainSection && (activeMainSection === 'garden' || activeMainSection === 'stream') && (
    <nav>
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="secondary-nav-row py-0.5">
          {secondaryNavItems[activeMainSection].map((item) => (
            <a
              href={item.href}
              class={`px-3 py-0.5 text-sm font-medium uppercase tracking-wide transition-colors duration-200 ${
                (isActive(item.href) || (activeSubsection && activeSubsection === item.href))
                  ? 'bg-white/80 dark:bg-gray-900/80 text-gray-900 dark:text-white'
                  : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-white/50 dark:hover:bg-gray-900/50'
              }`}
            >
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </nav>
  )}
</div>

<style>
  /* Guardian-style typography */
  .font-serif {
    font-family: 'Georgia', 'Times New Roman', serif;
  }
  
  /* Ensure consistent dimensions */
  nav a {
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
  }
  
  /* Active state styling */
  nav a {
    border-radius: 8px 8px 0 0;
  }
  
  /* Hover effects */
  nav a:hover {
    transition: all 0.2s ease-in-out;
  }
  
  /* Hide scrollbar for horizontal scrolling */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  
  /* Smooth scrolling for mobile */
  .overflow-x-auto {
    scroll-behavior: smooth;
  }
  
  /* Enhanced shadows and transitions */
  nav a {
    transition: all 0.2s ease-in-out;
  }
  
  nav a:hover {
    transform: translateY(-1px);
  }
  
  /* Name and Socials Row */
  .name-social-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }
  
  .header-name {
    flex-shrink: 0;
  }
  
  .header-socials {
    flex-shrink: 0;
  }
  
  /* Primary Navigation Row */
  .primary-nav-row {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  
  .primary-nav-row::-webkit-scrollbar {
    display: none;
  }
  
  /* Secondary Navigation Row */
  .secondary-nav-row {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  
  .secondary-nav-row::-webkit-scrollbar {
    display: none;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .container {
      padding-left: 1rem;
      padding-right: 1rem;
    }
    
    /* Mobile adjustments */
    .name-social-row {
      justify-content: space-between;
      flex-wrap: nowrap;
    }
    
    .header-name {
      margin-right: 1rem;
    }
    
    .primary-nav-row {
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 0.125rem;
    }
    
    .secondary-nav-row {
      justify-content: flex-start;
      flex-wrap: nowrap;
      gap: 0.125rem;
    }
    
    nav {
      width: 100%;
    }
    
    nav a {
      padding-left: 1rem;
      padding-right: 1rem;
      font-size: 0.875rem;
    }
    
    h1 {
      font-size: 1.5rem;
    }
  }
  
  @media (max-width: 640px) {
    nav a {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
      font-size: 0.75rem;
    }
    
    h1 {
      font-size: 1.25rem;
    }
  }
</style>