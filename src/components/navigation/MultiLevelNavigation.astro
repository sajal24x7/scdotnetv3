---
import SocialLinks from './SocialLinks.astro';
import multiLevelNavigationIslandScript from '../islands/multi-level-navigation-island.ts?url';

interface Props {
  currentPage: string;
  layout?: 'mobile' | 'desktop';
  enableSearch?: boolean;
}

const { currentPage, layout = 'desktop', enableSearch = false } = Astro.props as Props;

// Main navigation items (ordered): Garden | Stream | Nordletter | Books | About
const mainNavItems = [
  { href: '/garden/', label: 'Garden', key: 'garden' },
  { href: '/stream/', label: 'Stream', key: 'stream' },
  { href: '/nordletter/', label: 'Nordletter', key: 'nordletter' },
  { href: '/books/', label: 'Books', key: 'books' },
  { href: '/sajal/', label: 'About', key: 'about' },
];

// Secondary navigation items for each main section
const secondaryNavItems = {
  about: [
    { href: '/colophon/', label: 'Colophon' },
    { href: '/now/', label: 'Now' },
    { href: '/feeds/', label: 'Feeds' },
  ],
  garden: [
    { href: '/evergreen/', label: 'Evergreen' },
    { href: '/til/', label: 'TIL' },
    { href: '/bookshelf/', label: 'Bookshelf' },
    { href: '/stories/', label: 'Stories' },
    { href: '/poems/', label: 'Poems' },
  ],
  stream: [
    { href: '/blog/', label: 'Blog' },
    { href: '/micro/', label: 'Micro' },
    { href: '/photos/', label: 'Photos' },
  ],
};

// Determine which main section is active - improved logic for post pages
const getActiveMainSection = () => {
  // Check for about section (including all subdirectories and pages)
  if (currentPage.startsWith('/sajal/')) return 'about';
  
  // Check for garden section (including all subdirectories and posts)
  if (currentPage.startsWith('/garden/')) return 'garden';
  
  // Check for stream section (including all subdirectories and posts)
  if (currentPage.startsWith('/stream/')) return 'stream';
  
  // Check for individual post categories that belong to about
  if (currentPage.startsWith('/sajal/') || 
      currentPage.startsWith('/colophon/') || 
      currentPage.startsWith('/now/') ||
      currentPage.startsWith('/done/') ||
      currentPage.startsWith('/feeds/')) return 'about';
  
  // Check for individual post categories that belong to garden
  if (currentPage.startsWith('/evergreen/') || 
      currentPage.startsWith('/til/') || 
      currentPage.startsWith('/bookshelf/') || 
      currentPage.startsWith('/stories/') ||
      currentPage.startsWith('/poems/')) return 'garden';
  
  // Check for individual post categories that belong to stream
  if (currentPage.startsWith('/blog/') || 
      currentPage.startsWith('/micro/') || 
      currentPage.startsWith('/photos/')) return 'stream';
  
  // Check for tags pages - show garden navigation by default
  if (currentPage.startsWith('/tags/')) return 'garden';
  
  // Check for other sections
  if (currentPage.startsWith('/nordletter/')) return 'nordletter';
  if (currentPage.startsWith('/books/')) return 'books';
  
  return null;
};

const activeMainSection = getActiveMainSection();

const mainActiveClasses = 'bg-gray-100/80 dark:bg-gray-800/80 text-gray-900 dark:text-white border-gray-900 dark:border-white nav-active shadow-sm';
const mainInactiveClasses = 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50/50 dark:hover:bg-gray-800/50 border-gray-600 dark:border-gray-400';
const secondaryActiveClasses = 'bg-white/80 dark:bg-gray-900/80 text-gray-900 dark:text-white border-gray-900 dark:border-white nav-active shadow-sm border-b-2 border-blue-600';
const secondaryInactiveClasses = 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-white/50 dark:hover:bg-gray-900/50 border-gray-600 dark:border-gray-400';
const sectionsWithSecondary = ['about', 'garden', 'stream'] as const;
const secondaryNavEntries = sectionsWithSecondary.map((section) => ({
  section,
  items: secondaryNavItems[section] ?? []
}));


// Check if a link is active - improved logic for post pages
const isActive = (href: string) => {
  if (href === '/' && currentPage === '/') return true;
  if (href !== '/' && currentPage.startsWith(href)) return true;
  return false;
};

// Check if a main nav item is active
const isMainActive = (key: string) => {
  return activeMainSection === key;
};

// Get the specific subsection that's active for highlighting
const getActiveSubsection = () => {
  // Check for about subsections
  if (currentPage.startsWith('/sajal/')) return '/sajal/';
  if (currentPage.startsWith('/colophon/')) return '/colophon/';
  if (currentPage.startsWith('/now/')) return '/now/';
  if (currentPage.startsWith('/done/')) return '/now/'; // Done page highlights Now
  if (currentPage.startsWith('/feeds/')) return '/feeds/';

  // Check for garden subsections
  if (currentPage.startsWith('/evergreen/')) return '/evergreen/';
  if (currentPage.startsWith('/til/')) return '/til/';
  if (currentPage.startsWith('/bookshelf/')) return '/bookshelf/';
  if (currentPage.startsWith('/stories/')) return '/stories/';
  if (currentPage.startsWith('/poems/')) return '/poems/';

  // Check for stream subsections
  if (currentPage.startsWith('/blog/')) return '/blog/';
  if (currentPage.startsWith('/micro/')) return '/micro/';
  if (currentPage.startsWith('/photos/')) return '/photos/';

  return null;
};

const activeSubsection = getActiveSubsection();
---

<multi-level-navigation class="w-full block">
  <!-- Header: Name and Socials -->
  <div>
    <div class="container mx-auto px-4 max-w-6xl">
      <!-- Use 3-column grid: Name | Primary Nav | Socials -->
      <div class="name-social-row py-4">
        <!-- Site Name -->
        <div class="header-name">
          <a href="/" class="inline-block">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white font-serif tracking-tight">
              Sajal Choudhary
            </h1>
          </a>
        </div>
        
        <!-- Primary Navigation Row (moved between name and socials) -->
        <nav class="primary-nav-row py-0.5 nav-area" aria-label="Primary navigation">
          {mainNavItems.map((item, index) => (
            <a
              href={item.href}
              data-main-key={item.key}
              data-active-class={mainActiveClasses}
              data-inactive-class={mainInactiveClasses}
              aria-current={isMainActive(item.key) ? 'page' : undefined}
              class={`px-3 py-0.25 text-sm font-bold uppercase tracking-wide transition-colors duration-200 ${
                index < mainNavItems.length - 1 ? 'border-r' : ''
              } border-b ${
                isMainActive(item.key)
                  ? mainActiveClasses
                  : mainInactiveClasses
              }`}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <!-- Social Links -->
        <div class="header-socials">
          <SocialLinks layout="horizontal" size="sm" enableSearch={enableSearch} />
        </div>

        <!-- Secondary Navigation Row (persistent for About, Garden and Stream sections) -->
        <div class="secondary-in-grid nav-area">
          {secondaryNavEntries.map(({ section, items }) => (
            <nav
              data-secondary-nav
              data-section={section}
              class="secondary-nav-row py-0.5"
              hidden={section !== activeMainSection}
              aria-label={`${section.charAt(0).toUpperCase()}${section.slice(1)} section navigation`}
            >
              {items.map((item, index) => (
                <a
                  href={item.href}
                  data-secondary-href={item.href}
                  data-active-class={secondaryActiveClasses}
                  data-inactive-class={secondaryInactiveClasses}
                  aria-current={
                    isActive(item.href) || (activeSubsection && activeSubsection === item.href)
                      ? 'page'
                      : undefined
                  }
                  class={`px-3 py-0.25 text-sm font-medium uppercase tracking-wide transition-colors duration-200 ${
                    index < items.length - 1 ? 'border-r' : ''
                  } border-b ${
                    (isActive(item.href) || (activeSubsection && activeSubsection === item.href))
                      ? secondaryActiveClasses
                      : secondaryInactiveClasses
                  }`}
                >
                  {item.label}
                </a>
              ))}
            </nav>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Primary Navigation Row moved above between name and socials -->

</multi-level-navigation>

<script type="module" src={multiLevelNavigationIslandScript}></script>

<style>
  /* Guardian-style typography */
  .font-serif {
    font-family: 'Georgia', 'Times New Roman', serif;
  }
  
  /* Ensure consistent dimensions */
  nav a {
    min-height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
  }
  
  /* Active state styling */
  nav a {
    border-radius: 0;
  }

  /* (reverted) */
  
  /* Hover effects */
  nav a:hover {
    transition: all 0.2s ease-in-out;
  }
  
  /* Hide scrollbar for horizontal scrolling */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  
  /* Smooth scrolling for mobile */
  .overflow-x-auto {
    scroll-behavior: smooth;
  }
  
  /* Enhanced shadows and transitions */
  nav a {
    transition: all 0.2s ease-in-out;
  }
  
  nav a:hover {
    transform: translateY(-1px);
  }
  
  /* Name | Primary | Socials layout */
  .name-social-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 0.5rem;
    row-gap: 0.25rem;
    width: 100%;
  }
  .secondary-in-grid {
    grid-column: 2 / 3;
    grid-row: 2 / 3;
  }
  
  .header-name {
    flex-shrink: 0;
  }
  
  .header-socials {
    flex-shrink: 0;
  }
  
  /* Primary Navigation Row */
  .primary-nav-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  
  .primary-nav-row::-webkit-scrollbar {
    display: none;
  }
  
  /* Secondary Navigation Row */
  .secondary-nav-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .secondary-nav-row[hidden] {
    display: none;
  }
  
  .secondary-nav-row::-webkit-scrollbar {
    display: none;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .container {
      padding-left: 1rem;
      padding-right: 1rem;
    }
    
    /* Mobile adjustments: name + socials on one row, then primary, then secondary */
    .name-social-row {
      grid-template-columns: auto 1fr auto;
      grid-template-rows: auto auto auto;
      row-gap: 0.375rem;
    }

    .header-name {
      grid-column: 1 / 2;
      grid-row: 1 / 2;
      justify-self: start;
      margin-right: 0;
      text-align: left;
    }

    .primary-nav-row {
      grid-column: 1 / -1;
      grid-row: 2 / 3;
      justify-content: center;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 0;
    }

    .header-socials {
      grid-column: 3 / 4;
      grid-row: 1 / 2;
      justify-self: end;
    }

    .secondary-in-grid {
      grid-column: 1 / -1;
      grid-row: 3 / 4;
      justify-content: center;
    }

    .secondary-nav-row {
      justify-content: center;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 0;
    }
    
    nav {
      width: 100%;
    }
    
    nav a {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
      font-size: 0.75rem;
    }
    
    h1 {
      font-size: 1.5rem;
    }
  }
  
  @media (max-width: 640px) {
    nav a {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
      font-size: 0.75rem;
    }
    
    h1 {
      font-size: 1.25rem;
    }
  }
</style>
