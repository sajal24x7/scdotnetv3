---
interface Props {
  currentPage: string;
  layout?: 'mobile' | 'desktop';
  showLogo?: boolean;
}

const { 
  currentPage, 
  layout = 'desktop', 
  showLogo = false 
} = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/garden/', label: 'Garden' },
  { href: '/stream/', label: 'Stream' },
  { href: '/nordletter/', label: 'NordLetter' },
  { href: '/books/', label: 'Books' },
  { href: '/prose/', label: 'Prose' },
  { href: '/feeds/', label: 'Feeds' },
];

const isActive = (href: string) => {
  if (href === '/' && currentPage === '/') return true;
  if (href !== '/' && currentPage.startsWith(href)) return true;
  return false;
};
---

{layout === 'mobile' ? (
  <div class="pt-2">
    <div class="grid grid-cols-2 gap-x-4">
      <div class="flex flex-col items-start space-y-0.5">
        <a href="/about/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-small uppercase tracking-wide font-medium text-left">ABOUT</a>
        <a href="/garden/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-small uppercase tracking-wide font-medium text-left">GARDEN</a>
        <a href="/stream/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-small uppercase tracking-wide font-medium text-left">STREAM</a>
      </div>
      <div class="flex flex-col items-start space-y-0.5">
        <a href="/books/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-small uppercase tracking-wide font-medium text-left">BOOKS</a>
        <a href="/prose/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-small uppercase tracking-wide font-medium text-left">PROSE</a>
        <a href="/nordletter/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-small uppercase tracking-wide font-medium text-left">NORDLETTER</a>
      </div>
    </div>
  </div>
) : (
  <div class="flex flex-col items-start">
    <div class="grid grid-cols-2 gap-x-20">
      <div class="flex flex-col items-start">
        <a href="/about/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-normal uppercase tracking-wide font-medium text-left">ABOUT</a>
        <a href="/garden/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-normal uppercase tracking-wide font-medium text-left">GARDEN</a>
        <a href="/stream/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-normal uppercase tracking-wide font-medium text-left">STREAM</a>
      </div>
      <div class="flex flex-col items-start">
        <a href="/books/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-normal uppercase tracking-wide font-medium text-left">BOOKS</a>
        <a href="/prose/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-normal uppercase tracking-wide font-medium text-left">PROSE</a>
        <a href="/nordletter/" class="text-textPrimary hover:text-textPrimary transition-colors py-0.5 inline-block text-normal uppercase tracking-wide font-medium text-left">NORDLETTER</a>
      </div>
    </div>
  </div>
)} 