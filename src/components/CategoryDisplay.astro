---
import { formatCategoryLabel } from '../utils/tagPages';

interface Props {
  category: string;
  className?: string;
}

const { category, className = '' } = Astro.props;
const classes = ['category-display', 'card-chip', className].filter(Boolean).join(' ');
const label = formatCategoryLabel(category);
---

<span class={classes}>
  {label}
</span>

<style>
  .category-display {
    white-space: nowrap;
  }
</style>
