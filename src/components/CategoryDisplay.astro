---
interface Props {
  category: string;
  className?: string;
}

const { category, className = '' } = Astro.props;
const classes = ['category-display', 'card-chip', className].filter(Boolean).join(' ');
---

<span class={classes}>
  {category}
</span>

<style>
  .category-display {
    white-space: nowrap;
  }
</style>
