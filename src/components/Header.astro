---
// src/components/Header.astro
import SearchButton from './SearchButton.astro';

interface Props {
    currentPage: string;
}
const { currentPage } = Astro.props;

const navLinks = [
    { href: '/about/', label: 'About Sajal' },
    { href: '/notes/', label: 'Notes' },
    { href: '/ephemera/', label: 'Ephemera' },
    { href: '/nordletter/', label: 'NordLetter' },
    { href: '/books/', label: 'Books' },
    { href: '/stories/', label: 'Stories' },
    { href: '/poems/', label: 'Poems' },
];
---
<header class="container mx-auto px-4 py-4 max-w-3xl">
    <!-- Mobile: Logo and Navigation in same row -->
    <div class="flex justify-between items-start mb-3 sm:hidden">
        <!-- Logo on the left -->
        <a href="/" class="flex items-center text-xl font-bold text-textPrimary hover:text-accent transition-colors py-2">
            <img src="/logo/logo-square-v2.svg" alt="Sajal Logo" class="mr-3 h-16 w-16 transition-transform duration-300" />
        </a>
        
        <!-- Navigation on the right (two-column grid) -->
        <div class="pt-2">
            <div class="grid grid-cols-2 gap-x-4">
                <div class="flex flex-col items-start space-y-0.5">
                    <a href="/about/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-xs uppercase tracking-wide font-medium text-left">ABOUT SAJAL</a>
                    <div class="flex gap-x-1 items-center py-0.5">
                        <a href="/notes/" class="text-textSecondary hover:text-textPrimary transition-colors inline-block text-xs uppercase tracking-wide font-medium text-left">NOTES</a>
                        <span class="text-textSecondary text-xs">&</span>
                        <a href="/ephemera/" class="text-textSecondary hover:text-textPrimary transition-colors inline-block text-xs uppercase tracking-wide font-medium text-left">EPHEMERA</a>
                    </div>
                    <div class="flex gap-x-1 items-center py-0.5">
                        <a href="/stories/" class="text-textSecondary hover:text-textPrimary transition-colors inline-block text-xs uppercase tracking-wide font-medium text-left">STORIES</a>
                        <span class="text-textSecondary text-xs">&</span>
                        <a href="/poems/" class="text-textSecondary hover:text-textPrimary transition-colors inline-block text-xs uppercase tracking-wide font-medium text-left">POEMS</a>
                    </div>
                </div>
                <div class="flex flex-col items-start space-y-0.5">
                    <a href="/books/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-xs uppercase tracking-wide font-medium text-left">BOOKS</a>
                    <a href="/nordletter/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-xs uppercase tracking-wide font-medium text-left">NORDLETTER</a>
                    <a href="/feeds/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-xs uppercase tracking-wide font-medium text-left">FEEDS</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Desktop: Three column layout -->
    <div class="hidden sm:flex justify-between items-center mb-2">
        <!-- Logo on the left -->
        <a href="/" class="flex items-center text-xl font-bold text-textPrimary hover:text-accent transition-colors py-1">
            <img src="/logo/logo-square-v2.svg" alt="Sajal Logo" class="mr-3 h-20 w-20 transition-transform duration-300" />
        </a>
        <!-- Navigation Links center -->
        <div class="flex flex-col items-start">
            <div class="grid grid-cols-2 gap-x-20">
                <div class="flex flex-col items-start">
                    <a href="/about/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-sm uppercase tracking-wide font-medium text-left">ABOUT SAJAL</a>
                    <div class="flex gap-x-1 items-center py-0.5">
                        <a href="/notes/" class="text-textSecondary hover:text-textPrimary transition-colors inline-block text-sm uppercase tracking-wide font-medium text-left">NOTES</a>
                        <span class="text-textSecondary">&</span>
                        <a href="/ephemera/" class="text-textSecondary hover:text-textPrimary transition-colors inline-block text-sm uppercase tracking-wide font-medium text-left">EPHEMERA</a>
                    </div>
                    <div class="flex gap-x-1 items-center py-0.5">
                        <a href="/stories/" class="text-textSecondary hover:text-textPrimary transition-colors inline-block text-sm uppercase tracking-wide font-medium text-left">STORIES</a>
                        <span class="text-textSecondary">&</span>
                        <a href="/poems/" class="text-textSecondary hover:text-textPrimary transition-colors inline-block text-sm uppercase tracking-wide font-medium text-left">POEMS</a>
                    </div>
                </div>
                <div class="flex flex-col items-start">
                    <a href="/books/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-sm uppercase tracking-wide font-medium text-left">BOOKS</a>
                    <a href="/nordletter/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-sm uppercase tracking-wide font-medium text-left">NORDLETTER</a>
                    <a href="/feeds/" class="text-textSecondary hover:text-textPrimary transition-colors py-0.5 inline-block text-sm uppercase tracking-wide font-medium text-left">FEEDS</a>
                </div>
            </div>
        </div>
        <!-- Action Icons on the right (Search + Social Icons) -->
        <div class="flex flex-col items-end space-y-1">
            <!-- Search -->
            <div class="group flex items-center">
                <SearchButton />
            </div>
            <!-- Mastodon -->
            <a href="https://mastodon.social/@sajal24x7" class="group flex items-center transition-transform hover:scale-105" rel="me" aria-label="Follow on Mastodon" target="_blank" rel="noopener noreferrer">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="h-5 w-5">
                    <path fill="#6364FF" d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.67 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z"/>
                </svg>
            </a>
            <!-- LinkedIn -->
            <a href="https://www.linkedin.com/in/sajal24x7" class="group flex items-center transition-transform hover:scale-105" aria-label="Connect on LinkedIn" target="_blank" rel="noopener noreferrer">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="h-5 w-5">
                    <path fill="#0077B5" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
            </a>
            <!-- RSS -->
            <a href="/rss.xml" class="group flex items-center transition-transform hover:scale-105" aria-label="Subscribe to RSS feed">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="h-5 w-5">
                    <path fill="#FF6600" d="M3.429 2.857v2.857c9.714 0 17.571 7.857 17.571 17.571h2.857C23.857 13.429 13.286 2.857 3.429 2.857zm0 5.714v2.858c5.143 0 9.286 4.143 9.286 9.285h2.857c0-6.857-5.486-12.343-12.143-12.343zm2.285 7.714c1.257 0 2.286 1.029 2.286 2.286S6.971 20.857 5.714 20.857 3.429 19.828 3.429 18.571s1.028-2.286 2.285-2.286z"/>
                </svg>
            </a>
        </div>
    </div>
</header>

<style>
    /* Active state styling */
    .font-semibold.text-accent {
         border-bottom: 2px solid currentColor;
    }
    
    /* Responsive styling */
    @media (max-width: 640px) {
        nav ul {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            text-align: center;
        }
        
        .font-semibold.text-accent {
            border-bottom: 2px solid currentColor;
        }
    }
</style>