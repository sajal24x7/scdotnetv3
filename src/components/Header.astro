---
// src/components/Header.astro
import MultiLevelNavigation from './navigation/MultiLevelNavigation.astro';

interface Props {
    currentPage: string;
    enableSearch?: boolean;
}
const { currentPage, enableSearch = false } = Astro.props as Props;
---

<header class="w-full">
    <MultiLevelNavigation currentPage={currentPage} enableSearch={enableSearch} />
</header>
