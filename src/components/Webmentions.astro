import webmentionsData from '../data/webmentions.json';
import type { WebMention, WebMentionCache } from '../types/webmentions';

interface Props {
  url: string;
  className?: string;
  hasBacklinks?: boolean;
}

const { url, className = '', hasBacklinks = false } = Astro.props;
const webmentions = webmentionsData as WebMentionCache;

// Get the current page URL without trailing slash
const currentUrl = url.replace(/\/$/, '');

// Get all mentions where wm-target matches the current post
const postMentions = webmentions.children.filter((mention: WebMention) => {
  const target = mention["wm-target"];
  const baseUrl = `https://sajalchoudhary.net${currentUrl}`;
  // Match different variations of the URL
  return (
    target === baseUrl ||
    target === `${baseUrl}/` ||
    target === `${baseUrl}.md` ||
    target === `${baseUrl}.md/` ||
    target.startsWith(`${baseUrl}?`)
  ); // Handle URLs with query parameters
});

// Filter for mentions where wm-property is like-of or repost-of
const likesAndReposts = postMentions.filter(
  (mention: WebMention) =>
    mention["wm-property"] === "like-of" || mention["wm-property"] === "repost-of",
);

// Filter for mention with content (including replies and mentions)
const mentionWithContent = postMentions
  .filter(
    (mention: WebMention) =>
      (mention["wm-property"] === "mention-of" || mention["wm-property"] === "in-reply-to") &&
      mention.content,
  )
  .sort((a: WebMention, b: WebMention) => {
    const dateA = new Date(a["wm-received"]).getTime();
    const dateB = new Date(b["wm-received"]).getTime();
    return dateB - dateA;
  });

