// Remove mentions where mention[wm-source] matches blockList
const filteredMentions = mentionWithContent.filter((mention: WebMention) => {
  const domain = mention.url.split("/")[2];
  const isBlocked = blockList.includes(domain);
  return !isBlocked;
});

function mentionType(mention: WebMention) {
  if (mention["in-reply-to"]) return "replied";
  if (mention["like-of"]) return "liked";
  if (mention["bookmark-of"]) return "bookmarked";
  if (mention["mention-of"]) return "mentioned";
  return "unknown";
}

function sourceType(mention: WebMention) {
  const property = mention["wm-property"];
  // Map webmention properties to icon names
  const iconMap: Record<string, string> = {
    "mention-of": "heroicons:chat-bubble-left",
    "like-of": "heroicons:heart",
    "repost-of": "heroicons:arrow-path",
    "bookmark-of": "heroicons:bookmark",
    "in-reply-to": "heroicons:arrow-uturn-left",
  };
  return iconMap[property] || null;
}

function platformType(mention: WebMention) {
  if (
    mention.url.includes("bsky.app") ||
    mention["wm-source"].includes("brid.gy/comment/bluesky")
  ) {
    return { icon: "bluesky", class: "platform-icon bluesky-icon" };
  }
  if (
    mention.url.includes("twitter.com") ||
    mention.url.includes("x.com") ||
    mention["wm-source"].includes("brid.gy/post/twitter") ||
    mention["wm-source"].includes("brid.gy/comment/twitter")
  ) {
    return { icon: "twitter", class: "platform-icon twitter-icon" };
  }
  if (
    mention.url.includes("mastodon.social") ||
    mention["wm-source"].includes("brid.gy/post/mastodon") ||
    mention["wm-source"].includes("brid.gy/comment/mastodon")
  ) {
    return { icon: "mastodon", class: "platform-icon mastodon-icon" };
  }
  // Add other platforms here in the future
  return null;
}

function formatDate(date: string | number | Date) {
  const parsedDate = new Date(date);
  return parsedDate.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function getDomain(url: string) {
  return url.replace(/(^\w+:|^)\/\//, "").split("/")[0];
}

function formatContent(content: string) {
  const contentWithoutDomain = content.replace(/sajalchoudhary.net.*/g, "");
  return contentWithoutDomain.slice(0, 280);
}

// Filter likes for duplicate author photos
const likesWithoutDuplicates = likesAndReposts.filter(
  (like, index, self) =>
    index ===
    self.findIndex(
      (t) => t.author.photo === like.author.photo && t.author.name === like.author.name,
    ),
);
---

{(likesAndReposts.length > 0 || filteredMentions.length > 0) && (
  <div class={`webmentions ${className}`}>
    <div class="webmentions-container">
      <div class="webmentions-header">
        <h3 class="webmentions-title">Mentions around the web</h3>
      </div>

      {likesAndReposts.length > 0 && (
        <div class="likes-images-container">
          <div class="likes-container">
            {likesWithoutDuplicates.slice(0, 20).map((like: WebMention, index: number) =>
              like.author.photo ? (
                <div class="single-image">
                  <img src={like.author.photo} alt={like.author.name} />
                </div>
              ) : (
                <div class="single-image">
                  <svg
                    width="42"
                    height="42"
                    viewBox="0 0 42 42"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    class="placeholder-svg"
                  >
                    <circle cx="50%" cy="50%" r="21" fill="rgb(var(--color-accent))" />
                  </svg>
                </div>
              ),
            )}
            <span>{likesAndReposts.length} Likes and Reposts</span>
          </div>
        </div>
      )}

      {filteredMentions.length > 0 && (
        <>
          <div class="mentions-scroll-container">
            <div class="mentions-content-container">
              {filteredMentions.map((mention: WebMention, index: number) => {
                const platform = platformType(mention);
                return (
                  <div class:list={["reply", { hidden: index >= 4 }]}>
                    {mention.author.photo ? (
                      <img src={mention.author.photo} alt={mention.author.name} />
                    ) : (
                      <svg
                        width="42"
                        height="42"
                        viewBox="0 0 42 42"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        class="placeholder-svg"
                      >
                        <circle cx="50%" cy="50%" r="21" fill="rgb(var(--color-accent))" />
                      </svg>
                    )}

                    <div class="content">
                      <div class="name-date">
                        <a href={mention.url}>
                          <span class="author">
                            {mention.author.name || getDomain(mention["wm-source"])}
                          </span>
                          {platform && (
                            <span class={platform.class}>@{platform.icon}</span>
                          )}
                          <span class="mention-type">{mentionType(mention)}</span>
                          {sourceType(mention) && (
                            <span class={`${sourceType(mention)}-svg`}>
                              {sourceType(mention) === "heroicons:chat-bubble-left" && "💬"}
                              {sourceType(mention) === "heroicons:heart" && "❤️"}
                              {sourceType(mention) === "heroicons:arrow-path" && "🔄"}
                              {sourceType(mention) === "heroicons:bookmark" && "🔖"}
                              {sourceType(mention) === "heroicons:arrow-uturn-left" && "↩️"}
                            </span>
                          )}
                          {mention.name && <span class="post-name">in {mention.name}</span>}
                          <time datetime={mention.published}>
                            {formatDate(mention["wm-received"])}
                          </time>
                        </a>
                      </div>
                      {mention.content && <span>{formatContent(mention.content.text || '')}</span>}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          <div class="button-container">
            {filteredMentions.length > 4 && (
              <button class="show-more" data-total-mentions={filteredMentions.length}>
                Show {filteredMentions.length - 4} more
              </button>
            )}
          </div>
        </>
      )}
    </div>
  </div>
)}

<script>
  // Function to initialize show more buttons
  function initializeShowMoreButtons() {
    const showMoreButtons = document.querySelectorAll(".show-more");

    showMoreButtons.forEach((button) => {
      // Remove existing event listeners to prevent duplicates
      button.replaceWith(button.cloneNode(true));

      const newButton = document.querySelector(
        `[data-total-mentions="${button.getAttribute("data-total-mentions")}"]`,
      );
      let isShowingMore = false;

      newButton?.addEventListener("click", () => {
        const container = newButton.closest(".webmentions-container");
        const mentionsContainer = container?.querySelector(".mentions-scroll-container");
        const replies = container?.querySelectorAll(".reply");

        if (!container || !mentionsContainer || !replies) return;

        if (!isShowingMore) {
          mentionsContainer.classList.add("expanded");
          replies.forEach((reply, index) => {
            if (index >= 4) {
              reply.classList.remove("hidden");
            }
          });
          mentionsContainer.scrollTop = 0;
          newButton.textContent = "Show less";
        } else {
          replies.forEach((reply, index) => {
            if (index >= 4) {
              reply.classList.add("hidden");
            }
          });
          mentionsContainer.classList.remove("expanded");
          const totalMentions = parseInt(newButton.getAttribute("data-total-mentions") || "0");
          newButton.textContent = `Show ${totalMentions - 4} more`;
        }

        isShowingMore = !isShowingMore;
      });
    });
  }

  // Initialize on first load
  initializeShowMoreButtons();

  // Re-initialize after view transitions
  document.addEventListener("astro:page-load", initializeShowMoreButtons);
</script>

