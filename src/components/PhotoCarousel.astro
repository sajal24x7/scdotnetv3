---
// Gallery for photo posts whose images live in frontmatter (`images:`).
// One image renders plainly; several become a scroll-snap carousel with
// arrow buttons and dot indicators (all optional enhancements — the track
// scrolls natively without JS).

interface Props {
    images: string[];
    title?: string;
}

const { images, title = '' } = Astro.props as Props;
const multiple = images.length > 1;
const altFor = (index: number) =>
    title
        ? `${title} — photo ${index + 1} of ${images.length}`
        : `Photo ${index + 1} of ${images.length}`;
---

{multiple ? (
    <div class="photo-carousel" data-photo-carousel>
        <div class="photo-carousel__track" data-carousel-track tabindex="0" role="group" aria-label={`Photo gallery, ${images.length} photos`}>
            {images.map((src, index) => (
                <figure class="photo-carousel__slide">
                    <img
                        src={src}
                        alt={altFor(index)}
                        loading={index === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                    />
                </figure>
            ))}
        </div>

        <button class="photo-carousel__arrow photo-carousel__arrow--prev" type="button" data-carousel-prev aria-label="Previous photo">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <button class="photo-carousel__arrow photo-carousel__arrow--next" type="button" data-carousel-next aria-label="Next photo">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>

        <div class="photo-carousel__dots" data-carousel-dots aria-hidden="true">
            {images.map((_, index) => (
                <span class={`photo-carousel__dot${index === 0 ? ' photo-carousel__dot--active' : ''}`}></span>
            ))}
        </div>
    </div>
) : (
    images.length === 1 && (
        <figure class="photo-carousel photo-carousel--single">
            <img src={images[0]} alt={title || 'Photo'} loading="eager" decoding="async" />
        </figure>
    )
)}

<style>
    .photo-carousel {
        position: relative;
        margin: 0;
        border-radius: 0.75rem;
        overflow: hidden;
        background: rgba(0, 0, 0, 0.03);
    }

    :global(.dark) .photo-carousel {
        background: rgba(255, 255, 255, 0.04);
    }

    .photo-carousel--single img,
    .photo-carousel__slide img {
        display: block;
        width: 100%;
        height: auto;
        max-height: min(70vh, 42rem);
        object-fit: contain;
        margin: 0 auto;
    }

    .photo-carousel__track {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
    }

    .photo-carousel__track::-webkit-scrollbar {
        display: none;
    }

    .photo-carousel__track:focus-visible {
        outline: 2px solid rgba(99, 102, 241, 0.7);
        outline-offset: -2px;
    }

    .photo-carousel__slide {
        flex: 0 0 100%;
        margin: 0;
        scroll-snap-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .photo-carousel__arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border: none;
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.5);
        color: #fff;
        cursor: pointer;
        opacity: 0.85;
        transition: opacity 150ms ease, background 150ms ease;
        backdrop-filter: blur(4px);
    }

    .photo-carousel__arrow svg {
        width: 1.25rem;
        height: 1.25rem;
    }

    .photo-carousel__arrow:hover {
        opacity: 1;
        background: rgba(0, 0, 0, 0.65);
    }

    .photo-carousel__arrow[disabled] {
        opacity: 0.25;
        cursor: default;
    }

    .photo-carousel__arrow--prev {
        left: 0.75rem;
    }

    .photo-carousel__arrow--next {
        right: 0.75rem;
    }

    .photo-carousel__dots {
        position: absolute;
        bottom: 0.75rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 0.4rem;
        padding: 0.3rem 0.55rem;
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
    }

    .photo-carousel__dot {
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.5);
        transition: background 150ms ease, transform 150ms ease;
    }

    :global(.photo-carousel__dot--active) {
        background: #fff;
        transform: scale(1.2);
    }

    @media (prefers-reduced-motion: reduce) {
        .photo-carousel__track {
            scroll-behavior: auto;
        }
    }
</style>

<script>
    function initPhotoCarousels() {
        document.querySelectorAll<HTMLElement>('[data-photo-carousel]').forEach((carousel) => {
            if (carousel.dataset.carouselReady) return;
            carousel.dataset.carouselReady = 'true';

            const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
            const prev = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
            const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
            const dots = Array.from(carousel.querySelectorAll<HTMLElement>('.photo-carousel__dot'));
            if (!track) return;

            const slideCount = track.children.length;
            const currentIndex = () =>
                Math.min(slideCount - 1, Math.max(0, Math.round(track.scrollLeft / track.clientWidth)));

            const goTo = (index: number) => {
                const clamped = Math.min(slideCount - 1, Math.max(0, index));
                const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                track.scrollTo({
                    left: clamped * track.clientWidth,
                    behavior: reduceMotion ? 'auto' : 'smooth'
                });
            };

            const update = () => {
                const index = currentIndex();
                dots.forEach((dot, i) => dot.classList.toggle('photo-carousel__dot--active', i === index));
                if (prev) prev.disabled = index === 0;
                if (next) next.disabled = index === slideCount - 1;
            };

            prev?.addEventListener('click', () => goTo(currentIndex() - 1));
            next?.addEventListener('click', () => goTo(currentIndex() + 1));
            track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
            track.addEventListener('keydown', (event) => {
                if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(currentIndex() - 1); }
                if (event.key === 'ArrowRight') { event.preventDefault(); goTo(currentIndex() + 1); }
            });

            update();
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPhotoCarousels);
    } else {
        initPhotoCarousels();
    }
</script>
