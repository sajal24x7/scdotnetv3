---
interface Props {
  title: string;
  description?: string;
  url: string;
  pubDate: Date;
  image?: string;
}

const { title, description, url, pubDate, image } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(pubDate);
---

<article class="flex flex-col md:flex-row gap-6 border-b border-borderColor dark:border-borderColorDark pb-6">
  {image && (
    <a href={url} class="md:w-1/3 shrink-0">
      <img 
        src={image} 
        alt={title} 
        class="rounded-lg object-cover w-full aspect-video" 
      />
    </a>
  )}
  <div class="flex-1">
    <p class="text-sm text-textSecondary dark:text-textSecondaryDark mb-2">
      {formattedDate}
    </p>
    <h3 class="text-xl font-semibold mb-2">
      <a href={url} class="hover:text-accent transition-colors">
        {title}
      </a>
    </h3>
    {description && (
      <p class="text-textSecondary dark:text-textSecondaryDark line-clamp-3 mb-3">
        {description}
      </p>
    )}
  </div>
</article> 