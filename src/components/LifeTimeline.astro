---
import type { LifeCalendar, LifeEntry } from '../utils/life';
import { BIRTH } from '../utils/life';
import { parseMarkdown } from '../utils/markdown';

interface Props {
    entries: LifeEntry[];
    calendar: LifeCalendar;
}

const { entries, calendar } = Astro.props as Props;

const MS_YEAR = 365.25 * 24 * 60 * 60 * 1000;
const ageAt = (ms: number) => Math.max(0, Math.floor((ms - BIRTH) / MS_YEAR));

// Group entries by start year for the stream view (chronological — a life
// reads forward, unlike the home feed).
const yearGroups: { year: number; entries: LifeEntry[] }[] = [];
for (const entry of entries) {
    const group = yearGroups.find((g) => g.year === entry.year);
    if (group) group.entries.push(entry);
    else yearGroups.push({ year: entry.year, entries: [entry] });
}

// Compact payload for the hover tooltip
const tipData = Object.fromEntries(
    entries.map((e) => [e.id, { t: e.title, w: e.whenText }])
);

const weeksLivedLabel = calendar.weeksLived.toLocaleString('en-US');
const totalWeeksLabel = calendar.totalWeeks.toLocaleString('en-US');
const percentLabel = calendar.percentLived.toFixed(1);
---

<section class="life" data-life data-view="calendar">
    <header class="life__head">
        <div>
            <h2 class="life__title">Timeline</h2>
            <p class="life__subtitle">
                {weeksLivedLabel} of {totalWeeksLabel} weeks lived — {percentLabel}% of a 90-year life.
            </p>
        </div>
        <div class="life__toggle" role="group" aria-label="Timeline layout">
            <button type="button" data-life-view-btn="calendar" aria-pressed="true" aria-label="Life calendar view" title="Life calendar view">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <rect x="3" y="3" width="3.4" height="3.4" rx="0.6" />
                    <rect x="8.3" y="3" width="3.4" height="3.4" rx="0.6" />
                    <rect x="13.6" y="3" width="3.4" height="3.4" rx="0.6" />
                    <rect x="18.9" y="3" width="3.4" height="3.4" rx="0.6" />
                    <rect x="3" y="8.3" width="3.4" height="3.4" rx="0.6" />
                    <rect x="8.3" y="8.3" width="3.4" height="3.4" rx="0.6" />
                    <rect x="13.6" y="8.3" width="3.4" height="3.4" rx="0.6" />
                    <rect x="18.9" y="8.3" width="3.4" height="3.4" rx="0.6" />
                    <rect x="3" y="13.6" width="3.4" height="3.4" rx="0.6" opacity="0.35" />
                    <rect x="8.3" y="13.6" width="3.4" height="3.4" rx="0.6" opacity="0.35" />
                    <rect x="13.6" y="13.6" width="3.4" height="3.4" rx="0.6" opacity="0.35" />
                    <rect x="18.9" y="13.6" width="3.4" height="3.4" rx="0.6" opacity="0.35" />
                    <rect x="3" y="18.9" width="3.4" height="3.4" rx="0.6" opacity="0.35" />
                    <rect x="8.3" y="18.9" width="3.4" height="3.4" rx="0.6" opacity="0.35" />
                    <rect x="13.6" y="18.9" width="3.4" height="3.4" rx="0.6" opacity="0.35" />
                    <rect x="18.9" y="18.9" width="3.4" height="3.4" rx="0.6" opacity="0.35" />
                </svg>
            </button>
            <button type="button" data-life-view-btn="stream" aria-pressed="false" aria-label="Stream view" title="Stream view">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="5" cy="6" r="1.6" fill="currentColor" />
                    <circle cx="5" cy="12" r="1.6" fill="currentColor" />
                    <circle cx="5" cy="18" r="1.6" fill="currentColor" />
                    <path d="M10 6h9M10 12h9M10 18h9" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
            </button>
        </div>
    </header>

    <!-- ──────────────── Life calendar view ──────────────── -->
    <div class="life-cal" data-life-cal>
        <p class="life-cal__axis">Each row is a year of my life, starting on my birthday. Each box is a week.</p>

        <p class="sr-only">
            Life calendar: {weeksLivedLabel} of {totalWeeksLabel} weeks lived. Each row is one year of
            life and each box one week. Weeks holding a timeline entry are buttons — activate one to
            open that entry in the stream view.
        </p>

        <div class="life-cal__grid" role="group" aria-label="Life calendar, one box per week">
            {calendar.rows.map((row) => (
                <div class="lc-r">
                    <span class="lc-a">{row.age % 5 === 0 ? row.age : ''}</span>
                    {row.cells.map((cell) => {
                        const stateClass =
                            cell.state === 'past' ? 'p' : cell.state === 'current' ? 'n' : 'f';
                        const classes = `lc ${stateClass}${cell.entryIds.length ? ' e' : ''}${cell.hasMoment ? ' m' : ''}`;
                        return cell.entryIds.length ? (
                            <button
                                type="button"
                                class={classes}
                                data-e={cell.entryIds.join(',')}
                                aria-label={cell.entryIds
                                    .map((id) => tipData[id]?.t)
                                    .filter(Boolean)
                                    .join('; ')}
                            />
                        ) : (
                            <span class={classes} />
                        );
                    })}
                </div>
            ))}
        </div>

        <ul class="life-cal__legend" aria-hidden="true">
            <li><span class="lc p"></span> lived</li>
            <li><span class="lc n"></span> this week</li>
            <li><span class="lc f"></span> remaining</li>
            <li><span class="lc p m e"></span> an entry — hover or tap it</li>
        </ul>

        <div class="lc-tip" data-life-tip role="tooltip" hidden></div>
    </div>

    <!-- ──────────────── Stream view ──────────────── -->
    <div class="life-stream" data-life-stream hidden>
        {yearGroups.map((group) => (
            <>
                <div class="life-stream__year">
                    {group.year}
                    <span class="life-stream__age">age {ageAt(group.entries[0].start)}</span>
                </div>
                {group.entries.map((entry) => (
                    <article class="life-entry" id={`life-${entry.id}`}>
                        <div class="life-entry__meta">
                            <span class="card-chip">{entry.whenText}</span>
                        </div>
                        <h3 class="life-entry__title">{entry.title}</h3>
                        <div class="life-entry__body prose dark:prose-invert" set:html={parseMarkdown(entry.body)} />
                    </article>
                ))}
            </>
        ))}
    </div>

    {/* Tooltip lookup table. An era covers ~52 cells per year, so cells
        reference entries by id rather than repeating the text on each one. */}
    <script is:inline type="application/json" data-life-entries set:html={JSON.stringify(tipData)} />
</section>

<style>
    .life {
        width: 100%;
    }

    .life__head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.75rem;
    }

    .life__title {
        font-size: var(--text-xlarge);
        font-weight: 700;
        margin: 0 0 0.35rem;
        color: rgb(var(--color-text-primary));
    }

    .life__subtitle {
        margin: 0;
        font-size: var(--text-small);
        color: rgb(var(--color-text-secondary));
        font-variant-numeric: tabular-nums;
    }

    /* ---- view toggle (mirrors the photos-page toolbar) ---- */
    .life__toggle {
        display: inline-flex;
        gap: 2px;
        padding: 3px;
        border-radius: 0.65rem;
        background: rgba(0, 0, 0, 0.04);
        border: 1px solid rgba(0, 0, 0, 0.08);
    }

    :global(.dark) .life__toggle {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.08);
    }

    .life__toggle button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.1rem;
        height: 2.1rem;
        border: none;
        border-radius: 0.5rem;
        background: none;
        color: rgb(var(--color-text-secondary));
        cursor: pointer;
        transition: background 150ms ease, color 150ms ease;
    }

    .life__toggle button svg {
        width: 1.15rem;
        height: 1.15rem;
    }

    .life__toggle button[aria-pressed='true'] {
        background: rgb(var(--color-text-primary));
        color: rgb(var(--color-bg));
    }

    .life__toggle button:not([aria-pressed='true']):hover {
        color: rgb(var(--color-text-primary));
    }

    /* ---- life calendar ---- */
    .life-cal {
        position: relative;
    }

    .life-cal__axis {
        margin: 0 0 1rem;
        font-size: var(--text-xs);
        color: rgb(var(--color-text-secondary));
    }

    .life-cal__grid {
        --lc-gutter: 1.8rem;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    /* The age label is positioned out of flow in a left gutter. In the grid
       it would set the row's height, and since cells are square that height
       would drive their width too — pinning them at the label's font size and
       overlapping them once the columns shrink below it on narrow screens. */
    .lc-r {
        position: relative;
        display: grid;
        grid-template-columns: repeat(52, minmax(0, 1fr));
        gap: 2px;
        margin-left: var(--lc-gutter);
    }

    .lc-a {
        position: absolute;
        right: 100%;
        top: 50%;
        transform: translateY(-50%);
        margin-right: 0.35rem;
        font-size: var(--text-xs);
        line-height: 1;
        color: rgb(var(--color-text-secondary));
        font-variant-numeric: tabular-nums;
        user-select: none;
    }

    /* Width comes from the column, height follows it — never the reverse. */
    .lc {
        display: block;
        width: 100%;
        aspect-ratio: 1 / 1;
        border-radius: 1px;
        padding: 0;
        border: none;
        min-width: 0;
    }

    /* lived weeks: solid ink */
    .lc.p {
        background: rgba(var(--color-text-primary), 0.55);
    }

    /* remaining weeks: faint outline */
    .lc.f {
        background: rgba(var(--color-text-primary), 0.08);
    }

    /* the current week: accent plus a halo ring no other cell has,
       so "you are here" never reads as just another entry */
    .lc.n {
        background: rgb(var(--color-accent));
        box-shadow:
            0 0 0 1.5px rgb(var(--color-bg)),
            0 0 0 3px rgb(var(--color-accent));
        animation: life-pulse 2.4s ease-in-out infinite;
        position: relative;
        z-index: 1;
    }

    /* weeks with entries: accent-marked and interactive */
    .lc.e {
        background: rgba(var(--color-accent), 0.4);
        cursor: pointer;
        transition: transform 120ms ease, background 120ms ease;
    }

    .lc.e.m {
        background: rgba(var(--color-accent), 0.8);
    }

    .lc.e:hover,
    .lc.e:focus-visible {
        transform: scale(1.6);
        background: rgb(var(--color-accent-hover));
        position: relative;
        z-index: 2;
    }

    /* Cells are a few pixels wide, so a normal outline would swamp them —
       keep it thin and offset enough to stay legible against neighbours. */
    .lc.e:focus-visible {
        outline: 2px solid rgb(var(--color-text-primary));
        outline-offset: 2px;
    }

    @keyframes life-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
    }

    /* ---- legend ---- */
    .life-cal__legend {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.4rem;
        list-style: none;
        margin: 1.25rem 0 0;
        padding: 0;
        font-size: var(--text-xs);
        color: rgb(var(--color-text-secondary));
    }

    .life-cal__legend li {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
    }

    .life-cal__legend .lc {
        width: 0.7rem;
        height: 0.7rem;
        aspect-ratio: auto;
        flex: none;
        animation: none;
        cursor: default;
    }

    /* ---- tooltip ---- */
    .lc-tip {
        position: absolute;
        z-index: 10;
        max-width: 16rem;
        padding: 0.5rem 0.7rem;
        border-radius: 0.5rem;
        background: rgb(var(--color-text-primary));
        color: rgb(var(--color-bg));
        font-size: var(--text-xs);
        line-height: 1.45;
        pointer-events: none;
        transform: translate(-50%, calc(-100% - 0.55rem));
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    }

    .lc-tip--below {
        transform: translate(-50%, 0.55rem);
    }

    /* Tooltip contents are injected at runtime, so these must not be
       scoped — the generated markup carries no astro-cid attribute. */
    .lc-tip :global(p) {
        margin: 0;
    }

    .lc-tip :global(p + p) {
        margin-top: 0.5rem;
        padding-top: 0.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.18);
    }

    .lc-tip :global(strong) {
        display: block;
        font-weight: 600;
    }

    .lc-tip :global(span) {
        display: block;
        opacity: 0.7;
    }

    .lc-tip[hidden] {
        display: none;
    }

    /* ---- stream view (home-feed spine, grouped by year) ---- */
    .life-stream {
        position: relative;
    }

    .life-stream::before {
        content: '';
        position: absolute;
        left: 0.32rem;
        top: 0.4rem;
        bottom: 0;
        width: 2px;
        border-radius: 2px;
        background: rgba(var(--color-text-primary), 0.12);
    }

    .life-stream__year {
        position: relative;
        padding-left: 2rem;
        margin: 2.5rem 0 1.5rem;
        font-size: var(--text-xs);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: rgb(var(--color-text-secondary));
        display: flex;
        align-items: baseline;
        gap: 0.7rem;
    }

    .life-stream__year::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 50%;
        background: rgb(var(--color-bg));
        border: 2px solid rgba(var(--color-text-primary), 0.35);
    }

    .life-stream__year:first-child {
        margin-top: 0;
    }

    .life-stream__age {
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: none;
        color: rgba(var(--color-text-primary), 0.45);
    }

    .life-entry {
        position: relative;
        padding-left: 2rem;
        margin-bottom: 2.1rem;
        scroll-margin-top: 6rem;
    }

    .life-entry::before {
        content: '';
        position: absolute;
        left: 0.11rem;
        top: 0.42rem;
        width: 0.44rem;
        height: 0.44rem;
        border-radius: 50%;
        background: rgba(var(--color-text-primary), 0.4);
    }

    .life-entry__meta {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: var(--text-xs);
        margin-bottom: 0.5rem;
    }

    .life-entry__title {
        font-size: 1.15rem;
        font-weight: 600;
        margin: 0 0 0.3rem;
        line-height: 1.35;
        text-wrap: balance;
        color: rgb(var(--color-text-primary));
    }

    .life-entry__body {
        font-size: var(--text-normal);
        max-width: none;
    }

    .life-entry__body :global(> :first-child) {
        margin-top: 0;
    }

    .life-entry__body :global(> :last-child) {
        margin-bottom: 0;
    }

    /* flash highlight after jumping from the calendar */
    .life-entry.is-flashed::before {
        background: rgb(var(--color-accent));
    }

    .life-entry.is-flashed .life-entry__title {
        color: rgb(var(--color-accent));
        transition: color 400ms ease;
    }

    [hidden] {
        display: none !important;
    }

    @media (max-width: 40rem) {
        /* 52 columns on a phone leaves each week ~5px wide, so the gap and
           the current-week ring shrink with them or they swamp the cell. */
        .life-cal__grid,
        .lc-r {
            gap: 1px;
        }

        .life-cal__grid {
            --lc-gutter: 1.4rem;
        }

        .lc.n {
            box-shadow:
                0 0 0 1px rgb(var(--color-bg)),
                0 0 0 2px rgb(var(--color-accent));
        }

        .lc.e:focus-visible {
            outline-width: 1px;
            outline-offset: 1px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .lc.n {
            animation: none;
        }

        .lc.e:hover,
        .lc.e:focus-visible {
            transform: none;
        }
    }
</style>

<script>
    const root = document.querySelector<HTMLElement>('[data-life]');

    if (root) {
        const calView = root.querySelector<HTMLElement>('[data-life-cal]')!;
        const streamView = root.querySelector<HTMLElement>('[data-life-stream]')!;
        const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-life-view-btn]'));
        const tip = root.querySelector<HTMLElement>('[data-life-tip]')!;
        const dataEl = root.querySelector<HTMLScriptElement>('[data-life-entries]');
        const tipData: Record<string, { t: string; w: string }> = dataEl
            ? JSON.parse(dataEl.textContent || '{}')
            : {};

        function applyView(view: string): void {
            const next = view === 'stream' ? 'stream' : 'calendar';
            root.dataset.view = next;
            calView.hidden = next !== 'calendar';
            streamView.hidden = next !== 'stream';
            buttons.forEach((btn) => {
                btn.setAttribute('aria-pressed', String(btn.dataset.lifeViewBtn === next));
            });
        }

        buttons.forEach((btn) =>
            btn.addEventListener('click', () => applyView(btn.dataset.lifeViewBtn || 'calendar'))
        );

        // ---- tooltip on entry weeks ----
        function escapeHtml(value: string): string {
            return value.replace(/[&<>"]/g, (ch) =>
                ch === '&' ? '&amp;' : ch === '<' ? '&lt;' : ch === '>' ? '&gt;' : '&quot;'
            );
        }

        function showTip(cell: HTMLElement): void {
            const ids = (cell.dataset.e || '').split(',').filter(Boolean);
            const parts = ids
                .map((id) => tipData[id])
                .filter(Boolean)
                .map((d) => `<p><strong>${escapeHtml(d.t)}</strong><span>${escapeHtml(d.w)}</span></p>`);
            if (!parts.length) return;

            tip.innerHTML = parts.join('');
            tip.hidden = false;

            const calRect = calView.getBoundingClientRect();
            const cellRect = cell.getBoundingClientRect();
            const tipRect = tip.getBoundingClientRect();

            // Keep the tooltip inside the grid horizontally…
            const half = tipRect.width / 2;
            const rawX = cellRect.left + cellRect.width / 2 - calRect.left;
            tip.style.left = `${Math.min(Math.max(rawX, half), calRect.width - half)}px`;

            // …and flip it below the cell when it would clip off the top.
            const above = cellRect.top - calRect.top;
            const flip = above < tipRect.height + 12;
            tip.classList.toggle('lc-tip--below', flip);
            tip.style.top = `${flip ? above + cellRect.height : above}px`;
        }

        function hideTip(): void {
            tip.hidden = true;
        }

        calView.addEventListener('mouseover', (event) => {
            const cell = (event.target as HTMLElement).closest<HTMLElement>('[data-e]');
            if (cell) showTip(cell);
        });
        calView.addEventListener('mouseout', (event) => {
            if ((event.target as HTMLElement).closest('[data-e]')) hideTip();
        });
        calView.addEventListener('focusin', (event) => {
            const cell = (event.target as HTMLElement).closest<HTMLElement>('[data-e]');
            if (cell) showTip(cell);
        });
        calView.addEventListener('focusout', hideTip);

        // ---- click a marked week → jump to its entry in the stream ----
        calView.addEventListener('click', (event) => {
            const cell = (event.target as HTMLElement).closest<HTMLElement>('[data-e]');
            if (!cell) return;
            const firstId = (cell.dataset.e || '').split(',').filter(Boolean)[0];
            if (!firstId) return;

            hideTip();
            applyView('stream');

            const target = streamView.querySelector<HTMLElement>(`#life-${CSS.escape(firstId)}`);
            if (target) {
                const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                target.scrollIntoView({
                    behavior: reduceMotion ? 'auto' : 'smooth',
                    block: 'start'
                });
                target.classList.add('is-flashed');
                window.setTimeout(() => target.classList.remove('is-flashed'), 2000);
            }
        });
    }
</script>
