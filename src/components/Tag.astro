---
interface Props {
  tag: string;
  href?: string;
}

const { tag, href } = Astro.props;
const tagHref = href || `/tags/${tag.toLowerCase()}/`;
---

<a href={tagHref} class="tag">
  {tag.toUpperCase()}
</a>

<style>
  .tag {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    /* Color, border, and hover styles now handled by global CSS */
  }
</style>