---
import type { HTMLAttributes } from 'astro/types';

type TagAttributes = HTMLAttributes<'a'> & HTMLAttributes<'span'>;

interface Props extends TagAttributes {
    tag: string;
    href?: string;
    label?: string;
    uppercase?: boolean;
    prefix?: string;
    suffix?: string;
    isActive?: boolean;
    as?: 'a' | 'span' | 'button';
    asFilter?: boolean;
    class?: string;
    className?: string;
}

const {
    tag,
    href,
    label,
    uppercase = true,
    prefix = '',
    suffix = '',
    isActive = false,
    as,
    asFilter = false,
    class: classAttr = '',
    className = '',
    ...rest
} = Astro.props as Props & Record<string, any>;

const elementTag: 'a' | 'span' | 'button' = asFilter ? 'button' : (as ?? (href ? 'a' : 'span'));
const computedHref = elementTag === 'a' ? href ?? `/tags/${tag.toLowerCase()}/` : undefined;
const classes = ['tag', 'tag-chip', isActive ? 'tag-chip-active' : '', classAttr || className]
    .filter(Boolean)
    .join(' ');
const baseLabel = label ?? tag;
const displayLabel = `${prefix}${uppercase ? baseLabel.toUpperCase() : baseLabel}${suffix}`;
---

{elementTag === 'button' ? (
    <button type="button" class={classes} data-tag-filter={tag} {...(rest as Record<string, any>)}>
        {displayLabel}
    </button>
) : elementTag === 'a' ? (
    <a href={computedHref} class={classes} {...rest}>
        {displayLabel}
    </a>
) : (
    <span class={classes} {...rest}>
        {displayLabel}
    </span>
)}
