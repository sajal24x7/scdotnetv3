---
import RecentItems from '../RecentItems.astro';
import type { TagCategorySlice, TransformedPost } from '../../utils/tagPages';

interface Props {
    tag: string;
    posts: TransformedPost[];
    totalCount: number;
    categorySlices: TagCategorySlice[];
}

const { tag, posts, totalCount, categorySlices } = Astro.props as Props;

const navItems = [
    {
        key: '',
        label: 'All',
        includes: '',
        count: totalCount
    },
    ...categorySlices.map(slice => ({
        key: slice.key,
        label: slice.label,
        includes: slice.includes.join(','),
        count: slice.count
    }))
];

const description = `All ${totalCount} ${totalCount === 1 ? 'entry' : 'entries'} tagged with ${tag.toUpperCase()}.`;
---

<header class="tag-page-header">
    <h1 class="tag-page-title">
        <span class="tag-display tag-chip">{tag.toUpperCase()}</span>
    </h1>
    <p class="tag-page-description" id="tag-page-description">{description}</p>
</header>

{navItems.length > 1 && (
    <nav class="tag-category-nav" aria-label="Filter tagged content by category">
        <ul class="tag-category-list">
            {navItems.map((item, index) => (
                <li class="tag-category-item">
                    <button
                        type="button"
                        class={`tag-category-link tag-chip${index === 0 ? ' tag-category-link-active' : ''}`}
                        data-category-filter={item.includes}
                        aria-current={index === 0 ? 'true' : undefined}
                    >
                        <span class="tag-category-label">{item.label}</span>
                        <span class="tag-category-count">{item.count}</span>
                    </button>
                </li>
            ))}
        </ul>
    </nav>
)}

<section class="tag-page-content" data-category-filter-scope>
    {posts.length === 0 ? (
        <div class="tag-page-empty">
            <p>No content found for this selection.</p>
        </div>
    ) : (
        <RecentItems posts={posts} showTitle={false} />
    )}
</section>

<script>
    function initTagCategoryFilter() {
        const scope = document.querySelector('[data-category-filter-scope]');
        const buttons = document.querySelectorAll<HTMLButtonElement>('[data-category-filter]');
        const description = document.getElementById('tag-page-description');
        if (!scope || buttons.length === 0) return;

        const items = scope.querySelectorAll<HTMLElement>('[data-content-item]');
        const baseDescription = description?.textContent ?? '';

        function applyFilter(includes: string, label: string) {
            const includeList = includes ? includes.split(',') : null;
            let visibleCount = 0;

            items.forEach(item => {
                const category = item.getAttribute('data-category') ?? '';
                const matches = !includeList || includeList.includes(category);
                if (matches) {
                    item.removeAttribute('data-filtered');
                    visibleCount++;
                } else {
                    item.setAttribute('data-filtered', 'hidden');
                }
            });

            if (description) {
                description.textContent = includeList
                    ? `${visibleCount} ${visibleCount === 1 ? 'item' : 'items'} in ${label}.`
                    : baseDescription;
            }
        }

        buttons.forEach(button => {
            button.addEventListener('click', () => {
                buttons.forEach(b => {
                    b.classList.remove('tag-category-link-active');
                    b.removeAttribute('aria-current');
                });
                button.classList.add('tag-category-link-active');
                button.setAttribute('aria-current', 'true');

                const includes = button.getAttribute('data-category-filter') ?? '';
                const label = button.querySelector('.tag-category-label')?.textContent ?? '';
                applyFilter(includes, label);
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTagCategoryFilter);
    } else {
        initTagCategoryFilter();
    }
</script>

<style>
    .tag-page-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .tag-page-title {
        margin-bottom: 1rem;
    }

    .tag-page-description {
        font-size: 1.125rem;
        color: var(--textSecondary, #4b5563);
        max-width: 48rem;
        margin: 0 auto;
    }

    .tag-category-nav {
        margin-bottom: 2rem;
    }

    .tag-category-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        padding: 0;
        list-style: none;
    }

    .tag-category-item {
        margin: 0;
    }

    .tag-category-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: var(--text-xs);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.5rem 0.75rem;
        font-family: inherit;
    }

    .tag-category-link-active {
        background-color: var(--tagActiveBg, rgba(59, 130, 246, 0.12));
        border-color: var(--tagActiveBorder, rgba(59, 130, 246, 0.35));
        color: var(--tagActiveText, rgb(30, 64, 175));
    }

    .tag-category-link-active:focus-visible {
        outline: 2px solid rgba(59, 130, 246, 0.35);
        outline-offset: 2px;
    }

    .tag-category-count {
        font-variant-numeric: tabular-nums;
        opacity: 0.75;
    }

    .tag-page-content {
        margin-top: 2rem;
    }

    .tag-page-empty {
        text-align: center;
        padding: 3rem 1.5rem;
        border: 1px solid var(--borderColor, #e5e7eb);
        border-radius: 0.75rem;
    }

    :global(.dark) .tag-page-description {
        color: var(--textSecondaryDark, #9ca3af);
    }

    :global(.dark) .tag-category-link-active {
        background-color: rgba(96, 165, 250, 0.16);
        border-color: rgba(96, 165, 250, 0.45);
        color: rgb(191, 219, 254);
    }

    :global(.dark) .tag-page-empty {
        border-color: var(--borderColorDark, #374151);
    }

    :global([data-category-filter-scope] [data-content-item][data-filtered="hidden"]) {
        display: none;
    }

    @media (max-width: 640px) {
        .tag-page-description {
            font-size: 1rem;
        }

        .tag-category-list {
            justify-content: flex-start;
        }

        .tag-category-link {
            font-size: var(--text-xs);
        }
    }
</style>
