---
import RecentItems from '../RecentItems.astro';
import type { TagCategorySlice, TransformedPost } from '../../utils/tagPages';

interface Props {
    tag: string;
    posts: TransformedPost[];
    totalCount: number;
    categorySlices: TagCategorySlice[];
    activeCategory?: string | null;
}

const {
    tag,
    posts,
    totalCount,
    categorySlices,
    activeCategory = null
} = Astro.props as Props;

const activeKey = activeCategory ?? null;
const activeSlice = typeof activeKey === 'string'
    ? categorySlices.find(slice => slice.key === activeKey) ?? null
    : null;

const navItems = [
    {
        key: null as string | null,
        label: 'All',
        href: `/tags/${tag}/`,
        count: totalCount
    },
    ...categorySlices.map(slice => ({
        key: slice.key as string | null,
        label: slice.label,
        href: `/tags/${tag}/${slice.key}/`,
        count: slice.count,
        includeLabels: slice.includeLabels
    }))
];

const description = activeSlice
    ? formatSliceDescription(tag, activeSlice)
    : formatAllDescription(tag, totalCount);

function formatSliceDescription(tagValue: string, slice: TagCategorySlice): string {
    const includes = slice.includeLabels.length > 1
        ? ` (${slice.includeLabels.join(', ')})`
        : '';
    const itemLabel = slice.count === 1 ? 'item' : 'items';
    return `${slice.count} ${itemLabel} tagged with ${tagValue.toUpperCase()} in ${slice.label}${includes}.`;
}

function formatAllDescription(tagValue: string, count: number): string {
    const entryLabel = count === 1 ? 'entry' : 'entries';
    return `All ${count} ${entryLabel} tagged with ${tagValue.toUpperCase()}.`;
}
---

<header class="tag-page-header">
    <h1 class="tag-page-title">
        <span class="tag-display tag-chip">{tag.toUpperCase()}</span>
    </h1>
    <p class="tag-page-description">{description}</p>
</header>

{navItems.length > 1 && (
    <nav class="tag-category-nav" aria-label="Filter tagged content by category">
        <ul class="tag-category-list">
            {navItems.map(item => (
                <li class="tag-category-item">
                    <a
                        href={item.href}
                        class={`tag-category-link tag-chip${activeKey === item.key ? ' tag-category-link-active' : ''}`}
                        aria-current={activeKey === item.key ? 'page' : undefined}
                    >
                        <span class="tag-category-label">{item.label}</span>
                        <span class="tag-category-count">{item.count}</span>
                    </a>
                </li>
            ))}
        </ul>
    </nav>
)}

<section class="tag-page-content">
    {posts.length === 0 ? (
        <div class="tag-page-empty">
            <p>No content found for this selection.</p>
        </div>
    ) : (
        <RecentItems posts={posts} showTitle={false} />
    )}
</section>

<style>
    .tag-page-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .tag-page-title {
        margin-bottom: 1rem;
    }

    .tag-page-description {
        font-size: 1.125rem;
        color: var(--textSecondary, #4b5563);
        max-width: 48rem;
        margin: 0 auto;
    }

    .tag-category-nav {
        margin-bottom: 2rem;
    }

    .tag-category-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        padding: 0;
        list-style: none;
    }

    .tag-category-item {
        margin: 0;
    }

    .tag-category-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.5rem 0.75rem;
    }

    .tag-category-link-active {
        background-color: var(--tagActiveBg, rgba(59, 130, 246, 0.12));
        border-color: var(--tagActiveBorder, rgba(59, 130, 246, 0.35));
        color: var(--tagActiveText, rgb(30, 64, 175));
    }

    .tag-category-link-active:focus-visible {
        outline: 2px solid rgba(59, 130, 246, 0.35);
        outline-offset: 2px;
    }

    .tag-category-count {
        font-variant-numeric: tabular-nums;
        opacity: 0.75;
    }

    .tag-page-content {
        margin-top: 2rem;
    }

    .tag-page-empty {
        text-align: center;
        padding: 3rem 1.5rem;
        border: 1px solid var(--borderColor, #e5e7eb);
        border-radius: 0.75rem;
    }

    :global(.dark) .tag-page-description {
        color: var(--textSecondaryDark, #9ca3af);
    }

    :global(.dark) .tag-category-link-active {
        background-color: rgba(96, 165, 250, 0.16);
        border-color: rgba(96, 165, 250, 0.45);
        color: rgb(191, 219, 254);
    }

    :global(.dark) .tag-page-empty {
        border-color: var(--borderColorDark, #374151);
    }

    @media (max-width: 640px) {
        .tag-page-description {
            font-size: 1rem;
        }

        .tag-category-list {
            justify-content: flex-start;
        }

        .tag-category-link {
            font-size: 0.7rem;
        }
    }
</style>
