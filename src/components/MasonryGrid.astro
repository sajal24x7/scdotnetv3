---
import { marked } from 'marked';
import LinkHoverEffect from './LinkHoverEffect.astro';
import AdaptiveCard from './AdaptiveCard.astro';

interface Props {
  posts: any[];
  columns?: number;
}

const { posts, columns = 3 } = Astro.props;

// Configure marked options
marked.setOptions({
  gfm: true, // GitHub Flavored Markdown
  breaks: true // Convert line breaks to <br>
});

// Pre-render markdown content
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? marked.parse(post.body) : null
}));
---

<div class="masonry-grid">
  {renderedPosts.map((post) => (
    <div class="masonry-item">
      <AdaptiveCard 
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        category={post.data.category}
        image={post.data.image}
        link={post.data.link}
        layout="masonry"
      >
        {post.renderedContent && (
          <div class="prose dark:prose-dark max-w-none">
            <div set:html={post.renderedContent} />
          </div>
        )}
      </AdaptiveCard>
    </div>
  ))}
</div>

<LinkHoverEffect />

<style>
  .masonry-grid {
    column-count: 5;
    column-gap: 1rem;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
  }

  .masonry-item {
    break-inside: avoid;
    page-break-inside: avoid;
    margin-bottom: 1rem;
    display: inline-block;
    width: 100%;
    opacity: 1;
    transform: scale(1);
    transition: opacity 0.3s ease-out, transform 0.3s ease-out;
    transform-origin: top center;
  }

  .masonry-item.filtered-out {
    opacity: 0;
    transform: scale(0.8);
    position: absolute;
    pointer-events: none;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  /* Responsive breakpoints */
  @media (max-width: 1400px) {
    .masonry-grid {
      column-count: 4;
      column-gap: 1rem;
    }
  }

  @media (max-width: 1100px) {
    .masonry-grid {
      column-count: 3;
      column-gap: 0.75rem;
    }
  }

  @media (max-width: 900px) {
    .masonry-grid {
      column-count: 2;
      column-gap: 0.75rem;
    }
  }

  @media (max-width: 768px) {
    .masonry-grid {
      column-count: 1;
      column-gap: 0.5rem;
      max-width: none;
      padding: 0 1rem;
    }
  }

  /* Ensure links are properly styled */
  :global(.prose a) {
    color: #3b82f6;
    text-decoration: none;
    transition: color 0.2s;
  }

  :global(.prose a:hover) {
    color: #2563eb;
    text-decoration: underline;
  }

  :global(.dark .prose a) {
    color: #60a5fa;
  }

  :global(.dark .prose a:hover) {
    color: #93c5fd;
  }
</style>