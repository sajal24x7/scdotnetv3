---
import { getImageUrl } from '../utils/imageUtils';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  caption?: string;
  class?: string;
}

const { 
  src, 
  alt, 
  width, 
  height, 
  caption, 
  class: className = "" 
} = Astro.props;

// Process the image URL
const imageUrl = getImageUrl(src);
---

<figure class={`image-container ${className}`}>
  <img 
    src={imageUrl} 
    alt={alt} 
    width={width} 
    height={height} 
    loading="lazy"
    decoding="async"
    class="rounded-lg shadow-md w-full"
  />
  {caption && (
    <figcaption class="text-sm text-textSecondary dark:text-textSecondaryDark mt-2 text-center">
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .image-container {
    margin: 1.5rem 0;
  }
  
  img {
    max-width: 100%;
    height: auto;
  }
</style> 