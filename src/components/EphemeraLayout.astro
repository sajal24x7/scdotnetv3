---
import { marked } from 'marked';
import { formatDateWithTime } from '../utils/dateFormat';

const { posts } = Astro.props;

// Configure marked options
marked.setOptions({
  gfm: true,
  breaks: true
});

// Pre-render markdown content
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? marked.parse(post.body) : null
}));
---

<div class="ephemera-layout">
  {renderedPosts.map((post, index) => (
    <article class="ephemera-entry" data-category={post.data.category}>
      <div class="entry-layout">
        <!-- Left sidebar with metadata -->
        <div class="entry-meta">
          <time datetime={post.data.pubDate.toISOString()} class="entry-date">
            {formatDateWithTime(post.data.pubDate)}
          </time>
          
          <div class="entry-category">
            <span class="category-badge category-{post.data.category}">
              {post.data.category}
            </span>
          </div>
          
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="entry-tags">
              {post.data.tags.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
        </div>

        <!-- Main content area -->
        <div class="entry-content">
          <div class="entry-header">
            <h2 class="entry-title">
              {post.data.link ? (
                <a href={post.data.link} class="entry-link">
                  {post.data.title}
                </a>
              ) : (
                post.data.title
              )}
            </h2>
            
            {post.data.description && post.data.category !== 'micro' && (
              <p class="entry-description">
                {post.data.description}
              </p>
            )}
          </div>

          {post.data.image && (
            <div class="entry-image">
              <img 
                src={post.data.image} 
                alt={post.data.title}
                class="content-image"
              />
            </div>
          )}

          {post.renderedContent && (
            <div class="entry-body">
              <div class="prose dark:prose-invert max-w-none" set:html={post.renderedContent} />
            </div>
          )}
        </div>
      </div>
      
      {index < renderedPosts.length - 1 && (
        <div class="entry-divider"></div>
      )}
    </article>
  ))}
</div>

<style>
  .ephemera-layout {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .ephemera-entry {
    margin-bottom: 3rem;
  }

  .entry-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .entry-meta {
    position: sticky;
    top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-right: 1rem;
  }

  .entry-date {
    font-size: 0.875rem;
    color: #6b7280;
    font-weight: 500;
    line-height: 1.3;
  }

  :global(.dark) .entry-date {
    color: #9ca3af;
  }

  .entry-category {
    display: flex;
    gap: 0.5rem;
  }

  .category-badge {
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .category-blog {
    background-color: #dbeafe;
    color: #1e40af;
  }

  .category-micro {
    background-color: #dcfce7;
    color: #166534;
  }

  .category-photo {
    background-color: #fef3c7;
    color: #92400e;
  }

  :global(.dark) .category-blog {
    background-color: #1e3a8a;
    color: #bfdbfe;
  }

  :global(.dark) .category-micro {
    background-color: #166534;
    color: #dcfce7;
  }

  :global(.dark) .category-photo {
    background-color: #92400e;
    color: #fef3c7;
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .tag {
    background: #f3f4f6;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.6875rem;
    color: #4b5563;
    font-weight: 500;
  }

  :global(.dark) .tag {
    background: #374151;
    color: #d1d5db;
  }

  .entry-content {
    min-width: 0;
  }

  .entry-header {
    margin-bottom: 1.5rem;
  }

  .entry-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.75rem;
    color: #111827;
  }

  :global(.dark) .entry-title {
    color: #f9fafb;
  }

  .entry-link {
    color: #111827;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .entry-link:hover {
    color: #3b82f6;
  }

  :global(.dark) .entry-link {
    color: #f9fafb;
  }

  :global(.dark) .entry-link:hover {
    color: #60a5fa;
  }

  .entry-description {
    color: #6b7280;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 0;
  }

  :global(.dark) .entry-description {
    color: #9ca3af;
  }

  .entry-image {
    margin-bottom: 1.5rem;
  }

  .content-image {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  :global(.dark) .content-image {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
  }

  .entry-body {
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .entry-divider {
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgb(229 231 235),
      transparent
    );
    margin: 3rem 0;
  }

  :global(.dark) .entry-divider {
    background: linear-gradient(
      to right,
      transparent,
      rgb(55 65 81),
      transparent
    );
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .ephemera-layout {
      padding: 1rem;
    }

    .entry-layout {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .entry-meta {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
      padding-right: 0;
      padding-bottom: 1rem;
      border-bottom: 1px solid #e5e7eb;
    }

    :global(.dark) .entry-meta {
      border-bottom-color: #374151;
    }

    .entry-date {
      font-size: 0.8125rem;
    }

    .entry-tags {
      flex: 1;
      justify-content: flex-end;
    }

    .entry-title {
      font-size: 1.25rem;
    }

    .entry-body {
      font-size: 1rem;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 768px) and (max-width: 1024px) {
    .entry-layout {
      grid-template-columns: 160px 1fr;
      gap: 2rem;
    }

    .entry-meta {
      top: 1rem;
    }

    .entry-title {
      font-size: 1.375rem;
    }
  }

  /* Ensure proper prose styling for content */
  :global(.prose p) {
    margin-bottom: 1.25rem;
  }

  :global(.prose a) {
    color: #3b82f6;
    text-decoration: none;
    transition: color 0.2s;
  }

  :global(.prose a:hover) {
    color: #2563eb;
    text-decoration: underline;
  }

  :global(.dark .prose a) {
    color: #60a5fa;
  }

  :global(.dark .prose a:hover) {
    color: #93c5fd;
  }

  :global(.prose ul) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  :global(.prose li) {
    margin-bottom: 0.5rem;
  }

  :global(.prose blockquote) {
    border-left: 4px solid #e5e7eb;
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: #6b7280;
  }

  :global(.dark .prose blockquote) {
    border-left-color: #374151;
    color: #9ca3af;
  }
</style>