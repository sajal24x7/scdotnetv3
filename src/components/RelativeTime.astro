---
import { formatRelativeTime } from '../utils/dateFormat';

interface Props {
  date: Date | string;
  className?: string;
}

const { date, className = '' } = Astro.props;
const relativeTime = formatRelativeTime(date);
---

<time class={`relative-time ${className}`} datetime={typeof date === 'string' ? date : date.toISOString()}>
  {relativeTime}
</time>

<style>
  .relative-time {
    font-size: var(--text-small);
    color: #6b7280;
    font-weight: 500;
  }

  :global(.dark) .relative-time {
    color: #9ca3af;
  }
</style>