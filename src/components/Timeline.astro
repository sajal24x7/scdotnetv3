---
import type { CollectionEntry, ContentEntryMap } from 'astro:content';
import { formatDateWithTime } from '../utils/dateFormat';

interface Props {
  posts: CollectionEntry<keyof ContentEntryMap>[];
}

const { posts } = Astro.props;

// Pre-render all posts
const renderedPosts = await Promise.all(
  posts.map(async (post) => {
    const content = await post.render();
    return {
      ...post,
      content: content.Content
    };
  })
);
---

<div class="space-y-12">
  {renderedPosts.map((post) => {
    const data = post.data as {
      title?: string;
      pubDate: Date;
    };
    return (
      <article class="relative pl-8 border-l-2 border-gray-200 dark:border-gray-700">
        <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-gray-200 dark:bg-gray-700"></div>
        <div class="mb-2">
          <time class="text-sm text-gray-500 dark:text-gray-400">
            {formatDateWithTime(data.pubDate)}
          </time>
        </div>
        <div class="prose dark:prose-invert max-w-none">
          {data.title && <h2 class="text-2xl font-bold mb-4">{data.title}</h2>}
          <div set:html={post.content} />
        </div>
      </article>
    );
  })}
</div> 