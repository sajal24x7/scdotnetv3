---
interface MetadataItem {
    label: string;
    value: string;
    href?: string;
}

interface Props {
    coverSrc: string;
    coverAlt: string;
    title: string;
    authors?: string;
    kicker?: string;
    metadata?: MetadataItem[];
}

const { coverSrc, coverAlt, title, authors, kicker, metadata = [] } = Astro.props as Props;
---
<section class="mx-auto w-full max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-3 lg:items-start">
        <div class="mx-auto flex w-full max-w-xs flex-col gap-6 lg:mx-0">
            <img src={coverSrc} alt={coverAlt} class="w-full rounded-lg shadow-lg" />

            {metadata.length > 0 && (
                <div class="rounded-lg border border-dotted border-borderColor p-4 text-sm text-textSecondary dark:border-borderColorDark dark:text-textSecondaryDark">
                    <dl class="space-y-3">
                        {metadata.map((item) => (
                            <div
                                class="grid grid-cols-[max-content,1fr] items-baseline gap-x-6 text-textPrimary dark:text-textPrimaryDark"
                                key={item.label}
                            >
                                <dt class="text-xs font-semibold uppercase tracking-wide text-textSecondary dark:text-textSecondaryDark">
                                    {item.label}
                                </dt>
                                <dd class="text-sm text-right">
                                    {item.href ? (
                                        <a
                                            href={item.href}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="font-medium underline decoration-dotted underline-offset-4 hover:decoration-solid"
                                        >
                                            {item.value}
                                        </a>
                                    ) : (
                                        item.value
                                    )}
                                </dd>
                            </div>
                        ))}
                    </dl>
                </div>
            )}
        </div>

        <div class="lg:col-span-2">
            <div class="space-y-6">
                {(kicker || authors) && (
                    <header class="space-y-2">
                        {kicker && (
                            <p class="text-sm font-semibold uppercase tracking-wide text-textSecondary dark:text-textSecondaryDark">
                                {kicker}
                            </p>
                        )}
                        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
                        {authors && (
                            <p class="text-base text-textSecondary dark:text-textSecondaryDark">
                                {authors}
                            </p>
                        )}
                    </header>
                )}

                <div class="prose prose-neutral max-w-none text-base leading-relaxed dark:prose-invert">
                    <slot />
                </div>
            </div>
        </div>
    </div>
</section>
