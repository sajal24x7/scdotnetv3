---
// Small line glyph for a haiku's season: blossom, sun, leaf, snowflake.
// Draws in currentColor so the parent's season accent colours it, and sizes
// to 1em so it follows the surrounding text (scoped parent styles can't reach
// this element, so size it through font-size rather than a class).
import type { SeasonKey } from '../../utils/haiku';

interface Props {
    season: SeasonKey;
    class?: string;
}

const { season, class: className = '' } = Astro.props as Props;
---

<svg
    class={className}
    width="1em"
    height="1em"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    style="flex: none"
>
    {season === 'spring' && (
        <>
            <circle cx="12" cy="12" r="2" />
            <path d="M12 10c-2.2-1.6-2.2-5 0-6.5 2.2 1.5 2.2 4.9 0 6.5Z" />
            <path d="M13.9 11.4c.8-2.6 4-3.7 6.2-2.1-.8 2.6-4 3.7-6.2 2.1Z" />
            <path d="M13.2 13.6c2.7 0 4.7 2.7 3.8 5.3-2.7 0-4.7-2.7-3.8-5.3Z" />
            <path d="M10.8 13.6c.9 2.6-1.1 5.3-3.8 5.3-.9-2.6 1.1-5.3 3.8-5.3Z" />
            <path d="M10.1 11.4c-2.2 1.6-5.4.5-6.2-2.1 2.2-1.6 5.4-.5 6.2 2.1Z" />
        </>
    )}
    {season === 'summer' && (
        <>
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
        </>
    )}
    {season === 'autumn' && (
        <>
            <path d="M5 19C5 10 10 5 19.5 4.5 19 14 14 19 5 19Z" />
            <path d="M5 19l9-9" />
        </>
    )}
    {season === 'winter' && (
        <>
            <path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9" />
            <path d="M9.8 4.8 12 6.6l2.2-1.8M9.8 19.2l2.2-1.8 2.2 1.8" />
        </>
    )}
</svg>
