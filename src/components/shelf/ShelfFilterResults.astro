---
import '../../styles/shelf-filters.css';
// Renders the active-filters summary + badge row for shelf pages that use
// `src/scripts/shelfFilters.ts`. Hidden until at least one filter is active.
// The bookshelf page predates this component and keeps its own copy of this
// markup/CSS — this is the shared version for every other shelf page.
---
<div class="shelf-filter-results" id="shelf-filter-results" aria-live="polite" aria-atomic="true" hidden>
  <div class="shelf-filter-summary" id="shelf-filter-summary"></div>
  <div class="shelf-filter-active" id="shelf-filter-active"></div>
</div>

