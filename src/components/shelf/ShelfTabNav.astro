---
interface Props {
    currentTab: 'all' | 'books' | 'film' | 'tv' | 'games';
}

const { currentTab } = Astro.props;

const tabLabels: Record<typeof currentTab, string> = {
    all: 'Shelf',
    books: 'Books',
    film: 'Film',
    tv: 'TV',
    games: 'Games',
};

const label = tabLabels[currentTab];
---

<div class="shelf-tab-nav">
    <h1 class="shelf-tab-nav__text">{label}</h1>
</div>

<style>
    .shelf-tab-nav {
        margin-bottom: 1rem;
        display: flex;
        justify-content: center;
    }

    .shelf-tab-nav__text {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 700;
        margin: 0;
        line-height: 1.2;
        color: rgb(30 41 59);
    }

    :global(.dark) .shelf-tab-nav__text {
        color: rgb(var(--color-text-primary));
    }
</style>
