---
import '../../styles/shelf-card.css';
import { Image } from 'astro:assets';
import { getGameCoverImage } from '../../utils/gameCovers';
import {
    bookRatingDisplay,
    heartIconPaths,
    thumbIconPaths,
    type BookRating,
    type RatingIconSpec
} from '../../utils/bookRatings';
import { SHELF_STATUS_LABELS, SHELF_STATUS_CHIP_CLASS, type ShelfStatus } from '../../utils/shelfStatus';

interface GameCardProps {
    title: string;
    developer?: string;
    year?: number;
    genre?: string;
    platform?: string;
    hoursPlayed?: number;
    status?: ShelfStatus;
    rating?: BookRating;
    cover?: string;
    link?: string;
    watchNumber?: number; // 1 = first play, 2+ = replay
}

const props = Astro.props as GameCardProps;
const {
    title,
    developer,
    year,
    genre,
    platform,
    hoursPlayed,
    status,
    rating,
    cover,
    link,
    watchNumber = 1
} = props;

const statusLabel = status ? SHELF_STATUS_LABELS.gameshelf[status] : null;
const statusChipClass = status ? SHELF_STATUS_CHIP_CLASS[status] : '';

const genreLabel = genre ? genre.toUpperCase() : null;
const platformLabel = platform ? platform.toUpperCase() : null;
const hoursLabel = hoursPlayed !== undefined ? `${hoursPlayed} hrs` : null;
const isReplay = watchNumber > 1;
const replayLabel = isReplay ? (watchNumber === 2 ? '2nd play' : watchNumber === 3 ? '3rd play' : `${watchNumber}th play`) : null;

const shouldShowRating = status !== 'started' && status !== 'todo';
const ratingDisplay = shouldShowRating && rating ? bookRatingDisplay[rating] : null;
const ratingAriaLabel = ratingDisplay ? ratingDisplay.label : 'Rating: Not set';
const ratingIconSpecs: readonly RatingIconSpec[] = ratingDisplay?.iconSpecs ?? [];
const ratingChipLabel = ratingDisplay?.label ?? null;

const coverImage = cover ? getGameCoverImage(cover) : null;
---

<article class="book-card" data-card-root>
  <div class="book-card__surface">
    <div class="book-card__cover">
      {coverImage ? (
        <Image
          src={coverImage}
          alt={`Cover art for ${title}`}
          width={210}
          height={315}
          layout="fixed"
          class="book-card__cover-image"
          loading="lazy"
        />
      ) : (
        <div class="book-card__cover-placeholder" aria-hidden="true">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="6" y1="12" x2="10" y2="12"></line>
            <line x1="8" y1="10" x2="8" y2="14"></line>
            <line x1="15" y1="13" x2="15.01" y2="13"></line>
            <line x1="18" y1="11" x2="18.01" y2="11"></line>
            <rect x="2" y="6" width="20" height="12" rx="2"></rect>
          </svg>
        </div>
      )}
    </div>

    <div class="book-card__content">
      <header class="book-card__header">
        <div class="book-card__title-row">
          <div class="book-card__title-block">
            {year && <div class="book-card__series">{year}</div>}
            <h3 class="book-card__title">
              {link ? (
                <a href={link} class="book-card__title-link">{title}</a>
              ) : (
                title
              )}
            </h3>
          </div>
        </div>
        {developer && (
          <button
            type="button"
            class="book-card__author book-card__author--clickable"
            data-filter-type="developer"
            data-filter-value={developer}
          >
            {developer}
          </button>
        )}
      </header>

      {(statusLabel || genreLabel || platformLabel || hoursLabel || ratingChipLabel || replayLabel) && (
        <div class="book-card__meta" data-meta>
          <div class="book-card__meta-row book-card__meta-row--chips">
            {statusLabel && status && status !== 'finished' && (
              <button
                type="button"
                class={`book-card__chip book-card__chip--status book-card__chip--clickable ${statusChipClass}`}
                data-filter-type="status"
                data-filter-value={status}
              >
                {statusLabel}
              </button>
            )}
            {genreLabel && genre && (
              <button
                type="button"
                class="book-card__chip book-card__chip--genre book-card__chip--clickable"
                data-filter-type="genre"
                data-filter-value={genre}
              >
                {genreLabel}
              </button>
            )}
            {platformLabel && platform && (
              <button
                type="button"
                class="book-card__chip book-card__chip--platform book-card__chip--clickable"
                data-filter-type="platform"
                data-filter-value={platform}
              >
                {platformLabel}
              </button>
            )}
            {hoursLabel && (
              <span class="book-card__chip book-card__chip--hours">
                <span class="book-card__chip-label">{hoursLabel}</span>
              </span>
            )}
            {ratingChipLabel && rating && (
              <button
                type="button"
                class={`book-card__chip book-card__chip--rating book-card__chip--clickable book-card__chip--rating-${rating}`}
                data-filter-type="rating"
                data-filter-value={rating}
                aria-label={ratingAriaLabel}
              >
                <span class="book-card__chip-label">{ratingChipLabel}</span>
                {ratingIconSpecs.length > 0 && (
                  <span class={`book-card__rating-icons book-card__rating-icons--${rating}`} aria-hidden="true">
                    {ratingIconSpecs.map((iconSpec) => (
                      <span class="book-card__rating-icon">
                        <svg width={iconSpec.size} height={iconSpec.size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          {(iconSpec.type === 'heart' ? heartIconPaths : thumbIconPaths[iconSpec.direction]).map((d) => (
                            <path d={d}></path>
                          ))}
                        </svg>
                      </span>
                    ))}
                  </span>
                )}
              </button>
            )}
            {replayLabel && (
              <span class="book-card__chip book-card__chip--rewatch">
                <span class="book-card__chip-label">{replayLabel}</span>
              </span>
            )}
          </div>
        </div>
      )}
    </div>
  </div>
</article>

