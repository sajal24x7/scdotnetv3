---
// Shared queue wall: renders every `status: todo` entry for one shelf
// category with the same cover wall, view controls and click-to-filter as the
// main shelf pages, grouped by the year each entry was added (`created`).
// See planning/shelf-queue-design.md §1.
import '../../styles/shelf-wall.css';
import type { ImageMetadata } from 'astro';
import ShelfTile from './ShelfTile.astro';
import ShelfViewControls from './ShelfViewControls.astro';
import ShelfFilterResults from './ShelfFilterResults.astro';
import type { ShelfQueueConfig } from '../../utils/shelfQueue';

export interface ShelfQueueItem {
    id: string;
    title: string;
    creators: string[];
    created: Date;
    body: string;
    coverImage?: ImageMetadata;
    link?: string;
    genre?: string;
    tags?: string[];
    series?: string;
    seriesNumber?: number;
}

interface Props {
    config: ShelfQueueConfig;
    items: ShelfQueueItem[];
}

const { config, items } = Astro.props;

const plural = (n: number) => `${n} ${n === 1 ? config.noun.singular : config.noun.plural}`;

const years = Array.from(new Set(items.map((item) => item.created.getUTCFullYear())));
---

{items.length === 0 ? (
    <p class="shelf-queue__empty">Nothing on the {config.heading.toLowerCase()} list right now.</p>
) : (
    <>
        <ShelfViewControls />
        <ShelfFilterResults />
        <div
            class="shelf-years"
            data-shelf-queue
            data-person-filter={config.creatorField}
            data-noun-singular={config.noun.singular}
            data-noun-plural={config.noun.plural}
        >
            {years.map((year) => {
                const yearItems = items.filter((item) => item.created.getUTCFullYear() === year);
                return (
                    <section class="shelf-year" id={`${config.category}-queue-${year}`} data-year={year}>
                        <header class="shelf-year__head">
                            <h2 class="shelf-year__year">{year}</h2>
                            <span class="shelf-year__count" data-year-count={year}>Added {plural(yearItems.length)}</span>
                        </header>
                        <ul class="shelf-wall">
                            {yearItems.map((item) => (
                                <li
                                    class="shelf-wall__item"
                                    data-shelf-item
                                    data-person={item.creators.join(',')}
                                    data-genre={item.genre ?? ''}
                                    data-series={item.series ?? ''}
                                    data-tags={(item.tags ?? []).join(',')}
                                    data-sort-date={item.created.toISOString()}
                                    data-sort-status="0"
                                    data-sort-title={item.title.toLowerCase()}
                                    data-sort-rating="9"
                                >
                                    <ShelfTile
                                        title={item.title}
                                        href={item.link}
                                        cover={item.coverImage ?? null}
                                        people={item.creators}
                                        personFilter={config.creatorField}
                                        series={item.series ?? null}
                                        seriesNumber={item.seriesNumber ?? null}
                                        status="todo"
                                        genre={item.genre ?? null}
                                        notes={Boolean(item.body)}
                                        date={item.created}
                                    />
                                </li>
                            ))}
                        </ul>
                    </section>
                );
            })}
        </div>
    </>
)}

<style>
    .shelf-queue__empty {
        color: var(--gray-text-muted);
        font-size: var(--text-small);
        padding: 2rem 0;
        text-align: center;
    }
</style>

<script>
    import { initShelfFilters } from '../../scripts/shelfFilters';

    function initShelfQueueFilters() {
        const root = document.querySelector<HTMLElement>('[data-shelf-queue]');
        if (!root) return;
        const { personFilter = 'creator', nounSingular = 'item', nounPlural = 'items' } = root.dataset;

        initShelfFilters({
            itemSelector: '[data-shelf-item]',
            countNoun: { singular: nounSingular, plural: nounPlural },
            filterTypes: [
                { type: personFilter, attr: 'data-person' },
                { type: 'series' },
                { type: 'genre', badgeClass: () => 'shelf-filter-badge--genre' },
                { type: 'tag', attr: 'data-tags', badgeClass: () => 'shelf-filter-badge--tag' },
            ],
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initShelfQueueFilters);
    } else {
        initShelfQueueFilters();
    }
</script>
