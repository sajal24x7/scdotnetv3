---
import PostItem from '../PostItem.astro';
import { parseMarkdown } from '../../utils/markdown';

interface Props {
    posts: any[];
}

const { posts } = Astro.props as Props;
const hasSidebarContent = Astro.slots.has('sidebar');

const renderedPosts = posts.map(post => ({
    ...post,
    renderedContent: post.body ? parseMarkdown(post.body) : null
}));

const isMicroContent = (category: string) => category === 'micro';
---

<section class="stream-layout">
    <section class="stream-layout__posts grid-span-8 grid-start-1">
        {renderedPosts.map((post) => (
            <PostItem post={post} isMicroContent={isMicroContent} showFullContent={true} />
        ))}
    </section>

    {hasSidebarContent && (
        <aside class="stream-layout__sidebar grid-span-4 grid-start-9">
            <div class="stream-layout__sidebar-inner">
                <slot name="sidebar" />
            </div>
        </aside>
    )}
</section>

<style>
    .stream-layout {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        column-gap: clamp(1.5rem, 4vw, 2.25rem);
        row-gap: clamp(2rem, 5vw, 2.75rem);
        padding-block: clamp(1.5rem, 4vw, 2.5rem);
        align-items: start;
    }

    .stream-layout__posts {
        --post-item-spacing: var(--grid-row-gap);
        display: flex;
        flex-direction: column;
        gap: var(--grid-row-gap);
    }

    .stream-layout__sidebar {
        align-self: start;
    }

    .stream-layout__sidebar-inner {
        position: sticky;
        top: clamp(1.5rem, 4vw, 3rem);
        display: flex;
        flex-direction: column;
        gap: clamp(1rem, 3vw, 1.75rem);
    }

    @media (max-width: 63.9375rem) {
        .stream-layout__sidebar-inner {
            position: static;
        }
    }

    @media (min-width: 48rem) {
        .stream-layout {
            grid-template-columns: repeat(12, minmax(0, 1fr));
        }
    }
</style>
