---
import StreamPost from '../StreamPost.astro';
import { marked } from 'marked';

interface Props {
  posts: any[];
}

const { posts } = Astro.props;

// Configure marked options
marked.setOptions({
  gfm: true, // GitHub Flavored Markdown
  breaks: true // Convert line breaks to <br>
});

// Pre-render markdown content for posts
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? marked.parse(post.body) : null
}));





// Format date function


// Check if content is micro type
const isMicroContent = (category: string) => category === 'micro';
---

<div class="stream-layout">
  {renderedPosts.map((post) => (
    <StreamPost post={post} isMicroContent={isMicroContent} />
  ))}
</div>

<style>
  .stream-layout {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .stream-sidebar-left {
    /* This is now empty - metadata is handled within each post row */
    display: none;
  }

  .stream-content {
    padding: 0;
  }

  .stream-sidebar-right {
    position: sticky;
    top: 2rem;
    height: fit-content;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .stream-sidebar-right::-webkit-scrollbar {
    width: 4px;
  }

  .stream-sidebar-right::-webkit-scrollbar-track {
    background: #f3f4f6;
  }

  .stream-sidebar-right::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 2px;
  }

  :global(.dark) .stream-sidebar-right::-webkit-scrollbar-track {
    background: #1f2937;
  }

  :global(.dark) .stream-sidebar-right::-webkit-scrollbar-thumb {
    background: #4b5563;
  }

  /* Post row styling */
  .stream-post-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .stream-post-row:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }

  :global(.dark) .stream-post-row {
    border-bottom-color: #374151;
  }

  @media (max-width: 1023px) {
    .stream-post-row {
      display: block;
    }
    
    .stream-post-metadata {
      display: none;
    }
  }

  .stream-post {
    /* Border and spacing now handled by stream-post-row */
  }



  .stream-post-metadata {
    display: flex;
    justify-content: flex-end;
    padding-right: 1rem;
  }

  .stream-metadata {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: #6b7280;
    text-align: right;
  }

  :global(.dark) .stream-metadata {
    color: #9ca3af;
  }

  .stream-date-link {
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .stream-date {
    font-weight: 500;
    color: #8b5cf6;
    font-family: monospace;
  }

  .stream-meta-divider {
    color: #d1d5db;
  }

  :global(.dark) .stream-meta-divider {
    color: #4b5563;
  }

  .stream-date-link:hover .stream-date {
    color: #7c3aed;
    text-decoration: underline;
  }

  :global(.dark) .stream-date {
    color: #a78bfa;
  }

  :global(.dark) .stream-date-link:hover .stream-date {
    color: #c4b5fd;
  }





  .stream-tags-sidebar {
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    align-items: flex-end;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .stream-tags-inline {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    display: inline-block;
    color: #8b5cf6;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border: 1px solid #8b5cf6;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.2s ease;
    background: transparent;
    white-space: nowrap;
  }

  .tag:hover {
    color: #7c3aed;
    border-color: #7c3aed;
    background: rgba(139, 92, 246, 0.05);
  }

  :global(.dark) .tag {
    color: #a78bfa;
    border-color: #a78bfa;
  }

  :global(.dark) .tag:hover {
    color: #c4b5fd;
    border-color: #c4b5fd;
    background: rgba(167, 139, 250, 0.1);
  }

  .stream-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.75rem;
    color: #111827;
  }

  :global(.dark) .stream-title {
    color: #f9fafb;
  }

  .stream-title-link {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
  }

  /* Yellow highlight hover effect for stream title links */
  .stream-title-link {
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  .stream-title-link::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 0.3em;
    background-color: #fbbf24; /* Yellow highlight color */
    bottom: 0;
    left: 0;
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.3s ease-in-out;
    z-index: -1;
  }

  .stream-title-link:hover::before {
    transform: scaleY(1);
  }

  :global(.dark) .stream-title-link::before {
    background-color: #f59e0b; /* Slightly darker yellow for dark mode */
  }

  .stream-description {
    color: #4b5563;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  :global(.dark) .stream-description {
    color: #ffffff;
  }

  .stream-body {
    margin-bottom: 1rem;
  }

  /* Yellow highlight hover effect for read more links */
  .read-more-link {
    position: relative;
    text-decoration: none;
    font-weight: 500;
    color: inherit;
  }

  .read-more-link::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 0.3em;
    background-color: #fbbf24; /* Yellow highlight color */
    bottom: 0;
    left: 0;
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.3s ease-in-out;
    z-index: -1;
  }

  .read-more-link:hover::before {
    transform: scaleY(1);
  }

  :global(.dark) .read-more-link::before {
    background-color: #f59e0b; /* Slightly darker yellow for dark mode */
  }
</style>
