---
import PostItem from '../PostItem.astro';
import { parseMarkdown } from '../../utils/markdown';

interface Props {
    posts: any[];
}

const { posts } = Astro.props as Props;
const hasSidebarContent = Astro.slots.has('sidebar');

const renderedPosts = posts.map(post => ({
    ...post,
    renderedContent: post.body ? parseMarkdown(post.body) : null
}));

const isMicroContent = (category: string) => category === 'micro';
---

<div class={`stream-layout ${hasSidebarContent ? 'stream-layout--with-sidebar' : ''}`}>
    <section class="stream-layout__posts">
        {renderedPosts.map((post) => (
            <PostItem post={post} isMicroContent={isMicroContent} showFullContent={true} />
        ))}
    </section>

    {hasSidebarContent && (
        <aside class="stream-layout__sidebar">
            <div class="stream-layout__sidebar-inner">
                <slot name="sidebar" />
            </div>
        </aside>
    )}
</div>

<style>
    .stream-layout {
        --stream-layout-row-gap: clamp(1.25rem, 4vw, 2rem);
        --stream-layout-column-gap: clamp(1rem, 2.5vw, 1.75rem);
        padding-block: clamp(1.25rem, 3vw, 2.25rem);
        display: flex;
        flex-direction: column;
        gap: var(--stream-layout-row-gap);
    }

    .stream-layout__posts {
        --post-item-spacing: var(--stream-layout-row-gap);
        display: flex;
        flex-direction: column;
        gap: var(--stream-layout-row-gap);
    }

    .stream-layout__sidebar {
        margin-top: var(--stream-layout-row-gap);
        align-self: start;
    }

    .stream-layout__sidebar-inner {
        position: sticky;
        top: clamp(1.5rem, 4vw, 3rem);
        display: flex;
        flex-direction: column;
        gap: clamp(1rem, 3vw, 1.75rem);
    }

    @media (min-width: 64rem) {
        .stream-layout {
            --stream-layout-row-gap: clamp(1.25rem, 2.5vw, 1.75rem);
        }

        .stream-layout.stream-layout--with-sidebar {
            display: grid;
            grid-template-columns: repeat(12, minmax(0, 1fr));
            column-gap: var(--stream-layout-column-gap);
            row-gap: var(--stream-layout-row-gap);
        }

        .stream-layout.stream-layout--with-sidebar .stream-layout__posts {
            grid-column: span 8;
        }

        .stream-layout.stream-layout--with-sidebar .stream-layout__sidebar {
            margin-top: 0;
            grid-column: 9 / span 4;
        }
    }

    @media (max-width: 63.9375rem) {
        .stream-layout__sidebar-inner {
            position: static;
        }
    }
</style>
