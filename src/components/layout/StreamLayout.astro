---
import PostItem from '../PostItem.astro';
import { parseMarkdown } from '../../utils/markdown';

interface Props {
  posts: any[];
}

const { posts } = Astro.props;

// Pre-render markdown content for posts
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? parseMarkdown(post.body) : null
}));





// Format date function


// Check if content is micro type
const isMicroContent = (category: string) => category === 'micro';
---

<div class="stream-layout layout-boundary px-4">
  {renderedPosts.map((post) => (
    <PostItem post={post} isMicroContent={isMicroContent} showFullContent={true} />
  ))}
</div>

<style>
  .stream-sidebar-left {
    /* This is now empty - metadata is handled within each post row */
    display: none;
  }

  .stream-content {
    padding: 0;
  }

  .stream-sidebar-right {
    position: sticky;
    top: 2rem;
    height: fit-content;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .stream-sidebar-right::-webkit-scrollbar {
    width: 4px;
  }

  .stream-sidebar-right::-webkit-scrollbar-track {
    background: #f3f4f6;
  }

  .stream-sidebar-right::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 2px;
  }

  :global(.dark) .stream-sidebar-right::-webkit-scrollbar-track {
    background: #1f2937;
  }

  :global(.dark) .stream-sidebar-right::-webkit-scrollbar-thumb {
    background: #4b5563;
  }

  /* Post row styling */
  .post-item-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .post-item-row:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }

  :global(.dark) .post-item-row {
    border-bottom-color: #374151;
  }

  @media (max-width: 1023px) {
    .post-item-row {
      display: block;
    }
    
    .post-item-metadata {
      display: none;
    }
  }

  .post-item {
    /* Border and spacing now handled by post-item-row */
  }



  .post-item-metadata {
    display: flex;
    justify-content: flex-end;
    padding-right: 1rem;
  }

  .stream-metadata {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: #6b7280;
    text-align: right;
  }

  :global(.dark) .stream-metadata {
    color: #9ca3af;
  }

  .stream-date-link {
    text-decoration: none;
    transition: all 0.2s ease;
    color: inherit;
    font-weight: 500;
  }

  .stream-date {
    font-weight: 500;
    color: inherit;
    font-family: monospace;
  }

  .stream-meta-divider {
    color: #d1d5db;
  }

  :global(.dark) .stream-meta-divider {
    color: #4b5563;
  }

  /* Hover and dark-mode link colors are handled by shared utilities */





  .stream-tags-sidebar {
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    align-items: flex-end;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .stream-tags-inline {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.2s ease;
    background: transparent;
    white-space: nowrap;
  }

  /* Tag colors and hover behavior are provided by the tag-chip utility */

  .stream-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.75rem;
    color: #111827;
  }

  :global(.dark) .stream-title {
    color: #f9fafb;
  }

  .stream-title-link {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
  }

  /* Stream title links inherit styling from global link rules */

  .stream-description {
    color: #4b5563;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  :global(.dark) .stream-description {
    color: #d1d5db;
  }

  .stream-body {
    margin-bottom: 1rem;
  }

  .read-more-link {
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  /* Read more links rely on global link styling */
</style>
