---
interface Props {
  maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl' | '7xl' | 'full';
  className?: string;
  centered?: boolean;
}

const { 
  maxWidth = '4xl', 
  className = '', 
  centered = true 
} = Astro.props;

const maxWidthClasses = {
  sm: 'max-w-sm',
  md: 'max-w-md',
  lg: 'max-w-lg',
  xl: 'max-w-xl',
  '2xl': 'max-w-2xl',
  '3xl': 'max-w-3xl',
  '4xl': 'max-w-4xl',
  '5xl': 'max-w-5xl',
  '6xl': 'max-w-6xl',
  '7xl': 'max-w-7xl',
  full: 'max-w-full'
};

const proseClasses = `prose dark:prose-invert ${maxWidthClasses[maxWidth]} ${centered ? 'mx-auto' : ''} ${className}`.trim();
---

<div class={proseClasses}>
  <slot />
</div> 