---
import PostItem from '../PostItem.astro';
import { parseMarkdown } from '../../utils/markdown';

interface Props {
    posts: any[];
    showFullContent?: boolean;
}

const { posts = [], showFullContent = true } = Astro.props as Props;

const renderedPosts = posts.map((post) => ({
    ...post,
    renderedContent: post.body ? parseMarkdown(post.body) : null
}));

const isMicroContent = (category: string) => category === 'micro';
---

<div class="home-stream-list">
    {renderedPosts.map((post) => (
        <PostItem post={post} isMicroContent={isMicroContent} showFullContent={showFullContent} />
    ))}
</div>

<style>
    .home-stream-list {
        --stream-list-gap: clamp(1rem, 3vw, 1.75rem);
        display: flex;
        flex-direction: column;
        gap: var(--stream-list-gap);
    }
</style>
