---
// HomeTwoRowGrid.astro
// Two 2x1 responsive grids for the home page, with custom column widths and dividers.
---

<!-- Top row: Garden (wider) | Stream (narrower) -->
<div class="grid grid-cols-1 md:grid-cols-[1.3fr_0.7fr] gap-6 md:gap-8 w-full mb-8">
  <div class="flex flex-col min-h-[200px]">
    <div class="mb-4">
      <a href="/garden/" class="text-large font-semibold text-gray-900 dark:text-gray-100 hover:text-accent transition-colors">
        Garden
      </a>
    </div>
    <slot name="topLeft" />
  </div>
  <div class="flex flex-col min-h-[200px]">
    <div class="mb-4">
      <a href="/stream/" class="text-large font-semibold text-gray-900 dark:text-gray-100 hover:text-accent transition-colors">
        Stream
      </a>
    </div>
    <slot name="topRight" />
  </div>
</div>

<!-- Bottom row: Prose (wider) | Bookshelf (narrower) -->
<div class="grid grid-cols-1 md:grid-cols-[0.7fr_1.3fr] gap-6 md:gap-8 w-full">
  <div class="flex flex-col min-h-[200px]">
    <div class="mb-4">
      <a href="/bookshelf/" class="text-large font-semibold text-gray-900 dark:text-gray-100 hover:text-accent transition-colors">
        Bookshelf
      </a>
    </div>
    <slot name="bottomRight" /> <!-- Bookshelf (narrower, left) -->
  </div>
  <div class="flex flex-col min-h-[200px]">
    <div class="mb-4">
      <a href="/prose/" class="text-large font-semibold text-gray-900 dark:text-gray-100 hover:text-accent transition-colors">
        Prose
      </a>
    </div>
    <slot name="bottomLeft" /> <!-- Prose (wider, right) -->
  </div>
</div>

<style>
  @media (max-width: 768px) {
    .grid {
      gap: 1rem;
    }
  }
</style> 