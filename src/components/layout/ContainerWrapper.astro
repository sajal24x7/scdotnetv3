---
interface Props {
  maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl' | '7xl' | 'full';
  padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  className?: string;
  centered?: boolean;
}

const { 
  maxWidth = 'full', 
  padding = 'none', 
  className = '',
  centered = true
} = Astro.props;

const maxWidthClasses = {
  sm: 'max-w-sm',
  md: 'max-w-md',
  lg: 'max-w-lg',
  xl: 'max-w-xl',
  '2xl': 'max-w-2xl',
  '3xl': 'max-w-3xl',
  '4xl': 'max-w-4xl',
  '5xl': 'max-w-5xl',
  '6xl': 'max-w-6xl',
  '7xl': 'max-w-7xl',
  full: 'max-w-full'
};

const paddingClasses = {
  none: '',
  sm: 'px-2 py-4',
  md: 'px-4 py-8',
  lg: 'px-6 py-12',
  xl: 'px-8 py-16'
};

const containerClasses = `${maxWidthClasses[maxWidth]} ${paddingClasses[padding]} ${centered ? 'mx-auto' : ''} ${className}`.trim();
---

<div class={containerClasses}>
  <slot />
</div> 