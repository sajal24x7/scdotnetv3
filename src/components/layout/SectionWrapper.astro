---
interface Props {
  padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  margin?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  className?: string;
}

const { 
  padding = 'md', 
  margin = 'none', 
  className = '' 
} = Astro.props;

const paddingClasses = {
  none: '',
  sm: 'px-2 py-4',
  md: 'px-4 py-8',
  lg: 'px-6 py-12',
  xl: 'px-8 py-16'
};

const marginClasses = {
  none: '',
  sm: 'my-2',
  md: 'my-4',
  lg: 'my-8',
  xl: 'my-16'
};

const sectionClasses = `${paddingClasses[padding]} ${marginClasses[margin]} ${className}`.trim();
---

<section class={sectionClasses}>
  <slot />
</section> 