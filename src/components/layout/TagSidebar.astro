---
interface Props {
  tags: string[];
  title?: string;
}

const { tags, title = "Tags" } = Astro.props;
---

<aside class="tag-sidebar">
  <div class="tag-sidebar-content">
    <h3 class="tag-sidebar-title">{title}</h3>
    <div class="tag-list">
      {tags.map((tag) => (
        <a href={`/tags/${tag.toLowerCase()}/`} class="tag-item">
          {tag.toUpperCase()}
        </a>
      ))}
    </div>
  </div>
</aside>

<style>
  .tag-sidebar {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    padding: 1.5rem;
    height: fit-content;
  }

  :global(.dark) .tag-sidebar {
    background: #1f2937;
    border-color: #374151;
  }

  .tag-sidebar-content {
    width: 100%;
  }

  .tag-sidebar-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #111827;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 0.5rem;
  }

  :global(.dark) .tag-sidebar-title {
    color: #f9fafb;
    border-bottom-color: #374151;
  }

  .tag-list {
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  .tag-item {
    display: inline-block;
    color: #8b5cf6;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border: 1px solid #8b5cf6;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.2s ease;
    background: transparent;
    white-space: nowrap;
  }

  .tag-item:hover {
    color: #7c3aed;
    border-color: #7c3aed;
    background: rgba(139, 92, 246, 0.05);
  }

  :global(.dark) .tag-item {
    color: #a78bfa;
    border-color: #a78bfa;
  }

  :global(.dark) .tag-item:hover {
    color: #c4b5fd;
    border-color: #c4b5fd;
    background: rgba(167, 139, 250, 0.1);
  }

  /* Active state for current tag */
  .tag-item.active {
    color: #7c3aed;
    border-color: #7c3aed;
    background: rgba(139, 92, 246, 0.1);
    font-weight: 500;
  }

  :global(.dark) .tag-item.active {
    color: #c4b5fd;
    border-color: #c4b5fd;
    background: rgba(167, 139, 250, 0.15);
  }

  /* Responsive adjustments */
  @media (max-width: 1023px) {
    .tag-sidebar {
      display: none;
    }
  }

  /* Scrollable on very tall lists */
  @media (min-height: 800px) {
    .tag-list {
      max-height: 60vh;
      overflow-y: auto;
      scrollbar-width: thin;
    }

    .tag-list::-webkit-scrollbar {
      width: 4px;
    }

    .tag-list::-webkit-scrollbar-track {
      background: #f3f4f6;
    }

    .tag-list::-webkit-scrollbar-thumb {
      background: #d1d5db;
      border-radius: 2px;
    }

    :global(.dark) .tag-list::-webkit-scrollbar-track {
      background: #1f2937;
    }

    :global(.dark) .tag-list::-webkit-scrollbar-thumb {
      background: #4b5563;
    }
  }

  /* Compact mode for smaller sidebars */
  .tag-sidebar.compact {
    padding: 1rem;
  }

  .tag-sidebar.compact .tag-sidebar-title {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }

  .tag-sidebar.compact .tag-item {
    padding: 0.375rem 0.5rem;
    font-size: 0.8rem;
  }
</style>
