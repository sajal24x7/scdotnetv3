---
interface Props {
  title: string;
  description?: string;
  showBackButton?: boolean;
  backUrl?: string;
  actions?: any[];
  layout?: 'centered' | 'left-aligned';
  size?: 'sm' | 'md' | 'lg';
  maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl' | '7xl' | 'full';
  rssUrl?: string;
}

const {
  title,
  description,
  showBackButton = false,
  backUrl = '/',
  actions = [],
  layout = 'left-aligned',
  size = 'md',
  maxWidth = '2xl',
  rssUrl
} = Astro.props;

const sizeClasses = {
  sm: {
    title: 'text-large font-bold',
    description: 'text-small mt-2',
    container: 'mb-6'
  },
  md: {
    title: 'text-huge font-bold',
    description: 'text-normal mt-3',
    container: 'mb-8'
  },
  lg: {
    title: 'text-huge font-bold',
    description: 'text-large mt-4',
    container: 'mb-10'
  }
};

const maxWidthClasses = {
  sm: 'max-w-sm',
  md: 'max-w-md',
  lg: 'max-w-lg',
  xl: 'max-w-xl',
  '2xl': 'max-w-2xl',
  '3xl': 'max-w-3xl',
  '4xl': 'max-w-4xl',
  '5xl': 'max-w-5xl',
  '6xl': 'max-w-6xl',
  '7xl': 'max-w-7xl',
  full: 'max-w-full'
};

// Layout is now handled conditionally in the template
---

<header class={`${sizeClasses[size].container}`}>
  {layout === 'centered' ? (
    <div class="text-center">
      {showBackButton && (
        <a 
          href={backUrl} 
          class="inline-flex items-center text-small text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 mb-4 transition-colors"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back
        </a>
      )}
      
      <h1 class={`${sizeClasses[size].title} text-textPrimary`}>
        {rssUrl ? (
          <span class="title-with-rss">
            <span>{title}</span>
            <a href={rssUrl} class="rss-title-icon" aria-label={`${title} RSS feed`} title="Subscribe via RSS">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M3.429 2.857v2.857c9.714 0 17.571 7.857 17.571 17.571h2.857C23.857 13.429 13.286 2.857 3.429 2.857zm0 5.714v2.858c5.143 0 9.286 4.143 9.286 9.285h2.857c0-6.857-5.486-12.343-12.143-12.343zm2.285 7.714c1.257 0 2.286 1.029 2.286 2.286S6.971 20.857 5.714 20.857 3.429 19.828 3.429 18.571s1.028-2.286 2.285-2.286z"/>
              </svg>
            </a>
          </span>
        ) : title}
      </h1>

      {description && (
        <p class={`${sizeClasses[size].description} mx-auto ${maxWidthClasses[maxWidth]}`}>
          {description}
        </p>
      )}
      
      {actions.length > 0 && (
        <div class="flex items-center justify-center gap-3 mt-4">
          {actions.map((action) => (
            <a 
              href={action.href} 
              class={`inline-flex items-center px-4 py-2 rounded-lg font-medium transition-all duration-200 ${
                action.primary 
                  ? 'bg-accent text-white hover:bg-accent-dark shadow-md hover:shadow-lg' 
                  : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:text-gray-700'
              }`}
            >
              {action.icon && (
                <span class="mr-2" set:html={action.icon} />
              )}
              {action.label}
            </a>
          ))}
        </div>
      )}
    </div>
  ) : (
    <div class="flex items-start justify-between">
      <div class="flex-1">
        {showBackButton && (
          <a 
            href={backUrl} 
            class="inline-flex items-center text-small text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 mb-4 transition-colors"
          >
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Back
          </a>
        )}
        
        <h1 class={`${sizeClasses[size].title} text-textPrimary`}>
          {rssUrl ? (
            <span class="title-with-rss">
              <span>{title}</span>
              <a href={rssUrl} class="rss-title-icon" aria-label={`${title} RSS feed`} title="Subscribe via RSS">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M3.429 2.857v2.857c9.714 0 17.571 7.857 17.571 17.571h2.857C23.857 13.429 13.286 2.857 3.429 2.857zm0 5.714v2.858c5.143 0 9.286 4.143 9.286 9.285h2.857c0-6.857-5.486-12.343-12.143-12.343zm2.285 7.714c1.257 0 2.286 1.029 2.286 2.286S6.971 20.857 5.714 20.857 3.429 19.828 3.429 18.571s1.028-2.286 2.285-2.286z"/>
                </svg>
              </a>
            </span>
          ) : title}
        </h1>

        {description && (
          <p class={`${sizeClasses[size].description} ${maxWidthClasses[maxWidth]}`}>
            {description}
          </p>
        )}
      </div>
      
      {actions.length > 0 && (
        <div class="flex items-center gap-3 ml-6">
          {actions.map((action) => (
            <a 
              href={action.href} 
              class={`inline-flex items-center px-4 py-2 rounded-lg font-medium transition-all duration-200 ${
                action.primary 
                  ? 'bg-accent text-white hover:bg-accent-dark shadow-md hover:shadow-lg' 
                  : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:text-gray-700'
              }`}
            >
              {action.icon && (
                <span class="mr-2" set:html={action.icon} />
              )}
              {action.label}
            </a>
          ))}
        </div>
      )}
    </div>
  )}
</header>

<style>
  .title-with-rss {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }

  .rss-title-icon {
    display: inline-flex;
    align-items: center;
    color: inherit;
    opacity: 0.35;
    transition: opacity 0.15s ease;
    text-decoration: none;
    flex-shrink: 0;
  }

  .rss-title-icon:hover {
    opacity: 0.8;
  }

  .rss-title-icon svg {
    width: 0.6em;
    height: 0.6em;
  }

  /* Smooth transitions */
  .inline-flex {
    transition: all 0.2s ease-in-out;
  }

  /* Hover effects */
  .inline-flex:hover {
    transform: translateY(-1px);
  }

  /* Back button hover */
  a:hover svg {
    transform: translateX(-2px);
  }

  /* Description colors */
  p.text-small,
  p.text-normal,
  p.text-large {
    color: rgb(71 85 105);
  }

  :global(.dark) p.text-small,
  :global(.dark) p.text-normal,
  :global(.dark) p.text-large {
    color: rgb(var(--color-text-secondary));
  }

  /* Dark mode adjustments */
  :global(.dark) .bg-accent {
    background-color: var(--color-accent);
  }

  :global(.dark) .bg-accent-dark {
    background-color: var(--color-accent-dark, #1a5f7a);
  }
</style> 