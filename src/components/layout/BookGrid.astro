---
import BookCard from '../BookCard.astro';

interface Props {
  books: any[];
  showCurrentlyReading?: boolean;
  sectionTitle?: string;
}

const { books, showCurrentlyReading = true, sectionTitle } = Astro.props;

// Transform books for BookCard component
const transformBook = (book: any) => {
  console.log('BookGrid Debug - Original book data:', {
    bookCover: book.data.bookCover,
    bookCoverType: typeof book.data.bookCover,
    bookCoverLength: book.data.bookCover?.length,
    title: book.data.title
  });
  
  const transformed = {
    ...book.data,
    link: book.slug ? `/bookshelf/${book.slug}/` : undefined
  };
  
  console.log('BookGrid Debug - Transformed data:', {
    bookCover: transformed.bookCover,
    bookCoverType: typeof transformed.bookCover,
    bookCoverLength: transformed.bookCover?.length,
    title: transformed.title
  });
  
  return transformed;
};

// If showCurrentlyReading is true, filter for currently reading books
// Otherwise, display all books as-is (for yearly sections)
const displayBooks = showCurrentlyReading 
  ? books.filter(book => book.data.bookStatus === 'reading')
  : books;
---

<div class="book-grid-container">
  {displayBooks.length > 0 && (
    <div class="book-grid">
      {displayBooks.map((book) => (
        <div class="book-card-wrapper">
          <BookCard {...transformBook(book)} />
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .book-grid-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0;
  }

  .book-grid {
    display: grid;
    gap: 1.5rem;
    width: 100%;
  }

  /* Mobile: 1 column */
  .book-grid {
    grid-template-columns: 1fr;
  }

  /* Small tablet: 2 columns */
  @media (min-width: 640px) {
    .book-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Large tablet and desktop: 2 columns for better readability */
  @media (min-width: 1024px) {
    .book-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .book-card-wrapper {
    /* Just a container - don't interfere with BookCard's internal layout */
  }


  /* Mobile adjustments */
  @media (max-width: 639px) {
    .book-grid {
      gap: 1rem;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 640px) and (max-width: 1023px) {
    .book-grid {
      gap: 1.25rem;
    }
  }
</style>