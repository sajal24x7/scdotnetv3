---
import Card from '../Card.astro';
import BookshelfCard from '../bookshelf/BookshelfCard.astro';
import { parseMarkdown } from '../../utils/markdown';

interface Props {
  posts: any[];
}

const { posts } = Astro.props;

// Pre-render markdown content
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? parseMarkdown(post.body) : null
}));

// Content type specific styling classes
const getContentTypeClasses = (category?: string) => {
  switch (category) {
    case 'evergreen':
      return 'evergreen-card';
    case 'til':
      return 'til-card';
    case 'bookshelf':
      return 'bookshelf-card';
    case 'story':
      return 'stories-card';
    case 'poem':
      return 'poems-card';
    default:
      return 'default-card';
  }
};
---

<div class="featured-grid grid-span-full" data-featured-grid>
  {renderedPosts.map((post) => {
      const isBookshelf = post.data.category === 'bookshelf';

      return (
          <div
              class={`featured-card ${getContentTypeClasses(post.data.category)}`}
              data-featured-card
          >
              {isBookshelf ? (
                  <BookshelfCard
                      title={post.data.title}
                      author={post.data.author}
                      series={post.data.series}
                      startedReading={post.data.startedReading}
                      finishedReading={post.data.finishedReading}
                      bookStatus={post.data.bookStatus}
                      readingProgress={post.data.readingProgress}
                      bookRating={post.data.bookRating}
                      bookCover={post.data.bookCover}
                      link={post.data.link}
                      format={post.data.format}
                      pubDate={post.data.pubDate}
                  />
              ) : (
                  <Card {...post.data}>
                      {post.renderedContent && (
                          <div class="prose dark:prose-dark max-w-none">
                              <div set:html={post.renderedContent} />
                          </div>
                      )}
                  </Card>
              )}
          </div>
      );
  })}
</div>

<style>
  /* ── Grid ─────────────────────────────────────────────── */
  :global([data-featured-grid]) {
    --grid-column-gap: clamp(0.75rem, 2.5vw, 1.5rem);
    --grid-row-gap: clamp(1rem, 3vw, 1.75rem);
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    grid-auto-rows: 9rem;
    gap: var(--grid-row-gap) var(--grid-column-gap);
  }

  @media (min-width: 48rem) {
    :global([data-featured-grid]) {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 11rem;
    }
  }

  /* ── Card wrapper ─────────────────────────────────────── */
  .featured-card {
    position: relative;
    display: flex;
    min-width: 0;
  }

  .featured-card {
    grid-column: 1 / -1;
  }

  @media (min-width: 48rem) {
    .featured-card {
      grid-column: span 1 / span 1;
    }
  }

  /* ── Card: fills its grid row, image fills card ───────── */
  .featured-card :global(.card),
  .featured-card :global(.book-card) {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    border-radius: 0.75rem;
    border: none !important;
    background: #1a1a1a !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18), 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  /* card-content: zero padding, acts as positioned container */
  .featured-card :global(.card-content) {
    padding: 0;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  /* Image fills the entire card */
  .featured-card :global(.card-image) {
    position: absolute;
    inset: 0;
    height: 100%;
    min-height: 0;
    max-height: none;
    aspect-ratio: auto !important;
    margin: 0;
    overflow: hidden;
  }

  .featured-card :global(.card-image img) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    transition: transform 0.35s ease;
  }

  .featured-card :global(.card:hover .card-image img) {
    transform: scale(1.05);
  }

  /* No-image cards: dark gradient fills the whole card */
  .featured-card :global(.card--no-image .card-content)::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    border-radius: 0;
  }

  /* ── Text overlay at the bottom ───────────────────────── */
  .featured-card :global(.card-body) {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.65rem 0.8rem 0.7rem;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.82) 0%,
      rgba(0, 0, 0, 0.55) 55%,
      transparent 100%
    );
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .featured-card :global(.card-title) {
    color: #ffffff;
    font-size: clamp(0.9rem, 1.6vw, 1.05rem);
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  .featured-card :global(.card-meta) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin: 0;
  }

  /* Chip-style tags in the overlay */
  .featured-card :global(.card-chip),
  .featured-card :global(.card-category) {
    color: rgba(255, 255, 255, 0.85) !important;
    font-size: 0.65rem !important;
    background: rgba(255, 255, 255, 0.15) !important;
    border-color: rgba(255, 255, 255, 0.2) !important;
  }

  .featured-card :global(.card-description) {
    display: none;
  }

  /* ── Hover glow (override Card.astro's light hover bg) ── */
  .featured-card :global(.card:hover),
  .featured-card :global(.card:focus-within) {
    background: #1a1a1a !important;
    box-shadow:
      0 0 0 2px var(--card-accent, rgba(167, 139, 250, 0.6)),
      0 8px 24px rgba(0, 0, 0, 0.3) !important;
    transform: translateY(-2px);
  }

  /* ── Content type accent colours ─────────────────────── */
  .evergreen-card  { --card-accent: #10b981; }
  .til-card        { --card-accent: #3b82f6; }
  .bookshelf-card  { --card-accent: #f59e0b; }
  .stories-card    { --card-accent: #8b5cf6; }
  .poems-card      { --card-accent: #ec4899; }
</style>
