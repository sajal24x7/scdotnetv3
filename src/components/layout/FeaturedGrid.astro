---
import Card from '../Card.astro';
import BookshelfCard from '../bookshelf/BookshelfCard.astro';
import { parseMarkdown } from '../../utils/markdown';

interface Props {
  posts: any[];
}

const { posts } = Astro.props;

// Pre-render markdown content
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? parseMarkdown(post.body) : null
}));

// Content type specific styling classes
const getContentTypeClasses = (category?: string) => {
  switch (category) {
    case 'evergreen':
      return 'evergreen-card';
    case 'til':
      return 'til-card';
    case 'bookshelf':
      return 'bookshelf-card';
    case 'story':
      return 'stories-card';
    case 'poem':
      return 'poems-card';
    default:
      return 'default-card';
  }
};
---

<div class="featured-grid grid-span-full" data-featured-grid>
  {renderedPosts.map((post) => {
      const isBookshelf = post.data.category === 'bookshelf';

      return (
          <div
              class={`featured-card ${getContentTypeClasses(post.data.category)}`}
              data-featured-card
          >
              {isBookshelf ? (
                  <BookshelfCard
                      title={post.data.title}
                      author={post.data.author}
                      series={post.data.series}
                      startedReading={post.data.startedReading}
                      finishedReading={post.data.finishedReading}
                      bookStatus={post.data.bookStatus}
                      readingProgress={post.data.readingProgress}
                      bookRating={post.data.bookRating}
                      bookCover={post.data.bookCover}
                      link={post.data.link}
                      format={post.data.format}
                      pubDate={post.data.pubDate}
                  />
              ) : (
                  <Card {...post.data}>
                      {post.renderedContent && (
                          <div class="prose dark:prose-dark max-w-none">
                              <div set:html={post.renderedContent} />
                          </div>
                      )}
                  </Card>
              )}
          </div>
      );
  })}
</div>

<style>
  :global([data-featured-grid]) {
    --grid-column-gap: clamp(0.75rem, 2.5vw, 1.5rem);
    --grid-row-gap: clamp(1rem, 3vw, 1.75rem);
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--grid-row-gap) var(--grid-column-gap);
    grid-auto-rows: minmax(0, auto);
    align-items: start;
  }

  @media (min-width: 48rem) {
    :global([data-featured-grid]) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .featured-card {
    position: relative;
    display: flex;
    min-width: 0;
  }

  /* On mobile, cards span full width */
  .featured-card {
    grid-column: 1 / -1;
  }

  /* On desktop, each card spans 1 column in the 4-column grid */
  @media (min-width: 48rem) {
    .featured-card {
      grid-column: span 1 / span 1;
    }
  }

  /* Fixed height for all cards in featured section */
  .featured-card :global(.card),
  .featured-card :global(.book-card) {
    width: 100%;
    height: 100%;
    min-height: 15rem;
    max-height: 15rem;
    display: flex;
    flex-direction: column;
  }

  /* Add borders to all featured cards */
  .featured-card :global(.card) {
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 4px 12px rgba(15, 23, 42, 0.08);
  }

  :global(.dark) .featured-card :global(.card) {
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.2),
      0 4px 12px rgba(0, 0, 0, 0.3);
  }

  /* Make cards with images have transparent background but keep border */
  .featured-card :global(.card--with-image) {
    background: transparent !important;
  }

  /* Set featured card image height and ensure it fills the container */
  .featured-card :global(.card-image) {
    min-height: 10rem;
    max-height: 10rem;
    aspect-ratio: auto !important;
  }

  .featured-card :global(.card-image img) {
    object-fit: cover !important;
    width: 100% !important;
    height: 100% !important;
  }

  /* Add default black placeholder for cards without images */
  .featured-card :global(.card--no-image .card-content)::before {
    content: '';
    display: block;
    width: calc(100% + (var(--card-padding) * 2));
    height: 10rem;
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    margin: calc(var(--card-padding) * -1);
    margin-bottom: var(--card-padding);
    border-radius: 0.75rem 0.75rem 0 0;
  }

  /* Ensure card content doesn't overflow */
  .featured-card :global(.card-content) {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .featured-card :global(.card-body) {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .featured-card :global(.card-description) {
    flex: 1;
    overflow: hidden;
  }

  /* Hover effects for cards without images */
  .featured-card :global(.card--no-image:hover),
  .featured-card :global(.card--no-image:focus-within) {
    box-shadow: 0 20px 46px -28px rgba(129, 140, 248, 0.35);
  }

  /* Content type specific styling */
  .evergreen-card {
    --card-accent: #10b981; /* emerald */
  }

  .til-card {
    --card-accent: #3b82f6; /* blue */
  }

  .bookshelf-card {
    --card-accent: #f59e0b; /* amber */
  }

  .stories-card {
    --card-accent: #8b5cf6; /* purple */
  }

  .poems-card {
    --card-accent: #ec4899; /* pink */
  }

  /* Apply accent colors to cards */
  .featured-card :global(.card:hover) {
    border-color: var(--card-accent, #a78bfa);
  }

  .featured-card :global(.prose a) {
    color: rgb(var(--color-text-primary));
    text-decoration: underline;
    text-decoration-color: rgba(var(--color-text-primary), 0.35);
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .featured-card :global(.prose a:hover),
  .featured-card :global(.prose a:focus-visible) {
    color: rgb(var(--color-text-primary));
    text-decoration-color: rgba(var(--color-text-primary), 0.6);
  }

  :global(.dark) .featured-card :global(.prose a) {
    color: rgb(var(--color-text-primary));
    text-decoration-color: rgba(var(--color-text-primary), 0.35);
  }

  :global(.dark) .featured-card :global(.prose a:hover),
  :global(.dark) .featured-card :global(.prose a:focus-visible) {
    color: rgb(var(--color-text-primary));
    text-decoration-color: rgba(var(--color-text-primary), 0.6);
  }
</style>
