---
import StreamCard from '../StreamCard.astro';
import TimeDisplay from '../TimeDisplay.astro';
import CategoryDisplay from '../CategoryDisplay.astro';
import { marked } from 'marked';

interface Props {
  posts: any[];
}

const { posts } = Astro.props;

// Configure marked options
marked.setOptions({
  gfm: true, // GitHub Flavored Markdown
  breaks: true // Convert line breaks to <br>
});

// Pre-render markdown content for posts
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? marked.parse(post.body) : null
}));


---

<div class="stream-grid-layout">
  <!-- Desktop: 3-column layout -->
  <div class="stream-grid-desktop">
    <!-- Left sidebar: Metadata (aligned with content) -->
    <div class="stream-grid-sidebar-left">
      <!-- Metadata containers will be positioned to align with posts -->
    </div>
    
    <!-- Center content with inline metadata positioning -->
    <div class="stream-grid-content">
      {renderedPosts.map((post) => (
        <div class="stream-grid-post-row">
          <!-- Metadata for this specific post -->
          <div class="stream-grid-post-metadata">
            <div class="stream-grid-metadata">
              <a href={post.data.link} class="stream-grid-date-link link-hover">
                <TimeDisplay
                  date={post.data.pubDate}
                  category={post.data.category}
                  className="stream-grid-date"
                />
              </a>
              <CategoryDisplay category={post.data.category} className="stream-grid-category" />
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="stream-grid-tags-sidebar">
                  {post.data.tags.map((tag: string) => (
                    <a href={`/tags/${tag.toLowerCase()}/`} class="tag tag-chip">
                      {tag.toUpperCase()}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
          
          <!-- Post content using StreamCard -->
          <div class="stream-grid-post">
            <StreamCard {...post.data} renderedContent={post.renderedContent} body={post.body} />
          </div>
        </div>
      ))}
    </div>
    

  </div>
  
  <!-- Mobile: Single column -->
  <div class="stream-grid-mobile">
    <!-- Mobile content -->
    <div class="stream-grid-mobile-content">
      {renderedPosts.map((post) => (
        <div class="stream-grid-mobile-post">
          <StreamCard {...post.data} renderedContent={post.renderedContent} body={post.body} />
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .stream-grid-layout {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0;
  }

  /* Desktop Layout */
  .stream-grid-desktop {
    display: none;
  }

  @media (min-width: 1024px) {
    .stream-grid-desktop {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 2rem;
      padding: 0 1rem;
    }
  }

  .stream-grid-sidebar-left {
    /* This is now empty - metadata is handled within each post row */
    display: none;
  }

  .stream-grid-content {
    padding: 0;
  }



  /* Post row styling */
  .stream-grid-post-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .stream-grid-post-row:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }

  :global(.dark) .stream-grid-post-row {
    border-bottom-color: #374151;
  }

  @media (max-width: 1023px) {
    .stream-grid-post-row {
      display: block;
    }
    
    .stream-grid-post-metadata {
      display: none;
    }
  }

  .stream-grid-post {
    /* Border and spacing now handled by stream-grid-post-row */
  }

  .stream-grid-post-metadata {
    display: flex;
    justify-content: flex-end;
    padding-right: 1rem;
  }

  .stream-grid-metadata {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: #6b7280;
    text-align: right;
  }

  :global(.dark) .stream-grid-metadata {
    color: #9ca3af;
  }

  .stream-grid-date-link {
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .stream-grid-date {
    font-weight: 500;
    color: #8b5cf6;
    font-family: monospace;
  }

  .stream-grid-date-link:hover .stream-grid-date {
    color: #7c3aed;
    text-decoration: underline;
  }

  :global(.dark) .stream-grid-date {
    color: #a78bfa;
  }

  :global(.dark) .stream-grid-date-link:hover .stream-grid-date {
    color: #c4b5fd;
  }



  .stream-grid-tags-sidebar {
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    align-items: flex-end;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .tag {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.2s ease;
    background: transparent;
    white-space: nowrap;
  }

  /* Tag colors and hover behavior are provided by the tag-chip utility */

  /* Mobile Layout */
  .stream-grid-mobile {
    display: block;
    padding: 0 1rem;
  }

  @media (min-width: 1024px) {
    .stream-grid-mobile {
      display: none;
    }
  }

  .stream-grid-mobile-post {
    margin-bottom: 1.5rem;
  }

  .stream-grid-mobile-post:last-child {
    margin-bottom: 0;
  }
</style>