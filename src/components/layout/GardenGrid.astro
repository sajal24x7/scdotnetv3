---
import Card from '../Card.astro';
import { parseMarkdown } from '../../utils/markdown';

interface Props {
  posts: any[];
  contentType?: 'evergreen' | 'til' | 'bookshelf' | 'stories' | 'poems' | 'mixed';
}

const { posts, contentType = 'mixed' } = Astro.props;

// Pre-render markdown content
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? parseMarkdown(post.body) : null
}));

// Content type specific styling classes
const getContentTypeClasses = (type: string, category?: string) => {
  // If mixed content type, determine from individual post category
  if (type === 'mixed' && category) {
    switch (category) {
      case 'evergreen':
        return 'evergreen-card';
      case 'til':
        return 'til-card';
      case 'bookshelf':
        return 'bookshelf-card';
      case 'story':
        return 'stories-card';
      case 'poem':
        return 'poems-card';
      default:
        return 'default-card';
    }
  }
  
  // Use provided content type
  switch (type) {
    case 'evergreen':
      return 'evergreen-card';
    case 'til':
      return 'til-card';
    case 'bookshelf':
      return 'bookshelf-card';
    case 'stories':
      return 'stories-card';
    case 'poems':
      return 'poems-card';
    default:
      return 'default-card';
  }
};

const getSpanClass = (post: any) => {
  const span = post?.data?.layout?.span;

  if (span === 6) {
    return 'grid-span-6';
  }

  if (span === 12) {
    return 'grid-span-12';
  }

  if (span === 3) {
    return 'grid-span-3';
  }

  return 'grid-span-4';
};
---

{renderedPosts.map((post) => (
    <div
        class={`garden-card ${getSpanClass(post)} ${getContentTypeClasses(contentType, post.data.category)}`}
        data-garden-card
    >
        <Card {...post.data}>
            {post.renderedContent && (
                <div class="prose dark:prose-dark max-w-none">
                    <div set:html={post.renderedContent} />
                </div>
            )}
        </Card>
    </div>
))}


<style>
  :global([data-garden-grid]) {
    --garden-row-height: 10px;
    --grid-column-gap: clamp(0.75rem, 2.5vw, 1.5rem);
    --grid-row-gap: clamp(1rem, 3vw, 1.75rem);
  }

  .garden-card {
    position: relative;
    min-width: 0;
    grid-row: span var(--garden-row-span, 1);
  }

  .garden-card :global(.card) {
    height: 100%;
  }

  .garden-card :global(.card--no-image:hover),
  .garden-card :global(.card--no-image:focus-within) {
    box-shadow: 0 20px 46px -28px rgba(129, 140, 248, 0.35);
  }

  /* Content type specific styling */
  .evergreen-card {
    --card-accent: #10b981; /* emerald */
  }

  .til-card {
    --card-accent: #3b82f6; /* blue */
  }

  .bookshelf-card {
    --card-accent: #f59e0b; /* amber */
  }

  .stories-card {
    --card-accent: #8b5cf6; /* purple */
  }

  .poems-card {
    --card-accent: #ec4899; /* pink */
  }

  /* Apply accent colors to cards */
  .garden-card :global(.card:hover) {
    border-color: var(--card-accent, #a78bfa);
  }

  .garden-card :global(.prose a) {
    color: rgb(var(--color-text-primary));
    text-decoration: underline;
    text-decoration-color: rgba(var(--color-text-primary), 0.35);
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .garden-card :global(.prose a:hover),
  .garden-card :global(.prose a:focus-visible) {
    color: rgb(var(--color-text-primary));
    text-decoration-color: rgba(var(--color-text-primary), 0.6);
  }

  :global(.dark) .garden-card :global(.prose a) {
    color: rgb(var(--color-text-primary));
    text-decoration-color: rgba(var(--color-text-primary), 0.35);
  }

  :global(.dark) .garden-card :global(.prose a:hover),
  :global(.dark) .garden-card :global(.prose a:focus-visible) {
    color: rgb(var(--color-text-primary));
    text-decoration-color: rgba(var(--color-text-primary), 0.6);
  }
</style>

<script type="module" is:inline>
  const initGardenMasonry = () => {
    const cards = Array.from(document.querySelectorAll('[data-garden-card]'));
    if (!cards.length) {
      return;
    }

    const grids = new Map();

    cards.forEach((card) => {
      const grid = card.closest('[data-garden-grid]');
      if (!grid) {
        return;
      }

      if (!grids.has(grid)) {
        grids.set(grid, []);
      }

      const list = grids.get(grid);
      if (list) {
        list.push(card);
      }
    });

    grids.forEach((gridCards, grid) => {
      grid.dataset.gardenGridReady = 'true';

      const computeMetrics = () => {
        const styles = window.getComputedStyle(grid);
        const rowHeight = parseFloat(styles.getPropertyValue('--garden-row-height')) || 10;
        const rowGapValue = styles.rowGap || styles.getPropertyValue('row-gap');
        const rowGap = rowGapValue ? parseFloat(rowGapValue) : 0;
        return { rowHeight, rowGap };
      };

      const updateCard = (card, metrics) => {
        const inner = card.querySelector('[data-card-root]');
        if (!inner) {
          return;
        }

        const { rowGap, rowHeight } = metrics;
        const height = inner.offsetHeight;
        const span = Math.max(1, Math.ceil((height + rowGap) / (rowHeight + rowGap)));
        card.style.setProperty('--garden-row-span', String(span));
      };

      const updateAll = () => {
        const metrics = computeMetrics();
        gridCards.forEach((card) => updateCard(card, metrics));
      };

      if ('ResizeObserver' in window) {
        const resizeObserver = new ResizeObserver(() => updateAll());

        gridCards.forEach((card) => {
          const inner = card.querySelector('[data-card-root]');
          if (inner) {
            resizeObserver.observe(inner);
          }
        });
      }

      updateAll();

      let resizeFrame;
      window.addEventListener('resize', () => {
        if (resizeFrame) {
          cancelAnimationFrame(resizeFrame);
        }

        resizeFrame = requestAnimationFrame(() => {
          updateAll();
        });
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGardenMasonry, { once: true });
  } else {
    initGardenMasonry();
  }
</script>
