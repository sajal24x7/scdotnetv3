---
import Card from '../Card.astro';
import BookshelfCard from '../bookshelf/BookshelfCard.astro';
import { parseMarkdown } from '../../utils/markdown';

interface Props {
  posts: any[];
  contentType?: 'evergreen' | 'til' | 'bookshelf' | 'stories' | 'poems' | 'mixed';
}

const { posts, contentType = 'mixed' } = Astro.props;

// Pre-render markdown content
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? parseMarkdown(post.body) : null
}));

// Content type specific styling classes
const getContentTypeClasses = (type: string, category?: string) => {
  // If mixed content type, determine from individual post category
  if (type === 'mixed' && category) {
    switch (category) {
      case 'evergreen':
        return 'evergreen-card';
      case 'til':
        return 'til-card';
      case 'bookshelf':
        return 'bookshelf-card';
      case 'story':
        return 'stories-card';
      case 'poem':
        return 'poems-card';
      default:
        return 'default-card';
    }
  }
  
  // Use provided content type
  switch (type) {
    case 'evergreen':
      return 'evergreen-card';
    case 'til':
      return 'til-card';
    case 'bookshelf':
      return 'bookshelf-card';
    case 'stories':
      return 'stories-card';
    case 'poems':
      return 'poems-card';
    default:
      return 'default-card';
  }
};

const getSpanClass = (post: any) => {
  const span = post?.data?.layout?.span;

  if (span === 6) {
    return 'grid-span-6';
  }

  if (span === 12) {
    return 'grid-span-12';
  }

  if (span === 3) {
    return 'grid-span-3';
  }

  return 'grid-span-4';
};
---

{renderedPosts.map((post) => {
    const isBookshelf = post.data.category === 'bookshelf';

    return (
        <div
            class={`garden-card ${getSpanClass(post)} ${getContentTypeClasses(contentType, post.data.category)}`}
            data-garden-card
        >
            {isBookshelf ? (
                <BookshelfCard
                    title={post.data.title}
                    author={post.data.author}
                    series={post.data.series}
                    startedReading={post.data.startedReading}
                    finishedReading={post.data.finishedReading}
                    bookStatus={post.data.bookStatus}
                    readingProgress={post.data.readingProgress}
                    bookRating={post.data.bookRating}
                    bookCover={post.data.bookCover}
                    link={post.data.link}
                    format={post.data.format}
                    pubDate={post.data.pubDate}
                />
            ) : (
                <Card {...post.data}>
                    {post.renderedContent && (
                        <div class="prose dark:prose-dark max-w-none">
                            <div set:html={post.renderedContent} />
                        </div>
                    )}
                </Card>
            )}
        </div>
    );
})}


<style>
  :global([data-garden-grid]) {
    --grid-column-gap: clamp(0.75rem, 2.5vw, 1.5rem);
    --grid-row-gap: clamp(1rem, 3vw, 1.75rem);
    position: relative;
    width: 100%;
  }

  .garden-card {
    position: absolute;
    display: flex;
    min-width: 0;
    box-sizing: border-box;
  }

  .garden-card :global(.card),
  .garden-card :global(.book-card) {
    height: 100%;
  }

  .garden-card :global(.card--no-image:hover),
  .garden-card :global(.card--no-image:focus-within) {
    box-shadow: 0 20px 46px -28px rgba(129, 140, 248, 0.35);
  }

  /* Content type specific styling */
  .evergreen-card {
    --card-accent: #10b981; /* emerald */
  }

  .til-card {
    --card-accent: #3b82f6; /* blue */
  }

  .bookshelf-card {
    --card-accent: #f59e0b; /* amber */
  }

  .stories-card {
    --card-accent: #8b5cf6; /* purple */
  }

  .poems-card {
    --card-accent: #ec4899; /* pink */
  }

  /* Apply accent colors to cards */
  .garden-card :global(.card:hover) {
    border-color: var(--card-accent, #a78bfa);
  }

  .garden-card :global(.prose a) {
    color: rgb(var(--color-text-primary));
    text-decoration: underline;
    text-decoration-color: rgba(var(--color-text-primary), 0.35);
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .garden-card :global(.prose a:hover),
  .garden-card :global(.prose a:focus-visible) {
    color: rgb(var(--color-text-primary));
    text-decoration-color: rgba(var(--color-text-primary), 0.6);
  }

  :global(.dark) .garden-card :global(.prose a) {
    color: rgb(var(--color-text-primary));
    text-decoration-color: rgba(var(--color-text-primary), 0.35);
  }

  :global(.dark) .garden-card :global(.prose a:hover),
  :global(.dark) .garden-card :global(.prose a:focus-visible) {
    color: rgb(var(--color-text-primary));
    text-decoration-color: rgba(var(--color-text-primary), 0.6);
  }
</style>

<script>
  function initMasonryGrid() {
    const grids = document.querySelectorAll('[data-garden-grid]');

    grids.forEach(grid => {
      const layoutMasonry = () => {
        const cards = Array.from(grid.querySelectorAll('[data-garden-card]'));
        if (!cards.length) return;

        // Get computed gap values
        const style = getComputedStyle(grid);
        const columnGap = parseFloat(style.getPropertyValue('--grid-column-gap')) || 16;
        const rowGap = parseFloat(style.getPropertyValue('--grid-row-gap')) || 24;

        // Determine number of columns based on viewport
        const viewportWidth = window.innerWidth;
        let columns = 1;
        if (viewportWidth >= 1408) columns = 4; // 88rem
        else if (viewportWidth >= 1024) columns = 3; // 64rem
        else if (viewportWidth >= 640) columns = 2; // 40rem

        // Calculate column width
        const gridWidth = grid.offsetWidth;
        const columnWidth = (gridWidth - (columns - 1) * columnGap) / columns;

        // Track column heights
        const columnHeights = new Array(columns).fill(0);

        // Position each card in row-by-row order
        cards.forEach((card, index) => {
          // Determine column based on index (maintains left-to-right order)
          const column = index % columns;

          // Calculate position
          const x = column * (columnWidth + columnGap);
          const y = columnHeights[column];

          // Apply position and width
          card.style.left = `${x}px`;
          card.style.top = `${y}px`;
          card.style.width = `${columnWidth}px`;

          // Update column height
          const cardHeight = card.offsetHeight;
          columnHeights[column] += cardHeight + rowGap;
        });

        // Set container height
        const maxHeight = Math.max(...columnHeights) - rowGap;
        grid.style.height = `${maxHeight}px`;
      };

      // Layout on load
      layoutMasonry();

      // Re-layout on resize with debounce
      let resizeTimeout: ReturnType<typeof setTimeout>;
      const debouncedLayout = () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(layoutMasonry, 150);
      };

      window.addEventListener('resize', debouncedLayout);

      // Re-layout when images load
      const images = grid.querySelectorAll('img');
      images.forEach(img => {
        if (img.complete) return;
        img.addEventListener('load', layoutMasonry);
      });
    });
  }

  // Initialize on DOMContentLoaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMasonryGrid);
  } else {
    initMasonryGrid();
  }
</script>
