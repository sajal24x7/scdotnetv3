---
import Card from '../Card.astro';
import { marked } from 'marked';
import LinkHoverEffect from '../LinkHoverEffect.astro';

interface Props {
  posts: any[];
  contentType?: 'evergreen' | 'til' | 'bookshelf' | 'stories' | 'poems' | 'mixed';
}

const { posts, contentType = 'mixed' } = Astro.props;

// Configure marked options
marked.setOptions({
  gfm: true, // GitHub Flavored Markdown
  breaks: true // Convert line breaks to <br>
});

// Pre-render markdown content
const renderedPosts = posts.map(post => ({
  ...post,
  renderedContent: post.body ? marked.parse(post.body) : null
}));

// Content type specific styling classes
const getContentTypeClasses = (type: string, category?: string) => {
  // If mixed content type, determine from individual post category
  if (type === 'mixed' && category) {
    switch (category) {
      case 'evergreen':
        return 'evergreen-card';
      case 'til':
        return 'til-card';
      case 'bookshelf':
        return 'bookshelf-card';
      case 'story':
        return 'stories-card';
      case 'poem':
        return 'poems-card';
      default:
        return 'default-card';
    }
  }
  
  // Use provided content type
  switch (type) {
    case 'evergreen':
      return 'evergreen-card';
    case 'til':
      return 'til-card';
    case 'bookshelf':
      return 'bookshelf-card';
    case 'stories':
      return 'stories-card';
    case 'poems':
      return 'poems-card';
    default:
      return 'default-card';
  }
};
---

<div class="garden-grid">
  {renderedPosts.map((post) => (
    <div class={`garden-card-wrapper ${getContentTypeClasses(contentType, post.data.category)}`}>
      <Card {...post.data} tags={post.data.tags}>
        {post.renderedContent && (
          <div class="prose dark:prose-dark max-w-none">
            <div set:html={post.renderedContent} />
          </div>
        )}
      </Card>
    </div>
  ))}
</div>

<LinkHoverEffect />

<style>
  .garden-grid {
    display: grid;
    /* Mobile: 2 columns */
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0;
  }

  /* Tablet: 3 columns */
  @media (min-width: 768px) {
    .garden-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  /* Desktop: 4 columns */
  @media (min-width: 1024px) {
    .garden-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  /* Extra large screens: still 4 columns but with more gap */
  @media (min-width: 1280px) {
    .garden-grid {
      gap: 2rem;
    }
  }

  .garden-card-wrapper {
    display: flex;
    flex-direction: column;
  }

  /* Content type specific styling */
  .evergreen-card {
    --card-accent: #10b981; /* emerald */
  }

  .til-card {
    --card-accent: #3b82f6; /* blue */
  }

  .bookshelf-card {
    --card-accent: #f59e0b; /* amber */
  }

  .stories-card {
    --card-accent: #8b5cf6; /* purple */
  }

  .poems-card {
    --card-accent: #ec4899; /* pink */
  }

  /* Apply accent colors to cards */
  .garden-card-wrapper :global(.card:hover) {
    border-color: var(--card-accent, #a78bfa);
  }

  .garden-card-wrapper :global(.card-category) {
    background-color: color-mix(in srgb, var(--card-accent, #3b82f6) 10%, transparent);
    border-color: color-mix(in srgb, var(--card-accent, #3b82f6) 30%, transparent);
    color: var(--card-accent, #3b82f6);
  }

  :global(.dark) .garden-card-wrapper :global(.card-category) {
    background-color: color-mix(in srgb, var(--card-accent, #60a5fa) 20%, transparent);
    border-color: color-mix(in srgb, var(--card-accent, #60a5fa) 40%, transparent);
    color: color-mix(in srgb, var(--card-accent, #60a5fa) 90%, white);
  }

  /* Mobile adjustments */
  @media (max-width: 767px) {
    .garden-grid {
      padding: 0 0.5rem;
      gap: 0.75rem;
    }
  }

  /* Ensure proper prose styling */
  :global(.prose a) {
    color: #3b82f6;
    text-decoration: none;
    transition: color 0.2s;
  }

  :global(.prose a:hover) {
    color: #2563eb;
    text-decoration: underline;
  }

  :global(.dark .prose a) {
    color: #60a5fa;
  }

  :global(.dark .prose a:hover) {
    color: #93c5fd;
  }
</style>
