---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import manifest from '../../data/nordletter-image-manifest.json';
import HomeScrollRow from './HomeScrollRow.astro';

const { posts } = Astro.props;

const imageModules = import.meta.glob(
    '../../images/nordletter/*.{jpg,jpeg,png,webp,avif}',
    { eager: true }
) as Record<string, { default: ImageMetadata }>;

const imagesByFileName = Object.fromEntries(
    Object.entries(imageModules).map(([key, module]) => [
        key.split('/').pop() ?? key,
        module.default,
    ])
);

const manifestMap = manifest as Record<string, string>;

const getLocalImage = (post: (typeof posts)[number]) => {
    const slug = post?.id;
    if (!slug) return undefined;
    const fileName = manifestMap[slug];
    if (!fileName) return undefined;
    return imagesByFileName[fileName];
};

const resolvedPosts = posts.map((post: (typeof posts)[number]) => ({
    ...post,
    localImage: getLocalImage(post),
}));
---

<HomeScrollRow title="Nordletter" ctaText="Browse all issues" ctaHref="/nordletter/">
    {resolvedPosts.map((post: (typeof resolvedPosts)[number]) => (
        <article class="nl-card">
            <a href={post.data.link} class="nl-card__link">
                <div class="nl-card__image">
                    {post.localImage ? (
                        <Image
                            src={post.localImage}
                            alt={post.data.title ?? ''}
                            width={160}
                            height={160}
                            loading="lazy"
                            decoding="async"
                            class="nl-card__img"
                        />
                    ) : post.data.image ? (
                        <img
                            src={post.data.image}
                            alt={post.data.title ?? ''}
                            width={160}
                            height={160}
                            loading="lazy"
                            decoding="async"
                            class="nl-card__img"
                        />
                    ) : (
                        <div class="nl-card__placeholder" aria-hidden="true">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                <path d="M8 21h8M12 17v4"/>
                            </svg>
                        </div>
                    )}
                </div>
                <div class="nl-card__content">
                    {post.data.editionDisplay && (
                        <span class="nl-card__edition">{post.data.editionDisplay}</span>
                    )}
                    <h3 class="nl-card__title">{post.data.title}</h3>
                </div>
            </a>
        </article>
    ))}
</HomeScrollRow>

<style>
    .nl-card {
        width: 11rem;
        flex-shrink: 0;
        scroll-snap-align: start;
    }

    .nl-card__link {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: inherit;
        padding: 0.25rem;
        border-radius: 0.75rem;
        transition: transform 0.2s ease;
    }

    .nl-card__link:hover {
        transform: translateY(-2px);
    }

    .nl-card__image {
        width: 5.5rem;
        height: 5.5rem;
        border-radius: 9999px;
        overflow: hidden;
        background: rgba(0, 0, 0, 0.06);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    :global(.dark) .nl-card__image {
        background: rgba(255, 255, 255, 0.08);
    }

    .nl-card__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .nl-card__link:hover .nl-card__img {
        transform: scale(1.06);
    }

    .nl-card__placeholder {
        color: rgba(0, 0, 0, 0.3);
    }

    :global(.dark) .nl-card__placeholder {
        color: rgba(255, 255, 255, 0.3);
    }

    .nl-card__content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        text-align: center;
    }

    .nl-card__edition {
        font-size: 0.7rem;
        font-weight: 400;
        color: rgb(var(--color-text-secondary));
        opacity: 0.75;
    }

    .nl-card__title {
        font-size: 0.875rem;
        font-weight: 600;
        line-height: 1.4;
        margin: 0;
        color: rgb(var(--color-text-primary));
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .nl-card__link:hover .nl-card__title {
        text-decoration: underline;
        text-underline-offset: 2px;
    }
</style>
