---
import PageHeader from './PageHeader.astro';

export interface ProgressLayoutStat {
    label: string;
    value: string;
}

export interface ProgressLayoutQuickLink {
    href: string;
    label: string;
    description: string;
}

interface Props {
    pageTitle: string;
    pageDescription: string;
    hasItems: boolean;
    stats?: ProgressLayoutStat[];
    summaryTitle?: string;
    quickLinks?: ProgressLayoutQuickLink[];
}

const {
    pageTitle,
    pageDescription,
    hasItems,
    stats = [],
    summaryTitle = 'Summary',
    quickLinks = []
} = Astro.props as Props;

const shouldShowSidebar = stats.length > 0 || quickLinks.length > 0;
---
<section class="progress-page__layout">
    <header class="progress-page__header grid-span-full">
        <PageHeader
            title={pageTitle}
            description={pageDescription}
            layout="centered"
            size="lg"
            maxWidth="7xl"
        />
    </header>

    <section class="progress-page__content grid-span-8 grid-start-1">
        {Astro.slots.has('intro') && <slot name="intro" />}

        {hasItems ? (
            <div class="progress-page__list">
                <slot />
            </div>
        ) : (
            <slot name="empty" />
        )}
    </section>

    {shouldShowSidebar && (
        <aside class="progress-page__sidebar grid-span-4 grid-start-9">
            {stats.length > 0 && (
                <div class="progress-sidebar-card">
                    <h2 class="progress-sidebar-card__title">{summaryTitle}</h2>
                    <dl class="progress-sidebar-card__stats">
                        {stats.map(stat => (
                            <div>
                                <dt>{stat.label}</dt>
                                <dd>{stat.value}</dd>
                            </div>
                        ))}
                    </dl>
                </div>
            )}

            {quickLinks.length > 0 && (
                <div class="progress-sidebar-card">
                    <h2 class="progress-sidebar-card__title">Quick links</h2>
                    <ul class="progress-sidebar-card__links">
                        {quickLinks.map(link => (
                            <li>
                                <a class="progress-sidebar-card__link" href={link.href}>
                                    <span class="progress-sidebar-card__link-label">{link.label}</span>
                                    <span class="progress-sidebar-card__link-description">{link.description}</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            )}
        </aside>
    )}
</section>

<style>
    .progress-page__layout {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        column-gap: clamp(1.5rem, 4vw, 2.5rem);
        row-gap: clamp(2rem, 6vw, 3rem);
        padding-block: clamp(2rem, 5vw, 3.5rem);
    }

    .progress-page__content {
        display: flex;
        flex-direction: column;
        gap: clamp(1.5rem, 4vw, 2.5rem);
    }

    .progress-page__list {
        display: flex;
        flex-direction: column;
        gap: clamp(1.25rem, 4vw, 2rem);
    }

    .progress-page__sidebar {
        display: flex;
        flex-direction: column;
        gap: clamp(1.5rem, 4vw, 2.25rem);
    }

    .progress-sidebar-card {
        border: 1px solid rgba(var(--color-border), 0.85);
        border-radius: 0.75rem;
        padding: clamp(1rem, 3vw, 1.5rem);
        background-color: rgba(var(--color-bg-secondary), 0.55);
        display: flex;
        flex-direction: column;
        gap: clamp(1rem, 3vw, 1.5rem);
    }

    :global(.dark) .progress-sidebar-card {
        border-color: rgba(var(--color-border), 0.6);
        background-color: rgba(var(--color-bg-secondary), 0.45);
    }

    .progress-sidebar-card__title {
        font-size: 1rem;
        font-weight: 600;
    }

    .progress-sidebar-card__stats {
        display: grid;
        gap: clamp(0.75rem, 3vw, 1.25rem);
    }

    .progress-sidebar-card__links {
        display: flex;
        flex-direction: column;
        gap: clamp(0.75rem, 3vw, 1.25rem);
    }

    .progress-sidebar-card__link {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        font-weight: 500;
    }

    .progress-sidebar-card__link-label {
        font-size: 0.9375rem;
    }

    .progress-sidebar-card__link-description {
        font-size: 0.8125rem;
        color: rgba(var(--color-text-secondary), 0.85);
    }

    @media (min-width: 48rem) {
        .progress-page__layout {
            grid-template-columns: repeat(12, minmax(0, 1fr));
        }

        .progress-page__sidebar {
            position: sticky;
            top: clamp(1.5rem, 4vw, 3rem);
            align-self: start;
        }
    }
</style>
