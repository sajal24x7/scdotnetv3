---
import type { FeedEntry } from '../../utils/feed';

interface Props {
    entries: FeedEntry[];
    hasMore: boolean;
}

const { entries, hasMore } = Astro.props as Props;

// Group server-rendered entries under month headers
let lastMonth = '';
const rows = entries.map((entry) => {
    const showMonth = entry.month !== lastMonth;
    lastMonth = entry.month;
    return { ...entry, showMonth };
});
---

<div class="unified-feed" data-unified-feed data-has-more={hasMore ? 'true' : 'false'}>
    <header class="unified-feed__head">
        <h2 class="unified-feed__title">Lately</h2>
        <p class="unified-feed__subtitle">
            Everything, as it happens — from the garden, the stream, and the Nordletter.
        </p>
    </header>

    <div class="unified-feed__filters" role="group" aria-label="Filter the feed">
        <button type="button" class="tag-chip tag-chip-active" data-feed-filter="all" aria-pressed="true">Everything</button>
        <button type="button" class="tag-chip" data-feed-filter="stream" aria-pressed="false">Stream</button>
        <button type="button" class="tag-chip" data-feed-filter="garden" aria-pressed="false">Garden</button>
        <button type="button" class="tag-chip" data-feed-filter="nordletter" aria-pressed="false">Nordletter</button>
    </div>

    <div class="unified-feed__list" data-feed-list>
        {rows.map((row) => (
            <>
                {row.showMonth && <div class="unified-feed__month">{row.month}</div>}
                <article class="feed-entry" data-month={row.month} set:html={row.html} />
            </>
        ))}
    </div>

    <div class="unified-feed__foot">
        <button type="button" class="unified-feed__more" data-feed-more hidden={!hasMore}>
            Load 10 more
        </button>
        <p class="unified-feed__end" data-feed-end hidden={hasMore}>
            That's everything — you've reached the very beginning.
        </p>
        <p class="sr-only" role="status" aria-live="polite" data-feed-status></p>
    </div>
</div>

<style is:global>
    .unified-feed {
        width: 100%;
    }

    .unified-feed__head {
        margin-bottom: 1.5rem;
    }

    .unified-feed__title {
        font-size: var(--text-xlarge);
        font-weight: 700;
        margin: 0 0 0.35rem;
        color: rgb(var(--color-text-primary));
    }

    .unified-feed__subtitle {
        margin: 0;
        font-size: var(--text-small);
        color: rgb(var(--color-text-secondary));
    }

    .unified-feed__filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 2.5rem;
    }

    /* ---- timeline spine ---- */
    .unified-feed__list {
        position: relative;
    }

    .unified-feed__list::before {
        content: '';
        position: absolute;
        left: 0.32rem;
        top: 0.4rem;
        bottom: 0;
        width: 2px;
        border-radius: 2px;
        background: rgba(var(--color-text-primary), 0.12);
    }

    .unified-feed__month {
        position: relative;
        padding-left: 2rem;
        margin: 2.5rem 0 1.5rem;
        font-size: var(--text-xs);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: rgb(var(--color-text-secondary));
    }

    .unified-feed__month::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 50%;
        background: rgb(var(--color-bg));
        border: 2px solid rgba(var(--color-text-primary), 0.35);
    }

    .unified-feed__list > .unified-feed__month:first-child {
        margin-top: 0;
    }

    /* ---- entries ---- */
    .feed-entry {
        position: relative;
        padding-left: 2rem;
        margin-bottom: 2.1rem;
    }

    /* hairline divider between consecutive entries (skipped before month headers) */
    .feed-entry:has(+ .feed-entry) {
        padding-bottom: 1.25rem;
        margin-bottom: 1.25rem;
    }

    .feed-entry:has(+ .feed-entry)::after {
        content: '';
        position: absolute;
        left: 2rem;
        right: 0;
        bottom: 0;
        height: 1px;
        background: rgba(var(--color-text-primary), 0.08);
    }

    .feed-entry::before {
        content: '';
        position: absolute;
        left: 0.11rem;
        top: 0.42rem;
        width: 0.44rem;
        height: 0.44rem;
        border-radius: 50%;
        background: rgba(var(--color-text-primary), 0.4);
    }

    .feed-entry__meta {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: var(--text-xs);
        margin-bottom: 0.5rem;
    }

    /* date pill inherits .card-chip styling from global.css; keep digits aligned */
    .feed-entry__date {
        font-variant-numeric: tabular-nums;
    }

    a.feed-entry__date:focus-visible {
        outline: 2px solid rgb(var(--color-accent));
        outline-offset: 2px;
    }

    .feed-entry__title {
        font-size: 1.15rem;
        font-weight: 600;
        margin: 0 0 0.3rem;
        line-height: 1.35;
        text-wrap: balance;
        color: rgb(var(--color-text-primary));
    }

    .feed-entry__title a {
        color: inherit;
        text-decoration: none;
    }

    .feed-entry__title a:hover,
    .feed-entry__title a:focus-visible {
        color: rgb(var(--color-accent));
    }

    /* one reading size for all entry text, matching the site's body size token */
    .feed-entry {
        --feed-text-size: var(--text-normal);
    }

    .feed-entry__excerpt {
        margin: 0;
        font-size: var(--feed-text-size);
        color: rgba(var(--color-text-primary), 0.65);
    }

    .feed-entry__verse {
        font-family: 'Fraunces Variable', 'Fraunces', ui-serif, Georgia, serif;
        font-style: italic;
        font-size: var(--feed-text-size);
        color: rgba(var(--color-text-primary), 0.75);
        margin: 0.3rem 0 0;
        line-height: 1.6;
    }

    /* micro + photo bodies (full rendered markdown) */
    .feed-entry__body {
        font-size: var(--feed-text-size);
        max-width: none;
    }

    .feed-entry__body > :first-child {
        margin-top: 0;
    }

    .feed-entry__body > :last-child {
        margin-bottom: 0;
    }

    .feed-entry__body img {
        border-radius: 0.6rem;
        max-width: 100%;
        height: auto;
    }

    .feed-entry__body blockquote {
        border-left: 3px solid rgba(var(--tag-color-rgb), 0.45);
        padding-left: 0.9rem;
        margin-inline: 0;
        color: rgba(var(--color-text-primary), 0.65);
    }

    /* photo carousel (multi-image photo posts) */
    .feed-carousel {
        position: relative;
        margin: 0;
        border-radius: 0.6rem;
        overflow: hidden;
        background: rgba(var(--color-text-primary), 0.03);
    }

    .feed-carousel__track {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
    }

    .feed-carousel__track::-webkit-scrollbar {
        display: none;
    }

    .feed-carousel__track:focus-visible {
        outline: 2px solid rgb(var(--color-accent));
        outline-offset: -2px;
    }

    .feed-carousel__slide {
        flex: 0 0 100%;
        margin: 0;
        scroll-snap-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .feed-carousel__slide img {
        max-height: min(70vh, 32rem);
        object-fit: contain;
        border-radius: 0;
    }

    .feed-carousel__arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border: none;
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.5);
        color: #fff;
        cursor: pointer;
        opacity: 0.85;
        transition: opacity 150ms ease, background 150ms ease;
        backdrop-filter: blur(4px);
    }

    .feed-carousel__arrow svg {
        width: 1.15rem;
        height: 1.15rem;
    }

    .feed-carousel__arrow:hover {
        opacity: 1;
        background: rgba(0, 0, 0, 0.65);
    }

    .feed-carousel__arrow[disabled] {
        opacity: 0.25;
        cursor: default;
    }

    .feed-carousel__arrow--prev {
        left: 0.6rem;
    }

    .feed-carousel__arrow--next {
        right: 0.6rem;
    }

    .feed-carousel__dots {
        position: absolute;
        bottom: 0.6rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 0.35rem;
        padding: 0.25rem 0.5rem;
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
    }

    .feed-carousel__dot {
        width: 0.35rem;
        height: 0.35rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.5);
        transition: background 150ms ease, transform 150ms ease;
    }

    .feed-carousel__dot--active {
        background: #fff;
        transform: scale(1.2);
    }

    @media (prefers-reduced-motion: reduce) {
        .feed-carousel__track {
            scroll-behavior: auto;
        }
    }

    /* bookshelf row */
    .feed-entry__book {
        display: flex;
        gap: 0.9rem;
        align-items: flex-start;
    }

    .feed-entry__book-cover {
        width: 4.5rem;
        height: 6.6rem;
        flex: none;
        border-radius: 0.35rem;
        object-fit: cover;
        box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.18);
    }

    .feed-entry__book-cover--placeholder {
        background: rgba(var(--color-text-primary), 0.12);
    }

    .feed-entry__book-note {
        margin: 0.15rem 0 0;
        font-size: var(--feed-text-size);
        color: rgb(var(--color-text-secondary));
    }

    /* nordletter card */
    .feed-entry__nl-card {
        border: 1px solid rgb(var(--color-border));
        background: rgb(var(--color-bg-secondary));
        border-radius: 0.9rem;
        overflow: hidden;
        transition: border-color 0.2s ease;
    }

    .feed-entry__nl-card:hover {
        border-color: rgba(var(--color-text-primary), 0.3);
    }

    .feed-entry__nl-img {
        display: block;
        width: 100%;
        height: 9.5rem;
        object-fit: cover;
    }

    .feed-entry__nl-body {
        padding: 1rem 1.15rem 1.15rem;
    }

    .feed-entry__nl-badge {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 700;
        color: rgba(var(--color-text-primary), 0.75);
        border: 1px solid rgba(var(--color-text-primary), 0.3);
        border-radius: 0.35rem;
        padding: 0.08rem 0.45rem;
        margin-bottom: 0.5rem;
    }

    .feed-entry__nl-body .feed-entry__title {
        margin-bottom: 0.25rem;
    }


    /* ---- footer ---- */
    .unified-feed__foot {
        margin-top: 3rem;
        padding-left: 2rem;
    }

    .unified-feed__more {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font: inherit;
        font-weight: 600;
        font-size: var(--text-small);
        color: rgb(var(--color-text-primary));
        background: none;
        border: none;
        border-bottom: 1px solid rgba(var(--color-text-primary), 0.2);
        padding: 0 0 0.15rem;
        cursor: pointer;
        transition: border-color 0.2s ease;
    }

    .unified-feed__more::after {
        content: '↓';
        font-size: 0.95em;
        transition: transform 0.2s ease;
    }

    .unified-feed__more:hover,
    .unified-feed__more:focus-visible {
        border-bottom-color: rgba(var(--color-text-primary), 0.45);
    }

    .unified-feed__more:hover::after,
    .unified-feed__more:focus-visible::after {
        transform: translateY(0.15rem);
    }

    .unified-feed__more:focus-visible {
        outline: 2px solid rgb(var(--color-accent));
        outline-offset: 2px;
    }

    .unified-feed__more[disabled] {
        opacity: 0.6;
        cursor: wait;
    }

    .unified-feed__end {
        margin: 0;
        font-size: var(--text-small);
        color: rgb(var(--color-text-secondary));
    }

    [hidden] {
        display: none !important;
    }

    @media (prefers-reduced-motion: reduce) {
        .unified-feed__more::after {
            transition: none;
        }
    }
</style>

<script>
    // Feed entries timestamp themselves with the same <relative-time> element
    // as the stream page, so the labels tick client-side instead of freezing
    // at build time.
    import '../../scripts/relativeTime';

    interface FeedEntryData {
        html: string;
        group: string;
        month: string;
    }

    interface GroupState {
        entries: FeedEntryData[];
        page: number;
        hasMore: boolean;
    }

    function initFeedCarousels(container: ParentNode): void {
        container.querySelectorAll<HTMLElement>('[data-feed-carousel]').forEach((carousel) => {
            if (carousel.dataset.carouselReady) return;
            carousel.dataset.carouselReady = 'true';

            const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
            const prev = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
            const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
            const dots = Array.from(carousel.querySelectorAll<HTMLElement>('.feed-carousel__dot'));
            if (!track) return;

            const slideCount = track.children.length;
            const currentIndex = () =>
                Math.min(slideCount - 1, Math.max(0, Math.round(track.scrollLeft / track.clientWidth)));

            const goTo = (index: number) => {
                const clamped = Math.min(slideCount - 1, Math.max(0, index));
                const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                track.scrollTo({
                    left: clamped * track.clientWidth,
                    behavior: reduceMotion ? 'auto' : 'smooth'
                });
            };

            const update = () => {
                const index = currentIndex();
                dots.forEach((dot, i) => dot.classList.toggle('feed-carousel__dot--active', i === index));
                if (prev) prev.disabled = index === 0;
                if (next) next.disabled = index === slideCount - 1;
            };

            prev?.addEventListener('click', () => goTo(currentIndex() - 1));
            next?.addEventListener('click', () => goTo(currentIndex() + 1));
            track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
            track.addEventListener('keydown', (event) => {
                if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(currentIndex() - 1); }
                if (event.key === 'ArrowRight') { event.preventDefault(); goTo(currentIndex() + 1); }
            });

            update();
        });
    }

    const root = document.querySelector<HTMLElement>('[data-unified-feed]');

    if (root) {
        const list = root.querySelector<HTMLElement>('[data-feed-list]')!;
        const moreBtn = root.querySelector<HTMLButtonElement>('[data-feed-more]')!;
        const moreBtnDefaultLabel = moreBtn.textContent;
        const endNote = root.querySelector<HTMLElement>('[data-feed-end]')!;
        const statusNote = root.querySelector<HTMLElement>('[data-feed-status]')!;
        const filterBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-feed-filter]'));

        // Seed the "all" group from the server-rendered page 1
        const seeded: FeedEntryData[] = Array.from(list.querySelectorAll<HTMLElement>('.feed-entry')).map(
            (el) => ({
                html: el.innerHTML,
                group: '',
                month: el.dataset.month || ''
            })
        );

        const state: Record<string, GroupState> = {
            all: {
                entries: seeded,
                page: 1,
                hasMore: root.dataset.hasMore === 'true'
            }
        };

        let current = 'all';
        let loading = false;

        initFeedCarousels(list);

        async function fetchPage(group: string): Promise<void> {
            const groupState = state[group];
            const response = await fetch(`/api/feed/${group}/${groupState.page + 1}.json`);
            if (!response.ok) {
                throw new Error(`Feed page request failed: ${response.status}`);
            }
            const data = await response.json();
            groupState.page += 1;
            groupState.entries.push(...data.entries);
            groupState.hasMore = data.hasMore;
        }

        function render(): void {
            const groupState = state[current];
            let lastMonth = '';
            const parts: string[] = [];

            for (const entry of groupState.entries) {
                if (entry.month !== lastMonth) {
                    parts.push(`<div class="unified-feed__month">${entry.month}</div>`);
                    lastMonth = entry.month;
                }
                parts.push(`<article class="feed-entry" data-month="${entry.month}">${entry.html}</article>`);
            }

            list.innerHTML = parts.join('');
            initFeedCarousels(list);
            moreBtn.hidden = !groupState.hasMore;
            endNote.hidden = groupState.hasMore;
        }

        async function ensureGroup(group: string): Promise<void> {
            if (!state[group]) {
                state[group] = { entries: [], page: 0, hasMore: true };
                await fetchPage(group);
            }
        }

        moreBtn.addEventListener('click', async () => {
            if (loading) return;
            loading = true;
            moreBtn.disabled = true;
            moreBtn.textContent = 'Loading…';
            try {
                const before = state[current].entries.length;
                await fetchPage(current);
                render();
                const added = state[current].entries.length - before;
                statusNote.textContent = `${added} more ${added === 1 ? 'entry' : 'entries'} loaded`;
                moreBtn.textContent = moreBtnDefaultLabel;
            } catch {
                moreBtn.textContent = 'Something went wrong — try again';
            } finally {
                moreBtn.disabled = false;
                loading = false;
            }
        });

        filterBtns.forEach((btn) =>
            btn.addEventListener('click', async () => {
                if (loading) return;
                const group = btn.dataset.feedFilter || 'all';
                if (group === current) return;
                loading = true;
                try {
                    await ensureGroup(group);
                    current = group;
                    filterBtns.forEach((b) => {
                        const active = b === btn;
                        b.classList.toggle('tag-chip-active', active);
                        b.setAttribute('aria-pressed', String(active));
                    });
                    render();
                } catch {
                    // leave the previous group visible if the fetch fails
                } finally {
                    loading = false;
                }
            })
        );
    }
</script>
