---
interface Props {
  sections: {
    title: string;
    description: string;
    link: string;
    linkText: string;
    count: number;
    countLabel: string;
    color?: string;
    icon?: string;
  }[];
}

const { sections } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 py-8">
  {sections.map((section) => (
    <div class="group border border-gray-200 dark:border-gray-700 rounded-lg p-6 hover:border-gray-300 dark:hover:border-gray-600 transition-all duration-200 hover:shadow-md">
      <div class="flex items-start justify-between mb-4">
        <div class="flex-1">
          <h3 class="text-xl font-semibold mb-2 group-hover:text-accent transition-colors">
            <a href={section.link} class="block">
              {section.title}
            </a>
          </h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
            {section.description}
          </p>
        </div>
        {section.icon && (
          <div class="ml-4 text-2xl opacity-60 group-hover:opacity-100 transition-opacity">
            {section.icon}
          </div>
        )}
      </div>
      
      <div class="flex items-center justify-between">
        <div class="text-sm text-purple-600 dark:text-purple-400 font-medium">
          {section.count} {section.count === 1 ? section.countLabel : section.countLabel}
        </div>
        <a 
          href={section.link} 
          class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors font-medium"
        >
          {section.linkText} →
        </a>
      </div>
    </div>
  ))}
</div>

<style>
  /* Hover effects */
  .group:hover {
    transform: translateY(-1px);
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .grid {
      gap: 1rem;
    }
  }

  /* Dark mode adjustments */
  :global(.dark) .group {
    background: rgba(255, 255, 255, 0.02);
  }

  :global(.dark) .group:hover {
    background: rgba(255, 255, 255, 0.05);
  }
</style> 