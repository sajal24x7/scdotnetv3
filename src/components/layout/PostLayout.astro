---
import LayoutContainer from './LayoutContainer.astro';
import TimeDisplay from '../TimeDisplay.astro';
import Tag from '../Tag.astro';
import ShareButton from '../ShareButton.astro';
import Backlinks from '../Backlinks.astro';
import SyndicationLinks from '../SyndicationLinks.astro';
import Webmentions from '../Webmentions.astro';

interface Backlink {
    slug: string;
    title: string;
    description: string;
    category: string;
    pubDate: Date;
}

interface PostEntry {
    data: Record<string, any>;
}

interface Props {
    entry: PostEntry;
    category: string;
    canonicalUrl: string;
    backlinks: Backlink[];
    hasUpdatedDate: boolean;
}

const { entry, category, canonicalUrl, backlinks, hasUpdatedDate } = Astro.props as Props;

const entryData = entry.data ?? {};

const title = entryData?.title ?? '';
const formattedCategory = category.charAt(0).toUpperCase() + category.slice(1);
const description = 'description' in entryData ? entryData.description : undefined;
const tags = 'tags' in entryData && Array.isArray(entryData.tags) ? entryData.tags : [];
const syndicationUrls = 'syndicationUrls' in entryData && Array.isArray(entryData.syndicationUrls)
    ? entryData.syndicationUrls
    : [];
const heroImage = 'image' in entryData ? entryData.image : undefined;
const edition = category === 'nordletter' && 'edition' in entryData ? entryData.edition : undefined;
const bridgyOmit = 'bridgyOmit' in entryData && entryData.bridgyOmit;
const publishedDate = entryData?.pubDate;
const updatedDate = hasUpdatedDate ? entryData.updatedDate : undefined;
const contentTypeLabels: Record<string, string> = {
    blog: 'blog post',
    micro: 'micro post',
    photos: 'photo',
    evergreen: 'evergreen note',
    bookshelf: 'bookshelf note',
    til: 'til note',
    stories: 'story',
    poems: 'poem',
    nordletter: 'newsletter'
};
const contentType = contentTypeLabels[category] ?? 'post';
const displayDate = updatedDate ?? publishedDate;
const dateClass = updatedDate ? 'dt-updated' : 'dt-published';
---

<LayoutContainer
    prose
    maxWidth="4xl"
    padding="sm"
    paddingScale="page"
    className="post-layout__container"
>
    <article class="h-entry post-layout">
        <!-- Hidden microformat data -->
        <a href={canonicalUrl} class="u-url" style="display: none;"></a>
        {bridgyOmit && (
            <a href={canonicalUrl} class="u-bridgy-omit-link" style="display: none;"></a>
        )}
        <div class="p-author h-card" style="display: none;">
            <a class="p-name u-url" href="https://sajalchoudhary.net">Sajal Choudhary</a>
            <a class="u-url" href="https://sajalchoudhary.net">https://sajalchoudhary.net</a>
        </div>

        {heroImage && (
            <figure class="post-layout__hero">
                <img
                    src={heroImage}
                    alt={title}
                    class="rounded-lg w-full object-cover max-h-96"
                    loading="lazy"
                />
            </figure>
        )}

        <header class="post-layout__header">
            <h1 class="p-name text-3xl md:text-4xl font-bold mb-4">{title}</h1>

            {category === 'nordletter' && edition && displayDate && (
                <div class="post-layout__edition">
                    <span class="post-layout__edition-chip">Letter: {edition}</span>
                    <span class="post-layout__edition-chip">
                        Posted on{' '}
                        <time class={dateClass} datetime={displayDate.toISOString()}>
                            <TimeDisplay date={displayDate} category={category} format="detailed" />
                        </time>
                    </span>
                </div>
            )}

            {description && (
                <p class="p-summary post-layout__description">
                    {description}
                </p>
            )}

            {tags.length > 0 && (
                <div class="post-layout__tags">
                    {tags.map((tag: string) => (
                        <Tag tag={tag} />
                    ))}
                </div>
            )}
        </header>

        <div class="e-content post-layout__content">
            <slot />
        </div>

        <div class="post-layout__meta">
            {syndicationUrls.length > 0 && (
                <SyndicationLinks syndicationUrls={syndicationUrls} />
            )}
            <ShareButton title={title} url={canonicalUrl} ariaLabel="Share this post" class="post-layout__share" />
        </div>

        <div class="post-layout__back-link">
            <a href={`/${category}/`} class="font-medium link-hover">← Back to {formattedCategory}</a>
        </div>

        {displayDate && (
            <p class="post-layout__update-note">
                This {contentType} last updated on{' '}
                <time class={dateClass} datetime={displayDate.toISOString()}>
                    <TimeDisplay date={displayDate} category={category} format="detailed" />
                </time>
                . Thoughts? Email{' '}
                <a href="mailto:sajal@sajalchoudhary.net" class="link-hover">sajal@sajalchoudhary.net</a>
            </p>
        )}

        <Backlinks backlinks={backlinks} />

        <Webmentions url={canonicalUrl} />
    </article>
</LayoutContainer>

<style>
    .post-layout__container {
        padding-block: 0;
    }

    @media (min-width: 48rem) {
        .post-layout__container {
            padding-inline: 0;
        }
    }

    .post-layout {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .post-layout__hero {
        margin: 0;
    }

    .post-layout__header {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .post-layout__edition {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .post-layout__edition-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 0.85rem;
        border-radius: 0.75rem;
        background-color: rgba(var(--color-border), 0.12);
        font-size: 0.875rem;
        font-weight: 500;
        color: rgb(var(--color-text-secondary));
    }

    :global(.dark) .post-layout__edition-chip {
        background-color: rgba(var(--color-border), 0.22);
        color: rgb(var(--color-text-secondary));
    }

    .post-layout__description {
        font-size: clamp(1.1rem, 2.2vw, 1.35rem);
        color: rgb(var(--color-text-secondary));
        max-width: 52ch;
    }

    .post-layout__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .post-layout__content {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .post-layout__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
    }

    .post-layout__share {
        margin-left: auto;
    }

    .post-layout__back-link {
        margin-top: -1rem;
    }

    .post-layout__update-note {
        font-size: 0.95rem;
        color: rgb(var(--color-text-secondary));
    }

</style>
