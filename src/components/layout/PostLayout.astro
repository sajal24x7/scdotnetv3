---
import LayoutContainer from './LayoutContainer.astro';
import TimeDisplay from '../TimeDisplay.astro';
import Tag from '../Tag.astro';
import ShareButton from '../ShareButton.astro';
import Backlinks from '../Backlinks.astro';
import SyndicationLinks from '../SyndicationLinks.astro';
import Webmentions from '../Webmentions.astro';
import { Image } from 'astro:assets';
import { getBookCoverImage } from '../../utils/bookCovers';
import {
    bookRatingDisplay,
    heartIconPaths,
    thumbIconPaths,
    type BookRating,
    type RatingIconSpec
} from '../../utils/bookRatings';

interface Backlink {
    slug: string;
    title: string;
    description: string;
    category: string;
    pubDate: Date;
}

interface PostEntry {
    data: Record<string, any>;
}

interface Props {
    entry: PostEntry;
    category: string;
    canonicalUrl: string;
    backlinks: Backlink[];
    hasUpdatedDate: boolean;
}

const { entry, category, canonicalUrl, backlinks, hasUpdatedDate } = Astro.props as Props;

const entryData = entry.data ?? {};

const title = entryData?.title ?? '';
const formattedCategory = category.charAt(0).toUpperCase() + category.slice(1);
const description = 'description' in entryData ? entryData.description : undefined;
const tags = 'tags' in entryData && Array.isArray(entryData.tags) ? entryData.tags : [];
const syndicationUrls = 'syndicationUrls' in entryData && Array.isArray(entryData.syndicationUrls)
    ? entryData.syndicationUrls
    : [];
const heroImage = 'image' in entryData ? entryData.image : undefined;
const edition = category === 'nordletter' && 'edition' in entryData ? entryData.edition : undefined;
const bridgyOmit = 'bridgyOmit' in entryData && entryData.bridgyOmit;
const publishedDate = entryData?.pubDate;
const updatedDate = hasUpdatedDate ? entryData.updatedDate : undefined;

// Bookshelf-specific data
const isBookshelf = category === 'bookshelf';
const bookCover = isBookshelf && 'bookCover' in entryData ? entryData.bookCover : undefined;
const author = isBookshelf && 'author' in entryData ? entryData.author : undefined;
const format = isBookshelf && 'format' in entryData ? entryData.format : undefined;
const genre = isBookshelf && 'genre' in entryData ? entryData.genre : undefined;
const bookStatus = isBookshelf && 'bookStatus' in entryData ? entryData.bookStatus : undefined;
const bookRating = isBookshelf && 'bookRating' in entryData ? entryData.bookRating : undefined;
const series = isBookshelf && 'series' in entryData ? entryData.series : undefined;
const startedReading = isBookshelf && 'startedReading' in entryData ? entryData.startedReading : undefined;
const finishedReading = isBookshelf && 'finishedReading' in entryData ? entryData.finishedReading : undefined;
const readingProgress = isBookshelf && 'readingProgress' in entryData ? entryData.readingProgress : undefined;

// Helper functions for bookshelf display
const parseDate = (value: Date | string | undefined) => {
    if (!value) return null;
    if (value instanceof Date) return Number.isNaN(value.getTime()) ? null : value;
    const parsed = new Date(value);
    return Number.isNaN(parsed.getTime()) ? null : parsed;
};

const formatYMD = (value: Date | string | undefined) => {
    const date = parseDate(value);
    if (!date) return null;
    return date.toISOString().slice(0, 10);
};

const formatAuthors = (author?: string | string[]) => {
    if (!author) return null;
    if (typeof author === 'string') return author;
    if (author.length === 0) return null;
    if (author.length === 1) return author[0];
    if (author.length === 2) return `${author[0]} and ${author[1]}`;
    return `${author.slice(0, -1).join(', ')}, and ${author[author.length - 1]}`;
};

const normalizedFormat = format ? format.toLowerCase() : null;
const formatLabelMap: Record<string, string> = {
    audio: 'AUDIOBOOK',
    audiobook: 'AUDIOBOOK',
    ebook: 'EBOOK',
    digital: 'EBOOK',
    paper: 'PAPERBACK',
    paperback: 'PAPERBACK',
    hardcover: 'HARDCOVER'
};

const formatLabel = normalizedFormat ? (formatLabelMap[normalizedFormat] ?? normalizedFormat.toUpperCase()) : null;

const genreLabel = genre ? genre.toUpperCase() : null;

const finishedDate = formatYMD(finishedReading);
const startedDate = formatYMD(startedReading);
const timelineLabel = (() => {
    if (startedDate && finishedDate) return `Read ${startedDate} - ${finishedDate}`;
    if (startedDate) return `Read ${startedDate} -`;
    if (finishedDate) return `Read - ${finishedDate}`;
    return null;
})();

const ratingDisplay = bookRating ? bookRatingDisplay[bookRating as BookRating] : null;
const ratingAriaLabel = ratingDisplay
    ? ratingDisplay.label.replace(/^Rating:\s*/i, 'Rated ')
    : 'Rating: Not set';
const ratingIconSpecs: readonly RatingIconSpec[] = ratingDisplay?.iconSpecs ?? [];

const coverImage = bookCover ? getBookCoverImage(bookCover) : null;
const formattedAuthor = formatAuthors(author);
---

<LayoutContainer
    prose
    maxWidth="4xl"
    padding="sm"
    paddingScale="page"
    className="post-layout__container"
>
    <article class="h-entry">
        <!-- Hidden microformat data -->
        <a href={canonicalUrl} class="u-url" style="display: none;"></a>
        {bridgyOmit && (
            <a href={canonicalUrl} class="u-bridgy-omit-link" style="display: none;"></a>
        )}
        <div class="p-author h-card" style="display: none;">
            <a class="p-name u-url" href="https://sajalchoudhary.net">Sajal Choudhary</a>
            <a class="u-url" href="https://sajalchoudhary.net">https://sajalchoudhary.net</a>
        </div>

        <div class="mb-8">
            {/* Hero image for all posts */}
            {heroImage && !isBookshelf && (
                <div class="mb-6">
                    <img
                        src={heroImage}
                        alt={title}
                        class="rounded-lg w-full object-cover max-h-96"
                        loading="lazy"
                    />
                </div>
            )}

            {/* Book cover for bookshelf posts */}
            {isBookshelf && coverImage && (
                <div class="mb-6 flex justify-center">
                    <Image
                        src={coverImage}
                        alt={`Cover of ${title}`}
                        width={252}
                        height={378}
                        class="book-meta-cover-image"
                        loading="lazy"
                    />
                </div>
            )}

            <div class="text-center">
                <h1 class="p-name text-3xl md:text-4xl font-bold mb-2">{title}</h1>

                {isBookshelf && formattedAuthor && (
                    <div class="book-meta-author-title">by {formattedAuthor}</div>
                )}

                {category === 'nordletter' && edition && (
                    <div class="flex justify-center items-center gap-4 mb-4">
                        <div class="inline-block bg-gray-100 dark:bg-gray-800 px-4 py-2 rounded-lg">
                            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
                                Letter: {edition}
                            </span>
                        </div>
                    </div>
                )}

                {description && (
                    <p class="p-summary text-xl text-textSecondary dark:text-textSecondaryDark mb-8">
                        {description}
                    </p>
                )}

                {tags.length > 0 && (
                    <div class="mb-8 flex justify-center">
                        <div class="flex flex-wrap gap-2 justify-center">
                            {tags.map((tag: string) => (
                                <Tag tag={tag} as="a" />
                            ))}
                        </div>
                    </div>
                )}
            </div>
        </div>

        {isBookshelf && (genreLabel || formatLabel || bookRating || timelineLabel) && (
            <div class="book-meta-section">
                <div class="book-meta-pills">
                    {genreLabel && (
                            <span class="book-meta__chip book-meta__chip--genre">
                                {genreLabel}
                            </span>
                        )}

                    {formatLabel && (
                            <span class="book-meta__chip book-meta__chip--format">
                                {formatLabel}
                            </span>
                        )}

                        {bookRating && (
                            <span
                                class={`book-meta__chip book-meta__chip--rating ${
                                    bookRating ? `book-meta__chip--rating-${bookRating}` : 'book-meta__chip--rating-none'
                                }`}
                                aria-label={ratingAriaLabel}
                            >
                                <span class="book-meta__chip-label">Rated</span>
                                {ratingIconSpecs.length > 0 && (
                                    <span
                                        class={`book-meta__rating-icons ${
                                            bookRating ? `book-meta__rating-icons--${bookRating}` : ''
                                        }`}
                                        aria-hidden="true"
                                    >
                                        {ratingIconSpecs.map((iconSpec) => (
                                            <span class="book-meta__rating-icon">
                                                <svg
                                                    width={iconSpec.size}
                                                    height={iconSpec.size}
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="1.5"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                >
                                                    {(
                                                        iconSpec.type === 'heart'
                                                            ? heartIconPaths
                                                            : thumbIconPaths[iconSpec.direction]
                                                    ).map((d) => (
                                                        <path d={d}></path>
                                                    ))}
                                                </svg>
                                            </span>
                                        ))}
                                    </span>
                                )}
                            </span>
                        )}

                    {timelineLabel && (
                        <span class="book-meta__chip book-meta__chip--timeline">
                            <span class="book-meta__chip-label">{timelineLabel}</span>
                        </span>
                    )}
                </div>
            </div>
        )}

        <div class="e-content">
            <slot />
        </div>

        <div class="mt-12 pt-8 border-t border-borderColor dark:border-borderColorDark">
            <div class="flex justify-between">
                <a href={`/${category}/`} class="post-layout__back-link">← Back to {formattedCategory}</a>

                <ShareButton title={title} url={canonicalUrl} />
            </div>
        </div>

        <div class="post-layout__meta">
            <div class="post-layout__meta-row">
                <div class="post-layout__meta-primary">
                    <div class="post-layout__meta-date">
                        <span class="post-layout__meta-date-chip card-chip">
                            <span class="post-layout__meta-date-chip-label">
                                {updatedDate ? 'UPDATED' : 'PUBLISHED'}
                            </span>
                            {updatedDate ? (
                                <TimeDisplay
                                    date={updatedDate}
                                    category={category}
                                    format="detailed"
                                    className="dt-updated post-layout__meta-date-time"
                                />
                            ) : (
                                <TimeDisplay
                                    date={publishedDate}
                                    category={category}
                                    format="detailed"
                                    className="dt-published post-layout__meta-date-time"
                                />
                            )}
                        </span>
                    </div>

                    <div class="post-layout__feedback">
                        Thoughts? Email <a href="mailto:sajal@sajalchoudhary.net" class="link-hover">sajal@sajalchoudhary.net</a>
                    </div>
                </div>

                <SyndicationLinks
                    syndicationUrls={syndicationUrls}
                    className="post-layout__meta-syndication"
                />
            </div>
        </div>

        <Backlinks backlinks={backlinks} />

        <Webmentions url={canonicalUrl} />
    </article>
</LayoutContainer>

<style>
    .post-layout__container {
        padding-block: 0;
    }

    @media (min-width: 48rem) {
        .post-layout__container {
            padding-inline: 0;
        }
    }

    .post-layout__back-link {
        font-weight: 600;
        color: inherit;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        transition: color 0.2s ease, text-decoration-color 0.2s ease;
    }

    .post-layout__back-link:hover,
    .post-layout__back-link:focus-visible {
        color: rgb(var(--color-text-primary));
        text-decoration: underline;
        text-decoration-thickness: 0.1em;
        text-underline-offset: 0.2em;
    }

    .post-layout__back-link:focus-visible {
        outline: 2px solid rgb(var(--color-accent));
        outline-offset: 2px;
    }

    .post-layout__meta {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgb(var(--color-border));
    }

    :global(.dark) .post-layout__meta {
        border-top-color: rgb(var(--color-border));
    }

    .post-layout__meta-row {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    @media (min-width: 48rem) {
        .post-layout__meta-row {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }
    }

    .post-layout__meta-primary {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    @media (min-width: 48rem) {
        .post-layout__meta-primary {
            flex-direction: row;
            align-items: center;
            gap: 1.25rem;
        }
    }

    .post-layout__meta-date {
        display: flex;
        align-items: center;
    }

    .post-layout__meta-date-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.75rem;
        color: rgb(var(--color-text-primary));
        flex-wrap: wrap;
    }

    .post-layout__meta-date-chip-label {
        display: inline-flex;
        align-items: center;
    }

    .post-layout__meta-date-time {
        display: inline-flex;
        align-items: center;
        gap: 0.15rem;
        letter-spacing: inherit;
    }

    .post-layout__meta-syndication {
        margin-top: 0;
    }

    .post-layout__feedback {
        margin-top: 0;
        font-size: 0.95rem;
        color: rgb(var(--color-text-secondary));
    }

    .post-layout__feedback a {
        font-weight: 600;
    }

    /* Bookshelf metadata section */
    .book-meta-section {
        margin-bottom: 2.5rem;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid rgb(var(--color-border));
        text-align: center;
    }

    :global(.dark) .book-meta-section {
        border-bottom-color: rgb(var(--color-border));
    }

    .book-meta-cover-image {
        width: 100%;
        max-width: 252px;
        height: auto;
        border-radius: 0.75rem;
        box-shadow:
            0 4px 6px rgba(0, 0, 0, 0.1),
            0 2px 4px rgba(0, 0, 0, 0.06);
    }

    :global(.dark) .book-meta-cover-image {
        box-shadow:
            0 4px 6px rgba(0, 0, 0, 0.3),
            0 2px 4px rgba(0, 0, 0, 0.2);
    }

    .book-meta-author-title {
        font-size: 1.125rem;
        font-weight: 500;
        color: #374151;
        margin-bottom: 1rem;
        margin-top: 0.5rem;
    }

    :global(.dark) .book-meta-author-title {
        color: #d1d5db;
    }

    .book-meta-pills {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .book-meta__chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        padding: 0.15rem 0.55rem;
        border-radius: 0.5rem;
        border: none;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .book-meta__chip--genre {
        background: #dbeafe;
        color: #1e40af;
    }

    :global(.dark) .book-meta__chip--genre {
        background: rgba(30, 64, 175, 0.3);
        color: #bfdbfe;
    }

    .book-meta__chip--format {
        background: #e5e7eb;
        color: #111827;
    }

    :global(.dark) .book-meta__chip--format {
        background: #374151;
        color: #e5e7eb;
    }

    .book-meta__chip--rating {
        background: #e5e7eb;
        color: #111827;
    }

    :global(.dark) .book-meta__chip--rating {
        background: #374151;
        color: #f9fafb;
    }

    .book-meta__chip--rating-like {
        background: #dcfce7;
        color: #166534;
    }

    :global(.dark) .book-meta__chip--rating-like {
        background: rgba(22, 101, 52, 0.35);
        color: #bbf7d0;
    }

    .book-meta__chip--rating-love {
        background: #fce7f3;
        color: #be185d;
    }

    :global(.dark) .book-meta__chip--rating-love {
        background: rgba(190, 24, 93, 0.3);
        color: #fbcfe8;
    }

    .book-meta__chip--rating-nope {
        background: #fee2e2;
        color: #b91c1c;
    }

    :global(.dark) .book-meta__chip--rating-nope {
        background: rgba(185, 28, 28, 0.3);
        color: #fecaca;
    }

    .book-meta__chip--rating-none {
        background: #e5e7eb;
        color: #111827;
    }

    :global(.dark) .book-meta__chip--rating-none {
        background: #374151;
        color: #f9fafb;
    }

    .book-meta__chip--timeline {
        justify-content: flex-start;
        background: #f3f4f6;
        color: #1f2937;
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        text-transform: none;
    }

    :global(.dark) .book-meta__chip--timeline {
        background: #1f2937;
        color: #e5e7eb;
    }

    .book-meta__chip-label {
        white-space: nowrap;
    }

    .book-meta__rating-icons {
        display: inline-flex;
        gap: 0.25rem;
        color: #111827;
    }

    :global(.dark) .book-meta__rating-icons {
        color: #f9fafb;
    }

    .book-meta__rating-icons--like {
        color: #166534;
    }

    :global(.dark) .book-meta__rating-icons--like {
        color: #bbf7d0;
    }

    .book-meta__rating-icons--love {
        color: #be185d;
    }

    :global(.dark) .book-meta__rating-icons--love {
        color: #f9a8d4;
    }

    .book-meta__rating-icons--nope {
        color: #b91c1c;
    }

    :global(.dark) .book-meta__rating-icons--nope {
        color: #fca5a5;
    }

    .book-meta__rating-icon {
        line-height: 1;
        display: inline-flex;
    }
</style>
