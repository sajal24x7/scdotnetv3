---
import LayoutContainer from './LayoutContainer.astro';
import TimeDisplay from '../TimeDisplay.astro';
import Tag from '../Tag.astro';
import ShareButton from '../ShareButton.astro';
import Backlinks from '../Backlinks.astro';
import SyndicationLinks from '../SyndicationLinks.astro';
import NewsletterSignup from '../ui/NewsletterSignup.astro';
import { Image } from 'astro:assets';
import { getBookCoverImage } from '../../utils/bookCovers';
import { getFilmCoverImage } from '../../utils/filmCovers';
import { getGameCoverImage } from '../../utils/gameCovers';
import { getTVCoverImage } from '../../utils/tvCovers';
import {
    bookRatingDisplay,
    heartIconPaths,
    thumbIconPaths,
    type BookRating,
    type RatingIconSpec
} from '../../utils/bookRatings';

interface Backlink {
    slug: string;
    title: string;
    description: string;
    category: string;
    pubDate: Date;
}

interface PostEntry {
    data: Record<string, any>;
}

interface Props {
    entry: PostEntry;
    category: string;
    canonicalUrl: string;
    backlinks: Backlink[];
    hasUpdatedDate: boolean;
}

const { entry, category, canonicalUrl, backlinks, hasUpdatedDate } = Astro.props as Props;

const entryData = entry.data ?? {};

const title = entryData?.title ?? '';
const formattedCategory = category.charAt(0).toUpperCase() + category.slice(1);
const description = 'description' in entryData ? entryData.description : undefined;
const tags = 'tags' in entryData && Array.isArray(entryData.tags) ? entryData.tags : [];
const syndicationUrls = 'syndicationUrls' in entryData && Array.isArray(entryData.syndicationUrls)
    ? entryData.syndicationUrls
    : [];
const heroImage = 'image' in entryData ? entryData.image : undefined;
const edition = category === 'nordletter' && 'edition' in entryData ? entryData.edition : undefined;
const bridgyOmit = 'bridgyOmit' in entryData && entryData.bridgyOmit;
const publishedDate = entryData?.pubDate;
const updatedDate = hasUpdatedDate ? entryData.updatedDate : undefined;

// Bookshelf-specific data
const isBookshelf = category === 'bookshelf';
const bookCover = isBookshelf && 'cover' in entryData ? entryData.cover : undefined;
const author = isBookshelf && 'author' in entryData ? entryData.author : undefined;
const format = isBookshelf && 'format' in entryData ? entryData.format : undefined;
const genre = isBookshelf && 'genre' in entryData ? entryData.genre : undefined;
const shelfStatus = isBookshelf && 'shelfStatus' in entryData ? entryData.shelfStatus : undefined;
const bookRating = isBookshelf && 'rating' in entryData ? entryData.rating : undefined;
const series = isBookshelf && 'series' in entryData ? entryData.series : undefined;
const started = isBookshelf && 'started' in entryData ? entryData.started : undefined;
const finished = isBookshelf && 'finished' in entryData ? entryData.finished : undefined;
const readingProgress = isBookshelf && 'readingProgress' in entryData ? entryData.readingProgress : undefined;

// Helper functions for bookshelf display
const parseDate = (value: Date | string | undefined) => {
    if (!value) return null;
    if (value instanceof Date) return Number.isNaN(value.getTime()) ? null : value;
    const parsed = new Date(value);
    return Number.isNaN(parsed.getTime()) ? null : parsed;
};

const formatYMD = (value: Date | string | undefined) => {
    const date = parseDate(value);
    if (!date) return null;
    return date.toISOString().slice(0, 10);
};

const formatAuthors = (author?: string | string[]) => {
    if (!author) return null;
    if (typeof author === 'string') return author;
    if (author.length === 0) return null;
    if (author.length === 1) return author[0];
    if (author.length === 2) return `${author[0]} and ${author[1]}`;
    return `${author.slice(0, -1).join(', ')}, and ${author[author.length - 1]}`;
};

const normalizedFormat = format ? format.toLowerCase() : null;
const formatLabelMap: Record<string, string> = {
    audio: 'AUDIOBOOK',
    audiobook: 'AUDIOBOOK',
    ebook: 'EBOOK',
    digital: 'EBOOK',
    paper: 'PAPERBACK',
    paperback: 'PAPERBACK',
    hardcover: 'HARDCOVER'
};

const formatLabel = normalizedFormat ? (formatLabelMap[normalizedFormat] ?? normalizedFormat.toUpperCase()) : null;

const genreLabel = genre ? genre.toUpperCase() : null;

const finishedDate = formatYMD(finished);
const startedDate = formatYMD(started);
const timelineValue = (() => {
    if (startedDate && finishedDate) return `${startedDate} – ${finishedDate}`;
    if (startedDate) return `${startedDate} –`;
    if (finishedDate) return `– ${finishedDate}`;
    return null;
})();

const ratingDisplay = bookRating ? bookRatingDisplay[bookRating as BookRating] : null;
const ratingAriaLabel = ratingDisplay
    ? ratingDisplay.label.replace(/^Rating:\s*/i, 'Rated ')
    : 'Rating: Not set';
const ratingIconSpecs: readonly RatingIconSpec[] = ratingDisplay?.iconSpecs ?? [];

const coverImage = bookCover ? getBookCoverImage(bookCover) : null;
const formattedAuthor = formatAuthors(author);

// Film-specific data
const isFilmshelf = category === 'filmshelf';
const filmCoverFilename = isFilmshelf ? (entryData.cover ?? undefined) : undefined;
const director = isFilmshelf ? (entryData.director ?? undefined) : undefined;
const filmRating = isFilmshelf ? (entryData.rating ?? undefined) : undefined;
const filmWatchedDate = isFilmshelf ? (entryData.finished ?? undefined) : undefined;
const filmYear = isFilmshelf ? (entryData.year ?? null) : null;
const filmGenre = isFilmshelf ? (entryData.genre ?? null) : null;

// Game-specific data
const isGameshelf = category === 'gameshelf';
const gameCoverFilename = isGameshelf ? (entryData.cover ?? undefined) : undefined;
const developer = isGameshelf ? (entryData.developer ?? null) : null;
const platform = isGameshelf ? (entryData.platform ?? null) : null;
const gameRating = isGameshelf ? (entryData.rating ?? undefined) : undefined;
const gameYear = isGameshelf ? (entryData.year ?? null) : null;
const gameGenre = isGameshelf ? (entryData.genre ?? null) : null;

// TV-specific data (PostLayout fallback; primary TV page is tvshelf/[show].astro)
const isTVshelf = category === 'tvshelf';
const tvCoverFilename = isTVshelf ? (entryData.cover ?? undefined) : undefined;
const tvCreator = isTVshelf ? (entryData.creator ?? undefined) : undefined;
const tvRating = isTVshelf ? (entryData.rating ?? undefined) : undefined;
const tvYear = isTVshelf ? (entryData.year ?? null) : null;
const tvGenre = isTVshelf ? (entryData.genre ?? null) : null;
const tvSeason = isTVshelf ? (entryData.season ?? null) : null;

const isShelfPost = isBookshelf || isFilmshelf || isGameshelf || isTVshelf;

// Cover images for all shelf types
const filmCoverImage = filmCoverFilename ? getFilmCoverImage(filmCoverFilename) : null;
const gameCoverImage = gameCoverFilename ? getGameCoverImage(gameCoverFilename) : null;
const tvCoverImage = tvCoverFilename ? getTVCoverImage(tvCoverFilename) : null;
const shelfCoverImage = isBookshelf ? coverImage
    : isFilmshelf ? filmCoverImage
    : isGameshelf ? gameCoverImage
    : isTVshelf ? tvCoverImage
    : null;

// Formatted metadata for film/game/TV
const formattedDirectors = formatAuthors(director);
const formattedCreators = formatAuthors(tvCreator);

const filmGenreLabel = filmGenre ? filmGenre.toUpperCase() : null;
const filmRatingDisplay = filmRating ? bookRatingDisplay[filmRating as BookRating] : null;
const filmRatingAriaLabel = filmRatingDisplay
    ? filmRatingDisplay.label.replace(/^Rating:\s*/i, 'Rated ')
    : 'Rating: Not set';
const filmRatingIconSpecs: readonly RatingIconSpec[] = filmRatingDisplay?.iconSpecs ?? [];
const filmWatchedFormatted = formatYMD(filmWatchedDate);

const gameGenreLabel = gameGenre ? gameGenre.toUpperCase() : null;
const gameRatingDisplay = gameRating ? bookRatingDisplay[gameRating as BookRating] : null;
const gameRatingAriaLabel = gameRatingDisplay
    ? gameRatingDisplay.label.replace(/^Rating:\s*/i, 'Rated ')
    : 'Rating: Not set';
const gameRatingIconSpecs: readonly RatingIconSpec[] = gameRatingDisplay?.iconSpecs ?? [];

const tvGenreLabel = tvGenre ? tvGenre.toUpperCase() : null;
const tvRatingDisplay = tvRating ? bookRatingDisplay[tvRating as BookRating] : null;
const tvRatingAriaLabel = tvRatingDisplay
    ? tvRatingDisplay.label.replace(/^Rating:\s*/i, 'Rated ')
    : 'Rating: Not set';
const tvRatingIconSpecs: readonly RatingIconSpec[] = tvRatingDisplay?.iconSpecs ?? [];
---

<LayoutContainer
    prose
    maxWidth="full"
    padding="sm"
    paddingScale="page"
    className="post-layout__container"
>
    <!-- Pagefind metadata: outside data-pagefind-body so they don't pollute text index -->
    <div aria-hidden="true" style="display:none">
        <span data-pagefind-meta="category">{category}</span>
        {tags.map((tag: string) => (
            <span data-pagefind-filter="tag">{tag.toLowerCase()}</span>
        ))}
    </div>

    <article class="h-entry" data-pagefind-body>
        <!-- Hidden microformat data -->
        <a href={canonicalUrl} class="u-url" style="display: none;"></a>
        {bridgyOmit && (
            <a href={canonicalUrl} class="u-bridgy-omit-link" style="display: none;"></a>
        )}
        <div class="p-author h-card" style="display: none;">
            <a class="p-name u-url" href="https://sajalchoudhary.net">Sajal Choudhary</a>
            <a class="u-url" href="https://sajalchoudhary.net">https://sajalchoudhary.net</a>
        </div>

        <div class="mb-8">
            {/* Hero image for non-shelf posts */}
            {heroImage && !isShelfPost && (
                <div class="mb-6">
                    <img
                        src={heroImage}
                        alt={title}
                        class="rounded-lg w-full object-cover max-h-96"
                        loading="lazy"
                    />
                </div>
            )}

            {/* Shelf post pages: two-column on desktop (cover left, metadata right) */}
            {isShelfPost ? (
                <div class="book-header">
                    {shelfCoverImage && (
                        <div class="book-header__cover">
                            <Image
                                src={shelfCoverImage}
                                alt={`Cover of ${title}`}
                                class="book-meta-cover-image"
                                loading="lazy"
                            />
                        </div>
                    )}
                    <div class={`book-header__meta${!shelfCoverImage ? ' book-header__meta--no-cover' : ''}`}>
                        <h1 class="p-name text-3xl md:text-4xl font-bold mb-2">{title}</h1>

                        {isBookshelf && formattedAuthor && (
                            <div class="book-meta-author-title">by {formattedAuthor}</div>
                        )}
                        {isFilmshelf && formattedDirectors && (
                            <div class="book-meta-author-title">Directed by {formattedDirectors}</div>
                        )}
                        {isGameshelf && developer && (
                            <div class="book-meta-author-title">by {developer}</div>
                        )}
                        {isTVshelf && formattedCreators && (
                            <div class="book-meta-author-title">Created by {formattedCreators}</div>
                        )}

                        {description && (
                            <p class="p-summary text-xl text-textSecondary dark:text-textSecondaryDark mb-4">
                                {description}
                            </p>
                        )}

                        {tags.length > 0 && (
                            <div class="mb-4 flex flex-wrap gap-2">
                                {tags.map((tag: string) => (
                                    <Tag tag={tag} as="a" />
                                ))}
                            </div>
                        )}

                        {/* Bookshelf chips */}
                        {isBookshelf && (genreLabel || formatLabel || bookRating || timelineValue) && (
                            <div class="book-meta-pills">
                                {genreLabel && (
                                    <span class="book-meta__chip book-meta__chip--genre">
                                        <span class="book-meta__chip-section-label">Genre</span>
                                        {genreLabel}
                                    </span>
                                )}

                                {formatLabel && (
                                    <span class="book-meta__chip book-meta__chip--format">
                                        <span class="book-meta__chip-section-label">Format</span>
                                        {formatLabel}
                                    </span>
                                )}

                                {bookRating && (
                                    <span
                                        class={`book-meta__chip book-meta__chip--rating ${
                                            bookRating ? `book-meta__chip--rating-${bookRating}` : 'book-meta__chip--rating-none'
                                        }`}
                                        aria-label={ratingAriaLabel}
                                    >
                                        <span class="book-meta__chip-section-label">Rated</span>
                                        {ratingIconSpecs.length > 0 && (
                                            <span
                                                class={`book-meta__rating-icons ${
                                                    bookRating ? `book-meta__rating-icons--${bookRating}` : ''
                                                }`}
                                                aria-hidden="true"
                                            >
                                                {ratingIconSpecs.map((iconSpec) => (
                                                    <span class="book-meta__rating-icon">
                                                        <svg
                                                            width={iconSpec.size}
                                                            height={iconSpec.size}
                                                            viewBox="0 0 24 24"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            stroke-width="1.5"
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                        >
                                                            {(
                                                                iconSpec.type === 'heart'
                                                                    ? heartIconPaths
                                                                    : thumbIconPaths[iconSpec.direction]
                                                            ).map((d) => (
                                                                <path d={d}></path>
                                                            ))}
                                                        </svg>
                                                    </span>
                                                ))}
                                            </span>
                                        )}
                                    </span>
                                )}

                                {timelineValue && (
                                    <span class="book-meta__chip book-meta__chip--timeline">
                                        <span class="book-meta__chip-section-label">Read</span>
                                        <span class="book-meta__chip-label">{timelineValue}</span>
                                    </span>
                                )}
                            </div>
                        )}

                        {/* Film chips */}
                        {isFilmshelf && (filmGenreLabel || filmYear || filmRating || filmWatchedFormatted) && (
                            <div class="book-meta-pills">
                                {filmGenreLabel && (
                                    <span class="book-meta__chip book-meta__chip--genre">
                                        <span class="book-meta__chip-section-label">Genre</span>
                                        {filmGenreLabel}
                                    </span>
                                )}
                                {filmYear && (
                                    <span class="book-meta__chip book-meta__chip--timeline">
                                        <span class="book-meta__chip-section-label">Year</span>
                                        <span class="book-meta__chip-label">{filmYear}</span>
                                    </span>
                                )}
                                {filmRating && (
                                    <span
                                        class={`book-meta__chip book-meta__chip--rating book-meta__chip--rating-${filmRating}`}
                                        aria-label={filmRatingAriaLabel}
                                    >
                                        <span class="book-meta__chip-section-label">Rated</span>
                                        {filmRatingIconSpecs.length > 0 && (
                                            <span
                                                class={`book-meta__rating-icons book-meta__rating-icons--${filmRating}`}
                                                aria-hidden="true"
                                            >
                                                {filmRatingIconSpecs.map((iconSpec) => (
                                                    <span class="book-meta__rating-icon">
                                                        <svg
                                                            width={iconSpec.size}
                                                            height={iconSpec.size}
                                                            viewBox="0 0 24 24"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            stroke-width="1.5"
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                        >
                                                            {(
                                                                iconSpec.type === 'heart'
                                                                    ? heartIconPaths
                                                                    : thumbIconPaths[iconSpec.direction]
                                                            ).map((d) => (
                                                                <path d={d}></path>
                                                            ))}
                                                        </svg>
                                                    </span>
                                                ))}
                                            </span>
                                        )}
                                    </span>
                                )}
                                {filmWatchedFormatted && (
                                    <span class="book-meta__chip book-meta__chip--timeline">
                                        <span class="book-meta__chip-section-label">Watched</span>
                                        <span class="book-meta__chip-label">{filmWatchedFormatted}</span>
                                    </span>
                                )}
                            </div>
                        )}

                        {/* Game chips */}
                        {isGameshelf && (gameGenreLabel || platform || gameYear || gameRating) && (
                            <div class="book-meta-pills">
                                {gameGenreLabel && (
                                    <span class="book-meta__chip book-meta__chip--genre">
                                        <span class="book-meta__chip-section-label">Genre</span>
                                        {gameGenreLabel}
                                    </span>
                                )}
                                {platform && (
                                    <span class="book-meta__chip book-meta__chip--format">
                                        <span class="book-meta__chip-section-label">Platform</span>
                                        {(platform as string).toUpperCase()}
                                    </span>
                                )}
                                {gameYear && (
                                    <span class="book-meta__chip book-meta__chip--timeline">
                                        <span class="book-meta__chip-section-label">Year</span>
                                        <span class="book-meta__chip-label">{gameYear}</span>
                                    </span>
                                )}
                                {gameRating && (
                                    <span
                                        class={`book-meta__chip book-meta__chip--rating book-meta__chip--rating-${gameRating}`}
                                        aria-label={gameRatingAriaLabel}
                                    >
                                        <span class="book-meta__chip-section-label">Rated</span>
                                        {gameRatingIconSpecs.length > 0 && (
                                            <span
                                                class={`book-meta__rating-icons book-meta__rating-icons--${gameRating}`}
                                                aria-hidden="true"
                                            >
                                                {gameRatingIconSpecs.map((iconSpec) => (
                                                    <span class="book-meta__rating-icon">
                                                        <svg
                                                            width={iconSpec.size}
                                                            height={iconSpec.size}
                                                            viewBox="0 0 24 24"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            stroke-width="1.5"
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                        >
                                                            {(
                                                                iconSpec.type === 'heart'
                                                                    ? heartIconPaths
                                                                    : thumbIconPaths[iconSpec.direction]
                                                            ).map((d) => (
                                                                <path d={d}></path>
                                                            ))}
                                                        </svg>
                                                    </span>
                                                ))}
                                            </span>
                                        )}
                                    </span>
                                )}
                            </div>
                        )}

                        {/* TV chips */}
                        {isTVshelf && (tvGenreLabel || tvYear || tvSeason || tvRating) && (
                            <div class="book-meta-pills">
                                {tvGenreLabel && (
                                    <span class="book-meta__chip book-meta__chip--genre">
                                        <span class="book-meta__chip-section-label">Genre</span>
                                        {tvGenreLabel}
                                    </span>
                                )}
                                {tvYear && (
                                    <span class="book-meta__chip book-meta__chip--timeline">
                                        <span class="book-meta__chip-section-label">Year</span>
                                        <span class="book-meta__chip-label">{tvYear}</span>
                                    </span>
                                )}
                                {tvSeason && (
                                    <span class="book-meta__chip book-meta__chip--format">
                                        <span class="book-meta__chip-section-label">Season</span>
                                        {tvSeason}
                                    </span>
                                )}
                                {tvRating && (
                                    <span
                                        class={`book-meta__chip book-meta__chip--rating book-meta__chip--rating-${tvRating}`}
                                        aria-label={tvRatingAriaLabel}
                                    >
                                        <span class="book-meta__chip-section-label">Rated</span>
                                        {tvRatingIconSpecs.length > 0 && (
                                            <span
                                                class={`book-meta__rating-icons book-meta__rating-icons--${tvRating}`}
                                                aria-hidden="true"
                                            >
                                                {tvRatingIconSpecs.map((iconSpec) => (
                                                    <span class="book-meta__rating-icon">
                                                        <svg
                                                            width={iconSpec.size}
                                                            height={iconSpec.size}
                                                            viewBox="0 0 24 24"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            stroke-width="1.5"
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                        >
                                                            {(
                                                                iconSpec.type === 'heart'
                                                                    ? heartIconPaths
                                                                    : thumbIconPaths[iconSpec.direction]
                                                            ).map((d) => (
                                                                <path d={d}></path>
                                                            ))}
                                                        </svg>
                                                    </span>
                                                ))}
                                            </span>
                                        )}
                                    </span>
                                )}
                            </div>
                        )}
                    </div>
                </div>
            ) : (
                <div class="text-center">
                    <h1 class="p-name text-3xl md:text-4xl font-bold mb-2">{title}</h1>

                    {category === 'nordletter' && edition && (
                        <div class="flex justify-center items-center gap-4 mb-4">
                            <div class="inline-block bg-gray-100 dark:bg-gray-800 px-4 py-2 rounded-lg">
                                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
                                    Letter: {edition}
                                </span>
                            </div>
                        </div>
                    )}

                    {description && (
                        <p class="p-summary text-xl text-textSecondary dark:text-textSecondaryDark mb-8">
                            {description}
                        </p>
                    )}

                    {tags.length > 0 && (
                        <div class="mb-8 flex justify-center">
                            <div class="flex flex-wrap gap-2 justify-center">
                                {tags.map((tag: string) => (
                                    <Tag tag={tag} as="a" />
                                ))}
                            </div>
                        </div>
                    )}
                </div>
            )}
        </div>


        <div class="e-content">
            <slot />
        </div>

        <div class="mt-12 border-t border-borderColor dark:border-borderColorDark">
            <NewsletterSignup
                title="Subscribe to NordLetter"
                description="A weekly newsletter on living in Finland."
                buttonText="Sign up"
                headingClass="text-xl font-bold mb-3"
                centered={true}
            />
        </div>

        <div class="mt-12 pt-8 border-t border-borderColor dark:border-borderColorDark">
            <div class="flex justify-between">
                <a href={`/${category}/`} class="post-layout__back-link">← Back to {formattedCategory}</a>

                <ShareButton title={title} url={canonicalUrl} />
            </div>
        </div>

        <div class="post-layout__meta">
            <div class="post-layout__meta-row">
                <div class="post-layout__meta-primary">
                    <div class="post-layout__meta-date">
                        <span class="post-layout__meta-date-chip card-chip">
                            <span class="post-layout__meta-date-chip-label">
                                {updatedDate ? 'UPDATED' : 'PUBLISHED'}
                            </span>
                            {updatedDate ? (
                                <TimeDisplay
                                    date={updatedDate}
                                    category={category}
                                    format="detailed"
                                    className="dt-updated post-layout__meta-date-time"
                                />
                            ) : (
                                <TimeDisplay
                                    date={publishedDate}
                                    category={category}
                                    format="detailed"
                                    className="dt-published post-layout__meta-date-time"
                                />
                            )}
                        </span>
                    </div>

                    <div class="post-layout__feedback">
                        Thoughts? Email <a href="mailto:sajal@sajalchoudhary.net" class="link-hover">sajal@sajalchoudhary.net</a>
                    </div>
                </div>

                <SyndicationLinks
                    syndicationUrls={syndicationUrls}
                    className="post-layout__meta-syndication"
                />
            </div>
        </div>

        <Backlinks backlinks={backlinks} />
    </article>
</LayoutContainer>

<style>
    .post-layout__container {
        padding-block: 0;
    }

    @media (min-width: 48rem) {
        .post-layout__container {
            padding-inline: 0;
        }
    }

    .post-layout__back-link {
        font-weight: 600;
        color: inherit;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        transition: color 0.2s ease, text-decoration-color 0.2s ease;
    }

    .post-layout__back-link:hover,
    .post-layout__back-link:focus-visible {
        color: rgb(var(--color-text-primary));
        text-decoration: underline;
        text-decoration-thickness: 0.1em;
        text-underline-offset: 0.2em;
    }

    .post-layout__back-link:focus-visible {
        outline: 2px solid rgb(var(--color-accent));
        outline-offset: 2px;
    }

    .post-layout__meta {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgb(var(--color-border));
    }

    :global(.dark) .post-layout__meta {
        border-top-color: rgb(var(--color-border));
    }

    .post-layout__meta-row {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    @media (min-width: 48rem) {
        .post-layout__meta-row {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }
    }

    .post-layout__meta-primary {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    @media (min-width: 48rem) {
        .post-layout__meta-primary {
            flex-direction: row;
            align-items: center;
            gap: 1.25rem;
        }
    }

    .post-layout__meta-date {
        display: flex;
        align-items: center;
    }

    .post-layout__meta-date-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
