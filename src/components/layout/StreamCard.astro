---
interface Props {
    post: {
        data: {
            title?: string;
            description?: string;
            created: Date;
            category: string;
            link: string;
        };
    };
}

const { post } = Astro.props;
const { title, description, created, category, link } = post.data;

const formattedDate = new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
}).format(new Date(created));

const categoryLabels: Record<string, string> = {
    blog: 'Blog',
    micro: 'Note',
    photo: 'Photo',
};
const categoryLabel = categoryLabels[category] ?? category;
---

<article class="stream-card">
    <a href={link} class="stream-card__link">
        <span class="stream-card__chip">{categoryLabel}</span>
        <h3 class="stream-card__title">{title ?? 'Untitled'}</h3>
        {description && (
            <p class="stream-card__desc">{description}</p>
        )}
        <time class="stream-card__date" datetime={new Date(created).toISOString()}>
            {formattedDate}
        </time>
    </a>
</article>

<style>
    .stream-card {
        width: 15rem;
        flex-shrink: 0;
        scroll-snap-align: start;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 0.75rem;
        background: rgba(0, 0, 0, 0.02);
        transition:
            transform 180ms ease,
            box-shadow 220ms ease,
            border-color 180ms ease;
    }

    :global(.dark) .stream-card {
        background: rgba(255, 255, 255, 0.03);
        border-color: rgba(255, 255, 255, 0.08);
    }

    .stream-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        border-color: rgba(99, 102, 241, 0.25);
    }

    :global(.dark) .stream-card:hover {
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        border-color: rgba(129, 140, 248, 0.3);
    }

    .stream-card__link {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: clamp(0.875rem, 2vw, 1.125rem);
        text-decoration: none;
        color: inherit;
        height: 100%;
        min-height: 9rem;
    }

    .stream-card__chip {
        display: inline-flex;
        align-items: center;
        padding: 0.2rem 0.5rem;
        border-radius: 9999px;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        background: rgba(99, 102, 241, 0.1);
        color: rgb(99, 102, 241);
        width: fit-content;
    }

    :global(.dark) .stream-card__chip {
        background: rgba(129, 140, 248, 0.15);
        color: rgb(129, 140, 248);
    }

    .stream-card__title {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.4;
        margin: 0;
        color: rgb(var(--color-text-primary));
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .stream-card__desc {
        font-size: 0.8rem;
        line-height: 1.5;
        color: rgb(var(--color-text-secondary));
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex: 1;
    }

    .stream-card__date {
        font-size: 0.72rem;
        color: rgb(var(--color-text-secondary));
        margin-top: auto;
        opacity: 0.65;
    }
</style>
