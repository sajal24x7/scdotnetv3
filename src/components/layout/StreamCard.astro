---
import TimeDisplay from '../TimeDisplay.astro';

interface Props {
    post: {
        data: {
            title?: string;
            description?: string;
            created: Date;
            category: string;
            link: string;
        };
        body?: string;
    };
}

const { post } = Astro.props;
const { title, description, created, category, link } = post.data;

// Extract a plain-text excerpt from the raw markdown body.
// Skips markdown links and blockquotes so we surface the author's own words.
const getExcerpt = (body: string | undefined, max = 140): string => {
    if (!body) return '';
    const lines = body.split('\n');
    const kept = lines
        .filter((l) => {
            const t = l.trim();
            return t && !t.startsWith('>') && !t.startsWith('[') && !t.startsWith('!');
        })
        .join(' ')
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') // inline links → label only
        .replace(/[*_`#]/g, '')                    // remove common markdown punctuation
        .replace(/\s+/g, ' ')
        .trim();
    return kept.length > max ? kept.slice(0, max).trimEnd() + '…' : kept;
};

// For blog posts use the description; for micro use the body excerpt
const excerpt = category === 'blog' || category === 'photo'
    ? description ?? getExcerpt(post.body)
    : getExcerpt(post.body);
---

<article class="stream-card">
    <a href={link} class="stream-card__link">
        <h3 class="stream-card__title">{title ?? 'Untitled'}</h3>
        {excerpt && (
            <p class="stream-card__excerpt">{excerpt}</p>
        )}
        <TimeDisplay
            date={created}
            format="relative"
            className="stream-card__date"
            showTime={false}
        />
    </a>
</article>

<style>
    .stream-card {
        width: 15rem;
        flex-shrink: 0;
        scroll-snap-align: start;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 0.75rem;
        background: rgba(0, 0, 0, 0.02);
        transition:
            transform 180ms ease,
            box-shadow 220ms ease,
            border-color 180ms ease;
    }

    :global(.dark) .stream-card {
        background: rgba(255, 255, 255, 0.03);
        border-color: rgba(255, 255, 255, 0.08);
    }

    .stream-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        border-color: rgba(99, 102, 241, 0.25);
    }

    :global(.dark) .stream-card:hover {
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        border-color: rgba(129, 140, 248, 0.3);
    }

    .stream-card__link {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: clamp(0.875rem, 2vw, 1.125rem);
        text-decoration: none;
        color: inherit;
        height: 100%;
        min-height: 9rem;
    }

    .stream-card__title {
        font-size: 0.975rem;
        font-weight: 600;
        line-height: 1.4;
        margin: 0;
        color: rgb(var(--color-text-primary));
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .stream-card__excerpt {
        font-size: 0.8rem;
        line-height: 1.55;
        color: rgb(var(--color-text-secondary));
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex: 1;
    }

    .stream-card__date {
        font-size: 0.72rem;
        color: rgb(var(--color-text-secondary));
        margin-top: auto;
        opacity: 0.65;
        display: block;
    }
</style>
