---
// Lead image for non-shelf posts: a carousel when the post carries a
// frontmatter gallery (photo-style posts), otherwise the single hero image.
import PhotoCarousel from '../../PhotoCarousel.astro';

interface Props {
    title: string;
    heroImage?: string;
    galleryImages?: string[];
}

const { title, heroImage, galleryImages = [] } = Astro.props as Props;
---

{galleryImages.length > 0 && (
    <div class="mb-6">
        <PhotoCarousel images={galleryImages} title={title} />
    </div>
)}

{heroImage && galleryImages.length === 0 && (
    <div class="mb-6">
        <img
            src={heroImage}
            alt={title}
            class="rounded-lg w-full object-cover max-h-96 aspect-[1200/630]"
            loading="lazy"
            decoding="async"
        />
    </div>
)}
