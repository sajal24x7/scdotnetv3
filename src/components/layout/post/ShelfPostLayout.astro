---
import { Image } from 'astro:assets';
import PostShell from './PostShell.astro';
import PostMetaLine from './PostMetaLine.astro';
import ShelfMetaChips from './ShelfMetaChips.astro';
import Tag from '../../Tag.astro';
import { getPostCommonMeta, type PostLayoutProps } from '../../../utils/postMeta';
import { getShelfMeta, getShelfCoverImage, type ShelfCategory } from '../../../utils/shelfMeta';

/**
 * Shelf entries (bookshelf, filmshelf, tvshelf, gameshelf): cover art on the
 * left, byline and metadata chips on the right. The per-type field mapping
 * lives in `src/utils/shelfMeta.ts`.
 */

const { entry, category, canonicalUrl, backlinks, interactions = [], hasUpdatedDate } = Astro.props as PostLayoutProps;

const entryData = entry.data ?? {};
const meta = getPostCommonMeta(entryData, hasUpdatedDate);
const { byline, chips } = getShelfMeta(category, entryData);
const coverImage = getShelfCoverImage(category, entryData.cover);
---

<PostShell
    category={category}
    canonicalUrl={canonicalUrl}
    backlinks={backlinks}
    interactions={interactions}
    tags={meta.tags}
    bridgyOmit={meta.bridgyOmit}
>
    <div slot="header" class="mb-8">
        <div class="book-header">
            {coverImage && (
                <div class="book-header__cover">
                    <Image
                        src={coverImage}
                        alt={`Cover of ${meta.title}`}
                        class="book-meta-cover-image"
                        loading="lazy"
                    />
                </div>
            )}
            <div class={`book-header__meta${!coverImage ? ' book-header__meta--no-cover' : ''}`}>
                <h1 class="p-name text-3xl md:text-4xl font-bold mb-2">{meta.title}</h1>

                {byline && <div class="book-meta-author-title">{byline}</div>}

                {meta.description && (
                    <p class="p-summary text-xl text-textSecondary dark:text-textSecondaryDark mb-4">
                        {meta.description}
                    </p>
                )}

                {meta.tags.length > 0 && (
                    <div class="mb-4 flex flex-wrap gap-2">
                        {meta.tags.map((tag: string) => (
                            <Tag tag={tag} as="a" />
                        ))}
                    </div>
                )}

                <ShelfMetaChips chips={chips} className={!coverImage ? 'book-meta-pills--centered' : ''} />
            </div>
        </div>
    </div>

    <slot />

    <PostMetaLine
        slot="footer"
        category={category}
        publishedDate={meta.publishedDate}
        updated={meta.updated}
        syndicationUrls={meta.syndicationUrls}
    />
</PostShell>

<style>
    /* Shelf post two-column header */
    .book-header {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid rgb(var(--color-border));
    }

    :global(.dark) .book-header {
        border-bottom-color: rgb(var(--color-border));
    }

    .book-header__cover {
        display: flex;
        justify-content: center;
    }

    .book-header__meta {
        display: flex;
        flex-direction: column;
    }

    .book-header__meta--no-cover {
        text-align: center;
        align-items: center;
    }

    @media (min-width: 48rem) {
        .book-header {
            display: grid;
            /* 3 cols cover, 5 cols metadata (= 8 cols total, matching grid-span-8) */
            grid-template-columns: 3fr 5fr;
            gap: 2rem;
            align-items: start;
        }

        .book-header__cover {
            justify-content: center;
        }

        .book-header__meta {
            justify-content: flex-start;
            padding-top: 0.25rem;
        }
    }

    .book-meta-cover-image {
        width: auto;
        max-height: 16rem;
        height: auto;
        /* Cancel the .prose img spacing so the cover aligns with the title */
        margin: 0;
        border-radius: 0.75rem;
        box-shadow:
            0 4px 6px rgba(0, 0, 0, 0.1),
            0 2px 4px rgba(0, 0, 0, 0.06);
    }

    @media (min-width: 48rem) {
        .book-meta-cover-image {
            width: auto;
            max-height: 16rem;
        }
    }

    :global(.dark) .book-meta-cover-image {
        box-shadow:
            0 4px 6px rgba(0, 0, 0, 0.3),
            0 2px 4px rgba(0, 0, 0, 0.2);
    }

    .book-meta-author-title {
        font-size: 1.125rem;
        font-weight: 500;
        color: var(--gray-text-body);
        margin-bottom: 1rem;
        margin-top: 0.5rem;
    }
</style>
