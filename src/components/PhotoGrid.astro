---
import TimeDisplay from './TimeDisplay.astro';
import { getPhotoImages, getPhotoCaption } from '../utils/photos';

interface Props {
    posts: any[];
}

const { posts } = Astro.props as Props;

const tiles = posts.map((post) => {
    const images = getPhotoImages(post.data, post.body);
    const caption = getPhotoCaption(post.data, post.body);
    const tags = Array.isArray(post.data.tags) ? post.data.tags : [];
    return {
        link: post.data.link,
        created: post.data.created,
        tags: tags.join(','),
        image: images[0] ?? null,
        imageCount: images.length,
        caption,
    };
});
---

<div class="photo-grid">
    {tiles.map((tile) => (
        <a
            href={tile.link}
            class="photo-tile"
            data-content-item
            data-tags={tile.tags}
            aria-label={tile.caption || 'Photo post'}
        >
            {tile.image ? (
                <img
                    src={tile.image}
                    alt={tile.caption}
                    loading="lazy"
                    decoding="async"
                />
            ) : (
                <span class="photo-tile__placeholder">{tile.caption || 'Photo post'}</span>
            )}

            {tile.imageCount > 1 && (
                <span class="photo-tile__count" aria-label={`${tile.imageCount} photos`}>
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="8" y="8" width="12" height="12" rx="2" stroke="currentColor" stroke-width="2" />
                        <path d="M4 16V6a2 2 0 0 1 2-2h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    {tile.imageCount}
                </span>
            )}

            <span class="photo-tile__overlay">
                {tile.caption && <span class="photo-tile__caption">{tile.caption}</span>}
                <TimeDisplay
                    date={tile.created}
                    category="photo"
                    format="detailed"
                    className="photo-tile__date"
                />
            </span>
        </a>
    ))}
</div>

<style>
    .photo-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(0.75rem, 2vw, 1.25rem);
        padding-block: clamp(1.25rem, 3vw, 2rem);
    }

    @media (min-width: 40rem) {
        .photo-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 64rem) {
        .photo-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    .photo-tile {
        position: relative;
        display: block;
        aspect-ratio: 1 / 1;
        border-radius: 0.75rem;
        overflow: hidden;
        background: rgba(0, 0, 0, 0.04);
        border: 1px solid rgba(0, 0, 0, 0.08);
        text-decoration: none;
        transition: box-shadow 220ms ease, transform 220ms ease, border-color 180ms ease;
    }

    :global(.dark) .photo-tile {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.08);
    }

    .photo-tile:hover,
    .photo-tile:focus-visible {
        transform: translateY(-2px);
        border-color: rgba(99, 102, 241, 0.3);
        box-shadow:
            0 4px 8px rgba(0, 0, 0, 0.08),
            0 8px 24px rgba(129, 140, 248, 0.15);
    }

    .photo-tile:focus-visible {
        outline: 2px solid rgba(99, 102, 241, 0.7);
        outline-offset: 2px;
    }

    .photo-tile img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 400ms ease;
    }

    .photo-tile:hover img,
    .photo-tile:focus-visible img {
        transform: scale(1.04);
    }

    .photo-tile__placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        padding: 1.5rem;
        text-align: center;
        font-size: 1rem;
        line-height: 1.5;
        color: rgb(var(--color-text-secondary));
    }

    .photo-tile__count {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.55);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 600;
        backdrop-filter: blur(4px);
    }

    .photo-tile__count svg {
        width: 0.85rem;
        height: 0.85rem;
    }

    .photo-tile__overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: 0.25rem;
        padding: clamp(0.85rem, 2.5vw, 1.25rem);
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.72) 0%,
            rgba(0, 0, 0, 0.35) 45%,
            rgba(0, 0, 0, 0) 70%
        );
        color: #fff;
        opacity: 0;
        transition: opacity 220ms ease;
        pointer-events: none;
    }

    .photo-tile:hover .photo-tile__overlay,
    .photo-tile:focus-visible .photo-tile__overlay {
        opacity: 1;
    }

    /* Touch devices have no hover — keep the caption visible */
    @media (hover: none) {
        .photo-tile__overlay {
            opacity: 1;
        }
    }

    .photo-tile__caption {
        font-size: 0.95rem;
        font-weight: 600;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .photo-tile :global(.photo-tile__date) {
        font-size: 0.75rem;
        font-weight: 500;
        opacity: 0.85;
    }

    /* Placeholder tiles keep their text readable without the dark gradient */
    .photo-tile:has(.photo-tile__placeholder) .photo-tile__overlay {
        background: none;
        color: rgb(var(--color-text-secondary));
    }

    .photo-tile:has(.photo-tile__placeholder) .photo-tile__caption {
        display: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .photo-tile,
        .photo-tile img,
        .photo-tile__overlay {
            transition: none;
        }

        .photo-tile:hover img,
        .photo-tile:focus-visible img {
            transform: none;
        }
    }
</style>
