---
import TimeDisplay from './TimeDisplay.astro';
import Tag from './Tag.astro';
import { getPhotoImages, getPhotoCaption } from '../utils/photos';

interface Props {
    posts: any[];
}

const { posts } = Astro.props as Props;

const truncate = (text: string, max = 280) =>
    text.length <= max ? text : `${text.slice(0, max).replace(/\s+\S*$/, '')}…`;

const tiles = posts.map((post) => {
    const images = getPhotoImages(post.data, post.body);
    const title = typeof post.data.title === 'string' ? post.data.title.trim() : '';
    // Body text with markdown stripped (empty for posts whose body is just the image)
    const bodyCaption = truncate(getPhotoCaption({}, post.body));
    const tags: string[] = Array.isArray(post.data.tags) ? post.data.tags : [];
    return {
        link: post.data.link,
        created: post.data.created,
        tags,
        image: images[0] ?? null,
        imageCount: images.length,
        title,
        bodyCaption,
        // Grid overlay shows one line: the title when present, else the caption
        overlayCaption: title || bodyCaption,
    };
});
---

<div class="photo-feed" data-photo-feed data-view="grid">
    <div class="photo-feed__toolbar">
        <div class="photo-feed__toggle" role="group" aria-label="Photos layout">
            <button type="button" data-view-btn="grid" aria-pressed="true" aria-label="Grid view" title="Grid view">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <circle cx="5" cy="5" r="1.6" />
                    <circle cx="12" cy="5" r="1.6" />
                    <circle cx="19" cy="5" r="1.6" />
                    <circle cx="5" cy="12" r="1.6" />
                    <circle cx="12" cy="12" r="1.6" />
                    <circle cx="19" cy="12" r="1.6" />
                    <circle cx="5" cy="19" r="1.6" />
                    <circle cx="12" cy="19" r="1.6" />
                    <circle cx="19" cy="19" r="1.6" />
                </svg>
            </button>
            <button type="button" data-view-btn="list" aria-pressed="false" aria-label="Single column view" title="Single column view">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="4.5" y="4.5" width="15" height="15" rx="1.5" stroke="currentColor" stroke-width="2" />
                </svg>
            </button>
        </div>
    </div>

    <div class="photo-grid">
        {tiles.map((tile) => (
            <article class="photo-entry" data-content-item data-tags={tile.tags.join(',')}>
                <a
                    href={tile.link}
                    class="photo-entry__media"
                    aria-label={tile.overlayCaption || 'Photo post'}
                >
                    {tile.image ? (
                        <img
                            src={tile.image}
                            alt={tile.overlayCaption}
                            loading="lazy"
                            decoding="async"
                        />
                    ) : (
                        <span class="photo-entry__placeholder">{tile.overlayCaption || 'Photo post'}</span>
                    )}

                    {tile.imageCount > 1 && (
                        <span class="photo-entry__count" aria-label={`${tile.imageCount} photos`}>
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <rect x="8" y="8" width="12" height="12" rx="2" stroke="currentColor" stroke-width="2" />
                                <path d="M4 16V6a2 2 0 0 1 2-2h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            </svg>
                            {tile.imageCount}
                        </span>
                    )}

                    <span class="photo-entry__overlay">
                        {tile.overlayCaption && <span class="photo-entry__overlay-caption">{tile.overlayCaption}</span>}
                        <TimeDisplay
                            date={tile.created}
                            category="photo"
                            format="detailed"
                            className="photo-entry__overlay-date"
                        />
                    </span>
                </a>

                {/* Shown in the single-column view: caption + metadata below the image */}
                <div class="photo-entry__info">
                    {tile.title && (
                        <h2 class="photo-entry__title">
                            <a href={tile.link} class="link-hover">{tile.title}</a>
                        </h2>
                    )}
                    {tile.bodyCaption && tile.bodyCaption !== tile.title && (
                        <p class="photo-entry__caption">{tile.bodyCaption}</p>
                    )}
                    <div class="photo-entry__meta">
                        <a href={tile.link} class="photo-entry__date-link" aria-label="Open post">
                            <TimeDisplay
                                date={tile.created}
                                category="photo"
                                format="detailed"
                                className="photo-entry__date"
                            />
                        </a>
                        {tile.tags.length > 0 && (
                            <span class="photo-entry__tags">
                                {tile.tags.map((tag) => (
                                    <Tag tag={tag} asFilter />
                                ))}
                            </span>
                        )}
                    </div>
                </div>
            </article>
        ))}
    </div>
</div>

<script is:inline>
(() => {
    const VIEW_KEY = 'photos.view';
    const feed = document.querySelector('[data-photo-feed]');
    if (!feed) return;

    const buttons = feed.querySelectorAll('[data-view-btn]');

    function applyView(view) {
        const next = view === 'list' ? 'list' : 'grid';
        feed.dataset.view = next;
        buttons.forEach((btn) => {
            btn.setAttribute('aria-pressed', String(btn.dataset.viewBtn === next));
        });
    }

    buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
            applyView(btn.dataset.viewBtn);
            try { localStorage.setItem(VIEW_KEY, feed.dataset.view); } catch { /* private mode */ }
        });
    });

    try { applyView(localStorage.getItem(VIEW_KEY)); } catch { /* private mode */ }
})();
</script>

<style>
    .photo-feed {
        padding-block: clamp(1rem, 2.5vw, 1.5rem);
    }

    .photo-feed__toolbar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: clamp(0.75rem, 2vw, 1.25rem);
    }

    .photo-feed__toggle {
        display: inline-flex;
        gap: 2px;
        padding: 3px;
        border-radius: 0.65rem;
        background: rgba(0, 0, 0, 0.04);
        border: 1px solid rgba(0, 0, 0, 0.08);
    }

    :global(.dark) .photo-feed__toggle {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.08);
    }

    .photo-feed__toggle button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.1rem;
        height: 2.1rem;
        border: none;
        border-radius: 0.5rem;
        background: none;
        color: rgb(var(--color-text-secondary));
        cursor: pointer;
        transition: background 150ms ease, color 150ms ease;
    }

    .photo-feed__toggle button svg {
        width: 1.15rem;
        height: 1.15rem;
    }

    .photo-feed__toggle button[aria-pressed="true"] {
        background: rgb(var(--color-text-primary));
        color: rgb(var(--color-bg));
    }

    .photo-feed__toggle button:not([aria-pressed="true"]):hover {
        color: rgb(var(--color-text-primary));
    }

    .photo-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(0.75rem, 2vw, 1.25rem);
    }

    .photo-entry {
        display: flex;
        flex-direction: column;
    }

    .photo-entry__media {
        position: relative;
        display: block;
        border-radius: 0.75rem;
        overflow: hidden;
        background: rgba(0, 0, 0, 0.04);
        border: 1px solid rgba(0, 0, 0, 0.08);
        text-decoration: none;
        transition: box-shadow 220ms ease, transform 220ms ease, border-color 180ms ease;
    }

    :global(.dark) .photo-entry__media {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.08);
    }

    .photo-entry__media:hover,
    .photo-entry__media:focus-visible {
        transform: translateY(-2px);
        border-color: rgba(99, 102, 241, 0.3);
        box-shadow:
            0 4px 8px rgba(0, 0, 0, 0.08),
            0 8px 24px rgba(129, 140, 248, 0.15);
    }

    .photo-entry__media:focus-visible {
        outline: 2px solid rgba(99, 102, 241, 0.7);
        outline-offset: 2px;
    }

    .photo-entry__media img {
        width: 100%;
        display: block;
        transition: transform 400ms ease;
    }

    .photo-entry__placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 10rem;
        padding: 1.5rem;
        text-align: center;
        font-size: 1rem;
        line-height: 1.5;
        color: rgb(var(--color-text-secondary));
    }

    .photo-entry__count {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.55);
        color: #fff;
        font-size: var(--text-xs);
        font-weight: 600;
        backdrop-filter: blur(4px);
    }

    .photo-entry__count svg {
        width: 0.85rem;
        height: 0.85rem;
    }

    .photo-entry__overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: 0.25rem;
        padding: clamp(0.85rem, 2.5vw, 1.25rem);
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.72) 0%,
            rgba(0, 0, 0, 0.35) 45%,
            rgba(0, 0, 0, 0) 70%
        );
        color: #fff;
        opacity: 0;
        transition: opacity 220ms ease;
        pointer-events: none;
    }

    .photo-entry__media:hover .photo-entry__overlay,
    .photo-entry__media:focus-visible .photo-entry__overlay {
        opacity: 1;
    }

    .photo-entry__overlay-caption {
        font-size: var(--text-small);
        font-weight: 600;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .photo-entry :global(.photo-entry__overlay-date) {
        font-size: var(--text-xs);
        font-weight: 500;
        opacity: 0.85;
    }

    /* Placeholder tiles keep their text readable without the dark gradient */
    .photo-entry__media:has(.photo-entry__placeholder) .photo-entry__overlay {
        background: none;
        color: rgb(var(--color-text-secondary));
    }

    .photo-entry__media:has(.photo-entry__placeholder) .photo-entry__overlay-caption {
        display: none;
    }

    /* ------ Grid view (Pinterest-style masonry) ------ */

    .photo-feed[data-view="grid"] .photo-entry__media {
        border-radius: 0;
    }

    .photo-feed[data-view="grid"] .photo-entry__overlay {
        display: none;
    }

    .photo-feed[data-view="grid"] .photo-entry__media img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: unset;
    }

    .photo-feed[data-view="grid"] .photo-entry__media:hover img,
    .photo-feed[data-view="grid"] .photo-entry__media:focus-visible img {
        transform: scale(1.02);
    }

    .photo-feed[data-view="grid"] .photo-entry__info {
        display: none;
    }

    .photo-feed[data-view="grid"] .photo-grid {
        display: block;
        column-count: 2;
        column-gap: 3px;
    }

    .photo-feed[data-view="grid"] .photo-entry {
        display: block;
        break-inside: avoid;
        margin-bottom: 3px;
    }

    @media (min-width: 40rem) {
        .photo-feed[data-view="grid"] .photo-grid {
            column-count: 3;
            column-gap: clamp(0.5rem, 1.5vw, 0.85rem);
        }

        .photo-feed[data-view="grid"] .photo-entry {
            margin-bottom: clamp(0.5rem, 1.5vw, 0.85rem);
        }
    }

    @media (min-width: 64rem) {
        .photo-feed[data-view="grid"] .photo-grid {
            column-count: 4;
        }
    }

    /* ------ Single-column view (wide photos, caption + metadata below) ------ */

    .photo-feed[data-view="list"] .photo-grid {
        grid-template-columns: 1fr;
        gap: clamp(2rem, 5vw, 3rem);
    }

    .photo-feed[data-view="list"] .photo-entry__media img {
        height: auto;
        max-height: min(80vh, 44rem);
        object-fit: cover;
    }

    .photo-feed[data-view="list"] .photo-entry__overlay {
        display: none;
    }

    .photo-feed[data-view="list"] .photo-entry__info {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 0.85rem 0.25rem 0;
    }

    .photo-entry__title {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 700;
        line-height: 1.35;
    }

    .photo-entry__title a {
        color: rgb(var(--color-text-primary));
        text-decoration: none;
    }

    .photo-entry__caption {
        margin: 0;
        font-size: var(--text-small);
        line-height: 1.6;
        color: rgb(var(--color-text-secondary));
    }

    .photo-entry__meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 0.35rem;
    }

    .photo-entry__date-link {
        text-decoration: none;
        color: rgb(var(--color-text-secondary));
        font-size: var(--text-xs);
        font-weight: 500;
        transition: color 150ms ease;
    }

    .photo-entry__date-link:hover {
        color: rgb(var(--color-text-primary));
    }

    .photo-entry__tags {
        display: inline-flex;
        gap: 0.4rem;
        flex-wrap: wrap;
    }

    @media (prefers-reduced-motion: reduce) {
        .photo-entry__media,
        .photo-entry__media img,
        .photo-entry__overlay {
            transition: none;
        }

        .photo-feed[data-view="grid"] .photo-entry__media:hover img,
        .photo-feed[data-view="grid"] .photo-entry__media:focus-visible img {
            transform: none;
        }
    }
</style>
