---
import Layout from '../../layouts/Layout.astro';
import GardenGrid from '../../components/layout/GardenGrid.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for poems
const allPosts = await getAllPosts();
const poems = allPosts
  .filter(post => post.data.category === 'poem')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = poems.map(transformPost);
---

<Layout 
  title="Poems" 
  description="Poetry and verse" 
  currentPage="/poems/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
    <SectionLanding
      title="Poems"
      description="Poetry and verse from my collections."
      countText={`${transformedPosts.length} ${transformedPosts.length === 1 ? 'poem' : 'poems'}`}
      tagCategory="poem"
    >
      <GardenGrid posts={transformedPosts} contentType="poems" />
    </SectionLanding>
</Layout>
