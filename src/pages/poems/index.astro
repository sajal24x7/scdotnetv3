---
import Layout from '../../layouts/Layout.astro';
import GardenGrid from '../../components/layout/GardenGrid.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import { getAllPosts, transformPost } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';

// Get all posts and filter for poems
const allPosts = await getAllPosts();
const poems = allPosts
  .filter(post => post.data.category === 'poem')
  .sort((a, b) => new Date(b.data.created).getTime() - new Date(a.data.created).getTime());

// Transform posts into the shape the card grids expect
const transformedPosts = poems.map(transformPost);
const poemCount = transformedPosts.length;
const poemCountText = `${poemCount} ${poemCount === 1 ? 'poem' : 'poems'}`;

const sectionLandingProps = createSectionLandingProps(
  {
    title: 'Poems',
    description: 'Poetry and verse from my collections.',
    countText: poemCountText,
    tagCategory: 'poem',
    tagPosts: allPosts,
    contentClass: 'section-content--as-grid',
    rssUrl: '/poem/rss.xml'
  },
  'plainCount'
);
---

<Layout
  title="Poems"
  description="Poetry and verse"
  currentPage="/poems/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
    <SectionLanding {...sectionLandingProps}>
      <GardenGrid posts={transformedPosts} contentType="poems" />
    </SectionLanding>
  </Layout>
