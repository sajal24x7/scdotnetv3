---
import Layout from '../../layouts/Layout.astro';
import GardenGrid from '../../components/layout/GardenGrid.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import PopularTags from '../../components/PopularTags.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for poems
const allPosts = await getAllPosts();
const poems = allPosts
  .filter(post => post.data.category === 'poem')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = poems.map(transformPost);
---

<Layout 
  title="Poems" 
  description="Poetry and verse" 
  currentPage="/poems/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
    <PageHeader 
      title="Poems"
      description="Poetry and verse from my collections."
      layout="centered"
      size="lg"
      maxWidth="7xl"
    />
    
    <div class="poems-count mb-6 text-center">
      {transformedPosts.length} {transformedPosts.length === 1 ? 'poem' : 'poems'}
    </div>
    
    <PopularTags category="poem" />

    <main class="poems-main">
      <GardenGrid posts={transformedPosts} contentType="poems" />
    </main>
</Layout>

<style>
  .poems-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .poems-count {
    font-size: 0.875rem;
    font-weight: 500;
    color: #8b5cf6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.dark) .poems-count {
    color: #a78bfa;
  }

  .poems-main {
    padding-bottom: 2rem;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .poems-container {
      max-width: none;
      padding: 0;
    }

    .poems-main {
      padding-bottom: 1.5rem;
    }
  }
</style> 