---
import Layout from '../../../layouts/Layout.astro';
import NotesGrid from '../../../components/NotesGrid.astro';
import PageHeader from '../../../components/layout/PageHeader.astro';
import { getAllPosts, transformPost } from '../../../utils/content';

// Get all TIL posts
const allPosts = await getAllPosts();
const tilPosts = allPosts
  .filter(post => post.data.category === 'til')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the NotesGrid component
const transformedPosts = tilPosts.map(transformPost);
---

<Layout 
  title="TIL - Garden" 
  description="Today I Learned - Quick notes and discoveries" 
  currentPage="/garden/til/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
    <PageHeader 
      title="TIL"
      description="Today I Learned - Quick notes and discoveries from daily learning."
      layout="centered"
      size="lg"
    />
    
    <div class="til-count mb-6 text-center">
      {transformedPosts.length} {transformedPosts.length === 1 ? 'TIL note' : 'TIL notes'}
    </div>
    
    <div class="text-center mb-6">
      <a 
        href="/tags/?category=til" 
        class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
      >
        View entries by tag
      </a>
    </div>

    <main class="til-main">
      <NotesGrid posts={transformedPosts} />
    </main>
</Layout>

<style>
  .til-count {
    font-size: 0.875rem;
    font-weight: 500;
    color: #8b5cf6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.dark) .til-count {
    color: #a78bfa;
  }

  .til-main {
    padding-bottom: 2rem;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .til-main {
      padding-bottom: 1.5rem;
    }
  }
</style>