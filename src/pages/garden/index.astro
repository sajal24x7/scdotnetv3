---
import Layout from '../../layouts/Layout.astro';
import GardenGrid from '../../components/layout/GardenGrid.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for garden (evergreen, til, bookshelf, stories, poems)
const allPosts = await getAllPosts();
const gardenPosts = allPosts
  .filter(post => ['evergreen', 'til', 'bookshelf', 'story', 'poem'].includes(post.data.category))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the GardenGrid component
const transformedPosts = gardenPosts.map(transformPost);
---

<Layout 
  title="Garden" 
  description="Documentation, notes, and explorations" 
  currentPage="/garden/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
    <PageHeader 
      title="Garden"
      description="A collection of evergreen notes, learning, books, stories, and poems from my projects and explorations."
      layout="centered"
      size="lg"
      maxWidth="7xl"
    />
    
    <div class="garden-count mb-6 text-center">
      {transformedPosts.length} {transformedPosts.length === 1 ? 'note' : 'notes'}
    </div>
    
    <div class="text-center mb-6">
      <a 
        href="/tags/?category=garden" 
        class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
      >
        View entries by tag
      </a>
    </div>

    <main class="garden-main">
      <GardenGrid posts={transformedPosts} />
    </main>
</Layout>

<style>
  .garden-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .garden-count {
    font-size: 0.875rem;
    font-weight: 500;
    color: #8b5cf6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.dark) .garden-count {
    color: #a78bfa;
  }

  .garden-main {
    padding-bottom: 2rem;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .garden-container {
      max-width: none;
      padding: 0;
    }

    .garden-main {
      padding-bottom: 1.5rem;
    }
  }
</style> 