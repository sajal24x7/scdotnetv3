---
import Layout from '../../layouts/Layout.astro';
import GardenGrid from '../../components/layout/GardenGrid.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for garden (evergreen, til, bookshelf, stories, poems)
const allPosts = await getAllPosts();
const gardenPosts = allPosts
  .filter(post => ['evergreen', 'til', 'bookshelf', 'story', 'poem'].includes(post.data.category))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the GardenGrid component
const transformedPosts = gardenPosts.map(transformPost);
---

<Layout 
  title="Garden" 
  description="Documentation, notes, and explorations" 
  currentPage="/garden/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
    <SectionLanding
      title="Garden"
      description="A collection of evergreen notes, learning, books, stories, and poems from my projects and explorations."
      countText={`${transformedPosts.length} ${transformedPosts.length === 1 ? 'note' : 'notes'}`}
      tagCategory="garden"
    >
      <GardenGrid posts={transformedPosts} />
    </SectionLanding>
</Layout>
