---
import Layout from '../../layouts/Layout.astro';
import GardenGrid from '../../components/layout/GardenGrid.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import { getAllPosts, getPostsByCategory, transformPost } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';

// Get all posts and filter for garden (evergreen, til, bookshelf, stories, poems)
const allPosts = await getAllPosts();
const gardenPosts = getPostsByCategory(allPosts, 'garden');

// Transform posts for the GardenGrid component
const transformedPosts = gardenPosts.map(transformPost);
const noteCountText = `${transformedPosts.length} ${transformedPosts.length === 1 ? 'note' : 'notes'}`;

const sectionLandingProps = createSectionLandingProps({
  title: 'Garden',
  description: 'A collection of evergreen notes, learning, books, stories, and poems from my projects and explorations.',
  countText: noteCountText,
  tagCategory: 'garden',
  tagPosts: allPosts,
  contentClass: 'section-content--as-grid'
});
---

<Layout
  title="Garden"
  description="Documentation, notes, and explorations"
  currentPage="/garden/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
    <SectionLanding {...sectionLandingProps}>
      <GardenGrid posts={transformedPosts} />
    </SectionLanding>
  </Layout>
