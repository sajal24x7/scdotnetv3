---
import Layout from '../../../layouts/Layout.astro';
import NotesGrid from '../../../components/NotesGrid.astro';
import PageHeader from '../../../components/layout/PageHeader.astro';
import { getAllPosts, transformPost } from '../../../utils/content';

// Get all bookshelf posts
const allPosts = await getAllPosts();
const bookshelfPosts = allPosts
  .filter(post => post.data.category === 'bookshelf')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the NotesGrid component
const transformedPosts = bookshelfPosts.map(transformPost);
---

<Layout 
  title="Bookshelf - Garden" 
  description="Book notes and reading recommendations" 
  currentPage="/garden/bookshelf/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
    <PageHeader 
      title="Bookshelf"
      description="Book notes, reviews, and reading recommendations from my personal library."
      layout="centered"
      size="lg"
    />
    
    <div class="bookshelf-count mb-6 text-center">
      {transformedPosts.length} {transformedPosts.length === 1 ? 'book note' : 'book notes'}
    </div>
    
    <div class="text-center mb-6">
      <a 
        href="/tags/?category=bookshelf" 
        class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
      >
        View entries by tag
      </a>
    </div>

    <main class="bookshelf-main">
      <NotesGrid posts={transformedPosts} />
    </main>
</Layout>

<style>
  .bookshelf-count {
    font-size: 0.875rem;
    font-weight: 500;
    color: #8b5cf6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.dark) .bookshelf-count {
    color: #a78bfa;
  }

  .bookshelf-main {
    padding-bottom: 2rem;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .bookshelf-main {
      padding-bottom: 1.5rem;
    }
  }
</style>