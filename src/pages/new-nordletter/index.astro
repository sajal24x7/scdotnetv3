---
import Layout from '../../layouts/Layout.astro';
import ContentGrid from '../../components/ContentGrid.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for nordletter
const allPosts = await getAllPosts();
const nordletterPosts = allPosts
  .filter(post => post.data.category === 'nordletter')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = nordletterPosts.map(transformPost);
---

<Layout 
  title="Nordletter (New Layout)" 
  description="Monthly newsletter about life in the Nordics - Horizontal Layout" 
  currentPage="/new-nordletter/"
>
  <div class="max-w-7xl mx-auto">
    <header class="mb-12 px-6">
      <div class="flex flex-col">
        <h1 class="text-4xl font-bold mb-4">Nordletter (New Layout)</h1>
        <p class="text-xl text-textSecondary dark:text-textSecondaryDark mb-4">
          Monthly newsletter about life in the Nordics.
          <strong>This page uses the horizontal card layout like the main branch.</strong>
        </p>
        <div class="layout-info mb-6">
          <span class="layout-badge">Horizontal Layout</span>
          <a 
            href="/nordletter/" 
            class="compare-link"
          >
            ← Compare with old layout
          </a>
        </div>
        
        <a 
          href="/nordletter/tags" 
          class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
        >
          View entries by tag
        </a>
      </div>
    </header>

    <div class="px-6">
      <ContentGrid posts={transformedPosts} />
    </div>
  </div>
</Layout>

<style>
  .layout-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .layout-badge {
    background: #8b5cf6;
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .compare-link {
    color: #3b82f6;
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .compare-link:hover {
    color: #2563eb;
    text-decoration: underline;
  }

  :global(.dark) .compare-link {
    color: #60a5fa;
  }

  :global(.dark) .compare-link:hover {
    color: #93c5fd;
  }
</style>