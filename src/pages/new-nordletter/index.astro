---
import Layout from '../../layouts/Layout.astro';
import CircularGrid from '../../components/CircularGrid.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for nordletter
const allPosts = await getAllPosts();
const nordletterPosts = allPosts
  .filter(post => post.data.category === 'nordletter')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the CircularGrid component
const transformedPosts = nordletterPosts.map(transformPost);
---

<Layout 
  title="Nordletter (New Layout)" 
  description="Monthly newsletter about life in the Nordics - New Circular Layout" 
  currentPage="/new-nordletter/"
>
  <div class="max-w-7xl mx-auto">
    <header class="mb-12 px-6">
      <div class="flex flex-col">
        <h1 class="text-4xl font-bold mb-4">Nordletter (New Layout)</h1>
        <p class="text-xl text-textSecondary dark:text-textSecondaryDark mb-4">
          A weekly newsletter on living in Finland + 5 things from the web.
          <strong>This page uses the new AdaptiveCard component with circular layout.</strong>
        </p>
        <div class="layout-info mb-6">
          <span class="layout-badge">Circular Layout</span>
          <a 
            href="/nordletter/" 
            class="compare-link"
          >
            ← Compare with old layout
          </a>
        </div>
        
        <form
          class="flex flex-col sm:flex-row gap-3 max-w-md"
          action="https://buttondown.com/api/emails/embed-subscribe/sajal24x7"
          method="post"
          target="popupwindow"
          onsubmit="window.open('https://buttondown.com/sajal24x7', 'popupwindow')"
        >
          <input
            type="email"
            name="email"
            placeholder="Enter your email"
            required
            class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
          <button
            type="submit"
            class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors font-medium"
          >
            Subscribe
          </button>
        </form>
      </div>
    </header>

    <div class="px-6">
      <CircularGrid posts={transformedPosts} />
    </div>
  </div>
</Layout>

<style>
  .layout-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .layout-badge {
    background: #8b5cf6;
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .compare-link {
    color: #3b82f6;
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .compare-link:hover {
    color: #2563eb;
    text-decoration: underline;
  }

  :global(.dark) .compare-link {
    color: #60a5fa;
  }

  :global(.dark) .compare-link:hover {
    color: #93c5fd;
  }
</style>