---
import TvWatchPage from '../../../components/shelf/TvWatchPage.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { TvShow, TvWatch } from '../../../utils/shelfWall';

// There is no show page: each season page carries pills for every season.
// /tvshelf/<show>/ is a limited series' own page, or else redirects to the
// show's latest watch so old links keep working.
export async function getStaticPaths() {
    const { groupTvShows } = await import('../../../utils/shelfWall');
    const shows = groupTvShows(await getCollection('tvshelf'));
    return shows.map((show) => {
        const showPath = `/tvshelf/${show.showSlug}/`;
        // The latest limited-series watch at the show URL, if there is one.
        const own = [...show.watches].reverse().find((w) => w.path === showPath) ?? null;
        return {
            params: { show: show.showSlug },
            props: { show, watch: own },
        };
    });
}

interface Props {
    show: TvShow<CollectionEntry<'tvshelf'>>;
    watch: TvWatch<CollectionEntry<'tvshelf'>> | null;
}

const { show, watch } = Astro.props;
const target = show.latest.path;
---

{watch ? (
  <TvWatchPage show={show} watch={watch} />
) : (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <title>{show.showTitle} — TV Shelf</title>
      <meta http-equiv="refresh" content={`0; url=${target}`} />
      <meta name="robots" content="noindex" />
      <link rel="canonical" href={new URL(target, Astro.site ?? Astro.url).href} />
    </head>
    <body>
      <p><a href={target}>{show.showTitle}</a></p>
    </body>
  </html>
)}
