---
import '../../../styles/tv-detail.css';
import Layout from '../../../layouts/Layout.astro';
import ShelfTabNav from '../../../components/shelf/ShelfTabNav.astro';
import { Image } from 'astro:assets';
import { getAllPosts } from '../../../utils/content';
import { getCollection, render } from 'astro:content';
import { slugify } from '../../../utils/shelfUtils';
import { getTVCoverImage } from '../../../utils/tvCovers';
import {
    bookRatingDisplay,
    heartIconPaths,
    thumbIconPaths,
    type BookRating,
    type RatingIconSpec,
} from '../../../utils/bookRatings';
import { SHELF_STATUS_LABELS, type ShelfStatus } from '../../../utils/shelfStatus';
import { activityDate, hasShelfNotes } from '../../../utils/shelfWall';

export async function getStaticPaths() {
    const { getAllPosts } = await import('../../../utils/content');
    const { slugify } = await import('../../../utils/shelfUtils');
    const allPosts = await getAllPosts();
    const tvPosts = allPosts.filter((p) => p.data.category === 'tvshelf');

    const showMap = new Map<string, typeof tvPosts>();
    for (const post of tvPosts) {
        const key = post.data.showTitle ?? post.data.title ?? 'Unknown';
        if (!showMap.has(key)) showMap.set(key, []);
        showMap.get(key)!.push(post);
    }

    return Array.from(showMap.entries()).map(([showTitle, seasons]) => {
        // Use the show part of the first season's slug (e.g. "glory" from "glory/s1"),
        // falling back to slugify(showTitle) for entries without the new format.
        const firstSlug = seasons[0]?.id ?? '';
        const showSlug = firstSlug.split('/')[0] || slugify(showTitle);
        return {
            params: { show: showSlug },
            props: { showTitle, showSlug, seasons }
        };
    });
}

interface Props {
    showTitle: string;
    showSlug: string;
    seasons: Awaited<ReturnType<typeof getAllPosts>>;
}

const { showTitle, showSlug, seasons } = Astro.props;

const sortedSeasons = [...seasons].sort((a, b) => {
    return (a.data.season ?? 1) - (b.data.season ?? 1);
});

const latestSeason = [...seasons].sort((a, b) => (b.data.season ?? 1) - (a.data.season ?? 1))[0];

// Limited series: no entry has a season number — render content directly on this page.
const isLimitedSeries = seasons.every((s) => s.data.season === undefined);
const limitedPost = isLimitedSeries ? sortedSeasons[0] : null;
const limitedEntry = limitedPost
    ? (await getCollection('tvshelf')).find((entry) => entry.id === limitedPost.id)
    : null;
const { Content: LimitedContent } = limitedEntry ? await render(limitedEntry) : { Content: null };

const parseDate = (value?: Date | string | null): Date | null => {
    if (!value) return null;
    const d = value instanceof Date ? value : new Date(value);
    return Number.isNaN(d.getTime()) ? null : d;
};

const formatYMD = (value?: Date | string | null): string | null => {
    const d = parseDate(value);
    return d ? d.toISOString().slice(0, 10) : null;
};

const allPosts = await getAllPosts();

// Season pills: one per season number, linking to its latest watch. A second
// entry for the same season is a rewatch; todo stubs are left out.
const loggedSeasons = seasons
    .filter((s) => s.data.status !== 'todo' && s.data.season !== undefined)
    .sort((a, b) => activityDate(a.data).getTime() - activityDate(b.data).getTime());
const pillsBySeason = new Map<number, typeof loggedSeasons>();
for (const entry of loggedSeasons) {
    const num = entry.data.season as number;
    if (!pillsBySeason.has(num)) pillsBySeason.set(num, []);
    pillsBySeason.get(num)!.push(entry);
}
const seasonPills = Array.from(pillsBySeason.entries())
    .sort((a, b) => a[0] - b[0])
    .map(([num, watches]) => {
        const latest = watches[watches.length - 1];
        const status = latest.data.status as ShelfStatus | undefined;
        const rating = latest.data.rating as BookRating | undefined;
        const tip = [
            `Season ${num}`,
            watches.length > 1 ? `watched ${watches.length} times` : null,
            status && status !== 'finished' ? SHELF_STATUS_LABELS.tvshelf[status] : rating ? bookRatingDisplay[rating]?.label : null,
        ].filter(Boolean).join(', ');
        return {
            num,
            href: `/tvshelf/${showSlug}/${latest.id.split('/')[1] || `s${num}`}/`,
            // Reuse the page's chip colours: in-progress status first, then rating.
            tone: status === 'started' || status === 'paused' ? `chip--status-${status}` : rating ? `tv-chip--rating-${rating}` : 'tv-season-pill--plain',
            rewatched: watches.length > 1,
            notes: watches.some((w) => hasShelfNotes(w.body)),
            tip,
        };
    });

const statusLabelMap = SHELF_STATUS_LABELS.tvshelf;

const statusChipClassMap: Record<ShelfStatus, string> = {
    todo: 'chip--status-todo',
    started: 'chip--status-started',
    paused: 'chip--status-paused',
    finished: 'chip--status-finished',
};

const showCoverImage = latestSeason.data.cover ? getTVCoverImage(latestSeason.data.cover) : null;
const showCreators: string[] = Array.isArray(latestSeason.data.creator) ? latestSeason.data.creator : [];
const formatCreators = (creators: string[]) => {
    if (creators.length === 0) return null;
    if (creators.length === 1) return creators[0];
    if (creators.length === 2) return `${creators[0]} and ${creators[1]}`;
    return `${creators.slice(0, -1).join(', ')}, and ${creators[creators.length - 1]}`;
};
const formattedCreators = formatCreators(showCreators);
const showGenreLabel = latestSeason.data.genre ? (latestSeason.data.genre as string).toUpperCase() : null;
const showYear = latestSeason.data.year ?? null;

// Extra metadata for limited series header
const limitedStatus = limitedPost?.data.status as ShelfStatus | undefined;
const limitedRating = limitedPost?.data.rating;
const limitedPlatform = limitedPost?.data.platform as string | undefined;
const limitedStarted = formatYMD(limitedPost?.data.started);
const limitedFinished = formatYMD(limitedPost?.data.finished);
---

<Layout
  title={`${showTitle} — TV Shelf`}
  description={`All seasons of ${showTitle}`}
  currentPage="/tvshelf/"
  pageWrapper={{
    maxWidth: '4xl',
    padding: 'none',
    centered: true,
    grid: { gap: 'loose', padding: 'narrow' }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
  <div class="tv-show-page">
    <ShelfTabNav currentTab="tv" />

    <header class="tv-show-header">
      <div class="tv-show-header__cover-area">
        {showCoverImage ? (
          <Image
            src={showCoverImage}
            alt={`Poster for ${showTitle}`}
            class="tv-show-header__cover"
            loading="eager"
          />
        ) : (
          <div class="tv-show-header__cover-placeholder">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect>
              <polyline points="17 2 12 7 7 2"></polyline>
            </svg>
          </div>
        )}
      </div>
      <div class="tv-show-header__meta">
        <h1 class="tv-show-header__title">{showTitle}</h1>
        {formattedCreators && (
          <p class="tv-show-header__creator">Created by {formattedCreators}</p>
        )}
        <div class="tv-show-header__chips">
          {showGenreLabel && (
            <span class="tv-chip tv-chip--genre">
              <span class="tv-chip-label">Genre</span>
              {showGenreLabel}
            </span>
          )}
          {showYear && (
            <span class="tv-chip tv-chip--year">
              <span class="tv-chip-label">Year</span>
              {showYear as number}
            </span>
          )}
          {!isLimitedSeries && (
            <span class="tv-chip tv-chip--seasons">
              <span class="tv-chip-label">Seasons</span>
              {sortedSeasons.length}
            </span>
          )}
          {isLimitedSeries && limitedPlatform && (
            <span class="tv-chip tv-chip--platform">
              <span class="tv-chip-label">Platform</span>
              {limitedPlatform}
            </span>
          )}
          {isLimitedSeries && limitedStatus && limitedStatus !== 'finished' && (
            <span class={`tv-chip ${statusChipClassMap[limitedStatus]}`}>
              <span class="tv-chip-label">Status</span>
              {statusLabelMap[limitedStatus]}
            </span>
          )}
          {isLimitedSeries && limitedRating && (() => {
            const rd = bookRatingDisplay[limitedRating as BookRating];
            const specs: readonly RatingIconSpec[] = rd?.iconSpecs ?? [];
            return rd ? (
              <span class={`tv-chip tv-chip--rating tv-chip--rating-${limitedRating}`}>
                <span class="tv-chip-label">Rated</span>
                {specs.length > 0 && (
                  <span class="tv-chip__icons" aria-hidden="true">
                    {specs.map((spec) => (
                      <svg width={spec.size} height={spec.size} viewBox="0 0 24 24" fill="currentColor">
                        {(spec.type === 'heart' ? heartIconPaths : thumbIconPaths[spec.direction]).map((d) => (
                          <path d={d}></path>
                        ))}
                      </svg>
                    ))}
                  </span>
                )}
              </span>
            ) : null;
          })()}
          {isLimitedSeries && (limitedStarted || limitedFinished) && (
            <span class="tv-chip tv-chip--dates">
              {limitedStarted && limitedFinished
                ? `${limitedStarted} – ${limitedFinished}`
                : limitedStarted ?? limitedFinished}
            </span>
          )}
        </div>
      </div>
    </header>

    {isLimitedSeries && LimitedContent && (
      <div class="season-content">
        <LimitedContent />
      </div>
    )}

    {seasonPills.length > 1 && (
      <nav class="tv-season-pills" aria-label="Seasons">
        {seasonPills.map((pill) => (
          <a href={pill.href} class={`tv-season-pill ${pill.tone}`} title={pill.tip}>
            S{pill.num}
            {pill.rewatched && (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 11V9a3 3 0 0 1 3-3h12"></path><path d="m16 3 3 3-3 3"></path><path d="M20 13v2a3 3 0 0 1-3 3H5"></path><path d="m8 21-3-3 3-3"></path>
              </svg>
            )}
            {pill.notes && (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                <path d="M5 6h14"></path><path d="M5 10.5h14"></path><path d="M5 15h10"></path><path d="M5 19.5h6"></path>
              </svg>
            )}
            <span class="sr-only">{pill.tip}</span>
          </a>
        ))}
      </nav>
    )}

    {!isLimitedSeries && (
    <section class="tv-show-page__seasons">
      <h2 class="tv-show-page__seasons-title">Seasons</h2>
      <div class="tv-show-page__seasons-list">
        {sortedSeasons.map((season) => {
          const seasonNum = season.data.season ?? 1;
          const seasonSlug = season.id.split('/')[1] || `s${seasonNum}`;
          const status = season.data.status as ShelfStatus | undefined;
          const statusLabel = status ? statusLabelMap[status] : null;
          const statusChipClass = status ? statusChipClassMap[status] : '';
          const ratingDisplay = season.data.rating ? bookRatingDisplay[season.data.rating as BookRating] : null;
          const ratingIconSpecs: readonly RatingIconSpec[] = ratingDisplay?.iconSpecs ?? [];
          const watchedDate = formatYMD(season.data.finished ?? season.data.created);
          const coverImage = season.data.cover ? getTVCoverImage(season.data.cover) : null;

          return (
            <a href={`/tvshelf/${showSlug}/${seasonSlug}/`} class="tv-season-card">
              {coverImage && (
                <div class="tv-season-card__cover-wrap">
                  <Image
                    src={coverImage}
                    alt={`Season ${seasonNum} poster`}
                    width={80}
                    height={120}
                    class="tv-season-card__cover"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="tv-season-card__body">
                <div class="tv-season-card__heading">
                  <span class="tv-season-card__label">Season {seasonNum}</span>
                  {season.data.title && season.data.title !== showTitle && (
                    <span class="tv-season-card__subtitle"> — {season.data.title}</span>
                  )}
                </div>
                <div class="tv-season-card__chips">
                  {statusLabel && status && status !== 'finished' && (
                    <span class={`tv-chip ${statusChipClass}`}>
                      <span class="tv-chip-label">Status</span>
                      {statusLabel}
                    </span>
                  )}
                  {ratingDisplay && (
                    <span class={`tv-chip tv-chip--rating tv-chip--rating-${season.data.rating}`}>
                      <span class="tv-chip-label">Rated</span>
                      {ratingIconSpecs.length > 0 && (
                        <span class="tv-chip__icons" aria-hidden="true">
                          {ratingIconSpecs.map((spec) => (
                            <svg width={spec.size} height={spec.size} viewBox="0 0 24 24" fill="currentColor">
                              {(spec.type === 'heart' ? heartIconPaths : thumbIconPaths[spec.direction]).map((d) => (
                                <path d={d}></path>
                              ))}
                            </svg>
                          ))}
                        </span>
                      )}
                    </span>
                  )}
                  {watchedDate && status === 'finished' && (
                    <span class="tv-chip tv-chip--date">
                      <span class="tv-chip-label">Watched</span>
                      {watchedDate}
                    </span>
                  )}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>
    )}

    <div class="tv-show-page__back">
      <a href="/tvshelf/" class="tv-show-page__back-link">← Back to TV Shelf</a>
    </div>
  </div>
</Layout>

<style>
  .tv-show-page__seasons-title {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--gray-text-muted);
    margin: 0 0 1rem;
  }

  .tv-show-page__seasons-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .tv-season-card {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.02);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 0.75rem;
    align-items: flex-start;
    text-decoration: none;
    color: inherit;
    transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .tv-season-card:hover {
    background: rgba(99, 102, 241, 0.04);
    border-color: rgba(99, 102, 241, 0.2);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.08), 0 8px 24px rgba(129, 140, 248, 0.15);
    transform: translateY(-2px);
  }

  :global(.dark) .tv-season-card {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.08);
  }

  :global(.dark) .tv-season-card:hover {
    background: rgba(99, 102, 241, 0.08);
    border-color: rgba(99, 102, 241, 0.3);
  }

  .tv-season-card__cover-wrap {
    flex-shrink: 0;
  }

  .tv-season-card__cover {
    width: 3.5rem;
    height: auto;
    border-radius: 0.35rem;
    object-fit: cover;
  }

  .tv-season-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
  }

  .tv-season-card__heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--gray-text-strong);
  }

  .tv-season-card__label {
    font-weight: 700;
  }

  .tv-season-card__subtitle {
    font-weight: 400;
    color: var(--gray-text-muted);
  }

  .tv-season-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tv-chip--seasons { background: var(--pill-bg); color: var(--pill-fg); text-transform: none; font-size: var(--text-xs); letter-spacing: 0.03em; }

  .tv-chip--date { background: var(--pill-bg); color: var(--pill-fg); text-transform: none; font-size: var(--text-xs); letter-spacing: 0.03em; }

  .tv-show-page__back {
    margin-top: 1rem;
  }

  .tv-season-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .tv-season-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font-size: var(--text-small);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }

  .tv-season-pill--plain {
    background: var(--pill-bg);
    color: var(--pill-fg);
  }

  .tv-season-pill:hover,
  .tv-season-pill:focus-visible {
    border-color: currentColor;
  }
</style>
