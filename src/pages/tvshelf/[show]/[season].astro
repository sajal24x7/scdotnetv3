---
import '../../../styles/tv-detail.css';
import Layout from '../../../layouts/Layout.astro';
import ShelfTabNav from '../../../components/shelf/ShelfTabNav.astro';
import { Image } from 'astro:assets';
import { getAllPosts } from '../../../utils/content';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { slugify } from '../../../utils/shelfUtils';
import { getTVCoverImage } from '../../../utils/tvCovers';
import {
    bookRatingDisplay,
    heartIconPaths,
    thumbIconPaths,
    type BookRating,
    type RatingIconSpec
} from '../../../utils/bookRatings';
import { SHELF_STATUS_LABELS, type ShelfStatus } from '../../../utils/shelfStatus';

export async function getStaticPaths() {
    const { slugify } = await import('../../../utils/shelfUtils');
    const tvPosts = await getCollection('tvshelf');

    const showMap = new Map<string, CollectionEntry<'tvshelf'>[]>();
    for (const post of tvPosts) {
        const key = post.data.showTitle ?? post.data.title ?? 'Unknown';
        if (!showMap.has(key)) showMap.set(key, []);
        showMap.get(key)!.push(post);
    }

    const paths: { params: { show: string; season: string }; props: any }[] = [];
    for (const [showTitle, seasons] of showMap.entries()) {
        const sortedSeasons = [...seasons].sort((a, b) => (a.data.season ?? 1) - (b.data.season ?? 1));
        // Derive show slug from the first season's slug (e.g. "glory" from "glory/s1")
        const firstSlug = sortedSeasons[0]?.id ?? '';
        const showSlug = firstSlug.split('/')[0] || slugify(showTitle);

        for (const season of seasons) {
            // Posts without season metadata are limited series — no season subpage.
            if (season.data.season === undefined) continue;
            const parts = season.id.split('/');
            const seasonNum = season.data.season;
            const seasonSlug = parts[1] || `s${seasonNum}`;
            paths.push({
                params: { show: showSlug, season: seasonSlug },
                props: { showTitle, showSlug, season, allSeasons: sortedSeasons }
            });
        }
    }
    return paths;
}

interface Props {
    showTitle: string;
    showSlug: string;
    season: CollectionEntry<'tvshelf'>;
    allSeasons: CollectionEntry<'tvshelf'>[];
}

const { showTitle, showSlug, season, allSeasons } = Astro.props;
const seasonNum = season.data.season ?? 1;

const allPosts = await getAllPosts();
const { Content } = await render(season);

const parseDate = (value?: Date | string | null): Date | null => {
    if (!value) return null;
    const d = value instanceof Date ? value : new Date(value);
    return Number.isNaN(d.getTime()) ? null : d;
};

const formatYMD = (value?: Date | string | null): string | null => {
    const d = parseDate(value);
    return d ? d.toISOString().slice(0, 10) : null;
};

const creators: string[] = Array.isArray(season.data.creator) ? season.data.creator : [];
const formatCreators = (arr: string[]) => {
    if (arr.length === 0) return null;
    if (arr.length === 1) return arr[0];
    if (arr.length === 2) return `${arr[0]} and ${arr[1]}`;
    return `${arr.slice(0, -1).join(', ')}, and ${arr[arr.length - 1]}`;
};

const genre = season.data.genre as string | undefined;
const year = season.data.year as number | undefined;
const platform = season.data.platform as string | undefined;
const started = formatYMD(season.data.started);
const finished = formatYMD(season.data.finished);
const tvStatus = season.data.status as ShelfStatus | undefined;
const tvRating = season.data.rating;

const statusLabelMap = SHELF_STATUS_LABELS.tvshelf;

const statusChipClassMap: Record<ShelfStatus, string> = {
    todo: 'chip--status-todo',
    started: 'chip--status-started',
    paused: 'chip--status-paused',
    finished: 'chip--status-finished',
};

const ratingDisplay = tvRating ? bookRatingDisplay[tvRating as BookRating] : null;
const ratingIconSpecs: readonly RatingIconSpec[] = ratingDisplay?.iconSpecs ?? [];

const coverImage = season.data.cover ? getTVCoverImage(season.data.cover) : null;
---

<Layout
  title={`${showTitle} — Season ${seasonNum} — TV Shelf`}
  description={`Season ${seasonNum} of ${showTitle}`}
  currentPage="/tvshelf/"
  pageWrapper={{
    maxWidth: '4xl',
    padding: 'none',
    centered: true,
    grid: { gap: 'loose', padding: 'narrow' }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
  <div class="season-page">
    <ShelfTabNav currentTab="tv" />

    <header class="season-header">
      <div class="season-header__cover-area">
        {coverImage ? (
          <Image
            src={coverImage}
            alt={`Poster for ${showTitle} Season ${seasonNum}`}
            class="season-header__cover"
            loading="eager"
          />
        ) : (
          <div class="season-header__cover-placeholder">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect>
              <polyline points="17 2 12 7 7 2"></polyline>
            </svg>
          </div>
        )}
      </div>

      <div class="season-header__meta">
        <h1 class="season-header__title">{showTitle}</h1>

        {formatCreators(creators) && (
          <p class="season-header__creator">Created by {formatCreators(creators)}</p>
        )}

        <div class="season-header__chips">
          <span class="tv-chip tv-chip--season">
            <span class="tv-chip-label">Season</span>
            {seasonNum}
          </span>

          {genre && (
            <span class="tv-chip tv-chip--genre">
              <span class="tv-chip-label">Genre</span>
              {genre.toUpperCase()}
            </span>
          )}

          {year && (
            <span class="tv-chip tv-chip--year">
              <span class="tv-chip-label">Year</span>
              {year}
            </span>
          )}

          {platform && (
            <span class="tv-chip tv-chip--platform">
              <span class="tv-chip-label">Platform</span>
              {platform}
            </span>
          )}

          {tvStatus && tvStatus !== 'finished' && (
            <span class={`tv-chip ${statusChipClassMap[tvStatus]}`}>
              <span class="tv-chip-label">Status</span>
              {statusLabelMap[tvStatus]}
            </span>
          )}

          {ratingDisplay && (
            <span class={`tv-chip tv-chip--rating tv-chip--rating-${tvRating}`}>
              <span class="tv-chip-label">Rated</span>
              {ratingIconSpecs.length > 0 && (
                <span class="tv-chip__icons" aria-hidden="true">
                  {ratingIconSpecs.map((spec) => (
                    <svg width={spec.size} height={spec.size} viewBox="0 0 24 24" fill="currentColor">
                      {(spec.type === 'heart' ? heartIconPaths : thumbIconPaths[spec.direction]).map((d) => (
                        <path d={d}></path>
                      ))}
                    </svg>
                  ))}
                </span>
              )}
            </span>
          )}

          {(started || finished) && (
            <span class="tv-chip tv-chip--dates">
              {started && finished ? `${started} – ${finished}` : started ?? finished}
            </span>
          )}

          <a href={`/tvshelf/${showSlug}/`} class="tv-chip tv-chip--show-link">
            <span class="tv-chip-label">Show</span>
            {showTitle}
            <span class="tv-chip--show-link__seasons">
              {allSeasons.length} {allSeasons.length === 1 ? 'season' : 'seasons'}
            </span>
          </a>
        </div>
      </div>
    </header>

    {/* Season content / notes */}
    <div class="season-content">
      <Content />
    </div>

    <div class="season-nav">
      {allSeasons.find((s) => (s.data.season ?? 1) < seasonNum) && (() => {
        const prev = [...allSeasons].reverse().find((s) => (s.data.season ?? 1) < seasonNum);
        const prevNum = prev?.data.season ?? 1;
        const prevSlug = (prev?.data.slug ?? '').split('/')[1] || `s${prevNum}`;
        return (
          <a href={`/tvshelf/${showSlug}/${prevSlug}/`} class="season-nav__link season-nav__link--prev">
            ← Season {prevNum}
          </a>
        );
      })()}
      <a href={`/tvshelf/${showSlug}/`} class="season-nav__link season-nav__link--show">
        All seasons
      </a>
      {allSeasons.find((s) => (s.data.season ?? 1) > seasonNum) && (() => {
        const next = allSeasons.find((s) => (s.data.season ?? 1) > seasonNum);
        const nextNum = next?.data.season ?? seasonNum + 1;
        const nextSlug = (next?.data.slug ?? '').split('/')[1] || `s${nextNum}`;
        return (
          <a href={`/tvshelf/${showSlug}/${nextSlug}/`} class="season-nav__link season-nav__link--next">
            Season {nextNum} →
          </a>
        );
      })()}
    </div>

    <div class="season-back">
      <a href="/tvshelf/" class="season-back__link">← Back to TV Shelf</a>
    </div>
  </div>
</Layout>

<style>
  /* Season nav */
  .season-nav {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  :global(.dark) .season-nav {
    border-top-color: rgba(255, 255, 255, 0.08);
  }

  .season-nav__link--show {
    margin-left: auto;
    margin-right: auto;
  }

  /* Back link */
  .season-back {
    margin-top: 0.5rem;
  }

  .tv-chip--season { background: var(--pill-bg); color: var(--pill-fg); text-transform: none; font-size: var(--text-xs); letter-spacing: 0.02em; font-weight: 700; }

  /* Show link chip — styled as a small interactive box */
  .tv-chip--show-link {
    background: #ede9fe;
    color: #5b21b6;
    text-decoration: none;
    border: 1px solid rgba(91, 33, 182, 0.2);
    transition: background-color 150ms ease, border-color 150ms ease;
    text-transform: none;
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    gap: 0.35rem;
  }

  .tv-chip--show-link:hover {
    background: #ddd6fe;
    border-color: rgba(91, 33, 182, 0.4);
  }

  :global(.dark) .tv-chip--show-link {
    background: rgba(91, 33, 182, 0.2);
    color: #c4b5fd;
    border-color: rgba(139, 92, 246, 0.3);
  }

  :global(.dark) .tv-chip--show-link:hover {
    background: rgba(91, 33, 182, 0.35);
    border-color: rgba(139, 92, 246, 0.5);
  }

  .tv-chip--show-link__seasons {
    opacity: 0.65;
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
  }
</style>
