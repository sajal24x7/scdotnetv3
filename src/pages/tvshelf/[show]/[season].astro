---
import TvWatchPage from '../../../components/shelf/TvWatchPage.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { TvShow, TvWatch } from '../../../utils/shelfWall';

// One page per logged season watch: /tvshelf/friends/s1/, /tvshelf/friends/s1-2026/.
export async function getStaticPaths() {
    const { groupTvShows } = await import('../../../utils/shelfWall');
    const shows = groupTvShows(await getCollection('tvshelf'));
    return shows.flatMap((show) => show.watches
        // A limited series' first watch lives at the show URL itself.
        .filter((watch) => watch.path !== `/tvshelf/${show.showSlug}/`)
        .map((watch) => ({
            params: { show: show.showSlug, season: watch.path.split('/')[3] },
            props: { show, watch },
        })));
}

interface Props {
    show: TvShow<CollectionEntry<'tvshelf'>>;
    watch: TvWatch<CollectionEntry<'tvshelf'>>;
}

const { show, watch } = Astro.props;
---

<TvWatchPage show={show} watch={watch} />
