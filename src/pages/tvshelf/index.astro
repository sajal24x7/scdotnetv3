---
import '../../styles/shelf-year.css';
import Layout from '../../layouts/Layout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import TVCard from '../../components/shelf/TVCard.astro';
import ShelfQueueToggle from '../../components/shelf/ShelfQueueToggle.astro';
import ShelfFilterResults from '../../components/shelf/ShelfFilterResults.astro';
import { getAllPosts } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';
import { slugify } from '../../utils/shelfUtils';
import { SHELF_LIST_SORT_PRIORITY, type ShelfStatus } from '../../utils/shelfStatus';

const allPosts = await getAllPosts();
// `todo` entries live on the queue page (/tvshelf/queue/) only — see
// planning/shelf-queue-design.md §1.
const tvPosts = allPosts.filter((post) => post.data.category === 'tvshelf' && post.data.status !== 'todo');

const parseDate = (value?: Date | string | null): Date | null => {
    if (!value) return null;
    const d = value instanceof Date ? value : new Date(value);
    return Number.isNaN(d.getTime()) ? null : d;
};

// Most recent activity date for an entry: finished > started > created.
const activityDate = (post: typeof tvPosts[number]): Date => {
    const finished = parseDate(post.data.finished);
    if (finished) return finished;
    const started = parseDate(post.data.started);
    if (started) return started;
    return parseDate(post.data.created) ?? new Date();
};

// Split slug like "glory/s1" into show and season parts.
// When post.data.season is undefined the show is treated as a limited series
// (single season) and seasonSlug is left undefined — the card links to the
// show overview page rather than a season subpage.
function parsePostSlug(post: typeof tvPosts[number]) {
    const parts = post.id.split('/');
    const showTitle = post.data.showTitle ?? post.data.title ?? 'Unknown';
    const hasSeason = post.data.season !== undefined;
    const seasonNum = post.data.season ?? 1;
    return {
        showSlug: parts[0] || slugify(showTitle),
        seasonSlug: hasSeason ? (parts[1] || `s${seasonNum}`) : undefined
    };
}

interface SeasonEntry {
    post: typeof tvPosts[number];
    showTitle: string;
    showSlug: string;
    seasonSlug: string | undefined;
    seasonNum: number;
    year: number;
    tvStatus: ShelfStatus | undefined;
}

const seasonEntries: SeasonEntry[] = tvPosts.map((post) => {
    const { showSlug, seasonSlug } = parsePostSlug(post);
    return {
        post,
        showTitle: post.data.showTitle ?? post.data.title ?? 'Unknown',
        showSlug,
        seasonSlug,
        seasonNum: post.data.season ?? 1,
        year: activityDate(post).getFullYear(),
        tvStatus: post.data.status as ShelfStatus | undefined
    };
});

seasonEntries.sort((a, b) => {
    if (a.year !== b.year) return b.year - a.year;
    const sA = a.tvStatus ? SHELF_LIST_SORT_PRIORITY[a.tvStatus] : 99;
    const sB = b.tvStatus ? SHELF_LIST_SORT_PRIORITY[b.tvStatus] : 99;
    return sA - sB;
});

const years = Array.from(new Set(seasonEntries.map((e) => e.year)));

const entriesByYear = seasonEntries.reduce((acc, entry) => {
    if (!acc[entry.year]) acc[entry.year] = [];
    acc[entry.year].push(entry);
    return acc;
}, {} as Record<number, SeasonEntry[]>);

const watchedCount = seasonEntries.filter((e) => e.tvStatus === 'finished').length;
const countText = `${watchedCount} ${watchedCount === 1 ? 'season' : 'seasons'} watched`;

const tvDescription = "TV shows I've watched, am watching, or want to watch—organized by year.";

const sectionLandingProps = createSectionLandingProps({
    title: 'TV Shelf',
    countText,
    countVariant: 'plain',
    countClass: 'bookshelf-count',
    tagCategory: 'tvshelf',
    tagPosts: allPosts,
    contentClass: 'bookshelf-content',
    hideTitle: true
});
---

<Layout
  title="TV Shelf"
  description="TV shows I've watched and want to watch"
  currentPage="/tvshelf/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: { gap: 'loose', padding: 'narrow' }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
  <SectionLanding {...sectionLandingProps}>
    <div slot="afterHeader" class="shelf-header-block">
      <div class="shelf-title-row">
        <ShelfQueueToggle category="tvshelf" active="shelf" />
      </div>
      <p class="shelf-description">{tvDescription}</p>
    </div>
    <ShelfFilterResults />
    <div class="bookshelf-years">
      {years.map((year) => {
        const yearEntries = entriesByYear[year] ?? [];
        const watchedYear = yearEntries.filter((e) => e.tvStatus === 'finished').length;
        const seasonLabel = watchedYear === 1 ? 'season' : 'seasons';

        const yearRowCount = Math.ceil(yearEntries.length / 2);

        return (
          <section class="bookshelf-year" id={`tvshelf-${year}`} data-year={year}>
            <div class="bookshelf-year__grid twelve-grid grid-gap-tight">
              <div class="bookshelf-year__sidebar grid-span-2" style={`--year-row-count: ${yearRowCount};`}>
                <div class="bookshelf-year__sticky">
                  <span class="bookshelf-year__year">{year}</span>
                  <span class="bookshelf-year__count" data-year-count={year}>Watched {watchedYear} {seasonLabel}</span>
                </div>
              </div>
              {yearEntries.map((entry, index) => {
                const gridClasses = index % 2 === 0 ? 'grid-span-5 grid-start-3' : 'grid-span-5 grid-start-8';
                const { post, showTitle, showSlug, seasonSlug, seasonNum } = entry;
                return (
                  <div
                    class={`bookshelf-year__book ${gridClasses}`}
                    data-shelf-item
                    data-tags={Array.isArray(post.data.tags) ? post.data.tags.join(',') : ''}
                    data-creator={Array.isArray(post.data.creator) ? post.data.creator.join(',') : ''}
                    data-genre={post.data.genre ?? ''}
                    data-platform={post.data.platform ?? ''}
                    data-status={entry.tvStatus ?? ''}
                    data-rating={post.data.rating ?? ''}
                  >
                    <TVCard
                      title={showTitle}
                      showSlug={showSlug}
                      seasonSlug={seasonSlug}
                      seasonNumber={seasonNum}
                      creator={post.data.creator}
                      year={post.data.year as number | undefined}
                      genre={post.data.genre}
                      platform={post.data.platform}
                      status={entry.tvStatus as any}
                      rating={post.data.rating}
                      cover={post.data.cover}
                    />
                  </div>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </SectionLanding>
</Layout>


<script>
  import { initShelfFilters } from '../../scripts/shelfFilters';

  function initTvshelfFilters() {
    initShelfFilters({
      itemSelector: '[data-shelf-item]',
      countNoun: { singular: 'season', plural: 'seasons' },
      filterTypes: [
        { type: 'creator' },
        { type: 'genre', badgeClass: () => 'shelf-filter-badge--genre' },
        {
          type: 'status',
          labels: { todo: 'To Watch', started: 'Watching', paused: 'On Hold', finished: 'Watched' },
          badgeClass: (value) => `shelf-filter-badge--status-${value}`,
        },
        { type: 'platform' },
        {
          type: 'rating',
          labels: { like: 'Like', love: 'Love', nope: 'Nope' },
          badgeClass: (value) => `shelf-filter-badge--rating-${value}`,
        },
        { type: 'tag', badgeClass: () => 'shelf-filter-badge--tag' },
      ],
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTvshelfFilters);
  } else {
    initTvshelfFilters();
  }
</script>
