---
import '../../styles/shelf-wall.css';
import Layout from '../../layouts/Layout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import ShelfTile from '../../components/shelf/ShelfTile.astro';
import ShelfViewControls from '../../components/shelf/ShelfViewControls.astro';
import ShelfQueueToggle from '../../components/shelf/ShelfQueueToggle.astro';
import ShelfFilterResults from '../../components/shelf/ShelfFilterResults.astro';
import { getAllPosts } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';
import { groupTvShows, mostCommonRating, repeatLabel, seasonRangeLabel } from '../../utils/shelfWall';
import { getTVCoverImage } from '../../utils/tvCovers';
import { bookRatingOrder, type BookRating } from '../../utils/bookRatings';
import { SHELF_LIST_SORT_PRIORITY, SHELF_STATUS_LABELS, type ShelfStatus } from '../../utils/shelfStatus';

const allPosts = await getAllPosts();
// Every tvshelf entry goes in so show slugs match /tvshelf/[show]/; todo stubs
// are dropped from the shows themselves and live on /tvshelf/queue/ only.
const shows = groupTvShows(allPosts.filter((post) => post.data.category === 'tvshelf'));

const unique = (values: (string | undefined | null)[]) =>
    Array.from(new Set(values.filter((v): v is string => Boolean(v))));

// One tile per show, filed under the year of its latest watch.
const tiles = shows.map((show) => {
    const { latest, watches } = show;
    const status: ShelfStatus = watches.some((w) => w.post.data.status === 'started')
        ? 'started'
        : (latest.post.data.status as ShelfStatus) ?? 'finished';
    const ratings = watches.map((w) => w.post.data.rating as BookRating | undefined);
    const maxWatch = Math.max(...watches.map((w) => w.watchNumber));
    return {
        show,
        year: latest.date.getUTCFullYear(),
        status,
        rating: mostCommonRating(ratings, bookRatingOrder),
        ratings: unique(ratings),
        genre: latest.post.data.genre ?? watches.find((w) => w.post.data.genre)?.post.data.genre,
        genres: unique(watches.map((w) => w.post.data.genre)),
        creators: latest.post.data.creator ?? [],
        allCreators: unique(watches.flatMap((w) => w.post.data.creator ?? [])),
        platforms: unique(watches.map((w) => w.post.data.platform)),
        tags: unique(watches.flatMap((w) => (Array.isArray(w.post.data.tags) ? w.post.data.tags : []))),
        cover: latest.post.data.cover ?? watches.find((w) => w.post.data.cover)?.post.data.cover,
        seasons: seasonRangeLabel(watches.map((w) => w.season)),
        repeat: maxWatch > 1 ? repeatLabel(maxWatch, 'watch') : null,
        notes: watches.some((w) => w.notes),
    };
});

// Year desc, then in-progress first, then most recent activity.
tiles.sort((a, b) => {
    if (a.year !== b.year) return b.year - a.year;
    const byStatus = SHELF_LIST_SORT_PRIORITY[a.status] - SHELF_LIST_SORT_PRIORITY[b.status];
    if (byStatus !== 0) return byStatus;
    return b.show.latest.date.getTime() - a.show.latest.date.getTime();
});

const years = Array.from(new Set(tiles.map((t) => t.year)));

const finishedSeasonsIn = (year: number) => shows.reduce((count, show) =>
    count + show.watches.filter((w) => w.post.data.status === 'finished' && w.date.getUTCFullYear() === year).length, 0);

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const totalSeasons = shows.reduce((n, s) => n + s.watches.filter((w) => w.post.data.status === 'finished').length, 0);
const countText = `${plural(shows.length, 'show', 'shows')} · ${plural(totalSeasons, 'season', 'seasons')} watched`;

const tvDescription = "TV shows I've watched or am watching, one cover per show, filed under the year I last watched it.";

const sectionLandingProps = createSectionLandingProps({
    title: 'TV Shelf',
    countText,
    countVariant: 'plain',
    countClass: 'bookshelf-count',
    tagCategory: 'tvshelf',
    tagPosts: allPosts,
    contentClass: 'bookshelf-content',
    hideTitle: true
});
---

<Layout
  title="TV Shelf"
  description="TV shows I've watched and want to watch"
  currentPage="/tvshelf/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: { gap: 'loose', padding: 'narrow' }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
  <SectionLanding {...sectionLandingProps}>
    <div slot="afterHeader" class="shelf-header-block">
      <div class="shelf-title-row">
        <ShelfQueueToggle category="tvshelf" active="shelf" />
      </div>
      <p class="shelf-description">{tvDescription}</p>
    </div>
    <ShelfViewControls />
    <ShelfFilterResults />
    <div class="shelf-years">
      {years.map((year) => {
        const yearTiles = tiles.filter((t) => t.year === year);
        const seasonCount = finishedSeasonsIn(year);

        return (
          <section class="shelf-year" id={`tvshelf-${year}`} data-year={year}>
            <header class="shelf-year__head">
              <h2 class="shelf-year__year">{year}</h2>
              <span class="shelf-year__count" data-year-count={year}>
                {plural(yearTiles.length, 'show', 'shows')} · Watched {plural(seasonCount, 'season', 'seasons')}
              </span>
            </header>
            <ul class="shelf-wall">
              {yearTiles.map((tile) => (
                <li
                  class="shelf-wall__item"
                  data-shelf-item
                  data-tags={tile.tags.join(',')}
                  data-creator={tile.allCreators.join(',')}
                  data-genre={tile.genres.join(',')}
                  data-platform={tile.platforms.join(',')}
                  data-status={tile.status}
                  data-rating={tile.ratings.join(',')}
                  data-sort-date={tile.show.latest.date.toISOString()}
                  data-sort-status={SHELF_LIST_SORT_PRIORITY[tile.status]}
                  data-sort-title={tile.show.showTitle.toLowerCase()}
                  data-sort-rating={tile.rating ? bookRatingOrder.indexOf(tile.rating) : 9}
                >
                  <ShelfTile
                    title={tile.show.showTitle}
                    href={`/tvshelf/${tile.show.showSlug}/`}
                    cover={tile.cover ? getTVCoverImage(tile.cover) : null}
                    people={tile.creators}
                    personFilter="creator"
                    subtitle={tile.seasons}
                    status={tile.status}
                    statusLabel={SHELF_STATUS_LABELS.tvshelf[tile.status]}
                    rating={tile.rating}
                    genre={tile.genre}
                    repeat={tile.repeat}
                    notes={tile.notes}
                    date={tile.show.latest.date}
                  />
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
  </SectionLanding>
</Layout>

<script>
  import { initShelfFilters } from '../../scripts/shelfFilters';

  function initTvshelfFilters() {
    initShelfFilters({
      itemSelector: '[data-shelf-item]',
      countNoun: { singular: 'show', plural: 'shows' },
      filterTypes: [
        { type: 'creator' },
        { type: 'genre', badgeClass: () => 'shelf-filter-badge--genre' },
        {
          type: 'status',
          labels: { todo: 'To Watch', started: 'Watching', paused: 'On Hold', finished: 'Watched' },
          badgeClass: (value) => `shelf-filter-badge--status-${value}`,
        },
        { type: 'platform' },
        {
          type: 'rating',
          labels: { like: 'Like', love: 'Love', nope: 'Nope' },
          badgeClass: (value) => `shelf-filter-badge--rating-${value}`,
        },
        { type: 'tag', badgeClass: () => 'shelf-filter-badge--tag' },
      ],
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTvshelfFilters);
  } else {
    initTvshelfFilters();
  }
</script>
