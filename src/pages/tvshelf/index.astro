---
import '../../styles/shelf-wall.css';
import Layout from '../../layouts/Layout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import ShelfTile from '../../components/shelf/ShelfTile.astro';
import ShelfViewControls from '../../components/shelf/ShelfViewControls.astro';
import ShelfQueueToggle from '../../components/shelf/ShelfQueueToggle.astro';
import ShelfFilterResults from '../../components/shelf/ShelfFilterResults.astro';
import { getAllPosts } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';
import { groupTvShows, repeatLabel } from '../../utils/shelfWall';
import { getTVCoverImage } from '../../utils/tvCovers';
import { bookRatingOrder, type BookRating } from '../../utils/bookRatings';
import { SHELF_LIST_SORT_PRIORITY, SHELF_STATUS_LABELS, type ShelfStatus } from '../../utils/shelfStatus';

const allPosts = await getAllPosts();
// Todo stubs are left out by groupTvShows; they live on /tvshelf/queue/ only.
const shows = groupTvShows(allPosts.filter((post) => post.data.category === 'tvshelf'));

// One tile per season watch, filed under the year it was watched. A rewatch is
// its own tile in the year of the rewatch.
const tiles = shows.flatMap((show) => show.watches.map((watch) => {
    const data = watch.post.data;
    return {
        show,
        watch,
        year: watch.date.getUTCFullYear(),
        status: (data.status as ShelfStatus) ?? 'finished',
        rating: (data.rating as BookRating | undefined) ?? null,
        tags: Array.isArray(data.tags) ? data.tags : [],
        cover: data.cover ?? show.watches.find((w) => w.post.data.cover)?.post.data.cover,
    };
}));

// Year desc, then in-progress first, then most recent activity.
tiles.sort((a, b) => {
    if (a.year !== b.year) return b.year - a.year;
    const byStatus = SHELF_LIST_SORT_PRIORITY[a.status] - SHELF_LIST_SORT_PRIORITY[b.status];
    if (byStatus !== 0) return byStatus;
    return b.watch.date.getTime() - a.watch.date.getTime();
});

const years = Array.from(new Set(tiles.map((t) => t.year)));

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const finishedCount = tiles.filter((t) => t.status === 'finished').length;
const countText = `${plural(shows.length, 'show', 'shows')} · ${plural(finishedCount, 'season', 'seasons')} watched`;

const tvDescription = "TV shows I've watched or am watching, one cover per season, filed under the year I watched it.";

const sectionLandingProps = createSectionLandingProps({
    title: 'TV Shelf',
    countText,
    countVariant: 'plain',
    countClass: 'bookshelf-count',
    tagCategory: 'tvshelf',
    tagPosts: allPosts,
    contentClass: 'bookshelf-content',
    hideTitle: true
});
---

<Layout
  title="TV Shelf"
  description="TV shows I've watched and want to watch"
  currentPage="/tvshelf/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: { gap: 'loose', padding: 'narrow' }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
  <SectionLanding {...sectionLandingProps}>
    <div slot="afterHeader" class="shelf-header-block">
      <div class="shelf-title-row">
        <ShelfQueueToggle category="tvshelf" active="shelf" />
      </div>
      <p class="shelf-description">{tvDescription}</p>
    </div>
    <ShelfViewControls />
    <ShelfFilterResults />
    <div class="shelf-years">
      {years.map((year) => {
        const yearTiles = tiles.filter((t) => t.year === year);
        const yearShows = new Set(yearTiles.map((t) => t.show.showTitle)).size;

        return (
          <section class="shelf-year" id={`tvshelf-${year}`} data-year={year}>
            <header class="shelf-year__head">
              <h2 class="shelf-year__year">{year}</h2>
              <span class="shelf-year__count" data-year-count={year}>
                {plural(yearTiles.length, 'season', 'seasons')} · {plural(yearShows, 'show', 'shows')}
              </span>
            </header>
            <ul class="shelf-wall">
              {yearTiles.map((tile) => (
                <li
                  class="shelf-wall__item"
                  data-shelf-item
                  data-tags={tile.tags.join(',')}
                  data-creator={(tile.watch.post.data.creator ?? []).join(',')}
                  data-genre={tile.watch.post.data.genre ?? ''}
                  data-platform={tile.watch.post.data.platform ?? ''}
                  data-status={tile.status}
                  data-rating={tile.rating ?? ''}
                  data-sort-date={tile.watch.date.toISOString()}
                  data-sort-status={SHELF_LIST_SORT_PRIORITY[tile.status]}
                  data-sort-title={`${tile.show.showTitle.toLowerCase()} ${String(tile.watch.season ?? 0).padStart(3, '0')}`}
                  data-sort-rating={tile.rating ? bookRatingOrder.indexOf(tile.rating) : 9}
                >
                  <ShelfTile
                    title={tile.show.showTitle}
                    href={tile.watch.path}
                    cover={tile.cover ? getTVCoverImage(tile.cover) : null}
                    badge={tile.watch.season !== null ? `S${tile.watch.season}` : null}
                    people={tile.watch.post.data.creator ?? []}
                    personFilter="creator"
                    status={tile.status}
                    statusLabel={SHELF_STATUS_LABELS.tvshelf[tile.status]}
                    rating={tile.rating}
                    genre={tile.watch.post.data.genre}
                    repeat={tile.watch.watchNumber > 1 ? repeatLabel(tile.watch.watchNumber, 'watch') : null}
                    notes={tile.watch.notes}
                    date={tile.watch.date}
                  />
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
  </SectionLanding>
</Layout>

<script>
  import { initShelfFilters } from '../../scripts/shelfFilters';

  function initTvshelfFilters() {
    initShelfFilters({
      itemSelector: '[data-shelf-item]',
      countNoun: { singular: 'season', plural: 'seasons' },
      filterTypes: [
        { type: 'creator' },
        { type: 'genre', badgeClass: () => 'shelf-filter-badge--genre' },
        {
          type: 'status',
          labels: { todo: 'To Watch', started: 'Watching', paused: 'On Hold', finished: 'Watched' },
          badgeClass: (value) => `shelf-filter-badge--status-${value}`,
        },
        { type: 'platform' },
        {
          type: 'rating',
          labels: { like: 'Like', love: 'Love', nope: 'Nope' },
          badgeClass: (value) => `shelf-filter-badge--rating-${value}`,
        },
        { type: 'tag', attr: 'data-tags', badgeClass: () => 'shelf-filter-badge--tag' },
      ],
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTvshelfFilters);
  } else {
    initTvshelfFilters();
  }
</script>
