---
import Layout from '../../layouts/Layout.astro';
import StreamLayout from '../../components/layout/StreamLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import TagList from '../../components/TagList.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for stream (blog, micro, and photo)
const allPosts = await getAllPosts();
const stream = allPosts
  .filter(post => ['blog', 'micro', 'photo'].includes(post.data.category))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the StreamGrid component
const transformedPosts = stream.map(transformPost);
---

<Layout 
  title="Stream" 
  description="Blog posts, photos, and micro updates" 
  currentPage="/stream/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
    <PageHeader 
      title="Stream"
      description="Blog posts, photos, and micro updates from my daily life."
      layout="centered"
      size="lg"
      maxWidth="7xl"
    />
    
    <div class="stream-count mb-6 text-center">
      {transformedPosts.length} {transformedPosts.length === 1 ? 'post' : 'posts'}
    </div>
    
    <!-- TagList for mobile and desktop -->
    <div class="stream-taglist">
      <TagList category="stream" title="Tagged with:" />
    </div>
    
    <main class="stream-main">
      <StreamLayout posts={transformedPosts} />
    </main>
</Layout>

<style>
  .stream-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .stream-count {
    font-size: 0.875rem;
    font-weight: 500;
    color: #8b5cf6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.dark) .stream-count {
    color: #a78bfa;
  }

  .stream-main {
    padding-bottom: 2rem;
  }

  .stream-taglist {
    margin-bottom: 2rem;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .stream-container {
      max-width: none;
      padding: 0;
    }

    .stream-main {
      padding-bottom: 1.5rem;
    }

    .stream-taglist {
      margin-bottom: 1.5rem;
    }
  }
</style> 