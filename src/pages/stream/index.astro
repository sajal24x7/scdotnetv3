---
import Layout from '../../layouts/Layout.astro';
import StreamLayout from '../../components/layout/StreamLayout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import { getAllPosts, getPostsByCategory, transformPost } from '../../utils/content';

// Get all posts and filter for stream (blog, micro, and photo)
const allPosts = await getAllPosts();
const stream = getPostsByCategory(allPosts, 'stream');

// Transform posts for the StreamLayout component
const transformedPosts = stream.map(transformPost);
const postCount = transformedPosts.length;
const postCountText = `${postCount} ${postCount === 1 ? 'post' : 'posts'}`;
---

<Layout
  title="Stream"
  description="Blog posts, photos, and micro updates"
  currentPage="/stream/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true
  }}
  allPosts={allPosts}
  enableSearchModal
  enableLinkHoverEffect
>
    <SectionLanding
      title="Stream"
      description="Blog posts, photos, and micro updates from my daily life."
      layout="centered"
      headerSize="lg"
      headerMaxWidth="7xl"
      countText={postCountText}
      countVariant="plain"
      tagCategory="stream"
      tagTitle="Tagged with:"
      tagPosts={allPosts}
      padding="narrow"
    >
      <StreamLayout posts={transformedPosts} />
    </SectionLanding>
  </Layout>
