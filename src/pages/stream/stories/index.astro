---
import Layout from '../../../layouts/Layout.astro';
import ContentGrid from '../../../components/ContentGrid.astro';
import PageHeader from '../../../components/layout/PageHeader.astro';
import { getAllPosts, transformPost } from '../../../utils/content';

// Get all story posts
const allPosts = await getAllPosts();
const storyPosts = allPosts
  .filter(post => post.data.category === 'story')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = storyPosts.map(post => ({
  data: {
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    category: post.data.category,
    image: post.data.image,
    link: `/${post.data.category}/${post.slug}/`
  },
  body: post.body,
  render: post.render
}));
---

<Layout 
  title="Stories - Stream" 
  description="Story posts and creative writing" 
  currentPage="/stream/stories/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
    <PageHeader 
      title="Stories"
      description="Creative stories and narrative pieces from my imagination and experiences."
      layout="centered"
      size="lg"
    />
    
    <div class="stories-count mb-6 text-center">
      {transformedPosts.length} {transformedPosts.length === 1 ? 'story' : 'stories'}
    </div>
    
    <div class="text-center mb-6">
      <a 
        href="/tags/?category=story" 
        class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
      >
        View entries by tag
      </a>
    </div>

    <main class="stories-main">
      <ContentGrid posts={transformedPosts} />
    </main>
</Layout>

<style>
  .stories-count {
    font-size: 0.875rem;
    font-weight: 500;
    color: #8b5cf6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.dark) .stories-count {
    color: #a78bfa;
  }

  .stories-main {
    padding-bottom: 2rem;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .stories-main {
      padding-bottom: 1.5rem;
    }
  }
</style>