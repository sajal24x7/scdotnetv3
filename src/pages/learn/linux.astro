---
import Layout from '../../layouts/Layout.astro';
import LearningSystem from '../../components/learn/LearningSystem';
import { linuxLearnConfig } from '../../data/linux-learn-config';
import '../../styles/learn.css';
import '../../styles/auth.css';
---

<Layout
  title="Learn Linux — Sysadmin Command Practice"
  description="Practice common Linux sysadmin commands in short, quiz-style sessions: storage, logs, processes, networking, and more."
  currentPage="/learn/linux"
  pageWrapper={{ container: true, maxWidth: '6xl', padding: 'lg', paddingScale: 'page' }}
  enableLinkHoverEffect
>
  <div class="learn-linux-page">
    <h1 class="learn-linux-page__title">Learn Linux</h1>
    <p class="learn-linux-page__subtitle">
      A periodic table of sysadmin commands, practiced a few minutes a day. The scheduler
      decides what you see: cards come back right before you'd forget them, new commands
      trickle in gradually, and the chart turns green as commands become solid. Open it,
      do today's review, get on with your work.
    </p>

    <LearningSystem client:load config={linuxLearnConfig} />
  </div>
</Layout>
