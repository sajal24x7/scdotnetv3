---
import Layout from '../../layouts/Layout.astro';
import LearnHub from '../../components/learn/LearnHub';
import type { LearnHubSystem } from '../../components/learn/LearnHub';
import { practiceRegistry } from '../../data/practice-registry';
import '../../styles/learn.css';

// Build-time summaries only — the island must not bundle four content
// pools. practiceRegistry (server-only, see src/data/practice-registry.ts)
// is the single source for this now, shared with /practice.
const systems: LearnHubSystem[] = practiceRegistry
  .filter((deck) => deck.learnHref)
  .map((deck) => ({
    id: deck.id,
    title: deck.title,
    emoji: deck.emoji,
    href: deck.learnHref!,
    blurb: deck.blurb,
    itemNoun: deck.itemNoun,
    totalItems: deck.totalItems,
    totalPrompts: deck.totalPrompts,
    storageKey: deck.storageKey,
    newPerDay: deck.newPerDay,
    dueCap: deck.dueCap,
  }));
---

<Layout
  title="Learn — Daily Practice"
  description="One page for all my spaced-repetition practice systems: Linux commands, Finnish, vocabulary, and decks built from my own TIL and evergreen notes."
  currentPage="/learn"
  pageWrapper={{ container: true, maxWidth: '6xl', padding: 'lg', paddingScale: 'page' }}
>
  <div class="learn-hub-page">
    <h1 class="learn-hub-page__title">Learn</h1>
    <p class="learn-hub-page__subtitle">
      Two halves to the daily ritual: learn today's new concepts (here, or on a deck's
      own page), then answer questions at practice. Each system keeps its own wall
      chart and schedule — a few minutes a day, then get on with your day.
    </p>

    <LearnHub client:load systems={systems} />
  </div>
</Layout>
