---
import Layout from '../../layouts/Layout.astro';
import StreamLayout from '../../components/layout/StreamLayout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import { getAllPosts, getPostsByCategory, transformPost } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';

// Get all posts and filter for blog
const allPosts = await getAllPosts();
const blogPosts = getPostsByCategory(allPosts, 'blog');

// Transform posts for the ContentGrid component
const transformedPosts = blogPosts.map(transformPost);
const postCount = transformedPosts.length;
const postCountText = `${postCount} ${postCount === 1 ? 'post' : 'posts'}`;

const sectionLandingProps = createSectionLandingProps(
  {
    title: 'Blog',
    description: 'Long-form thoughts, tutorials, and articles.',
    countText: postCountText,
    tagCategory: 'blog',
    tagPosts: allPosts,
    contentClass: 'grid-span-8 grid-start-3'
  },
  'plainCount'
);
---

<Layout
  title="Blog"
  description="Long-form thoughts and articles"
  currentPage="/blog/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
    <SectionLanding {...sectionLandingProps}>
      <StreamLayout posts={transformedPosts} />
    </SectionLanding>
  </Layout>
