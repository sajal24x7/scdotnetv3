---
import Layout from '../../layouts/Layout.astro';
import StreamLayout from '../../components/layout/StreamLayout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for blog
const allPosts = await getAllPosts();
const blogPosts = allPosts
  .filter(post => post.data.category === 'blog')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = blogPosts.map(transformPost);
---

<Layout 
  title="Blog" 
  description="Long-form thoughts and articles" 
  currentPage="/blog/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
    <SectionLanding
      title="Blog"
      description="Long-form thoughts, tutorials, and articles."
      countText={`${transformedPosts.length} ${transformedPosts.length === 1 ? 'post' : 'posts'}`}
      tagCategory="blog"
    >
      <StreamLayout posts={transformedPosts} />
    </SectionLanding>
</Layout>
