---
import Layout from '../../layouts/Layout.astro';
import ContentGrid from '../../components/ContentGrid.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for blog
const allPosts = await getAllPosts();
const blogPosts = allPosts
  .filter(post => post.data.category === 'blog')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = blogPosts.map(transformPost);
---

<Layout 
  title="Blog" 
  description="Long-form thoughts and articles" 
  currentPage="/blog/"
>
  <div class="max-w-7xl mx-auto">
    <header class="mb-12 px-6">
      <div class="flex flex-col">
        <h1 class="text-4xl font-bold mb-4">Blog</h1>
        <p class="text-xl text-textSecondary dark:text-textSecondaryDark mb-4">
          Long-form thoughts, tutorials, and articles.
        </p>
        <a 
          href="/blog/tags" 
          class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
        >
          View entries by tag
        </a>
      </div>
    </header>

    <div class="px-6">
      <ContentGrid posts={transformedPosts} />
    </div>
  </div>
</Layout> 