---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ContentGrid from '../../../components/ContentGrid.astro';
import { getYearDirectories } from '../../../utils/content';

export async function getStaticPaths() {
  function isBlogPost(post: unknown): post is CollectionEntry<any> {
    return (
      typeof post === 'object' &&
      post !== null &&
      'data' in post &&
      typeof (post as any).data === 'object' &&
      (post as any).data !== null &&
      (post as any).data.category === 'blog'
    );
  }

  const years = getYearDirectories();
  const allPosts = await Promise.all(years.map(year => getCollection(year)));
  const flatPosts = allPosts.flat();
  const blogPosts = flatPosts.filter(isBlogPost);

  // Get all unique tags
  const tags = new Set<string>();
  blogPosts.forEach(post => {
    if (post.data.tags) {
      post.data.tags.forEach(tag => tags.add(tag));
    }
  });

  return Array.from(tags).map(tag => ({
    params: { tag },
    props: { tag }
  }));
}

const { tag } = Astro.props;

// Redefine helper function for runtime
function isBlogPost(post: unknown): post is CollectionEntry<any> {
  return (
    typeof post === 'object' &&
    post !== null &&
    'data' in post &&
    typeof (post as any).data === 'object' &&
    (post as any).data !== null &&
    (post as any).data.category === 'blog'
  );
}

// Get all posts from year collections - redefine years for runtime
const years = getYearDirectories();
const allPosts = await Promise.all(years.map(year => getCollection(year)));
const flatPosts = allPosts.flat();
const taggedPosts = flatPosts.filter(
  (post): post is CollectionEntry<any> =>
    isBlogPost(post) &&
    Array.isArray((post as any).data.tags) &&
    (post as any).data.tags.includes(tag)
).sort((a, b) => new Date(a.data.pubDate).getTime() - new Date(b.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = taggedPosts.map(post => ({
  data: {
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    category: post.data.category,
    image: post.data.image,
    link: `/${post.data.category}/${post.slug}/`
  },
  body: post.body
}));
---

<Layout 
  title={`Blog posts tagged with "${tag}"`}
  description={`Browse blog posts tagged with "${tag}"`}
  currentPage="/blog/"
>
  <div class="max-w-7xl mx-auto">
    <header class="mb-12 px-6">
      <div class="flex flex-col">
        <h1 class="text-4xl font-bold mb-4">Blog posts tagged with "{tag}"</h1>
        <a 
          href="/blog/tags" 
          class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
        >
          ← Back to all tags
        </a>
      </div>
    </header>

    <div class="px-6">
      <ContentGrid posts={transformedPosts} />
    </div>
  </div>
</Layout> 