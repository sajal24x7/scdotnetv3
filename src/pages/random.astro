---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Get all posts
const allPosts = await getCollection('posts');

// Get index from query parameter or select random
const queryIndex = Astro.url.searchParams.get('id');
const index = queryIndex ? parseInt(queryIndex) : Math.floor(Math.random() * allPosts.length);

// Make sure index is valid
const safeIndex = index < allPosts.length ? index : 0;

// Get the random content entry
const randomEntry = allPosts[safeIndex];

// Determine the URL based on category
let redirectUrl = '/';
if (randomEntry) {
  redirectUrl = `/${randomEntry.data.category}/${randomEntry.slug}/`;
}

// Redirect to the random content
return Astro.redirect(redirectUrl);
---

<Layout title="Redirecting..." currentPage="/random"
  enableSearchModal
  enableLinkHoverEffect
>
  <div class="flex items-center justify-center min-h-[50vh]">
    <p>Redirecting to a random post...</p>
  </div>
</Layout>
