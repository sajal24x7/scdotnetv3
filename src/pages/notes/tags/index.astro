---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import TagPage from '../../../components/TagPage.astro';

const years = ['2012', '2013', '2014', '2015', '2016', '2017', '2019', '2021', '2022', '2024', '2025'];

// Get all posts from year collections
const allPosts = await Promise.all(years.map(year => getCollection(year)));
const notesPosts = allPosts
  .flat()
  .filter(post => {
    const data = post.data as { category?: string; tags?: string[] };
    return data.category && ['evergreen', 'til'].includes(data.category);
  });

// Count tags
const tags: Record<string, number> = notesPosts.reduce((acc, post) => {
  const data = post.data as { tags?: string[] };
  if (data.tags) {
    data.tags.forEach(tag => {
      acc[tag] = (acc[tag] || 0) + 1;
    });
  }
  return acc;
}, {} as Record<string, number>);
---

<Layout 
  title="Notes Tags" 
  description="Browse notes by tag" 
  currentPage="/notes/"
>
  <TagPage 
    title="Notes Tags" 
    description="Browse notes and documentation by tag"
    tags={tags}
    currentPage="/notes"
  />
</Layout> 