---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import TagPage from '../../../components/TagPage.astro';

const years = ['2012', '2013', '2014', '2015', '2016', '2017', '2019', '2021', '2022', '2024', '2025'];

// Get all posts from year collections
const allPosts = await Promise.all(years.map(year => getCollection(year)));
const evergreenPosts = allPosts
  .flat()
  .filter(post => post.data.category === 'evergreen');

// Count tags
const tags = evergreenPosts.reduce((acc, post) => {
  if (post.data.tags) {
    post.data.tags.forEach(tag => {
      acc[tag] = (acc[tag] || 0) + 1;
    });
  }
  return acc;
}, {});
---

<Layout 
  title="Notes Tags" 
  description="Browse notes by tag" 
  currentPage="/notes/"
>
  <TagPage 
    title="Notes Tags" 
    description="Browse notes and documentation by tag"
    tags={tags}
    currentPage="/notes"
  />
</Layout> 