---
import Layout from '../../layouts/Layout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import NordletterGrid from '../../components/NordletterGrid.astro';
import NewsletterSignup from '../../components/ui/NewsletterSignup.astro';
import { getAllPosts, transformPost, cleanNordletterTitle, getEditionDisplay } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';

// Get all posts and filter for nordletter
const allPosts = await getAllPosts();
const nordletterPosts = allPosts
  .filter(post => post.data.category === 'nordletter')
  .sort((a, b) => new Date(b.data.created).getTime() - new Date(a.data.created).getTime());

// Transform posts for the NordletterGrid component and add edition information
const transformedPosts = nordletterPosts.map(post => {
  const transformed = transformPost(post);
  return {
    ...transformed,
    data: {
      ...transformed.data,
      title: cleanNordletterTitle(transformed.data.title),
      editionDisplay: getEditionDisplay(transformed.data.edition, post.data.created, post.data.title, post.id)
    }
  };
});

const sectionLandingProps = createSectionLandingProps({
  title: 'Nordletter',
  description: 'A weekly newsletter on living in Finland + 5 things from the web.',
  tagCategory: 'nordletter',
  tagPosts: allPosts,
  tagWrapperClass: 'grid-span-full',
  contentClass: 'nordletter-content twelve-grid grid-gap-tight',
  contentPadding: '0',
  rssUrl: '/nordletter/rss.xml'
});
---

<Layout
  title="Nordletter"
  description="Monthly newsletter about life in the Nordics"
  currentPage="/nordletter/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
  <SectionLanding {...sectionLandingProps}>
    <div slot="beforeContent" class="nordletter-signup grid-span-full">
      <NewsletterSignup showCopy={false} wrapperClass="py-0" formClass="nordletter-signup__form mx-auto" />
    </div>

    <NordletterGrid posts={transformedPosts} />
  </SectionLanding>
</Layout>

<style>
  .nordletter-signup {
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }

  .nordletter-signup__form {
    margin-inline: auto;
    width: min(100%, 38rem);
    max-width: min(100%, 38rem);
  }

  .nordletter-content {
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }
</style>
