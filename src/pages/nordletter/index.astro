---
import Layout from '../../layouts/Layout.astro';
import AdaptiveCard from '../../components/AdaptiveCard.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for nordletter
const allPosts = await getAllPosts();
const nordletterPosts = allPosts
  .filter(post => post.data.category === 'nordletter')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the AdaptiveCard component
const transformedPosts = nordletterPosts.map(transformPost);
---

<Layout 
  title="Nordletter" 
  description="Monthly newsletter about life in the Nordics" 
  currentPage="/nordletter/"
>
  <div class="max-w-7xl mx-auto">
    <header class="mb-12 px-6">
      <div class="flex flex-col">
        <h1 class="text-4xl font-bold mb-4">Nordletter</h1>
        <p class="text-xl text-textSecondary dark:text-textSecondaryDark mb-4">
          Monthly newsletter about life in the Nordics.
        </p>
        <a 
          href="/nordletter/tags" 
          class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
        >
          View entries by tag
        </a>
      </div>
    </header>

    <div class="px-6">
      <div class="grid grid-cols-1 gap-12 py-12">
        {transformedPosts.map((post) => (
          <AdaptiveCard 
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            image={post.data.image}
            link={post.data.link}
            layout="horizontal"
          />
        ))}
      </div>
    </div>
  </div>
</Layout> 