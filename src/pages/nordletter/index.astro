---
import Layout from '../../layouts/Layout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import NordletterGrid from '../../components/NordletterGrid.astro';
import NewsletterSignup from '../../components/ui/NewsletterSignup.astro';
import { getAllPosts, transformPost, cleanNordletterTitle, getEditionDisplay } from '../../utils/content';

// Get all posts and filter for nordletter
const allPosts = await getAllPosts();
const nordletterPosts = allPosts
  .filter(post => post.data.category === 'nordletter')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the NordletterGrid component and add edition information
const transformedPosts = nordletterPosts.map(post => {
  const transformed = transformPost(post);
  return {
    ...transformed,
    data: {
      ...transformed.data,
      title: cleanNordletterTitle(transformed.data.title),
      editionDisplay: getEditionDisplay(transformed.data.edition, post.data.pubDate, post.data.title, post.slug)
    }
  };
});
---

<Layout
  title="Nordletter"
  description="Monthly newsletter about life in the Nordics"
  currentPage="/nordletter/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-6'
  }}
  allPosts={allPosts}
  enableSearchModal
  enableLinkHoverEffect
>
  <SectionLanding
    title="Nordletter"
    description="A weekly newsletter on living in Finland + 5 things from the web."
    layout="centered"
    headerSize="lg"
    headerMaxWidth="7xl"
    tagCategory="nordletter"
    tagPosts={allPosts}
    tagWrapperClass="px-6 mb-6"
  >
    <div slot="beforeContent" class="px-6 mb-8">
      <NewsletterSignup showCopy={false} wrapperClass="py-0" formClass="mx-auto" />
    </div>

    <NordletterGrid posts={transformedPosts} />
  </SectionLanding>
</Layout>
