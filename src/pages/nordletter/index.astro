---
import Layout from '../../layouts/Layout.astro';
import NordletterGrid from '../../components/NordletterGrid.astro';
import { getAllPosts, transformPost, cleanNordletterTitle, getEditionDisplay } from '../../utils/content';

// Get all posts and filter for nordletter
const allPosts = await getAllPosts();
const nordletterPosts = allPosts
  .filter(post => post.data.category === 'nordletter')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the NordletterGrid component and add edition information
const transformedPosts = nordletterPosts.map(post => {
  const transformed = transformPost(post);
  return {
    ...transformed,
    data: {
      ...transformed.data,
      title: cleanNordletterTitle(transformed.data.title),
      editionDisplay: getEditionDisplay(transformed.data.edition, post.data.pubDate, post.data.title, post.slug)
    }
  };
});
---

<Layout 
  title="Nordletter" 
  description="Monthly newsletter about life in the Nordics" 
  currentPage="/nordletter/"
>
  <div class="max-w-7xl mx-auto">
    <header class="mb-12 px-6">
      <div class="flex flex-col">
        <h1 class="text-4xl font-bold mb-4">Nordletter</h1>
        <p class="text-xl text-textSecondary dark:text-textSecondaryDark mb-4">
          A weekly newsletter on living in Finland + 5 things from the web.
        </p>
        <a 
          href="/tags/?category=nordletter" 
          class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200 mb-6 block"
        >
          View entries by tag
        </a>
        
        <form
          class="flex flex-col sm:flex-row gap-3 max-w-md"
          action="https://buttondown.com/api/emails/embed-subscribe/sajal24x7"
          method="post"
          target="popupwindow"
          onsubmit="window.open('https://buttondown.com/sajal24x7', 'popupwindow')"
        >
          <input
            type="email"
            name="email"
            placeholder="Enter your email"
            required
            class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
          <button
            type="submit"
            class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors font-medium"
          >
            Subscribe
          </button>
        </form>
      </div>
    </header>

    <div class="px-6">
      <NordletterGrid posts={transformedPosts} />
    </div>
  </div>
</Layout> 