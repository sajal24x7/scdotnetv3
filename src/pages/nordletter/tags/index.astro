---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import TagPage from '../../../components/TagPage.astro';

// Get all nordletter entries
const nordletter = await getCollection('nordletter');

// Count tags
const tags = nordletter.reduce((acc, post) => {
  if (post.data.tags) {
    post.data.tags.forEach(tag => {
      acc[tag] = (acc[tag] || 0) + 1;
    });
  }
  return acc;
}, {});
---

<Layout 
  title="Nordletter Tags" 
  description="Browse nordletter entries by tag" 
  currentPage="/nordletter/"
>
  <TagPage 
    title="Nordletter Tags" 
    description="Browse nordletter entries by tag"
    tags={tags}
    currentPage="/nordletter"
  />
</Layout> 