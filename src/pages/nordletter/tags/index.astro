---
import Layout from '../../../layouts/Layout.astro';
import TagPage from '../../../components/TagPage.astro';
import { getAllPosts } from '../../../utils/content';

// Get all posts and filter for nordletter
const allPosts = await getAllPosts();
const nordletterPosts = allPosts.filter(post => post.data.category === 'nordletter');

// Count tags
const tags = nordletterPosts.reduce((acc, post) => {
  if (post.data.tags) {
    post.data.tags.forEach(tag => {
      acc[tag] = (acc[tag] || 0) + 1;
    });
  }
  return acc;
}, {});
---

<Layout 
  title="Nordletter Tags" 
  description="Browse nordletter entries by tag" 
  currentPage="/nordletter/"
>
  <TagPage 
    title="Nordletter Tags" 
    description="Browse nordletter entries by tag"
    tags={tags}
    currentPage="/nordletter"
  />
</Layout> 