---
import { getAllPosts } from '../utils/content';
import Layout from '../layouts/Layout.astro';
import TimeDisplay from '../components/TimeDisplay.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import LayoutContainer from '../components/layout/LayoutContainer.astro';
import { parseMarkdown } from '../utils/markdown';
import { formatDate } from '../utils/dateFormat';
import '../styles/progress-page.css';

// Get all posts dynamically across year folders and filter to category 'now' and status 'active' (or undefined for backward compatibility)
const allPosts = await getAllPosts();
const activeNowPosts = allPosts
  .filter(post => post.data.category === 'now' && (!post.data.status || post.data.status === 'active'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Pre-render markdown content
const renderedPosts = activeNowPosts.map(post => ({
    ...post,
    renderedContent: post.body ? parseMarkdown(post.body) : null
}));

const activeCount = renderedPosts.length;
const latestUpdateDate = renderedPosts[0]?.data.updatedDate ?? renderedPosts[0]?.data.pubDate;
const latestUpdate = latestUpdateDate ? formatDate(latestUpdateDate) : null;

const quickLinks = [
    {
        href: '/done/',
        label: 'Browse completed tasks',
        description: 'Review recently wrapped projects and milestones.'
    },
    {
        href: '/stream/',
        label: 'Read the stream',
        description: 'Catch up on blog posts, photos, and micro updates.'
    },
    {
        href: '/garden/',
        label: 'Explore the garden',
        description: 'Longer-term notes and research that inform these efforts.'
    }
];
---

<Layout
  title="Now - Sajal Choudhary"
  description="What I'm currently working on and thinking about"
  currentPage="/now/"
  pageWrapper={{
        maxWidth: '7xl',
        padding: 'md',
        centered: true,
        className: 'progress-page progress-page--now',
        grid: {
            gap: 'tight',
            padding: 'narrow'
        }
  }}
  allPosts={allPosts}
  enableSearchModal
  enableLinkHoverEffect
>
    <section class="progress-page__layout twelve-grid">
        <header class="progress-page__header grid-span-full">
            <PageHeader
                title="Now"
                description="A snapshot of what I'm currently focused on, thinking about, and working towards."
                layout="centered"
                size="lg"
                maxWidth="7xl"
            />
        </header>

        <section class="progress-page__content grid-span-8 grid-start-1">
            <p class="progress-page__intro">
                View <a href="/done/" class="progress-page__link">completed tasks</a> when you want to see what recently wrapped.
            </p>

            {renderedPosts.length > 0 ? (
                <div class="progress-page__list">
                    {renderedPosts.map((post) => (
                        <article class="progress-card">
                            <div class="progress-card__meta">
                                <TimeDisplay
                                    date={post.data.pubDate}
                                    category="now"
                                    format="month-year"
                                    className="progress-card__time"
                                />
                                {post.data.title && (
                                    <h2 class="progress-card__title">{post.data.title}</h2>
                                )}
                            </div>

                            {post.renderedContent && (
                                <LayoutContainer prose maxWidth="full" className="progress-card__body">
                                    <div set:html={post.renderedContent} />
                                </LayoutContainer>
                            )}
                        </article>
                    ))}
                </div>
            ) : (
                <p class="progress-page__empty">No active updates yet.</p>
            )}
        </section>

        {(activeCount > 0 || quickLinks.length > 0) && (
            <aside class="progress-page__sidebar grid-span-4 grid-start-9">
                {activeCount > 0 && (
                    <div class="progress-sidebar-card">
                        <h2 class="progress-sidebar-card__title">Summary</h2>
                        <dl class="progress-sidebar-card__stats">
                            <div>
                                <dt>Active updates</dt>
                                <dd>{activeCount}</dd>
                            </div>
                            <div>
                                <dt>Last updated</dt>
                                <dd>{latestUpdate ?? '—'}</dd>
                            </div>
                        </dl>
                    </div>
                )}

                {quickLinks.length > 0 && (
                    <div class="progress-sidebar-card">
                        <h2 class="progress-sidebar-card__title">Quick links</h2>
                        <ul class="progress-sidebar-card__links">
                            {quickLinks.map(link => (
                                <li>
                                    <a class="progress-sidebar-card__link" href={link.href}>
                                        <span class="progress-sidebar-card__link-label">{link.label}</span>
                                        <span class="progress-sidebar-card__link-description">{link.description}</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                )}
            </aside>
        )}
    </section>
</Layout>