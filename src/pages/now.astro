---
import { getAllPosts } from '../utils/content';
import Layout from '../layouts/Layout.astro';
import { marked } from 'marked';
import TimeDisplay from '../components/TimeDisplay.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import ProseWrapper from '../components/layout/ProseWrapper.astro';

// Configure marked options
marked.setOptions({
  gfm: true, // GitHub Flavored Markdown
  breaks: true // Convert line breaks to <br>
});

// Get all posts dynamically across year folders and filter to category 'now' and status 'active' (or undefined for backward compatibility)
const allPosts = await getAllPosts();
const activeNowPosts = allPosts
  .filter(post => post.data.category === 'now' && (!post.data.status || post.data.status === 'active'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Pre-render markdown content
const renderedPosts = activeNowPosts.map(post => ({
  ...post,
  renderedContent: post.body ? marked.parse(post.body) : null
}));

const latestPost = renderedPosts[0];
const earlierPosts = renderedPosts.slice(1);
---

<Layout 
  title="Now - Sajal Choudhary" 
  description="What I'm currently working on and thinking about"
  currentPage="/now/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
    <PageHeader 
      title="Now" 
      description="A snapshot of what I'm currently focused on, thinking about, and working towards."
      layout="centered"
      size="lg"
      maxWidth="7xl"
    />

    <div class="text-center mb-8">
      <p class="text-gray-600 dark:text-gray-400">
        View <a href="/done/" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">completed tasks</a> here.
      </p>
    </div>

    <div class="px-6">
      <div class="grid grid-cols-1 gap-12 py-12">
        {latestPost ? (
          <article class="card bg-transparent dark:bg-transparent rounded-xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:scale-[1.01] border border-gray-100 dark:border-gray-700">
            <div class="p-8">
              <div class="mb-6">
                <TimeDisplay 
                  date={latestPost.data.pubDate} 
                  category="now" 
                  format="month-year"
                  className="text-lg font-semibold text-gray-700 dark:text-gray-300"
                />
              </div>

              {latestPost.renderedContent && (
                <ProseWrapper maxWidth="full">
                  <div set:html={latestPost.renderedContent} />
                </ProseWrapper>
              )}
            </div>
          </article>
        ) : (
          <p class="text-gray-600 dark:text-gray-400">No active updates yet.</p>
        )}
      </div>

      {earlierPosts.length > 0 && (
        <section class="mt-4 mb-16">
          <h3 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-6">Earlier updates</h3>
          <div class="space-y-8">
            {earlierPosts.map((post) => (
              <article class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden bg-transparent dark:bg-transparent p-6">
                <div class="mb-4">
                  <TimeDisplay 
                    date={post.data.pubDate} 
                    category="now" 
                    format="month-year"
                    className="text-lg font-semibold text-gray-700 dark:text-gray-300"
                  />
                </div>
                
                {post.renderedContent && (
                  <ProseWrapper maxWidth="full">
                    <div set:html={post.renderedContent} />
                  </ProseWrapper>
                )}
              </article>
            ))}
          </div>
        </section>
      )}
    </div>
</Layout>

<style>
  .grid {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  /* Add a subtle divider between cards */
  .grid > *:not(:last-child) {
    position: relative;
  }

  .grid > *:not(:last-child)::after {
    content: '';
    position: absolute;
    bottom: -1.5rem;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgb(229 231 235),
      transparent
    );
  }

  :global(.dark) .grid > *:not(:last-child)::after {
    background: linear-gradient(
      to right,
      transparent,
      rgb(55 65 81),
      transparent
    );
  }

  /* Ensure links are properly styled */
  :global(.prose a) {
    color: #3b82f6;
    text-decoration: none;
    transition: color 0.2s;
  }

  :global(.prose a:hover) {
    color: #2563eb;
    text-decoration: underline;
  }

  :global(.dark .prose a) {
    color: #60a5fa;
  }

  :global(.dark .prose a:hover) {
    color: #93c5fd;
  }

  /* Additional prose styles for better markdown rendering */
  :global(.prose h1),
  :global(.prose h2),
  :global(.prose h3),
  :global(.prose h4) {
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    font-weight: 600;
  }

  :global(.prose ul),
  :global(.prose ol) {
    margin-top: 0.5em;
    margin-bottom: 1.5em;
    padding-left: 1.5em;
  }

  :global(.prose li) {
    margin-top: 0.25em;
    margin-bottom: 0.25em;
  }

  :global(.prose blockquote) {
    margin: 1.5em 0;
    padding-left: 1em;
    border-left: 4px solid #e5e7eb;
    font-style: italic;
  }

  :global(.dark .prose blockquote) {
    border-left-color: #374151;
  }

  :global(.prose code) {
    background-color: #f3f4f6;
    padding: 0.2em 0.4em;
    border-radius: 0.25em;
    font-size: 0.875em;
  }

  :global(.dark .prose code) {
    background-color: #1f2937;
  }

  :global(.prose pre) {
    background-color: #f3f4f6;
    padding: 1em;
    border-radius: 0.5em;
    overflow-x: auto;
    margin: 1.5em 0;
  }

  :global(.dark .prose pre) {
    background-color: #1f2937;
  }
</style> 