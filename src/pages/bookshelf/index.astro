---
import Layout from '../../layouts/Layout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import BookGrid from '../../components/bookshelf/BookGrid.astro';
import { getAllPosts } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';

// Get all posts and filter for bookshelf
const allPosts = await getAllPosts();
const bookshelfPosts = allPosts
    .filter((post) => post.data.category === 'bookshelf')
    .sort((a, b) => {
        // Sort by finished reading date if available, otherwise by pub date
        const aDate = a.data.finishedReading || a.data.pubDate;
        const bDate = b.data.finishedReading || b.data.pubDate;
        return new Date(bDate).getTime() - new Date(aDate).getTime();
    });

// Separate currently reading books
const currentlyReading = bookshelfPosts.filter((book) => book.data.bookStatus === 'reading');

// Group completed books by year
const completedBooks = bookshelfPosts.filter((book) => book.data.bookStatus === 'read' || !book.data.bookStatus);
const booksByYear = completedBooks.reduce((acc, book) => {
    const date = book.data.finishedReading || book.data.pubDate;
    const year = new Date(date).getFullYear();
    if (!acc[year]) {
        acc[year] = [];
    }
    acc[year].push(book);
    return acc;
}, {} as Record<number, typeof bookshelfPosts>);

// Get sorted years (newest first)
const years = Object.keys(booksByYear)
    .map(Number)
    .sort((a, b) => b - a);

// Calculate total books count
const totalBooks = bookshelfPosts.length;
const countText = `${totalBooks} ${totalBooks === 1 ? 'book' : 'books'}`;

const sectionLandingProps = createSectionLandingProps({
    title: 'Bookshelf',
    description: "A collection of books I've read and am currently reading, organized by year.",
    countText,
    countVariant: 'plain',
    countClass: 'bookshelf-count',
    tagCategory: 'bookshelf',
    tagPosts: allPosts,
    contentClass: 'bookshelf-content'
});
---

<Layout
  title="Bookshelf"
  description="Books I've read and am currently reading"
  currentPage="/bookshelf/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: false
  }}
  allPosts={allPosts}
  enableSearchModal
  enableLinkHoverEffect
>
  <SectionLanding {...sectionLandingProps}>
    <div class="bookshelf-sections">
      {currentlyReading.length > 0 && (
        <section class="bookshelf-section">
          <header class="bookshelf-section__header">
            <h2 class="bookshelf-section__title">Currently Reading</h2>
            <span class="bookshelf-section__count">({currentlyReading.length})</span>
          </header>
          <BookGrid books={currentlyReading} />
        </section>
      )}

      {years.map((year) => (
        <section class="bookshelf-section">
          <header class="bookshelf-section__header">
            <h2 class="bookshelf-section__title">{year}</h2>
            <span class="bookshelf-section__count">({booksByYear[year].length})</span>
          </header>
          <BookGrid books={booksByYear[year]} />
        </section>
      ))}
    </div>
  </SectionLanding>
</Layout>

<style>
  .bookshelf-count {
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
  }

  :global(.dark) .bookshelf-count {
    color: #9ca3af;
  }

  .bookshelf-content {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3rem);
    padding-bottom: 2rem;
  }

  .bookshelf-sections {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .bookshelf-section {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .bookshelf-section__header {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .bookshelf-section__title {
    font-size: var(--text-large);
    font-weight: 600;
    margin: 0;
    color: #111827;
  }

  :global(.dark) .bookshelf-section__title {
    color: #f9fafb;
  }

  .bookshelf-section__count {
    font-size: var(--text-normal);
    font-weight: 500;
    color: #6b7280;
  }

  :global(.dark) .bookshelf-section__count {
    color: #9ca3af;
  }

  @media (max-width: 640px) {
    .bookshelf-content,
    .bookshelf-sections {
      gap: 2rem;
    }

    .bookshelf-section {
      gap: 1.5rem;
    }
  }
</style>
