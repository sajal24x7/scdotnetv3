---
import Layout from '../../layouts/Layout.astro';
import { getAllPosts } from '../../utils/content';
import { formatDateOnly } from '../../utils/date';

// Get all posts and filter for bookshelf
const allPosts = await getAllPosts();
const bookshelfPosts = allPosts
  .filter(post => post.data.category === 'bookshelf')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Group posts by year
const postsByYear = bookshelfPosts.reduce((acc, post) => {
  const year = new Date(post.data.pubDate).getFullYear();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof bookshelfPosts>);

// Get sorted years (newest first)
const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);

// Helper function to format book format
const formatBookFormat = (format: string | undefined) => {
  if (!format) return null;
  return format.charAt(0).toUpperCase() + format.slice(1);
};

---

<Layout 
  title="Bookshelf" 
  description="Book reviews and reading notes organized by year" 
  currentPage="/bookshelf/"
>
  <div class="max-w-4xl mx-auto px-6">
    <header class="mb-12">
      <h1 class="text-4xl font-bold mb-4">Bookshelf</h1>
      <p class="text-xl text-textSecondary dark:text-textSecondaryDark mb-4">
        Book reviews, reading notes, and thoughts on literature.
      </p>
      <a 
        href="/bookshelf/tags" 
        class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
      >
        View entries by tag
      </a>
    </header>

    <!-- Books by Year -->
    {years.map(year => (
      <section class="mb-12 year-section" data-year={year}>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-3">
          <span>{year}</span>
          <span class="text-lg font-normal text-textSecondary dark:text-textSecondaryDark">
            {postsByYear[year].length} book{postsByYear[year].length !== 1 ? 's' : ''}
          </span>
        </h2>
        
        <div class="space-y-8">
          {postsByYear[year].map(post => (
            <article 
              class="book-entry border-b border-gray-200 dark:border-gray-700 pb-8 last:border-b-0"
            >
              <div class="flex flex-col md:flex-row gap-6">
                <!-- Book Cover/Image -->
                {post.data.image && (
                  <div class="flex-shrink-0">
                    <img 
                      src={post.data.image} 
                      alt={`Cover of ${post.data.title}`}
                      class="w-24 h-32 md:w-20 md:h-28 object-cover rounded shadow-md"
                    />
                  </div>
                )}
                
                <!-- Book Details -->
                <div class="flex-1 min-w-0">
                  <div class="mb-3">
                    <h3 class="text-xl font-bold mb-2">
                      <a 
                        href={`/bookshelf/${post.slug}/`}
                        class="text-accent hover:text-accent/80 transition-colors"
                      >
                        {post.data.title}
                      </a>
                    </h3>
                    
                    {post.data.description && (
                      <p class="text-textSecondary dark:text-textSecondaryDark leading-relaxed mb-3">
                        {post.data.description}
                      </p>
                    )}
                    
                    <div class="flex flex-col gap-2 text-sm text-textSecondary dark:text-textSecondaryDark">
                      {/* Format */}
                      {(post.data as any).format && (
                        <span class="flex items-center gap-1">
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                          </svg>
                          {formatBookFormat((post.data as any).format)}
                        </span>
                      )}
                      
                      {/* Reading Dates */}
                      <div class="flex flex-wrap gap-4">
                        {(post.data as any).startDate && (
                          <span class="flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                              <line x1="16" y1="2" x2="16" y2="6"></line>
                              <line x1="8" y1="2" x2="8" y2="6"></line>
                              <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            Started: {formatDateOnly((post.data as any).startDate)}
                          </span>
                        )}
                        
                        {(post.data as any).endDate && (
                          <span class="flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                              <line x1="16" y1="2" x2="16" y2="6"></line>
                              <line x1="8" y1="2" x2="8" y2="6"></line>
                              <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            Finished: {formatDateOnly((post.data as any).endDate)}
                          </span>
                        )}
                      </div>
                      
                      {post.data.tags && (
                        <div class="flex flex-wrap gap-2 mt-2">
                          {post.data.tags.map((tag: string) => (
                            <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded-full text-xs">
                              {tag}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>


</Layout> 