---
import Layout from '../../layouts/Layout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import BookshelfCard from '../../components/bookshelf/BookshelfCard.astro';
import { getAllPosts } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';

// Get all posts and filter for bookshelf
const allPosts = await getAllPosts();
const bookshelfPosts = allPosts.filter((post) => post.data.category === 'bookshelf');

const normalizeStatus = (status?: string | null) => {
    switch (status) {
        case 'read':
        case 'finished':
            return 'finished';
        case 'reading':
        case 'on-hold':
        case 'to-read':
            return status;
        default:
            return 'finished';
    }
};

const statusOrder: Record<string, number> = {
    reading: 0,
    finished: 1,
    'on-hold': 2,
    'to-read': 3,
    other: 4
};

const toTime = (value?: Date | string | null) => {
    if (!value) {
        return 0;
    }

    const date = value instanceof Date ? value : new Date(value);
    const time = date.getTime();
    return Number.isNaN(time) ? 0 : time;
};

const compareDesc = (a?: Date | string | null, b?: Date | string | null) => {
    return toTime(b) - toTime(a);
};

const parseDate = (value?: Date | string | null) => {
    if (!value) return null;
    const date = value instanceof Date ? value : new Date(value);
    return Number.isNaN(date.getTime()) ? null : date;
};

const getBookYear = (book: typeof bookshelfPosts[number]) => {
    const finished = parseDate(book.data.finishedReading);
    if (finished) return finished.getFullYear();

    const started = parseDate(book.data.startedReading);
    if (started) return started.getFullYear();

    const pub = parseDate(book.data.pubDate);
    return (pub ?? new Date()).getFullYear();
};

const booksWithYear = bookshelfPosts.map((book) => ({
    book,
    year: getBookYear(book)
}));

const sortedBooks = [...booksWithYear].sort((a, b) => {
    if (a.year !== b.year) {
        return b.year - a.year;
    }

    const statusA = normalizeStatus(a.book.data.bookStatus);
    const statusB = normalizeStatus(b.book.data.bookStatus);

    if (statusA !== statusB) {
        return (statusOrder[statusA] ?? statusOrder.other) - (statusOrder[statusB] ?? statusOrder.other);
    }

    if (statusA === 'reading') {
        const progressA = typeof a.book.data.readingProgress === 'number' ? a.book.data.readingProgress : -1;
        const progressB = typeof b.book.data.readingProgress === 'number' ? b.book.data.readingProgress : -1;

        if (progressA !== progressB) {
            return progressB - progressA;
        }

        return compareDesc(a.book.data.startedReading ?? a.book.data.pubDate, b.book.data.startedReading ?? b.book.data.pubDate);
    }

    if (statusA === 'finished') {
        return compareDesc(a.book.data.finishedReading ?? a.book.data.pubDate, b.book.data.finishedReading ?? b.book.data.pubDate);
    }

    if (statusA === 'on-hold' || statusA === 'to-read') {
        return compareDesc(a.book.data.startedReading ?? a.book.data.pubDate, b.book.data.startedReading ?? b.book.data.pubDate);
    }

    return compareDesc(a.book.data.pubDate, b.book.data.pubDate);
});

const years = Array.from(new Set(sortedBooks.map((entry) => entry.year)));

const booksByYear = sortedBooks.reduce((acc, { year, book }) => {
    if (!acc[year]) {
        acc[year] = [];
    }
    acc[year].push(book);
    return acc;
}, {} as Record<number, typeof bookshelfPosts>);

const transformBook = (book: typeof bookshelfPosts[number]) => ({
    ...book.data,
    link: book.slug ? `/bookshelf/${book.slug}/` : undefined
});

// Extract unique authors and genres for filters
const extractAuthors = (author?: string | string[] | null) => {
    if (!author) return [];
    return Array.isArray(author) ? author : [author];
};

const allAuthors = new Set<string>();
const allGenres = new Set<string>();

bookshelfPosts.forEach((book) => {
    const authors = extractAuthors(book.data.author);
    authors.forEach((author) => allAuthors.add(author));

    if (book.data.genre) {
        allGenres.add(book.data.genre);
    }
});

const sortedAuthors = Array.from(allAuthors).sort((a, b) => a.localeCompare(b));
const sortedGenres = Array.from(allGenres).sort((a, b) => a.localeCompare(b));

// Calculate total books count
const totalBooks = bookshelfPosts.length;
const countText = `${totalBooks} ${totalBooks === 1 ? 'book' : 'books'}`;

const sectionLandingProps = createSectionLandingProps({
    title: 'Bookshelf',
    description: "Books I'm reading, have finished, or have on deck—organized by year with inline status cues.",
    countText,
    countVariant: 'plain',
    countClass: 'bookshelf-count',
    tagCategory: 'bookshelf',
    tagPosts: allPosts,
    contentClass: 'bookshelf-content'
});
---

<Layout
  title="Bookshelf"
  description="Books I've read and am currently reading"
  currentPage="/bookshelf/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  allPosts={allPosts}
  enableSearchModal
  enableLinkHoverEffect
>
  <SectionLanding {...sectionLandingProps}>
    {(sortedAuthors.length > 0 || sortedGenres.length > 0) && (
      <div class="bookshelf-filters">
        {sortedAuthors.length > 0 && (
          <div class="bookshelf-filter-group">
            <h3 class="bookshelf-filter-group__title">Filter by Author:</h3>
            <div class="bookshelf-filter-group__items">
              <button
                type="button"
                class="tag-chip"
                data-filter-type="author"
                data-filter-value=""
                data-filter-active="true"
              >
                All Authors
              </button>
              {sortedAuthors.map((author) => (
                <button
                  type="button"
                  class="tag-chip"
                  data-filter-type="author"
                  data-filter-value={author}
                >
                  {author}
                </button>
              ))}
            </div>
          </div>
        )}
        {sortedGenres.length > 0 && (
          <div class="bookshelf-filter-group">
            <h3 class="bookshelf-filter-group__title">Filter by Genre:</h3>
            <div class="bookshelf-filter-group__items">
              <button
                type="button"
                class="tag-chip"
                data-filter-type="genre"
                data-filter-value=""
                data-filter-active="true"
              >
                All Genres
              </button>
              {sortedGenres.map((genre) => (
                <button
                  type="button"
                  class="tag-chip"
                  data-filter-type="genre"
                  data-filter-value={genre}
                >
                  {genre}
                </button>
              ))}
            </div>
          </div>
        )}
        <div class="bookshelf-filters__results" id="filter-results" aria-live="polite" aria-atomic="true">
          Showing {totalBooks} {totalBooks === 1 ? 'book' : 'books'}
        </div>
      </div>
    )}
    <div class="bookshelf-years">
      {years.map((year) => {
        const yearBooks = booksByYear[year] ?? [];
        const bookCount = yearBooks.length;
        const bookLabel = bookCount === 1 ? 'book' : 'books';

        return (
          <section class="bookshelf-year" id={`bookshelf-${year}`} data-year={year}>
            <div class="bookshelf-year__grid twelve-grid grid-gap-tight">
              <div class="bookshelf-year__sidebar grid-span-2">
                <div class="bookshelf-year__sticky">
                  <span class="bookshelf-year__year">{year}</span>
                  <span class="bookshelf-year__count" data-year-count={year}>{bookCount} {bookLabel}</span>
                </div>
              </div>
              {yearBooks.map((book, index) => {
                const gridClasses = index % 2 === 0 ? 'grid-span-5 grid-start-3' : 'grid-span-5 grid-start-8';
                const bookSlug = book.slug ?? `${year}-${index}`;
                const bookAuthors = extractAuthors(book.data.author).join(',');
                const bookGenre = book.data.genre ?? '';

                return (
                  <div
                    key={bookSlug}
                    class={`bookshelf-year__book ${gridClasses}`}
                    data-book-item
                    data-author={bookAuthors}
                    data-genre={bookGenre}
                  >
                    <BookshelfCard {...transformBook(book)} />
                  </div>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </SectionLanding>
</Layout>

<style>
  .bookshelf-count {
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
  }

  :global(.dark) .bookshelf-count {
    color: #9ca3af;
  }

  .bookshelf-content {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3rem);
    padding-bottom: 2rem;
  }

  .bookshelf-filters {
    display: block;
    margin-bottom: 2rem;
  }

  .bookshelf-filter-group {
    display: block;
    margin-bottom: 1.5rem;
  }

  .bookshelf-filter-group__title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: #111827;
  }

  :global(.dark) .bookshelf-filter-group__title {
    color: #f9fafb;
  }

  .bookshelf-filter-group__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .bookshelf-filter-group__items .tag-chip[data-filter-active="true"] {
    color: rgb(var(--tag-hover-rgb));
    border-color: rgba(var(--tag-hover-rgb), 0.95);
    background-color: rgba(var(--tag-color-rgb), 0.24);
    box-shadow: 0 0 0 1px rgba(var(--tag-hover-rgb), 0.22);
  }

  :global(.dark) .bookshelf-filter-group__items .tag-chip[data-filter-active="true"] {
    color: rgb(var(--tag-dark-hover-rgb));
    border-color: rgba(var(--tag-dark-hover-rgb), 0.92);
    background-color: rgba(var(--tag-dark-color-rgb), 0.32);
    box-shadow: 0 0 0 1px rgba(var(--tag-dark-hover-rgb), 0.24);
  }

  .bookshelf-filters__results {
    font-size: 0.875rem;
    font-weight: 500;
    color: #6b7280;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  :global(.dark) .bookshelf-filters__results {
    color: #9ca3af;
    border-top-color: rgba(255, 255, 255, 0.08);
  }

  .bookshelf-year[data-filtered="hidden"] {
    display: none;
  }

  .bookshelf-year__book[data-filtered="hidden"] {
    display: none;
  }

  .bookshelf-years {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .bookshelf-year__grid {
    align-items: flex-start;
  }

  .bookshelf-year__sidebar {
    display: flex;
  }

  @media (min-width: 48rem) {
    .bookshelf-year__sidebar {
      grid-row: 1 / -1;
    }
  }

  .bookshelf-year__sticky {
    position: sticky;
    top: clamp(4rem, 6vw, 5.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .bookshelf-year__year {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: #111827;
  }

  :global(.dark) .bookshelf-year__year {
    color: #f9fafb;
  }

  .bookshelf-year__count {
    font-size: 0.95rem;
    font-weight: 500;
    color: #6b7280;
  }

  :global(.dark) .bookshelf-year__count {
    color: #9ca3af;
  }

  .bookshelf-year__book {
    display: flex;
  }

  .bookshelf-year__book :global(.book-card) {
    width: 100%;
  }

  @media (max-width: 47.999rem) {
    .bookshelf-year__sticky {
      position: static;
    }
  }

  @media (min-width: 64rem) {
    .bookshelf-year__year {
      font-size: clamp(2.25rem, 4vw, 3.5rem);
    }
  }
</style>

<script>
  function initBookshelfFilters() {
    const filterChips = document.querySelectorAll('[data-filter-type]') as NodeListOf<HTMLButtonElement>;
    const resultsDisplay = document.getElementById('filter-results');

    if (filterChips.length === 0) {
      return;
    }

    // Store current filter state
    let selectedAuthor = '';
    let selectedGenre = '';

    function applyFilters() {
      const allBookItems = document.querySelectorAll('[data-book-item]');
      let visibleCount = 0;

      // Track visible books per year
      const yearCounts: Record<string, number> = {};

      allBookItems.forEach((bookItem) => {
        const bookAuthors = bookItem.getAttribute('data-author') || '';
        const bookGenre = bookItem.getAttribute('data-genre') || '';

        const authorMatch = !selectedAuthor || bookAuthors.split(',').includes(selectedAuthor);
        const genreMatch = !selectedGenre || bookGenre === selectedGenre;

        const isVisible = authorMatch && genreMatch;

        if (isVisible) {
          bookItem.removeAttribute('data-filtered');
          visibleCount++;

          // Get the year from the parent section
          const yearSection = bookItem.closest('[data-year]');
          if (yearSection) {
            const year = yearSection.getAttribute('data-year') || '';
            yearCounts[year] = (yearCounts[year] || 0) + 1;
          }
        } else {
          bookItem.setAttribute('data-filtered', 'hidden');
        }
      });

      // Update year counts and hide empty year sections
      const yearSections = document.querySelectorAll('[data-year]');
      yearSections.forEach((section) => {
        const year = section.getAttribute('data-year') || '';
        const count = yearCounts[year] || 0;

        if (count === 0) {
          section.setAttribute('data-filtered', 'hidden');
        } else {
          section.removeAttribute('data-filtered');

          // Update the year count display
          const countElement = section.querySelector(`[data-year-count="${year}"]`);
          if (countElement) {
            const bookLabel = count === 1 ? 'book' : 'books';
            countElement.textContent = `${count} ${bookLabel}`;
          }
        }
      });

      // Update results display
      if (resultsDisplay) {
        const bookLabel = visibleCount === 1 ? 'book' : 'books';
        resultsDisplay.textContent = `Showing ${visibleCount} ${bookLabel}`;
      }
    }

    function updateChipActiveState() {
      filterChips.forEach((chip) => {
        const filterType = chip.getAttribute('data-filter-type');
        const filterValue = chip.getAttribute('data-filter-value') || '';

        if (filterType === 'author') {
          if (filterValue === selectedAuthor) {
            chip.setAttribute('data-filter-active', 'true');
          } else {
            chip.removeAttribute('data-filter-active');
          }
        } else if (filterType === 'genre') {
          if (filterValue === selectedGenre) {
            chip.setAttribute('data-filter-active', 'true');
          } else {
            chip.removeAttribute('data-filter-active');
          }
        }
      });
    }

    // Handle filter chip clicks
    filterChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const filterType = chip.getAttribute('data-filter-type');
        const filterValue = chip.getAttribute('data-filter-value') || '';

        if (filterType === 'author') {
          selectedAuthor = filterValue;
        } else if (filterType === 'genre') {
          selectedGenre = filterValue;
        }

        updateChipActiveState();
        applyFilters();
      });
    });
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBookshelfFilters);
  } else {
    initBookshelfFilters();
  }
</script>
