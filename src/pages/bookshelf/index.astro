---
import Layout from '../../layouts/Layout.astro';
import BookGrid from '../../components/layout/BookGrid.astro';
import BookCard from '../../components/BookCard.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import TagList from '../../components/TagList.astro';
import { getAllPosts } from '../../utils/content';

// Get all posts and filter for bookshelf
const allPosts = await getAllPosts();
const bookshelfPosts = allPosts
  .filter(post => post.data.category === 'bookshelf')
  .sort((a, b) => {
    // Sort by finished reading date if available, otherwise by pub date
    const aDate = a.data.finishedReading || a.data.pubDate;
    const bDate = b.data.finishedReading || b.data.pubDate;
    return new Date(bDate).getTime() - new Date(aDate).getTime();
  });

// Group books by year based on finished reading date or pub date
// Exclude currently reading books from yearly sections
const booksByYear = bookshelfPosts
  .filter(book => book.data.bookStatus !== 'reading')
  .reduce((acc, book) => {
    const date = book.data.finishedReading || book.data.pubDate;
    const year = new Date(date).getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(book);
    return acc;
  }, {} as Record<number, typeof bookshelfPosts>);

// Get sorted years (newest first)
const years = Object.keys(booksByYear)
  .map(Number)
  .sort((a, b) => b - a);

// Calculate total books
const totalBooks = bookshelfPosts.length;
const currentlyReadingCount = bookshelfPosts.filter(book => book.data.bookStatus === 'reading').length;
const readBooksCount = bookshelfPosts.filter(book => book.data.bookStatus === 'read' || !book.data.bookStatus).length;
---

<Layout 
  title="Bookshelf" 
  description="Book reviews and reading notes organized by year" 
  currentPage="/bookshelf/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
  <PageHeader 
    title="Bookshelf"
    description="Book reviews, reading notes, and thoughts on literature."
    layout="centered"
    size="lg"
    maxWidth="7xl"
  />
  

  <TagList category="bookshelf" />

  {/* Currently Reading Section */}
  {currentlyReadingCount > 0 && (
    <section class="currently-reading-section">
      <h2 class="section-title">
        <span>Currently Reading</span>
        <span class="section-count">
          {currentlyReadingCount} book{currentlyReadingCount !== 1 ? 's' : ''}
        </span>
      </h2>
      
      <div class="book-grid">
        {bookshelfPosts
          .filter(book => book.data.bookStatus === 'reading')
          .map((book) => (
            <div class="book-card-wrapper">
              <BookCard {...book.data} link={book.slug ? `/bookshelf/${book.slug}/` : undefined} />
            </div>
          ))}
      </div>
    </section>
  )}

  {/* Books by Year */}
  {years.map(year => (
    <section class="year-section" data-year={year}>
      <h2 class="year-title">
        <span>{year}</span>
        <span class="year-count">
          {booksByYear[year].length} book{booksByYear[year].length !== 1 ? 's' : ''}
        </span>
      </h2>
      
      <BookGrid books={booksByYear[year]} showCurrentlyReading={false} />
    </section>
  ))}
</Layout>

<style>
  .bookshelf-header {
    padding: 1.5rem 0 1rem;
    text-align: center;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 1.5rem;
  }

  :global(.dark) .bookshelf-header {
    border-bottom-color: #374151;
  }

  .bookshelf-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 0.5rem;
    color: #111827;
  }

  :global(.dark) .bookshelf-title {
    color: #f9fafb;
  }

  .bookshelf-description {
    font-size: 1rem;
    line-height: 1.5;
    color: #6b7280;
    margin-bottom: 1rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  :global(.dark) .bookshelf-description {
    color: #9ca3af;
  }

  .currently-reading-section {
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #111827;
  }

  :global(.dark) .section-title {
    color: #f9fafb;
  }

  .section-count {
    font-size: 1rem;
    font-weight: 500;
    color: #6b7280;
  }

  :global(.dark) .section-count {
    color: #9ca3af;
  }

  .book-grid {
    display: grid;
    gap: 1.5rem;
    width: 100%;
  }

  /* Mobile: 1 column */
  .book-grid {
    grid-template-columns: 1fr;
  }

  /* Small tablet: 2 columns */
  @media (min-width: 640px) {
    .book-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Large tablet and desktop: 2 columns for better readability */
  @media (min-width: 1024px) {
    .book-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .book-card-wrapper {
    /* Just a container - don't interfere with BookCard's internal layout */
  }

  .year-section {
    margin-bottom: 2rem;
  }

  .year-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #111827;
  }

  :global(.dark) .year-title {
    color: #f9fafb;
  }

  .year-count {
    font-size: 1rem;
    font-weight: 500;
    color: #6b7280;
  }

  :global(.dark) .year-count {
    color: #9ca3af;
  }



  /* Mobile adjustments */
  @media (max-width: 768px) {
    .bookshelf-header {
      padding: 1rem 1rem 0.75rem;
      margin-bottom: 1rem;
    }

    .bookshelf-title {
      font-size: 2rem;
    }

    .bookshelf-description {
      font-size: 0.95rem;
      margin-bottom: 0.75rem;
    }


    .currently-reading-section {
      margin-bottom: 1.5rem;
    }

    .section-title {
      font-size: 1.25rem;
      margin-bottom: 1rem;
    }

    .book-grid {
      gap: 1rem;
    }

    .year-section {
      margin-bottom: 1.5rem;
      padding: 0 1rem;
    }

    .year-title {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 768px) and (max-width: 1024px) {
    .bookshelf-title {
      font-size: 2.25rem;
    }
  }
</style> 