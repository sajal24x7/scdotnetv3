---
import Layout from '../../layouts/Layout.astro';
import GardenGrid from '../../components/layout/GardenGrid.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import TagList from '../../components/TagList.astro';
import { getAllPosts, transformPost } from '../../utils/content';


// Get all posts and filter for bookshelf
const allPosts = await getAllPosts();
const bookshelfPosts = allPosts
  .filter(post => post.data.category === 'bookshelf')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for grid component
const transformedPosts = bookshelfPosts.map(transformPost);

// Group transformed posts by year
const postsByYear = transformedPosts.reduce((acc, post) => {
  const year = new Date(post.data.pubDate).getFullYear();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof transformedPosts>);

// Get sorted years (newest first)
const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);


---

<Layout 
  title="Bookshelf" 
  description="Book reviews and reading notes organized by year" 
  currentPage="/bookshelf/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
  <PageHeader 
    title="Bookshelf"
    description="Book reviews, reading notes, and thoughts on literature."
    layout="centered"
    size="lg"
    maxWidth="7xl"
  />
  
  <div class="bookshelf-count mb-6 text-center">
    {bookshelfPosts.length} {bookshelfPosts.length === 1 ? 'book' : 'books'}
  </div>

  <TagList category="bookshelf" />

  {/* Books by Year */}
  {years.map(year => (
    <section class="year-section" data-year={year}>
      <h2 class="year-title">
        <span>{year}</span>
        <span class="year-count">
          {postsByYear[year].length} book{postsByYear[year].length !== 1 ? 's' : ''}
        </span>
      </h2>
      
      <GardenGrid posts={postsByYear[year]} contentType="bookshelf" />
    </section>
  ))}
</Layout>

<style>
  .bookshelf-header {
    padding: 1.5rem 0 1rem;
    text-align: center;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 1.5rem;
  }

  :global(.dark) .bookshelf-header {
    border-bottom-color: #374151;
  }

  .bookshelf-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 0.5rem;
    color: #111827;
  }

  :global(.dark) .bookshelf-title {
    color: #f9fafb;
  }

  .bookshelf-description {
    font-size: 1rem;
    line-height: 1.5;
    color: #6b7280;
    margin-bottom: 1rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  :global(.dark) .bookshelf-description {
    color: #9ca3af;
  }

  .bookshelf-count {
    font-size: 0.875rem;
    font-weight: 500;
    color: #8b5cf6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  :global(.dark) .bookshelf-count {
    color: #a78bfa;
  }

  .year-section {
    margin-bottom: 2rem;
  }

  .year-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #111827;
  }

  :global(.dark) .year-title {
    color: #f9fafb;
  }

  .year-count {
    font-size: 1rem;
    font-weight: 500;
    color: #6b7280;
  }

  :global(.dark) .year-count {
    color: #9ca3af;
  }



  /* Mobile adjustments */
  @media (max-width: 768px) {
    .bookshelf-header {
      padding: 1rem 1rem 0.75rem;
      margin-bottom: 1rem;
    }

    .bookshelf-title {
      font-size: 2rem;
    }

    .bookshelf-description {
      font-size: 0.95rem;
      margin-bottom: 0.75rem;
    }

    .year-section {
      margin-bottom: 1.5rem;
      padding: 0 1rem;
    }

    .year-title {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 768px) and (max-width: 1024px) {
    .bookshelf-title {
      font-size: 2.25rem;
    }
  }
</style> 