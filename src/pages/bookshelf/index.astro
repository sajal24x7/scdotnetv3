---
import Layout from '../../layouts/Layout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import BookshelfCard from '../../components/bookshelf/BookshelfCard.astro';
import { getAllPosts } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';

// Get all posts and filter for bookshelf
const allPosts = await getAllPosts();
const bookshelfPosts = allPosts.filter((post) => post.data.category === 'bookshelf');

const normalizeStatus = (status?: string | null) => {
    switch (status) {
        case 'read':
        case 'finished':
            return 'finished';
        case 'reading':
        case 'on-hold':
        case 'to-read':
            return status;
        default:
            return 'finished';
    }
};

const statusOrder: Record<string, number> = {
    reading: 0,
    finished: 1,
    'on-hold': 2,
    'to-read': 3,
    other: 4
};

const toTime = (value?: Date | string | null) => {
    if (!value) {
        return 0;
    }

    const date = value instanceof Date ? value : new Date(value);
    const time = date.getTime();
    return Number.isNaN(time) ? 0 : time;
};

const compareDesc = (a?: Date | string | null, b?: Date | string | null) => {
    return toTime(b) - toTime(a);
};

const parseDate = (value?: Date | string | null) => {
    if (!value) return null;
    const date = value instanceof Date ? value : new Date(value);
    return Number.isNaN(date.getTime()) ? null : date;
};

const getBookYear = (book: typeof bookshelfPosts[number]) => {
    const finished = parseDate(book.data.finishedReading);
    if (finished) return finished.getFullYear();

    const started = parseDate(book.data.startedReading);
    if (started) return started.getFullYear();

    const pub = parseDate(book.data.pubDate);
    return (pub ?? new Date()).getFullYear();
};

const booksWithYear = bookshelfPosts.map((book) => ({
    book,
    year: getBookYear(book)
}));

const sortedBooks = [...booksWithYear].sort((a, b) => {
    if (a.year !== b.year) {
        return b.year - a.year;
    }

    const statusA = normalizeStatus(a.book.data.bookStatus);
    const statusB = normalizeStatus(b.book.data.bookStatus);

    if (statusA !== statusB) {
        return (statusOrder[statusA] ?? statusOrder.other) - (statusOrder[statusB] ?? statusOrder.other);
    }

    if (statusA === 'reading') {
        const progressA = typeof a.book.data.readingProgress === 'number' ? a.book.data.readingProgress : -1;
        const progressB = typeof b.book.data.readingProgress === 'number' ? b.book.data.readingProgress : -1;

        if (progressA !== progressB) {
            return progressB - progressA;
        }

        return compareDesc(a.book.data.startedReading ?? a.book.data.pubDate, b.book.data.startedReading ?? b.book.data.pubDate);
    }

    if (statusA === 'finished') {
        return compareDesc(a.book.data.finishedReading ?? a.book.data.pubDate, b.book.data.finishedReading ?? b.book.data.pubDate);
    }

    if (statusA === 'on-hold' || statusA === 'to-read') {
        return compareDesc(a.book.data.startedReading ?? a.book.data.pubDate, b.book.data.startedReading ?? b.book.data.pubDate);
    }

    return compareDesc(a.book.data.pubDate, b.book.data.pubDate);
});

const years = Array.from(new Set(sortedBooks.map((entry) => entry.year)));

const booksByYear = sortedBooks.reduce((acc, { year, book }) => {
    if (!acc[year]) {
        acc[year] = [];
    }
    acc[year].push(book);
    return acc;
}, {} as Record<number, typeof bookshelfPosts>);

const transformBook = (book: typeof bookshelfPosts[number]) => ({
    ...book.data,
    link: book.slug ? `/bookshelf/${book.slug}/` : undefined
});

// Extract unique authors and genres for filters
const extractAuthors = (author?: string | string[] | null) => {
    if (!author) return [];
    return Array.isArray(author) ? author : [author];
};

const authorCounts: Record<string, number> = {};
const genreCounts: Record<string, number> = {};

bookshelfPosts.forEach((book) => {
    const authors = extractAuthors(book.data.author);
    authors.forEach((author) => {
        authorCounts[author] = (authorCounts[author] || 0) + 1;
    });

    if (book.data.genre) {
        genreCounts[book.data.genre] = (genreCounts[book.data.genre] || 0) + 1;
    }
});

// Sort by count (descending), then alphabetically
const sortedAuthors = Object.entries(authorCounts)
    .sort((a, b) => {
        const countDiff = b[1] - a[1];
        return countDiff !== 0 ? countDiff : a[0].localeCompare(b[0]);
    });

const sortedGenres = Object.entries(genreCounts)
    .sort((a, b) => {
        const countDiff = b[1] - a[1];
        return countDiff !== 0 ? countDiff : a[0].localeCompare(b[0]);
    });

const initialAuthorCount = 5;
const initialGenreCount = 5;
const topAuthors = sortedAuthors.slice(0, initialAuthorCount);
const topGenres = sortedGenres.slice(0, initialGenreCount);
const hasMoreAuthors = sortedAuthors.length > initialAuthorCount;
const hasMoreGenres = sortedGenres.length > initialGenreCount;

// Calculate total books count
const totalBooks = bookshelfPosts.length;
const countText = `${totalBooks} ${totalBooks === 1 ? 'book' : 'books'}`;

const sectionLandingProps = createSectionLandingProps({
    title: 'Bookshelf',
    description: "Books I'm reading, have finished, or have on deck—organized by year with inline status cues.",
    countText,
    countVariant: 'plain',
    countClass: 'bookshelf-count',
    tagCategory: 'bookshelf',
    tagPosts: allPosts,
    contentClass: 'bookshelf-content'
});
---

<Layout
  title="Bookshelf"
  description="Books I've read and am currently reading"
  currentPage="/bookshelf/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  allPosts={allPosts}
  enableSearchModal
  enableLinkHoverEffect
>
  <SectionLanding {...sectionLandingProps}>
    <div class="bookshelf-filters__results" id="filter-results" aria-live="polite" aria-atomic="true" hidden>
      <div class="bookshelf-filters__summary" id="filter-summary">
        Showing <span id="filter-count">{totalBooks}</span> {totalBooks === 1 ? 'book' : 'books'}
      </div>
      <div class="bookshelf-filters__active" id="active-filters"></div>
    </div>
    <div class="bookshelf-years">
      {years.map((year) => {
        const yearBooks = booksByYear[year] ?? [];
        const bookCount = yearBooks.length;
        const bookLabel = bookCount === 1 ? 'book' : 'books';

        return (
          <section class="bookshelf-year" id={`bookshelf-${year}`} data-year={year}>
            <div class="bookshelf-year__grid twelve-grid grid-gap-tight">
              <div class="bookshelf-year__sidebar grid-span-2">
                <div class="bookshelf-year__sticky">
                  <span class="bookshelf-year__year">{year}</span>
                  <span class="bookshelf-year__count" data-year-count={year}>{bookCount} {bookLabel}</span>
                </div>
              </div>
              {yearBooks.map((book, index) => {
                const gridClasses = index % 2 === 0 ? 'grid-span-5 grid-start-3' : 'grid-span-5 grid-start-8';
                const bookSlug = book.slug ?? `${year}-${index}`;
                const bookAuthors = extractAuthors(book.data.author).join(',');
                const bookGenre = book.data.genre ?? '';
                const bookStatus = normalizeStatus(book.data.bookStatus);

                return (
                  <div
                    key={bookSlug}
                    class={`bookshelf-year__book ${gridClasses}`}
                    data-book-item
                    data-author={bookAuthors}
                    data-genre={bookGenre}
                    data-status={bookStatus}
                  >
                    <BookshelfCard {...transformBook(book)} />
                  </div>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </SectionLanding>
</Layout>

<style>
  .bookshelf-count {
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
  }

  :global(.dark) .bookshelf-count {
    color: #9ca3af;
  }

  .bookshelf-content {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3rem);
    padding-bottom: 2rem;
  }

  .bookshelf-filters__results {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #6b7280;
    padding: 1rem;
    background: rgba(99, 102, 241, 0.04);
    border: 1px solid rgba(99, 102, 241, 0.15);
    border-radius: 0.5rem;
    margin-bottom: 1.5rem;
  }

  :global(.dark) .bookshelf-filters__results {
    color: #9ca3af;
    background: rgba(99, 102, 241, 0.08);
    border-color: rgba(99, 102, 241, 0.2);
  }

  .bookshelf-filters__summary {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .bookshelf-filters__active {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  :global(.filter-badge) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    background: #ffffff;
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 0.375rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: #4f46e5;
    cursor: pointer;
    transition: all 150ms ease;
  }

  :global(.dark) :global(.filter-badge) {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(99, 102, 241, 0.4);
    color: #a5b4fc;
  }

  :global(.filter-badge:hover) {
    background: rgba(99, 102, 241, 0.1);
    border-color: rgba(99, 102, 241, 0.5);
    transform: translateY(-1px);
  }

  :global(.dark) :global(.filter-badge:hover) {
    background: rgba(99, 102, 241, 0.15);
    border-color: rgba(99, 102, 241, 0.6);
  }

  :global(.filter-badge__label) {
    white-space: nowrap;
  }

  :global(.filter-badge__remove) {
    font-size: 1.2rem;
    line-height: 1;
    font-weight: 600;
    opacity: 0.7;
    transition: opacity 150ms ease;
  }

  :global(.filter-badge:hover) :global(.filter-badge__remove) {
    opacity: 1;
  }

  :global(.filter-badge--clear-all) {
    background: #ef4444;
    color: #ffffff;
    border-color: #dc2626;
  }

  :global(.dark) :global(.filter-badge--clear-all) {
    background: #dc2626;
    border-color: #b91c1c;
  }

  :global(.filter-badge--clear-all:hover) {
    background: #dc2626;
    border-color: #b91c1c;
  }

  :global(.dark) :global(.filter-badge--clear-all:hover) {
    background: #b91c1c;
    border-color: #991b1b;
  }

  .bookshelf-year[data-filtered="hidden"] {
    display: none;
  }

  .bookshelf-year__book[data-filtered="hidden"] {
    display: none;
  }

  .bookshelf-years {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .bookshelf-year__grid {
    align-items: flex-start;
  }

  .bookshelf-year__sidebar {
    display: flex;
  }

  @media (min-width: 48rem) {
    .bookshelf-year__sidebar {
      grid-row: 1 / -1;
    }
  }

  .bookshelf-year__sticky {
    position: sticky;
    top: clamp(4rem, 6vw, 5.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .bookshelf-year__year {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: #111827;
  }

  :global(.dark) .bookshelf-year__year {
    color: #f9fafb;
  }

  .bookshelf-year__count {
    font-size: 0.95rem;
    font-weight: 500;
    color: #6b7280;
  }

  :global(.dark) .bookshelf-year__count {
    color: #9ca3af;
  }

  .bookshelf-year__book {
    display: flex;
  }

  .bookshelf-year__book :global(.book-card) {
    width: 100%;
  }

  @media (max-width: 47.999rem) {
    .bookshelf-year__sticky {
      position: static;
    }
  }

  @media (min-width: 64rem) {
    .bookshelf-year__year {
      font-size: clamp(2.25rem, 4vw, 3.5rem);
    }
  }
</style>

<script>
  function initBookshelfFilters() {
    const resultsDisplay = document.getElementById('filter-results');
    const filterCountElement = document.getElementById('filter-count');
    const activeFiltersContainer = document.getElementById('active-filters');

    // Store current filter state
    let selectedAuthor = '';
    let selectedGenre = '';
    let selectedStatus = '';

    // Map for display labels
    const statusDisplayMap: Record<string, string> = {
      reading: 'Currently Reading',
      finished: 'Finished',
      'on-hold': 'On Hold',
      'to-read': 'To Read'
    };

    function updateFilterDisplay() {
      if (!activeFiltersContainer) return;

      const hasFilters = selectedAuthor || selectedGenre || selectedStatus;

      if (!hasFilters) {
        if (resultsDisplay) {
          resultsDisplay.setAttribute('hidden', '');
        }
        activeFiltersContainer.innerHTML = '';
        return;
      }

      if (resultsDisplay) {
        resultsDisplay.removeAttribute('hidden');
      }

      // Build filter badges
      const badges: string[] = [];

      if (selectedAuthor) {
        badges.push(`
          <button type="button" class="filter-badge" data-remove-filter="author">
            <span class="filter-badge__label">Author: ${selectedAuthor}</span>
            <span class="filter-badge__remove" aria-label="Remove author filter">×</span>
          </button>
        `);
      }

      if (selectedGenre) {
        badges.push(`
          <button type="button" class="filter-badge" data-remove-filter="genre">
            <span class="filter-badge__label">Genre: ${selectedGenre}</span>
            <span class="filter-badge__remove" aria-label="Remove genre filter">×</span>
          </button>
        `);
      }

      if (selectedStatus) {
        const statusLabel = statusDisplayMap[selectedStatus] || selectedStatus;
        badges.push(`
          <button type="button" class="filter-badge" data-remove-filter="status">
            <span class="filter-badge__label">Status: ${statusLabel}</span>
            <span class="filter-badge__remove" aria-label="Remove status filter">×</span>
          </button>
        `);
      }

      // Add clear all button if multiple filters
      if (badges.length > 1) {
        badges.push(`
          <button type="button" class="filter-badge filter-badge--clear-all" data-remove-filter="all">
            Clear all filters
          </button>
        `);
      }

      activeFiltersContainer.innerHTML = badges.join('');
    }

    function applyFilters() {
      const allBookItems = document.querySelectorAll('[data-book-item]');
      let visibleCount = 0;

      // Track visible books per year
      const yearCounts: Record<string, number> = {};

      allBookItems.forEach((bookItem) => {
        const bookAuthors = bookItem.getAttribute('data-author') || '';
        const bookGenre = bookItem.getAttribute('data-genre') || '';
        const bookStatus = bookItem.getAttribute('data-status') || '';

        const authorMatch = !selectedAuthor || bookAuthors.split(',').includes(selectedAuthor);
        const genreMatch = !selectedGenre || bookGenre === selectedGenre;
        const statusMatch = !selectedStatus || bookStatus === selectedStatus;

        const isVisible = authorMatch && genreMatch && statusMatch;

        if (isVisible) {
          bookItem.removeAttribute('data-filtered');
          visibleCount++;

          // Get the year from the parent section
          const yearSection = bookItem.closest('[data-year]');
          if (yearSection) {
            const year = yearSection.getAttribute('data-year') || '';
            yearCounts[year] = (yearCounts[year] || 0) + 1;
          }
        } else {
          bookItem.setAttribute('data-filtered', 'hidden');
        }
      });

      // Update year counts and hide empty year sections
      const yearSections = document.querySelectorAll('[data-year]');
      yearSections.forEach((section) => {
        const year = section.getAttribute('data-year') || '';
        const count = yearCounts[year] || 0;

        if (count === 0) {
          section.setAttribute('data-filtered', 'hidden');
        } else {
          section.removeAttribute('data-filtered');

          // Update the year count display
          const countElement = section.querySelector(`[data-year-count="${year}"]`);
          if (countElement) {
            const bookLabel = count === 1 ? 'book' : 'books';
            countElement.textContent = `${count} ${bookLabel}`;
          }
        }
      });

      // Update results count
      if (filterCountElement) {
        filterCountElement.textContent = String(visibleCount);
      }

      // Update filter display
      updateFilterDisplay();
    }

    function resetFilters() {
      selectedAuthor = '';
      selectedGenre = '';
      selectedStatus = '';

      // Hide results display when no filters active
      if (resultsDisplay) {
        resultsDisplay.setAttribute('hidden', '');
      }

      // Reset all book items
      const allBookItems = document.querySelectorAll('[data-book-item]');
      allBookItems.forEach((bookItem) => {
        bookItem.removeAttribute('data-filtered');
      });

      // Reset year counts
      const yearSections = document.querySelectorAll('[data-year]');
      yearSections.forEach((section) => {
        section.removeAttribute('data-filtered');
        const year = section.getAttribute('data-year') || '';
        const allYearBooks = section.querySelectorAll('[data-book-item]');
        const count = allYearBooks.length;

        const countElement = section.querySelector(`[data-year-count="${year}"]`);
        if (countElement) {
          const bookLabel = count === 1 ? 'book' : 'books';
          countElement.textContent = `${count} ${bookLabel}`;
        }
      });

      // Update filter display
      updateFilterDisplay();
    }

    // Handle clicks on card field filters and remove filter buttons
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;

      // Check for remove filter button
      const removeButton = target.closest('[data-remove-filter]') as HTMLElement;
      if (removeButton) {
        event.preventDefault();
        const filterToRemove = removeButton.getAttribute('data-remove-filter');

        if (filterToRemove === 'all') {
          resetFilters();
        } else if (filterToRemove === 'author') {
          selectedAuthor = '';
          applyFilters();
        } else if (filterToRemove === 'genre') {
          selectedGenre = '';
          applyFilters();
        } else if (filterToRemove === 'status') {
          selectedStatus = '';
          applyFilters();
        }
        return;
      }

      // Check for filter trigger
      const filterTrigger = target.closest('[data-filter-type]') as HTMLElement;
      if (filterTrigger) {
        event.preventDefault();
        const filterType = filterTrigger.getAttribute('data-filter-type');
        const filterValue = filterTrigger.getAttribute('data-filter-value') || '';

        // Toggle filter - if clicking the same filter, remove it
        if (filterType === 'author') {
          if (selectedAuthor === filterValue) {
            selectedAuthor = '';
          } else {
            selectedAuthor = filterValue;
          }
        } else if (filterType === 'genre') {
          if (selectedGenre === filterValue) {
            selectedGenre = '';
          } else {
            selectedGenre = filterValue;
          }
        } else if (filterType === 'status') {
          if (selectedStatus === filterValue) {
            selectedStatus = '';
          } else {
            selectedStatus = filterValue;
          }
        }

        applyFilters();
      }
    });
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBookshelfFilters);
  } else {
    initBookshelfFilters();
  }
</script>
