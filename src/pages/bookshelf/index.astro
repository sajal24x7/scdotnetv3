---
import Layout from '../../layouts/Layout.astro';
import BookGrid from '../../components/layout/BookGrid.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import TagList from '../../components/TagList.astro';
import { getAllPosts } from '../../utils/content';

// Get all posts and filter for bookshelf
const allPosts = await getAllPosts();
const bookshelfPosts = allPosts
  .filter(post => post.data.category === 'bookshelf')
  .sort((a, b) => {
    // Sort by finished reading date if available, otherwise by pub date
    const aDate = a.data.finishedReading || a.data.pubDate;
    const bDate = b.data.finishedReading || b.data.pubDate;
    return new Date(bDate).getTime() - new Date(aDate).getTime();
  });

// Group books by year based on finished reading date or pub date
const booksByYear = bookshelfPosts.reduce((acc, book) => {
  const date = book.data.finishedReading || book.data.pubDate;
  const year = new Date(date).getFullYear();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(book);
  return acc;
}, {} as Record<number, typeof bookshelfPosts>);

// Get sorted years (newest first)
const years = Object.keys(booksByYear)
  .map(Number)
  .sort((a, b) => b - a);

// Calculate total books
const totalBooks = bookshelfPosts.length;
const currentlyReadingCount = bookshelfPosts.filter(book => book.data.bookStatus === 'reading').length;
const readBooksCount = bookshelfPosts.filter(book => book.data.bookStatus === 'read' || !book.data.bookStatus).length;
---

<Layout 
  title="Bookshelf" 
  description="Book reviews and reading notes organized by year" 
  currentPage="/bookshelf/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
  <PageHeader 
    title="Bookshelf"
    description="Book reviews, reading notes, and thoughts on literature."
    layout="centered"
    size="lg"
    maxWidth="7xl"
  />
  
  <div class="bookshelf-stats mb-6 text-center">
    <div class="stat-item">
      <span class="stat-number">{totalBooks}</span>
      <span class="stat-label">Total Books</span>
    </div>
    {currentlyReadingCount > 0 && (
      <div class="stat-item">
        <span class="stat-number">{currentlyReadingCount}</span>
        <span class="stat-label">Currently Reading</span>
      </div>
    )}
    <div class="stat-item">
      <span class="stat-number">{readBooksCount}</span>
      <span class="stat-label">Read</span>
    </div>
  </div>

  <TagList category="bookshelf" />

  {/* Books by Year */}
  {years.map(year => (
    <section class="year-section" data-year={year}>
      <h2 class="year-title">
        <span>{year}</span>
        <span class="year-count">
          {booksByYear[year].length} book{booksByYear[year].length !== 1 ? 's' : ''}
        </span>
      </h2>
      
      <BookGrid books={booksByYear[year]} showCurrentlyReading={true} />
    </section>
  ))}
</Layout>

<style>
  .bookshelf-header {
    padding: 1.5rem 0 1rem;
    text-align: center;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 1.5rem;
  }

  :global(.dark) .bookshelf-header {
    border-bottom-color: #374151;
  }

  .bookshelf-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 0.5rem;
    color: #111827;
  }

  :global(.dark) .bookshelf-title {
    color: #f9fafb;
  }

  .bookshelf-description {
    font-size: 1rem;
    line-height: 1.5;
    color: #6b7280;
    margin-bottom: 1rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  :global(.dark) .bookshelf-description {
    color: #9ca3af;
  }

  .bookshelf-stats {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .stat-number {
    font-size: 2rem;
    font-weight: 800;
    color: #f59e0b;
    line-height: 1;
  }

  :global(.dark) .stat-number {
    color: #fbbf24;
  }

  .stat-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.dark) .stat-label {
    color: #9ca3af;
  }

  .year-section {
    margin-bottom: 2rem;
  }

  .year-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #111827;
  }

  :global(.dark) .year-title {
    color: #f9fafb;
  }

  .year-count {
    font-size: 1rem;
    font-weight: 500;
    color: #6b7280;
  }

  :global(.dark) .year-count {
    color: #9ca3af;
  }



  /* Mobile adjustments */
  @media (max-width: 768px) {
    .bookshelf-header {
      padding: 1rem 1rem 0.75rem;
      margin-bottom: 1rem;
    }

    .bookshelf-title {
      font-size: 2rem;
    }

    .bookshelf-description {
      font-size: 0.95rem;
      margin-bottom: 0.75rem;
    }

    .bookshelf-stats {
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .stat-number {
      font-size: 1.5rem;
    }

    .stat-label {
      font-size: 0.8rem;
    }

    .year-section {
      margin-bottom: 1.5rem;
      padding: 0 1rem;
    }

    .year-title {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 768px) and (max-width: 1024px) {
    .bookshelf-title {
      font-size: 2.25rem;
    }
  }
</style> 