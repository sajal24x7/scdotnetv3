---
import Layout from '../../../layouts/Layout.astro';
import SectionLanding from '../../../layouts/SectionLanding.astro';
import ShelfQueue, { type ShelfQueueItem } from '../../../components/shelf/ShelfQueue.astro';
import ShelfQueueToggle from '../../../components/shelf/ShelfQueueToggle.astro';
import { getAllPosts } from '../../../utils/content';
import { createSectionLandingProps } from '../../../utils/sectionLanding';
import { SHELF_QUEUE_CONFIG, getQueueCreators } from '../../../utils/shelfQueue';
import { getBookCoverImage } from '../../../utils/bookCovers';

const config = SHELF_QUEUE_CONFIG.bookshelf;

const allPosts = await getAllPosts();
const queuePosts = allPosts.filter(
    (post) => post.data.category === 'bookshelf' && post.data.status === 'todo'
);

queuePosts.sort((a, b) => new Date(b.data.created).getTime() - new Date(a.data.created).getTime());

const items: ShelfQueueItem[] = queuePosts.map((post) => ({
    id: post.id,
    title: post.data.title ?? '',
    creators: getQueueCreators(post.data, config.creatorField),
    created: new Date(post.data.created),
    body: post.body?.trim() ?? '',
    coverImage: post.data.cover ? getBookCoverImage(post.data.cover as any) : undefined,
    link: post.id ? `/bookshelf/${post.id}/` : undefined,
    genre: post.data.genre,
    tags: post.data.tags,
    series: post.data.series && post.data.series !== 'none' ? post.data.series : undefined,
    seriesNumber: post.data.seriesNumber,
}));

const { singular, plural } = config.noun;
const countText = `${items.length} ${items.length === 1 ? singular : plural}`;

// Same header as the main shelf page; the tag list only counts queued entries.
const sectionLandingProps = createSectionLandingProps({
    title: config.heading,
    countText,
    countVariant: 'plain',
    countClass: 'bookshelf-count',
    tagCategory: 'bookshelf',
    tagPosts: queuePosts,
    contentClass: 'bookshelf-content',
    hideTitle: true,
});
---

<Layout
  title={`${config.heading} — Bookshelf`}
  description="Books on the to-read list"
  currentPage="/bookshelf/queue/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: { gap: 'loose', padding: 'narrow' }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
  <SectionLanding {...sectionLandingProps}>
    <div slot="afterHeader" class="shelf-header-block">
      <div class="shelf-title-row">
        <ShelfQueueToggle category="bookshelf" active="queue" />
      </div>
      <p class="shelf-description">Books on the to-read list.</p>
    </div>
    <ShelfQueue config={config} items={items} />
  </SectionLanding>
</Layout>
