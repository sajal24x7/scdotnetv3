---
import Layout from '../../layouts/Layout.astro';
import ContentGrid from '../../components/ContentGrid.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for prose (stories and poems)
const allPosts = await getAllPosts();
const prose = allPosts
  .filter(post => ['story', 'poem'].includes(post.data.category))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = prose.map(transformPost);
---

<Layout 
  title="Prose" 
  description="Stories and poems" 
  currentPage="/prose/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
    <PageHeader 
      title="Prose"
      description="Stories and poems from my collections."
      layout="centered"
      size="lg"
    />
    
    <div class="prose-count mb-6 text-center">
      {transformedPosts.length} {transformedPosts.length === 1 ? 'piece' : 'pieces'}
    </div>
    
    <div class="text-center mb-6">
      <a 
        href="/tags/?category=prose" 
        class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
      >
        View entries by tag
      </a>
    </div>

    <main class="prose-main">
      <ContentGrid posts={transformedPosts} />
    </main>
</Layout>

<style>
  .prose-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .prose-count {
    font-size: 0.875rem;
    font-weight: 500;
    color: #8b5cf6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.dark) .prose-count {
    color: #a78bfa;
  }

  .prose-main {
    padding-bottom: 2rem;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .prose-container {
      max-width: none;
      padding: 0;
    }

    .prose-main {
      padding-bottom: 1.5rem;
    }
  }
</style> 