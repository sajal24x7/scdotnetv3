---
import Layout from '../../layouts/Layout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import { Image } from 'astro:assets';
import BookCover from '../../images/books/01-ayom.jpg';

// Book data - add new books here in reverse chronological order
const books = [
  {
    year: 2025,
    title: "A Year of Mornings",
    subtitle: "Poems for Young Adults",
    url: "/books/a-year-of-mornings/",
    description: "A year of mornings is a collection of fifty love poems. It follows a young heart as it finds love, finds the strength to be in love and finally, finds the strength to let go.",
    available: true,
    coverImage: BookCover
  }
  // Future books will be added here
];
---

<Layout title="Books - Sajal Choudhary" description="Books by Sajal Choudhary" currentPage="/books/"
    pageWrapper={{
        maxWidth: '7xl',
        padding: 'none',
        centered: true,
        grid: {
            gap: 'loose',
            padding: 'narrow'
        }
    }}
    enableSearchModal
    enableLinkHoverEffect
>
    <SectionLanding
        title="Books by Sajal Choudhary"
        description="Essays and other writing can be found throughout this site: garden, blog posts, prose."
        layout="centered"
        headerSize="lg"
        headerMaxWidth="7xl"
        contentClass="books-layout"
        contentPadding="clamp(2rem, 5vw, 3rem)"
    >
        <section class="books-list">
            {books.map((book) => (
                <article class="books-item twelve-grid grid-gap-tight">
                    <div class="books-item__content grid-span-10 grid-start-2">
                        <div class="books-item__inner ten-grid grid-gap-normal">
                            <div class="books-item__year grid-span-2 grid-start-1">
                                <div class="books-item__year-sticky">
                                    <span class="year-text">{book.year}</span>
                                </div>
                            </div>

                            {book.coverImage && (
                                <div class="books-item__cover grid-span-2 grid-start-3">
                                    <Image
                                        src={book.coverImage}
                                        alt={`${book.title} cover`}
                                        class="books-item__cover-image"
                                    />
                                </div>
                            )}

                            <div class="books-item__details grid-span-6 grid-start-5">
                                <h2 class="books-item__title text-xl font-semibold">
                                    {book.available ? (
                                        <a href={book.url} class="link-hover">
                                            <em>{book.title}</em>: {book.subtitle}
                                        </a>
                                    ) : (
                                        <span><em>{book.title}</em>: {book.subtitle}</span>
                                    )}
                                </h2>

                                {book.description && (
                                    <p class="books-item__description text-textSecondary dark:text-textSecondaryDark leading-relaxed">
                                        {book.description}
                                    </p>
                                )}
                            </div>
                        </div>
                    </div>
                </article>
            ))}
        </section>

        <nav class="books-explore twelve-grid grid-gap-tight">
            <div class="books-explore__content grid-span-10 grid-start-2">
                <p class="books-explore__text">
                    <a href="/garden/" class="link-hover">Roam the garden</a>, <a href="/stream/" class="link-hover">dip into the stream</a>, or <a href="/nordletter/" class="link-hover">read an edition of nordletter</a>.
                </p>
            </div>
        </nav>
    </SectionLanding>
</Layout>

<style>
    .books-layout {
        display: flex;
        flex-direction: column;
        gap: clamp(2rem, 5vw, 3rem);
    }

    .books-list {
        display: flex;
        flex-direction: column;
        gap: clamp(2.5rem, 5vw, 4rem);
    }

    .books-item {
        align-items: start;
    }

    .books-item__content {
        padding-bottom: clamp(2rem, 4vw, 3rem);
        border-bottom: 1px solid rgba(148, 163, 184, 0.35);
    }

    .books-item:last-of-type .books-item__content {
        border-bottom: none;
        padding-bottom: 0;
    }

    .books-item__inner {
        align-items: start;
        gap: clamp(1rem, 2vw, 1.5rem);
    }

    .books-item__year {
        display: flex;
    }

    .books-item__year-sticky {
        position: sticky;
        top: clamp(4rem, 6vw, 5.5rem);
        display: flex;
        flex-direction: column;
    }

    .year-text {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 700;
        letter-spacing: 0.02em;
        color: #111827;
    }

    :global(.dark) .year-text {
        color: #f9fafb;
    }

    .books-item__cover {
        display: flex;
        align-items: start;
    }

    .books-item__cover-image {
        width: 100%;
        max-width: clamp(7rem, 15vw, 10rem);
        border-radius: 0.75rem;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.12);
        border: 1px solid rgba(148, 163, 184, 0.35);
    }

    :global(.dark) .books-item__cover-image {
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
    }

    .books-item__details {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .books-item__title {
        margin: 0;
        line-height: 1.3;
        font-size: clamp(1.125rem, 2.5vw, 1.25rem);
    }

    .books-item__description {
        margin: 0;
        font-size: clamp(0.95rem, 2vw, 1rem);
    }

    .books-explore {
        margin-top: clamp(1.5rem, 3vw, 2rem);
        padding-top: clamp(2rem, 4vw, 3rem);
        border-top: 1px solid rgba(148, 163, 184, 0.25);
    }

    .books-explore__content {
        display: flex;
        justify-content: center;
    }

    .books-explore__text {
        margin: 0;
        font-size: clamp(0.95rem, 2vw, 1.05rem);
        line-height: 1.6;
        color: #475569;
        text-align: center;
    }

    :global(.dark) .books-explore__text {
        color: #cbd5e1;
    }

    /* Responsive adjustments */
    @media (max-width: 47.999rem) {
        .books-item__year-sticky {
            position: static;
        }

        .books-item__inner {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .year-text {
            font-size: 1.75rem;
        }

        .books-item__cover-image {
            max-width: 6rem;
        }
    }

    @media (min-width: 48rem) {
        .books-item__year {
            grid-row: 1 / -1;
        }
    }

    @media (min-width: 64rem) {
        .year-text {
            font-size: clamp(2.25rem, 4vw, 3.5rem);
        }
    }
</style>
