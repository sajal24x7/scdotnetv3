---
import Layout from '../../layouts/Layout.astro';
import BookDetailLayout from '../../components/books/BookDetailLayout.astro';

const metadata = [
    { label: 'Pub date', value: 'October 2009' },
    { label: 'ISBN', value: '978-1-56898-784-0' },
    { label: 'Pages', value: '144' },
    {
        label: 'Amazon',
        value: 'Buy on Amazon',
        href: 'https://www.amazon.com/Year-Mornings-3191-Miles-Apart/dp/1568987841',
    },
    {
        label: 'Library',
        value: 'Find at your library',
        href: 'https://www.worldcat.org/title/318450381',
    },
];
---

<Layout
    title="A Year of Mornings"
    currentPage="/books/a-year-of-mornings/"
    enableSearchModal
    enableLinkHoverEffect
>
    <BookDetailLayout
        coverSrc="/books/01-ayom.jpg"
        coverAlt="Book cover for A Year of Mornings"
        title="A Year of Mornings"
        kicker="Poetry"
        metadata={metadata}
    >
        <p>
            A collection of fifty love poems that follows a young heart as it finds love, finds the strength to be in love and
            finally, finds the strength to let go.
        </p>
    </BookDetailLayout>
</Layout>
