---
import Layout from '../../layouts/Layout.astro';
import GardenGrid from '../../components/layout/GardenGrid.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import { getAllPosts, transformPost } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';

// Get all evergreen posts
const allPosts = await getAllPosts();
const evergreenPosts = allPosts
  .filter(post => post.data.category === 'evergreen')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the NotesGrid component
const transformedPosts = evergreenPosts.map(transformPost);
const postCount = transformedPosts.length;
const postCountText = `${postCount} ${postCount === 1 ? 'evergreen note' : 'evergreen notes'}`;

const sectionLandingProps = createSectionLandingProps(
  {
    title: 'Evergreen',
    description: 'Timeless documentation and knowledge that remains relevant over time.',
    countText: postCountText,
    tagCategory: 'evergreen',
    tagPosts: allPosts,
    contentClass: 'section-content--as-grid'
  },
  'plainCount'
);
---

<Layout
  title="Evergreen - Sajal Choudhary"
  description="Evergreen documentation and knowledge base"
  currentPage="/evergreen/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  allPosts={allPosts}
  enableSearchModal
  enableLinkHoverEffect
>
    <SectionLanding {...sectionLandingProps}>
      <GardenGrid posts={transformedPosts} contentType="evergreen" />
    </SectionLanding>
  </Layout>
