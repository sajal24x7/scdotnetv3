---
import Layout from '../../layouts/Layout.astro';
import NotesGrid from '../../components/NotesGrid.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all evergreen posts
const allPosts = await getAllPosts();
const evergreenPosts = allPosts
  .filter(post => post.data.category === 'evergreen')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the NotesGrid component
const transformedPosts = evergreenPosts.map(transformPost);
---

<Layout 
  title="Evergreen - Sajal Choudhary" 
  description="Evergreen documentation and knowledge base" 
  currentPage="/evergreen/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
    <PageHeader 
      title="Evergreen"
      description="Timeless documentation and knowledge that remains relevant over time."
      layout="centered"
      size="lg"
    />
    
    <div class="evergreen-count mb-6 text-center">
      {transformedPosts.length} {transformedPosts.length === 1 ? 'evergreen note' : 'evergreen notes'}
    </div>
    
    <div class="text-center mb-6">
      <a 
        href="/tags/?category=evergreen" 
        class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
      >
        View entries by tag
      </a>
    </div>

    <main class="evergreen-main">
      <NotesGrid posts={transformedPosts} />
    </main>
</Layout>

<style>
  .evergreen-count {
    font-size: 0.875rem;
    font-weight: 500;
    color: #8b5cf6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.dark) .evergreen-count {
    color: #a78bfa;
  }

  .evergreen-main {
    padding-bottom: 2rem;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .evergreen-main {
      padding-bottom: 1.5rem;
    }
  }
</style>