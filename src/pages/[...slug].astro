---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TimeDisplay from '../components/TimeDisplay.astro';
import type { CollectionEntry } from 'astro:content';
import { getYearDirectories } from '../utils/content';
import LinkHoverEffect from '../components/LinkHoverEffect.astro';
import ProseWrapper from '../components/layout/ProseWrapper.astro';
import Backlinks from '../components/Backlinks.astro';
import SyndicationLinks from '../components/SyndicationLinks.astro';
import Webmentions from '../components/Webmentions.astro';
import { findBacklinksComprehensive } from '../utils/backlinks';

export async function getStaticPaths() {
  // Get all year directories from content
  const years = getYearDirectories();

  // Get all posts from all collections
  const allPosts = await Promise.all(years.map(year => getCollection(year as any)));
  const posts = allPosts.flat().filter(entry => (entry as CollectionEntry<any>).data && (entry as CollectionEntry<any>).data.title);

  return posts.map((entry) => {
    const e = entry as CollectionEntry<any>;
    const category = 'category' in e.data && e.data.category ? e.data.category : 'notes';
    return {
      params: { slug: `${category}/${e.slug}` },
      props: { entry: e },
    };
  });
}

const slugParam = Astro.params.slug as string;
const [category, slug] = slugParam.split('/');
const entry = (Astro.props as { entry: CollectionEntry<any> }).entry;
const { Content } = await entry.render();

const hasUpdatedDate = 'updatedDate' in entry.data && entry.data.updatedDate;

// Find backlinks for this post
const backlinks = await findBacklinksComprehensive(slug, entry.data?.title || '');

// Get canonical URL for microformats
const canonicalUrl = `${Astro.site}/${category}/${slug}/`;

---

<Layout 
  title={`${entry.data?.title ?? ''} - ${category.charAt(0).toUpperCase() + category.slice(1)}`}
  description={entry.data?.description} 
  currentPage={`/${category}/${slug}/`}
>
  <ProseWrapper>
    <article class="h-entry">
      <!-- Hidden microformat data -->
      <a href={canonicalUrl} class="u-url" style="display: none;"></a>
      {entry.data?.bridgyOmit && (
        <a href={canonicalUrl} class="u-bridgy-omit-link" style="display: none;"></a>
      )}
      <div class="p-author h-card" style="display: none;">
        <a class="p-name u-url" href="https://sajalchoudhary.net">Sajal Choudhary</a>
        <a class="u-url" href="https://sajalchoudhary.net">https://sajalchoudhary.net</a>
      </div>
      
      <div class="mb-8">
        
        {/* Hero image for all posts */}
        {'image' in entry.data && entry.data.image && (
          <div class="mb-6">
            <img 
              src={entry.data.image} 
              alt={entry.data?.title ?? ''} 
              class="rounded-lg w-full object-cover max-h-96"
              loading="lazy"
            />
          </div>
        )}
        
        <div class="text-center">
          <h1 class="p-name text-3xl md:text-4xl font-bold mb-2">{entry.data?.title ?? ''}</h1>
          
          {category === 'nordletter' && 'edition' in entry.data && entry.data.edition && (
            <div class="flex justify-center items-center gap-4 mb-4">
              <div class="inline-block bg-gray-100 dark:bg-gray-800 px-4 py-2 rounded-lg">
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
                  Letter: {entry.data.edition}
                </span>
              </div>
              <div class="inline-block bg-gray-100 dark:bg-gray-800 px-4 py-2 rounded-lg">
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
                  Posted on <TimeDisplay date={hasUpdatedDate ? entry.data.updatedDate : entry.data.pubDate} category={category} format="detailed" />
                </span>
              </div>
            </div>
          )}
          
          {category !== 'nordletter' && (
            <p class="text-sm text-textSecondary dark:text-textSecondaryDark mb-6">
              {hasUpdatedDate ? (
                <>Last updated: <time class="dt-updated" datetime={entry.data.updatedDate.toISOString()}><TimeDisplay date={entry.data.updatedDate} category={category} format="detailed" /></time></>
              ) : (
                <>Published: <time class="dt-published" datetime={entry.data.pubDate.toISOString()}><TimeDisplay date={entry.data.pubDate} category={category} format="detailed" /></time></>
              )}
            </p>
          )}
          
          {entry.data?.description && (
            <p class="p-summary text-xl text-textSecondary dark:text-textSecondaryDark mb-8">
              {entry.data.description}
            </p>
          )}
          
          {'tags' in entry.data && Array.isArray(entry.data.tags) && entry.data.tags.length > 0 && (
            <div class="mb-8 flex justify-center">
              <div class="flex flex-wrap gap-2 justify-center">
                {entry.data.tags.map((tag: string) => (
                  <a 
                    href={`/tags/${tag.toLowerCase()}/`} 
                    class="tag"
                  >
                    {tag.toUpperCase()}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
      
      <div class="e-content">
        <Content />
      </div>
      
      <div class="mt-12 pt-8 border-t border-borderColor dark:border-borderColorDark">
        <div class="flex justify-between">
          <a href={`/${category}/`} class="text-accent hover:underline">← Back to {category.charAt(0).toUpperCase() + category.slice(1)}</a>
          
          <button 
            id="shareButton" 
            class="text-accent hover:underline flex items-center"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
            Share
          </button>
        </div>
      </div>
      
      <!-- Backlinks Section -->
      <Backlinks backlinks={backlinks} />
      
      <!-- Syndication Links Section -->
      <SyndicationLinks syndicationUrls={entry.data?.syndicationUrls || []} />
      
      <!-- Webmentions Section -->
      <Webmentions url={canonicalUrl} />
    </article>
  </ProseWrapper>
</Layout>

<LinkHoverEffect />

<script>
  // Share functionality
  const shareButton = document.getElementById('shareButton');
  
  if (shareButton) {
    shareButton.addEventListener('click', async () => {
      const title = document.title;
      const url = window.location.href;
      
      // Use Web Share API if available
      if (navigator.share) {
        try {
          await navigator.share({
            title: title,
            url: url
          });
        } catch (error) {
          console.error('Error sharing:', error);
        }
      } else {
        // Fallback to clipboard copy
        try {
          await navigator.clipboard.writeText(url);
          alert('Link copied to clipboard!');
        } catch (error) {
          console.error('Failed to copy:', error);
        }
      }
    });
  }
</script>

<style>
  .tag {
    display: inline-block;
    color: #8b5cf6;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border: 1px solid #8b5cf6;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.2s ease;
    background: transparent;
    white-space: nowrap;
  }

  .tag:hover {
    color: #7c3aed;
    border-color: #7c3aed;
    background: rgba(139, 92, 246, 0.05);
  }

  :global(.dark) .tag {
    color: #a78bfa;
    border-color: #a78bfa;
  }

  :global(.dark) .tag:hover {
    color: #c4b5fd;
    border-color: #c4b5fd;
    background: rgba(167, 139, 250, 0.1);
  }

  /* Backlinks styling */
  .backlink-container {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(var(--color-border));
  }

  .backlink-container h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: rgb(var(--color-text-primary));
  }

  .backlink-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .backlink-container .backlink-item {
    border: 1px solid #e5e7eb;
    background-color: #ffffff;
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    transition: box-shadow 0.2s, border-color 0.2s, background-color 0.2s;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    cursor: pointer;
  }

  .backlink-container .backlink-item:hover {
    border-color: #a78bfa;
    box-shadow: 0 4px 16px 0 rgba(136, 58, 234, 0.08);
    background-color: #fafaff;
  }

  :global(.dark) .backlink-container .backlink-item {
    background-color: #18181b;
    border-color: #27272a;
  }

  :global(.dark) .backlink-container .backlink-item:hover {
    border-color: #a78bfa;
    background-color: #232336;
  }

  .backlink-container .backlink-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .backlink-container .backlink-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .backlink-container .backlink-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: nowrap;
  }

  .backlink-container .backlink-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: #111827;
    line-height: 1.4;
    transition: color 0.2s ease;
    flex: 1;
    min-width: 0;
  }

  .backlink-container .backlink-item:hover .backlink-title {
    color: #3b82f6;
  }

  :global(.dark) .backlink-container .backlink-title {
    color: #f9fafb;
  }

  :global(.dark) .backlink-container .backlink-item:hover .backlink-title {
    color: #60a5fa;
  }

  .backlink-container .backlink-description {
    font-size: 0.875rem;
    color: #4b5563;
    line-height: 1.5;
    margin: 0;
  }

  :global(.dark) .backlink-container .backlink-description {
    color: #d1d5db;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .backlink-container .backlink-item {
      padding: 0.875rem 1rem;
    }

    .backlink-container .backlink-header {
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .backlink-container .backlink-title {
      font-size: 0.875rem;
      flex: 1;
      min-width: 200px;
    }
  }

</style> 