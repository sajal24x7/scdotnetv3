---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import type { CollectionEntry } from 'astro:content';
import { getContentCategories } from '../utils/content';
import { CONTENT_CATEGORIES } from '../content.config';
import { findBacklinksComprehensive } from '../utils/backlinks';
import { getInteractionsForPost } from '../utils/interactions';
import PostLayout from '../components/layout/PostLayout.astro';
import PhotoPostLayout from '../components/layout/PhotoPostLayout.astro';

type AnyEntry = CollectionEntry<(typeof CONTENT_CATEGORIES)[number]>;

export async function getStaticPaths() {
  // Get all category collections
  const categories = getContentCategories();
  const allPosts = await Promise.all(
    categories.map(async (category) => (await getCollection(category as any)) as AnyEntry[])
  );
  // Titles are optional (micro posts from /write often have none), so only
  // require frontmatter to exist — filtering on title made titleless posts 404.
  const posts = allPosts.flat().filter((entry) => entry.data);

  return posts.map((e) => {
    const category = 'category' in e.data && e.data.category ? e.data.category : 'notes';
    return {
      params: { slug: `${category}/${e.id}` },
      props: { entry: e },
    };
  });
}

const slugParam = Astro.params.slug as string;
const [category, slug] = slugParam.split('/');
const entry = (Astro.props as { entry: AnyEntry }).entry;
const { Content } = await render(entry);

const hasUpdatedDate = Boolean('updated' in entry.data && entry.data.updated);

// Find backlinks for this post
const backlinks = await findBacklinksComprehensive(`${category}/${slug}`);

// Responses collected from syndicated copies (Mastodon, Bluesky, …)
const interactions = await getInteractionsForPost(`${category}/${slug}`);

// Get canonical URL for microformats
const canonicalUrl = new URL(`${category}/${slug}/`, Astro.site).href;

const categoryLabel = category.charAt(0).toUpperCase() + category.slice(1);
const pageTitle = entry.data?.title ? `${entry.data.title} - ${categoryLabel}` : categoryLabel;

// Photo posts get their own Instagram-style layout, and go full-width (no
// grid-start-3/span-8 constraint) so the image/text row lines up with the
// site header instead of the narrower reading column other posts use.
const isPhotoPost = category === 'photo';

const ogImagePath = 'image' in entry.data && entry.data.image ? entry.data.image : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data?.title || categoryLabel,
  ...(entry.data?.created ? { datePublished: new Date(entry.data.created).toISOString() } : {}),
  ...(hasUpdatedDate ? { dateModified: new Date(entry.data.updated).toISOString() } : {}),
  author: { '@type': 'Person', name: 'Sajal Choudhary', url: 'https://sajalchoudhary.net' },
  image: new URL(ogImagePath ?? '/logo/logo-square-v2.svg', Astro.site).href,
  url: canonicalUrl,
};

---

<Layout
  title={pageTitle}
  description={entry.data?.description}
  currentPage={`/${category}/${slug}/`}
  ogType="article"
  ogImage={ogImagePath}
  publishedTime={entry.data?.created}
  enableLinkHoverEffect
  pageWrapper={
    isPhotoPost
      ? { grid: { padding: 'narrow' } }
      : { className: 'grid-span-8 grid-start-3', grid: { padding: 'narrow' } }
  }
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(jsonLd)} />
  {isPhotoPost ? (
    <PhotoPostLayout
      entry={entry}
      canonicalUrl={canonicalUrl}
      backlinks={backlinks}
      interactions={interactions}
      hasUpdatedDate={hasUpdatedDate}
    >
      <Content />
    </PhotoPostLayout>
  ) : (
    <PostLayout
      entry={entry}
      category={category}
      canonicalUrl={canonicalUrl}
      backlinks={backlinks}
      interactions={interactions}
      hasUpdatedDate={hasUpdatedDate}
    >
      <Content />
    </PostLayout>
  )}
</Layout>
