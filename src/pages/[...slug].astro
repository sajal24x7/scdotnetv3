---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { format } from 'date-fns';
import type { CollectionEntry } from 'astro:content';
import { getYearDirectories } from '../utils/content';
import { formatDateWithTime } from '../utils/dateFormat';
import { formatDate, formatDateOnly } from '../utils/date';

export async function getStaticPaths() {
  // Get all year directories from content
  const years = getYearDirectories();

  // Get all posts from all collections
  const allPosts = await Promise.all(years.map(year => getCollection(year as any)));
  const posts = allPosts.flat().filter(entry => entry.data);

  return posts.map((entry) => {
    const category = 'category' in entry.data && entry.data.category ? entry.data.category : 'notes';
    return {
      params: { slug: `${category}/${entry.slug}` },
      props: { entry },
    };
  });
}

const [category, slug] = Astro.params.slug.split('/');
const { entry } = Astro.props;
const { Content } = await entry.render();

// Cast entry to any to access extended properties
const entryData = (entry as any).data;

const formattedDate = entry.data?.pubDate ? formatDateWithTime(entry.data.pubDate) : '';
const updatedDate = 'updatedDate' in entry.data && entry.data.updatedDate
  ? formatDateWithTime(entry.data.updatedDate)
  : null;

// Construct the current post URL
const currentPostUrl = `/${category}/${entry.slug}/`;

// Generate a fallback title for posts without titles (like micro posts)
const pageTitle = entry.data?.title 
  ? `${entry.data.title} - ${category.charAt(0).toUpperCase() + category.slice(1)}`
  : `${category.charAt(0).toUpperCase() + category.slice(1)} - ${formattedDate}`;

// Helper functions for bookshelf posts
const formatReadingPeriod = (startDate: Date | undefined, endDate: Date | undefined) => {
  if (!startDate && !endDate) return null;
  if (startDate && endDate) {
    const start = formatDate(startDate);
    const end = formatDate(endDate);
    return `${start} - ${end}`;
  }
  if (startDate) return `Started ${formatDate(startDate)}`;
  if (endDate) return `Finished ${formatDate(endDate)}`;
  return null;
};

const formatBookFormat = (format: string | undefined) => {
  if (!format) return null;
  return format.charAt(0).toUpperCase() + format.slice(1);
};
---

<Layout 
  title={pageTitle}
  description={entry.data?.description} 
  currentPage={currentPostUrl}
>
  <article class="prose dark:prose-dark mx-auto">
    <div class="mb-8">
      {'image' in entry.data && entry.data.image && (
        <div class="mb-6">
          <img 
            src={entry.data.image} 
            alt={entry.data?.title ?? ''} 
            class="rounded-lg w-full object-cover max-h-96"
            loading="lazy"
          />
        </div>
      )}
      
      {entry.data?.title && (
        <h1 class="text-3xl md:text-4xl font-bold mb-4">{entry.data.title}</h1>
      )}
      
      {entry.data?.description && (
        <p class="text-xl text-textSecondary dark:text-textSecondaryDark mb-8">
          {entry.data.description}
        </p>
      )}
      
            {/* Bookshelf metadata box */}
      {category === 'bookshelf' && (
        <div class="mb-8 p-4 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm text-textSecondary dark:text-textSecondaryDark">
            {/* Format */}
            {entryData.format && (
              <span class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
                {formatBookFormat(entryData.format)}
              </span>
            )}
            
            {/* Started date */}
            {entryData.startDate && (
              <span class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                Started: {formatDateOnly(entryData.startDate)}
              </span>
            )}
            
            {/* Finished date */}
            {entryData.endDate && (
              <span class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                Finished: {formatDateOnly(entryData.endDate)}
              </span>
            )}
          </div>
        </div>
      )}
      
      {'tags' in entry.data && Array.isArray(entry.data.tags) && entry.data.tags.length > 0 && (
        <div class="mb-8">
          <div class="flex flex-wrap gap-2">
            {entry.data.tags.map((tag: string) => (
              <a 
                href={`/tags/${tag}/`} 
                class="text-xs bg-borderColor dark:bg-borderColorDark px-2 py-1 rounded-md hover:bg-accent hover:text-white transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
    
    <div>
      <Content />
    </div>
    
    <div class="mt-12 pt-8 border-t border-borderColor dark:border-borderColorDark">
      <div class="flex justify-between">
        <a href={`/${category}/`} class="text-accent hover:underline">← Back to {category.charAt(0).toUpperCase() + category.slice(1)}</a>
        
        <button 
          id="shareButton" 
          class="text-accent hover:underline flex items-center"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
          </svg>
          Share
        </button>
      </div>
    </div>
  </article>
</Layout>

<script>
  // Share functionality
  const shareButton = document.getElementById('shareButton');
  
  if (shareButton) {
    shareButton.addEventListener('click', async () => {
      const title = document.title;
      const url = window.location.href;
      
      // Use Web Share API if available
      if (navigator.share) {
        try {
          await navigator.share({
            title: title,
            url: url
          });
        } catch (error) {
          console.error('Error sharing:', error);
        }
      } else {
        // Fallback to clipboard copy
        try {
          await navigator.clipboard.writeText(url);
          alert('Link copied to clipboard!');
        } catch (error) {
          console.error('Failed to copy:', error);
        }
      }
    });
  }
</script> 