---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import type { CollectionEntry } from 'astro:content';
import { getAllPosts, getAdjacentPosts, getContentCategories, getPostLayout } from '../utils/content';
import { CONTENT_CATEGORIES } from '../content.config';
import { findBacklinksComprehensive } from '../utils/backlinks';
import { getInteractionsForPost } from '../utils/interactions';
import GardenPostLayout from '../components/layout/post/GardenPostLayout.astro';
import StreamPostLayout from '../components/layout/post/StreamPostLayout.astro';
import ShelfPostLayout from '../components/layout/post/ShelfPostLayout.astro';
import ProsePostLayout from '../components/layout/post/ProsePostLayout.astro';
import PhotoPostLayout from '../components/layout/post/PhotoPostLayout.astro';

type AnyEntry = CollectionEntry<(typeof CONTENT_CATEGORIES)[number]>;

export async function getStaticPaths() {
  // Get all category collections
  const categories = getContentCategories();
  const allPosts = await Promise.all(
    categories.map(async (category) => (await getCollection(category as any)) as AnyEntry[])
  );
  // Titles are optional (micro posts from /write often have none), so only
  // require frontmatter to exist — filtering on title made titleless posts 404.
  const posts = allPosts.flat().filter((entry) => entry.data);

  return posts.map((e) => {
    const category = 'category' in e.data && e.data.category ? e.data.category : 'notes';
    return {
      params: { slug: `${category}/${e.id}` },
      props: { entry: e },
    };
  });
}

const slugParam = Astro.params.slug as string;
const [category, slug] = slugParam.split('/');
const entry = (Astro.props as { entry: AnyEntry }).entry;
const { Content } = await render(entry);

const hasUpdatedDate = Boolean('updated' in entry.data && entry.data.updated);

// Find backlinks for this post
const backlinks = await findBacklinksComprehensive(`${category}/${slug}`);

// Responses collected from syndicated copies (Mastodon, Bluesky, …)
const interactions = await getInteractionsForPost(`${category}/${slug}`);

// Get canonical URL for microformats
const canonicalUrl = new URL(`${category}/${slug}/`, Astro.site).href;

const categoryLabel = category.charAt(0).toUpperCase() + category.slice(1);
const pageTitle = entry.data?.title ? `${entry.data.title} - ${categoryLabel}` : categoryLabel;

// Each category maps to a detail layout in src/utils/content.ts; the component
// table below is the only place that mapping becomes markup.
const layoutName = getPostLayout(category);
const PostLayoutComponent = {
  garden: GardenPostLayout,
  stream: StreamPostLayout,
  shelf: ShelfPostLayout,
  prose: ProsePostLayout,
  photo: PhotoPostLayout
}[layoutName];

// Column width per layout: photo posts go full-width so the image/text row
// lines up with the site header, creative writing sits in a narrower column
// than an essay does, and everything else uses the standard reading column.
const pageWrapper =
  layoutName === 'photo'
    ? { grid: { padding: 'narrow' as const } }
    : layoutName === 'prose'
      ? { className: 'grid-span-6 grid-start-4', grid: { padding: 'narrow' as const } }
      : { className: 'grid-span-8 grid-start-3', grid: { padding: 'narrow' as const } };

// Stories and poems link to their neighbours so a reader can walk the
// collection in the order it was written.
const siblings =
  layoutName === 'prose'
    ? getAdjacentPosts(await getAllPosts(), category, entry.id)
    : undefined;

const ogImagePath = 'image' in entry.data && entry.data.image ? entry.data.image : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data?.title || categoryLabel,
  ...(entry.data?.created ? { datePublished: new Date(entry.data.created).toISOString() } : {}),
  ...(hasUpdatedDate ? { dateModified: new Date(entry.data.updated).toISOString() } : {}),
  author: { '@type': 'Person', name: 'Sajal Choudhary', url: 'https://sajalchoudhary.net' },
  image: new URL(ogImagePath ?? '/logo/logo-square-v2.svg', Astro.site).href,
  url: canonicalUrl,
};

---

<Layout
  title={pageTitle}
  description={entry.data?.description}
  currentPage={`/${category}/${slug}/`}
  ogType="article"
  ogImage={ogImagePath}
  publishedTime={entry.data?.created}
  enableLinkHoverEffect
  pageWrapper={pageWrapper}
>
  {/* escape "<" so no field value can close the script tag early */}
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  <PostLayoutComponent
    entry={entry}
    category={category}
    canonicalUrl={canonicalUrl}
    backlinks={backlinks}
    interactions={interactions}
    hasUpdatedDate={hasUpdatedDate}
    siblings={siblings}
  >
    <Content />
  </PostLayoutComponent>
</Layout>
