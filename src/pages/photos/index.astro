---
import Layout from '../../layouts/Layout.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import { getAllPosts, getPostsByCategory, transformPost } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';

// Get all photo posts
const allPosts = await getAllPosts();
const photoPosts = getPostsByCategory(allPosts, 'photo');

// Transform posts for the PhotoGrid component
const transformedPosts = photoPosts.map(transformPost);
const postCount = transformedPosts.length;
const postCountText = `${postCount} ${postCount === 1 ? 'photo post' : 'photo posts'}`;

const sectionLandingProps = createSectionLandingProps(
  {
    title: 'Photos',
    description: 'Photo posts and visual content from my photography and travels.',
    countText: postCountText,
    tagCategory: 'photo',
    tagPosts: allPosts,
    gridMaxWidth: '100%',
    rssUrl: '/photo/rss.xml'
  },
  'plainCount'
);
---

<Layout
  title="Photos"
  description="Photo posts and visual content"
  currentPage="/photos/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
    <SectionLanding {...sectionLandingProps}>
      <PhotoGrid posts={transformedPosts} />
    </SectionLanding>
  </Layout>
