---
import Layout from '../../layouts/Layout.astro';
import StreamLayout from '../../components/layout/StreamLayout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all photo posts
const allPosts = await getAllPosts();
const photoPosts = allPosts
  .filter(post => post.data.category === 'photo')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the StreamLayout component
const transformedPosts = photoPosts.map(transformPost);
---

<Layout
  title="Photos - Sajal Choudhary"
  description="Photo posts and visual content"
  currentPage="/photos/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
  allPosts={allPosts}
>
    <SectionLanding
      title="Photos"
      description="Photo posts and visual content from my photography and travels."
      layout="centered"
      size="lg"
      maxWidth="7xl"
      />
    
    <div class="photos-count mb-6 text-center">
      {transformedPosts.length} {transformedPosts.length === 1 ? 'photo post' : 'photo posts'}
    </div>

    <!-- TagList for mobile and desktop -->
    <div class="photos-taglist">
      <TagList category="photo" title="Tagged with:" posts={allPosts} />
    </div>
    
    <main class="photos-main">
      <StreamLayout posts={transformedPosts} />
    </SectionLanding>
</Layout>
