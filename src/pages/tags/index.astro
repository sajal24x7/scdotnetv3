---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import { getAllPosts } from '../../utils/content';

// Get all posts
const allPosts = await getAllPosts();

// Get all unique tags and their counts
const tagCounts = new Map<string, number>();
allPosts.forEach(post => {
  post.data.tags?.forEach(tag => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

// Convert to array and sort by count (descending)
const sortedTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1]);

const topTwentyTags = sortedTags.slice(0, 20);
const allTags = Array.from(tagCounts.entries())
  .sort((a, b) => a[0].localeCompare(b[0]));

// Group tags by category for client-side filtering
const tagsByCategory = new Map<string, Array<[string, number]>>();

// Initialize categories
tagsByCategory.set('all', sortedTags);

// Process each category
const categories = ['blog', 'bookshelf', 'stream', 'garden', 'nordletter', 'til', 'micro', 'story', 'poem'];

categories.forEach(category => {
  const categoryPosts = allPosts.filter(post => {
      if (category === 'stream') {
    return ['blog', 'micro', 'photo'].includes(post.data.category);
  }
    return post.data.category === category;
  });
  
  const categoryTagCounts = new Map<string, number>();
  categoryPosts.forEach(post => {
    post.data.tags?.forEach(tag => {
      categoryTagCounts.set(tag, (categoryTagCounts.get(tag) || 0) + 1);
    });
  });
  
  const categoryTags = Array.from(categoryTagCounts.entries())
    .sort((a, b) => b[1] - a[1]);
  
  tagsByCategory.set(category, categoryTags);
});
---

<Layout
  title="Tags - Sajal Choudhary"
  description="All tags used in the content"
  currentPage="/tags/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'md',
    centered: true,
    className: 'px-4'
  }}
  allPosts={allPosts}
  enableSearchModal
  enableLinkHoverEffect
>
  <PageHeader 
    title="Tags"
    description="A collection of all tags used across my blog, photos, and micro updates."
    layout="centered"
    size="lg"
    maxWidth="7xl"
  />

  <section class="space-y-12">
    {sortedTags.length === 0 ? (
      <div class="text-center py-12 border border-borderColor dark:border-borderColorDark rounded-lg">
        <p class="text-textSecondary dark:text-textSecondaryDark">
          No tags found.
        </p>
      </div>
    ) : (
      <>
        {/* Top Twenty Tags */}
        {topTwentyTags.length > 0 && (
          <div>
            <h2 class="text-2xl font-bold mb-8">Top Twenty Tags</h2>
            <div class="grid grid-cols-2 gap-4">
              {topTwentyTags.map(([tag, count]) => (
                <a href={`/tags/${tag}/`} class="text-sm font-medium hover:text-accent transition-colors">
                  {tag.toUpperCase()} ({count})
                </a>
              ))}
            </div>
          </div>
        )}

        {/* All Tags */}
        <div class="mt-48">
          <h2 class="text-2xl font-bold mb-8">All Tags</h2>
          <div class="grid grid-cols-2 gap-4">
            {allTags.map(([tag, count]) => (
              <a href={`/tags/${tag}/`} class="text-sm font-medium hover:text-accent transition-colors">
                {tag.toUpperCase()} ({count})
              </a>
            ))}
          </div>
        </div>
      </>
    )}
  </section>

  <script define:vars={{ tagsByCategory: Object.fromEntries(tagsByCategory) }}>
    // Handle category filtering based on URL parameters
    document.addEventListener('DOMContentLoaded', function() {
      const urlParams = new URLSearchParams(window.location.search);
      const category = urlParams.get('category');
      
      if (category && tagsByCategory[category]) {
        // Update page title and description
      const title = document.querySelector('h1');
      const description = document.querySelector('header p');
      
      if (category === 'stream') {
        title.textContent = 'Stream Tags';
        description.textContent = 'Tags used in blog posts, photos, and micro updates';
      } else {
        const categoryName = category.charAt(0).toUpperCase() + category.slice(1);
        title.textContent = `${categoryName} Tags`;
        description.textContent = `Tags used in ${category} content`;
      }
      
      // Add back link
      const backLink = document.createElement('div');
      backLink.className = 'mb-4';
      backLink.innerHTML = `
        <a href="/tags/" class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200">
           View all tags
        </a>
      `;
      title.parentNode.insertBefore(backLink, title.nextSibling);
      
      // Update tag links to include category parameter
      const tagLinks = document.querySelectorAll('a[href^="/tags/"]');
      tagLinks.forEach(link => {
        const href = link.getAttribute('href');
        if (href && href !== '/tags/') {
          link.setAttribute('href', href + `?category=${category}`);
        }
      });
      
      // Filter and display only category-specific tags
      const categoryTags = tagsByCategory[category];
      
      if (categoryTags && categoryTags.length > 0) {
        const topTwenty = categoryTags.slice(0, 20);
        const allCategoryTags = categoryTags.sort((a, b) => a[0].localeCompare(b[0]));
        
        // Update top twenty tags
        const topTwentyContainer = document.querySelector('.grid.grid-cols-2.gap-4');
        if (topTwentyContainer && topTwenty.length > 0) {
          topTwentyContainer.innerHTML = topTwenty.map(([tag, count]) => 
            `<a href="/tags/${tag}/?category=${category}" class="text-sm font-medium hover:text-accent transition-colors">
              ${tag.toUpperCase()} (${count})
            </a>`
          ).join('');
        }
        
        // Update all tags
        const allTagsContainer = document.querySelectorAll('.grid.grid-cols-2.gap-4')[1];
        if (allTagsContainer) {
          allTagsContainer.innerHTML = allCategoryTags.map(([tag, count]) => 
            `<a href="/tags/${tag}/?category=${category}" class="text-sm font-medium hover:text-accent transition-colors">
              ${tag.toUpperCase()} (${count})
            </a>`
          ).join('');
        }
      } else {
        // Show no tags message
        const section = document.querySelector('section');
        section.innerHTML = `
          <div class="text-center py-12 border border-borderColor dark:border-borderColorDark rounded-lg">
            <p class="text-textSecondary dark:text-textSecondaryDark">
              No tags found in ${category}.
            </p>
          </div>
        `;
        }
      }
      // If no category parameter, leave the page as is with default "Tags" title
    });
  </script>
</Layout> 