---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import RecentItems from '../../components/RecentItems.astro';
import { getAllPosts, transformPost } from '../../utils/content';

export async function getStaticPaths() {
  // Get all posts
  const allPosts = await getAllPosts();
  
  // Get all unique tags
  const tags = new Set<string>();
  allPosts.forEach(post => {
    post.data.tags?.forEach((tag: string) => tags.add(tag));
  });

  // Create paths for each tag
  return Array.from(tags).map(tag => ({
    params: { tag },
    props: { tag }
  }));
}

const { tag } = Astro.props;

// Get all posts
const allPosts = await getAllPosts();

// Filter posts by tag
const taggedPosts = allPosts.filter(post => {
  return post.data.tags?.includes(tag);
});

// Sort by publish date (newest first)
const sortedPosts = taggedPosts.sort((a, b) => 
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Transform posts for the RecentItems component
const transformedPosts = sortedPosts.map(transformPost);

// Group posts by category for client-side filtering
const postsByCategory = new Map<string, typeof sortedPosts>();

// Initialize with all posts
postsByCategory.set('all', sortedPosts);

// Process each category
const categories = ['blog', 'bookshelf', 'stream', 'garden', 'nordletter', 'til', 'micro', 'story', 'poem'];

categories.forEach(category => {
  const categoryPosts = sortedPosts.filter(post => {
      if (category === 'stream') {
    return ['blog', 'micro', 'photo'].includes(post.data.category);
  }
    return post.data.category === category;
  });
  
  postsByCategory.set(category, categoryPosts);
});
---

<Layout 
  title={`Posts tagged "${tag}" - Sajal Choudhary`} 
  description={`All posts tagged with "${tag}"`}
  currentPage={`/tags/${tag}/`}
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'md',
    centered: true,
    className: 'px-4'
  }}
>
  <header class="text-center mb-10">
    <h1 class="text-huge font-bold text-textPrimary">
      <span class="tag-display">{tag.toUpperCase()}</span>
    </h1>
    <p class="text-large text-gray-600 dark:text-gray-400 mt-4 mx-auto max-w-7xl">
      Things from the garden and the stream related to {tag}
    </p>
  </header>
  

    <section class="space-y-12">
      {transformedPosts.length === 0 ? (
        <div class="text-center py-12 border border-borderColor dark:border-borderColorDark rounded-lg">
          <p class="text-textSecondary dark:text-textSecondaryDark">
            No content found with this tag.
          </p>
        </div>
      ) : (
        <RecentItems posts={transformedPosts} showTitle={false} />
      )}
    </section>
  </div>

  <script define:vars={{ postsByCategory: Object.fromEntries(postsByCategory), tag }}>
    // Handle category filtering based on URL parameters
    document.addEventListener('DOMContentLoaded', function() {
      const urlParams = new URLSearchParams(window.location.search);
      const category = urlParams.get('category');
      
      if (category && postsByCategory[category]) {
        // Update page title and description
        const title = document.querySelector('h1');
        const description = document.querySelector('header p');
        
        if (category === 'stream') {
          title.innerHTML = `<span class="tag-display">${tag.toUpperCase()}</span>`;
          description.textContent = `Things from the garden and the stream related to ${tag}`;
        } else {
          const categoryName = category.charAt(0).toUpperCase() + category.slice(1);
          title.innerHTML = `<span class="tag-display">${tag.toUpperCase()}</span>`;
          description.textContent = `Things from the garden and the stream related to ${tag}`;
        }
        
        // Filter and display only category-specific posts
        const categoryPosts = postsByCategory[category];
        
        // Update post count
        const postCount = document.querySelector('header p');
        postCount.textContent = `${categoryPosts.length} ${categoryPosts.length === 1 ? 'item' : 'items'} tagged with #${tag} in ${category === 'ephemera' ? 'ephemera' : category}`;
        
        // Update posts display
        const section = document.querySelector('section');
        
        if (categoryPosts.length === 0) {
          section.innerHTML = `
            <div class="text-center py-12 border border-borderColor dark:border-borderColorDark rounded-lg">
              <p class="text-textSecondary dark:text-textSecondaryDark">
                No content found with this tag in ${category}.
              </p>
            </div>
          `;
        } else {
          // For now, we'll show a simple list since we can't easily transform posts in the browser
          // In a real implementation, you might want to pre-render all category views
          const postsHtml = categoryPosts.map(post => `
            <article class="post-item">
              <div class="post-item-desktop">
                <div class="post-item-metadata">
                  <a href="/${post.data.category}/${post.slug}/" class="stream-date-link">
                    <time class="stream-date">
                      ${new Date(post.data.pubDate).toLocaleDateString('en-US', { 
                        year: 'numeric', 
                        month: 'long', 
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                      })}
                    </time>
                  </a>
                  <span class="stream-category">${post.data.category}</span>
                  ${post.data.tags ? post.data.tags.map(tag => 
                    `<a href="/tags/${tag.toLowerCase()}/" class="tag">${tag.toUpperCase()}</a>`
                  ).join('') : ''}
                </div>
                <div class="post-item-content">
                  <h2 class="stream-title">
                    <a href="/${post.data.category}/${post.slug}/" class="stream-title-link">
                      ${post.data.title}
                    </a>
                  </h2>
                  ${post.data.description ? `<p class="stream-description">${post.data.description}</p>` : ''}
                </div>
              </div>
            </article>
          `).join('');
          
          section.innerHTML = `<div class="recent-items"><div class="recent-items-list">${postsHtml}</div></div>`;
        }
      }
    });
  </script>

  <style>
    .tag-display {
      display: inline-block;
      color: #8b5cf6;
      padding: 0.5rem 1rem;
      border: 1px solid #8b5cf6;
      border-radius: 0.375rem;
      font-size: 1rem;
      font-weight: 600;
      background: transparent;
      white-space: nowrap;
      letter-spacing: 0.05em;
    }

    :global(.dark) .tag-display {
      color: #a78bfa;
      border-color: #a78bfa;
    }
  </style>
</Layout> 