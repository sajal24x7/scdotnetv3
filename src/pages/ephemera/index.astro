---
import Layout from '../../layouts/Layout.astro';
import ContentGrid from '../../components/ContentGrid.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for ephemera (including TILs)
const allPosts = await getAllPosts();
const ephemera = allPosts
  .filter(post => ['blog', 'micro', 'photo', 'til'].includes(post.data.category))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = ephemera.map(post => ({
  data: {
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    category: post.data.category,
    image: post.data.image,
    link: `/${post.data.category}/${post.slug}/`
  },
  body: post.body,
  render: post.render
}));
---

<Layout 
  title="Ephemera" 
  description="Blog posts, photos, and micro updates" 
  currentPage="/ephemera/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
    <PageHeader 
      title="Ephemera"
      description="Blog posts, photos, and micro updates from my daily life."
      layout="centered"
      size="lg"
    />
    
    <div class="ephemera-count mb-6 text-center">
      {transformedPosts.length} {transformedPosts.length === 1 ? 'post' : 'posts'}
    </div>
    
    <div class="text-center mb-6">
      <a 
        href="/tags/?category=ephemera" 
        class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
      >
        View entries by tag
      </a>
    </div>

    <main class="ephemera-main">
      <ContentGrid posts={transformedPosts} />
    </main>
</Layout>

<style>
  .ephemera-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .ephemera-count {
    font-size: 0.875rem;
    font-weight: 500;
    color: #8b5cf6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.dark) .ephemera-count {
    color: #a78bfa;
  }

  .ephemera-main {
    padding-bottom: 2rem;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .ephemera-container {
      max-width: none;
      padding: 0;
    }

    .ephemera-main {
      padding-bottom: 1.5rem;
    }
  }
</style> 