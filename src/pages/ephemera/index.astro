---
import Layout from '../../layouts/Layout.astro';
import ContentGrid from '../../components/ContentGrid.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for ephemera
const allPosts = await getAllPosts();
const ephemera = allPosts
  .filter(post => ['blog', 'micro', 'photo', 'til'].includes(post.data.category))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = ephemera.map(post => ({
  data: {
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    category: post.data.category,
    image: post.data.image,
    link: `/${post.data.category}/${post.slug}/`
  },
  body: post.body,
  render: post.render
}));
---

<Layout 
  title="Ephemera" 
  description="Blog posts, photos, and micro updates" 
  currentPage="/ephemera/"
>
  <div class="max-w-7xl mx-auto">
    <header class="mb-12 px-6">
      <div class="flex flex-col">
        <h1 class="text-4xl font-bold mb-4">Ephemera</h1>
        <p class="text-xl text-textSecondary dark:text-textSecondaryDark mb-4">
          Blog posts, photos, and micro updates from my daily life.
        </p>
        <a 
          href="/ephemera/tags" 
          class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
        >
          View entries by tag
        </a>
      </div>
    </header>

    <div class="px-6">
      <ContentGrid posts={transformedPosts} />
    </div>
  </div>
</Layout>

<script>
  // JavaScript to handle the show all tags functionality
  document.addEventListener('DOMContentLoaded', () => {
    const showAllTagsBtn = document.getElementById('show-all-tags-btn');
    const additionalTags = document.getElementById('additional-tags');
    
    if (showAllTagsBtn && additionalTags) {
      const totalTags = showAllTagsBtn.getAttribute('data-total-tags');
      
      showAllTagsBtn.addEventListener('click', () => {
        // Toggle the visibility of additional tags
        if (additionalTags.classList.contains('hidden')) {
          // Show all tags
          additionalTags.classList.remove('hidden');
          additionalTags.classList.add('inline');
          showAllTagsBtn.textContent = 'Hide additional tags';
        } else {
          // Hide additional tags
          additionalTags.classList.add('hidden');
          additionalTags.classList.remove('inline');
          showAllTagsBtn.textContent = `Show all tags (${totalTags})`;
        }
      });
    }
  });
</script> 