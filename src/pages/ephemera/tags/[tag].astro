---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ContentGrid from '../../../components/ContentGrid.astro';
import { getYearDirectories } from '../../../utils/content';

export async function getStaticPaths() {
  const years = getYearDirectories();
  const allPosts = await Promise.all(years.map(year => getCollection(year)));
  const ephemeraPosts = allPosts
    .flat()
    .filter((post): post is CollectionEntry<any> => ['blog', 'micro', 'photo', 'til'].includes(post.data.category));

  // Get all unique tags
  const tags = new Set<string>();
  ephemeraPosts.forEach(post => {
    if (post.data.tags) {
      post.data.tags.forEach(tag => tags.add(tag));
    }
  });

  return Array.from(tags).map(tag => ({
    params: { tag },
    props: { tag }
  }));
}

const { tag } = Astro.props;

// Get all posts from year collections - redefine years for runtime
const years = getYearDirectories();
const allPosts = await Promise.all(years.map(year => getCollection(year)));
const taggedPosts = allPosts
  .flat()
  .filter((post): post is CollectionEntry<any> => 
    ['blog', 'micro', 'photo', 'til'].includes(post.data.category) && 
    post.data.tags && 
    post.data.tags.includes(tag)
  )
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = taggedPosts.map(post => ({
  data: {
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    category: post.data.category,
    image: post.data.image,
    link: `/${post.data.category}/${post.slug}/`
  },
  body: post.body
}));
---

<Layout 
  title={`Ephemera tagged with "${tag}"`}
  description={`Browse ephemera tagged with "${tag}"`}
  currentPage="/ephemera/"
>
  <div class="max-w-7xl mx-auto">
    <header class="mb-12 px-6">
      <div class="flex flex-col">
        <h1 class="text-4xl font-bold mb-4">Ephemera tagged with "{tag}"</h1>
        <a 
          href="/ephemera/tags" 
          class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
        >
          ← Back to all tags
        </a>
      </div>
    </header>

    <div class="px-6">
      <ContentGrid posts={transformedPosts} />
    </div>
  </div>
</Layout> 