---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import TagPage from '../../../components/TagPage.astro';

const years = ['2012', '2013', '2014', '2015', '2016', '2017', '2019', '2021', '2022', '2024', '2025'];

// Get all posts from year collections
const allPosts = await Promise.all(years.map(year => getCollection(year)));
const ephemera = allPosts
  .flat()
  .filter(post => ['blog', 'micro', 'photo'].includes(post.data.category));

// Count tags
const tags = ephemera.reduce((acc, post) => {
  if (post.data.tags) {
    post.data.tags.forEach(tag => {
      acc[tag] = (acc[tag] || 0) + 1;
    });
  }
  return acc;
}, {});
---

<Layout 
  title="Ephemera Tags" 
  description="Browse ephemera entries by tag" 
  currentPage="/ephemera/"
>
  <TagPage 
    title="Ephemera Tags" 
    description="Browse blog posts, photos, and micro updates by tag"
    tags={tags}
    currentPage="/ephemera"
  />
</Layout> 