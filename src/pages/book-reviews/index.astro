---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Get all notes with the book-reviews tag
const notes = await getCollection('notes', (note) => 
  note.data.tags?.includes('book-reviews')
);

// Sort notes by updated date or publication date (newest first)
const sortedNotes = notes.sort((a, b) => {
  const aDate = a.data.updatedDate || a.data.pubDate;
  const bDate = b.data.updatedDate || b.data.pubDate;
  return bDate.valueOf() - aDate.valueOf();
});

// Create a map of tags and their counts
const tagCounts = new Map();
sortedNotes.forEach(note => {
  note.data.tags?.forEach(tag => {
    if (tag !== 'book-reviews') { // Exclude the book-reviews tag itself
      tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
    }
  });
});

// Convert to array and sort by count (descending)
const tags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .map(([tag]) => tag);

const topTags = tags.slice(0, 20); // Only display top 20 tags initially
---

<Layout 
  title="Book Reviews - Sajal Choudhary" 
  description="A collection of book reviews and reading notes"
  currentPage="/book-reviews/"
>
  <div class="max-w-2xl mx-auto px-4">
    <header class="mb-16">
      <h1 class="text-4xl font-bold mb-4">Book Reviews</h1>
      <p class="text-xl text-textSecondary dark:text-textSecondaryDark">
        A collection of book reviews, reading notes, and literary thoughts.
      </p>
    </header>

    {tags.length > 0 && (
      <div class="mb-10">
        <h2 class="text-lg font-semibold mb-2">Browse by topic</h2>
        <div class="flex flex-wrap gap-2">
          {/* Display only top 20 tags initially */}
          {topTags.map(tag => (
            <a 
              href={`/tags/${tag}/`}
              class="px-3 py-1 text-sm bg-borderColor dark:bg-borderColorDark hover:bg-accent hover:text-white transition-colors rounded-md tag-link"
            >
              #{tag} <span class="text-xs opacity-75">({tagCounts.get(tag)})</span>
            </a>
          ))}
          
          {/* Additional tags that will be hidden initially */}
          {tags.length > 20 && (
            <>
              <span id="additional-tags" class="hidden">
                {tags.slice(20).map(tag => (
                  <a 
                    href={`/tags/${tag}/`}
                    class="px-3 py-1 text-sm bg-borderColor dark:bg-borderColorDark hover:bg-accent hover:text-white transition-colors rounded-md tag-link"
                  >
                    #{tag} <span class="text-xs opacity-75">({tagCounts.get(tag)})</span>
                  </a>
                ))}
              </span>
              
              {/* Show all tags button */}
              <button 
                id="show-all-tags-btn"
                class="px-3 py-1 text-sm border border-accent text-accent dark:border-accent dark:text-accent hover:bg-accent hover:text-white transition-colors rounded-md ml-2"
                data-total-tags={tags.length}
              >
                Show all tags ({tags.length})
              </button>
            </>
          )}
        </div>
      </div>
    )}

    <section class="space-y-12">
      {sortedNotes.length === 0 ? (
        <div class="text-center py-12 border border-borderColor dark:border-borderColorDark rounded-lg">
          <p class="text-textSecondary dark:text-textSecondaryDark">No book reviews yet. Check back soon!</p>
        </div>
      ) : (
        <div class="space-y-12">
          {sortedNotes.map(note => (
            <article>
              <a href={`/notes/${note.slug}/`} class="group">
                <div class="flex items-baseline gap-4">
                  <time class="text-sm text-textSecondary dark:text-textSecondaryDark whitespace-nowrap">
                    {new Date(note.data.pubDate).toLocaleDateString('en-US', {
                      day: 'numeric',
                      month: 'short',
                      year: 'numeric'
                    })}
                  </time>
                  <h2 class="text-xl font-medium group-hover:text-accent transition-colors">
                    {note.data.title}
                  </h2>
                </div>
              </a>
            </article>
          ))}
        </div>
      )}
    </section>
  </div>
</Layout>

<script>
  // JavaScript to handle the show all tags functionality
  document.addEventListener('DOMContentLoaded', () => {
    const showAllTagsBtn = document.getElementById('show-all-tags-btn');
    const additionalTags = document.getElementById('additional-tags');
    
    if (showAllTagsBtn && additionalTags) {
      const totalTags = showAllTagsBtn.getAttribute('data-total-tags');
      
      showAllTagsBtn.addEventListener('click', () => {
        // Toggle the visibility of additional tags
        if (additionalTags.classList.contains('hidden')) {
          // Show all tags
          additionalTags.classList.remove('hidden');
          additionalTags.classList.add('inline');
          showAllTagsBtn.textContent = 'Hide additional tags';
        } else {
          // Hide additional tags
          additionalTags.classList.add('hidden');
          additionalTags.classList.remove('inline');
          showAllTagsBtn.textContent = `Show all tags (${totalTags})`;
        }
      });
    }
  });
</script> 