---
import Layout from '../layouts/Layout.astro';
import NewsletterSignup from '../components/ui/NewsletterSignup.astro';
import HomeScrollRow from '../components/layout/HomeScrollRow.astro';
import StreamCard from '../components/layout/StreamCard.astro';
import NordletterScrollRow from '../components/layout/NordletterScrollRow.astro';
import Card from '../components/Card.astro';
import BookshelfCard from '../components/bookshelf/BookshelfCard.astro';
import { Image } from 'astro:assets';
import BookCover from '../images/books/01-ayom.jpg';
import ProfileImage from '../images/profile/profile.jpeg';
import { getAllPosts, getPostsByCategory, transformPost, cleanNordletterTitle, getEditionDisplay } from '../utils/content';
import type { Post } from '../utils/content';


// Get all posts
const allPosts = await getAllPosts();

// Stream: most recent blog, micro, photo posts
const streamPostsRaw = getPostsByCategory(allPosts, 'stream', { limit: 8 });
const streamPosts = streamPostsRaw.map(transformPost);

// Bookshelf: most recently added books
const bookshelfPostsRaw = getPostsByCategory(allPosts, ['bookshelf'], { limit: 8 });
const bookshelfPosts = bookshelfPostsRaw.map(transformPost);

// Garden: evergreen notes and TIL posts (no shelf)
const gardenPostsRaw = getPostsByCategory(allPosts, ['evergreen', 'til'], { limit: 8 });
const gardenPosts = gardenPostsRaw.map(transformPost);

// Nordletter: most recent issues with edition labels
const nordletterPostsRaw = getPostsByCategory(allPosts, ['nordletter'], { limit: 8 });
const nordletterPosts = nordletterPostsRaw.map((post) => {
    const transformed = transformPost(post);
    return {
        ...transformed,
        data: {
            ...transformed.data,
            title: cleanNordletterTitle(transformed.data.title ?? ''),
            editionDisplay: getEditionDisplay(post.data.edition, post.data.created, post.data.title, post.id),
        },
    };
});

// Fiction: most recent stories and poems
const fictionPostsRaw = getPostsByCategory(allPosts, ['story', 'poem'], { limit: 8 });
const fictionPosts = fictionPostsRaw.map(transformPost);
---

<Layout
    title="Sajal Choudhary"
    currentPage="/"
    pageWrapper={{
        maxWidth: 'full',
        padding: 'none',
        centered: false,
        className: 'contents',
        grid: {
            gap: 'loose',
            padding: 'narrow'
        }
    }}
    allPosts={allPosts}
    enableLinkHoverEffect
>
    <!-- Book Hero Section -->
    <section class="home-section home-section--book">
        <div class="grid-span-1 hidden md:block" aria-hidden="true"></div>
        <figure class="grid-span-3 home-book__cover edge-to-edge-mobile md:pr-6">
            <Image
                src={BookCover}
                alt="A Year of Mornings - Book Cover"
                class="w-full h-auto max-w-[20rem] mx-auto md:mx-0 rounded-xl shadow-lg"
            />
        </figure>
        <div class="grid-span-7 home-book__content text-center md:text-left">
            <div class="space-y-3">
                <p class="text-small text-gray-600 dark:text-gray-400 uppercase tracking-wide">Out now!</p>
                <h1 class="home-book__title font-bold">
                    <a href="/books/a-year-of-mornings/" class="text-accent hover:text-accent/80 transition-colors">
                        A Year of Mornings
                    </a>
                </h1>
                <p class="text-normal text-gray-700 dark:text-gray-300 leading-relaxed">
                    A collection of fifty love poems that follows a young heart as it finds love, finds the strength to be in love and finally, finds the strength to let go.
                </p>
            </div>
            <p class="text-normal text-gray-700 dark:text-gray-300">Nab your copy:</p>
            <div class="flex flex-col gap-3 sm:flex-row sm:justify-center md:justify-start">
                <a
                    href="https://amzn.to/46PLYIL"
                    class="inline-flex items-center justify-center rounded-xl bg-[#8b5cf6] px-6 py-3 font-semibold text-white shadow transition-colors hover:bg-[#7c3aed] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#7c3aed]"
                >
                    Buy on Amazon
                </a>
                <a
                    href="https://helmet.finna.fi/Record/helmet.2626433/Versions?sid=5134185916"
                    class="inline-flex items-center justify-center rounded-xl border border-[#8b5cf6] px-6 py-3 font-semibold text-[#7c3aed] transition-colors hover:bg-[#8b5cf6]/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#7c3aed]"
                >
                    Borrow via Helmet
                </a>
            </div>
        </div>
        <div class="grid-span-1 hidden md:block" aria-hidden="true"></div>
    </section>

    <!-- About + Newsletter Section -->
    <section class="home-section home-section--about">
        <figure class="grid-span-4 home-about__image flex justify-center md:justify-start">
            <Image
                src={ProfileImage}
                alt="Sajal Choudhary"
                class="w-56 h-56 sm:w-64 sm:h-64 lg:w-72 lg:h-72 rounded-full object-cover shadow-lg"
            />
        </figure>
        <div class="grid-span-8 home-about__content space-y-6 text-center md:text-left">
            <div class="prose dark:prose-invert max-w-none">
                <p class="text-normal leading-relaxed">
                    I am a platform engineer and a writer based in Finland.<br />I am the author of <a href='/books/a-year-of-mornings/' class='text-accent hover:text-accent/80'>A Year of Mornings</a>, a collection of poems for young adults.<br />
                </p>
            </div>
            <NewsletterSignup wrapperClass="py-0" formClass="mx-auto md:mx-0" />

            <!-- Social Media Links for Bridgy verification (hidden) -->
            <div class="sr-only">
                <a href="https://mastodon.social/@sajal24x7" rel="me">Mastodon</a>
                <a href="https://bsky.app/profile/sajal24x7.bsky.social" rel="me">Bluesky</a>
                <a href="https://github.com/sajal24x7" rel="me">GitHub</a>
            </div>
        </div>
    </section>

    <!-- Stream Section -->
    <HomeScrollRow title="Stream" ctaText="Dip into the stream" ctaHref="/stream/">
        {streamPosts.map((post) => <StreamCard post={post} />)}
    </HomeScrollRow>

    <!-- Bookshelf Section -->
    <HomeScrollRow title="Bookshelf" ctaText="Full shelf" ctaHref="/bookshelf/">
        {bookshelfPosts.map((post) => (
            <div class="scroll-slot scroll-slot--wide">
                <BookshelfCard
                    title={post.data.title ?? ''}
                    author={post.data.author}
                    series={post.data.series}
                    started={post.data.started}
                    finished={post.data.finished}
                    shelfStatus={post.data.shelfStatus as any}
                    readingProgress={post.data.readingProgress}
                    rating={post.data.rating}
                    cover={post.data.cover}
                    link={post.data.link}
                    format={post.data.format}
                    created={post.data.created}
                />
            </div>
        ))}
    </HomeScrollRow>

    <!-- Garden Section -->
    <HomeScrollRow title="Garden" ctaText="Roam the garden" ctaHref="/garden/">
        {gardenPosts.map((post) => (
            <div class="scroll-slot">
                <Card
                    title={post.data.title}
                    description={post.data.description}
                    created={post.data.created}
                    category={post.data.category}
                    image={post.data.image}
                    link={post.data.link}
                />
            </div>
        ))}
    </HomeScrollRow>

    <!-- Nordletter Section -->
    <NordletterScrollRow posts={nordletterPosts} />

    <!-- Fiction Section -->
    <HomeScrollRow title="Fiction" ctaText="Read fiction" ctaHref="/prose/">
        {fictionPosts.map((post) => (
            <div class="scroll-slot">
                <Card
                    title={post.data.title}
                    description={post.data.description}
                    created={post.data.created}
                    category={post.data.category}
                    image={post.data.image}
                    link={post.data.link}
                />
            </div>
        ))}
    </HomeScrollRow>

    <div class="grid-span-full home-footer-spacer" aria-hidden="true"></div>
</Layout>

<style>
    :global(.twelve-grid) {
        --grid-row-gap: 0;
    }

    /* sections that participate directly in the 12-col grid must be transparent */
    .home-section {
        display: contents;
    }

    .home-book__cover,
    .home-book__content {
        padding-block: clamp(2.5rem, 6vw, 4rem);
    }

    .home-book__cover {
        display: flex;
        justify-content: center;
    }

    .home-book__title {
        font-size: clamp(1.75rem, 5vw, 2.25rem);
        text-align: center;
    }

    .home-book__content {
        display: flex;
        flex-direction: column;
        gap: clamp(1.75rem, 4vw, 2.5rem);
    }

    .home-about__image,
    .home-about__content {
        padding-block: clamp(2rem, 5vw, 3.75rem);
    }

    .home-about__content {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    /* ── Scroll section card slots ──────────────────────────── */
    .scroll-slot {
        width: 15rem;
        flex-shrink: 0;
        scroll-snap-align: start;
        display: flex;
        flex-direction: column;
    }

    .scroll-slot--wide {
        width: 18rem;
    }

    /* Ensure Card fills its slot */
    .scroll-slot :global(.card),
    .scroll-slot :global(.book-card) {
        width: 100%;
        height: 100%;
    }

    .home-footer-spacer {
        padding-bottom: clamp(2rem, 5vw, 3rem);
    }

    @media (min-width: 48rem) {
        .home-book__cover {
            justify-content: flex-start;
            padding-right: clamp(1.25rem, 3vw, 2.5rem);
        }

        .home-book__content {
            text-align: left;
        }

        .home-about__content {
            text-align: left;
        }
    }

    @media (max-width: 47.99rem) {
        .home-book__cover,
        .home-about__image {
            margin-bottom: clamp(1.5rem, 5vw, 2rem);
        }
    }
</style>
