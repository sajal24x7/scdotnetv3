---
import Layout from '../layouts/Layout.astro';
import NewsletterSignup from '../components/ui/NewsletterSignup.astro';
import UnifiedFeed from '../components/layout/UnifiedFeed.astro';
import { Image } from 'astro:assets';
import ProfileImage from '../images/profile/profile.jpeg';
import { getAllPosts } from '../utils/content';
import { getFeedEntriesForGroup, FEED_PAGE_SIZE } from '../utils/feed';

// Get all posts
const allPosts = await getAllPosts();

// First page of the unified feed; the rest loads client-side from /api/feed/
const feedEntries = await getFeedEntriesForGroup(allPosts, 'all');
const initialEntries = feedEntries.slice(0, FEED_PAGE_SIZE);
const hasMoreEntries = feedEntries.length > FEED_PAGE_SIZE;
---

<Layout
    title="Sajal Choudhary"
    currentPage="/"
    pageWrapper={{
        maxWidth: 'full',
        padding: 'none',
        centered: false,
        className: 'contents',
        grid: {
            gap: 'loose',
            padding: 'narrow'
        }
    }}
    allPosts={allPosts}
    enableLinkHoverEffect
>
    <!-- About + Newsletter Section -->
    <section class="home-section home-section--about">
        <figure class="grid-span-4 home-about__image flex justify-center md:justify-start">
            <Image
                src={ProfileImage}
                alt="Sajal Choudhary"
                class="w-56 h-56 sm:w-64 sm:h-64 lg:w-72 lg:h-72 rounded-full object-cover shadow-lg"
            />
        </figure>
        <div class="grid-span-8 home-about__content space-y-6 text-center md:text-left">
            <div class="prose dark:prose-invert max-w-none">
                <h1 class="text-huge font-bold">Sajal Choudhary</h1>
                <p class="text-normal leading-relaxed">I am a platform engineer and a writer based in Finland.</p>
                <p class="text-normal leading-relaxed">I am also the author of <a href='/books/a-year-of-mornings/' class='text-accent hover:text-accent/80'>A Year of Mornings</a>, a collection of poems for young adults.</p>
            </div>
            <NewsletterSignup wrapperClass="py-0" formClass="mx-auto md:mx-0" />

            <!-- Social Media Links for Bridgy verification (hidden) -->
            <div class="sr-only">
                <a href="https://mastodon.social/@sajal24x7" rel="me">Mastodon</a>
                <a href="https://bsky.app/profile/sajal24x7.bsky.social" rel="me">Bluesky</a>
                <a href="https://github.com/sajal24x7" rel="me">GitHub</a>
            </div>
        </div>
    </section>

    <!-- Unified Feed Section -->
    <section class="home-section home-section--feed">
        <div class="home-feed grid-span-full">
            <UnifiedFeed entries={initialEntries} hasMore={hasMoreEntries} />
        </div>
    </section>

    <div class="grid-span-full home-footer-spacer" aria-hidden="true"></div>
</Layout>

<style>
    :global(.twelve-grid) {
        --grid-row-gap: 0;
    }

    .home-section {
        display: contents;
    }

    .home-about__image,
    .home-about__content {
        padding-block: clamp(2rem, 5vw, 3.75rem);
    }

    .home-about__content {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .home-section--feed {
        display: contents;
    }

    .home-feed {
        display: flex;
        padding-block: clamp(2rem, 5vw, 3.5rem);
        border-top: 1px solid rgba(var(--color-text-primary), 0.12);
        margin-top: clamp(1rem, 3vw, 2rem);
    }

    .home-footer-spacer {
        padding-bottom: clamp(2rem, 5vw, 3rem);
    }

    @media (min-width: 48rem) {
        .home-feed {
            grid-column: 2 / span 10;
            padding-block: clamp(2.5rem, 5vw, 4rem);
        }

        .home-about__content {
            text-align: left;
        }
    }

    @media (max-width: 47.99rem) {
        .home-about__image {
            margin-bottom: clamp(1.5rem, 5vw, 2rem);
        }
    }
</style>
