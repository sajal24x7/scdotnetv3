---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostCard from '../components/PostCard.astro';
import type { CollectionEntry } from 'astro:content';

// Get all posts
const allPosts = await getCollection('posts');

// Get recent notes for featured section
const recentNotes = allPosts
  .filter(post => post.data.category === 'evergreen')
  .sort((a, b) => {
    const aDate = a.data.updatedDate || a.data.pubDate;
    const bDate = b.data.updatedDate || b.data.pubDate;
    return bDate.valueOf() - aDate.valueOf();
  })
  .slice(0, 3);

// Get creative writing (stories and poems)
const creativeWriting = allPosts
  .filter(post => ['stories', 'poems'].includes(post.data.category))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Get recent blog posts
const recentBlogPosts = allPosts
  .filter(post => post.data.category === 'blog')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Get a random post from available collections
const getRandomPost = () => {
  if (allPosts.length === 0) return null;
  const randomIndex = Math.floor(Math.random() * allPosts.length);
  const randomPost = allPosts[randomIndex];
  return `/${randomPost.data.category}/${randomPost.slug}/`;
};
---

<Layout title="Sajal Choudhary" currentPage="/">
  <section class="max-w-4xl mx-auto">
    <!-- Header Section -->
    <div class="py-8 mb-12 border-b border-gray-200 dark:border-gray-700">
