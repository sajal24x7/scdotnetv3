        <div class="grid md:grid-cols-2 gap-8 text-sm">
          <div>
            <h4 class="font-medium mb-2">Writing</h4>
            <ul class="space-y-1 text-textSecondary dark:text-textSecondaryDark">
              <li><a href="/notes/" class="hover:text-accent">Digital Garden</a></li>
              <li><a href="/blog/" class="hover:text-accent">Blog Posts</a></li>
              <li><a href="/stories/" class="hover:text-accent">Short Stories</a></li>
              <li><a href="/poems/" class="hover:text-accent">Poems</a></li>
            </ul>
          </div>
          
          <div>
            <h4 class="font-medium mb-2">About</h4>
            <ul class="space-y-1 text-textSecondary dark:text-textSecondaryDark">
              <li><a href="/about/" class="hover:text-accent">About Me</a></li>
              <li><a href="/now/" class="hover:text-accent">What I'm Doing Now</a></li>
              <li><a href="/books/" class="hover:text-accent">What I'm Reading</a></li>
              <li><a href="/contact/" class="hover:text-accent">Get In Touch</a></li>
