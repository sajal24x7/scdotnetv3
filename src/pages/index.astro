---
import Layout from '../layouts/Layout.astro';
import ProfileHero from '../components/ui/ProfileHero.astro';
import BookShowcase from '../components/ui/BookShowcase.astro';
import NewsletterSignup from '../components/ui/NewsletterSignup.astro';
import HomeTwoRowGrid from '../components/layout/HomeTwoRowGrid.astro';
import ResponsiveContentGrid from '../components/content/ResponsiveContentGrid.astro';
import PostList from '../components/content/PostList.astro';
import BookList from '../components/content/BookList.astro';
import FictionGrid from '../components/content/FictionGrid.astro';
import { getAllPosts } from '../utils/content';
import { formatDate } from '../utils/date';

// Get all posts
const allPosts = await getAllPosts();

// Recent notes (evergreen category)
const recentNotes = allPosts
  .filter(post => post.data.category === 'evergreen')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 8);

// Ephemera posts (blog, micro, photo, til categories)
const ephemeraPosts = allPosts
  .filter(post => ['blog', 'micro', 'photo', 'til'].includes(post.data.category))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 8);

// Recent bookshelf posts
const recentBooks = allPosts
  .filter(post => post.data.category === 'bookshelf')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 8);

// Recent fiction posts (poems and stories combined)
const recentFiction = allPosts
  .filter(post => ['poem', 'story'].includes(post.data.category))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 8);

const sections = [
  {
    title: "Recent Posts",
    description: "Latest thoughts and writings",
    href: "/blog/",
    posts: allPosts
      .filter(post => ['blog', 'micro'].includes(post.data.category))
      .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
      .slice(0, 6)
  }
];
---

<Layout 
  title="Sajal Choudhary" 
  currentPage="/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
  <ProfileHero
    name="Sajal Choudhary"
    title="Hi I'm Sajal, a writer, poet & walker."
    description="I graduated from Delhi Technological University (DCE) in 2014. I joined TCS as a Systems Engineer after graduation. I manage a team now. And the breadth of technologies I work on has also ballooned a bit. 😄 I moved to Finland in April, 2021. I have lived in Helsinki, walked around the Toolo lake. Then moved to Espoo, and continue living in Matinkyla. Walking around Matinkyla beach. I have written at different places (couple of Wordpress sites) from around 2012. I have folded all of those stories, poems and essays under this site now."
    imageSrc="/profile/profile.jpeg"
    imageAlt="Sajal Choudhary"
    bookLink="/books/a-year-of-mornings/"
    bookTitle="A Year of Mornings"
    jobDescription=""
  />

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
    <BookShowcase
      bookTitle="A Year of Mornings"
      bookLink="/books/a-year-of-mornings/"
      bookCoverSrc="/books/01-ayom.jpg"
      bookCoverAlt="A Year of Mornings - Book Cover"
      bookDescription="A collection of fifty love poems that follows a young heart as it finds love, finds the strength to be in love and finally, finds the strength to let go."
    />
    <NewsletterSignup />
  </div>

  <HomeTwoRowGrid>
    <ResponsiveContentGrid
      slot="topLeft"
      posts={recentNotes}
      columns={2}
      layout="grid"
      gap="md"
    />
    <PostList
      slot="topRight"
      posts={ephemeraPosts}
      mode="list"
      showCategory={true}
      compact={true}
      maxPosts={8}
    />
    <FictionGrid
      slot="bottomLeft"
      posts={recentFiction}
      maxPosts={8}
    />
    <BookList
      slot="bottomRight"
      posts={recentBooks}
      maxPosts={8}
    />
  </HomeTwoRowGrid>

  <div class="py-12"></div>
</Layout>