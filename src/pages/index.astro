---
import Layout from '../layouts/Layout.astro';
import NewsletterSignup from '../components/ui/NewsletterSignup.astro';
import StreamList from '../components/layout/StreamList.astro';
import HomeFeaturedGrid from '../components/content/HomeFeaturedGrid.astro';
import GardenGrid from '../components/layout/GardenGrid.astro';
import { Image } from 'astro:assets';
import BookCover from '../images/books/01-ayom.jpg';
import ProfileImage from '../images/profile/profile.jpeg';
import { getAllPosts, getPostsByCategory, transformPost } from '../utils/content';
import type { Post } from '../utils/content';


// Get all posts
const allPosts = await getAllPosts();
const postsBySlug = new Map(allPosts.map((post) => [post.slug, post] as const));

// Build a list of the most recent stream posts across the unified categories
const streamPostsRaw = getPostsByCategory(allPosts, 'stream', { limit: 5 });
const streamPosts = streamPostsRaw.map(transformPost);

// Curate the latest garden notes, stories, til entries, and more
const gardenPostsRaw = getPostsByCategory(allPosts, 'garden', { limit: 8 });
const gardenPosts = gardenPostsRaw.map(transformPost);

// Load the featured pool from the curated data file
const { default: homeFeaturedPoolRaw } = await import('../data/homeFeatured.json');
const homeFeaturedPool = (Array.isArray(homeFeaturedPoolRaw) ? homeFeaturedPoolRaw : []) as string[];

const shufflePosts = <T,>(input: T[]): T[] => {
    const array = [...input];
    for (let i = array.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]];
    }
    return array;
};

const featuredCandidates = homeFeaturedPool
    .map((slug) => postsBySlug.get(slug))
    .filter((post): post is Post => Boolean(post));

const featuredPosts = shufflePosts(featuredCandidates)
    .slice(0, 4)
    .map(transformPost);
---

<Layout
    title="Sajal Choudhary"
    currentPage="/"
    pageWrapper={{
        maxWidth: 'full',
        padding: 'none',
        centered: false,
        className: 'contents',
        grid: {
            gap: 'loose',
            padding: 'narrow'
        }
    }}
    allPosts={allPosts}
    enableSearchModal
    enableLinkHoverEffect
>
    <!-- Book Hero Section -->
    <section class="home-section home-section--book">
        <div class="grid-span-1 hidden md:block" aria-hidden="true"></div>
        <figure class="grid-span-3 home-book__cover edge-to-edge-mobile md:pr-6">
            <Image
                src={BookCover}
                alt="A Year of Mornings - Book Cover"
                class="w-full h-auto max-w-[20rem] mx-auto md:mx-0 rounded-xl shadow-lg"
            />
        </figure>
        <div class="grid-span-7 home-book__content text-center md:text-left">
            <div class="space-y-3">
                <p class="text-small text-gray-600 dark:text-gray-400 uppercase tracking-wide">Out now!</p>
                <h1 class="text-huge font-bold">
                    <a href="/books/a-year-of-mornings/" class="text-accent hover:text-accent/80 transition-colors">
                        A Year of Mornings
                    </a>
                </h1>
                <p class="text-normal text-gray-700 dark:text-gray-300 leading-relaxed">
                    A collection of fifty love poems that follows a young heart as it finds love, finds the strength to be in love and finally, finds the strength to let go.
                </p>
            </div>
            <p class="text-normal text-gray-700 dark:text-gray-300">Nab your copy:</p>
            <div class="flex flex-col gap-3 sm:flex-row sm:justify-center md:justify-start">
                <a
                    href="https://amzn.in/d/cJIzbG0"
                    class="inline-flex items-center justify-center rounded-xl bg-[#8b5cf6] px-6 py-3 font-semibold text-white shadow transition-colors hover:bg-[#7c3aed] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#7c3aed]"
                >
                    Buy on Amazon
                </a>
                <a
                    href="https://helmet.finna.fi/Record/helmet.2626433/Versions?sid=5134185916"
                    class="inline-flex items-center justify-center rounded-xl border border-[#8b5cf6] px-6 py-3 font-semibold text-[#7c3aed] transition-colors hover:bg-[#8b5cf6]/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#7c3aed]"
                >
                    Borrow via Helmet
                </a>
            </div>
        </div>
        <div class="grid-span-1 hidden md:block" aria-hidden="true"></div>
    </section>

    <!-- About + Newsletter Section -->
    <section class="home-section home-section--about">
        <figure class="grid-span-4 home-about__image flex justify-center md:justify-start">
            <Image
                src={ProfileImage}
                alt="Sajal Choudhary"
                class="w-56 h-56 sm:w-64 sm:h-64 lg:w-72 lg:h-72 rounded-full object-cover shadow-lg"
            />
        </figure>
        <div class="grid-span-8 home-about__content space-y-6 text-center md:text-left">
            <div class="prose dark:prose-invert max-w-none">
                <p class="text-normal leading-relaxed">
                    I am a platform engineer and a writer based in Finland.<br />I am the author of <a href='/books/a-year-of-mornings/' class='text-accent hover:text-accent/80'>A Year of Mornings</a>, a collection of poems for young adults.<br />
                </p>
            </div>
            <NewsletterSignup />

            <!-- Social Media Links for Bridgy verification (hidden) -->
            <div class="sr-only">
                <a href="https://mastodon.social/@sajal24x7" rel="me">Mastodon</a>
                <a href="https://bsky.app/profile/sajal24x7.bsky.social" rel="me">Bluesky</a>
                <a href="https://github.com/sajal24x7" rel="me">GitHub</a>
            </div>
        </div>
    </section>

    <!-- Writing Section -->
    <section class="home-section home-section--featured">
        <HomeFeaturedGrid posts={featuredPosts} />
    </section>

    <section class="home-section home-section--stream">
        <div class="home-stream grid-span-8 grid-start-3">
            <div class="home-stream__inner">
                <h2 class="home-stream__title">Stream</h2>
                <StreamList posts={streamPosts} />
                <a href="/stream/" class="home-stream__cta">Dip into the stream</a>
            </div>
        </div>
    </section>

    <section class="home-section home-section--garden">
        <div class="home-garden__heading grid-span-full">
            <h2 class="home-garden__title">Garden</h2>
        </div>
        <div class="home-garden__grid grid-span-full">
            <GardenGrid posts={gardenPosts} />
        </div>
        <div class="home-garden__footer grid-span-full">
            <a href="/garden/" class="home-garden__cta">Roam through the garden</a>
        </div>
    </section>

    <div class="grid-span-full home-footer-spacer" aria-hidden="true"></div>
</Layout>

<style>
    .home-section {
        display: contents;
    }

    .home-book__cover,
    .home-book__content {
        padding-block: clamp(2.5rem, 6vw, 4rem);
    }

    .home-book__cover {
        display: flex;
        justify-content: center;
    }

    .home-book__content {
        display: flex;
        flex-direction: column;
        gap: clamp(1.75rem, 4vw, 2.5rem);
    }

    .home-about__image,
    .home-about__content {
        padding-block: clamp(2rem, 5vw, 3.75rem);
    }

    .home-about__content {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .home-section--featured,
    .home-section--stream,
    .home-section--garden {
        display: contents;
    }

    .home-stream {
        display: flex;
        padding-block: clamp(2rem, 5vw, 3.5rem);
    }

    .home-garden__title {
        font-size: var(--text-large);
        font-weight: 700;
        margin: 0;
        color: rgb(var(--color-text-primary));
    }

    .home-garden__heading {
        margin-top: clamp(2rem, 5vw, 3.5rem);
        margin-bottom: clamp(1.5rem, 3vw, 2rem);
    }

    .home-garden__grid {
        display: contents;
        margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
    }

    .home-garden__footer {
        display: flex;
    }

    .home-garden__cta,
    .home-stream__cta {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-weight: 600;
        font-size: 0.95rem;
        color: rgb(var(--color-text-primary));
        text-decoration: none;
        border-bottom: 1px solid rgba(var(--color-text-primary), 0.2);
        padding-bottom: 0.15rem;
        transition: color 0.2s ease, border-color 0.2s ease;
    }

    .home-garden__cta:hover,
    .home-garden__cta:focus-visible,
    .home-stream__cta:hover,
    .home-stream__cta:focus-visible {
        color: rgb(var(--color-text-primary));
        border-bottom-color: rgba(var(--color-text-primary), 0.45);
    }

    .home-garden__cta:focus-visible,
    .home-stream__cta:focus-visible {
        outline: 2px solid rgb(var(--color-accent));
        outline-offset: 2px;
    }

    .home-garden__cta::after,
    .home-stream__cta::after {
        content: '→';
        font-size: 0.95em;
        transition: transform 0.2s ease;
    }

    .home-garden__cta:hover::after,
    .home-garden__cta:focus-visible::after,
    .home-stream__cta:hover::after,
    .home-stream__cta:focus-visible::after {
        transform: translateX(0.2rem);
    }

    .home-stream__inner {
        display: flex;
        flex-direction: column;
        gap: clamp(1.25rem, 3vw, 1.75rem);
    }

    .home-stream__title {
        font-size: var(--text-large);
        font-weight: 700;
        margin: 0;
        color: rgb(var(--color-text-primary));
    }

    .home-footer-spacer {
        padding-bottom: clamp(2rem, 5vw, 3rem);
    }

    @media (min-width: 48rem) {
        .home-book__cover {
            justify-content: flex-start;
            padding-right: clamp(1.25rem, 3vw, 2.5rem);
        }

        .home-book__content {
            text-align: left;
        }

        .home-about__content {
            text-align: left;
        }

        .home-stream {
            padding-block: clamp(2.5rem, 5vw, 4rem);
        }
    }

    @media (max-width: 47.99rem) {
        .home-book__cover,
        .home-about__image {
            margin-bottom: clamp(1.5rem, 5vw, 2rem);
        }

        .home-stream__title,
        .home-garden__title {
            text-align: center;
        }

        .home-stream__cta,
        .home-garden__cta {
            justify-content: center;
            align-self: center;
        }

        .home-garden__footer {
            justify-content: center;
        }
    }
</style>
