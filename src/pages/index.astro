---
import Layout from '../layouts/Layout.astro';
import NewsletterSignup from '../components/ui/NewsletterSignup.astro';
import RecentItems from '../components/RecentItems.astro';
import FeaturedPosts from '../components/content/FeaturedPosts.astro';
import { FEATURED_POST_SLUGS } from '../data/featuredPostSlugs';
import { getAllPosts, getPostsByCategory, transformPost } from '../utils/content';
import type { Post } from '../utils/content';


// Get all posts
const allPosts = await getAllPosts();
const postsBySlug = new Map(allPosts.map((post) => [post.slug, post] as const));

// Build a list of the most recent stream posts across the unified categories
const recentPostsRaw = getPostsByCategory(allPosts, 'stream', { limit: 8 });
const recentPosts = recentPostsRaw.map(transformPost);

// Collect featured stories that lean on long-form writing and visuals
const featuredSource = getPostsByCategory(allPosts, ['evergreen', 'story', 'poem', 'blog'], { limit: 12 });
const recentSlugs = new Set(recentPostsRaw.map((post) => post.slug));

const curatedFeatured = FEATURED_POST_SLUGS.reduce<Post[]>((acc, slug) => {
    const post = postsBySlug.get(slug);
    if (post && !recentSlugs.has(post.slug)) {
        acc.push(post);
    }
    return acc;
}, []);

const curatedSlugs = new Set(curatedFeatured.map((post) => post.slug));

const fallbackFeatured = featuredSource
    .filter((post) => !recentSlugs.has(post.slug) && !curatedSlugs.has(post.slug))
    .sort((a, b) => {
        const aHasImage = a.data?.image ? 1 : 0;
        const bHasImage = b.data?.image ? 1 : 0;
        if (aHasImage !== bHasImage) {
            return bHasImage - aHasImage;
        }
        const aTime = new Date(a.data.pubDate).getTime();
        const bTime = new Date(b.data.pubDate).getTime();
        return bTime - aTime;
    });

const prioritizedFeatured = [...curatedFeatured, ...fallbackFeatured];

const featuredPosts = prioritizedFeatured.slice(0, 6).map(transformPost);
---

<Layout
    title="Sajal Choudhary"
    currentPage="/"
    pageWrapper={{
        maxWidth: 'full',
        padding: 'none',
        centered: false,
        className: 'contents',
        grid: {
            gap: 'loose',
            padding: 'narrow'
        }
    }}
    allPosts={allPosts}
    enableSearchModal
    enableLinkHoverEffect
>
    <!-- Book Hero Section -->
    <section class="home-section home-section--book">
        <div class="grid-span-1 hidden md:block" aria-hidden="true"></div>
        <figure class="grid-span-3 home-book__cover edge-to-edge-mobile md:pr-6">
            <img
                src="/books/01-ayom.jpg"
                alt="A Year of Mornings - Book Cover"
                class="w-full h-auto max-w-[20rem] mx-auto md:mx-0 rounded-xl shadow-lg"
            />
        </figure>
        <div class="grid-span-7 home-book__content text-center md:text-left">
            <div class="space-y-3">
                <p class="text-small text-gray-600 dark:text-gray-400 uppercase tracking-wide">Out now!</p>
                <h1 class="text-huge font-bold">
                    <a href="/books/a-year-of-mornings/" class="text-accent hover:text-accent/80 transition-colors">
                        A Year of Mornings
                    </a>
                </h1>
                <p class="text-normal text-gray-700 dark:text-gray-300 leading-relaxed">
                    A collection of fifty love poems that follows a young heart as it finds love, finds the strength to be in love and finally, finds the strength to let go.
                </p>
            </div>
            <p class="text-normal text-gray-700 dark:text-gray-300">Nab your copy:</p>
            <div class="flex flex-col gap-3 sm:flex-row sm:justify-center md:justify-start">
                <a
                    href="https://amzn.in/d/cJIzbG0"
                    class="inline-flex items-center justify-center rounded-xl bg-[#8b5cf6] px-6 py-3 font-semibold text-white shadow transition-colors hover:bg-[#7c3aed] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#7c3aed]"
                >
                    Buy on Amazon
                </a>
                <a
                    href="https://helmet.finna.fi/Record/helmet.2626433/Versions?sid=5134185916"
                    class="inline-flex items-center justify-center rounded-xl border border-[#8b5cf6] px-6 py-3 font-semibold text-[#7c3aed] transition-colors hover:bg-[#8b5cf6]/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#7c3aed]"
                >
                    Borrow via Helmet
                </a>
            </div>
        </div>
        <div class="grid-span-1 hidden md:block" aria-hidden="true"></div>
    </section>

    <!-- About + Newsletter Section -->
    <section class="home-section home-section--about">
        <figure class="grid-span-4 home-about__image flex justify-center md:justify-start">
            <img
                src="/profile/profile.jpeg"
                alt="Sajal Choudhary"
                class="w-56 h-56 sm:w-64 sm:h-64 lg:w-72 lg:h-72 rounded-full object-cover shadow-lg"
            />
        </figure>
        <div class="grid-span-8 home-about__content space-y-6 text-center md:text-left">
            <div class="prose dark:prose-invert max-w-none">
                <p class="text-normal leading-relaxed">
                    I am a platform engineer and a writer based in Finland.<br />I am the author of <a href='/books/a-year-of-mornings/' class='text-accent hover:text-accent/80'>A Year of Mornings</a>, a collection of poems for young adults.<br />
                </p>
            </div>
            <NewsletterSignup />

            <!-- Social Media Links for Bridgy verification (hidden) -->
            <div class="sr-only">
                <a href="https://mastodon.social/@sajal24x7" rel="me">Mastodon</a>
                <a href="https://bsky.app/profile/sajal24x7.bsky.social" rel="me">Bluesky</a>
                <a href="https://github.com/sajal24x7" rel="me">GitHub</a>
            </div>
        </div>
    </section>

    <!-- Writing Section -->
    <section class="grid-span-8 grid-start-1 home-posts">
        <RecentItems posts={recentPosts} title="Recently" />
    </section>

    <aside class="grid-span-4 grid-start-9 home-posts__featured">
        <FeaturedPosts posts={featuredPosts} title="Featured" />
    </aside>
</Layout>

<style>
    .home-section {
        display: contents;
    }

    .home-book__cover,
    .home-book__content {
        padding-block: clamp(2.5rem, 6vw, 4rem);
    }

    .home-book__cover {
        display: flex;
        justify-content: center;
    }

    .home-book__content {
        display: flex;
        flex-direction: column;
        gap: clamp(1.75rem, 4vw, 2.5rem);
    }

    .home-about__image,
    .home-about__content {
        padding-block: clamp(2rem, 5vw, 3.75rem);
    }

    .home-about__content {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .home-posts,
    .home-posts__featured {
        padding-block: clamp(2rem, 5vw, 3.5rem);
    }

    @media (min-width: 48rem) {
        .home-book__cover {
            justify-content: flex-start;
            padding-right: clamp(1.25rem, 3vw, 2.5rem);
        }

        .home-book__content {
            text-align: left;
        }

        .home-about__content {
            text-align: left;
        }

        .home-posts,
        .home-posts__featured {
            padding-block: clamp(2.5rem, 5vw, 4rem);
        }
    }

    @media (max-width: 47.99rem) {
        .home-book__cover,
        .home-about__image {
            margin-bottom: clamp(1.5rem, 5vw, 2rem);
        }
    }
</style>
