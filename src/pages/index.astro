---
import Layout from '../layouts/Layout.astro';
import NewsletterSignup from '../components/ui/NewsletterSignup.astro';
import StreamList from '../components/layout/StreamList.astro';
import GardenGrid from '../components/layout/GardenGrid.astro';
import BookshelfCard from '../components/bookshelf/BookshelfCard.astro';
import { Image } from 'astro:assets';
import BookCover from '../images/books/01-ayom.jpg';
import ProfileImage from '../images/profile/profile.jpeg';
import { getAllPosts, getPostsByCategory, transformPost, cleanNordletterTitle } from '../utils/content';
import type { Post } from '../utils/content';

const allPosts = await getAllPosts();
const postsBySlug = new Map(allPosts.map((post) => [post.slug, post] as const));

// Stream: last 5 posts (blog, micro, photo)
const streamPostsRaw = getPostsByCategory(allPosts, 'stream', { limit: 5 });
const streamPosts = streamPostsRaw.map(transformPost);

// Garden: curated featured posts from homeFeatured.json pool
const { default: homeFeaturedPoolRaw } = await import('../data/homeFeatured.json');
const homeFeaturedPool = (Array.isArray(homeFeaturedPoolRaw) ? homeFeaturedPoolRaw : []) as string[];

const gardenPosts = homeFeaturedPool
    .map((slug) => postsBySlug.get(slug))
    .filter((post): post is Post => Boolean(post))
    .map(transformPost);

// Nordletter: 3 most recent editions
const nordletterPostsRaw = getPostsByCategory(allPosts, 'nordletter', { limit: 3 });
const nordletterPosts = nordletterPostsRaw.map(post => {
    const transformed = transformPost(post);
    const pubDate = post.data.pubDate instanceof Date ? post.data.pubDate : new Date(String(post.data.pubDate));
    return {
        ...transformed,
        cleanTitle: cleanNordletterTitle(post.data.title || '') || post.data.title || '',
        formattedDate: pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
        isoDate: pubDate.toISOString(),
    };
});

// Bookshelf: 4 most recently added books (raw data kept for full BookshelfCard props)
const bookshelfPostsRaw = getPostsByCategory(allPosts, 'bookshelf', { limit: 4 });
const bookshelfPosts = bookshelfPostsRaw.map(post => ({
    ...post,
    link: `/bookshelf/${post.slug}/`,
}));
---

<Layout
    title="Sajal Choudhary"
    currentPage="/"
    pageWrapper={{
        maxWidth: 'full',
        padding: 'none',
        centered: false,
        className: 'contents',
        grid: {
            gap: 'loose',
            padding: 'narrow'
        }
    }}
    allPosts={allPosts}
    enableSearchModal
    enableLinkHoverEffect
>
    <!-- Book Hero Section -->
    <section class="home-section home-section--book">
        <div class="grid-span-1 hidden md:block" aria-hidden="true"></div>
        <figure class="grid-span-3 home-book__cover edge-to-edge-mobile md:pr-6">
            <Image
                src={BookCover}
                alt="A Year of Mornings - Book Cover"
                class="w-full h-auto max-w-[20rem] mx-auto md:mx-0 rounded-xl shadow-lg"
            />
        </figure>
        <div class="grid-span-7 home-book__content text-center md:text-left">
            <div class="space-y-3">
                <p class="text-small text-gray-600 dark:text-gray-400 uppercase tracking-wide">Out now!</p>
                <h1 class="home-book__title font-bold">
                    <a href="/books/a-year-of-mornings/" class="text-accent hover:text-accent/80 transition-colors">
                        A Year of Mornings
                    </a>
                </h1>
                <p class="text-normal text-gray-700 dark:text-gray-300 leading-relaxed">
                    A collection of fifty love poems that follows a young heart as it finds love, finds the strength to be in love and finally, finds the strength to let go.
                </p>
            </div>
            <p class="text-normal text-gray-700 dark:text-gray-300">Nab your copy:</p>
            <div class="flex flex-col gap-3 sm:flex-row sm:justify-center md:justify-start">
                <a
                    href="https://amzn.to/46PLYIL"
                    class="inline-flex items-center justify-center rounded-xl bg-[#8b5cf6] px-6 py-3 font-semibold text-white shadow transition-colors hover:bg-[#7c3aed] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#7c3aed]"
                >
                    Buy on Amazon
                </a>
                <a
                    href="https://helmet.finna.fi/Record/helmet.2626433/Versions?sid=5134185916"
                    class="inline-flex items-center justify-center rounded-xl border border-[#8b5cf6] px-6 py-3 font-semibold text-[#7c3aed] transition-colors hover:bg-[#8b5cf6]/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#7c3aed]"
                >
                    Borrow via Helmet
                </a>
            </div>
        </div>
        <div class="grid-span-1 hidden md:block" aria-hidden="true"></div>
    </section>

    <!-- About + Newsletter Section -->
    <section class="home-section home-section--about">
        <figure class="grid-span-4 home-about__image flex justify-center md:justify-start">
            <Image
                src={ProfileImage}
                alt="Sajal Choudhary"
                class="w-56 h-56 sm:w-64 sm:h-64 lg:w-72 lg:h-72 rounded-full object-cover shadow-lg"
            />
        </figure>
        <div class="grid-span-8 home-about__content space-y-6 text-center md:text-left">
            <div class="prose dark:prose-invert max-w-none">
                <p class="text-normal leading-relaxed">
                    I am a platform engineer and a writer based in Finland.<br />I am the author of <a href='/books/a-year-of-mornings/' class='text-accent hover:text-accent/80'>A Year of Mornings</a>, a collection of poems for young adults.<br />
                </p>
            </div>
            <NewsletterSignup wrapperClass="py-0" formClass="mx-auto md:mx-0" />
            <div class="sr-only">
                <a href="https://mastodon.social/@sajal24x7" rel="me">Mastodon</a>
                <a href="https://bsky.app/profile/sajal24x7.bsky.social" rel="me">Bluesky</a>
                <a href="https://github.com/sajal24x7" rel="me">GitHub</a>
            </div>
        </div>
    </section>

    <!-- Two-column content: Wide left (Garden + Stream) | Narrow right (Nordletter + Bookshelf) -->
    <div class="home-content-columns grid-span-full">

        <!-- Left column: Garden (curated) + Stream -->
        <div class="home-col home-col--main">

            <section class="home-section-block">
                <div class="home-section-header">
                    <h2 class="home-section-title">Garden</h2>
                </div>
                <div data-garden-grid>
                    <GardenGrid posts={gardenPosts} />
                </div>
                <div class="home-section-footer">
                    <a href="/garden/" class="home-section-cta">Roam through the garden</a>
                </div>
            </section>

            <section class="home-section-block">
                <div class="home-section-header">
                    <h2 class="home-section-title">Stream</h2>
                </div>
                <StreamList posts={streamPosts} />
                <div class="home-section-footer">
                    <a href="/stream/" class="home-section-cta">Dip into the stream</a>
                </div>
            </section>

        </div>

        <!-- Right column: Nordletter + Bookshelf -->
        <div class="home-col home-col--side">

            <section class="home-section-block">
                <div class="home-section-header">
                    <h2 class="home-section-title">Nordletter</h2>
                </div>
                <ul class="home-nordletter-list">
                    {nordletterPosts.map(post => (
                        <li class="home-nordletter-item">
                            <a href={post.data.link} class="home-nordletter-link">
                                {post.data.edition && (
                                    <span class="home-nordletter-edition">#{post.data.edition}</span>
                                )}
                                <span class="home-nordletter-title">{post.cleanTitle}</span>
                            </a>
                            <time class="home-nordletter-date" datetime={post.isoDate}>
                                {post.formattedDate}
                            </time>
                        </li>
                    ))}
                </ul>
                <div class="home-section-footer">
                    <a href="/nordletter/" class="home-section-cta">Read the archives</a>
                </div>
            </section>

            <section class="home-section-block">
                <div class="home-section-header">
                    <h2 class="home-section-title">Bookshelf</h2>
                </div>
                <div class="home-bookshelf-list">
                    {bookshelfPosts.map(post => (
                        <BookshelfCard
                            title={post.data.title}
                            author={post.data.author}
                            series={post.data.series}
                            startedReading={post.data.startedReading}
                            finishedReading={post.data.finishedReading}
                            bookStatus={post.data.bookStatus}
                            bookRating={post.data.bookRating}
                            bookCover={post.data.bookCover}
                            link={post.link}
                            format={post.data.format}
                            pubDate={post.data.pubDate}
                        />
                    ))}
                </div>
                <div class="home-section-footer">
                    <a href="/bookshelf/" class="home-section-cta">Browse the shelf</a>
                </div>
            </section>

        </div>
    </div>

    <div class="grid-span-full home-footer-spacer" aria-hidden="true"></div>
</Layout>

<style>
    :global(.twelve-grid) {
        --grid-row-gap: 0;
    }

    /* ── Book + About sections (display: contents — children live in the parent grid) ── */

    .home-section {
        display: contents;
    }

    .home-book__cover,
    .home-book__content {
        padding-block: clamp(2.5rem, 6vw, 4rem);
    }

    .home-book__cover {
        display: flex;
        justify-content: center;
    }

    .home-book__title {
        font-size: clamp(1.75rem, 5vw, 2.25rem);
        text-align: center;
    }

    .home-book__content {
        display: flex;
        flex-direction: column;
        gap: clamp(1.75rem, 4vw, 2.5rem);
    }

    .home-about__image,
    .home-about__content {
        padding-block: clamp(2rem, 5vw, 3.75rem);
    }

    .home-about__content {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    @media (min-width: 48rem) {
        .home-book__cover {
            justify-content: flex-start;
            padding-right: clamp(1.25rem, 3vw, 2.5rem);
        }

        .home-book__content {
            text-align: left;
        }

        .home-about__content {
            text-align: left;
        }
    }

    @media (max-width: 47.99rem) {
        .home-book__cover,
        .home-about__image {
            margin-bottom: clamp(1.5rem, 5vw, 2rem);
        }
    }

    /* ── Two-column content layout ── */

    .home-content-columns {
        padding-block: clamp(2rem, 5vw, 3.5rem);
        display: flex;
        flex-direction: column;
        gap: clamp(3rem, 6vw, 4rem);
    }

    @media (min-width: 48rem) {
        .home-content-columns {
            display: grid;
            grid-template-columns: 7fr 5fr;
            gap: clamp(1.5rem, 3vw, 2.5rem);
            align-items: start;
        }
    }

    .home-col {
        display: flex;
        flex-direction: column;
        gap: clamp(2.5rem, 5vw, 3.5rem);
    }

    /* ── Section blocks (Garden, Stream, Nordletter, Bookshelf) ── */

    .home-section-block {
        display: flex;
        flex-direction: column;
        gap: clamp(1.25rem, 3vw, 1.75rem);
    }

    .home-section-header {
        display: flex;
        align-items: center;
    }

    .home-section-title {
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 700;
        margin: 0;
        color: rgb(var(--color-text-primary));
    }

    .home-section-footer {
        display: flex;
    }

    .home-section-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-weight: 600;
        font-size: 0.95rem;
        color: rgb(var(--color-text-primary));
        text-decoration: none;
        border-bottom: 1px solid rgba(var(--color-text-primary), 0.2);
        padding-bottom: 0.15rem;
        transition: color 0.2s ease, border-color 0.2s ease;
    }

    .home-section-cta:hover,
    .home-section-cta:focus-visible {
        border-bottom-color: rgba(var(--color-text-primary), 0.45);
    }

    .home-section-cta:focus-visible {
        outline: 2px solid rgb(var(--color-accent));
        outline-offset: 2px;
    }

    .home-section-cta::after {
        content: '→';
        font-size: 0.95em;
        transition: transform 0.2s ease;
    }

    .home-section-cta:hover::after,
    .home-section-cta:focus-visible::after {
        transform: translateX(0.2rem);
    }

    /* Garden grid: cap at 2 columns inside the left column */
    @media (min-width: 64rem) {
        .home-col--main :global([data-garden-grid]) {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* ── Nordletter list ── */

    .home-nordletter-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: clamp(0.6rem, 1.5vw, 0.85rem);
    }

    .home-nordletter-item {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        padding: clamp(0.75rem, 2vw, 1rem);
        background: rgba(0, 0, 0, 0.02);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 0.75rem;
        transition: background 180ms ease, border-color 180ms ease, transform 220ms ease, box-shadow 220ms ease;
    }

    :global(.dark) .home-nordletter-item {
        background: rgba(255, 255, 255, 0.03);
        border-color: rgba(255, 255, 255, 0.08);
    }

    .home-nordletter-item:hover {
        background: rgba(99, 102, 241, 0.04);
        border-color: rgba(99, 102, 241, 0.2);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.06), 0 8px 24px rgba(129, 140, 248, 0.15);
        transform: translateY(-2px);
    }

    :global(.dark) .home-nordletter-item:hover {
        background: rgba(99, 102, 241, 0.08);
        border-color: rgba(99, 102, 241, 0.3);
    }

    .home-nordletter-link {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        text-decoration: none;
        color: rgb(var(--color-text-primary));
        font-weight: 600;
        line-height: 1.4;
    }

    .home-nordletter-edition {
        flex-shrink: 0;
        font-size: 0.72rem;
        font-weight: 700;
        color: rgb(var(--color-accent));
        font-variant-numeric: tabular-nums;
    }

    .home-nordletter-title {
        font-size: var(--text-normal);
    }

    .home-nordletter-date {
        font-size: var(--text-small);
        color: rgb(var(--color-text-secondary, 107 114 128));
        padding-left: 0;
    }

    /* ── Bookshelf list ── */

    .home-bookshelf-list {
        display: flex;
        flex-direction: column;
        gap: clamp(0.6rem, 1.5vw, 0.85rem);
    }

    /* ── Footer spacer ── */

    .home-footer-spacer {
        padding-bottom: clamp(2rem, 5vw, 3rem);
    }
</style>
