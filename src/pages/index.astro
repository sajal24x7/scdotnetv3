---
import Layout from '../layouts/Layout.astro';
import { getAllPosts } from '../utils/content';
import { formatDate } from '../utils/date';

const recentPosts = (await getAllPosts())
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 5);
---

<Layout title="Sajal Choudhary" currentPage="/">
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header Section -->
    <div class="py-8 mb-6">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 sm:gap-8">
        <img 
          src="/profile/profile.jpeg" 
          alt="Sajal Choudhary" 
          class="w-32 h-32 sm:w-40 sm:h-40 rounded-full object-cover shadow-lg border-2 border-gray-200 dark:border-gray-600 flex-shrink-0"
        />
        <div class="text-center sm:text-left">
          <h1 class="text-3xl sm:text-4xl font-bold mb-4">Hi, I'm Sajal.</h1>
          <div class="prose dark:prose-invert max-w-none">
            <p class="text-base sm:text-lg">
              I am the author of <a href="/books/a-year-of-mornings/" class="text-accent hover:text-accent/80">A Year of Mornings (2025)</a>, a collection of poems for young adults.
            </p>
            <p class="text-base sm:text-lg mb-0">
              In my day job, I work as an assistant consultant at TCS. 
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Featured Book Section -->
    <div class="border-t border-black/10 dark:border-white/10 py-8">
      <div class="flex flex-col lg:flex-row items-start gap-8">
        <!-- Book Cover -->
        <div class="flex-shrink-0">
          <img 
            src="/books/01-ayom.jpg" 
            alt="A Year of Mornings by Sajal Choudhary cover image"
            class="w-32 h-auto lg:w-40 rounded-lg shadow-lg border border-gray-200 dark:border-gray-600"
          />
        </div>
        
        <!-- Book Details -->
        <div class="flex-1">
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">Out now!</p>
          <h2 class="text-2xl font-bold mb-3">
            <a href="/books/a-year-of-mornings/" class="text-accent hover:text-accent/80 transition-colors">
              A Year of Mornings
            </a>
          </h2>
          <p class="text-base text-gray-700 dark:text-gray-300 mb-4">
            A collection of fifty love poems that follows a young heart as it finds love, 
            finds the strength to be in love and finally, finds the strength to let go.
          </p>
        </div>
      </div>
    </div>

    <!-- Newsletter Section -->
    <div class="border-t border-black/10 dark:border-white/10 py-8">
      <div class="prose dark:prose-invert max-w-none">
        <h2 class="text-2xl font-bold mb-4">NordLetter</h2>
        <p class="text-base mb-6">
          I send out a newsletter once a week about living in Finland + five interesting things I've found on the open web.
        </p>
        
        <form
          class="flex flex-col sm:flex-row gap-3 max-w-md"
          action="https://buttondown.com/api/emails/embed-subscribe/sajal24x7"
          method="post"
          target="popupwindow"
          onsubmit="window.open('https://buttondown.com/sajal24x7', 'popupwindow')"
        >
          <input
            type="email"
            name="email"
            placeholder="Enter your email"
            required
            class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
          <button
            type="submit"
            class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors font-medium"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>

    <!-- Blog Section -->
    <div class="py-8 border-t border-black/10 dark:border-white/10">
      <div class="prose dark:prose-invert max-w-none">
        <p class="text-base mb-6">
          This is my home on the web. There are two main sections here: <a href="/notes/" class="hover:text-accent transition-colors">notes</a> and <a href="/ephemera/" class="hover:text-accent transition-colors">ephemera</a>.
          Notes are things that would (I hope) stand the test of time. Ephemera are things that are in the moment.
        </p>
      </div>
    </div>

    <!-- Recent Posts Section -->
    <div class="border-t border-black/10 dark:border-white/10 py-8">
      <h2 class="text-2xl font-bold mb-6">Recent Posts</h2>
      <div class="space-y-4">
        {recentPosts.map((post) => (
          <div class="flex items-start gap-4">
            <time datetime={post.data.pubDate.toISOString()} class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">
              {formatDate(post.data.pubDate)}
            </time>
            <div class="flex-1 min-w-0">
              <a href={`/${post.data.category}/${post.slug}`} class="text-lg hover:text-blue-600 dark:hover:text-blue-400 block">
                {post.data.title}
                <span class="text-sm text-gray-400 dark:text-gray-500 font-normal ml-2">· {post.data.category}</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Directory/Footer Section -->
    <div class="py-8 border-t border-black/10 dark:border-white/10">
      <div class="prose dark:prose-invert max-w-none">
        <p class="text-sm text-textSecondary dark:text-textSecondaryDark mb-6">
          I have written a lot of things on the internet since 2012. Here's a directory of what's available on this website.
        </p>
        
        <div>
          <h4 class="font-medium mb-3 text-base">Basics</h4>
          <ul class="space-y-2 text-textSecondary dark:text-textSecondaryDark">
            <li><a href="/about/" class="hover:text-accent transition-colors">About Me</a></li>
            <li><a href="/now/" class="hover:text-accent transition-colors">What I'm Doing Now</a></li>
          </ul>
        </div>

        <div class="grid sm:grid-cols-2 gap-8 text-sm mt-8">
          <div>
            <h4 class="font-medium mb-3 text-base">Writing</h4>
            <ul class="space-y-2 text-textSecondary dark:text-textSecondaryDark">
              <li><a href="/notes/" class="hover:text-accent transition-colors">Digital Garden</a></li>
              <li><a href="/blog/" class="hover:text-accent transition-colors">Blog Posts</a></li>
              <li><a href="/stories/" class="hover:text-accent transition-colors">Short Stories</a></li>
              <li><a href="/poems/" class="hover:text-accent transition-colors">Poems</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>