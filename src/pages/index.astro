---
import Layout from '../layouts/Layout.astro';
import BookShowcase from '../components/ui/BookShowcase.astro';
import NewsletterSignup from '../components/ui/NewsletterSignup.astro';
import HomeTwoRowGrid from '../components/layout/HomeTwoRowGrid.astro';
import ResponsiveContentGrid from '../components/content/ResponsiveContentGrid.astro';
import PostList from '../components/content/PostList.astro';
import BookList from '../components/content/BookList.astro';
import FictionGrid from '../components/content/FictionGrid.astro';
import { getAllPosts, transformPost } from '../utils/content';


// Get all posts
const allPosts = await getAllPosts();

// Recent garden posts (evergreen, til, now categories)
const recentGarden = allPosts
  .filter(post => ['evergreen', 'til', 'now'].includes(post.data.category))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 8)
  .map(transformPost);

// Stream posts (blog, micro, photo categories)
const streamPosts = allPosts
  .filter(post => ['blog', 'micro', 'photo'].includes(post.data.category))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 8);

// Recent bookshelf posts
const recentBooks = allPosts
  .filter(post => post.data.category === 'bookshelf')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 8);

// Recent prose posts (poems and stories combined)
const recentProse = allPosts
  .filter(post => ['poem', 'story'].includes(post.data.category))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 8);

const sections = [
  {
    title: "Recent Posts",
    description: "Latest thoughts and writings",
    href: "/blog/",
    posts: allPosts
      .filter(post => ['blog', 'micro'].includes(post.data.category))
      .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
      .slice(0, 6)
  }
];
---

<Layout 
  title="Sajal Choudhary" 
  currentPage="/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'md',
    centered: true
  }}
>
  <!-- Hero Section -->
  <div class="py-12 mb-8">
    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8 sm:gap-12">
      <!-- Larger circular photo on the left -->
      <img 
        src="/profile/profile.jpeg" 
        alt="Sajal Choudhary" 
        class="w-56 h-56 sm:w-72 sm:h-72 rounded-full object-cover shadow-lg flex-shrink-0"
      />
      
      <!-- Bio and newsletter signup on the right -->
      <div class="text-center sm:text-left flex-1">
        <h1 class="text-huge font-bold mb-4">Sajal Choudhary</h1>
        <div class="prose dark:prose-invert max-w-none">
          <p class="text-normal leading-relaxed">
            I am a platform engineer and a writer based in Finland.<br />I am the author of <a href='/books/a-year-of-mornings/' class='text-accent hover:text-accent/80'>A Year of Mornings</a>, a collection of poems for young adults.<br />
          </p>
        </div>
        
        <!-- Social Media Links for Bridgy verification (hidden) -->
        <div class="sr-only">
          <a href="https://mastodon.social/@sajal24x7" rel="me">Mastodon</a>
          <a href="https://bsky.app/profile/sajal24x7.bsky.social" rel="me">Bluesky</a>
          <a href="https://github.com/sajal24x7" rel="me">GitHub</a>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
    <BookShowcase
      bookTitle="A Year of Mornings"
      bookLink="/books/a-year-of-mornings/"
      bookCoverSrc="/books/01-ayom.jpg"
      bookCoverAlt="A Year of Mornings - Book Cover"
      bookDescription="A collection of fifty love poems that follows a young heart as it finds love, finds the strength to be in love and finally, finds the strength to let go."
    />
    <NewsletterSignup />
  </div>

  <HomeTwoRowGrid>
    <ResponsiveContentGrid
      slot="topLeft"
      posts={recentGarden}
      columns={2}
      layout="grid"
      gap="md"
    />
    <PostList
      slot="topRight"
      posts={streamPosts}
      mode="list"
      showCategory={true}
      compact={true}
      maxPosts={8}
    />
    <FictionGrid
      slot="bottomLeft"
      posts={recentProse}
      maxPosts={8}
    />
    <BookList
      slot="bottomRight"
      posts={recentBooks}
      maxPosts={8}
    />
  </HomeTwoRowGrid>

  <div class="py-12"></div>
</Layout>