---
import Layout from '../layouts/Layout.astro';
import BookShowcase from '../components/ui/BookShowcase.astro';
import NewsletterSignup from '../components/ui/NewsletterSignup.astro';
import RecentItems from '../components/RecentItems.astro';
import FeaturedPosts from '../components/content/FeaturedPosts.astro';
import { getAllPosts, getPostsByCategory, transformPost } from '../utils/content';


// Get all posts
const allPosts = await getAllPosts();

// Build a list of the most recent posts across all categories
const sortedPosts = [...allPosts].sort((a, b) => {
  const aTime = new Date(a.data.pubDate).getTime();
  const bTime = new Date(b.data.pubDate).getTime();
  return bTime - aTime;
});

const recentPostsRaw = sortedPosts.slice(0, 8);
const recentPosts = recentPostsRaw.map(transformPost);

// Collect featured stories that lean on long-form writing and visuals
const featuredSource = getPostsByCategory(allPosts, ['evergreen', 'story', 'poem', 'blog'], { limit: 12 });
const recentSlugs = new Set(recentPostsRaw.map((post) => post.slug));
const prioritizedFeatured = featuredSource
  .filter((post) => !recentSlugs.has(post.slug))
  .sort((a, b) => {
    const aHasImage = a.data?.image ? 1 : 0;
    const bHasImage = b.data?.image ? 1 : 0;
    if (aHasImage !== bHasImage) {
      return bHasImage - aHasImage;
    }
    const aTime = new Date(a.data.pubDate).getTime();
    const bTime = new Date(b.data.pubDate).getTime();
    return bTime - aTime;
  });

const featuredPosts = prioritizedFeatured.slice(0, 6).map(transformPost);
---

<Layout
  title="Sajal Choudhary"
  currentPage="/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'md',
    centered: true
  }}
  allPosts={allPosts}
  enableSearchModal
  enableLinkHoverEffect
>
  <!-- Hero Section -->
  <div class="py-12 mb-8">
    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8 sm:gap-12">
      <!-- Larger circular photo on the left -->
      <img 
        src="/profile/profile.jpeg" 
        alt="Sajal Choudhary" 
        class="w-56 h-56 sm:w-72 sm:h-72 rounded-full object-cover shadow-lg flex-shrink-0"
      />
      
      <!-- Bio and newsletter signup on the right -->
      <div class="text-center sm:text-left flex-1">
        <h1 class="text-huge font-bold mb-4">Sajal Choudhary</h1>
        <div class="prose dark:prose-invert max-w-none">
          <p class="text-normal leading-relaxed">
            I am a platform engineer and a writer based in Finland.<br />I am the author of <a href='/books/a-year-of-mornings/' class='text-accent hover:text-accent/80'>A Year of Mornings</a>, a collection of poems for young adults.<br />
          </p>
        </div>
        
        <!-- Social Media Links for Bridgy verification (hidden) -->
        <div class="sr-only">
          <a href="https://mastodon.social/@sajal24x7" rel="me">Mastodon</a>
          <a href="https://bsky.app/profile/sajal24x7.bsky.social" rel="me">Bluesky</a>
          <a href="https://github.com/sajal24x7" rel="me">GitHub</a>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
    <BookShowcase
      bookTitle="A Year of Mornings"
      bookLink="/books/a-year-of-mornings/"
      bookCoverSrc="/books/01-ayom.jpg"
      bookCoverAlt="A Year of Mornings - Book Cover"
      bookDescription="A collection of fifty love poems that follows a young heart as it finds love, finds the strength to be in love and finally, finds the strength to let go."
    />
    <NewsletterSignup />
  </div>

  <section class="mb-16">
    <RecentItems posts={recentPosts} title="Recently" />
  </section>

  <section class="mb-16">
    <FeaturedPosts posts={featuredPosts} title="Featured" />
  </section>
</Layout>
