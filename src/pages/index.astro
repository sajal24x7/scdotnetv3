---
import Layout from '../layouts/Layout.astro';
import NewsletterSignup from '../components/ui/NewsletterSignup.astro';
import UnifiedFeed from '../components/layout/UnifiedFeed.astro';
import { Image } from 'astro:assets';
import BookCover from '../images/books/01-ayom.jpg';
import ProfileImage from '../images/profile/profile.jpeg';
import { getAllPosts } from '../utils/content';
import { getFeedEntriesForGroup, FEED_PAGE_SIZE } from '../utils/feed';

// Get all posts
const allPosts = await getAllPosts();

// First page of the unified feed; the rest loads client-side from /api/feed/
const feedEntries = await getFeedEntriesForGroup(allPosts, 'all');
const initialEntries = feedEntries.slice(0, FEED_PAGE_SIZE);
const hasMoreEntries = feedEntries.length > FEED_PAGE_SIZE;
---

<Layout
    title="Sajal Choudhary"
    currentPage="/"
    pageWrapper={{
        maxWidth: 'full',
        padding: 'none',
        centered: false,
        className: 'contents',
        grid: {
            gap: 'loose',
            padding: 'narrow'
        }
    }}
    allPosts={allPosts}
    enableLinkHoverEffect
>
    <!-- About + Newsletter Section -->
    <section class="home-section home-section--about">
        <figure class="grid-span-4 home-about__image flex justify-center md:justify-start">
            <Image
                src={ProfileImage}
                alt="Sajal Choudhary"
                class="w-56 h-56 sm:w-64 sm:h-64 lg:w-72 lg:h-72 rounded-full object-cover shadow-lg"
            />
        </figure>
        <div class="grid-span-8 home-about__content space-y-6 text-center md:text-left">
            <div class="prose dark:prose-invert max-w-none">
                <h1 class="text-huge font-bold">Sajal Choudhary</h1>
                <p class="text-normal leading-relaxed">I am a platform engineer and a writer based in Finland.</p>
            </div>
            <NewsletterSignup wrapperClass="py-0" formClass="mx-auto md:mx-0" />

            <!-- Social Media Links for Bridgy verification (hidden) -->
            <div class="sr-only">
                <a href="https://mastodon.social/@sajal24x7" rel="me">Mastodon</a>
                <a href="https://bsky.app/profile/sajal24x7.bsky.social" rel="me">Bluesky</a>
                <a href="https://github.com/sajal24x7" rel="me">GitHub</a>
            </div>
        </div>
    </section>

    <!-- Book Section: collapsed to a single line by default -->
    <details class="grid-span-full home-book-disclosure">
        <summary class="home-book-disclosure__summary">
            <svg class="home-book-disclosure__chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M6 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span>Also, I write poetry — my book <strong>A Year of Mornings</strong> is out now.</span>
        </summary>
        <div class="home-book-disclosure__body">
            <figure class="home-book-disclosure__cover">
                <Image
                    src={BookCover}
                    alt="A Year of Mornings - Book Cover"
                    class="w-full h-auto max-w-[12rem] mx-auto md:mx-0 rounded-xl shadow-lg"
                />
            </figure>
            <div class="home-book-disclosure__content">
                <h2 class="text-large font-bold">
                    <a href="/books/a-year-of-mornings/" class="text-accent hover:text-accent/80 transition-colors">
                        A Year of Mornings
                    </a>
                </h2>
                <p class="text-normal text-gray-700 dark:text-gray-300 leading-relaxed">
                    A collection of fifty love poems that follows a young heart as it finds love, finds the strength to be in love and finally, finds the strength to let go.
                </p>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <a
                        href="https://amzn.to/46PLYIL"
                        class="inline-flex items-center justify-center rounded-xl bg-accent px-6 py-3 font-semibold text-white shadow transition-colors hover:bg-accent-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-hover"
                    >
                        Buy on Amazon
                    </a>
                    <a
                        href="https://helmet.finna.fi/Record/helmet.2626433/Versions?sid=5134185916"
                        class="inline-flex items-center justify-center rounded-xl border border-accent px-6 py-3 font-semibold text-accent-hover transition-colors hover:bg-accent/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-hover"
                    >
                        Borrow via Helmet
                    </a>
                </div>
            </div>
        </div>
    </details>

    <!-- Unified Feed Section -->
    <section class="home-section home-section--feed">
        <div class="home-feed grid-span-full">
            <UnifiedFeed entries={initialEntries} hasMore={hasMoreEntries} />
        </div>
    </section>

    <div class="grid-span-full home-footer-spacer" aria-hidden="true"></div>
</Layout>

<style>
    :global(.twelve-grid) {
        --grid-row-gap: 0;
    }

    .home-section {
        display: contents;
    }

    .home-book-disclosure {
        border-top: 1px solid rgba(var(--color-text-primary), 0.12);
        border-bottom: 1px solid rgba(var(--color-text-primary), 0.12);
        padding-block: 1rem;
    }

    .home-book-disclosure__summary {
        list-style: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        cursor: pointer;
        font-size: var(--text-small);
        color: rgb(var(--color-text-secondary));
        text-align: center;
    }

    .home-book-disclosure__summary::-webkit-details-marker {
        display: none;
    }

    .home-book-disclosure__summary:hover {
        color: rgb(var(--color-text-primary));
    }

    .home-book-disclosure__summary:focus-visible {
        outline: 2px solid rgb(var(--color-accent));
        outline-offset: 4px;
        border-radius: 0.3rem;
    }

    .home-book-disclosure__chevron {
        width: 0.85rem;
        height: 0.85rem;
        flex-shrink: 0;
        transition: transform 0.2s ease;
        color: rgb(var(--color-accent-hover));
    }

    .home-book-disclosure[open] .home-book-disclosure__chevron {
        transform: rotate(90deg);
    }

    .home-book-disclosure__body {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        padding-top: 1.5rem;
        text-align: center;
    }

    .home-book-disclosure__content {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        align-items: center;
    }

    .home-about__image,
    .home-about__content {
        padding-block: clamp(2rem, 5vw, 3.75rem);
    }

    .home-about__content {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .home-section--feed {
        display: contents;
    }

    .home-feed {
        display: flex;
        padding-block: clamp(2rem, 5vw, 3.5rem);
        border-top: 1px solid rgba(var(--color-text-primary), 0.12);
        margin-top: clamp(1rem, 3vw, 2rem);
    }

    .home-footer-spacer {
        padding-bottom: clamp(2rem, 5vw, 3rem);
    }

    @media (min-width: 48rem) {
        .home-feed {
            grid-column: 2 / span 10;
            padding-block: clamp(2.5rem, 5vw, 4rem);
        }

        .home-about__content {
            text-align: left;
        }

        .home-book-disclosure__summary {
            justify-content: flex-start;
            text-align: left;
        }

        .home-book-disclosure__body {
            flex-direction: row;
            align-items: flex-start;
            text-align: left;
        }

        .home-book-disclosure__content {
            align-items: flex-start;
        }

        .home-book-disclosure__cover {
            flex-shrink: 0;
        }
    }

    @media (max-width: 47.99rem) {
        .home-about__image {
            margin-bottom: clamp(1.5rem, 5vw, 2rem);
        }
    }
</style>
