---
import Layout from '../../layouts/Layout.astro';
import GardenGrid from '../../components/layout/GardenGrid.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import { getAllPosts, transformPost } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';

// Get all posts and filter for stories
const allPosts = await getAllPosts();
const stories = allPosts
  .filter(post => post.data.category === 'story')
  .sort((a, b) => new Date(b.data.created).getTime() - new Date(a.data.created).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = stories.map(transformPost);
const storyCount = transformedPosts.length;
const storyCountText = `${storyCount} ${storyCount === 1 ? 'story' : 'stories'}`;

const sectionLandingProps = createSectionLandingProps(
  {
    title: 'Stories',
    description: 'Short stories and fiction pieces.',
    countText: storyCountText,
    tagCategory: 'story',
    tagPosts: allPosts,
    contentClass: 'section-content--as-grid',
    rssUrl: '/story/rss.xml'
  },
  'plainCount'
);
---

<Layout
  title="Stories"
  description="Short stories and fiction"
  currentPage="/stories/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
    <SectionLanding {...sectionLandingProps}>
      <GardenGrid posts={transformedPosts} contentType="stories" />
    </SectionLanding>
  </Layout>
