---
import Layout from '../../layouts/Layout.astro';
import ResponsiveGrid from '../../components/ResponsiveGrid.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for stories
const allPosts = await getAllPosts();
const stories = allPosts
  .filter(post => post.data.category === 'story')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ResponsiveGrid component
const transformedPosts = stories.map(transformPost);
---

<Layout 
  title="Stories" 
  description="Short stories and fiction" 
  currentPage="/stories/"
>
  <div class="stories-container">
    <header class="stories-header">
      <div class="header-content">
        <h1 class="stories-title">Stories</h1>
        <p class="stories-description">
          Short stories and fiction pieces.
        </p>
        <div class="stories-count">
          {transformedPosts.length} {transformedPosts.length === 1 ? 'story' : 'stories'}
        </div>
        <a 
          href="/stories/tags" 
          class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
        >
          View entries by tag
        </a>
      </div>
    </header>

    <main class="stories-main">
      <ResponsiveGrid posts={transformedPosts} />
    </main>
  </div>
</Layout>

<style>
  .stories-container {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .stories-header {
    padding: 1.5rem 0 1rem;
    text-align: center;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 1.5rem;
  }

  :global(.dark) .stories-header {
    border-bottom-color: #374151;
  }

  .header-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .stories-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 0.5rem;
    color: #111827;
  }

  :global(.dark) .stories-title {
    color: #f9fafb;
  }

  .stories-description {
    font-size: 1rem;
    line-height: 1.5;
    color: #6b7280;
    margin-bottom: 1rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  :global(.dark) .stories-description {
    color: #9ca3af;
  }

  .stories-count {
    font-size: 0.875rem;
    font-weight: 500;
    color: #8b5cf6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  :global(.dark) .stories-count {
    color: #a78bfa;
  }

  .stories-main {
    padding-bottom: 2rem;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .stories-container {
      max-width: none;
      padding: 0;
    }

    .stories-header {
      padding: 1rem 1rem 0.75rem;
      margin-bottom: 1rem;
    }

    .stories-title {
      font-size: 2rem;
    }

    .stories-description {
      font-size: 0.95rem;
      margin-bottom: 0.75rem;
    }

    .stories-main {
      padding-bottom: 1.5rem;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 768px) and (max-width: 1024px) {
    .stories-container {
      max-width: 95vw;
      padding: 0 1.5rem;
    }

    .stories-title {
      font-size: 2.25rem;
    }
  }

  /* Desktop adjustments */
  @media (min-width: 1024px) and (max-width: 1440px) {
    .stories-container {
      max-width: 90vw;
      padding: 0 2rem;
    }
  }

  /* Large desktop adjustments */
  @media (min-width: 1440px) and (max-width: 1920px) {
    .stories-container {
      max-width: 85vw;
      padding: 0 2.5rem;
    }
  }

  /* Extra large screens */
  @media (min-width: 1920px) {
    .stories-container {
      max-width: 80vw;
      padding: 0 3rem;
    }
  }
</style>