---
import { getAllPosts, type Post } from '../utils/content';
import Layout from '../layouts/Layout.astro';
import { formatDate, formatDateRange } from '../utils/dateFormat';
import PageHeader from '../components/layout/PageHeader.astro';
import LayoutContainer from '../components/layout/LayoutContainer.astro';
import { parseMarkdown } from '../utils/markdown';
import '../styles/progress-page.css';

// Get all posts dynamically across year folders and filter to category 'now' and status 'done'
const allPosts = await getAllPosts();
const doneNowPosts = allPosts
  .filter(post => post.data.category === 'now' && post.data.status === 'done')
  .sort((a, b) => {
    // Sort by updatedDate (end date) descending, fallback to pubDate if no updatedDate
    const aDate = a.data.updatedDate || a.data.pubDate;
    const bDate = b.data.updatedDate || b.data.pubDate;
    return bDate.getTime() - aDate.getTime();
  });

// Pre-render markdown content
type DonePost = Post & {
  endDate: Date;
  renderedContent: string | null;
};

const renderedPosts: DonePost[] = doneNowPosts.map(post => {
    const rawEndDate = post.data.updatedDate ?? post.data.pubDate;
    const endDate = rawEndDate instanceof Date ? rawEndDate : new Date(rawEndDate);

    return {
        ...post,
        endDate,
        renderedContent: post.body ? parseMarkdown(post.body) : null
    };
});

const completedCount = renderedPosts.length;
const lastCompletedDate = renderedPosts[0]?.endDate;
const lastCompleted = lastCompletedDate ? formatDate(lastCompletedDate) : null;

const quickLinks = [
    {
        href: '/now/',
        label: 'Check current focus',
        description: 'See what is in motion on the Now page.'
    },
    {
        href: '/stream/',
        label: 'Read recent updates',
        description: 'Browse the stream for detailed write-ups.'
    },
    {
        href: '/bookshelf/',
        label: 'Visit the bookshelf',
        description: 'Track reading notes that influence future work.'
    }
];
---

<Layout
  title="Done - Sajal Choudhary"
  description="Completed tasks and projects that were previously in progress"
  currentPage="/done/"
  pageWrapper={{
        maxWidth: '7xl',
        padding: 'md',
        centered: true,
        className: 'progress-page progress-page--done',
        grid: {
            gap: 'tight',
            padding: 'narrow'
        }
  }}
  allPosts={allPosts}
  enableSearchModal
  enableLinkHoverEffect
>
    <section class="progress-page__layout twelve-grid">
        <header class="progress-page__header grid-span-full">
            <PageHeader
                title="Done"
                description="Completed tasks and projects that were previously in progress. These represent milestones achieved and goals accomplished."
                layout="centered"
                size="lg"
                maxWidth="7xl"
            />
        </header>

        <section class="progress-page__content grid-span-8 grid-start-1">
            <p class="progress-page__intro">
                Looking for active work? Visit the <a href="/now/" class="progress-page__link">Now page</a> to see what's in motion.
            </p>

            {renderedPosts.length > 0 ? (
                <div class="progress-page__list">
                    {renderedPosts.map((post) => (
                        <article class="progress-card">
                            <div class="progress-card__meta">
                                <time
                                    class="progress-card__time"
                                    datetime={post.endDate.toISOString()}
                                >
                                    {formatDateRange(post.data.pubDate, post.endDate)}
                                </time>
                                {post.data.title && (
                                    <h2 class="progress-card__title">{post.data.title}</h2>
                                )}
                            </div>

                            {post.renderedContent && (
                                <LayoutContainer prose maxWidth="full" className="progress-card__body">
                                    <div set:html={post.renderedContent} />
                                </LayoutContainer>
                            )}
                        </article>
                    ))}
                </div>
            ) : (
                <div class="progress-page__empty">
                    <p>No completed tasks yet.</p>
                    <p>
                        Check the <a href="/now/" class="progress-page__link">Now page</a> to see what's currently in progress.
                    </p>
                </div>
            )}
        </section>

        {(completedCount > 0 || quickLinks.length > 0) && (
            <aside class="progress-page__sidebar grid-span-4 grid-start-9">
                {completedCount > 0 && (
                    <div class="progress-sidebar-card">
                        <h2 class="progress-sidebar-card__title">Summary</h2>
                        <dl class="progress-sidebar-card__stats">
                            <div>
                                <dt>Completed items</dt>
                                <dd>{completedCount}</dd>
                            </div>
                            <div>
                                <dt>Last completion</dt>
                                <dd>{lastCompleted ?? '—'}</dd>
                            </div>
                        </dl>
                    </div>
                )}

                {quickLinks.length > 0 && (
                    <div class="progress-sidebar-card">
                        <h2 class="progress-sidebar-card__title">Quick links</h2>
                        <ul class="progress-sidebar-card__links">
                            {quickLinks.map(link => (
                                <li>
                                    <a class="progress-sidebar-card__link" href={link.href}>
                                        <span class="progress-sidebar-card__link-label">{link.label}</span>
                                        <span class="progress-sidebar-card__link-description">{link.description}</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                )}
            </aside>
        )}
    </section>
</Layout>