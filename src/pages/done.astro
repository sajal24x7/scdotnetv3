---
import { getAllPosts } from '../utils/content';
import Layout from '../layouts/Layout.astro';
import { marked } from 'marked';
import TimeDisplay from '../components/TimeDisplay.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import ProseWrapper from '../components/layout/ProseWrapper.astro';

// Configure marked options
marked.setOptions({
  gfm: true, // GitHub Flavored Markdown
  breaks: true // Convert line breaks to <br>
});

// Get all posts dynamically across year folders and filter to category 'now' and status 'done'
const allPosts = await getAllPosts();
const doneNowPosts = allPosts
  .filter(post => post.data.category === 'now' && post.data.status === 'done')
  .sort((a, b) => {
    // Sort by updatedDate (end date) descending, fallback to pubDate if no updatedDate
    const aDate = a.data.updatedDate || a.data.pubDate;
    const bDate = b.data.updatedDate || b.data.pubDate;
    return bDate.getTime() - aDate.getTime();
  });

// Pre-render markdown content
const renderedPosts = doneNowPosts.map(post => ({
  ...post,
  renderedContent: post.body ? marked.parse(post.body) : null
}));
---

<Layout 
  title="Done - Sajal Choudhary" 
  description="Completed tasks and projects that were previously in progress"
  currentPage="/done/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
    <PageHeader 
      title="Done" 
      description="Completed tasks and projects that were previously in progress. These represent milestones achieved and goals accomplished."
      layout="centered"
      size="lg"
      maxWidth="7xl"
    />

    <div class="text-center mb-8">
      <p class="text-gray-600 dark:text-gray-400">
        View <a href="/now/" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">current tasks</a> here.
      </p>
    </div>

    <div class="px-6">
      {renderedPosts.length > 0 ? (
        <div class="grid grid-cols-1 gap-8 py-12">
          {renderedPosts.map((post) => (
            <article class="card bg-transparent dark:bg-transparent rounded-xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:scale-[1.01] border border-gray-100 dark:border-gray-700">
              <div class="p-8">
                <div class="mb-6">
                  <TimeDisplay 
                    date={post.data.updatedDate || post.data.pubDate} 
                    category="now" 
                    format="month-year"
                    className="text-lg font-semibold text-gray-700 dark:text-gray-300"
                  />
                </div>

                {post.renderedContent && (
                  <ProseWrapper maxWidth="full">
                    <div set:html={post.renderedContent} />
                  </ProseWrapper>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="py-12 text-center">
          <p class="text-gray-600 dark:text-gray-400 text-lg">No completed tasks yet.</p>
          <p class="text-gray-500 dark:text-gray-500 mt-2">Check the <a href="/now/" class="text-blue-600 dark:text-blue-400 hover:underline">Now page</a> to see what's currently in progress.</p>
        </div>
      )}
    </div>
</Layout>

<style>
  .grid {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  /* Add a subtle divider between cards */
  .grid > *:not(:last-child) {
    position: relative;
  }

  .grid > *:not(:last-child)::after {
    content: '';
    position: absolute;
    bottom: -1rem;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgb(229 231 235),
      transparent
    );
  }

  :global(.dark) .grid > *:not(:last-child)::after {
    background: linear-gradient(
      to right,
      transparent,
      rgb(55 65 81),
      transparent
    );
  }

  /* Ensure links are properly styled */
  :global(.prose a) {
    color: #3b82f6;
    text-decoration: none;
    transition: color 0.2s;
  }

  :global(.prose a:hover) {
    color: #2563eb;
    text-decoration: underline;
  }

  :global(.dark .prose a) {
    color: #60a5fa;
  }

  :global(.dark .prose a:hover) {
    color: #93c5fd;
  }

  /* Additional prose styles for better markdown rendering */
  :global(.prose h1),
  :global(.prose h2),
  :global(.prose h3),
  :global(.prose h4) {
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    font-weight: 600;
  }

  :global(.prose ul),
  :global(.prose ol) {
    margin-top: 0.5em;
    margin-bottom: 1.5em;
    padding-left: 1.5em;
  }

  :global(.prose li) {
    margin-top: 0.25em;
    margin-bottom: 0.25em;
  }

  :global(.prose blockquote) {
    margin: 1.5em 0;
    padding-left: 1em;
    border-left: 4px solid #e5e7eb;
    font-style: italic;
  }

  :global(.dark .prose blockquote) {
    border-left-color: #374151;
  }

  :global(.prose code) {
    background-color: #f3f4f6;
    padding: 0.2em 0.4em;
    border-radius: 0.25em;
    font-size: 0.875em;
  }

  :global(.dark .prose code) {
    background-color: #1f2937;
  }

  :global(.prose pre) {
    background-color: #f3f4f6;
    padding: 1em;
    border-radius: 0.5em;
    overflow-x: auto;
    margin: 1.5em 0;
  }

  :global(.dark .prose pre) {
    background-color: #1f2937;
  }
</style>