---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { Image } from 'astro:assets';
import ProfileImage from '../images/profile/profile.jpeg';
---

<Layout
  title="Sajal Choudhary"
  description="Platform engineer and writer based in Finland"
  currentPage="/sajal/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'about-page',
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  enableSearchModal
  enableLinkHoverEffect
>
  <section class="about-page__layout twelve-grid">
    <header class="grid-span-full about-page__header">
      <PageHeader
        title="Sajal Choudhary"
        layout="centered"
        size="lg"
        maxWidth="7xl"
      />
    </header>

    <section class="about-section twelve-grid grid-gap-tight grid-span-full">
      <figure class="about-image grid-span-5">
        <Image
          src={ProfileImage}
          alt="Sajal Choudhary"
          class="w-full h-auto rounded-lg shadow-lg"
        />
      </figure>
      <div class="about-content grid-span-7 prose dark:prose-dark">
        <p class="text-lg">Hi!</p>
        <p class="text-lg">I'm Sajal. I am a platform engineer and writer based in Finland.</p>
      </div>
    </section>
  </section>
</Layout>

<style>
  .about-page__layout {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .about-page__header {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .about-section {
    align-items: start;
  }

  .about-image {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 48rem) {
    .about-image {
      justify-content: flex-start;
    }

    .about-section {
      align-items: center;
    }
  }

  @media (max-width: 47.99rem) {
    .about-image {
      margin-bottom: clamp(1.5rem, 5vw, 2rem);
    }
  }
</style>
