---
import Layout from '../layouts/Layout.astro';
import SectionLanding from '../layouts/SectionLanding.astro';
import { Image } from 'astro:assets';
import ProfileImage from '../images/profile/profile.jpeg';
---

<Layout
  title="Sajal Choudhary"
  description="Platform engineer and writer based in Finland"
  currentPage="/sajal/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  enableLinkHoverEffect
>
  <SectionLanding
    title="Sajal Choudhary"
    layout="centered"
    headerSize="lg"
    headerMaxWidth="7xl"
    contentClass="about-content-wrapper"
  >
    <section class="about-section twelve-grid grid-gap-tight">
      <figure class="about-image grid-span-5">
        <Image
          src={ProfileImage}
          alt="Sajal Choudhary"
          class="w-full h-auto rounded-lg shadow-lg"
        />
      </figure>
      <div class="about-content grid-span-7 prose dark:prose-dark">
        <p class="text-lg">Hi!</p>
        <p class="text-lg">I'm Sajal. I am a platform engineer and writer based in Finland.</p>
      </div>
    </section>
  </SectionLanding>
</Layout>

<style>
  .about-content-wrapper {
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  .about-section {
    align-items: start;
  }

  .about-image {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 48rem) {
    .about-image {
      justify-content: flex-start;
    }

    .about-section {
      align-items: center;
    }
  }

  @media (max-width: 47.99rem) {
    .about-image {
      margin-bottom: clamp(1.5rem, 5vw, 2rem);
    }
  }
</style>
