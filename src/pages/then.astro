---
import { getAllPosts, type Post } from '../utils/content';
import Layout from '../layouts/Layout.astro';
import { formatDateRange } from '../utils/dateFormat';
import LayoutContainer from '../components/layout/LayoutContainer.astro';
import ProgressLayout from '../components/layout/ProgressLayout.astro';
import { parseMarkdown } from '../utils/markdown';
import '../styles/progress-page.css';

// Get all posts dynamically across year folders and filter to category 'now' and status other than 'started'
// (i.e. 'todo', 'paused', and 'finished'), sorted by most recently touched first
const allPosts = await getAllPosts();
const thenNowPosts = allPosts
  .filter(post => post.data.category === 'now' && post.data.status && post.data.status !== 'started')
  .sort((a, b) => {
    // Sort by updated (end date) descending, fallback to created if no updated
    const aDate = a.data.updated || a.data.created;
    const bDate = b.data.updated || b.data.created;
    return bDate.getTime() - aDate.getTime();
  });

// Pre-render markdown content
type ThenPost = Post & {
  endDate: Date;
  renderedContent: string | null;
};

const renderedPosts: ThenPost[] = thenNowPosts.map(post => {
    const rawEndDate = post.data.updated ?? post.data.created;
    const endDate = rawEndDate instanceof Date ? rawEndDate : new Date(rawEndDate);

    return {
        ...post,
        endDate,
        renderedContent: post.body ? parseMarkdown(post.body) : null
    };
});

---

<Layout
  title="Then"
  description="Paused and completed tasks and projects that were previously in progress"
  currentPage="/now/"
  pageWrapper={{
        maxWidth: '7xl',
        padding: 'none',
        centered: true,
        className: 'progress-page progress-page--then',
        grid: {
            gap: 'loose',
            padding: 'narrow'
        }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
    <ProgressLayout
        pageTitle="Then"
        pageDescription="Tasks and projects that are no longer active — paused for later, or completed."
        hasItems={renderedPosts.length > 0}
        togglePage="then"
    >
        {renderedPosts.map((post) => (
            <article class="progress-card">
                <div class="progress-card__meta">
                    <div class="progress-card__meta-row">
                        <time
                            class="progress-card__time"
                            datetime={post.endDate.toISOString()}
                        >
                            {formatDateRange(post.data.created, post.endDate)}
                        </time>
                        <span class={`progress-card__status progress-card__status--${post.data.status}`}>
                            {post.data.status === 'paused' ? 'Paused' : post.data.status === 'todo' ? 'Not Started' : 'Done'}
                        </span>
                    </div>
                    {post.data.title && (
                        <h2 class="progress-card__title">{post.data.title}</h2>
                    )}
                </div>

                {post.renderedContent && (
                    <LayoutContainer prose maxWidth="full" className="progress-card__body">
                        <div set:html={post.renderedContent} />
                    </LayoutContainer>
                )}
            </article>
        ))}

        <div slot="empty" class="progress-page__empty">
            <p>No paused or completed tasks yet.</p>
            <p>
                Check the <a href="/now/" class="progress-page__link">Now page</a> to see what's currently in progress.
            </p>
        </div>
    </ProgressLayout>
</Layout>
