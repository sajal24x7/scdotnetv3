---
import Layout from '../../layouts/Layout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import GameCard from '../../components/shelf/GameCard.astro';
import ShelfTabNav from '../../components/shelf/ShelfTabNav.astro';
import { getAllPosts } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';
import { computeWatchNumbers } from '../../utils/shelfUtils';

const allPosts = await getAllPosts();
const gamePosts = allPosts.filter((post) => post.data.category === 'gameshelf');

const parseDate = (value?: Date | string | null): Date | null => {
    if (!value) return null;
    const d = value instanceof Date ? value : new Date(value);
    return Number.isNaN(d.getTime()) ? null : d;
};

const getGameYear = (post: typeof gamePosts[number]): number => {
    const started = parseDate(post.data.started);
    if (started) return started.getFullYear();
    const pub = parseDate(post.data.created);
    return (pub ?? new Date()).getFullYear();
};

const compareDesc = (a?: Date | string | null, b?: Date | string | null) => {
    const toTime = (v?: Date | string | null) => {
        if (!v) return 0;
        const d = v instanceof Date ? v : new Date(v);
        return Number.isNaN(d.getTime()) ? 0 : d.getTime();
    };
    return toTime(b) - toTime(a);
};

const statusOrder: Record<string, number> = {
    playing: 0,
    played: 1,
    'on-hold': 2,
    other: 3
};

const gamesWithYear = gamePosts.map((post) => ({
    post,
    year: getGameYear(post)
}));

const sortedGames = [...gamesWithYear].sort((a, b) => {
    if (a.year !== b.year) return b.year - a.year;
    const statusA = a.post.data.shelfStatus ?? 'other';
    const statusB = b.post.data.shelfStatus ?? 'other';
    if (statusA !== statusB) {
        return (statusOrder[statusA] ?? statusOrder.other) - (statusOrder[statusB] ?? statusOrder.other);
    }
    return compareDesc(a.post.data.created, b.post.data.created);
});

const years = Array.from(new Set(sortedGames.map((e) => e.year)));

const gamesByYear = sortedGames.reduce((acc, { year, post }) => {
    if (!acc[year]) acc[year] = [];
    acc[year].push(post);
    return acc;
}, {} as Record<number, typeof gamePosts>);

// Compute replay numbers
const allGameEntries = sortedGames.map((e) => ({
    title: e.post.data.title ?? '',
    date: e.post.data.created
}));
const watchNumbers = computeWatchNumbers(allGameEntries);
const watchNumberMap = new Map<string, number>();
sortedGames.forEach((entry, i) => {
    watchNumberMap.set(entry.post.id, watchNumbers.get(i) ?? 1);
});

// Count played games
const playedGames = gamePosts.filter((p) => p.data.shelfStatus === 'played');
const totalGames = playedGames.length;
const countText = `${totalGames} ${totalGames === 1 ? 'game' : 'games'} played`;

const gameDescription = "Games I've played, am playing, or want to play—organized by year.";

const sectionLandingProps = createSectionLandingProps({
    title: 'Game Shelf',
    countText,
    countVariant: 'plain',
    countClass: 'bookshelf-count',
    tagCategory: 'gameshelf',
    tagPosts: allPosts,
    contentClass: 'bookshelf-content',
    hideTitle: true
});
---

<Layout
  title="Game Shelf"
  description="Games I've played and want to play"
  currentPage="/gameshelf/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: { gap: 'loose', padding: 'narrow' }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
  <SectionLanding {...sectionLandingProps}>
    <div slot="afterHeader" class="shelf-header-block">
      <div class="shelf-title-row">
        <ShelfTabNav currentTab="games" />
        <a href="/gameshelf/rss.xml" class="shelf-rss-link" aria-label="Game Shelf RSS feed" title="Subscribe via RSS">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="16" height="16">
            <path d="M3.429 2.857v2.857c9.714 0 17.571 7.857 17.571 17.571h2.857C23.857 13.429 13.286 2.857 3.429 2.857zm0 5.714v2.858c5.143 0 9.286 4.143 9.286 9.285h2.857c0-6.857-5.486-12.343-12.143-12.343zm2.285 7.714c1.257 0 2.286 1.029 2.286 2.286S6.971 20.857 5.714 20.857 3.429 19.828 3.429 18.571s1.028-2.286 2.285-2.286z"/>
          </svg>
        </a>
      </div>
      <p class="shelf-description">{gameDescription}</p>
    </div>
    <div class="bookshelf-years">
      {years.map((year) => {
        const yearGames = gamesByYear[year] ?? [];
        const playedYearGames = yearGames.filter((p) => p.data.shelfStatus === 'played');
        const gameCount = playedYearGames.length;
        const gameLabel = gameCount === 1 ? 'game' : 'games';

        return (
          <section class="bookshelf-year" id={`gameshelf-${year}`} data-year={year}>
            <div class="bookshelf-year__grid twelve-grid grid-gap-tight">
              <div class="bookshelf-year__sidebar grid-span-2">
                <div class="bookshelf-year__sticky">
                  <span class="bookshelf-year__year">{year}</span>
                  <span class="bookshelf-year__count" data-year-count={year}>Played {gameCount} {gameLabel}</span>
                </div>
              </div>
              {yearGames.map((post, index) => {
                const gridClasses = index % 2 === 0 ? 'grid-span-5 grid-start-3' : 'grid-span-5 grid-start-8';
                const watchNumber = watchNumberMap.get(post.id) ?? 1;
                return (
                  <div
                    class={`bookshelf-year__book ${gridClasses}`}
                    data-game-item
                    data-tags={Array.isArray(post.data.tags) ? post.data.tags.join(',') : ''}
                    data-genre={post.data.genre ?? ''}
                    data-developer={post.data.developer ?? ''}
                    data-status={post.data.shelfStatus ?? ''}
                    data-rating={post.data.rating ?? ''}
                    data-platform={post.data.platform ?? ''}
                  >
                    <GameCard
                      title={post.data.title ?? ''}
                      developer={post.data.developer}
                      year={post.data.year as number | undefined}
                      genre={post.data.genre}
                      platform={post.data.platform}
                      hoursPlayed={post.data.hoursPlayed}
                      shelfStatus={post.data.shelfStatus as any}
                      rating={post.data.rating}
                      cover={post.data.cover}
                      link={post.id ? `/gameshelf/${post.id}/` : undefined}
                      watchNumber={watchNumber}
                    />
                  </div>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </SectionLanding>
</Layout>

<style>
  .bookshelf-count { font-size: var(--text-small); font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; color: #6b7280; }
  :global(.dark) .bookshelf-count { color: #9ca3af; }
  .bookshelf-content { display: flex; flex-direction: column; gap: clamp(2rem, 5vw, 3rem); padding-bottom: 2rem; }
  .bookshelf-years { display: flex; flex-direction: column; gap: clamp(2rem, 5vw, 3.5rem); }
  .bookshelf-year[data-filtered="hidden"] { display: none; }
  .bookshelf-year__book[data-filtered="hidden"] { display: none; }
  .bookshelf-year__grid { align-items: flex-start; }
  .bookshelf-year__sidebar { display: flex; }
  @media (min-width: 48rem) { .bookshelf-year__sidebar { grid-row: 1 / -1; } }
  .bookshelf-year__sticky { position: sticky; top: clamp(4rem, 6vw, 5.5rem); display: flex; flex-direction: column; gap: 0.35rem; }
  .bookshelf-year__year { font-size: var(--text-huge); font-weight: 700; color: rgb(var(--color-text-primary)); }
  .bookshelf-year__count { font-size: var(--text-small); font-weight: 500; color: #6b7280; }
  :global(.dark) .bookshelf-year__count { color: #9ca3af; }
  .bookshelf-year__book { display: flex; }
  .bookshelf-year__book :global(.book-card) { width: 100%; }
  @media (max-width: 47.999rem) { .bookshelf-year__sticky { position: static; } }
  @media (min-width: 64rem) { .bookshelf-year__year { font-size: clamp(2.25rem, 4vw, 3.5rem); } }
</style>

<script>
  function initGameshelfFilters() {
    let selectedGenre = '';
    let selectedPlatform = '';
    let selectedRating = '';
    let selectedStatus = '';
    let selectedDeveloper = '';
    let selectedTag = '';

    function hasAnyFilter() {
      return !!(selectedGenre || selectedPlatform || selectedRating || selectedStatus || selectedDeveloper || selectedTag);
    }

    function applyFilters() {
      const allItems = document.querySelectorAll<HTMLElement>('[data-game-item]');
      const yearCounts: Record<string, number> = {};

      allItems.forEach((item) => {
        const genre = item.getAttribute('data-genre') || '';
        const platform = item.getAttribute('data-platform') || '';
        const rating = item.getAttribute('data-rating') || '';
        const status = item.getAttribute('data-status') || '';
        const developer = item.getAttribute('data-developer') || '';
        const tags = (item.getAttribute('data-tags') || '').split(',').filter(Boolean);

        const isVisible =
          (!selectedGenre || genre === selectedGenre) &&
          (!selectedPlatform || platform === selectedPlatform) &&
          (!selectedRating || rating === selectedRating) &&
          (!selectedStatus || status === selectedStatus) &&
          (!selectedDeveloper || developer === selectedDeveloper) &&
          (!selectedTag || tags.includes(selectedTag));

        if (isVisible) {
          item.removeAttribute('data-filtered');
          const yearSection = item.closest<HTMLElement>('[data-year]');
          if (yearSection) {
            const year = yearSection.getAttribute('data-year') || '';
            yearCounts[year] = (yearCounts[year] || 0) + 1;
          }
        } else {
          item.setAttribute('data-filtered', 'hidden');
        }
      });

      const yearSections = document.querySelectorAll<HTMLElement>('[data-year]');
      yearSections.forEach((section) => {
        const year = section.getAttribute('data-year') || '';
        let count = 0;

        if (hasAnyFilter()) {
          count = yearCounts[year] || 0;
        } else {
          section.querySelectorAll<HTMLElement>('[data-game-item]').forEach((item) => {
            if (item.getAttribute('data-status') === 'played') count++;
          });
        }

        if (hasAnyFilter() && count === 0) {
          section.setAttribute('data-filtered', 'hidden');
        } else {
          section.removeAttribute('data-filtered');
          const countEl = section.querySelector(`[data-year-count="${year}"]`);
          if (countEl) {
            const label = count === 1 ? 'game' : 'games';
            countEl.textContent = hasAnyFilter()
              ? `Showing ${count} ${label}`
              : `Played ${count} ${label}`;
          }
        }
      });

      updateFilterBadges();
    }

    function updateFilterBadges() {
      const resultsDisplay = document.getElementById('section-tag-filter-results');
      const activeFiltersContainer = document.getElementById('section-tag-filter-active');
      const filterSummary = document.getElementById('section-tag-filter-summary');

      if (!hasAnyFilter()) {
        if (resultsDisplay) resultsDisplay.setAttribute('hidden', '');
        if (activeFiltersContainer) activeFiltersContainer.innerHTML = '';
        return;
      }

      if (resultsDisplay) resultsDisplay.removeAttribute('hidden');

      const x = '<span aria-hidden="true">×</span>';
      const badges: string[] = [];

      if (selectedGenre)    badges.push(`<button type="button" class="section-tag-filter-badge" data-remove-game-filter="genre">${selectedGenre.toUpperCase()} ${x}</button>`);
      if (selectedPlatform) badges.push(`<button type="button" class="section-tag-filter-badge" data-remove-game-filter="platform">${selectedPlatform.toUpperCase()} ${x}</button>`);
      if (selectedRating)   badges.push(`<button type="button" class="section-tag-filter-badge" data-remove-game-filter="rating">${selectedRating.toUpperCase()} ${x}</button>`);
      if (selectedStatus)   badges.push(`<button type="button" class="section-tag-filter-badge" data-remove-game-filter="status">${selectedStatus.toUpperCase()} ${x}</button>`);
      if (selectedDeveloper) badges.push(`<button type="button" class="section-tag-filter-badge" data-remove-game-filter="developer">${selectedDeveloper} ${x}</button>`);
      if (selectedTag)      badges.push(`<button type="button" class="section-tag-filter-badge" data-remove-game-filter="tag">${selectedTag.toUpperCase()} ${x}</button>`);

      if (badges.length > 1) badges.push(`<button type="button" class="section-tag-filter-badge" data-remove-game-filter="all">Clear all</button>`);

      if (activeFiltersContainer) activeFiltersContainer.innerHTML = badges.join('');

      if (filterSummary) {
        const visibleCount = document.querySelectorAll('[data-game-item]:not([data-filtered])').length;
        const label = visibleCount === 1 ? 'game' : 'games';
        filterSummary.textContent = `Showing ${visibleCount} ${label}`;
      }
    }

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;

      const removeBadge = target.closest<HTMLElement>('[data-remove-game-filter]');
      if (removeBadge) {
        event.preventDefault();
        const key = removeBadge.getAttribute('data-remove-game-filter');
        if (key === 'all') {
          selectedGenre = selectedPlatform = selectedRating = selectedStatus = selectedDeveloper = selectedTag = '';
          const tagList = document.querySelector('tag-list') as any;
          if (tagList?.clearActiveTag) tagList.clearActiveTag();
        } else if (key === 'genre')     { selectedGenre = ''; }
        else if (key === 'platform')    { selectedPlatform = ''; }
        else if (key === 'rating')      { selectedRating = ''; }
        else if (key === 'status')      { selectedStatus = ''; }
        else if (key === 'developer')   { selectedDeveloper = ''; }
        else if (key === 'tag') {
          selectedTag = '';
          const tagList = document.querySelector('tag-list') as any;
          if (tagList?.clearActiveTag) tagList.clearActiveTag();
        }
        applyFilters();
        return;
      }

      const filterTrigger = target.closest<HTMLElement>('[data-filter-type]');
      if (filterTrigger) {
        event.preventDefault();
        const type = filterTrigger.getAttribute('data-filter-type');
        const value = filterTrigger.getAttribute('data-filter-value') || '';

        if (type === 'genre')       selectedGenre     = selectedGenre === value ? '' : value;
        else if (type === 'platform')    selectedPlatform  = selectedPlatform === value ? '' : value;
        else if (type === 'rating')      selectedRating    = selectedRating === value ? '' : value;
        else if (type === 'shelfStatus') selectedStatus    = selectedStatus === value ? '' : value;
        else if (type === 'developer')   selectedDeveloper = selectedDeveloper === value ? '' : value;

        applyFilters();
      }
    });

    document.addEventListener('tagfilter', (event) => {
      selectedTag = (event as CustomEvent).detail?.tag || '';
      applyFilters();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGameshelfFilters);
  } else {
    initGameshelfFilters();
  }
</script>
