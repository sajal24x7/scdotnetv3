---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import TagPage from '../../../components/TagPage.astro';

const years = ['2012', '2013', '2014', '2015', '2016', '2017', '2019', '2021', '2022', '2024', '2025'];

// Get all posts from year collections
const allPosts = await Promise.all(years.map(year => getCollection(year as any)));
const microPosts = allPosts
  .flat()
  .filter((post: any) => post.data.category === 'micro');

// Count tags
const tags = microPosts.reduce((acc: Record<string, number>, post: any) => {
  if (post.data.tags) {
    post.data.tags.forEach((tag: string) => {
      acc[tag] = (acc[tag] || 0) + 1;
    });
  }
  return acc;
}, {} as Record<string, number>);
---

<Layout 
  title="Micro Tags" 
  description="Browse micro updates by tag" 
  currentPage="/micro/"
>
  <TagPage 
    title="Micro Tags" 
    description="Browse micro updates by tag"
    tags={tags}
    currentPage="/micro"
  />
</Layout> 