---
import Layout from '../../layouts/Layout.astro';
import StreamLayout from '../../components/layout/StreamLayout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import { getAllPosts, getPostsByCategory, transformPost } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';

// Get all posts and filter for micro
const allPosts = await getAllPosts();
const microPosts = getPostsByCategory(allPosts, 'micro');

// Transform posts into the shape the card grids expect
const transformedPosts = microPosts.map(transformPost);
const postCount = transformedPosts.length;
const postCountText = `${postCount} ${postCount === 1 ? 'post' : 'posts'}`;

const sectionLandingProps = createSectionLandingProps(
  {
    title: 'Micro',
    description: 'Short thoughts, interesting links, and brief updates—similar to tweets or status updates.',
    countText: postCountText,
    tagCategory: 'micro',
    tagPosts: allPosts,
    contentClass: 'grid-span-8 grid-start-3',
    rssUrl: '/micro/rss.xml'
  },
  'plainCount'
);
---

<Layout
  title="Micro"
  description="Short thoughts, links, and updates"
  currentPage="/micro/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
  <SectionLanding {...sectionLandingProps}>
    <StreamLayout posts={transformedPosts} />
  </SectionLanding>
</Layout>
