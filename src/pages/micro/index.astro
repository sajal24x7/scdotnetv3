---
import Layout from '../../layouts/Layout.astro';
import StreamLayout from '../../components/layout/StreamLayout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import TagList from '../../components/TagList.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for micro
const allPosts = await getAllPosts();
const microPosts = allPosts
  .filter(post => post.data.category === 'micro')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = microPosts.map(transformPost);
---

<Layout
  title="Micro"
  description="Short thoughts, links, and updates"
  currentPage="/micro/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
  allPosts={allPosts}
>
  <SectionLanding
    title="Micro"
    description="Short thoughts, interesting links, and brief updates—similar to tweets or status updates."
    layout="centered"
    size="lg"
    maxWidth="7xl"
  />
  
  <div class="micro-count mb-6 text-center">
    {transformedPosts.length} {transformedPosts.length === 1 ? 'post' : 'posts'}
  </div>

  <!-- TagList for mobile and desktop -->
  <div class="micro-taglist">
    <TagList category="micro" title="Tagged with:" posts={allPosts} />
  </div>

  <main class="micro-main">
    
    <StreamLayout posts={transformedPosts} />
  </SectionLanding>
</Layout>
