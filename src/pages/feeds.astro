---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import RecentItems from '../components/RecentItems.astro';
import { getAllPosts, transformPost } from '../utils/content';

// Get recent posts for preview (more posts for the main section)
const allPosts = await getAllPosts();
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
const recentPosts = sortedPosts.slice(0, 15); // Show more posts

// Transform posts for the RecentItems component
const transformedRecentPosts = recentPosts.map(transformPost);
---

<Layout
  title="RSS Feeds - Sajal Choudhary"
  description="Subscribe to RSS feeds for different types of content"
  currentPage="/feeds/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'md',
    centered: true
  }}
  allPosts={allPosts}
  enableSearchModal
  enableLinkHoverEffect
>
  <section class="feeds-grid page-grid grid-gap-tight grid-span-full">
    <header class="grid-span-full">
      <PageHeader
        title="RSS Feeds"
        description="Subscribe to different feeds based on your interests. All feeds are beautifully styled when viewed in your browser."
        layout="centered"
        size="lg"
        maxWidth="7xl"
      />
    </header>

    <!-- Feed Buttons -->
    <section class="feeds-grid__buttons page-grid grid-gap-tight grid-span-full">
      <a
        href="/rss.xml"
        class="grid-span-3 flex items-center justify-center gap-2 px-4 py-3 bg-white dark:bg-gray-800 border border-borderColor dark:border-borderColorDark rounded-md hover:bg-bgSecondary dark:hover:bg-bgSecondaryDark transition-all duration-200 shadow-sm"
      >
        <svg class="w-4 h-4 opacity-60" fill="currentColor" viewBox="0 0 20 20">
          <path d="M3.429 2.857v2.857c9.714 0 17.571 7.857 17.571 17.571h2.857C23.857 13.429 13.286 2.857 3.429 2.857zm0 5.714v2.858c5.143 0 9.286 4.143 9.286 9.285h2.857c0-6.857-5.486-12.343-12.143-12.343zm2.285 7.714c1.257 0 2.286 1.029 2.286 2.286S6.971 20.857 5.714 20.857 3.429 19.828 3.429 18.571s1.028-2.286 2.285-2.286z" />
        </svg>
        <span>Everything</span>
      </a>

      <a
        href="/garden/rss.xml"
        class="grid-span-3 flex items-center justify-center gap-2 px-4 py-3 bg-white dark:bg-gray-800 border border-borderColor dark:border-borderColorDark rounded-md hover:bg-bgSecondary dark:hover:bg-bgSecondaryDark transition-all duration-200 shadow-sm"
      >
        <svg class="w-4 h-4 opacity-60" fill="currentColor" viewBox="0 0 20 20">
          <path d="M3.429 2.857v2.857c9.714 0 17.571 7.857 17.571 17.571h2.857C23.857 13.429 13.286 2.857 3.429 2.857zm0 5.714v2.858c5.143 0 9.286 4.143 9.286 9.285h2.857c0-6.857-5.486-12.343-12.143-12.343zm2.285 7.714c1.257 0 2.286 1.029 2.286 2.286S6.971 20.857 5.714 20.857 3.429 19.828 3.429 18.571s1.028-2.286 2.285-2.286z" />
        </svg>
        <span>Garden</span>
      </a>

      <a
        href="/stream/rss.xml"
        class="grid-span-3 flex items-center justify-center gap-2 px-4 py-3 bg-white dark:bg-gray-800 border border-borderColor dark:border-borderColorDark rounded-md hover:bg-bgSecondary dark:hover:bg-bgSecondaryDark transition-all duration-200 shadow-sm"
      >
        <svg class="w-4 h-4 opacity-60" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z"
            clip-rule="evenodd"
          />
        </svg>
        <span>Stream</span>
      </a>

      <a
        href="/nordletter/rss.xml"
        class="grid-span-3 flex items-center justify-center gap-2 px-4 py-3 bg-white dark:bg-gray-800 border border-borderColor dark:border-borderColorDark rounded-md hover:bg-bgSecondary dark:hover:bg-bgSecondaryDark transition-all duration-200 shadow-sm"
      >
        <svg class="w-4 h-4 opacity-60" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
          <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
        </svg>
        <span>NordLetter</span>
      </a>
    </section>

    <!-- Recent Posts + About RSS -->
    <section class="feeds-grid__recent page-grid grid-gap-tight grid-span-full border-t border-borderColor dark:border-borderColorDark pt-12">
      <div class="grid-span-8 grid-start-1">
        <RecentItems posts={transformedRecentPosts} title="Recent Posts" showFullContent={false} />
      </div>

      <aside class="grid-span-4 grid-start-9 self-start bg-bgSecondary dark:bg-bgSecondaryDark rounded-lg p-6 border border-borderColor dark:border-borderColorDark">
        <h2 class="text-xl font-semibold mb-3 flex items-center">
          <svg class="w-5 h-5 mr-2 text-accent" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
              clip-rule="evenodd"
            />
          </svg>
          About RSS
        </h2>
        <p class="text-textSecondary dark:text-textSecondaryDark mb-4">
          RSS (Really Simple Syndication) lets you follow websites in your favorite RSS reader.
          When I publish new content, it automatically appears in your reader - no need to check back manually.
        </p>
        <div class="flex flex-wrap gap-2">
          <a
            href="https://aboutfeeds.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-3 py-1 bg-accent bg-opacity-10 text-accent rounded-full text-sm hover:bg-opacity-20 transition-colors"
          >
            Learn about RSS
          </a>
          <a
            href="https://feedly.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-3 py-1 bg-accent bg-opacity-10 text-accent rounded-full text-sm hover:bg-opacity-20 transition-colors"
          >
            Try Feedly
          </a>
          <a
            href="https://netnewswire.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-3 py-1 bg-accent bg-opacity-10 text-accent rounded-full text-sm hover:bg-opacity-20 transition-colors"
          >
            NetNewsWire
          </a>
        </div>
      </aside>
    </section>
  </section>
</Layout>

<style>
  .page-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    column-gap: var(--grid-column-gap);
    row-gap: var(--grid-row-gap);
    padding-inline: var(--grid-padding-inline);
  }

  @media (min-width: 48rem) {
    .page-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
  }

  .feeds-grid {
    padding-block: clamp(2.5rem, 6vw, 3.5rem);
  }
</style>
