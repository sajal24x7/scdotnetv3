---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import RecentItems from '../components/RecentItems.astro';
import { getAllPosts, transformPost } from '../utils/content';
import '../styles/progress-page.css';

// Get recent posts for preview (more posts for the main section)
const allPosts = await getAllPosts();
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.created).valueOf() - new Date(a.data.created).valueOf()
);
const recentPosts = sortedPosts.slice(0, 15); // Show more posts

// Transform posts for the RecentItems component
const transformedRecentPosts = recentPosts.map(transformPost);
---

<Layout
  title="RSS Feeds - Sajal Choudhary"
  description="Subscribe to RSS feeds for different types of content"
  currentPage="/feeds/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'progress-page',
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
  <section class="progress-page__layout twelve-grid feeds-page-layout">
    <header class="grid-span-full progress-page__header feeds-page-header">
      <div class="progress-page__header-content">
        <PageHeader
          title="RSS Feeds"
          layout="centered"
          size="lg"
          maxWidth="7xl"
        />
        <div class="feeds-intro">
          <p>
            RSS lets you follow what I — or anyone you choose — write, without algorithms or ads.
            I use <a href="https://netnewswire.com" target="_blank" rel="noopener noreferrer">NetNewsWire</a> as
            my reader of choice; <a href="https://feedly.com" target="_blank" rel="noopener noreferrer">Feedly</a> is
            another popular option. If you're new to feeds,
            <a href="https://aboutfeeds.com" target="_blank" rel="noopener noreferrer">aboutfeeds.com</a> is
            a good place to start, and this piece on
            <a href="https://www.citationneeded.news/curate-with-rss/" target="_blank" rel="noopener noreferrer">curating your newspaper with feeds</a>
            is well worth reading.
          </p>
        </div>
      </div>
    </header>

    <!-- Subscribe Section -->
    <article class="grid-span-8 grid-start-3 progress-card feed-subscribe-card">
      <div class="progress-card__meta feed-subscribe-header">
        <h2 class="progress-card__title">Subscribe</h2>
      </div>
      <div class="progress-card__body feed-subscribe-body">
        <p class="feeds-subscribe-intro">
          Other than feeds for all the categories, the following curated feeds are available.
        </p>
        <div class="feeds-prose">
          <p>
            The <a href="/rss.xml"><strong>Everything</strong></a> feed is the full firehose — all content published
            across the site, every category, in a single stream. For something narrower,
            <a href="/longform/rss.xml"><strong>Longform</strong></a> brings together the writing that takes more
            than a few minutes to read: blog essays, evergreen notes, and NordLetter issues. If
            you prefer the quicker stuff, the <a href="/stream/rss.xml"><strong>Stream</strong></a> collects
            blog posts, micro-updates, and photos — the things that flow through day to day.
          </p>
          <p>
            <a href="/garden/rss.xml"><strong>Garden</strong></a> is for the slower, more permanent writing:
            evergreen notes, TIL entries, bookshelf logs, stories, and poems — content that tends
            to grow and be tended over time rather than published and forgotten.
            <a href="/prose/rss.xml"><strong>Prose</strong></a> narrows this further to creative writing only —
            stories and poetry. And <a href="/nordletter/rss.xml"><strong>NordLetter</strong></a> is the feed
            for the newsletter archive, published on its own cadence.
          </p>
        </div>
      </div>
    </article>

    <!-- Recent Posts -->
    <section class="grid-span-8 grid-start-3 progress-page__content" style="margin-top: clamp(2rem, 5vw, 3.5rem);">
      <RecentItems posts={transformedRecentPosts} title="Recent Posts" showFullContent={false} showReadMore={false} />
    </section>
  </section>
</Layout>

<style>
  /* Reduce spacing after header */
  .feeds-page-header {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  /* Intro prose below title */
  .feeds-intro {
    margin-top: 1.25rem;
    text-align: center;
  }

  .feeds-intro p {
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    color: rgb(71 85 105);
    max-width: 48rem;
    margin: 0 auto;
    line-height: 1.7;
  }

  :global(.dark) .feeds-intro p {
    color: rgb(var(--color-text-secondary));
  }

  .feeds-intro a {
    color: #7c3aed;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .feeds-intro a:hover {
    color: #6d28d9;
  }

  :global(.dark) .feeds-intro a {
    color: #a78bfa;
  }

  :global(.dark) .feeds-intro a:hover {
    color: #c4b5fd;
  }

  /* Subscribe card */
  .feed-subscribe-card {
    margin-top: clamp(0.5rem, 2vw, 1rem);
  }

  .feed-subscribe-header,
  .feed-subscribe-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .feeds-subscribe-intro {
    font-size: 0.95rem;
    color: rgb(71 85 105);
    margin-bottom: 1.25rem;
    line-height: 1.6;
  }

  :global(.dark) .feeds-subscribe-intro {
    color: rgb(var(--color-text-secondary));
  }

  /* Prose descriptions */
  .feeds-prose {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .feeds-prose p {
    font-size: clamp(0.925rem, 1.8vw, 1rem);
    line-height: 1.75;
    color: rgb(55 65 81);
    margin: 0;
  }

  :global(.dark) .feeds-prose p {
    color: rgb(var(--color-text-secondary));
  }

  .feeds-prose a {
    color: #7c3aed;
    text-decoration: none;
  }

  .feeds-prose a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  :global(.dark) .feeds-prose a {
    color: #a78bfa;
  }

  :global(.dark) .feeds-prose a:hover {
    color: #c4b5fd;
  }

  .feeds-prose strong {
    font-weight: 600;
    color: inherit;
  }
</style>
