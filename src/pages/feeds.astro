---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import RecentItems from '../components/RecentItems.astro';
import { getAllPosts, transformPost } from '../utils/content';
import '../styles/progress-page.css';

// Get recent posts for preview (more posts for the main section)
const allPosts = await getAllPosts();
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
const recentPosts = sortedPosts.slice(0, 15); // Show more posts

// Transform posts for the RecentItems component
const transformedRecentPosts = recentPosts.map(transformPost);
---

<Layout
  title="RSS Feeds - Sajal Choudhary"
  description="Subscribe to RSS feeds for different types of content"
  currentPage="/feeds/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'progress-page',
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  allPosts={allPosts}
  enableSearchModal
  enableLinkHoverEffect
>
  <section class="progress-page__layout twelve-grid">
    <header class="grid-span-full progress-page__header">
      <div class="progress-page__header-content">
        <PageHeader
          title="RSS Feeds"
          description="Subscribe to different feeds based on your interests. All feeds are beautifully styled when viewed in your browser."
          layout="centered"
          size="lg"
          maxWidth="7xl"
        />
      </div>
    </header>

    <!-- About Feeds -->
    <article class="grid-span-full progress-card about-feeds-card">
      <div class="progress-card__meta about-feeds-header">
        <h2 class="progress-card__title">About Feeds</h2>
      </div>
      <div class="progress-card__body about-feeds-body">
        <p class="progress-page__intro" style="margin-bottom: 1.5rem;">
          RSS lets you follow what I (or others that you choose to follow) write. I use NetNewsWire as my reader of choice. There are other options like Feedly for example.
        </p>
        <div class="feeds-buttons">
          <a
            href="https://aboutfeeds.com"
            target="_blank"
            rel="noopener noreferrer"
            class="feeds-button feeds-button--primary"
          >
            Learn more about feeds
          </a>
          <a
            href="https://www.citationneeded.news/curate-with-rss/"
            target="_blank"
            rel="noopener noreferrer"
            class="feeds-button feeds-button--secondary"
          >
            Curating your newspaper with feeds
          </a>
          <a
            href="https://netnewswire.com"
            target="_blank"
            rel="noopener noreferrer"
            class="feeds-button feeds-button--secondary"
          >
            Download NetNewsWire
          </a>
        </div>
      </div>
    </article>

    <!-- Feed Buttons Section -->
    <section class="grid-span-8 grid-start-3 feed-buttons-section">
      <p class="feed-buttons-description">
        This website offers four aptly named feeds - everything/garden/stream/nordletter.
      </p>
      <div class="feed-buttons-grid">
        <a href="/rss.xml" class="feed-button">
          Everything
        </a>
        <a href="/garden/rss.xml" class="feed-button">
          Garden
        </a>
        <a href="/stream/rss.xml" class="feed-button">
          Stream
        </a>
        <a href="/nordletter/rss.xml" class="feed-button">
          NordLetter
        </a>
      </div>
    </section>

    <!-- Recent Posts -->
    <section class="grid-span-8 grid-start-3 progress-page__content" style="margin-top: clamp(2rem, 5vw, 3.5rem);">
      <RecentItems posts={transformedRecentPosts} title="Recent Posts" showFullContent={false} showReadMore={false} />
    </section>
  </section>
</Layout>

<style>
  /* Center-align About Feeds section */
  .about-feeds-card {
    text-align: center;
  }

  .about-feeds-header,
  .about-feeds-body {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .about-feeds-body p {
    text-align: center;
  }

  .feeds-buttons {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.75rem;
    width: 100%;
    max-width: 100%;
    justify-content: center;
  }

  .feeds-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
    text-align: center;
  }

  .feeds-button--primary {
    background: #8b5cf6;
    color: white;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  }

  .feeds-button--primary:hover {
    background: #7c3aed;
    transform: translateY(-1px);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  .feeds-button--primary:focus-visible {
    outline: 2px solid #7c3aed;
    outline-offset: 2px;
  }

  .feeds-button--secondary {
    border: 1px solid #8b5cf6;
    color: #7c3aed;
    background: transparent;
  }

  .feeds-button--secondary:hover {
    background: rgba(139, 92, 246, 0.1);
    transform: translateY(-1px);
  }

  .feeds-button--secondary:focus-visible {
    outline: 2px solid #7c3aed;
    outline-offset: 2px;
  }

  :global(.dark) .feeds-button--secondary {
    color: #a78bfa;
    border-color: #7c3aed;
  }

  :global(.dark) .feeds-button--secondary:hover {
    background: rgba(139, 92, 246, 0.15);
    border-color: #8b5cf6;
  }

  /* Feed Buttons Section */
  .feed-buttons-section {
    text-align: center;
  }

  .feed-buttons-description {
    font-size: 1.05rem;
    color: rgb(71 85 105);
    margin: 0 0 1.5rem 0;
  }

  :global(.dark) .feed-buttons-description {
    color: rgb(148 163 184);
  }

  .feed-buttons-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .feed-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
    background: #8b5cf6;
    color: white;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  }

  .feed-button:hover {
    background: #7c3aed;
    transform: translateY(-1px);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  .feed-button:focus-visible {
    outline: 2px solid #7c3aed;
    outline-offset: 2px;
  }


  @media (min-width: 768px) {
    .feed-buttons-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
