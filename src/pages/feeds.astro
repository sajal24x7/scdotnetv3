---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import RecentItems from '../components/RecentItems.astro';
import { getAllPosts, transformPost } from '../utils/content';
import '../styles/progress-page.css';

// Get recent posts for preview (more posts for the main section)
const allPosts = await getAllPosts();
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
const recentPosts = sortedPosts.slice(0, 15); // Show more posts

// Transform posts for the RecentItems component
const transformedRecentPosts = recentPosts.map(transformPost);
---

<Layout
  title="RSS Feeds - Sajal Choudhary"
  description="Subscribe to RSS feeds for different types of content"
  currentPage="/feeds/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'progress-page',
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  allPosts={allPosts}
  enableSearchModal
  enableLinkHoverEffect
>
  <section class="progress-page__layout twelve-grid">
    <header class="grid-span-full progress-page__header">
      <div class="progress-page__header-content">
        <PageHeader
          title="RSS Feeds"
          description="Subscribe to different feeds based on your interests. All feeds are beautifully styled when viewed in your browser."
          layout="centered"
          size="lg"
          maxWidth="7xl"
        />
      </div>
    </header>

    <!-- About Feeds -->
    <article class="grid-span-8 grid-start-3 progress-card">
      <div class="progress-card__meta">
        <h2 class="progress-card__title">About Feeds</h2>
      </div>
      <div class="progress-card__body">
        <p class="progress-page__intro" style="margin-bottom: 1.5rem;">
          RSS lets you follow what I (or others that you choose to follow) write. I use NetNewsWire as my reader of choice. There are other options like Feedly for example.
        </p>
        <div class="feeds-buttons">
          <a
            href="https://aboutfeeds.com"
            target="_blank"
            rel="noopener noreferrer"
            class="feeds-button feeds-button--primary"
          >
            Learn more about feeds
          </a>
          <a
            href="https://www.citationneeded.news/curate-with-rss/"
            target="_blank"
            rel="noopener noreferrer"
            class="feeds-button feeds-button--secondary"
          >
            Curating your newspaper with feeds
          </a>
          <a
            href="https://netnewswire.com"
            target="_blank"
            rel="noopener noreferrer"
            class="feeds-button feeds-button--secondary"
          >
            Download NetNewsWire
          </a>
        </div>
      </div>
    </article>

    <!-- Feed Buttons -->
    <section class="grid-span-full twelve-grid grid-gap-tight">
      <a
        href="/rss.xml"
        class="grid-span-3 flex items-center justify-center gap-2 px-4 py-3 bg-white dark:bg-gray-800 border border-borderColor dark:border-borderColorDark rounded-md hover:bg-bgSecondary dark:hover:bg-bgSecondaryDark transition-all duration-200 shadow-sm"
      >
        <svg class="w-4 h-4 opacity-60" fill="currentColor" viewBox="0 0 20 20">
          <path d="M3.429 2.857v2.857c9.714 0 17.571 7.857 17.571 17.571h2.857C23.857 13.429 13.286 2.857 3.429 2.857zm0 5.714v2.858c5.143 0 9.286 4.143 9.286 9.285h2.857c0-6.857-5.486-12.343-12.143-12.343zm2.285 7.714c1.257 0 2.286 1.029 2.286 2.286S6.971 20.857 5.714 20.857 3.429 19.828 3.429 18.571s1.028-2.286 2.285-2.286z" />
        </svg>
        <span>Everything</span>
      </a>

      <a
        href="/garden/rss.xml"
        class="grid-span-3 flex items-center justify-center gap-2 px-4 py-3 bg-white dark:bg-gray-800 border border-borderColor dark:border-borderColorDark rounded-md hover:bg-bgSecondary dark:hover:bg-bgSecondaryDark transition-all duration-200 shadow-sm"
      >
        <svg class="w-4 h-4 opacity-60" fill="currentColor" viewBox="0 0 20 20">
          <path d="M3.429 2.857v2.857c9.714 0 17.571 7.857 17.571 17.571h2.857C23.857 13.429 13.286 2.857 3.429 2.857zm0 5.714v2.858c5.143 0 9.286 4.143 9.286 9.285h2.857c0-6.857-5.486-12.343-12.143-12.343zm2.285 7.714c1.257 0 2.286 1.029 2.286 2.286S6.971 20.857 5.714 20.857 3.429 19.828 3.429 18.571s1.028-2.286 2.285-2.286z" />
        </svg>
        <span>Garden</span>
      </a>

      <a
        href="/stream/rss.xml"
        class="grid-span-3 flex items-center justify-center gap-2 px-4 py-3 bg-white dark:bg-gray-800 border border-borderColor dark:border-borderColorDark rounded-md hover:bg-bgSecondary dark:hover:bg-bgSecondaryDark transition-all duration-200 shadow-sm"
      >
        <svg class="w-4 h-4 opacity-60" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z"
            clip-rule="evenodd"
          />
        </svg>
        <span>Stream</span>
      </a>

      <a
        href="/nordletter/rss.xml"
        class="grid-span-3 flex items-center justify-center gap-2 px-4 py-3 bg-white dark:bg-gray-800 border border-borderColor dark:border-borderColorDark rounded-md hover:bg-bgSecondary dark:hover:bg-bgSecondaryDark transition-all duration-200 shadow-sm"
      >
        <svg class="w-4 h-4 opacity-60" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
          <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
        </svg>
        <span>NordLetter</span>
      </a>
    </section>

    <!-- Recent Posts -->
    <section class="grid-span-8 grid-start-3 progress-page__content" style="margin-top: clamp(2rem, 5vw, 3.5rem);">
      <RecentItems posts={transformedRecentPosts} title="Recent Posts" showFullContent={false} />
    </section>
  </section>
</Layout>

<style>
  .feeds-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .feeds-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
    text-align: center;
  }

  .feeds-button--primary {
    background: #8b5cf6;
    color: white;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  }

  .feeds-button--primary:hover {
    background: #7c3aed;
    transform: translateY(-1px);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  .feeds-button--primary:focus-visible {
    outline: 2px solid #7c3aed;
    outline-offset: 2px;
  }

  .feeds-button--secondary {
    border: 1px solid #8b5cf6;
    color: #7c3aed;
    background: transparent;
  }

  .feeds-button--secondary:hover {
    background: rgba(139, 92, 246, 0.1);
    transform: translateY(-1px);
  }

  .feeds-button--secondary:focus-visible {
    outline: 2px solid #7c3aed;
    outline-offset: 2px;
  }

  :global(.dark) .feeds-button--secondary {
    color: #a78bfa;
    border-color: #7c3aed;
  }

  :global(.dark) .feeds-button--secondary:hover {
    background: rgba(139, 92, 246, 0.15);
    border-color: #8b5cf6;
  }

  @media (min-width: 640px) {
    .feeds-buttons {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
