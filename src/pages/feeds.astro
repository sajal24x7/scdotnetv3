---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { getAllPosts } from '../utils/content';
import '../styles/progress-page.css';

const allPosts = await getAllPosts();
---

<Layout
  title="RSS Feeds - Sajal Choudhary"
  description="Subscribe to RSS feeds for different types of content"
  currentPage="/feeds/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'progress-page',
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
  <section class="progress-page__layout twelve-grid feeds-page-layout">
    <header class="grid-span-full progress-page__header feeds-page-header">
      <div class="progress-page__header-content">
        <PageHeader
          title="RSS Feeds"
          layout="centered"
          size="lg"
          maxWidth="7xl"
        />
        <div class="feeds-intro">
          <p>
            RSS lets you follow what I — or anyone you choose — write, without algorithms or ads.
            I use <a href="https://netnewswire.com" target="_blank" rel="noopener noreferrer">NetNewsWire</a> as
            my reader of choice; <a href="https://feedly.com" target="_blank" rel="noopener noreferrer">Feedly</a> is
            another popular option. If you're new to feeds,
            <a href="https://aboutfeeds.com" target="_blank" rel="noopener noreferrer">aboutfeeds.com</a> is
            a good place to start, and this piece on
            <a href="https://www.citationneeded.news/curate-with-rss/" target="_blank" rel="noopener noreferrer">curating your newspaper with feeds</a>
            is well worth reading.
          </p>
        </div>
      </div>
    </header>

    <!-- Subscribe Table -->
    <article class="grid-span-full feeds-table-card">
      <div class="feeds-table">

        <!-- Column 1: Garden -->
        <div class="feeds-col">
          <a href="/garden/rss.xml" class="feeds-col__parent">Garden</a>
          <ul class="feeds-col__list">
            <li><a href="/evergreen/rss.xml">Evergreen</a></li>
            <li><a href="/til/rss.xml">TIL</a></li>
            <li><a href="/story/rss.xml">Stories</a></li>
            <li><a href="/poem/rss.xml">Poems</a></li>
            <li><a href="/bookshelf/rss.xml">Bookshelf</a></li>
            <li><a href="/filmshelf/rss.xml">Film Shelf</a></li>
            <li><a href="/tvshelf/rss.xml">TV Shelf</a></li>
            <li><a href="/gameshelf/rss.xml">Game Shelf</a></li>
          </ul>
        </div>

        <!-- Column 2: Stream + Nordletter -->
        <div class="feeds-col">
          <a href="/stream/rss.xml" class="feeds-col__parent">Stream</a>
          <ul class="feeds-col__list">
            <li><a href="/blog/rss.xml">Blog</a></li>
            <li><a href="/micro/rss.xml">Micro</a></li>
            <li><a href="/photo/rss.xml">Photos</a></li>
          </ul>
          <a href="/nordletter/rss.xml" class="feeds-col__parent feeds-col__parent--spaced">Nordletter</a>
        </div>

        <!-- Column 3: Special -->
        <div class="feeds-col">
          <span class="feeds-col__label">Special</span>
          <ul class="feeds-col__list">
            <li><a href="/rss.xml">Everything</a></li>
            <li><a href="/longform/rss.xml">Longform</a></li>
            <li><a href="/prose/rss.xml">Prose</a></li>
          </ul>
        </div>

      </div>
    </article>
  </section>
</Layout>

<style>
  .feeds-page-header {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .feeds-intro {
    margin-top: 1.25rem;
    text-align: center;
  }

  .feeds-intro p {
    font-size: clamp(1.25rem, 4vw, 1.5rem);
    color: rgb(71 85 105);
    max-width: 48rem;
    margin: 0 auto;
    line-height: 1.7;
  }

  :global(.dark) .feeds-intro p {
    color: rgb(var(--color-text-secondary));
  }

  .feeds-intro a {
    color: #7c3aed;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .feeds-intro a:hover {
    color: #6d28d9;
  }

  :global(.dark) .feeds-intro a {
    color: #a78bfa;
  }

  :global(.dark) .feeds-intro a:hover {
    color: #c4b5fd;
  }

  /* Table layout */
  .feeds-table-card {
    margin-top: clamp(0.5rem, 2vw, 1rem);
    max-width: 48rem;
    margin-inline: auto;
    width: 100%;
  }

  .feeds-table {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  :global(.dark) .feeds-table {
    border-color: rgba(255, 255, 255, 0.1);
  }

  .feeds-col {
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .feeds-col + .feeds-col {
    border-left: 1px solid rgba(0, 0, 0, 0.1);
  }

  :global(.dark) .feeds-col + .feeds-col {
    border-left-color: rgba(255, 255, 255, 0.1);
  }

  /* Column heading (clickable feed) */
  .feeds-col__parent {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgb(31 41 55);
    text-decoration: none;
    margin-bottom: 0.625rem;
    transition: color 0.15s ease;
  }

  .feeds-col__parent:hover {
    color: #7c3aed;
  }

  :global(.dark) .feeds-col__parent {
    color: rgb(243 244 246);
  }

  :global(.dark) .feeds-col__parent:hover {
    color: #a78bfa;
  }

  .feeds-col__parent--spaced {
    margin-top: 1.5rem;
    margin-bottom: 0;
  }

  /* Non-clickable column label (Special) */
  .feeds-col__label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgb(31 41 55);
    margin-bottom: 0.625rem;
  }

  :global(.dark) .feeds-col__label {
    color: rgb(243 244 246);
  }

  /* Sub-feed list */
  .feeds-col__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .feeds-col__list li {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  :global(.dark) .feeds-col__list li {
    border-top-color: rgba(255, 255, 255, 0.07);
  }

  .feeds-col__list a {
    display: block;
    padding: 0.4rem 0;
    font-size: 0.875rem;
    color: rgb(75 85 99);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .feeds-col__list a:hover {
    color: #7c3aed;
  }

  :global(.dark) .feeds-col__list a {
    color: rgb(156 163 175);
  }

  :global(.dark) .feeds-col__list a:hover {
    color: #a78bfa;
  }

  /* Mobile: single column */
  @media (max-width: 640px) {
    .feeds-table {
      grid-template-columns: 1fr;
    }

    .feeds-col + .feeds-col {
      border-left: none;
      border-top: 1px solid rgba(0, 0, 0, 0.1);
    }

    :global(.dark) .feeds-col + .feeds-col {
      border-top-color: rgba(255, 255, 255, 0.1);
    }
  }
</style>
