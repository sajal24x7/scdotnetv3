---
import Layout from '../layouts/Layout.astro';
import { getAllPosts } from '../utils/content';
import { formatDate } from '../utils/date';

// Debug URL parsing - try multiple methods
const url = Astro.url;
const searchParams = Astro.url.searchParams;
const searchQuery = searchParams.get('q') || '';

// Alternative methods to get query param
const urlSearchParams = new URLSearchParams(url.search);
const queryFromURL = urlSearchParams.get('q') || '';

// Manual parsing
const manualQuery = url.search.includes('?q=') 
  ? decodeURIComponent(url.search.split('?q=')[1].split('&')[0]) 
  : '';

const allPosts = await getAllPosts();

// Very simple search - try all query methods
const searchResults = [];

// Try all possible query values
const possibleQueries = [searchQuery, queryFromURL, manualQuery].filter(q => q && q.length > 0);

for (const testQuery of possibleQueries) {
  if (testQuery) {
    const query = testQuery.toLowerCase().trim();
    
    // For debugging - let's just find posts with "ai" in tags
    if (query === 'tag:ai' || query === 'ai') {
      for (let i = 0; i < allPosts.length; i++) {
        const post = allPosts[i];
        if (post.data.tags) {
          for (let j = 0; j < post.data.tags.length; j++) {
            const tag = post.data.tags[j];
            if (tag.toLowerCase() === 'ai') {
              searchResults.push({ post, score: 100 });
              break;
            }
          }
        }
      }
      break; // Found a working query, stop trying others
    }
  }
}

// Debug info
const debugInfo = {
  // URL Debug
  fullURL: url.href,
  pathname: url.pathname,
  search: url.search,
  searchParamsString: searchParams.toString(),
  allParams: Array.from(searchParams.entries()),
  qParam: searchParams.get('q'),
  qParamExists: searchParams.has('q'),
  
  // Alternative query methods
  queryFromURL,
  manualQuery,
  urlSearchParamsAll: Array.from(urlSearchParams.entries()),
  
  // Search Debug  
  searchQuery,
  allPostsCount: allPosts.length,
  searchResultsCount: searchResults.length,
  queryLength: searchQuery.length,
  trimmedQuery: searchQuery.toLowerCase().trim(),
  samplePostTags: allPosts.length > 0 ? allPosts[0].data.tags : 'no posts'
};
---

<Layout title={searchQuery ? `Search results for "${searchQuery}"` : "Search"} currentPage="search">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Search Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-4">Search</h1>
      
      <!-- Search Form -->
      <form method="GET" action="/search" class="mb-6">
        <div class="flex gap-3">
          <input
            type="text"
            name="q"
            value={searchQuery}
            placeholder="Search posts or try 'tag:ai'..."
            class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
          <button
            type="submit"
            class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors font-medium"
          >
            Search
          </button>
        </div>
      </form>
      
      <!-- Test Links -->
      <div class="mb-6 p-4 bg-yellow-100 dark:bg-yellow-900 rounded">
        <h3 class="font-bold mb-2">Test These Direct Links:</h3>
        <div class="space-y-2">
          <div><a href="/search?q=AI" class="text-blue-600 underline">Search for "AI" → /search?q=AI</a></div>
          <div><a href="/search?q=tag:ai" class="text-blue-600 underline">Search for "tag:ai" → /search?q=tag:ai</a></div>
          <div><a href="/search?q=blog" class="text-blue-600 underline">Search for "blog" → /search?q=blog</a></div>
        </div>
      </div>
      
      <!-- Debug Info -->
      <div class="mb-6 p-4 bg-gray-100 dark:bg-gray-800 rounded text-sm">
        <h3 class="font-bold mb-2">Debug Info:</h3>
        <pre>{JSON.stringify(debugInfo, null, 2)}</pre>
        
        <h4 class="font-bold mt-4 mb-2">Sample Posts with Tags:</h4>
        {allPosts.slice(0, 5).map(post => (
          <div class="mb-2 p-2 bg-white dark:bg-gray-700 rounded">
            <div><strong>{post.data.title}</strong></div>
            <div>Tags: {post.data.tags ? post.data.tags.join(', ') : 'No tags'}</div>
          </div>
        ))}
      </div>

      <!-- Search Results Info -->
      {searchQuery && (
        <div class="text-gray-600 dark:text-gray-400">
          {searchResults.length > 0 ? (
            <p>Found {searchResults.length} result{searchResults.length !== 1 ? 's' : ''} for "<strong>{searchQuery}</strong>"</p>
          ) : (
            <p>No results found for "<strong>{searchQuery}</strong>"</p>
          )}
        </div>
      )}
    </div>

    <!-- Search Results -->
    {searchQuery && searchResults.length > 0 && (
      <div class="mb-8">
        <h2 class="text-2xl font-semibold mb-4">Search Results ({searchResults.length})</h2>
        <div class="space-y-4">
          {searchResults.map(({ post, score }) => (
            <div class="border border-gray-200 dark:border-gray-700 p-4 rounded">
              <h3 class="text-lg font-semibold mb-2">
                <a 
                  href={`/${post.data.category}/${post.slug}/`} 
                  class="text-blue-600 dark:text-blue-400 hover:underline"
                >
                  {post.data.title || 'Untitled'}
                </a>
              </h3>
              <div class="text-sm text-gray-600 dark:text-gray-400 mb-2">
                <span>Category: {post.data.category}</span>
                {post.data.tags && post.data.tags.length > 0 && (
                  <span> | Tags: {post.data.tags.join(', ')}</span>
                )}
                <span> | Score: {score}</span>
              </div>
              {post.data.description && (
                <p class="text-gray-700 dark:text-gray-300 text-sm">
                  {post.data.description}
                </p>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- No Results State -->
    {searchQuery && searchResults.length === 0 && (
      <div class="text-center py-12">
        <div class="text-gray-400 mb-4">
          <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-2">No results found</h3>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          Try adjusting your search terms or browse the content below.
        </p>
        <div class="flex flex-col sm:flex-row gap-2 justify-center">
          <a href="/notes/" class="text-blue-600 dark:text-blue-400 hover:underline">Browse Notes</a>
          <a href="/ephemera/" class="text-blue-600 dark:text-blue-400 hover:underline">Browse Ephemera</a>
          <a href="/blog/" class="text-blue-600 dark:text-blue-400 hover:underline">Browse Blog</a>
        </div>
      </div>
    )}

    <!-- Empty State (No Search Query) -->
    {!searchQuery && (
      <div class="text-center py-12">
        <div class="text-gray-400 mb-4">
          <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-2">Search the site</h3>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          Enter a search term above to find posts by title, content, or tags.
        </p>
        <p class="text-sm text-gray-500 dark:text-gray-500">
          Try searching for topics like "AI", "technology", or use "tag:ai" for tag-specific searches.
        </p>
      </div>
    )}
  </div>
</Layout>