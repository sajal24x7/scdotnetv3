---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
---

<Layout
  title="Search – Sajal Choudhary"
  description="Search across all posts, notes, and content"
  currentPage="/search/"
  pageWrapper={{
    maxWidth: '3xl',
    padding: 'md',
    paddingScale: 'container',
    centered: true,
  }}
  enableLinkHoverEffect
>
  <PageHeader
    title="Search"
    description="Search across posts, notes, and everything else."
    layout="left"
    size="md"
    maxWidth="3xl"
  />

  <div class="search-page mt-6">
    <form id="search-form" role="search" class="flex gap-2">
      <input
        type="search"
        id="search-input"
        name="q"
        placeholder="Search posts… or try tag:ai"
        autocomplete="off"
        class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
      />
      <button
        type="submit"
        class="px-5 py-2 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 font-medium rounded-lg hover:bg-gray-700 dark:hover:bg-gray-300 transition-colors"
      >
        Search
      </button>
    </form>

    <div id="search-status" class="mt-6 text-sm text-gray-500 dark:text-gray-400 hidden"></div>

    <div id="search-results" class="mt-4 divide-y divide-gray-200 dark:divide-gray-700"></div>
  </div>

  <script>
    import initializeSearchPage from '../components/islands/search-page-loader.js';
    initializeSearchPage();
  </script>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.pagefind-excerpt mark) {
    background-color: rgb(254 240 138);
    color: inherit;
    border-radius: 2px;
    padding: 0 1px;
  }

  :global(.dark) :global(.pagefind-excerpt mark) {
    background-color: rgb(161 98 7 / 0.5);
  }
</style>
