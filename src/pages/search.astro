---
import Layout from '../layouts/Layout.astro';
import { getAllPosts } from '../utils/content';
import { formatDate } from '../utils/date';

const searchQuery = Astro.url.searchParams.get('q') || '';
const allPosts = await getAllPosts();

// Debug information
console.log('=== SEARCH DEBUG ===');
console.log('Raw search query:', searchQuery);
console.log('Total posts loaded:', allPosts.length);
if (allPosts.length > 0) {
  console.log('Sample post structure:', {
    title: allPosts[0].data.title,
    category: allPosts[0].data.category,
    tags: allPosts[0].data.tags,
    hasSlug: !!allPosts[0].slug
  });
}

function searchPosts(query: string) {
  console.log('searchPosts called with:', query);
  if (!query || query.length < 2) {
    return [];
  }

  query = query.toLowerCase().trim();
  
  // Check for tag-specific search (tag:ai)
  const tagSearchMatch = query.match(/^tag:(.+)$/);
  if (tagSearchMatch) {
    const tagQuery = tagSearchMatch[1];
    console.log('Tag search detected. Looking for tag:', tagQuery);
    
    const tagResults = allPosts
      .filter(post => {
        const hasTags = post.data.tags && post.data.tags.length > 0;
        console.log(`Post "${post.data.title}" has tags:`, post.data.tags);
        
        if (!hasTags) return false;
        
        const match = post.data.tags.some(tag => {
          const lowerTag = tag.toLowerCase();
          const lowerQuery = tagQuery.toLowerCase();
          const isMatch = lowerTag === lowerQuery || 
                 lowerTag.startsWith(lowerQuery + '-') || 
                 lowerTag.startsWith(lowerQuery + ' ') ||
                 lowerTag.endsWith('-' + lowerQuery) ||
                 lowerTag.endsWith(' ' + lowerQuery) ||
                 lowerTag.includes(' ' + lowerQuery + ' ') ||
                 lowerTag.includes('-' + lowerQuery + '-');
          
          if (isMatch) {
            console.log(`✅ Match found: "${lowerTag}" matches "${lowerQuery}"`);
          }
          return isMatch;
        });
        
        return match;
      })
      .map(post => ({ post, score: 100 }));
    
    console.log(`Tag search results: ${tagResults.length} posts found`);
    return tagResults;
  }
  
  // Regular search with scoring (excluding body for now)
  const results: { post: any, score: number }[] = [];
  
  allPosts.forEach(post => {
    let score = 0;
    const title = post.data.title?.toLowerCase() || '';
    const tags = post.data.tags || [];
    const category = post.data.category?.toLowerCase() || '';
    const description = post.data.description?.toLowerCase() || '';
    
    // Tag matches (highest priority)
    const exactTagMatch = tags.some(tag => tag.toLowerCase() === query);
    const partialTagMatch = tags.some(tag => tag.toLowerCase().includes(query));
    
    if (exactTagMatch) {
      score += 100;
    } else if (partialTagMatch) {
      score += 80;
    }
    
    // Title matches (high priority)
    if (title === query) {
      score += 60;
    } else if (title.includes(query)) {
      score += 40;
    }
    
    // Description matches
    if (description.includes(query)) {
      score += 30;
    }
    
    // Category matches
    if (category.includes(query)) {
      score += 20;
    }
    
    if (score > 0) {
      results.push({ post, score });
    }
  });
  
  // Sort by score (highest first), then by date (newest first)
  return results.sort((a, b) => {
    if (b.score !== a.score) {
      return b.score - a.score;
    }
    return new Date(b.post.data.pubDate).getTime() - new Date(a.post.data.pubDate).getTime();
  });
}

const searchResults = searchPosts(searchQuery);
console.log('Final search results:', searchResults.length);
console.log('===================');
---

<Layout title={searchQuery ? `Search results for "${searchQuery}"` : "Search"} currentPage="search">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Search Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-4">Search</h1>
      
      <!-- Search Form -->
      <form method="GET" action="/search" class="mb-6">
        <div class="flex gap-3">
          <input
            type="text"
            name="q"
            value={searchQuery}
            placeholder="Search posts or try 'tag:ai'..."
            class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
          <button
            type="submit"
            class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors font-medium"
          >
            Search
          </button>
        </div>
      </form>
      
      <!-- Search Results Info -->
      {searchQuery && (
        <div class="text-gray-600 dark:text-gray-400">
          {searchResults.length > 0 ? (
            <p>Found {searchResults.length} result{searchResults.length !== 1 ? 's' : ''} for "<strong>{searchQuery}</strong>"</p>
          ) : (
            <p>No results found for "<strong>{searchQuery}</strong>"</p>
          )}
        </div>
      )}
    </div>

    <!-- Search Results -->
    {searchQuery && searchResults.length > 0 && (
      <div class="mb-8">
        <h2 class="text-2xl font-semibold mb-4">Search Results ({searchResults.length})</h2>
        <div class="space-y-4">
          {searchResults.map(({ post, score }) => (
            <div class="border border-gray-200 dark:border-gray-700 p-4 rounded">
              <h3 class="text-lg font-semibold mb-2">
                <a 
                  href={`/${post.data.category}/${post.slug}/`} 
                  class="text-blue-600 dark:text-blue-400 hover:underline"
                >
                  {post.data.title || 'Untitled'}
                </a>
              </h3>
              <div class="text-sm text-gray-600 dark:text-gray-400 mb-2">
                <span>Category: {post.data.category}</span>
                {post.data.tags && post.data.tags.length > 0 && (
                  <span> | Tags: {post.data.tags.join(', ')}</span>
                )}
                <span> | Score: {score}</span>
              </div>
              {post.data.description && (
                <p class="text-gray-700 dark:text-gray-300 text-sm">
                  {post.data.description}
                </p>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- No Results State -->
    {searchQuery && searchResults.length === 0 && (
      <div class="text-center py-12">
        <div class="text-gray-400 mb-4">
          <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-2">No results found</h3>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          Try adjusting your search terms or browse the content below.
        </p>
        <div class="flex flex-col sm:flex-row gap-2 justify-center">
          <a href="/notes/" class="text-blue-600 dark:text-blue-400 hover:underline">Browse Notes</a>
          <a href="/ephemera/" class="text-blue-600 dark:text-blue-400 hover:underline">Browse Ephemera</a>
          <a href="/blog/" class="text-blue-600 dark:text-blue-400 hover:underline">Browse Blog</a>
        </div>
      </div>
    )}

    <!-- Empty State (No Search Query) -->
    {!searchQuery && (
      <div class="text-center py-12">
        <div class="text-gray-400 mb-4">
          <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-2">Search the site</h3>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          Enter a search term above to find posts by title, content, or tags.
        </p>
        <p class="text-sm text-gray-500 dark:text-gray-500">
          Try searching for topics like "AI", "technology", or use "tag:ai" for tag-specific searches.
        </p>
      </div>
    )}
  </div>
</Layout>