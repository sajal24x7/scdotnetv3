---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Search" description="Search through all posts and content" currentPage="search">
  <div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-gray-900 dark:to-gray-800">
    <div class="container mx-auto px-4 py-8">
      <div class="text-center">
        <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">
          Search Posts
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
          Find exactly what you're looking for across all content
        </p>
        <div class="max-w-2xl mx-auto">
          <input 
            type="text" 
            placeholder="Search posts..." 
            class="w-full px-6 py-4 text-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all shadow-lg"
          />
        </div>
        <p class="mt-4 text-sm text-gray-500">
          This is a test search page. Full functionality coming soon!
        </p>
      </div>
    </div>
  </div>
</Layout>