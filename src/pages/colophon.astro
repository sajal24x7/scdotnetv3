---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/layout/PageHeader.astro';

const getGridSpanClass = (span: number | undefined, fallback: number) => {
    if (typeof span === 'number' && Number.isInteger(span) && span >= 1 && span <= 12) {
        return `grid-span-${span}`;
    }

    return `grid-span-${fallback}`;
};

const contentCallouts = [
    {
        title: 'Writing Workflow',
        items: [
            'Write in <a href="https://obsidian.md" target="_blank" rel="noopener noreferrer">Obsidian</a>',
            'Organize with tags and categories',
            'Use frontmatter for metadata',
            'Preview with Astro dev server'
        ],
        span: 6
    },
    {
        title: 'Content Types',
        items: [
            '<strong>Garden:</strong> Evergreen notes, TIL, bookshelf',
            '<strong>Stream:</strong> Blog posts, micro posts, photos',
            '<strong>Creative:</strong> Stories, poems, prose',
            '<strong>Newsletter:</strong> Nordletter updates'
        ],
        span: 6
    }
];
---

<Layout
  title="Colophon - Sajal Choudhary"
  description="Technical details about this website"
  currentPage="/colophon/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'md',
    centered: true,
    grid: {
      gap: 'tight'
    }
  }}
  enableSearchModal
  enableLinkHoverEffect
>
  <section class="colophon page-grid grid-gap-tight grid-span-full">
    <header class="grid-span-full">
      <PageHeader
        title="Colophon"
        description="This page contains technical details about how this website is built and maintained."
        layout="centered"
        size="lg"
        maxWidth="7xl"
      />
    </header>

    <section class="colophon__card-group page-grid grid-gap-tight grid-span-full">
      <article class="colophon-card grid-span-3 border border-borderColor dark:border-borderColorDark rounded-lg p-6">
        <h3 class="colophon-card__title">
          <span class="colophon-card__icon">🛠️</span> Built With
        </h3>
        <ul class="colophon-card__list">
          <li><strong>Framework:</strong> <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a></li>
          <li><strong>Styling:</strong> <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer">Tailwind CSS</a></li>
          <li><strong>Content:</strong> Markdown with frontmatter</li>
          <li><strong>Deployment:</strong> <a href="https://netlify.com" target="_blank" rel="noopener noreferrer">Netlify</a></li>
        </ul>
      </article>

      <article class="colophon-card grid-span-3 border border-borderColor dark:border-borderColorDark rounded-lg p-6">
        <h3 class="colophon-card__title">
          <span class="colophon-card__icon">🎨</span> Design & Typography
        </h3>
        <ul class="colophon-card__list">
          <li><strong>Fonts:</strong> <a href="https://fonts.google.com/specimen/Inter" target="_blank" rel="noopener noreferrer">Inter</a> for body text</li>
          <li><strong>Headings:</strong> <a href="https://fonts.google.com/specimen/Montserrat" target="_blank" rel="noopener noreferrer">Montserrat</a> for headings</li>
          <li><strong>Icons:</strong> Heroicons and custom SVG</li>
          <li><strong>Theme:</strong> Light/dark mode support</li>
        </ul>
      </article>
    </section>

    <section class="colophon__section page-grid grid-gap-tight grid-span-full">
      <div class="colophon__section-heading grid-span-8 grid-start-3 prose dark:prose-dark">
        <h2>Content Management</h2>
      </div>
      <div class="colophon__callouts page-grid grid-gap-tight grid-span-full">
        {contentCallouts.map((callout) => (
            <article class={`colophon-callout ${getGridSpanClass(callout.span, 6)} bg-bgSecondary dark:bg-bgSecondaryDark rounded-lg p-6`}>
                <h3 class="colophon-callout__title">{callout.title}</h3>
                <ul class="colophon-callout__list">
                    {callout.items.map((item) => (
                        <li set:html={item} />
                    ))}
                </ul>
            </article>
        ))}
      </div>
    </section>

    <section class="colophon__section page-grid grid-gap-tight grid-span-full">
      <div class="colophon__section-heading grid-span-8 grid-start-3 prose dark:prose-dark">
        <h2>Technical Features</h2>
      </div>
      <div class="colophon__card-group page-grid grid-gap-tight grid-span-full">
        <article class="colophon-card grid-span-3 border border-borderColor dark:border-borderColorDark rounded-lg p-5">
          <h3 class="colophon-card__title">
            <span class="colophon-card__icon">🔍</span> Search
          </h3>
          <p>Full-text search across all content with instant results and keyboard navigation support.</p>
        </article>
        <article class="colophon-card grid-span-3 border border-borderColor dark:border-borderColorDark rounded-lg p-5">
          <h3 class="colophon-card__title">
            <span class="colophon-card__icon">📱</span> Responsive
          </h3>
          <p>Mobile-first design that works seamlessly across all devices and screen sizes.</p>
        </article>
        <article class="colophon-card grid-span-3 border border-borderColor dark:border-borderColorDark rounded-lg p-5">
          <h3 class="colophon-card__title">
            <span class="colophon-card__icon">⚡</span> Performance
          </h3>
          <p>Static site generation for fast loading times and excellent Core Web Vitals scores.</p>
        </article>
        <article class="colophon-card grid-span-3 border border-borderColor dark:border-borderColorDark rounded-lg p-5">
          <h3 class="colophon-card__title">
            <span class="colophon-card__icon">🎯</span> SEO
          </h3>
          <p>Optimized meta tags, structured data, and semantic HTML for better search engine visibility.</p>
        </article>
      </div>
    </section>

    <section class="colophon__section page-grid grid-gap-tight grid-span-full">
      <div class="colophon__section-heading grid-span-8 grid-start-3 prose dark:prose-dark">
        <h2>Site History</h2>
      </div>
      <div class="colophon__timeline grid-span-8 grid-start-3">
        <div class="timeline-container relative border-l border-borderColor dark:border-borderColorDark">
          <div class="timeline-wrapper grid md:grid-cols-[1fr_3fr] gap-4 md:gap-8">
            <!-- Timeline Item 1 -->
            <div class="timeline-date text-right pr-8 hidden md:block">
              <span class="inline-block bg-bgSecondary dark:bg-bgSecondaryDark px-4 py-2 rounded-lg font-medium">2025</span>
            </div>
            <div class="timeline-content relative mb-12">
              <div class="md:hidden text-sm text-textSecondary dark:text-textSecondaryDark mb-2">2025</div>
              <div class="timeline-marker absolute -left-[41px] md:-left-4 top-0 w-4 h-4 rounded-full bg-accent"></div>
              <div class="bg-bgSecondary dark:bg-bgSecondaryDark p-6 rounded-lg shadow-sm">
                <h3 class="text-xl font-semibold mb-2">Migrated to Astro</h3>
                <p>Rebuilt the entire site using Astro for better performance, improved developer experience, and modern web standards. Added new features like search, improved navigation, and better content organization.</p>
              </div>
            </div>

            <!-- Timeline Item 2 -->
            <div class="timeline-date text-right pr-8 hidden md:block">
              <span class="inline-block bg-bgSecondary dark:bg-bgSecondaryDark px-4 py-2 rounded-lg font-medium">2021-2024</span>
            </div>
            <div class="timeline-content relative mb-12">
              <div class="md:hidden text-sm text-textSecondary dark:text-textSecondaryDark mb-2">2021-2024</div>
              <div class="timeline-marker absolute -left-[41px] md:-left-4 top-0 w-4 h-4 rounded-full bg-accent"></div>
              <div class="bg-bgSecondary dark:bg-bgSecondaryDark p-6 rounded-lg shadow-sm">
                <h3 class="text-xl font-semibold mb-2">Ghost Pro Hosting</h3>
                <p>Used Ghost Pro for hosting and content management. While it was reliable, the limitations in customization and the desire for more control led to the decision to rebuild with a static site generator.</p>
              </div>
            </div>

            <!-- Timeline Item 3 -->
            <div class="timeline-date text-right pr-8 hidden md:block">
              <span class="inline-block bg-bgSecondary dark:bg-bgSecondaryDark px-4 py-2 rounded-lg font-medium">2020-2021</span>
            </div>
            <div class="timeline-content relative mb-12">
              <div class="md:hidden text-sm text-textSecondary dark:text-textSecondaryDark mb-2">2020-2021</div>
              <div class="timeline-marker absolute -left-[41px] md:-left-4 top-0 w-4 h-4 rounded-full bg-accent"></div>
              <div class="bg-bgSecondary dark:bg-bgSecondaryDark p-6 rounded-lg shadow-sm">
                <h3 class="text-xl font-semibold mb-2">Self-Hosted Ghost</h3>
                <p>Attempted self-hosting Ghost on AWS LightSail using Docker Compose. While it worked, the maintenance overhead was too high for the amount of content being published.</p>
              </div>
            </div>

            <!-- Timeline Item 4 -->
            <div class="timeline-date text-right pr-8 hidden md:block">
              <span class="inline-block bg-bgSecondary dark:bg-bgSecondaryDark px-4 py-2 rounded-lg font-medium">2012-2020</span>
            </div>
            <div class="timeline-content relative">
              <div class="md:hidden text-sm text-textSecondary dark:text-textSecondaryDark mb-2">2012-2020</div>
              <div class="timeline-marker absolute -left-[41px] md:-left-4 top-0 w-4 h-4 rounded-full bg-accent"></div>
              <div class="bg-bgSecondary dark:bg-bgSecondaryDark p-6 rounded-lg shadow-sm">
                <h3 class="text-xl font-semibold mb-2">WordPress Era</h3>
                <p>Started with Blogger, then moved to WordPress (both free and self-hosted versions). Used various themes and plugins, but performance issues and the complexity of maintenance led to exploring alternatives.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="colophon__section page-grid grid-gap-tight grid-span-full">
      <div class="colophon__section-heading grid-span-8 grid-start-3 prose dark:prose-dark">
        <h2>Open Source</h2>
        <p>This website is built entirely with open source technologies. The source code is available on GitHub, and contributions are welcome.</p>
      </div>
      <div class="colophon__links grid-span-8 grid-start-3">
        <a
          href="https://github.com/yourusername/your-repo"
          target="_blank"
          rel="noopener noreferrer"
          class="colophon-link bg-accent text-white hover:bg-accent/90"
        >
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.071 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd"/>
          </svg>
          View Source
        </a>
        <a
          href="https://github.com/yourusername/your-repo/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="colophon-link bg-white dark:bg-gray-800 border border-borderColor dark:border-borderColorDark hover:bg-bgSecondary dark:hover:bg-bgSecondaryDark"
        >
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
          Report Issues
        </a>
      </div>
    </section>
  </section>
</Layout>

<style>
  .page-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    column-gap: var(--grid-column-gap);
    row-gap: var(--grid-row-gap);
    padding-inline: var(--grid-padding-inline);
  }

  @media (min-width: 48rem) {
    .page-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
  }

  .colophon {
    padding-block: clamp(2.5rem, 6vw, 3.5rem);
  }

  .colophon__section-heading h2 {
    margin-bottom: clamp(1rem, 3vw, 1.75rem);
  }

  .colophon-card {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    background-color: var(--color-bg);
    color: inherit;
  }

  .colophon-card__title {
    display: flex;
    align-items: center;
    font-size: clamp(1.125rem, 2vw, 1.25rem);
    font-weight: 600;
    gap: 0.5rem;
    margin-bottom: clamp(0.75rem, 2vw, 1rem);
  }

  .colophon-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .colophon-card__list,
  .colophon-callout__list {
    display: grid;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .colophon-callout {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .colophon-callout__title {
    font-size: clamp(1.125rem, 2vw, 1.25rem);
    font-weight: 600;
  }

  .colophon__timeline {
    margin-top: clamp(0.5rem, 2vw, 1rem);
  }

  .colophon__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .colophon-link {
    display: inline-flex;
    align-items: center;
    border-radius: 0.75rem;
    font-weight: 600;
    padding: 0.75rem 1.25rem;
    transition: background-color 150ms ease, color 150ms ease;
  }

  /* Timeline specific styles */
  @media (min-width: 768px) {
    .timeline-container {
      position: relative;
      padding-left: clamp(2.5rem, 4vw, 3rem);
    }

    .timeline-container:before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: clamp(1.25rem, 3vw, 1.5rem);
      width: 2px;
      background-color: var(--color-border);
      transform: translateX(-1px);
    }
  }

  .timeline-marker {
    box-shadow: 0 0 0 4px var(--color-bg);
  }
</style>

