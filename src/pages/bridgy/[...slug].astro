---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getYearDirectories } from '../utils/content';
import { findBacklinksComprehensive } from '../utils/backlinks';

export async function getStaticPaths() {
  // Get all year directories from content
  const years = getYearDirectories();

  // Get all posts from all collections
  const allPosts = await Promise.all(years.map(year => getCollection(year as any)));
  const posts = allPosts.flat().filter(entry => (entry as CollectionEntry<any>).data && (entry as CollectionEntry<any>).data.title);

  return posts.map((entry) => {
    const e = entry as CollectionEntry<any>;
    const category = 'category' in e.data && e.data.category ? e.data.category : 'notes';
    return {
      params: { slug: `${category}/${e.slug}` },
      props: { entry: e },
    };
  });
}

const slugParam = Astro.params.slug as string;
const [category, slug] = slugParam.split('/');
const entry = (Astro.props as { entry: CollectionEntry<any> }).entry;

// Find backlinks for this post (limit to 5 for Bridgy)
const backlinks = await findBacklinksComprehensive(slug, entry.data?.title || '');
const limitedBacklinks = backlinks.slice(0, 5);

// Get canonical URL for microformats
const canonicalUrl = `${Astro.site}/${category}/${slug}/`;

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{entry.data?.title ?? ''} - {category.charAt(0).toUpperCase() + category.slice(1)}</title>
  <meta name="description" content={entry.data?.description || "A personal digital garden and blog"} />
  
  <!-- Open Graph / Social Media -->
  <meta property="og:title" content={entry.data?.title ?? ''} />
  <meta property="og:description" content={entry.data?.description || "A personal digital garden and blog"} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonicalUrl} />
  
  <!-- Webmention Discovery -->
  <link rel="webmention" href="https://webmention.io/sajalchoudhary.net/webmention" />
  <link rel="pingback" href="https://webmention.io/sajalchoudhary.net/xmlrpc" />
  
  <!-- Bridgy-specific meta tags -->
  <meta name="bridgy-omit" content="true" />
  <meta name="bridgy-content" content="title,description,backlinks" />
  
  <!-- Minimal CSS for Bridgy -->
  <style>
    body {
      font-family: system-ui, sans-serif;
      line-height: 1.6;
      max-width: 65ch;
      margin: 0 auto;
      padding: 2rem 1rem;
      color: #333;
      background: #fff;
    }
    .h-entry { margin-bottom: 2rem; }
    .p-name { font-size: 2rem; font-weight: bold; margin-bottom: 1rem; color: #000; }
    .p-summary { font-size: 1.2rem; color: #666; margin-bottom: 1.5rem; }
    .e-content { margin-bottom: 2rem; }
    .e-content p { margin-bottom: 1rem; }
    .e-content a { color: #0066cc; text-decoration: underline; }
    .backlinks { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #eee; }
    .backlinks h3 { font-size: 1.1rem; margin-bottom: 1rem; color: #333; }
    .backlink-item { margin-bottom: 0.5rem; }
    .backlink-link { color: #0066cc; text-decoration: none; }
    .backlink-link:hover { text-decoration: underline; }
    .hidden { display: none; }
    .tags { margin: 1rem 0; }
    .tag { 
      display: inline-block; 
      background: #f0f0f0; 
      padding: 0.25rem 0.5rem; 
      margin: 0.25rem; 
      border-radius: 0.25rem; 
      font-size: 0.875rem; 
      color: #666;
    }
  </style>
</head>
<body>
  <article class="h-entry">
    <!-- Hidden microformat data for Bridgy -->
    <a href={canonicalUrl} class="u-url hidden"></a>
    <div class="p-author h-card hidden">
      <a class="p-name u-url" href="https://sajalchoudhary.net">Sajal Choudhary</a>
      <a class="u-url" href="https://sajalchoudhary.net">https://sajalchoudhary.net</a>
    </div>
    
    <!-- Post Title -->
    <h1 class="p-name">{entry.data?.title ?? ''}</h1>
    
    <!-- Post Description -->
    {entry.data?.description && (
      <p class="p-summary">{entry.data.description}</p>
    )}
    
    <!-- Tags (if any) -->
    {'tags' in entry.data && Array.isArray(entry.data.tags) && entry.data.tags.length > 0 && (
      <div class="tags">
        {entry.data.tags.map((tag: string) => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    )}
    
    <!-- Post Content (minimal for Bridgy) -->
    <div class="e-content">
      <p><strong>Read the full post:</strong> <a href={canonicalUrl}>{canonicalUrl}</a></p>
      <p>Published: {entry.data.pubDate.toLocaleDateString()}</p>
    </div>
    
    <!-- Backlinks (simplified for Bridgy) -->
    {limitedBacklinks.length > 0 && (
      <div class="backlinks">
        <h3>Related Posts ({backlinks.length})</h3>
        {limitedBacklinks.map((backlink) => (
          <div class="backlink-item">
            <a href={backlink.slug} class="backlink-link">{backlink.title}</a>
          </div>
        ))}
        {backlinks.length > 5 && (
          <p><a href={canonicalUrl} class="backlink-link">View all {backlinks.length} related posts</a></p>
        )}
      </div>
    )}
  </article>
</body>
</html>