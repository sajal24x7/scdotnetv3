---
import Layout from '../layouts/Layout.astro';
import MultiLevelNavigation from '../components/navigation/MultiLevelNavigation.astro';
---

<Layout 
  title="Navigation Demo" 
  description="Demo of the multi-level navigation system" 
  currentPage="/navigation-demo/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-4'
  }}
>
  <!-- Navigation Demo -->
  <div class="w-full">
    <MultiLevelNavigation currentPage="/navigation-demo/" />
  </div>

  <!-- Content Area -->
  <div class="container mx-auto max-w-6xl py-8">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-textPrimary mb-4">Navigation Demo</h1>
      <p class="text-lg text-textSecondary max-w-2xl mx-auto">
        This page demonstrates the new multi-level navigation system. Try clicking on different navigation items to see the secondary navigation appear.
      </p>
    </div>

    <!-- Navigation Instructions -->
    <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-6 mb-8">
      <h2 class="text-2xl font-semibold text-textPrimary mb-4">How It Works</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-lg font-medium text-textPrimary mb-2">Main Navigation</h3>
          <ul class="space-y-2 text-textSecondary">
            <li>• <strong>About</strong> - Single level navigation</li>
            <li>• <strong>Garden</strong> - Shows secondary navigation with: Evergreen, TIL, Bookshelf, Notes</li>
            <li>• <strong>Stream</strong> - Shows secondary navigation with: Blog, Micro, Photos, Stories, Poems</li>
            <li>• <strong>Nordletter</strong> - Single level navigation</li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-medium text-textPrimary mb-2">Features</h3>
          <ul class="space-y-2 text-textSecondary">
            <li>• Responsive design for mobile and desktop</li>
            <li>• Active state highlighting</li>
            <li>• Secondary navigation appears automatically</li>
            <li>• Clean, consistent layout across all devices</li>
            <li>• Smooth transitions and hover effects</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Try Navigation Section -->
    <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-6 mb-8">
      <h2 class="text-2xl font-semibold text-textPrimary mb-4">Try the Navigation</h2>
      <p class="text-textSecondary mb-4">
        Click on any navigation item above to see how the secondary navigation works. The secondary navigation will appear below the main navigation when you're in the Garden or Stream sections.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/garden/" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
          Go to Garden
        </a>
        <a href="/stream/" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
          Go to Stream
        </a>
        <a href="/about/" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors">
          Go to About
        </a>
        <a href="/nordletter/" class="px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition-colors">
          Go to Nordletter
        </a>
      </div>
    </div>

    <!-- Technical Details -->
    <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-6">
      <h2 class="text-2xl font-semibold text-textPrimary mb-4">Technical Implementation</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-lg font-medium text-textPrimary mb-2">Component Structure</h3>
          <ul class="space-y-2 text-textSecondary text-sm">
            <li>• <code>MultiLevelNavigation.astro</code> - Main navigation component</li>
            <li>• Responsive design with Tailwind CSS</li>
            <li>• Clean, semantic HTML structure</li>
            <li>• Automatic active state detection</li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-medium text-textPrimary mb-2">Navigation Logic</h3>
          <ul class="space-y-2 text-textSecondary text-sm">
            <li>• Main navigation always visible</li>
            <li>• Secondary navigation appears for Garden/Stream</li>
            <li>• Active states based on current page path</li>
            <li>• Mobile-first responsive design</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Custom styling for demo page */
  .container {
    animation: fadeIn 0.5s ease-in-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .container {
      padding: 0 1rem;
    }
  }
</style>