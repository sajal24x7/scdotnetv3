---
import '../../styles/shelf-wall.css';
import Layout from '../../layouts/Layout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import ShelfTile from '../../components/shelf/ShelfTile.astro';
import ShelfViewControls from '../../components/shelf/ShelfViewControls.astro';
import ShelfTabNav from '../../components/shelf/ShelfTabNav.astro';
import ShelfFilterResults from '../../components/shelf/ShelfFilterResults.astro';
import type { ImageMetadata } from 'astro';
import { getAllPosts } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';
import { computeWatchNumbers } from '../../utils/shelfUtils';
import { activityDate, groupTvShows, hasShelfNotes, mostCommonRating, repeatLabel, seasonRangeLabel } from '../../utils/shelfWall';
import { getBookCoverImage } from '../../utils/bookCovers';
import { getFilmCoverImage } from '../../utils/filmCovers';
import { getTVCoverImage } from '../../utils/tvCovers';
import { getGameCoverImage } from '../../utils/gameCovers';
import { bookRatingOrder, type BookRating } from '../../utils/bookRatings';
import { SHELF_LIST_SORT_PRIORITY, SHELF_STATUS_LABELS, type ShelfStatus } from '../../utils/shelfStatus';

const allPosts = await getAllPosts();
const shelfCategories = new Set(['bookshelf', 'filmshelf', 'tvshelf', 'gameshelf']);
// `todo` entries live on each category's queue page only — see
// planning/shelf-queue-design.md §1.
const shelfPosts = allPosts.filter((post) => shelfCategories.has(post.data.category ?? '') && post.data.status !== 'todo');

type EntryType = 'book' | 'film' | 'tv' | 'game';

// One tile's worth of data, whatever the media type.
interface CombinedEntry {
    type: EntryType;
    date: Date;
    year: number;
    title: string;
    href: string;
    cover: ImageMetadata | null;
    people: string[];
    personFilter: string;
    subtitle: string | null;
    series: string | null;
    seriesNumber: number | null;
    status: ShelfStatus;
    statusLabel: string;
    rating: BookRating | null;
    genre: string | null;
    repeat: string | null;
    notes: boolean;
    // Data attributes read by shelfFilters.ts. Only the attrs relevant to an
    // entry's type are set, so e.g. a book's `data-format` never collides with
    // a film's `data-platform`, and each filter only matches its own media type.
    filterAttrs: Record<string, string>;
}

const TYPE_LABEL: Record<EntryType, string> = { book: 'Book', film: 'Film', tv: 'TV', game: 'Game' };
const CATEGORY_TYPE: Record<string, EntryType> = { bookshelf: 'book', filmshelf: 'film', gameshelf: 'game' };

const normalizeStatus = (status?: string | null): ShelfStatus =>
    status === 'started' || status === 'paused' || status === 'todo' ? status : 'finished';

const asList = (value?: string | string[] | null): string[] =>
    !value ? [] : Array.isArray(value) ? value : [value];

const unique = (values: (string | undefined | null)[]) =>
    Array.from(new Set(values.filter((v): v is string => Boolean(v))));

// Rereads, rewatches and replays, numbered per media type.
const repeatNumbers = new Map<string, number>();
for (const category of ['bookshelf', 'filmshelf', 'gameshelf']) {
    const posts = shelfPosts.filter((p) => p.data.category === category);
    const numbers = computeWatchNumbers(posts.map((p) => ({
        title: p.data.title ?? '',
        date: p.data.finished ?? p.data.started ?? p.data.created,
    })));
    posts.forEach((p, i) => repeatNumbers.set(p.id, numbers.get(i) ?? 1));
}

const entries: CombinedEntry[] = [];

for (const post of shelfPosts) {
    const type = CATEGORY_TYPE[post.data.category ?? ''];
    if (!type) continue; // TV is grouped by show below
    const date = activityDate(post.data);
    const status = normalizeStatus(post.data.status);
    const number = repeatNumbers.get(post.id) ?? 1;
    const rawSeries = post.data.series ?? '';
    const base = {
        type,
        date,
        year: date.getFullYear(),
        title: post.data.title ?? '',
        status,
        rating: (post.data.rating as BookRating | undefined) ?? null,
        genre: post.data.genre ?? null,
        series: null as string | null,
        seriesNumber: null as number | null,
    };

    if (type === 'book') {
        const authors = asList(post.data.author);
        entries.push({
            ...base,
            href: `/bookshelf/${post.id}/`,
            cover: post.data.cover ? getBookCoverImage(post.data.cover) : null,
            people: authors,
            personFilter: 'author',
            subtitle: TYPE_LABEL.book,
            series: rawSeries && rawSeries !== 'none' ? rawSeries : null,
            seriesNumber: post.data.seriesNumber ?? null,
            statusLabel: SHELF_STATUS_LABELS.bookshelf[status],
            repeat: number > 1 ? repeatLabel(number, 'read') : null,
            // Every book has notes, so the icon would mark them all.
            notes: false,
            filterAttrs: {
                'data-author': authors.join(','),
                'data-genre': post.data.genre ?? '',
                'data-format': post.data.format ?? '',
                'data-series': rawSeries && rawSeries !== 'none' ? rawSeries : '',
                'data-rating': post.data.rating ?? '',
                'data-status': status,
            },
        });
    } else if (type === 'film') {
        const directors = post.data.director ?? [];
        entries.push({
            ...base,
            href: `/filmshelf/${post.id}/`,
            cover: post.data.cover ? getFilmCoverImage(post.data.cover) : null,
            people: directors,
            personFilter: 'director',
            subtitle: TYPE_LABEL.film,
            statusLabel: SHELF_STATUS_LABELS.filmshelf[status],
            repeat: number > 1 ? repeatLabel(number, 'watch') : null,
            notes: hasShelfNotes(post.body),
            filterAttrs: {
                'data-director': directors.join(','),
                'data-genre': post.data.genre ?? '',
                'data-platform': post.data.platform ?? '',
                'data-rating': post.data.rating ?? '',
                'data-status': status,
            },
        });
    } else {
        const hours = post.data.hoursPlayed;
        entries.push({
            ...base,
            href: `/gameshelf/${post.id}/`,
            cover: post.data.cover ? getGameCoverImage(post.data.cover) : null,
            people: post.data.developer ? [post.data.developer] : [],
            personFilter: 'developer',
            subtitle: hours ? `${TYPE_LABEL.game} · ${hours} ${hours === 1 ? 'hour' : 'hours'}` : TYPE_LABEL.game,
            statusLabel: SHELF_STATUS_LABELS.gameshelf[status],
            repeat: number > 1 ? repeatLabel(number, 'play') : null,
            notes: hasShelfNotes(post.body),
            filterAttrs: {
                'data-developer': post.data.developer ?? '',
                'data-genre': post.data.genre ?? '',
                'data-platform': post.data.platform ?? '',
                'data-rating': post.data.rating ?? '',
                'data-status': status,
            },
        });
    }
}

// One entry per TV show, filed under the year of its latest watch. Every tvshelf
// entry goes in so show slugs match /tvshelf/[show]/; todo stubs are dropped.
for (const show of groupTvShows(allPosts.filter((p) => p.data.category === 'tvshelf'))) {
    const { latest, watches } = show;
    const status: ShelfStatus = watches.some((w) => w.post.data.status === 'started')
        ? 'started'
        : normalizeStatus(latest.post.data.status);
    const ratings = watches.map((w) => w.post.data.rating as BookRating | undefined);
    const maxWatch = Math.max(...watches.map((w) => w.watchNumber));
    const seasons = seasonRangeLabel(watches.map((w) => w.season));
    const cover = latest.post.data.cover ?? watches.find((w) => w.post.data.cover)?.post.data.cover;
    entries.push({
        type: 'tv',
        date: latest.date,
        year: latest.date.getFullYear(),
        title: show.showTitle,
        href: `/tvshelf/${show.showSlug}/`,
        cover: cover ? getTVCoverImage(cover) : null,
        people: latest.post.data.creator ?? [],
        personFilter: 'creator',
        subtitle: seasons ? `${TYPE_LABEL.tv} · ${seasons}` : TYPE_LABEL.tv,
        series: null,
        seriesNumber: null,
        status,
        statusLabel: SHELF_STATUS_LABELS.tvshelf[status],
        rating: mostCommonRating(ratings, bookRatingOrder),
        genre: latest.post.data.genre ?? watches.find((w) => w.post.data.genre)?.post.data.genre ?? null,
        repeat: maxWatch > 1 ? repeatLabel(maxWatch, 'watch') : null,
        notes: watches.some((w) => w.notes),
        filterAttrs: {
            'data-creator': unique(watches.flatMap((w) => w.post.data.creator ?? [])).join(','),
            'data-genre': unique(watches.map((w) => w.post.data.genre)).join(','),
            'data-platform': unique(watches.map((w) => w.post.data.platform)).join(','),
            'data-rating': unique(ratings).join(','),
            'data-status': status,
        },
    });
}

// Year desc, then in progress first (as on each shelf), then most recent activity,
// so books, films, TV and games interleave within each status.
entries.sort((a, b) =>
    b.year - a.year
    || SHELF_LIST_SORT_PRIORITY[a.status] - SHELF_LIST_SORT_PRIORITY[b.status]
    || b.date.getTime() - a.date.getTime());

const years = Array.from(new Set(entries.map((e) => e.year)));

const entriesByYear = entries.reduce((acc, entry) => {
    if (!acc[entry.year]) acc[entry.year] = [];
    acc[entry.year].push(entry);
    return acc;
}, {} as Record<number, CombinedEntry[]>);

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const TYPE_NOUN: Record<EntryType, [string, string]> = {
    book: ['book', 'books'],
    film: ['film', 'films'],
    tv: ['show', 'shows'],
    game: ['game', 'games'],
};

// "12 books · 30 films · 5 shows", counting finished entries only.
const yearCountText = (yearEntries: CombinedEntry[]) => (['book', 'film', 'tv', 'game'] as EntryType[])
    .map((type) => {
        const count = yearEntries.filter((e) => e.type === type && e.status === 'finished').length;
        return count ? plural(count, ...TYPE_NOUN[type]) : null;
    })
    .filter(Boolean)
    .join(' · ');

const totalItems = entries.filter((e) => e.status === 'finished').length;
const countText = `${totalItems} ${totalItems === 1 ? 'item' : 'items'} finished`;

const sectionLandingProps = createSectionLandingProps({
    title: 'Shelf',
    countText,
    countVariant: 'plain',
    countClass: 'bookshelf-count',
    contentClass: 'bookshelf-content',
    hideTitle: true
});

const shelfDescription = "Everything I've read, watched, and played—books, films, TV, and games—in one place.";
---

<Layout
  title="Shelf"
  description="Books, films, TV shows, and games I've engaged with"
  currentPage="/shelf/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: { gap: 'loose', padding: 'narrow' }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
  <SectionLanding {...sectionLandingProps}>
    <div slot="afterHeader" class="shelf-header-block">
      <div class="shelf-title-row">
        <ShelfTabNav currentTab="all" />
        <a href="/shelf/rss.xml" class="shelf-rss-link" aria-label="Shelf RSS feed" title="Subscribe via RSS">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="16" height="16">
            <path d="M3.429 2.857v2.857c9.714 0 17.571 7.857 17.571 17.571h2.857C23.857 13.429 13.286 2.857 3.429 2.857zm0 5.714v2.858c5.143 0 9.286 4.143 9.286 9.285h2.857c0-6.857-5.486-12.343-12.143-12.343zm2.285 7.714c1.257 0 2.286 1.029 2.286 2.286S6.971 20.857 5.714 20.857 3.429 19.828 3.429 18.571s1.028-2.286 2.285-2.286z"/>
          </svg>
        </a>
      </div>
      <p class="shelf-description">{shelfDescription}</p>
    </div>
    <ShelfViewControls />
    <ShelfFilterResults />
    <div class="shelf-years">
      {years.map((year) => {
        const yearEntries = entriesByYear[year] ?? [];
        const counts = yearCountText(yearEntries);

        return (
          <section class="shelf-year" id={`shelf-${year}`} data-year={year}>
            <header class="shelf-year__head">
              <h2 class="shelf-year__year">{year}</h2>
              {counts && <span class="shelf-year__count" data-year-count={year}>{counts}</span>}
            </header>
            <ul class="shelf-wall">
              {yearEntries.map((entry) => (
                <li
                  class="shelf-wall__item"
                  data-shelf-item
                  {...entry.filterAttrs}
                  data-sort-date={entry.date.toISOString()}
                  data-sort-status={SHELF_LIST_SORT_PRIORITY[entry.status]}
                  data-sort-title={entry.title.toLowerCase()}
                  data-sort-rating={entry.rating ? bookRatingOrder.indexOf(entry.rating) : 9}
                >
                  <ShelfTile
                    title={entry.title}
                    href={entry.href}
                    cover={entry.cover}
                    people={entry.people}
                    personFilter={entry.personFilter}
                    series={entry.series}
                    seriesNumber={entry.seriesNumber}
                    subtitle={entry.subtitle}
                    status={entry.status}
                    statusLabel={entry.statusLabel}
                    rating={entry.rating}
                    genre={entry.genre}
                    repeat={entry.repeat}
                    notes={entry.notes}
                    date={entry.date}
                  />
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
  </SectionLanding>
</Layout>


<script>
  import { initShelfFilters } from '../../scripts/shelfFilters';

  function initShelfPageFilters() {
    initShelfFilters({
      itemSelector: '[data-shelf-item]',
      countNoun: { singular: 'item', plural: 'items' },
      filterTypes: [
        { type: 'author' },
        { type: 'director' },
        { type: 'creator' },
        { type: 'developer' },
        { type: 'genre', badgeClass: () => 'shelf-filter-badge--genre' },
        {
          type: 'status',
          labels: { todo: 'To Do', started: 'In Progress', paused: 'On Hold', finished: 'Finished' },
          badgeClass: (value) => `shelf-filter-badge--status-${value}`,
        },
        { type: 'format' },
        { type: 'series' },
        { type: 'platform' },
        {
          type: 'rating',
          labels: { like: 'Like', love: 'Love', nope: 'Nope' },
          badgeClass: (value) => `shelf-filter-badge--rating-${value}`,
        },
      ],
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShelfPageFilters);
  } else {
    initShelfPageFilters();
  }
</script>
