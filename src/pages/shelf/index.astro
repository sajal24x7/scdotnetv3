---
import Layout from '../../layouts/Layout.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import BookshelfCard from '../../components/bookshelf/BookshelfCard.astro';
import FilmCard from '../../components/shelf/FilmCard.astro';
import TVCard from '../../components/shelf/TVCard.astro';
import GameCard from '../../components/shelf/GameCard.astro';
import ShelfTabNav from '../../components/shelf/ShelfTabNav.astro';
import ShelfFilterResults from '../../components/shelf/ShelfFilterResults.astro';
import { getAllPosts } from '../../utils/content';
import { createSectionLandingProps } from '../../utils/sectionLanding';
import { slugify, computeWatchNumbers } from '../../utils/shelfUtils';
import { SHELF_STATUS_PRIORITY } from '../../utils/shelfStatus';

const allPosts = await getAllPosts();
const shelfCategories = new Set(['bookshelf', 'filmshelf', 'tvshelf', 'gameshelf']);
const shelfPosts = allPosts.filter((post) => shelfCategories.has(post.data.category ?? ''));

const parseDate = (value?: Date | string | null): Date | null => {
    if (!value) return null;
    const d = value instanceof Date ? value : new Date(value);
    return Number.isNaN(d.getTime()) ? null : d;
};

// Most recent activity date for an entry: finished > started > created.
// Used consistently across categories so books/films/TV/games interleave
// by actual date rather than falling back to inconsistent proxies.
const getEntryDate = (post: typeof shelfPosts[number]): Date => {
    const finished = parseDate(post.data.finished);
    if (finished) return finished;
    const started = parseDate(post.data.started);
    if (started) return started;
    return parseDate(post.data.created) ?? new Date();
};

// For TV: group seasons by show — one representative per show
const tvShowMap = new Map<string, typeof shelfPosts>();
for (const post of shelfPosts) {
    if (post.data.category !== 'tvshelf') continue;
    const key = post.data.showTitle ?? post.data.title ?? 'Unknown';
    if (!tvShowMap.has(key)) tvShowMap.set(key, []);
    tvShowMap.get(key)!.push(post);
}

// Build a deduplicated list of entries for the combined view
interface CombinedEntry {
    type: 'book' | 'film' | 'tv' | 'game';
    year: number;
    date: Date;
    post?: typeof shelfPosts[number];
    // TV-specific aggregate data
    showTitle?: string;
    showSlug?: string;
    tvRepresentative?: typeof shelfPosts[number];
    tvSeasonCount?: number;
    tvLatestSeason?: number;
    tvStatus?: string;
}

const entries: CombinedEntry[] = [];

// Add non-TV posts directly
for (const post of shelfPosts) {
    if (post.data.category === 'tvshelf') continue; // handled via showMap
    const date = getEntryDate(post);
    entries.push({
        type: post.data.category === 'bookshelf' ? 'book'
             : post.data.category === 'filmshelf' ? 'film'
             : 'game',
        year: date.getFullYear(),
        date,
        post
    });
}

// Add one entry per TV show
for (const [showTitle, seasons] of tvShowMap.entries()) {
    const sortedSeasons = [...seasons].sort((a, b) => (b.data.season ?? 1) - (a.data.season ?? 1));
    const representative = sortedSeasons[0];
    const seasonNumbers = seasons.map((s) => s.data.season ?? 1);
    const latestSeason = Math.max(...seasonNumbers);
    const tvStatus = seasons
        .map((s) => s.data.status)
        .filter(Boolean)
        .sort((a, b) => (SHELF_STATUS_PRIORITY[a as keyof typeof SHELF_STATUS_PRIORITY] ?? 5) - (SHELF_STATUS_PRIORITY[b as keyof typeof SHELF_STATUS_PRIORITY] ?? 5))[0];
    const date = getEntryDate(representative);

    entries.push({
        type: 'tv',
        year: date.getFullYear(),
        date,
        showTitle,
        showSlug: slugify(showTitle),
        tvRepresentative: representative,
        tvSeasonCount: seasons.length,
        tvLatestSeason: seasonNumbers.length > 0 ? latestSeason : undefined,
        tvStatus
    });
}

// Sort chronologically (most recent activity first) so books, films, TV, and
// games interleave into one unified timeline instead of clustering by type.
entries.sort((a, b) => b.date.getTime() - a.date.getTime());

const years = Array.from(new Set(entries.map((e) => e.year)));

const entriesByYear = entries.reduce((acc, entry) => {
    if (!acc[entry.year]) acc[entry.year] = [];
    acc[entry.year].push(entry);
    return acc;
}, {} as Record<number, CombinedEntry[]>);

// Compute rewatch numbers for films and games
const filmEntries = shelfPosts.filter((p) => p.data.category === 'filmshelf');
const filmWatchNumbers = computeWatchNumbers(filmEntries.map((p) => ({ title: p.data.title ?? '', date: p.data.finished ?? p.data.created })));
const filmWatchMap = new Map<string, number>();
filmEntries.forEach((p, i) => filmWatchMap.set(p.id, filmWatchNumbers.get(i) ?? 1));

// Count total finished items
const totalItems =
    shelfPosts.filter((p) => p.data.status === 'finished' && p.data.category !== 'tvshelf').length +
    Array.from(tvShowMap.values()).filter((seasons) => seasons.some((s) => s.data.status === 'finished')).length;

const countText = `${totalItems} ${totalItems === 1 ? 'item' : 'items'} finished`;

const sectionLandingProps = createSectionLandingProps({
    title: 'Shelf',
    countText,
    countVariant: 'plain',
    countClass: 'bookshelf-count',
    contentClass: 'bookshelf-content',
    hideTitle: true
});

const shelfDescription = "Everything I've read, watched, and played—books, films, TV, and games—in one place.";

const normalizeBookStatus = (status?: string | null) => {
    switch (status) {
        case 'started':
        case 'paused':
        case 'todo':
            return status;
        case 'finished':
        default:
            return 'finished';
    }
};

const joinAuthors = (author?: string | string[] | null) => {
    if (!author) return '';
    return Array.isArray(author) ? author.join(',') : author;
};

// Data attributes read by shelfFilters.ts — only the attrs relevant to an
// entry's type are set, so e.g. a book's `data-format` never collides with a
// film's `data-platform`, and each filter naturally only ever matches its
// own media type.
const getEntryFilterAttrs = (entry: CombinedEntry): Record<string, string> => {
    if (entry.type === 'book' && entry.post) {
        return {
            'data-author': joinAuthors(entry.post.data.author),
            'data-genre': entry.post.data.genre ?? '',
            'data-format': entry.post.data.format ?? '',
            'data-rating': entry.post.data.rating ?? '',
            'data-status': normalizeBookStatus(entry.post.data.status),
        };
    }

    if (entry.type === 'film' && entry.post) {
        return {
            'data-director': Array.isArray(entry.post.data.director) ? entry.post.data.director.join(',') : '',
            'data-genre': entry.post.data.genre ?? '',
            'data-platform': entry.post.data.platform ?? '',
            'data-rating': entry.post.data.rating ?? '',
            'data-status': entry.post.data.status ?? '',
        };
    }

    if (entry.type === 'tv' && entry.tvRepresentative) {
        return {
            'data-creator': Array.isArray(entry.tvRepresentative.data.creator) ? entry.tvRepresentative.data.creator.join(',') : '',
            'data-genre': entry.tvRepresentative.data.genre ?? '',
            'data-platform': entry.tvRepresentative.data.platform ?? '',
            'data-rating': entry.tvRepresentative.data.rating ?? '',
            'data-status': entry.tvStatus ?? '',
        };
    }

    if (entry.type === 'game' && entry.post) {
        return {
            'data-developer': entry.post.data.developer ?? '',
            'data-genre': entry.post.data.genre ?? '',
            'data-platform': entry.post.data.platform ?? '',
            'data-rating': entry.post.data.rating ?? '',
            'data-status': entry.post.data.status ?? '',
        };
    }

    return {};
};
---

<Layout
  title="Shelf"
  description="Books, films, TV shows, and games I've engaged with"
  currentPage="/shelf/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: { gap: 'loose', padding: 'narrow' }
  }}
  allPosts={allPosts}
  enableLinkHoverEffect
>
  <SectionLanding {...sectionLandingProps}>
    <div slot="afterHeader" class="shelf-header-block">
      <div class="shelf-title-row">
        <ShelfTabNav currentTab="all" />
        <a href="/shelf/rss.xml" class="shelf-rss-link" aria-label="Shelf RSS feed" title="Subscribe via RSS">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="16" height="16">
            <path d="M3.429 2.857v2.857c9.714 0 17.571 7.857 17.571 17.571h2.857C23.857 13.429 13.286 2.857 3.429 2.857zm0 5.714v2.858c5.143 0 9.286 4.143 9.286 9.285h2.857c0-6.857-5.486-12.343-12.143-12.343zm2.285 7.714c1.257 0 2.286 1.029 2.286 2.286S6.971 20.857 5.714 20.857 3.429 19.828 3.429 18.571s1.028-2.286 2.285-2.286z"/>
          </svg>
        </a>
      </div>
      <p class="shelf-description">{shelfDescription}</p>
    </div>
    <ShelfFilterResults />
    <div class="bookshelf-years">
      {years.map((year) => {
        const yearEntries = entriesByYear[year] ?? [];

        const yearRowCount = Math.ceil(yearEntries.length / 2);

        return (
          <section class="bookshelf-year" id={`shelf-${year}`} data-year={year}>
            <div class="bookshelf-year__grid twelve-grid grid-gap-tight">
              <div class="bookshelf-year__sidebar grid-span-2" style={`--year-row-count: ${yearRowCount};`}>
                <div class="bookshelf-year__sticky">
                  <span class="bookshelf-year__year">{year}</span>
                </div>
              </div>
              {yearEntries.map((entry, index) => {
                const gridClasses = index % 2 === 0 ? 'grid-span-5 grid-start-3' : 'grid-span-5 grid-start-8';
                const key = entry.post?.id ?? entry.showSlug ?? `${year}-${index}`;

                return (
                  <div class={`bookshelf-year__book ${gridClasses}`} data-shelf-item {...getEntryFilterAttrs(entry)}>
                    {entry.type === 'book' && entry.post && (
                      <BookshelfCard
                        {...entry.post.data}
                        title={entry.post.data.title ?? ''}
                        link={entry.post.id ? `/bookshelf/${entry.post.id}/` : undefined}
                      />
                    )}
                    {entry.type === 'film' && entry.post && (
                      <FilmCard
                        title={entry.post.data.title ?? ''}
                        director={entry.post.data.director}
                        year={entry.post.data.year as number | undefined}
                        genre={entry.post.data.genre}
                        status={entry.post.data.status as any}
                        rating={entry.post.data.rating}
                        finished={entry.post.data.finished}
                        cover={entry.post.data.cover}
                        link={entry.post.id ? `/filmshelf/${entry.post.id}/` : undefined}
                        watchNumber={filmWatchMap.get(entry.post.id) ?? 1}
                      />
                    )}
                    {entry.type === 'tv' && entry.tvRepresentative && (
                      <TVCard
                        title={entry.showTitle ?? ''}
                        showSlug={entry.showSlug ?? ''}
                        creator={entry.tvRepresentative.data.creator}
                        year={entry.tvRepresentative.data.year as number | undefined}
                        genre={entry.tvRepresentative.data.genre}
                        status={entry.tvStatus as any}
                        rating={entry.tvRepresentative.data.rating}
                        cover={entry.tvRepresentative.data.cover}
                        seasonCount={entry.tvSeasonCount}
                        latestSeason={entry.tvLatestSeason}
                      />
                    )}
                    {entry.type === 'game' && entry.post && (
                      <GameCard
                        title={entry.post.data.title ?? ''}
                        developer={entry.post.data.developer}
                        year={entry.post.data.year as number | undefined}
                        genre={entry.post.data.genre}
                        platform={entry.post.data.platform}
                        status={entry.post.data.status as any}
                        rating={entry.post.data.rating}
                        cover={entry.post.data.cover}
                        link={entry.post.id ? `/gameshelf/${entry.post.id}/` : undefined}
                      />
                    )}
                  </div>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </SectionLanding>
</Layout>

<style>
  .bookshelf-count { font-size: var(--text-small); font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; color: #6b7280; }
  :global(.dark) .bookshelf-count { color: #9ca3af; }
  .bookshelf-content { display: flex; flex-direction: column; gap: clamp(2rem, 5vw, 3rem); padding-bottom: 2rem; }
  .bookshelf-years { display: flex; flex-direction: column; gap: clamp(2rem, 5vw, 3.5rem); }
  .bookshelf-year[data-filtered="hidden"] { display: none; }
  .bookshelf-year__book[data-filtered="hidden"] { display: none; }
  .bookshelf-year__grid { align-items: flex-start; }
  .bookshelf-year__sidebar { display: flex; align-items: flex-start; }
  /* grid-row: 1 / -1 wouldn't span the implicit rows the entries create, since
     negative line numbers resolve against the explicit grid (columns only here);
     --year-row-count (set inline per section) gives the exact row span instead
     of a large guess, which would otherwise force empty trailing rows into existence */
  @media (min-width: 48rem) { .bookshelf-year__sidebar { grid-row: 1 / span var(--year-row-count, 1); align-self: stretch; } }
  .bookshelf-year__sticky { position: sticky; top: clamp(4rem, 6vw, 5.5rem); display: flex; flex-direction: column; gap: 0.35rem; }
  .bookshelf-year__year { font-size: var(--text-huge); font-weight: 700; color: rgb(var(--color-text-primary)); }
  .bookshelf-year__book { display: flex; }
  .bookshelf-year__book :global(.book-card) { width: 100%; }
  @media (max-width: 47.999rem) { .bookshelf-year__sticky { position: static; } }
  @media (min-width: 64rem) { .bookshelf-year__year { font-size: clamp(2.25rem, 4vw, 3.5rem); } }
</style>

<script>
  import { initShelfFilters } from '../../scripts/shelfFilters';

  function initShelfPageFilters() {
    initShelfFilters({
      itemSelector: '[data-shelf-item]',
      countNoun: { singular: 'item', plural: 'items' },
      filterTypes: [
        { type: 'author' },
        { type: 'director' },
        { type: 'creator' },
        { type: 'developer' },
        { type: 'genre', badgeClass: () => 'shelf-filter-badge--genre' },
        {
          type: 'status',
          labels: { todo: 'To Do', started: 'In Progress', paused: 'On Hold', finished: 'Finished' },
          badgeClass: (value) => `shelf-filter-badge--status-${value}`,
        },
        { type: 'format' },
        { type: 'platform' },
        {
          type: 'rating',
          labels: { like: 'Like', love: 'Love', nope: 'Nope' },
          badgeClass: (value) => `shelf-filter-badge--rating-${value}`,
        },
      ],
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShelfPageFilters);
  } else {
    initShelfPageFilters();
  }
</script>
