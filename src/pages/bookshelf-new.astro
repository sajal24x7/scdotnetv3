---
import Layout from '../layouts/Layout.astro';
import BookGrid from '../components/bookshelf/BookGrid.astro';
import { getAllPosts } from '../utils/content';

// Get all posts and filter for bookshelf
const allPosts = await getAllPosts();
const bookshelfPosts = allPosts
  .filter(post => post.data.category === 'bookshelf')
  .sort((a, b) => {
    // Sort by finished reading date if available, otherwise by pub date
    const aDate = a.data.finishedReading || a.data.pubDate;
    const bDate = b.data.finishedReading || b.data.pubDate;
    return new Date(bDate).getTime() - new Date(aDate).getTime();
  });

// Separate currently reading books
const currentlyReading = bookshelfPosts.filter(book => book.data.bookStatus === 'reading');

// Group completed books by year
const completedBooks = bookshelfPosts.filter(book => book.data.bookStatus === 'read' || !book.data.bookStatus);
const booksByYear = completedBooks.reduce((acc, book) => {
  const date = book.data.finishedReading || book.data.pubDate;
  const year = new Date(date).getFullYear();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(book);
  return acc;
}, {} as Record<number, typeof bookshelfPosts>);

// Get sorted years (newest first)
const years = Object.keys(booksByYear)
  .map(Number)
  .sort((a, b) => b - a);

// Calculate stats
const totalBooks = bookshelfPosts.length;
const currentlyReadingCount = currentlyReading.length;
const readBooksCount = completedBooks.length;
---

<Layout 
  title="Bookshelf" 
  description="Books I've read and am currently reading" 
  currentPage="/bookshelf-new/"
  pageWrapper={{
    maxWidth: '6xl',
    padding: 'none',
    centered: true,
    className: 'px-4'
  }}
>
  <div class="bookshelf-container">
    <header class="bookshelf-header">
      <h1 class="bookshelf-title">Bookshelf</h1>
      <p class="bookshelf-description">
        A collection of books I've read and am currently reading, organized by year.
      </p>
      <div class="bookshelf-stats">
        <span class="stat">
          <strong>{totalBooks}</strong> total books
        </span>
        <span class="stat">
          <strong>{currentlyReadingCount}</strong> currently reading
        </span>
        <span class="stat">
          <strong>{readBooksCount}</strong> completed
        </span>
      </div>
    </header>

    <main class="bookshelf-content">
      {/* Currently Reading Section */}
      {currentlyReadingCount > 0 && (
        <section class="section">
          <h2 class="section-title">
            Currently Reading
            <span class="section-count">({currentlyReadingCount})</span>
          </h2>
          <BookGrid books={currentlyReading} />
        </section>
      )}

      {/* Books by Year */}
      {years.map(year => (
        <section class="section">
          <h2 class="section-title">
            {year}
            <span class="section-count">({booksByYear[year].length})</span>
          </h2>
          <BookGrid books={booksByYear[year]} />
        </section>
      ))}
    </main>
  </div>
</Layout>

<style>
  .bookshelf-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .bookshelf-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e5e7eb;
  }

  :global(.dark) .bookshelf-header {
    border-bottom-color: #374151;
  }

  .bookshelf-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 1rem 0;
    color: #111827;
  }

  :global(.dark) .bookshelf-title {
    color: #f9fafb;
  }

  .bookshelf-description {
    font-size: 1.125rem;
    line-height: 1.6;
    color: #6b7280;
    margin: 0 0 1.5rem 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  :global(.dark) .bookshelf-description {
    color: #9ca3af;
  }

  .bookshelf-stats {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .stat {
    font-size: 0.875rem;
    font-weight: 500;
    color: #f59e0b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.dark) .stat {
    color: #fbbf24;
  }

  .stat strong {
    color: #111827;
    font-weight: 600;
  }

  :global(.dark) .stat strong {
    color: #f9fafb;
  }

  .bookshelf-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-bottom: 2rem;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
    color: #111827;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.dark) .section-title {
    color: #f9fafb;
  }

  .section-count {
    font-size: 1rem;
    font-weight: 500;
    color: #6b7280;
  }

  :global(.dark) .section-count {
    color: #9ca3af;
  }

  /* Mobile adjustments */
  @media (max-width: 640px) {
    .bookshelf-container {
      padding: 1rem 0;
    }

    .bookshelf-header {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
    }

    .bookshelf-title {
      font-size: 2rem;
    }

    .bookshelf-description {
      font-size: 1rem;
    }

    .bookshelf-stats {
      gap: 1rem;
    }

    .bookshelf-content {
      gap: 2rem;
    }

    .section {
      gap: 1rem;
    }

    .section-title {
      font-size: 1.25rem;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 641px) and (max-width: 1024px) {
    .bookshelf-title {
      font-size: 2.25rem;
    }
  }
</style>