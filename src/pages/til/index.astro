---
import Layout from '../../layouts/Layout.astro';
import GardenGrid from '../../components/layout/GardenGrid.astro';
import SectionLanding from '../../layouts/SectionLanding.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for TIL posts
const allPosts = await getAllPosts();
const tilPosts = allPosts
  .filter(post => post.data.category === 'til')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = tilPosts.map(transformPost);
const noteCount = transformedPosts.length;
const noteCountText = `${noteCount} ${noteCount === 1 ? 'note' : 'notes'}`;
---

<Layout
  title="Today I Learned"
  description="Quick notes about things I've learned while working with various technologies, tools, and systems"
  currentPage="/til/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    grid: {
      gap: 'loose',
      padding: 'narrow'
    }
  }}
  allPosts={allPosts}
  enableSearchModal
  enableLinkHoverEffect
>
    <SectionLanding
      title="Today I Learned"
      description="Quick notes about things I've learned while working with various technologies, tools, and systems."
      layout="centered"
      headerSize="lg"
      headerMaxWidth="7xl"
      countText={noteCountText}
      countVariant="plain"
      tagCategory="til"
      tagPosts={allPosts}
      contentClass="til-main grid-gap-tight"
    >
      <GardenGrid posts={transformedPosts} contentType="til" />
    </SectionLanding>
  </Layout>
