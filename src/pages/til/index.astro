---
import Layout from '../../layouts/Layout.astro';
import GardenGrid from '../../components/layout/GardenGrid.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import PopularTags from '../../components/PopularTags.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for TIL posts
const allPosts = await getAllPosts();
const tilPosts = allPosts
  .filter(post => post.data.category === 'til')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = tilPosts.map(transformPost);
---

<Layout 
  title="Today I Learned" 
  description="Quick notes about things I've learned while working with various technologies, tools, and systems" 
  currentPage="/til/"
  pageWrapper={{
    maxWidth: '7xl',
    padding: 'none',
    centered: true,
    className: 'px-2'
  }}
>
    <PageHeader 
      title="Today I Learned"
      description="Quick notes about things I've learned while working with various technologies, tools, and systems."
      layout="centered"
      size="lg"
      maxWidth="7xl"
    />
    
    <div class="til-count mb-6 text-center">
      {transformedPosts.length} {transformedPosts.length === 1 ? 'note' : 'notes'}
    </div>
    
    <PopularTags category="til" />

    <main class="til-main">
      <GardenGrid posts={transformedPosts} contentType="til" />
    </main>
</Layout>

<style>
  .til-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .til-count {
    font-size: 0.875rem;
    font-weight: 500;
    color: #8b5cf6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.dark) .til-count {
    color: #a78bfa;
  }

  .til-main {
    padding-bottom: 2rem;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .til-container {
      max-width: none;
      padding: 0;
    }

    .til-main {
      padding-bottom: 1.5rem;
    }
  }
</style> 