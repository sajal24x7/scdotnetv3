---
import Layout from '../../layouts/Layout.astro';
import ContentGrid from '../../components/ContentGrid.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for TIL
const allPosts = await getAllPosts();
const tilPosts = allPosts
  .filter(post => post.data.category === 'til')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = tilPosts.map(transformPost);
---

<Layout 
  title="TIL" 
  description="Today I Learned - Technical notes and learnings" 
  currentPage="/til/"
>
  <div class="til-container">
    <header class="til-header">
      <div class="header-content">
        <h1 class="til-title">Today I Learned</h1>
        <p class="til-description">
          Technical notes, learnings, and discoveries from my daily work and exploration.
        </p>
        <div class="til-count">
          {transformedPosts.length} {transformedPosts.length === 1 ? 'entry' : 'entries'}
        </div>
      </div>
    </header>

    <main class="til-main">
      <ContentGrid posts={transformedPosts} />
    </main>
  </div>
</Layout>

<style>
  .til-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .til-header {
    padding: 1.5rem 0 1rem;
    text-align: center;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 1.5rem;
  }

  :global(.dark) .til-header {
    border-bottom-color: #374151;
  }

  .header-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .til-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 0.5rem;
    color: #111827;
  }

  :global(.dark) .til-title {
    color: #f9fafb;
  }

  .til-description {
    font-size: 1rem;
    line-height: 1.5;
    color: #6b7280;
    margin-bottom: 1rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  :global(.dark) .til-description {
    color: #9ca3af;
  }

  .til-count {
    font-size: 0.875rem;
    font-weight: 500;
    color: #8b5cf6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.dark) .til-count {
    color: #a78bfa;
  }

  .til-main {
    padding-bottom: 2rem;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .til-container {
      padding: 0 0.25rem;
    }

    .til-header {
      padding: 1rem 0 0.75rem;
      margin-bottom: 1rem;
    }

    .til-title {
      font-size: 2rem;
    }

    .til-description {
      font-size: 0.95rem;
      margin-bottom: 0.75rem;
    }

    .til-main {
      padding-bottom: 1.5rem;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 768px) and (max-width: 1024px) {
    .til-title {
      font-size: 2.25rem;
    }
  }
</style> 