---
import Layout from '../../layouts/Layout.astro';
import ContentGrid from '../../components/ContentGrid.astro';
import { getAllPosts, transformPost } from '../../utils/content';

// Get all posts and filter for TIL
const allPosts = await getAllPosts();
const tilPosts = allPosts
  .filter(post => post.data.category === 'til')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = tilPosts.map(transformPost);
---

<Layout 
  title="TIL" 
  description="Today I Learned - Technical notes and learnings" 
  currentPage="/til/"
>
  <div class="max-w-7xl mx-auto">
    <header class="mb-12 px-6">
      <div class="flex flex-col">
        <h1 class="text-4xl font-bold mb-4">Today I Learned</h1>
        <p class="text-xl text-textSecondary dark:text-textSecondaryDark mb-4">
          Technical notes, learnings, and discoveries from my daily work and exploration.
        </p>
        <a 
          href="/til/tags" 
          class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
        >
          View entries by tag
        </a>
      </div>
    </header>

    <div class="px-6">
      <ContentGrid posts={transformedPosts} />
    </div>
  </div>
</Layout> 