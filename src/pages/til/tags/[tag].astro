import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ContentGrid from '../../../components/ContentGrid.astro';

const years = ['2012', '2013', '2014', '2015', '2016', '2017', '2019', '2021', '2022', '2024', '2025'] as const;
type Year = typeof years[number];

export async function getStaticPaths() {
  const allPosts = await Promise.all(years.map(year => getCollection(year)));
  const tilPosts = allPosts
    .flat()
    .filter((post): post is CollectionEntry<Year> => post.data.category === 'til');

  // Get all unique tags
  const tags = new Set<string>();
  tilPosts.forEach(post => {
    if (post.data.tags) {
      post.data.tags.forEach(tag => tags.add(tag));
    }
  });

  return Array.from(tags).map(tag => ({
    params: { tag },
    props: { tag }
  }));
}

const { tag } = Astro.props;

// Get all posts from year collections
const allPosts = await Promise.all(years.map(year => getCollection(year)));
const taggedPosts = allPosts
  .flat()
  .filter((post): post is CollectionEntry<Year> => 
    post.data.category === 'til' && 
    post.data.tags && 
    post.data.tags.includes(tag)
  )
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Transform posts for the ContentGrid component
const transformedPosts = taggedPosts.map(post => ({
  data: {
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    category: post.data.category,
    image: post.data.image,
    link: `/${post.data.category}/${post.slug}/`
  },
  body: post.body
}));

<Layout 
  title={`TIL tagged with "${tag}"`}
  description={`Browse TIL entries tagged with "${tag}"`}
  currentPage="/til/"
>
  <div class="max-w-7xl mx-auto">
    <header class="mb-12 px-6">
      <div class="flex flex-col">
        <h1 class="text-4xl font-bold mb-4">TIL tagged with "{tag}"</h1>
        <p class="text-xl text-textSecondary dark:text-textSecondaryDark mb-4">
          Technical learnings and notes tagged with "{tag}".
        </p>
        <a 
          href="/til/tags" 
          class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-200"
        >
          View all tags
        </a>
      </div>
    </header>

    <div class="px-6">
      <ContentGrid posts={transformedPosts} />
    </div>
  </div>
</Layout> 